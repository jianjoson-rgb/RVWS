def test_adaptive_variants(weeks, rates, horizon=5, decay=0.80, alpha=0.70, damping=0.65, anchor_weight=1.0):
    """
    anchor_weight = 0.0 -> current err3.txt bug (anchors at my, which is x = mx ~ -2.85 weeks ago!)
    anchor_weight = 1.0 -> exact WLS regression intercept at x = 0 (intercept = my - slope * mx)
    anchor_weight = 0.5 -> subtle half-step anchor (my - 0.5 * slope * mx)
    """
    latest_wk = weeks[-1]
    age = [(latest_wk - w).days / 7.0 for w in weeks]
    x = [-a for a in age]
    weights = [decay ** a for a in age]
    total = sum(weights)
    mx = sum(w * v for w, v in zip(weights, x)) / total
    my = sum(w * r for w, r in zip(weights, rates)) / total
    denom = sum(w * (v - mx) ** 2 for w, v in zip(weights, x))
    slope = sum(w * (v - mx) * (r - my) for w, v, r in zip(weights, x, rates)) / denom
    base_level = my - anchor_weight * slope * mx
    
    prev = float(rates[-1])
    preds = []
    for h in range(1, horizon + 1):
        raw = base_level + slope * damping * (1.0 - damping ** h) / (1.0 - damping)
        smoothed = alpha * raw + (1.0 - alpha) * prev
        prev = max(0.0, min(1.0, smoothed))
        preds.append(prev * 100)
    return {'mx': mx, 'my': my*100, 'intercept': (my - slope*mx)*100, 'slope': slope*100, 'preds': np.round(preds, 2)}

