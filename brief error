def apply_what_if(model, lob_setting, adjustment_setting):
    """Optional, explicitly assumed percentage-point change to one W+4 result."""
    lob = str(lob_setting or "").strip().upper()
    delta_text = "" if adjustment_setting is None else str(adjustment_setting).strip()
    if not lob and not delta_text:
        return None
    if lob not in LOBS or not delta_text:
        raise ValueError("Set both WHAT_IF_LOB (CORE, PLUS, RETAIL or PREMIUM) and WHAT_IF_ADJUSTMENT_PP, or leave both blank.")
    try:
        delta = float(delta_text)
    except ValueError as exc:
        raise ValueError("WHAT_IF_ADJUSTMENT_PP must be a number of percentage points.") from exc
    if not finite(delta) or not -100 <= delta <= 100:
        raise ValueError("WHAT_IF_ADJUSTMENT_PP must be between -100 and 100.")
    row = next(r for r in model["rows"] if r["lob"] == lob)
    f = row.get("forecast", {})
    if not f.get("available") or len(f.get("values", [])) != 4 or not finite(f["values"][-1]):
        return {"available": False, "lob": lob, "adjustment_pp": delta,
                "reason": "A what-if needs an available W+4 baseline."}
    baseline = float(f["values"][-1])
    scenario = baseline + delta / 100
    if not 0 <= scenario <= 1:
        raise ValueError("The what-if W+4 result must be between 0% and 100%; adjust WHAT_IF_ADJUSTMENT_PP.")
    return {"available": True, "lob": lob, "adjustment_pp": delta,
            "baseline_w4": baseline, "scenario_w4": scenario,
