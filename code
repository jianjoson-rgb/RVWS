    STALE_VERSION: 'This plan changed. Reload its details before saving (REG-STATE-02).',
    REVIEW_INDEPENDENCE_REQUIRED: 'You cannot review a plan you own or submitted. An eligible independent approver must decide (REG-REVIEW-01).',
