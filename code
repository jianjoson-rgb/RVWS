  const kpis = getKpiSettings_();
  const table = readTable_(FRAMEWORK_SHEET_NAME, ['Category','Type','Definition','Activity_Examples','Active','Sort_Order']);
  const differences = [], details = [], duplicates = [], grouped = Object.create(null);
