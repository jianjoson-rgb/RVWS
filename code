function getTrackerSpreadsheet_() {
  const id = String(PropertiesService.getScriptProperties().getProperty('REGISTRY_SPREADSHEET_ID') || '').trim();
  if (!/^[A-Za-z0-9_-]{20,200}$/.test(id)) {
    throw registryConfigurationError_('REGISTRY_SPREADSHEET_ID is missing or invalid in Script Properties.');
  }
  return SpreadsheetApp.openById(id);
}

function normalizeHeaderKey_(value) {
  const key = String(value == null ? '' : value).trim().toLowerCase();

  return /^site\s*\/\s*department$/.test(key) ? 'site' : key;
}

function buildHeaderMapStrict_(headers, sheetName) {
  const map = {};
  const duplicates = [];

  headers.forEach(function(header, index) {
    const key = normalizeHeaderKey_(header);
    if (!key) return;

    if (Object.prototype.hasOwnProperty.call(map, key)) {
      duplicates.push(String(header).trim());
      return;
    }

    map[key] = index;
  });

  if (duplicates.length) {
    throw registryConfigurationError_(
      sheetName + ' has duplicate header(s): ' +
      Array.from(new Set(duplicates)).join(', ')
    );
  }

  return map;
}

function requireHeaders_(headers, requiredHeaders, sheetName) {
  const map = buildHeaderMapStrict_(headers, sheetName);
  const missing = requiredHeaders.filter(function(header) {
    return !Object.prototype.hasOwnProperty.call(
      map,
      normalizeHeaderKey_(header)
    );
  });

  if (missing.length) {
    throw registryConfigurationError_(
      sheetName + ' is missing required header(s): ' + missing.join(', ')
    );
  }

  return map;
}

function assertMasterFormulaSchema_(headers) {
  const map = requireHeaders_(
    headers,
    Object.keys(ACTIONTRACKER_MASTER_FORMULA_COLUMNS),
    MASTER_SHEET_NAME
  );

  Object.keys(ACTIONTRACKER_MASTER_FORMULA_COLUMNS).forEach(function(header) {
    const actualColumn = map[normalizeHeaderKey_(header)] + 1;
    const expectedColumn = ACTIONTRACKER_MASTER_FORMULA_COLUMNS[header];

    if (actualColumn !== expectedColumn) {
      throw registryConfigurationError_(
        MASTER_SHEET_NAME + ' schema mismatch: "' + header +
        '" must remain in column ' + expectedColumn +
        ' but is currently in column ' + actualColumn + '.'
      );
    }
  });
}

function requireNonBlankText_(value, label) {
  const text = String(value == null ? '' : value).trim();
  if (!text) {
    throw registryInputError_(label + ' is required.');
  }
  return text;
}

function normalizeActionTrackerSite_(value) {
  const text = String(value == null ? '' : value).trim();
  if (!text) return '';

  if (text.toUpperCase() === 'MYQ') {
    return 'MTQ';
  }

  const canonical = ACTIONTRACKER_DEFAULT_SITES.find(function(site) {
    return site.toLowerCase() === text.toLowerCase();
  });

  return canonical || text;
}

function dateToClientIso_(value) {
  if (!(value instanceof Date) || Number.isNaN(value.getTime())) {
    return '';
  }

  return value.toISOString();
}

function validateTaskUsOwnerEmail_(value) {
  const email = requireNonBlankText_(value, 'Action Owner').toLowerCase();

  if (!/^[a-z0-9._%+-]+@taskus\.com$/i.test(email)) {
    throw registryInputError_(
      'Action Owner must be a valid @taskus.com email address.'
    );
  }

  return email;
}

function parseStoredMetricNumber_(value, unit) {
  if (typeof value === 'number' && Number.isFinite(value)) {
    return value;
  }

  const text = String(value == null ? '' : value).trim();
  if (!text) return null;

  const normalized = text.replace(/,/g, '');

  if (/^-?\d{1,3}:\d{2}:\d{2}$/.test(normalized)) {
    const negative = normalized.charAt(0) === '-';
    const clean = negative ? normalized.slice(1) : normalized;
    const parts = clean.split(':').map(Number);

    if (
      parts.length !== 3 ||
      parts.some(function(part) { return !Number.isFinite(part); }) ||
      parts[1] > 59 ||
      parts[2] > 59
    ) {
      return null;
    }

    const minutes = parts[0] * 60 + parts[1] + parts[2] / 60;
    return negative ? -minutes : minutes;
  }

  const number = Number(normalized.replace('%', ''));
  if (!Number.isFinite(number)) return null;

  if (String(unit || '').trim() === '%' && normalized.indexOf('%') !== -1) {
    return number / 100;
  }

  return number;
}

// Stored values can come from older imports or direct Sheet edits. Apply the
// same unit and range checks used for new submissions before reporting results.
// Values with an unknown unit are withheld; the original Sheet is not changed.
function registryValidatedStoredMetric_(value, unit, kpiName) {
  if (!String(unit == null ? '' : unit).trim()) return null;
  try { return parseKpiMetricServer_(value, kpiName || '', {unit:unit}, 'Stored metric'); }
  catch (ignored) { return null; }
}
function registryStoredMetricSetComplete_(baseline, current, goal, unit, kpiName) {
  if (!String(unit == null ? '' : unit).trim()) return false;
  const values=[baseline,current,goal].map(function(value) {
    return registryValidatedStoredMetric_(value,unit,kpiName);
  });
  // Source formula defines progress as unavailable when the target equals baseline.
  return values.every(function(value){return value!==null;}) && values[0]!==values[2];
}

function registryMetricDelta_(baselineValue, currentValue, goalValue, direction, unit, gap, kpiName) {
  const current = registryValidatedStoredMetric_(currentValue, unit, kpiName);
  const reference = registryValidatedStoredMetric_(gap ? goalValue : baselineValue, unit, kpiName);
  if (current === null || reference === null) return null;
  if (!gap) return current - reference;
  // Sponsor BRD 4.4 defines a signed Gap to Goal as Goal minus Current.
  // KPI direction controls attainment/improvement, not this arithmetic sign.
  return reference - current;
}

function registryRequireNumericKpiConfig_(setting) {
  if(!setting||!/^(higher|lower)( is better)?$/i.test(String(setting.direction||'').trim())||!String(setting.unit||'').trim()) {
    throw registryInputError_('This KPI is not ready for numeric entry. Ask the maintainer to verify its direction and unit.');
  }
  if(!registryAhtUnitValidServer_(setting.name,setting.unit)) {
    throw registryInputError_('AHT requires the approved unit minutes. Ask the maintainer to review the KPI unit and any existing values before continuing.');
  }
  return setting;
}

function deriveOutcomeStatus_(baselineValue, currentValue, goalValue, direction, unit, kpiName) {
  const baseline = registryValidatedStoredMetric_(baselineValue, unit, kpiName);
  const current = registryValidatedStoredMetric_(currentValue, unit, kpiName);
  const goal = registryValidatedStoredMetric_(goalValue, unit, kpiName);
  const normalizedDirection = String(direction || '').trim().toLowerCase().replace(/\s+is better$/, '');

  if (
    baseline === null ||
    current === null ||
    goal === null ||
    !String(unit == null ? '' : unit).trim() ||
    (normalizedDirection !== 'higher' && normalizedDirection !== 'lower')
  ) {
    return 'Insufficient Data';
  }

  if (
    (normalizedDirection === 'higher' && current >= goal) ||
    (normalizedDirection === 'lower' && current <= goal)
  ) {
    return 'Goal Met';
  }

  const tolerance = Math.max(
    Math.abs(goal - baseline) * 0.01,
    Math.max(Math.abs(baseline), Math.abs(goal), 1) * 1e-9
  );

  if (Math.abs(current - baseline) <= tolerance) {
    return 'Unchanged';
  }

  const improving = normalizedDirection === 'higher'
    ? current > baseline
    : current < baseline;

  return improving ? 'Improving' : 'Worsening';
}

function getSettingsOptionValues_(headerName) {
  const ss = getTrackerSpreadsheet_();
  const sheet = ss.getSheetByName(SETTINGS_SHEET_NAME);

  if (!sheet || sheet.getLastRow() < 2 || sheet.getLastColumn() < 1) {
