    return checks;
  }
  if (owner !== owner.trim().toLowerCase() || !/^[A-Z0-9._%+\-]+@taskus\.com$/i.test(owner)) {
    throw new Error('Setup incomplete: FOLLOWUP_TRIGGER_OWNER must contain the lowercase TaskUs email of the installed trigger owner.');
