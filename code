    (!selection.department||row.department===selection.department)&&(!selection.category||(row.frameworkCategory||row.category)===selection.category)&&
    (!selection.kpi||row.kpi===selection.kpi)&&(!selection.statuses.length||selection.statuses.indexOf(row.status)>=0);});
  const counts={};REGISTRY_SNAPSHOT_COUNT_KEYS.forEach(function(key){counts[key]=0;});
  selected.forEach(function(row){
    if(ACTIONTRACKER_ALLOWED_STATUSES.indexOf(row.status)<0||(row.stability&&row.stability.issue)||row.assessmentHistoryLoaded===false||
      (row.reportingWarnings&&row.reportingWarnings.length)||['Data review required','History unavailable'].indexOf((row.reviewSchedule||{}).state)>=0)
      throw registryInputError_('Resolve current reporting data warnings before saving a historical snapshot.');
    // Historic counts cannot represent unknown classifications. Reject rather
    // than persist misleading zeroes, including for completed/cancelled plans
    // because the existing schedule counts include every selected status.
    if(['On Track','At Risk','Overdue'].indexOf(row.health)<0)
      throw registryInputError_('Schedule Health is pending or unavailable for one or more selected plans. A historical snapshot cannot be saved yet.');
    if(row.measurementMethod!=='Governance outcome'&&(!registryAhtUnitValidServer_(row.kpi,row.unit)||!/^(Higher|Lower)( is better)?$/i.test(String(row.direction||'').trim())||
      !String(row.unit||'').trim()||['Goal Met','Improving','Unchanged','Worsening'].indexOf(row.outcome)<0))
      throw registryInputError_('KPI outcome is pending or unavailable for one or more selected numeric plans. A historical snapshot cannot be saved yet.');
    counts.total++;if(['Not Started','Ongoing','On Hold'].indexOf(row.status)>=0)counts.active++;
    if(row.status==='Completed')counts.completed++;if(row.status==='Cancelled')counts.cancelled++;
    if(row.approvalRequired===true&&row.reviewStatus==='Pending Review')counts.pendingReview++;
    if(row.awaitingFirstAssessment===true)counts.awaitingAssessment++;
