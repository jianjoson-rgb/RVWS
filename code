// policy confirmed by the requester. Can_Approve still gates approval actions.
function registryStoredSiteList_(value, allowNewlines) {
  const raw = String(value == null ? '' : value).trim();
  if (!raw || raw.length > 2000 || /[\x00-\x08\x0b\x0c\x0e-\x1f]/.test(raw)) return [];
  const parts = raw.split(allowNewlines ? /[,;\r\n]+/ : /,/).map(function(site) { return normalizeActionTrackerSite_(site); });
  if (parts.length > 100 || parts.some(function(site) { return !site || site.length > 100 || /[*<>]/.test(site); })) return [];
  const seen = new Set();
  return parts.filter(function(site) { const key = registrySiteKey_(site); if (seen.has(key)) return false; seen.add(key); return true; });
}

function registryReadContextForActor_(actor, includeViewSites) {
  if (!actor || !actor.active || !/^[A-Z0-9._%+\-]+@taskus\.com$/i.test(String(actor.email || ''))) {
    throw registrySecurityError_('Read access is not authorized.', 'ACCOUNT_INACTIVE');
  }
  const mode = String(PropertiesService.getScriptProperties().getProperty('REGISTRY_READ_POLICY') || '').trim();
  if (mode !== 'SITES' && mode !== 'ALL_ACTIVE' && mode !== 'APPROVAL_SITES') {
    throw registryConfigurationError_('REGISTRY_READ_POLICY requires an explicitly approved configuration. Reads remain locked.');
  }
  if (mode === 'APPROVAL_SITES') {
    if (!actor.approvalReadGrantValid) throw registryConfigurationError_('Approval_Sites contains an invalid read grant.');
    const scope = (includeViewSites===true || (includeViewSites!==false && registryViewOnlyReadActive_)) ? actor.approvalReadSites : actor.mutationReadSites;
    const approvedSites = Array.isArray(scope) ? scope.map(registrySiteKey_) : [];
    if (!approvedSites.length) throw registrySecurityError_('Explicit read access is required.', 'READ_SCOPE_REQUIRED');
    // Active, Can_Admin, optional legacy read columns and the literal Global site
    // never grant unrestricted records under this policy. Global-only operations
    // remain blocked unless a separate explicit whole-registry policy is approved.
    return {actor:actor, mode:mode, allRecords:false, sites:approvedSites};
  }
  if (mode === 'SITES' && (!actor.hasReadHeaders || !actor.readGrantValid)) {
    throw registryConfigurationError_('SITES policy requires valid Read_Sites and boolean Can_Read_All columns in Access_Control.');
  }
  const allRecords = mode === 'ALL_ACTIVE' || (mode === 'SITES' && actor.canReadAll === true);
  const sites = Array.isArray(actor.readSites) ? actor.readSites.map(registrySiteKey_) : [];
  if (!allRecords && !sites.length) throw registrySecurityError_('Explicit read access is required.', 'READ_SCOPE_REQUIRED');
  return {actor: actor, mode: mode, allRecords: allRecords, sites: sites};
}

