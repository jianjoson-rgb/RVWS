const REGISTRY_SECURITY_HEADERS = Object.freeze(registrySchema_().headers.REGISTRY_SECURITY_HEADERS);

function registrySecurityError_(message, code) {
  const error = new Error(message);
  error.registrySecurityCode = code;
  return error;
}

// View-only scope is enabled only for reviewed, read-only web endpoints.
// Unknown operations and scheduled jobs always use the legacy mutation scope.
const REGISTRY_VIEW_ONLY_READ_ENDPOINTS = Object.freeze(['doGet','getAccessContext','getCreationOptions','getDashboardData','getActionPlans','getActionPlanDetails','getActionUpdateHistory','getRegistryStabilityConfig','getRegistryFollowUpPortfolio','getHandoverPortfolio','getRegistryScalingContext']);
let registryViewOnlyReadActive_ = false;
function registryAuditOperation_(operation, requestedRecordId, work, logSuccess, scheduled) {
  const previousViewOnlyRead=registryViewOnlyReadActive_;
  registryViewOnlyReadActive_=!scheduled && REGISTRY_VIEW_ONLY_READ_ENDPOINTS.indexOf(operation)>=0;
  try {
    let actor = null;
    if (!scheduled) {
      actor = requireActiveActor_();
      registryAuthorizeOperation_(operation, requestedRecordId, actor);
    }
    registryOperationMaintenanceGuard_(operation);
    const result = work();
    if (logSuccess) {
      const needsReview = !!result && result.operationReconciliationRequired === true;
      registryWriteSecurityEvent_(operation, requestedRecordId,
        needsReview ? 'REVIEW_REQUIRED' : 'SUCCESS',
        needsReview ? 'OPERATION_RECONCILIATION_REQUIRED' : 'OPERATION_COMPLETED', scheduled);
    }
    return scheduled ? result : registrySanitizePublicResult_(result, actor, operation, requestedRecordId);
  } catch (error) {
    const safe = registryRecordFailure_(operation, requestedRecordId, error, scheduled);
    throw scheduled ? error : safe;
  } finally { registryViewOnlyReadActive_=previousViewOnlyRead; }
}
// Public entry points authenticate on every invocation. Active membership is
// read access is locked until REGISTRY_READ_POLICY is explicitly configured.
function assertRegistryReader_() {
  return registryReadContextForActor_(requireActiveActor_()).actor;
}

function registryConfigurationError_(detail) {
  return registrySecurityError_(detail, 'REGISTRY_CONFIGURATION');
}

// Only explicit, server-authored validation messages may cross the RPC boundary.
function registryInputError_(message) {
  const error = new Error(message);
  error.registryInputMessage = message;
  return error;
}

function registryRecordFailure_(operation, requestedRecordId, error, scheduled) {
  if (error && error.registryClientSafe === true) return error;
  const denied = ['IDENTITY_UNVERIFIED', 'ACCOUNT_INACTIVE', 'PERMISSION_REQUIRED',
    'OWNER_REQUIRED', 'APPROVAL_SITE_REQUIRED', 'FOLLOWUP_ASSIGNEE_REQUIRED',
    'TRIGGER_IDENTITY_REQUIRED', 'TRIGGER_OWNER_REQUIRED', 'PLAN_COMPLETED',
    'READ_SCOPE_REQUIRED', 'RECORD_UNAVAILABLE', 'GLOBAL_READ_REQUIRED',
    'REVIEW_INDEPENDENCE_REQUIRED', 'REVIEW_PROVENANCE_REQUIRED'];
  const code = error && error.registrySecurityCode;
  const isDenied = denied.indexOf(code) >= 0;
  const reads = ['doGet', 'getAccessContext', 'getCreationOptions', 'getDashboardData',
    'getActionPlans', 'getActionPlanDetails', 'getActionUpdateHistory',
    'getRegistryFollowUpPortfolio', 'getRegistryStabilityConfig',
    'previewRegistryFollowUpReminders', 'previewRegistryAssignmentEmails',
    'previewRegistryPlanEvents', 'validateRegistrySetup'];
  const reference = 'SEC-' + Utilities.getUuid();
  const reason = isDenied && reads.indexOf(operation) >= 0 ? 'READ_DENIED' :
    (isDenied || code === 'STALE_VERSION' || code === 'REGISTRY_CONFIGURATION' ? code : 'OPERATION_FAILED');
  registryWriteSecurityEvent_(operation, requestedRecordId,
    isDenied ? 'DENIED' : 'FAILED', reason, scheduled, reference);
  try {
    // No payloads, request tokens, stack traces, URLs, email values or credentials.
    const detail = registryChatDiagnosticText_(String(error && error.message || error || 'Unknown error').replace(/[A-Z0-9._%+\-]+@[A-Z0-9.\-]+\.[A-Z]{2,}/gi, '[redacted email]'),
      PropertiesService.getScriptProperties().getProperty('REGISTRY_CHAT_WEBHOOK_URL'))
      .replace(/[A-Z0-9._%+\-]+@[A-Z0-9.\-]+\.[A-Z]{2,}/gi, '[redacted email]');
    console.error(JSON.stringify({registryErrorReference: reference, operation: operation,
      reason: reason, cause: code || 'UNCLASSIFIED', diagnostic: detail}));
  } catch (ignored) { /* Error delivery must not depend on diagnostic logging. */ }

  const messages = {
    READ_SCOPE_REQUIRED: 'Read access is not configured for this account (REG-AUTH-09). Contact the maintainer.',
    RECORD_UNAVAILABLE: 'Record unavailable (REG-RECORD-01).',
    GLOBAL_READ_REQUIRED: 'This operation requires explicit access to the entire registry (REG-AUTH-10).',
    DRIVE_WRITE_UNCERTAIN: 'Upload outcome could not be confirmed (REG-DRIVE-01). Contact the maintainer before retrying.',
    IDENTITY_UNVERIFIED: 'Access denied (REG-AUTH-01). Open the app using your authorized work account.',
    ACCOUNT_INACTIVE: 'Access denied (REG-AUTH-02). Contact the registry maintainer.',
    PERMISSION_REQUIRED: 'Permission denied (REG-AUTH-03). Contact the registry maintainer.',
    OWNER_REQUIRED: 'Only the active action owner may perform this operation (REG-AUTH-04).',
    APPROVAL_SITE_REQUIRED: 'You are not authorized to approve this plan site (REG-AUTH-05).',
    FOLLOWUP_ASSIGNEE_REQUIRED: 'Only the assigned owner or authorized verifier may perform this operation (REG-AUTH-06).',
