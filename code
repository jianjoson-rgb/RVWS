      else if([route.manager,route.executive].some(function(email){try{const person=getAccessEntry_(email);return !person || !person.active || !registryCanReadSite_(registryReadContextForActor_(person),scope.plans[x.actionPlanId].site);}catch(ignored){return true;}})){errors.push(x.id+': escalation routing accounts require current plan access.');}
      else {
