    })
    .filter(function(value) {
      return value !== '';
    });
}

function protectLiteralText_(value) {
  const text = String(value == null ? '' : value);
  return /^[=+\-@]/.test(text) ? "'" + text : text;
}

function setLiteralCellValue_(range, value) {
  range.setValue(protectLiteralText_(value));
}

// Compare stored cells conservatively; do not overwrite concurrent changes.
function registryRollbackCellEqual_(a, b) {
  if ((a === '' || a == null) && (b === '' || b == null)) return true;
  if (Object.prototype.toString.call(a) === '[object Date]' || Object.prototype.toString.call(b) === '[object Date]') {
    return Object.prototype.toString.call(a) === '[object Date]' && Object.prototype.toString.call(b) === '[object Date]' && a.getTime() === b.getTime();
  }
  return a === b;
}
function registryRestoreOwnedCell_(item) {
  if (!item || !item.range || !item.attempted) return;
  if (item.range.getFormula()) throw new Error('Concurrent formula requires review.');
  const actual = item.range.getValue(), old = item.oldValue, intended = item.intendedValue;
  if (registryRollbackCellEqual_(actual, old)) return;
  const protectedValue = item.literalText && typeof intended === 'string' ? protectLiteralText_(intended) : intended;
  if (!registryRollbackCellEqual_(actual, protectedValue) && !registryRollbackCellEqual_(actual, intended)) {
    throw new Error('Concurrent cell change requires review.');
  }
  if (old === '' || old == null) item.range.clearContent();
  else if (item.literalText && typeof old === 'string') setLiteralCellValue_(item.range, old);
  else item.range.setValue(old);
}

function isAhtKpiServer_(kpiName) {
  const text = String(kpiName || '').trim().toLowerCase();
  return (
    /(^|\W)aht($|\W)/.test(text) ||
    text.indexOf('average handle time') !== -1 ||
    text.indexOf('average handling time') !== -1
  );
}

function registryAhtUnitValidServer_(kpiName,unit) {
  return !isAhtKpiServer_(kpiName) || /^(minute|minutes)$/i.test(String(unit||'').trim());
}

function parseKpiMetricServer_(value, kpiName, kpiSetting, label) {
  if (
    value === null ||
    value === undefined ||
    typeof value === 'boolean' ||
    String(value).trim() === ''
  ) {
    throw registryInputError_(label + ' is required.');
  }

  const unit = String((kpiSetting && kpiSetting.unit) || '').trim();
  const rawText = String(value).trim().replace(/,/g, '');
  let numericValue;

  if (isAhtKpiServer_(kpiName)) {
    // Both the web form and the server convert clock time to decimal minutes.
    // Reject incompatible units even when the client already sent a number.
    if (!registryAhtUnitValidServer_(kpiName,unit)) {
      throw registryInputError_('AHT requires the approved unit minutes. Ask the maintainer to review the KPI unit and any existing values before continuing.');
    }
    if (rawText.indexOf(':') !== -1) {
      const match = rawText.match(/^(\d+):(\d{2}):(\d{2})$/);
      if (!match) {
        throw registryInputError_(label + ' must use HH:MM:SS for AHT.');
      }

      const hours = Number(match[1]);
      const minutes = Number(match[2]);
      const seconds = Number(match[3]);

      if (minutes >= 60 || seconds >= 60) {
        throw registryInputError_(label + ' contains an invalid AHT time.');
      }

      numericValue = hours * 60 + minutes + seconds / 60;
    } else {
      numericValue = Number(rawText);
    }

    if (!Number.isFinite(numericValue) || numericValue < 0) {
      throw registryInputError_(label + ' must be a non-negative AHT value.');
    }

    return numericValue;
  }

  if (unit === '%') {
    if (rawText.endsWith('%')) {
      if (!rawText.slice(0, -1).trim()) throw registryInputError_(label + ' must contain a percentage value.');
      numericValue = Number(rawText.slice(0, -1)) / 100;
    } else {
      numericValue = Number(rawText);
    }

    if (!Number.isFinite(numericValue)) {
      throw registryInputError_(label + ' must be numeric.');
    }

    if (numericValue < 0 || numericValue > 1) {
      throw registryInputError_(
        label + ' must be from 0 to 1, or entered with a % sign ' +
        '(for example 82% or 0.82).'
      );
    }

    return numericValue;
  }

  numericValue = Number(rawText);

  if (!Number.isFinite(numericValue)) {
    throw registryInputError_(label + ' must be numeric.');
  }

  if (unit.toLowerCase() === 'count' && (!Number.isSafeInteger(numericValue) || numericValue < 0)) {
    throw registryInputError_(label + ' must be a non-negative whole number for a Count KPI.');
  }
  return numericValue;
}

function validateKpiPerformanceServer_(value, kpiName, kpiSetting) {
  return parseKpiMetricServer_(
    value,
    kpiName,
    kpiSetting,
    'Current Performance'
  );
}

function validateAllowedStatus_(status) {
  const clean = String(status == null ? '' : status).trim();

  if (!clean) {
    throw registryInputError_('Action Status is required.');
  }

  if (ACTIONTRACKER_ALLOWED_STATUSES.indexOf(clean) === -1) {
    throw registryInputError_('Invalid Action Status: ' + clean);
  }

  return clean;
}

function parseDateInputServer_(value, label) {
  if (value instanceof Date && !Number.isNaN(value.getTime())) {
    return new Date(
      value.getFullYear(),
      value.getMonth(),
      value.getDate()
    );
  }

  const text = String(value == null ? '' : value).trim();
  if (!text) {
    throw registryInputError_(label + ' is required.');
  }

  let year;
  let month;
  let day;
  let match = text.match(/^(\d{4})-(\d{2})-(\d{2})$/);

  if (match) {
    year = Number(match[1]);
    month = Number(match[2]);
    day = Number(match[3]);
  } else {
    match = text.match(/^(\d{1,2})\/(\d{1,2})\/(\d{4})$/);
    if (!match) {
      throw registryInputError_(label + ' must be a valid date.');
    }
    month = Number(match[1]);
    day = Number(match[2]);
    year = Number(match[3]);
  }

  const parsed = new Date(year, month - 1, day);

  if (
    parsed.getFullYear() !== year ||
    parsed.getMonth() !== month - 1 ||
    parsed.getDate() !== day
  ) {
    throw registryInputError_(label + ' must be a valid calendar date.');
  }

  return parsed;
}

function requireAuthenticatedWriter_() {
  return requireActiveActor_().email;
}

function getAccessEntry_(email) {
  const table = readTable_(ACCESS_SHEET_NAME,
    ['Email', 'Name', 'Role', 'Active', 'Can_Submit', 'Can_Comment', 'Can_Audit', 'Can_Approve', 'Approval_Sites']);
  const matches = table.rows.filter(function(row) {
    return String(row[table.map.email] || '').trim().toLowerCase() === email;
  });
  if (matches.length > 1) throw registryConfigurationError_('Duplicate email in Access_Control. Ask the maintainer to correct it.');
  if (!matches.length) return null;
  return registryAccessEntryFromRow_(email, matches[0], table.map);
}

function requireActiveActor_(flag) {

  const email = String(Session.getActiveUser().getEmail() || '').trim().toLowerCase();
  if (!email || !/^[A-Z0-9._%+\-]+@taskus\.com$/i.test(email)) {
    throw registrySecurityError_('Your signed-in work identity could not be verified. Access is blocked. Open the app using your authorized TaskUs account.', 'IDENTITY_UNVERIFIED');
  }
  const actor = getAccessEntry_(email);
  if (!actor || !actor.active) throw registrySecurityError_('Your account is not authorized for this registry.', 'ACCOUNT_INACTIVE');
  if (flag && !actor[flag]) throw registrySecurityError_(flag === 'canAdmin' ?
    'This operation requires registry administrator permission.' :
    'You do not have permission for this operation.', 'PERMISSION_REQUIRED');
  return actor;
}

function getAccessContextCore_() {
  const actor = requireActiveActor_();
  let all = false, configured = false;
  const sites = String(PropertiesService.getScriptProperties().getProperty('REGISTRY_READ_POLICY') || '').trim() === 'APPROVAL_SITES' ? (registryViewOnlyReadActive_ ? actor.approvalReadSites : actor.mutationReadSites) : actor.readSites;
  try { const context = registryReadContextForActor_(actor); all = context.allRecords; configured = true; }
  catch (ignored) { /* Own access context may bootstrap without granting protected reads. */ }
  return { version: ACTIONTRACKER_VERSION, email: actor.email, name: actor.name, active: actor.active,
    canSubmit: actor.canSubmit, canComment: actor.canComment, canAudit: actor.canAudit,
    canAdmin: actor.canAdmin, canApprove: actor.canApprove, approvalSites: actor.approvalSites,
    readSites: sites, canReadAllRecords: all, readAccessConfigured: configured,
    verified: true, reviewEnabled: true, assessmentEnabled: true, admin: false, adminOnly: actor.canAdmin && !configured,
    accountExpiresAt:actor.accountExpiresAt,accessVersion:actor.accessVersion,temporaryGrants:actor.temporaryGrants||[] };
}

function readTable_(sheetName, requiredHeaders) {
  const sheet = getTrackerSpreadsheet_().getSheetByName(sheetName);
  if (!sheet) throw registryConfigurationError_(sheetName + ' sheet not found.');
  const headers = sheet.getRange(1, 1, 1, sheet.getLastColumn()).getDisplayValues()[0];
  const map = requireHeaders_(headers, requiredHeaders, sheetName);
  const count = Math.max(0, sheet.getLastRow() - 1);
  if (sheetName === ACCESS_SHEET_NAME && count > 20000) {
    throw registryConfigurationError_('Access table physical capacity requires governed maintenance.');
  }
  return { sheet: sheet, headers: headers, map: map,
    rows: count ? sheet.getRange(2, 1, count, headers.length).getValues() : [] };
}

function getFrameworkRows_() {
  const table = readTable_(FRAMEWORK_SHEET_NAME,
    ['Category', 'Type', 'Definition', 'Activity_Examples', 'Active', 'Sort_Order']);
  const seen = {};
  return table.rows.filter(function(row) { return row[table.map.active] === true; })
    .map(function(row) {
      const category = requireNonBlankText_(row[table.map.category], 'Framework Category');
      const type = requireNonBlankText_(row[table.map.type], 'Framework Type');
      if (['Intervention', 'Escalation', 'Standardization', 'Scaling', 'Engagement'].indexOf(category) < 0) {
        throw registryConfigurationError_('Unsupported active category in Action_Framework: ' + category);
      }
      const key = registryFrameworkLabelKey_(category) + '\n' + registryFrameworkLabelKey_(type);
      if (seen[key]) throw registryConfigurationError_('Duplicate active Category / Type in Action_Framework (including equivalent hyphen/spacing variants): ' + category + ' / ' + type);
      seen[key] = true;
      return { category: category, type: type,
        definition: String(row[table.map.definition] || ''),
        examples: String(row[table.map.activity_examples] || ''),
        sortOrder: Number(row[table.map.sort_order]) || 999 };
    }).sort(function(a, b) { return a.sortOrder - b.sortOrder || a.type.localeCompare(b.type); });
}

function validateClassification_(category, type) {
  const match = getFrameworkRows_().find(function(row) {
    return row.category === category && row.type === type;
  });
  if (!match) throw registryInputError_('Select an active, allowed Category / Type combination. Refresh the form if the framework changed.');
  return match;
}

function boundedText_(value, label, maxLength, required) {
  const text = String(value == null ? '' : value).trim();
  if (required && !text) throw registryInputError_(label + ' is required.');
  if (text.length > maxLength) throw registryInputError_(label + ' must be at most ' + maxLength + ' characters.');
  return text;
}

// Optional milestone names are supplied by users; existing blank plans are not
// assigned to any group. Keep the authoritative schema hash unchanged.
function registryMilestoneValue_(value) {
  if(value!==null&&value!==undefined&&typeof value!=='string')
    throw registryInputError_('Milestone name must be text.');
  const text=boundedText_(value,'Milestone name',120,false).normalize('NFKC').replace(/\s+/g,' ').trim();
  if(text.length>120)throw registryInputError_('Milestone name must be at most 120 characters.');
  return text;
}

function storedVersion_(value) {
  if (value === '' || value === null || value === undefined) return 1;
  const version = Number(value);
  if (!Number.isSafeInteger(version) || version < 1) throw registryConfigurationError_('Invalid stored version. Ask the maintainer to review this record.');
  return version;
}

// Blank versions remain compatible with historical, unenrolled rows. Enrolled
// approval records need explicit numeric versions; guessing v1 would invent
// approval provenance and allow an incomplete row to be changed.
function registryEnrolledVersionsValid_(row, map) {
  if (row[map.approval_required] !== true) return true;
  const plan = row[map.plan_version], record = row[map.record_version];
  return typeof plan === 'number' && Number.isSafeInteger(plan) && plan >= 1 &&
    typeof record === 'number' && Number.isSafeInteger(record) && record >= plan;
}

function requireVersion_(expected, actual) {
  if (!Number.isSafeInteger(Number(expected)) || Number(expected) < 1 || Number(expected) !== actual) {
    throw registrySecurityError_('This action changed since you opened it. Reload its details before saving.', 'STALE_VERSION');
  }
}

function findActionRecord_(actionPlanId) {
  const actor = requireActiveActor_();
  const readContext = registryReadContextForActor_(actor);
  actionPlanId = registryRecordId_(actionPlanId);
  registryRequirePlanRead_(actionPlanId, readContext);
  const table = readTable_(MASTER_SHEET_NAME, getRequiredMasterHeaders_().concat(ACTIONTRACKER_EXTENSION_HEADERS));
  assertMasterFormulaSchema_(table.headers);
  const indices = [];
  table.rows.forEach(function(row, index) {
    if (String(row[table.map['action plan id']] || '').trim() === actionPlanId) indices.push(index);
  });
  if (indices.length !== 1 || !registryCanReadSite_(readContext, table.rows[indices[0]][table.map.site])) {
    throw registrySecurityError_('Record unavailable.', 'RECORD_UNAVAILABLE');
  }
  table.rowNumber = indices[0] + 2; table.row = table.rows[indices[0]];
  if (!registryEnrolledVersionsValid_(table.row, table.map)) throw registryConfigurationError_(
    'Approval-enrolled record has invalid version metadata. Ask the maintainer to reconcile it before continuing.');
  table.planVersion = storedVersion_(table.row[table.map.plan_version]);
  table.recordVersion = storedVersion_(table.row[table.map.record_version]);
  return table;
}

function requireOwner_(actor, action) {
  const owner = String(action.row[action.map['action owner']] || '').trim().toLowerCase();
  if (actor.email !== owner) throw registrySecurityError_('Only the active action owner may update execution or upload evidence.', 'OWNER_REQUIRED');
}

function digest_(value) {
  return Utilities.computeDigest(Utilities.DigestAlgorithm.SHA_256, value)
    .map(function(byte) { return ('0' + ((byte + 256) % 256).toString(16)).slice(-2); }).join('');
}

function normalizeRequestToken_(requestToken) {
  const token = String(requestToken == null ? '' : requestToken).trim();

  if (!token) {
    throw registryInputError_('Request token is required. Refresh the app and try again.');
  }

  if (!/^[A-Za-z0-9._:-]{8,160}$/.test(token)) {
    throw registryInputError_('Invalid request token.');
  }

  return token;
}

function getOperationPropertyKey_(kind, requestToken) {

  return 'ACTIONTRACKER_' + kind + '_' + digest_(requireAuthenticatedWriter_() + '\n' + requestToken);
}

function beginIdempotentOperation_(kind, requestToken, fingerprint, writeLock) {
  registryOperationUseLock_(writeLock || registryOperationHeldLock_);
  return registryBeginLedgerOperation_(kind, requestToken, fingerprint);
}

function completeIdempotentOperation_(operationKey, result) {
  registryCompleteLedgerOperation_(operationKey, result);
}

function abandonIdempotentOperation_(operationKey) {
  registryAbandonLedgerOperation_(operationKey);
}

function markOperationNeedsReview_(operationKey, detail) {
  registryMarkLedgerReview_(operationKey, detail);
}

function deterministicFormRequestToken_(sheet, row, timestamp) {
  const seed = [
    sheet.getSheetId(),
    row,
    timestamp instanceof Date ? timestamp.toISOString() : String(timestamp || '')
  ].join('|');

  const digest = Utilities.computeDigest(
    Utilities.DigestAlgorithm.SHA_256,
    seed,
    Utilities.Charset.UTF_8
  );

  const hex = digest.map(function(byte) {
    const value = byte < 0 ? byte + 256 : byte;
    return ('0' + value.toString(16)).slice(-2);
  }).join('');

  return 'FORM-' + hex;
}

function findHeaderIndex_(headers, headerName) {

  const target =
    String(headerName)
      .trim()
      .toLowerCase();

  return headers.findIndex(
    header =>
      String(header)
        .trim()
        .toLowerCase() === target
  );
}

function getLastDataRowByColumn_(sheet, columnNumber) {

  const maxRows = sheet.getMaxRows();

  if (maxRows < 2) {
    return 1;
  }

  const values =
    sheet
      .getRange(
        2,
        columnNumber,
        maxRows - 1,
        1
      )
      .getDisplayValues();

  for (
    let i = values.length - 1;
    i >= 0;
    i--
  ) {

    if (
      String(values[i][0]).trim() !== ''
    ) {
      return i + 2;
    }
  }

  return 1;
}

function getKpiSettings_() {

  const ss =
    getTrackerSpreadsheet_();

  const sheet =
    ss.getSheetByName(
      SETTINGS_SHEET_NAME
    );

  const settings = {};

  if (!sheet) {
    return settings;
  }

  const lastRow =
    sheet.getLastRow();

  if (lastRow < 2) {
    return settings;
  }

  const settingHeaders=sheet.getRange(1,1,1,sheet.getLastColumn()).getDisplayValues()[0];
  const settingMap=requireHeaders_(settingHeaders,['KPI','Direction','Unit'],SETTINGS_SHEET_NAME);

  const values =
    sheet
      .getRange(
        2,
        1,
        lastRow - 1,
        sheet.getLastColumn()
      )
      .getDisplayValues();

  values.forEach(
    row => {

      const kpi =
        String(row[settingMap.kpi] || '')
          .trim();

      if (!kpi) {
        return;
      }

      if (settings[kpi.toLowerCase()]) throw registryConfigurationError_('Duplicate KPI in Settings: ' + kpi);
      settings[
        kpi.toLowerCase()
      ] = {

        name:
          kpi,

        direction:
          String(row[settingMap.direction] || '')
            .trim(),

        unit:
          String(row[settingMap.unit] || '')
            .trim()

      };

    }
  );

  return settings;
}

function getRequiredMasterHeaders_() { return registrySchema_().masterBaseHeaders.slice(); }

function getRequiredSubmissionLogHeaders_() { return registrySchema_().submissionBaseHeaders.slice(); }

function generateSubmissionId_(submissionSheet, submissionHeaders) {
  const map = requireHeaders_(
    submissionHeaders,
    ['Submission ID'],
    SUBMISSION_LOG_SHEET_NAME
  );

  const idColumn = map[normalizeHeaderKey_('Submission ID')] + 1;
  const lastRow = getLastDataRowByColumn_(submissionSheet, idColumn);
  let highestNumber = 0;

  if (lastRow >= 2) {
    submissionSheet
      .getRange(2, idColumn, lastRow - 1, 1)
      .getDisplayValues()
      .flat()
      .forEach(function(id) {
        const match = String(id).trim().match(/^SUB-(\d+)$/);
        if (!match) return;
        const number = Number(match[1]);
        if (number > highestNumber) highestNumber = number;
      });
  }

  return 'SUB-' + String(highestNumber + 1).padStart(5, '0');
}

function createActionPlan_(payload, context) {
  payload = payload || {};
  context = context || {};
  registryRequireCapabilityAtSite_(requireActiveActor_('canSubmit'),'canSubmit',payload.site);
  const creationReadContext = registryReadContextForActor_(requireActiveActor_());
  registryRequireSiteRead_(creationReadContext, payload.site);

  const ss = context.spreadsheet || getTrackerSpreadsheet_();
  const masterSheet = ss.getSheetByName(MASTER_SHEET_NAME);
  const submissionSheet = ss.getSheetByName(SUBMISSION_LOG_SHEET_NAME);

  if (!masterSheet) {
    throw new Error('Action_Master sheet not found.');
  }

  if (!submissionSheet) {
    throw new Error('Submission_Log sheet not found.');
  }

  let site = normalizeActionTrackerSite_(
    requireNonBlankText_(payload.site, 'Site / Department')
  );
  const actionPlanName = boundedText_(payload.actionPlanName, 'Action Plan Name', 200, true);
  const actionDescription = boundedText_(payload.actionDescription, 'Action Steps', 5000, true);
  const milestoneName = registryMilestoneValue_(payload.milestoneName);
  const measurement=registryMeasurementFields_(payload),governance=measurement.Measurement_Method==='Governance outcome';
  const kpi = governance?'':requireNonBlankText_(payload.kpi, 'Target KPI / Behavior');
  const owner = validateTaskUsOwnerEmail_(payload.owner);
  const category = requireNonBlankText_(payload.category, 'Action Category');
  const actionType = requireNonBlankText_(payload.actionType, 'Action Type');
  const activity = boundedText_(payload.activity, 'Activity', 2000, true);
  const department = boundedText_(payload.department, 'Department', 100, false);
  validateClassification_(category, actionType);
  const ownerEntry = getAccessEntry_(owner);
  if (!ownerEntry || !ownerEntry.active) throw registryInputError_("Choose an active listed action owner.");
  registryRequireParticipantRead_(owner, site, 'Action owner');
  if (department && getSettingsOptionValues_('Department').indexOf(department) < 0) {
    throw registryInputError_("Select a currently configured department.");
  }

  const creationOptions = getCreationOptionsCore_();
  const allowedSites = (creationOptions.sites || []).map(function(value) {
    return String(value).trim().toLowerCase();
  });
  const allowedCategories = (creationOptions.categories || []).map(function(value) {
    return String(value).trim().toLowerCase();
  });

  if (allowedSites.indexOf(site.toLowerCase()) === -1) {
    throw registryInputError_("Select a currently configured site or department scope.");
  }

  site = creationOptions.sites.find(function(choice) { return registrySiteKey_(choice) === registrySiteKey_(site); });

  if (allowedCategories.indexOf(category.toLowerCase()) === -1) {
    throw registryInputError_("Select a currently configured action category.");
  }

  const actionStatus = validateAllowedStatus_(payload.actionStatus);
  if (actionStatus !== 'Not Started') throw registryInputError_("New plans start Not Started until an eligible approver approves the plan.");
  const scope = Object.assign(validateRegistryScope_(payload), validateRegistryGlide_(payload));
  const startDate = parseDateInputServer_(payload.startDate, 'Start Date');
  const endDate = parseDateInputServer_(payload.endDate, 'Target End Date');

  if (endDate.getTime() < startDate.getTime()) {
    throw registryInputError_("Target End Date cannot be earlier than Start Date.");
  }

  const kpiSettings = getKpiSettings_();
  const kpiKey = kpi.toLowerCase();
  const kpiSetting = kpiSettings[kpiKey];

  if (!governance && !kpiSetting) {
    throw registryInputError_('Select a currently configured KPI.');
  }
  if(!governance)registryRequireNumericKpiConfig_(kpiSetting);

  const baseline = governance?'':parseKpiMetricServer_(
    payload.baseline,
    kpi,
    kpiSetting,
    'Baseline Performance'
  );

  const goal = governance?'':parseKpiMetricServer_(
    payload.goal,
    kpi,
    kpiSetting,
    'End Goal / Target'
  );

  const source = requireNonBlankText_(
    context.source || 'ActionTracker App',
    'Submission Source'
  );

  const submittedBy = requireActiveActor_('canSubmit').email;

  const requestToken = normalizeRequestToken_(context.requestToken);
  const createdDate = context.createdDate instanceof Date
    ? context.createdDate
    : new Date();

  const lock = LockService.getScriptLock();
  lock.waitLock(30000);

  let operation = null;
  let masterRollback = [];
  let submissionLogRow = null;

  try {
    registryRequireCapabilityAtSite_(requireActiveActor_('canSubmit'),'canSubmit',site);
    registryRequireSiteRead_(registryReadContextForActor_(requireActiveActor_()), site);
    validateClassification_(category, actionType);
    validateRegistryScope_(payload);
    validateRegistryGlide_(payload);
    readTable_('Review_Log', REGISTRY_REVIEW_HEADERS);
    const latestOwner = getAccessEntry_(owner);
    if (!latestOwner || !latestOwner.active) throw registryInputError_("The selected action owner is no longer active. Refresh and select an active owner.");
    registryRequireParticipantRead_(owner, site, 'Action owner');
    if(!governance){const latestSetting=registryRequireNumericKpiConfig_(resolveRegistryKpiSetting_(getKpiSettings_(),kpi));
      if(latestSetting.direction!==kpiSetting.direction||latestSetting.unit!==kpiSetting.unit)throw registryInputError_('KPI configuration changed. Refresh the form before submitting.');}
    const createFingerprint = [
      site, actionPlanName, actionDescription, kpi, owner, category, actionType,
      activity, department, baseline, goal, startDate.toISOString(), endDate.toISOString(), actionStatus, scope, measurement
    ];
    // Blank/absent names retain the prior fingerprint for in-flight retries.
    if(milestoneName)createFingerprint.push({milestoneName:milestoneName});
    operation = beginIdempotentOperation_('CREATE', requestToken, digest_(JSON.stringify(createFingerprint)), lock);

    if (operation.duplicate) {
      return operation.result;
    }

    ensureRegistryGovernanceHeaders_();
    ensureRegistryGlideHeaders_();
    const masterHeaders = masterSheet
      .getRange(1, 1, 1, masterSheet.getLastColumn())
      .getDisplayValues()[0];

    const masterMap = requireHeaders_(
      masterHeaders,
      getRequiredMasterHeaders_().concat(ACTIONTRACKER_EXTENSION_HEADERS),
      MASTER_SHEET_NAME
    );

    assertMasterFormulaSchema_(masterHeaders);

    ensureSubmissionAuditHeaders_(submissionSheet);
    const submissionHeaders = submissionSheet
      .getRange(1, 1, 1, submissionSheet.getLastColumn())
      .getDisplayValues()[0];

    const submissionMap = requireHeaders_(
      submissionHeaders,
      getRequiredSubmissionLogHeaders_(),
      SUBMISSION_LOG_SHEET_NAME
    );

    if(milestoneName&&(masterMap.milestone_name===undefined||submissionMap.milestone_name===undefined))
      throw registryInputError_('Milestone grouping is not configured. Contact the registry maintainer before saving a milestone.');

    const actionPlanId = generateActionPlanId_(
      masterSheet,
      site,
      createdDate
    );

    const submissionId = generateSubmissionId_(
      submissionSheet,
      submissionHeaders
    );

    const idColumn = masterMap[normalizeHeaderKey_('Action Plan ID')] + 1;
    const newRow = getLastDataRowByColumn_(masterSheet, idColumn) + 1;

    // A sheet does not grow automatically when a range extends past its grid.
    // Reserve capacity only after the idempotent operation has been accepted,
    // and before writing any part of the action or its submission audit.
    if (newRow > masterSheet.getMaxRows()) {
      masterSheet.insertRowsAfter(masterSheet.getMaxRows(), Math.max(100, newRow - masterSheet.getMaxRows()));
    }
    // ID-column placement must never overwrite a partial, custom, or formula
    // row. Ignore calculated spill columns and only a verified empty checkbox.
    const candidateRange = masterSheet.getRange(newRow, 1, 1, masterSheet.getLastColumn());
    const candidateValues = candidateRange.getValues()[0], candidateFormulas = candidateRange.getFormulas()[0];
    const checkboxIndex = masterMap[normalizeHeaderKey_('Approval_Required')];
    let checkboxRule = null;
    if (checkboxIndex !== undefined && candidateValues[checkboxIndex] === false) {
      const checkboxCell = masterSheet.getRange(newRow, checkboxIndex + 1);
      if (typeof checkboxCell.getDataValidation === 'function') checkboxRule = checkboxCell.getDataValidation();
    }
    const hasUnexpectedRowData = candidateValues.some(function(value, index) {
      if (index >= 15 && index <= 19) return false;
      if (candidateFormulas[index]) return true;
      if (value === '' || value === null || value === undefined) return false;
      if (index === checkboxIndex && value === false && checkboxRule && SpreadsheetApp.DataValidationCriteria &&
          checkboxRule.getCriteriaType() === SpreadsheetApp.DataValidationCriteria.CHECKBOX &&
          checkboxRule.getAllowInvalid() === false && Array.isArray(checkboxRule.getCriteriaValues()) && checkboxRule.getCriteriaValues().length === 0) return false;
      return true;
    });
    if (hasUnexpectedRowData) throw registryConfigurationError_('The next action row contains unowned data or formulas. Review the sheet before submitting.');
    const plannedSubmissionRow = submissionSheet.getLastRow() + 1;
    if (plannedSubmissionRow > submissionSheet.getMaxRows()) {
      submissionSheet.insertRowsAfter(submissionSheet.getMaxRows(), Math.max(100, plannedSubmissionRow - submissionSheet.getMaxRows()));
    }

    function masterColumn(headerName) {
      return masterMap[normalizeHeaderKey_(headerName)] + 1;
    }

    function writeMasterField(headerName, value, literalText) {
      const column = masterColumn(headerName);

      if (column >= 16 && column <= 20) {
        throw new Error(
          'ActionTracker blocked a write into controlled formula column ' +
          column + ' (' + headerName + ').'
        );
      }

      const range = masterSheet.getRange(newRow, column);
      const rollbackItem = {
        range: range,
        oldValue: range.getValue(),
        literalText: literalText,
        intendedValue: value,
        attempted: true
      };
      masterRollback.push(rollbackItem);

      if (literalText) {
        setLiteralCellValue_(range, value);
      } else {
        range.setValue(value);
      }
    }

    writeMasterField('Action Plan ID', actionPlanId, true);
    writeMasterField('Created Date', createdDate, false);
    writeMasterField('Created By', submittedBy, true);
    writeMasterField('Site', site, true);
    writeMasterField('Action Plan Name', actionPlanName, true);
    writeMasterField('Action Description', actionDescription, true);
    if(milestoneName)writeMasterField('Milestone_Name', milestoneName, true);
    writeMasterField('Target KPI / Behavior', kpi, true);
    writeMasterField('Action Owner', owner, true);

    writeMasterField('Action Category', '', true);
    writeMasterField('Department', department, true);
    writeMasterField('Framework_Category', category, true);
    writeMasterField('Action_Type', actionType, true);
    writeMasterField('Activity', activity, true);
    writeMasterField('Plan_Version', 1, false);
    writeMasterField('Record_Version', 1, false);
    writeMasterField('Review_Status', 'Pending Review', true);
    writeMasterField('Latest_Review_ID', '', true);
    writeMasterField('Effectiveness_Status', 'Not Yet Assessed', true);
    writeMasterField('Latest_Assessment_ID', '', true);
    writeMasterField('Approval_Required', true, false);
    Object.keys(measurement).forEach(function(header){writeMasterField(header,measurement[header],true);});
    Object.keys(scope).forEach(function(header) { writeMasterField(header, scope[header], true); });
    writeMasterField('Baseline Performance', baseline, false);
    writeMasterField('Current Performance', baseline, false);
    writeMasterField('End Goal / Target', goal, false);
    writeMasterField('Start Date', startDate, false);
    writeMasterField('Target End Date', endDate, false);
    writeMasterField('Action Status', actionStatus, true);
    writeMasterField('Latest Comment', '', true);
    writeMasterField('Last Updated Date', createdDate, false);
    writeMasterField('Last Updated By', submittedBy, true);

    if (actionStatus === 'Completed') {
      writeMasterField('Completion Date', createdDate, false);
    } else {
      writeMasterField('Completion Date', '', false);
    }

    SpreadsheetApp.flush();

    const logOutput = new Array(submissionHeaders.length).fill('');

    function setSubmissionField(headerName, value) {
      logOutput[submissionMap[normalizeHeaderKey_(headerName)]] = value;
    }

    setSubmissionField('Submission ID', protectLiteralText_(submissionId));
    setSubmissionField('Action Plan ID', protectLiteralText_(actionPlanId));
    setSubmissionField('Submission Date', createdDate);
    setSubmissionField('Submission Source', protectLiteralText_(source));
    setSubmissionField('Submitted By', protectLiteralText_(submittedBy));
    setSubmissionField('Site', protectLiteralText_(site));
    setSubmissionField('Action Plan Name', protectLiteralText_(actionPlanName));
    setSubmissionField('Action Description', protectLiteralText_(actionDescription));
    if(milestoneName)setSubmissionField('Milestone_Name', protectLiteralText_(milestoneName));
    setSubmissionField('Target KPI / Behavior', protectLiteralText_(kpi));
    setSubmissionField('Action Owner', protectLiteralText_(owner));
    setSubmissionField('Action Category', protectLiteralText_(category));
    setSubmissionField('Baseline Performance', baseline);
    setSubmissionField('End Goal / Target', goal);
    setSubmissionField('Start Date', startDate);
    setSubmissionField('Target End Date', endDate);
    setSubmissionField('Action Status', protectLiteralText_(actionStatus));
    Object.keys(measurement).forEach(function(header){setSubmissionField(header,protectLiteralText_(measurement[header]));});
    Object.keys(scope).forEach(function(header) { setSubmissionField(header, protectLiteralText_(scope[header])); });
    setSubmissionField('Plan_Version', 1);
    setSubmissionField('Request_ID', protectLiteralText_(requestToken));
    setSubmissionField('Revision_Comment', 'Initial registration');
    const createdSnapshot = masterSheet.getRange(newRow, 1, 1, masterHeaders.length).getValues()[0];
    setSubmissionField('Plan_Snapshot', JSON.stringify(snapshotNamedRow_(masterHeaders, createdSnapshot)));

    const nextSubmissionRow = submissionSheet.getLastRow() + 1;
    if (nextSubmissionRow > submissionSheet.getMaxRows()) {
      submissionSheet.insertRowsAfter(submissionSheet.getMaxRows(), Math.max(100, nextSubmissionRow - submissionSheet.getMaxRows()));
    }
    const submissionRange = submissionSheet.getRange(nextSubmissionRow, 1, 1, logOutput.length);
    submissionLogRow = nextSubmissionRow;
    submissionRange.setValues([logOutput]);

    SpreadsheetApp.flush();

    const result = {
      success: true,
      version: ACTIONTRACKER_VERSION,
      submissionId: submissionId,
      actionPlanId: actionPlanId,
      createdDate: createdDate.toISOString()
    };

    completeIdempotentOperation_(operation.key, result);
    masterRollback = [];
    submissionLogRow = null;

    return result;

  } catch (error) {
    let rollbackError = null;

    if (submissionLogRow) {
      try {
        const auditRange = submissionSheet.getRange(submissionLogRow, 1, 1, submissionSheet.getLastColumn());
        const values = auditRange.getValues()[0], formulas = auditRange.getFormulas()[0];
        // Preserve any non-empty/partial audit row: ownership is not proven
        // after an interrupted append or an external edit.
        if (values.some(function(v){return v !== '' && v !== null && v !== undefined;}) || formulas.some(Boolean)) {
          throw new Error('Submission audit row requires review.');
        }
      } catch (restoreError) { rollbackError = restoreError; }
    }
    masterRollback.slice().reverse().forEach(function(item) {
      try {
        registryRestoreOwnedCell_(item);
      } catch (restoreError) { if (!rollbackError) rollbackError = restoreError; }
    });
    try { SpreadsheetApp.flush(); } catch (restoreError) { if (!rollbackError) rollbackError = restoreError; }

    if (operation && operation.key) {
      if (rollbackError) {
        markOperationNeedsReview_(operation.key, {
          operation: 'CREATE',
          error: String(error && error.message ? error.message : error),
          rollbackError: String(
            rollbackError && rollbackError.message
              ? rollbackError.message
              : rollbackError
          )
        });
      } else {
        abandonIdempotentOperation_(operation.key);
      }
    }

    if (rollbackError) {
      throw new Error(
        'Creation failed and automatic rollback also failed. ' +
        'Do not retry until Action_Master and Submission_Log are reviewed. ' +
        'Original error: ' +
        (error && error.message ? error.message : String(error))
      );
    }

    throw error;

  } finally {
    lock.releaseLock();
  }
}

