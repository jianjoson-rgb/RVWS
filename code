// Reporting uses the saved next-review date; a cadence or deadline is never
// inferred from execution completion or the passage of another week.
function registryReviewDateKey_(value) {
  let text = '';
  if (value instanceof Date) {
    if (!Number.isFinite(value.getTime())) return '';
    text = Utilities.formatDate(value, 'Asia/Manila', 'yyyy-MM-dd');
  } else text = String(value == null ? '' : value).trim();
  if (!/^\d{4}-\d{2}-\d{2}$/.test(text)) return '';
  const instant = Date.parse(text + 'T00:00:00Z');
  return Number.isFinite(instant) && new Date(instant).toISOString().slice(0,10) === text ? text : '';
}

function registryReviewSchedule_(row, map, reporting) {
  const schedule = { eligible:false, state:'Not eligible', dueDate:'', assessmentId:'',
    today:registryToday_(), message:'Effectiveness review is available for eligible Ongoing, On Hold, or Completed plans.' };
  const execution = String(row[map['action status']] || '').trim();
  if (!['Ongoing','On Hold','Completed'].includes(execution)) return schedule;
  schedule.eligible = true;
  const id = String(row[map['action plan id']] || '').trim();
  if (!registryEnrolledVersionsValid_(row, map)) {
    schedule.state='Data review required';schedule.message='Review scheduling is unavailable until record version metadata is reconciled.';return schedule;
  }
  let version, record;
  try { version=storedVersion_(row[map.plan_version]);record=storedVersion_(row[map.record_version]); }
  catch (ignored) { schedule.state='Data review required';schedule.message='Review scheduling is unavailable until record version metadata is reconciled.';return schedule; }
  const flag = row[map.approval_required];
  if (flag !== true && flag !== false && flag !== '' && flag != null) {
    schedule.state='Data review required';schedule.message='Review scheduling is unavailable until approval metadata is reconciled.';return schedule;
  }
  if (flag === true) {
    if (!reporting.reviewHistoryLoaded) {
      schedule.state='History unavailable';schedule.message='Approval history is unavailable; review eligibility is not inferred.';return schedule;
    }
    const review = reporting.reviews[String(row[map.latest_review_id] || '')];
    const approved = String(row[map.review_status]) === 'Approved' && review && review.actionPlanId === id &&
      review.planVersion === version && review.decision === 'Approved' && Number.isSafeInteger(review.recordVersionReviewed) &&
      review.recordVersionReviewed >= 1 && review.recordVersionReviewed < record;
    if (!approved) {
      if (String(row[map.review_status]) === 'Approved') {
        schedule.state='Data review required';schedule.message='The saved approval has no matching current-version review.';
      } else {
        schedule.eligible=false;schedule.message='Approve the current plan version before assessing effectiveness.';
      }
      return schedule;
    }
  }
  if (!reporting.assessmentHistoryLoaded) {
    schedule.state='History unavailable';schedule.message='Assessment history is unavailable; due dates and first-assessment status are not inferred.';return schedule;
  }
  const pointer = String(row[map.latest_assessment_id] || '').trim();
  const hasCurrentAssessment = reporting.assessments[id + ':' + version] === true;
  if (!pointer && !hasCurrentAssessment && (!row[map.effectiveness_status] || String(row[map.effectiveness_status]) === 'Not Yet Assessed')) {
    schedule.state='First assessment';schedule.message='No assessment is recorded for this plan version. A first-review deadline has not been set.';return schedule;
  }
  const assessment = (reporting.assessmentDetails || {})[pointer];
  if (!assessment || assessment.actionPlanId !== id || assessment.planVersion !== version ||
      !Number.isSafeInteger(assessment.recordVersionReviewed) || assessment.recordVersionReviewed < 1 ||
      assessment.recordVersionReviewed >= record || assessment.status !== String(row[map.effectiveness_status]) ||
      REGISTRY_EFFECTIVENESS_STATUSES.indexOf(assessment.status) < 0) {
    schedule.state='Data review required';schedule.message='The latest assessment cannot be matched to the current plan version. Its review date is not used.';return schedule;
  }
  schedule.assessmentId = assessment.assessmentId;
  if (assessment.nextReviewDateAvailable === false) {
    schedule.state='History unavailable';schedule.message='Saved review schedule information is unavailable. Ask the maintainer to check the assessment history.';return schedule;
  }
  if (!assessment.nextReviewDate) {
    schedule.state = assessment.nextReviewDateRecorded ? 'Data review required' : 'Unscheduled';
    schedule.message = assessment.nextReviewDateRecorded ? 'The saved next-review date is invalid; ask the maintainer to reconcile it.' : 'The latest assessment has no saved next-review date. Record the next review through an authorized assessment.';
    return schedule;
  }
  schedule.dueDate = assessment.nextReviewDate;
  schedule.state = schedule.dueDate < schedule.today ? 'Overdue' : schedule.dueDate === schedule.today ? 'Due today' : 'Scheduled';
  schedule.message = 'Based on the next-review date saved with the current-version assessment. A missed review does not change effectiveness.';
  return schedule;
}

// Sponsor transcript script_2, 00:43:31: evaluate every action every week.
// The reporting week follows this app's existing Sunday–Saturday Manila view.
// Coverage is read-only. Saved review dates, ratings and workflow state stay intact.
function registryWeeklyAssessmentInstant_(value) {
  if (value instanceof Date) return Number.isFinite(value.getTime()) ? value.toISOString() : '';
  if (typeof value !== 'string' || !/^\d{4}-\d\d-\d\dT\d\d:\d\d:\d\d(?:\.\d{1,3})?(?:Z|[+-]\d\d:\d\d)$/.test(value)) return '';
  const parts=value.match(/^(\d{4})-(\d\d)-(\d\d)T(\d\d):(\d\d):(\d\d)/),year=Number(parts[1]),month=Number(parts[2]),day=Number(parts[3]);
  const calendar=new Date(Date.UTC(year,month-1,day));
  if(calendar.getUTCFullYear()!==year || calendar.getUTCMonth()!==month-1 || calendar.getUTCDate()!==day || Number(parts[4])>23 || Number(parts[5])>59 || Number(parts[6])>59)return '';
  const instant=Date.parse(value);
  return Number.isFinite(instant)?new Date(instant).toISOString():'';
}

function registryWeeklyReview_(row, map, reporting) {
  const schedule=registryReviewSchedule_(row,map,reporting),today=registryReviewDateKey_(schedule.today);
  const result={eligible:schedule.eligible,state:'Not eligible',weekStart:'',weekEnd:'',today:today,
    assessedOn:'',assessmentId:'',reworkRequired:false,reworkMessage:'',
    message:'Effectiveness assessment is available for approved Ongoing, On Hold and Completed plans.'};
  if(!today){result.state='History unavailable';result.message='The Manila reporting date is unavailable. Reload before checking weekly coverage.';return result;}
  const start=new Date(today+'T00:00:00Z');start.setUTCDate(start.getUTCDate()-start.getUTCDay());
  const end=new Date(start);end.setUTCDate(end.getUTCDate()+6);
  result.weekStart=start.toISOString().slice(0,10);result.weekEnd=end.toISOString().slice(0,10);
  if(!schedule.eligible)return result;
  if(['Data review required','History unavailable'].includes(schedule.state)){
    result.state=schedule.state;result.message=schedule.message;return result;
  }
  if(row[map.approval_required]===true){
    let provenance;
    try{provenance=registrySubmissionProvenanceFromRows_({row:row,map:map,planVersion:storedVersion_(row[map.plan_version])},reporting.submissionTable);}
    catch(ignored){provenance=null;}
    if(!provenance || provenance.ready!==true){result.state='Data review required';result.message='Weekly coverage is unavailable until current-version submission provenance is reconciled.';return result;}
  }
  if(schedule.state==='First assessment'){
    result.state='Weekly review needed';result.message='No assessment is recorded for the current plan version. Operations should evaluate the action this reporting week. No deadline or rating was generated.';return result;
  }
  const assessment=(reporting.assessmentDetails || {})[schedule.assessmentId];
  if(!assessment){result.state='Data review required';result.message='The current assessment cannot be verified for weekly coverage.';return result;}
  result.assessmentId=assessment.assessmentId;
  // Weak or unmeasurable actions require explicit operational attention; do not
  // rewrite historical approval, a human rating, or completed execution.
  result.reworkRequired=['No Observable Effect','Insufficient Evidence'].includes(assessment.status);
  if(result.reworkRequired)result.reworkMessage=String(row[map['action status']])==='Completed'
    ? 'Operations must revisit the action and evidence. Completed execution stays locked; use an owned corrective follow-up or a new action plan for changes.'
    : 'Operations must revisit the action and evidence. Use an owned Adjust/Stop follow-up or an eligible owner revision, which requires new approval.';
  if(assessment.assessedAtAvailable===false){result.state='History unavailable';result.message='The assessment recording timestamp column is unavailable; weekly evaluation coverage is not inferred from observation dates.';return result;}
  const instant=registryWeeklyAssessmentInstant_(assessment.assessedAt),periodEnd=registryReviewDateKey_(assessment.periodEnd);
  if(!instant || !periodEnd || Date.parse(instant)>Date.now() || periodEnd>today){
    result.state='Data review required';result.message='The current assessment has a missing, invalid or future recording/observation date. Reconcile its history before counting weekly coverage.';return result;
  }
  if(assessment.status!=='Insufficient Evidence' && assessment.hasEvidence!==true){
    result.state='Data review required';result.message='The current rating requires available current-version evidence. Reconcile the assessment before counting weekly coverage.';return result;
  }
  if((assessment.status==='Validated' && (assessment.expectations!=='Met' || assessment.relationship!=='Supported')) ||
      (assessment.status==='No Observable Effect' && (String(row[map['action status']])!=='Completed' || assessment.expectations!=='Not Met'))){
    result.state='Data review required';result.message='The recorded assessment is inconsistent with its rating conditions. Reconcile it before counting weekly coverage.';return result;
  }
  result.assessedOn=registryToday_(new Date(instant));
  if(!registryReviewDateKey_(result.assessedOn) || result.assessedOn>today || result.assessedOn<periodEnd){
    result.state='Data review required';result.message='The recording date conflicts with the assessment observation period. Reconcile it before counting weekly coverage.';result.assessedOn='';return result;
  }
  result.state=result.assessedOn>=result.weekStart && result.assessedOn<=result.weekEnd?'Reviewed this week':'Weekly review needed';
  result.message=result.state==='Reviewed this week'
    ? 'A current-version assessment was recorded during this Sunday–Saturday Manila reporting week. This confirms evaluation coverage, not successful impact.'
    : 'No current-version assessment was recorded during this Sunday–Saturday Manila reporting week. Evaluate the action and record the evidence-backed rating; the saved next-review date remains unchanged.';
  return result;
}

