  if(selection.owner||selection.search)throw registryInputError_('Clear owner and search filters before saving or comparing snapshots.');
  const clean={sites:[],department:'',category:'',statuses:[],kpi:''};
  ['sites','statuses'].forEach(function(key){
    const values=selection[key]===undefined?[]:selection[key];
    if(!Array.isArray(values)||values.length>100||values.some(function(value){return typeof value!=='string'||!value.trim()||value.length>100;}))
      throw registryInputError_('Snapshot selections are invalid.');
    clean[key]=Array.from(new Set(values.map(function(value){return key==='sites'?normalizeActionTrackerSite_(value):value.trim();}))).sort();
  });
  clean.sites.forEach(function(site){registryRequireSiteRead_(access.context,site);});
  if(clean.statuses.some(function(status){return ACTIONTRACKER_ALLOWED_STATUSES.indexOf(status)<0;}))throw registryInputError_('Select a configured execution status.');
  ['department','category','kpi'].forEach(function(key){
    const value=selection[key]===undefined?'':selection[key];
    if(typeof value!=='string'||value.length>300)throw registryInputError_('Snapshot filter text is invalid.');
    clean[key]=value.trim();if(!clean[key])return;
    let allowed=[];
    if(key==='department')allowed=getSettingsOptionValues_('Department').concat(rows.map(function(row){return row.department;}));
    if(key==='category')allowed=getFrameworkRows_().map(function(row){return row.category;}).concat(rows.map(function(row){return row.frameworkCategory||row.category;}));
    if(key==='kpi'){const settings=getKpiSettings_();allowed=Object.keys(settings).map(function(name){return settings[name].name;}).concat(rows.map(function(row){return row.kpi;}));}
    if(allowed.indexOf(clean[key])<0)throw registryInputError_('Select a currently available snapshot filter.');
  });
  const scope={mode:access.context.mode,allRecords:access.context.allRecords===true,sites:(access.context.sites||[]).slice().sort()};
  const readScopeSignature=digest_(JSON.stringify(scope)),contextSignature=digest_(JSON.stringify([readScopeSignature,clean]));
  return {selection:clean,readScopeSignature:readScopeSignature,contextSignature:contextSignature};
}
function registrySnapshotCounts_(rows,selection) {
