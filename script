def _email_v565_squad_tenure_mix(
    group: pd.DataFrame,
    limit: int = 2,
) -> str:
    """Top tenure-group population share among rated surveys for one squad."""
    if group is None or not isinstance(group, pd.DataFrame) or group.empty or "Tenure Group" not in group.columns:
        return "tenure mix unavailable"
    work = group.copy()
    work["Tenure Group"] = work["Tenure Group"].map(_email_v565_clean_label)
    work = work[work["Tenure Group"].ne("")].copy()
    if work.empty:
        return "tenure mix unavailable"
    responses = (
        pd.to_numeric(work.get("Responses", pd.Series(1.0, index=work.index)), errors="coerce")
        .fillna(0.0)
        .clip(lower=0.0)
    )
    total = float(responses.sum())
    if total <= 0:
        return "tenure mix unavailable"
    work["_Responses"] = responses
    mix = (
        work.groupby("Tenure Group", dropna=False)
        .agg(Responses=("_Responses", "sum"))
        .reset_index()
        .sort_values("Responses", ascending=False)
        .head(max(1, int(limit)))
    )
    parts = [
        f"{normalize_text(row['Tenure Group'])} {format_rate(safe_rate(row['Responses'], total), 1)}"
        for _, row in mix.iterrows()
        if normalize_text(row.get("Tenure Group", ""))
    ]
    return ", ".join(parts) if parts else "tenure mix unavailable"


