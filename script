# EXECUTIVE TREND VOLUME BARS — v5.7.35
# =========================================================
def _compact_response_label_v535(value: Any) -> str:
    """Compact response label for labels inside chart volume bars."""
    if value is None or pd.isna(value):
        return ""
    try:
        number = float(value)
    except Exception:
        return ""
    if not np.isfinite(number) or number <= 0:
        return ""
    if abs(number) >= 1_000_000:
        return f"{number / 1_000_000:.1f}M"
    if abs(number) >= 10_000:
        return f"{number / 1_000:.1f}K"
    return format_int(number)


def _safe_chart_response_array_v535(
    chart: pd.DataFrame,
    column_name: str = "Responses",
) -> np.ndarray:
    """Return a response-count array safely, including duplicate-column defense."""
    if chart is None or not isinstance(chart, pd.DataFrame) or chart.empty:
        return np.array([], dtype=float)

    if column_name not in chart.columns:
        return np.zeros(len(chart), dtype=float)

    selected = chart.loc[:, column_name]
    if isinstance(selected, pd.DataFrame):
        selected = selected.iloc[:, 0]

    return (
        pd.to_numeric(selected, errors="coerce")
        .fillna(0)
        .clip(lower=0)
        .to_numpy(dtype=float)
    )


def _add_response_volume_bars_v535(
    ax,
    x_values: Sequence[float],
    response_values: Sequence[float],
    y_min: float,
    y_max: float,
    config: AppConfig = CONFIG,
    extra_points: Optional[Sequence[Tuple[float, float]]] = None,
) -> None:
    """
    Add subtle response-volume columns to the bottom of an existing Smiley trend chart.

    This preserves the approved dashboard layout:
    - no second visible axis,
    - no changed Smiley y-axis,
    - no changed KPI cards,
    - labels stay inside the lower part of each bar.
    """
    x_array = np.asarray(list(x_values), dtype=float)
    response_array = np.asarray(list(response_values), dtype=float)

    if len(x_array) == 0 or len(response_array) == 0:
        return

    min_len = min(len(x_array), len(response_array))
    x_array = x_array[:min_len]
    response_array = response_array[:min_len]

    extra_x: List[float] = []
    extra_responses: List[float] = []
    if extra_points:
        for point_x, point_response in extra_points:
            try:
                response_float = float(point_response)
                point_float = float(point_x)
            except Exception:
                continue
            if np.isfinite(point_float) and np.isfinite(response_float) and response_float > 0:
                extra_x.append(point_float)
                extra_responses.append(response_float)

    if extra_x:
        x_array = np.concatenate([x_array, np.asarray(extra_x, dtype=float)])
        response_array = np.concatenate(
            [response_array, np.asarray(extra_responses, dtype=float)]
        )

    valid_mask = np.isfinite(response_array) & (response_array > 0)
    if not valid_mask.any():
        return

    max_response = float(np.nanmax(response_array[valid_mask]))
    if max_response <= 0:
        return

    y_span = max(float(y_max) - float(y_min), 0.01)
    bar_band = y_span * 0.155
    min_bar_height = y_span * 0.018

    bar_heights = np.where(
        valid_mask,
        min_bar_height + (response_array / max_response) * (bar_band - min_bar_height),
        0.0,
    )

    bars = ax.bar(
        x_array,
        bar_heights,
        bottom=y_min,
        width=0.56,
        color="#DCE4F2",
        alpha=0.62,
        edgecolor="none",
        zorder=2.05,
        label="_nolegend_",
    )

    for bar, response, height in zip(bars, response_array, bar_heights):
        label = _compact_response_label_v535(response)
        if not label or height <= 0:
            continue

        label_y = y_min + max(height * 0.12, y_span * 0.006)
        ax.text(
            bar.get_x() + bar.get_width() / 2,
            label_y,
            label,
            ha="center",
            va="bottom",
            fontsize=6.7,
            fontweight="bold",
            color="#344054",
            zorder=3.0,
            clip_on=True,
        )


def _annotate_rate_points(
    ax,
    x_values: Sequence[float],
    rates: Sequence[float],
    decimals: int = 1,
    include_indexes: Optional[Iterable[int]] = None,
    color: str = "#12223F",
) -> None:
    """Label selected points with alternating offsets to avoid collisions."""
    x_array = np.asarray(x_values, dtype=float)
    rate_array = np.asarray(rates, dtype=float)

    if include_indexes is None:
        indexes = range(len(rate_array))
    else:
        indexes = sorted(
            {
                int(index)
                for index in include_indexes
                if 0 <= int(index) < len(rate_array)
            }
        )

    for index in indexes:
        rate = rate_array[index]
        if not np.isfinite(rate):
            continue

        vertical_offset = 8 if index % 2 == 0 else 13
        ax.annotate(
            f"{rate:.{decimals}%}",
            (x_array[index], rate),
            xytext=(0, vertical_offset),
            textcoords="offset points",
            ha="center",
            va="bottom",
            fontsize=8.0,
            fontweight="bold",
            color=color,
            clip_on=False,
            zorder=7,
        )


def _panel_legend_handles(
    grain: str,
    metric: PeriodMetric,
    config: AppConfig = CONFIG,
) -> List[Any]:
    """Create compact, predictable panel legends independent of plot order."""
    grain = str(grain).strip().upper()

    if grain == "DAILY":
        actual_label = "Actual Daily Smiley Rate"
    elif grain == "WEEKLY":
        actual_label = "Completed Weeks (Actual)"
    else:
        actual_label = "Completed Months / Current MTD"

    handles: List[Any] = [
        Line2D(
            [0],
            [0],
            color=config.chart_actual_color,
            marker="o",
            markersize=4.5,
            linewidth=2.0,
            label=actual_label,
        )
    ]

    if grain in {"WEEKLY", "MONTHLY"}:
        current_label = (
            "Current Week (WTD)"
            if grain == "WEEKLY" and metric.is_incomplete
            else "Current Month (MTD)"
            if grain == "MONTHLY" and metric.is_incomplete
            else "Selected Period"
        )
        handles.append(
            Line2D(
                [0],
                [0],
                linestyle="none",
                marker="o",
                markerfacecolor=config.chart_actual_dark_color,
                markeredgecolor="white",
                markersize=7,
                label=current_label,
            )
        )

        if metric.is_incomplete and pd.notna(metric.projected_rate):
            handles.append(
                Line2D(
                    [0],
                    [0],
                    color=config.chart_projection_color,
                    linestyle=(0, (4, 4)),
                    linewidth=1.8,
                    marker="o",
                    markerfacecolor="white",
                    markeredgecolor=config.chart_projection_color,
                    markersize=5.5,
                    label=(
                        "Projected Week-End"
                        if grain == "WEEKLY"
                        else "Projected Month-End"
                    ),
                )
            )

    handles.extend(
        [
            Line2D(
                [0],
                [0],
                color=config.chart_average_color,
                linestyle=(0, (5, 5)),
                linewidth=1.6,
                label=(
                    f"{metric.baseline_period_count}-Day Average"
                    if grain == "DAILY"
                    else f"{metric.baseline_period_count}-Week Average"
                    if grain == "WEEKLY"
                    else f"{metric.baseline_period_count}-Month Average"
                ),
            ),
            Line2D(
                [0],
                [0],
                color=config.chart_target_color,
                linestyle=(0, (1, 2.4)),
                linewidth=1.8,
                label=f"Target ({format_rate(config.target_rate, decimals=1)})",
            ),
            Patch(
                facecolor="#DCE4F2",
                edgecolor="none",
                alpha=0.62,
                label="Response Volume",
            ),
            Patch(
                facecolor=config.chart_gap_fill_color,
                edgecolor="none",
                alpha=config.chart_gap_fill_alpha,
                label="Gap to Target",
            ),
        ]
    )

    return handles


def _set_panel_header_and_legend(
    ax,
    title: str,
    grain: str,
    metric: PeriodMetric,
    config: AppConfig = CONFIG,
) -> None:
    """Apply the VP-approved title-left / legend-right panel header."""
    ax.text(
        0.0,
        1.13,
        title,
        transform=ax.transAxes,
        ha="left",
        va="bottom",
        fontsize=14,
        fontweight="bold",
        color=config.chart_title_color,
        clip_on=False,
    )

    if not config.chart_show_panel_legends:
        return

    handles = _panel_legend_handles(grain, metric, config)
    if grain == "DAILY":
        ncol = 5
    else:
        ncol = 4

    ax.legend(
        handles=handles,
        loc="lower right",
        bbox_to_anchor=(1.0, 1.025),
        ncol=ncol,
        frameon=False,
        fontsize=7.7,
        handlelength=2.5,
        columnspacing=1.15,
        handletextpad=0.55,
        borderaxespad=0.0,
    )


def _plot_daily_panel(
    ax,
    card_ax,
    metric: PeriodMetric,
    config: AppConfig = CONFIG,
    shared_ylim: Optional[Tuple[float, float]] = None,
) -> None:
    chart = metric.chart_df.copy()
    values = _safe_chart_rate_array(chart, "Actual Rate")
    x = np.arange(len(values), dtype=float)

    y_min, y_max = (
        shared_ylim
        if shared_ylim is not None
        else _chart_ylim(list(values) + [metric.baseline_rate], config)
    )
    _style_main_axis(ax, y_min, y_max, config)
    _add_reference_lines(
        ax,
        metric.baseline_rate,
        config.target_rate,
        config,
        baseline_label=f"{metric.baseline_period_count}-Day Average",
    )

    _fill_actual_area(ax, x, values, y_min, config)
    _fill_gap_to_target(ax, x, values, config.target_rate, config)
    _add_response_volume_bars_v535(
        ax,
        x,
        _safe_chart_response_array_v535(chart, "Responses"),
        y_min,
        y_max,
        config,
    )

    ax.plot(
        x,
        values,
        color=config.chart_actual_color,
        linewidth=2.1,
        marker="o",
        markersize=5.2,
        zorder=4,
    )

    _annotate_rate_points(
        ax,
        x,
        values,
        decimals=config.chart_point_label_decimals,
        color=config.chart_title_color,
    )

    ax.set_xticks(x)
    ax.set_xticklabels(chart.get("Period Label", pd.Series(dtype="object")), fontsize=8.3)
    ax.set_xlim(-0.45, max(len(values) - 0.55, 0.55))
    _set_panel_header_and_legend(
        ax,
        f"DAILY SMILEY TREND — LAST {len(chart)} DAYS",
        "DAILY",
        metric,
        config,
    )
    _draw_daily_card(card_ax, metric, config)


def _plot_weekly_panel(
    ax,
    card_ax,
    metric: PeriodMetric,
    config: AppConfig = CONFIG,
    shared_ylim: Optional[Tuple[float, float]] = None,
