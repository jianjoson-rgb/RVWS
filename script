def _v573_parse_first_number(text_value: Any) -> float:
    match = re.search(r"[-+]?\d+(?:,\d{3})*(?:\.\d+)?", str(text_value or ""))
    if not match:
        return np.nan
    try:
        return float(match.group(0).replace(",", ""))
    except Exception:
        return np.nan


def _v573_metric_token_color(token: str, context: str) -> str:
    """Color metric tokens in the main Whitepaper summary bullets."""
    token_text = normalize_text(token)
    if not token_text:
        return V573_TEXT_BLACK

    lowered_context = normalize_text(context).lower()
    lowered_token = token_text.lower()
    numeric = _v573_parse_first_number(token_text)
    if pd.isna(numeric):
        return V573_TEXT_GRAY

    is_percent = "%" in lowered_token
    is_pp = "pp" in lowered_token
    is_minute = "min" in lowered_token or "minute" in lowered_token

    if is_percent:
        risk_percent_context = any(
            phrase in lowered_context
            for phrase in [
                "fail rate",
                "non-smiley async share",
                "non-smiley survey share",
                "non-smiley share",
                "non-smiley qa miss",
                "non-smiley qa misses",
                "major opportunity",
            ]
        )
        performance_percent_context = any(
            phrase in lowered_context
            for phrase in [
                "smiley",
                "aftr",
                "qa score",
                "qa performance",
                "qa pass",
                "pass rate",
            ]
        )
        if risk_percent_context:
            return V573_TEXT_RED if numeric > 0 else V573_TEXT_GRAY
        if performance_percent_context:
            return V573_TEXT_GREEN if numeric >= 80.0 else V573_TEXT_RED
        return V573_TEXT_BLACK

    if is_pp:
        if abs(numeric) < 1e-12:
            return V573_TEXT_GRAY
        risk_gap_context = any(
            phrase in lowered_context
            for phrase in [
                "aht gap",
                "queue gap",
                "async gap",
                "aftr gap",
                "non-smiley",
                "qa miss",
                "fail",
                "pressure",
                "risk",
            ]
        )
        if "vs rolling" in lowered_context or "rolling baseline" in lowered_context or "rolling average" in lowered_context:
            risk_gap_context = False
        if risk_gap_context:
            return V573_TEXT_RED if numeric > 0 else V573_TEXT_GREEN
        return V573_TEXT_GREEN if numeric > 0 else V573_TEXT_RED

    if is_minute:
        if abs(numeric) < 1e-12:
            return V573_TEXT_GRAY
        if token_text.strip().startswith("-"):
            return V573_TEXT_GREEN
        if token_text.strip().startswith("+"):
            return V573_TEXT_RED
        return V573_TEXT_BLACK

    return V573_TEXT_BLACK


def _v573_add_colorized_text_runs(
    paragraph: Any,
    text_value: str,
    *,
    font_size: float = 8.6,
    default_color: str = V573_TEXT_BLACK,
    bold: bool = False,
) -> None:
    """Add text with lightweight red/green metric colors while preserving spacing."""
    clean = _v572_doc_text(text_value)
    if not clean:
        return

    token_pattern = re.compile(
        r"([+-]?\d+(?:,\d{3})*(?:\.\d+)?\s*(?:%|pp|min|mins|minute|minutes))",
        flags=re.I,
    )
    last_end = 0
    for match in token_pattern.finditer(clean):
        if match.start() > last_end:
            run = paragraph.add_run(clean[last_end:match.start()])
            run.font.size = Pt(font_size)
            run.font.color.rgb = RGBColor.from_string(default_color)
            run.bold = bold

        token = match.group(1)
        window_start = max(0, match.start() - 90)
        window_end = min(len(clean), match.end() + 90)
        color = _v573_metric_token_color(token, clean[window_start:window_end])
        token_run = paragraph.add_run(token)
        token_run.font.size = Pt(font_size)
        token_run.font.color.rgb = RGBColor.from_string(color)
        token_run.bold = True
        last_end = match.end()

    if last_end < len(clean):
        run = paragraph.add_run(clean[last_end:])
        run.font.size = Pt(font_size)
        run.font.color.rgb = RGBColor.from_string(default_color)
        run.bold = bold


def _v572_add_plain_bullet(
    document: Document,
    text_value: str,
    *,
    level: int = 0,
    bold_prefix: Optional[str] = None,
    font_size: float = 8.6,
) -> None:
    """
    v5.7.73 override: render main-summary bullets with email-style red/green
    metric colors while preserving readable DOCX spacing.
    """
    clean = _v572_doc_text(text_value)
    if not clean:
        return
    style = "List Bullet" if int(level or 0) <= 0 else "List Bullet 2"
    paragraph = document.add_paragraph(style=style)
    paragraph.paragraph_format.space_before = Pt(0)
    paragraph.paragraph_format.space_after = Pt(2.4)
    paragraph.paragraph_format.line_spacing = 1.08
    if int(level or 0) > 0:
        paragraph.paragraph_format.left_indent = Inches(0.28)

    if bold_prefix and clean.startswith(bold_prefix):
        prefix_run = paragraph.add_run(bold_prefix)
        prefix_run.bold = True
        prefix_run.font.size = Pt(font_size)
        prefix_run.font.color.rgb = RGBColor.from_string(V573_TEXT_BLUE)
        remainder = clean[len(bold_prefix):]
        if remainder and not remainder.startswith(" "):
            remainder = " " + remainder
        _v573_add_colorized_text_runs(
            paragraph,
            remainder,
            font_size=font_size,
            default_color=V573_TEXT_BLACK,
        )
    else:
        _v573_add_colorized_text_runs(
            paragraph,
            clean,
            font_size=font_size,
            default_color=V573_TEXT_BLACK,
        )


