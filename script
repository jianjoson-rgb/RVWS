def build_finance_qa_scope_analyses(
    filtered_df: pd.DataFrame,
    grain_results: Mapping[str, GrainResult],
    report_scope: Mapping[str, Any],
    config: AppConfig = CONFIG,
) -> Dict[str, FinanceQAScopeAnalysis]:
    """
    Build Finance/QA analysis for Overall and every approved site.

    Existing report outputs remain unchanged; this mapping is an additive layer.
    """
    scope_sources: Dict[str, pd.DataFrame] = {}
    if config.finance_qa_include_overall_scope:
        scope_sources["OVERALL"] = filtered_df.copy()

    if config.finance_qa_include_approved_site_scopes:
        normalized_sites = (
            filtered_df["Site"].map(normalize_text).str.upper()
            if "Site" in filtered_df.columns
            else pd.Series("", index=filtered_df.index)
        )
        for site in config.site_detail_sites:
            site_code = normalize_text(site).upper()
            scope_sources[site_code] = filtered_df[
                normalized_sites.eq(site_code)
            ].copy()

    output: Dict[str, FinanceQAScopeAnalysis] = {}
    for scope_key, scope_df in scope_sources.items():
        scope_name = "Overall" if scope_key == "OVERALL" else scope_key
        classified = _prepare_finance_qa_source_utc(
            scope_df,
            config,
        )
        grain_analyses = build_finance_qa_grain_analyses(
            filtered_df=scope_df,
            grain_results=grain_results,
            config=config,
        )

        for grain, analysis in grain_analyses.items():
            analysis.scope_name = scope_name
            result = grain_results.get(grain)
            if result is None:
                continue
            period_df = _finance_metric_period_subset(
                classified,
                result.overall,
            )
            analysis.squad_summary = _finance_squad_summary(
                period_df=period_df,
                scope_name=scope_name,
                grain=grain,
                config=config,
            )

        pattern_population = _selected_reporting_month_finance(
            classified,
            report_scope,
        )
        day_of_month, day_of_month_detail = (
            _finance_day_of_month_summaries(pattern_population)
        )

        valid_created = int(
            classified["_Created Date UTC"].notna().sum()
        )
        distinct_hours = int(
            pd.to_datetime(
                classified["_Created Date UTC"],
                errors="coerce",
                utc=True,
            ).dt.hour.nunique()
        )
        output[scope_key] = FinanceQAScopeAnalysis(
            scope_name=scope_name,
            grain_analyses=grain_analyses,
            monthly_trend=_finance_monthly_trend(
                classified,
                report_scope,
                config,
            ),
            time_of_day_summary=_finance_time_of_day_summary(
                pattern_population,
                config,
            ),
            day_of_week_summary=_finance_day_of_week_summary(
                pattern_population,
            ),
            day_of_month_summary=day_of_month,
            day_of_month_detail=day_of_month_detail,
            methodology_notes=finance_qa_methodology_notes(config),
            validation_notes=[
                (
                    f"{valid_created:,} rows in the {scope_name} scope have a "
                    "valid UTC Created Date."
                ),
                (
                    f"{distinct_hours} distinct UTC hours were found in the "
                    f"{scope_name} scope."
                ),
                (
                    "Timing-pattern tables compare All Rated, Finance, and Other "
                    f"for {report_scope.get('pattern_label', 'the selected period')} "
                    "using UTC calendar/hour boundaries."
                ),
            ],
        )

    return output


def _combine_finance_scope_frames(
    scope_analyses: Mapping[str, FinanceQAScopeAnalysis],
    frame_name: str,
    include_grain: bool = False,
) -> pd.DataFrame:
    """
    Combine one scope-analysis DataFrame for Google Sheets audit output.

    Scope and Grain assignment is idempotent so frames that already contain
    either column do not raise ``ValueError: cannot insert ..., already exists``.
    """
    frames: List[pd.DataFrame] = []

    def with_front_columns(
        frame: pd.DataFrame,
        scope_name: str,
        grain_name: str = "",
    ) -> pd.DataFrame:
        copy = frame.copy()
        copy["Scope"] = scope_name
        if grain_name:
            copy["Grain"] = grain_name

        front = ["Scope"]
        if grain_name:
            front.append("Grain")
        remaining = [
            column
            for column in copy.columns
            if column not in front
        ]
        return copy[front + remaining]

    for _, scope_analysis in scope_analyses.items():
        if include_grain:
            for grain, grain_analysis in scope_analysis.grain_analyses.items():
                frame = getattr(
                    grain_analysis,
                    frame_name,
                    pd.DataFrame(),
                )
                if frame is None or frame.empty:
                    continue
                frames.append(
                    with_front_columns(
                        frame,
                        scope_analysis.scope_name,
                        grain,
                    )
                )
        else:
            frame = getattr(
                scope_analysis,
                frame_name,
                pd.DataFrame(),
            )
            if frame is None or frame.empty:
                continue
            frames.append(
                with_front_columns(
                    frame,
                    scope_analysis.scope_name,
                )
            )

    return (
        pd.concat(frames, ignore_index=True, sort=False)
        if frames
        else pd.DataFrame()
    )

