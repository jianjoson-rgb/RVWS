                "Main Executive Signal & Driver Summary could not be generated; continuing full report: %s",
                exc,
            )

    if config.generate_email_body and config.email_body_add_to_reports:
        email_payload = _selection_aware_email_payload_v570(
            selection=selection,
            report_scope=report_scope,
            grain_results=grain_results,
