# V5.7.58 LOW-SMILEY SQUAD QA CONTEXT + EMAIL BULLET SPACING
# =========================================================
# Scope:
# - Keep v5.7.57 calculations intact.
# - Replace the separate "Squad QA Bottom 5" detailed-readout list with QA
#   attribute performance attached to the same bottom-5 Smiley squads.
# - Render the Squad Focus section as one parent bullet with nested squad
#   sub-bullets so Google Docs/Gmail keeps the visual hierarchy readable.
# - Harden list indentation in the final DOCX spacing pass.


def _email_v558_squad_group_from_source(
    source_df: pd.DataFrame,
    site: Any,
    squad: Any,
    config: AppConfig = CONFIG,
) -> pd.DataFrame:
    """Return current-period rows for one low-Smiley site/squad."""
    if source_df is None or not isinstance(source_df, pd.DataFrame) or source_df.empty:
        return pd.DataFrame()
    if not {"Site", "Squad Code"}.issubset(source_df.columns):
        return pd.DataFrame()

    work = source_df.copy()
    try:
        work = filter_rows_to_approved_sites(work, config)
    except Exception:
        pass

    site_key = normalize_text(site).upper()
    squad_key = normalize_text(squad).upper()
    if not site_key or not squad_key:
        return pd.DataFrame()

    site_series = work["Site"].map(lambda value: normalize_text(value).upper())
    squad_series = work["Squad Code"].map(lambda value: normalize_text(value).upper())
    return work.loc[site_series.eq(site_key) & squad_series.eq(squad_key)].copy()


def _email_v558_squad_qa_performance(
    source_df: pd.DataFrame,
    site: Any,
    squad: Any,
    config: AppConfig = CONFIG,
    limit: int = 2,
) -> Dict[str, Any]:
    """
    Summarize QA performance for the same low-Smiley squad shown in the email
    driver readout. This does not rank separate QA squads; it attaches QA
    context to the squads already selected by Smiley underperformance.
    """
    group = _email_v558_squad_group_from_source(
        source_df=source_df,
        site=site,
        squad=squad,
        config=config,
    )
    qa_columns = [column for column in QA_ATTRIBUTE_COLUMNS if column in group.columns]
    if group.empty or not qa_columns:
        return {
            "available": False,
            "qa_pass_rate": np.nan,
            "audited": 0,
            "failed": 0,
            "attributes": [],
        }

    qa_values = group[qa_columns].apply(pd.to_numeric, errors="coerce")
    valid = qa_values.where(qa_values.isin([0, 1]))
    audited = int(valid.notna().sum().sum())
    passed = int(valid.eq(1).sum().sum())
    failed = int(valid.eq(0).sum().sum())
    qa_pass_rate = safe_rate(passed, audited)

    attributes: List[Dict[str, Any]] = []
    for attribute in qa_columns:
        attr_values = valid[attribute].dropna()
        attr_audited = int(attr_values.notna().sum())
        if attr_audited <= 0:
            continue
        attr_failed = int(attr_values.eq(0).sum())
        attr_passed = int(attr_values.eq(1).sum())
        attributes.append(
            {
                "QA Attribute": normalize_text(attribute),
                "Audited": attr_audited,
                "Passed": attr_passed,
                "Failed": attr_failed,
                "Failure Rate": safe_rate(attr_failed, attr_audited),
                "Pass Rate": safe_rate(attr_passed, attr_audited),
            }
        )

    if attributes:
        failed_attrs = [item for item in attributes if int(item.get("Failed", 0)) > 0]
        ranking_pool = failed_attrs if failed_attrs else attributes
        attributes = sorted(
            ranking_pool,
            key=lambda item: (
                -float(item.get("Failure Rate", 0.0) or 0.0),
                -int(item.get("Audited", 0) or 0),
                normalize_text(item.get("QA Attribute", "")),
            ),
        )[: max(1, int(limit))]

    return {
        "available": audited > 0,
        "qa_pass_rate": qa_pass_rate,
        "audited": audited,
        "failed": failed,
        "attributes": attributes,
    }


def _email_v558_squad_qa_segments(
    qa_performance: Mapping[str, Any],
    config: AppConfig = CONFIG,
) -> List[Dict[str, Any]]:
    """Build color-coded QA context segments for one low-Smiley squad bullet."""
    if not qa_performance or not qa_performance.get("available"):
        return [
            _email_v551_seg(" QA performance: "),
            _email_v551_seg("QA attributes unavailable", color=EMAIL_V551_GRAY, bold=True),
            _email_v551_seg("."),
        ]

    qa_target = float(getattr(config, "qa_heatmap_target_rate", 0.80))
    qa_rate = _email_v551_num(qa_performance.get("qa_pass_rate"))
    audited = int(_email_v551_num(qa_performance.get("audited", 0), 0.0) or 0)
    failed = int(_email_v551_num(qa_performance.get("failed", 0), 0.0) or 0)
    attributes = list(qa_performance.get("attributes", []) or [])

    segments: List[Dict[str, Any]] = [
        _email_v551_seg(" QA performance: "),
        _email_v551_seg(
            format_rate(qa_rate),
            color=_email_v551_rate_color(qa_rate, threshold=qa_target),
            bold=True,
        ),
        _email_v551_seg(f" QA pass rate across {format_int(audited)} audited checks"),
    ]

    if failed <= 0:
        segments.extend(
            [
                _email_v551_seg("; "),
                _email_v551_seg("no failed QA attributes in audited checks", color=EMAIL_V551_GREEN, bold=True),
                _email_v551_seg("."),
            ]
        )
        return segments

    if attributes:
        segments.append(_email_v551_seg("; coach "))
        for idx, item in enumerate(attributes):
            attribute = normalize_text(item.get("QA Attribute", ""))
            failure_rate = _email_v551_num(item.get("Failure Rate"))
            if not attribute:
                continue
            if idx > 0:
                segments.append(_email_v551_seg("; "))
            segments.append(
                _email_v551_seg(
                    f"{attribute} {format_rate(failure_rate, 1)} fail rate",
                    color=EMAIL_V551_RED,
                    bold=True,
                )
            )
    else:
        segments.append(_email_v551_seg("; failed QA attributes require review"))
    segments.append(_email_v551_seg("."))
    return segments


def _email_v558_squad_smiley_with_qa_paragraphs(
    grain_result: GrainResult,
    source_df: pd.DataFrame,
    config: AppConfig = CONFIG,
    limit: int = 5,
) -> List[Dict[str, Any]]:
    """
    Build one Squad Focus parent bullet and nested bottom-5 Smiley squad bullets.

    Each nested squad bullet includes the squad's Smiley performance and the QA
    attribute performance for that same squad/current period.
    """
    rows = _email_v557_squad_smiley_rows(
        grain_result=grain_result,
        config=config,
        limit=limit,
    )
    if rows.empty:
        return [
            {
                "level": 0,
                "segments": [
                    _email_v551_seg(
                        "Squad Focus: No qualifying low-Smiley squad rows were available for this grain."
                    )
                ],
            }
        ]

    paragraphs: List[Dict[str, Any]] = [
        {
            "level": 0,
            "segments": [
                _email_v551_seg("Squad Focus — Bottom 5 Smiley Squads with QA Attribute Performance:", bold=True),
                _email_v551_seg(" lowest Smiley squads by rate/volume, with QA performance shown for the same squads."),
