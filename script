        sharp = _email_v565_sharpest_grain(grain_results, active)
        if sharp and sharp in grain_results:
            site_rows = _top_site_rows(grain_results[sharp], "negative", 1, config=CONFIG)
            if site_rows is not None and not site_rows.empty:
                attention = normalize_text(site_rows.iloc[0].get("Site", ""))
    if not attention:
        attention = "Review Required"
    return f"[Whitepaper Report] {report_date} | {selection.lob.upper()} Signal: {signal} | Attention: {attention}"


