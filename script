        self.reload_button = widgets.Button(
            description="Reload Source Data",
            button_style="",
            icon="refresh",
            layout=widgets.Layout(width="205px"),
        )
        self.status = widgets.HTML(
            value="<b>Status:</b> Initializing Google access and source data…"
        )
        self.output = widgets.Output(
            layout={
                "border": "1px solid #D1D5DB",
                "padding": "8px",
                "margin_top": "8px",
            }
        )

        self.run_button.on_click(self._on_run_clicked)
        self.reload_button.on_click(self._on_reload_clicked)
        self.month_dropdown.observe(
            self._on_period_changed,
            names="value",
        )

    def _on_period_changed(self, change: Mapping[str, Any]) -> None:
        """Enable Anchor Date only for Specific Month, Week, or Day."""
        selected = normalize_text(change.get("new", "")).upper()
        self.anchor_date_picker.disabled = selected not in {
            "SPECIFIC MONTH",
            "SPECIFIC WEEK",
            "SPECIFIC DAY",
        }

    def initialize(self) -> None:
        self.clients = authenticate_google()
        self.spreadsheet = open_source_spreadsheet(
            self.clients,
            self.config,
        )
        raw_df = load_source_values(self.spreadsheet, self.config)
        self.normalized_source_df, self.source_validation = normalize_source_schema(
            raw_df,
            self.config,
        )
        self.month_dropdown.options = available_report_period_options(
            self.normalized_source_df
        )
        self.month_dropdown.value = "CURRENT MONTH"
        latest_source_date = pd.Timestamp(
            self.normalized_source_df["Date"].max()
        ).date()
        self.anchor_date_picker.value = latest_source_date
        self.anchor_date_picker.disabled = True
        self.status.value = (
            f"<b>Status:</b> Ready. Loaded {len(self.normalized_source_df):,} "
            f"validated rows and "
            f"{self.normalized_source_df['Ticket ID'].nunique():,} unique tickets."
        )

    def show(self) -> "ExecutiveReportControlPanel":
        title = widgets.HTML(
            value=(
                "<h3 style='color:#12223F;margin-bottom:4px;'>"
                f"Whitepaper Report Controls — v{__version__}</h3>"
                "<div style='color:#4B5563;margin-bottom:10px;'>"
                "Select a report period, optional Anchor Date, LOB, and "
                "report-wide analysis grain. Specific Month, Specific Week, and "
                "Specific Day use Anchor Date. Every Weekly view uses Sunday "
                "through Saturday only. ALL GRAINS runs Daily, Weekly, and "
                "Monthly independently; a specific grain applies that grain "
                "across grain-sensitive report sections. "
                "Teammate Coaching Opportunities use the fixed configured "
                "Avg Monthly Vol cutoff, no minimum gap threshold, and optional "
                "current-week activity. "
                "The approved executive charts, full native Google Docs report, "
                "dedicated email Executive Summary Google Docs file, and "
                "Google Sheets tabs will be published in the approved Shared Drive "
                "folder. Select <b>ALL - ONE EACH</b> in LOB to generate "
                "separate CORE, PREMIUM, PLUS, and RETAIL reports in one run.</div>"
            )
        )
        controls = widgets.VBox(
            [
                title,
                self.status,
                self.month_dropdown,
                self.anchor_date_picker,
                self.lob_dropdown,
                self.grain_dropdown,
                widgets.HBox([self.run_button, self.reload_button]),
                self.output,
            ]
        )
        display(controls)
        self.initialize()
        return self

    def _on_reload_clicked(self, _button) -> None:
        with self.output:
            clear_output(wait=True)
            print("Reloading source data…")
            try:
                self.initialize()
                print("Source data reloaded successfully.")
            except Exception as exc:
                LOGGER.exception("Source reload failed.")
                self.status.value = (
                    f"<b style='color:#B91C1C;'>Status:</b> Reload failed: {exc}"
                )
                print(f"ERROR: {exc}")

    def _on_run_clicked(self, _button) -> None:
        if (
            self.clients is None
            or self.spreadsheet is None
            or self.normalized_source_df is None
        ):
            self.status.value = (
                "<b style='color:#B91C1C;'>Status:</b> "
                "Source data is not initialized."
            )
            return

        anchor_value = self.anchor_date_picker.value
        selection = ReportSelection(
            report_month=str(self.month_dropdown.value),
            lob=str(self.lob_dropdown.value),
            grain=str(self.grain_dropdown.value),
            anchor_date=(
                anchor_value.isoformat()
                if anchor_value is not None
                else ""
            ),
        )

        runtime_config = self.config

        self.run_button.disabled = True
        self.reload_button.disabled = True
        self.status.value = (
            "<b>Status:</b> Generating the approved executive report…"
        )

        with self.output:
            clear_output(wait=True)
            try:
                print(
                    "Teammate Coaching Opportunities setting: "
                    f"Avg Monthly Vol >= {runtime_config.teammate_coaching_min_avg_monthly_rated:g}; "
                    "no minimum gap; activity in any 2 of last 4 completed weeks required; current week optional; "
                    "Overall consolidates site-selected rows with Site tag and 3M QA"
                )
                results = run_executive_report(
                    selection=selection,
                    clients=self.clients,
                    spreadsheet=self.spreadsheet,
                    normalized_source_df=self.normalized_source_df,
                    source_validation=self.source_validation,
                    config=runtime_config,
                )
                display(
                    widgets.HTML(
                        value=_completion_html_for_results_v536(results)
                    )
                )
                if isinstance(results, Mapping) and results.get("batch_mode"):
                    completed_count = len(results.get("results_by_lob", {}) or {})
                    failed_count = len(results.get("errors_by_lob", {}) or {})
                    self.status.value = (
                        "<b style='color:#166534;'>Status:</b> "
                        f"ALL - ONE EACH completed: {completed_count} "
                        f"completed, {failed_count} failed."
                    )
                else:
                    self.status.value = (
                        "<b style='color:#166534;'>Status:</b> Report completed."
                    )
            except Exception as exc:
                LOGGER.exception("Executive report failed.")
                self.status.value = (
                    f"<b style='color:#B91C1C;'>Status:</b> Report failed: {exc}"
                )
                print("\nREPORT FAILED")
                print("=" * 72)
                print(exc)
                print(
                    "\nCheck the validation message above. The source script "
                    "distinguishes data/schema problems from Google authentication "
                    "or Drive permission problems."
                )
            finally:
                self.run_button.disabled = False
                self.reload_button.disabled = False

