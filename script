def _status_threshold_pp(config: AppConfig = CONFIG) -> float:
    return float(
        getattr(config, "performance_status_threshold_pp", 0.50)
    )


def _volume_threshold_pct(config: AppConfig = CONFIG) -> float:
    return float(
        getattr(config, "volume_status_threshold_pct", 5.00)
    )


def comparison_status(
    current_rate: Any,
    previous_rate: Any,
    *,
    higher_is_better: bool,
    config: AppConfig = CONFIG,
) -> str:
    """Return Improving, Regressing, Stable, or insufficient-data status."""
    current = pd.to_numeric(
        pd.Series([current_rate]),
        errors="coerce",
    ).iloc[0]
    previous = pd.to_numeric(
        pd.Series([previous_rate]),
        errors="coerce",
    ).iloc[0]
    if pd.isna(current) or pd.isna(previous):
        return "Insufficient previous data"

    delta_pp = (float(current) - float(previous)) * 100
    threshold = _status_threshold_pp(config)
    if abs(delta_pp) < threshold:
        return "Stable"

    improved = delta_pp > 0 if higher_is_better else delta_pp < 0
    return "Improving" if improved else "Regressing"


def volume_change_metrics(
    current_volume: Any,
    previous_volume: Any,
    config: AppConfig = CONFIG,
) -> Tuple[float, str]:
    """Return neutral volume percentage change and volume status."""
    current = pd.to_numeric(
        pd.Series([current_volume]),
        errors="coerce",
    ).iloc[0]
    previous = pd.to_numeric(
        pd.Series([previous_volume]),
        errors="coerce",
    ).iloc[0]

    if pd.isna(current) or pd.isna(previous) or float(previous) <= 0:
        return np.nan, "Insufficient previous volume"

    change_pct = (
        (float(current) - float(previous))
        / float(previous)
        * 100
    )
    threshold = _volume_threshold_pct(config)
    if abs(change_pct) < threshold:
        return change_pct, "Stable volume"
    return (
        change_pct,
        "Volume increased"
        if change_pct > 0
        else "Volume decreased",
    )


def _previous_equivalent_window(
    grain: str,
    period_start: pd.Timestamp,
    period_end: pd.Timestamp,
    data_through: pd.Timestamp,
) -> Tuple[pd.Timestamp, pd.Timestamp, str, str]:
    """
    Return the immediately previous like-for-like period.

    Daily compares with the previous UTC calendar day.
    Weekly compares with the prior Sunday-Saturday week using the same elapsed
    number of days when the current week is incomplete.
    Monthly compares with the prior month using the same elapsed number of days
    for MTD; completed months compare with the full previous month.
    """
    grain_name = normalize_text(grain).upper()
    start = pd.Timestamp(period_start).normalize()
    end = pd.Timestamp(period_end).normalize()
    cutoff = min(pd.Timestamp(data_through).normalize(), end)

    if grain_name == "DAILY":
        previous_start = start - pd.Timedelta(days=1)
        previous_end = previous_start
        label = previous_start.strftime("%b %d, %Y")
        basis = "previous day"
        return previous_start, previous_end, label, basis

    if grain_name == "WEEKLY":
        selected_start = sunday_week_start(start)
        elapsed_days = max(0, (cutoff - selected_start).days)
        previous_start = selected_start - pd.Timedelta(days=7)
        previous_end = min(
            previous_start + pd.Timedelta(days=elapsed_days),
            previous_start + pd.Timedelta(days=6),
        )
        label = (
            f"{week_beginning_chart_label(previous_start)} "
            f"({previous_start.strftime('%m/%d/%Y')}–"
            f"{previous_end.strftime('%m/%d/%Y')})"
        )
        basis = (
            "previous week, same elapsed Sunday-through-day cutoff"
            if elapsed_days < 6
            else "previous full Sunday-Saturday week"
        )
        return previous_start, previous_end, label, basis

    if grain_name == "MONTHLY":
        selected_month_start = month_start(start)
        previous_start = selected_month_start - pd.DateOffset(months=1)
        selected_month_end = month_end(selected_month_start)

        if cutoff >= selected_month_end:
            previous_end = month_end(previous_start)
            basis = "previous full month"
        else:
            elapsed_days = max(0, (cutoff - selected_month_start).days)
            previous_end = min(
                month_end(previous_start),
                previous_start + pd.Timedelta(days=elapsed_days),
            )
            basis = "previous month, same elapsed calendar days"

        label = (
            previous_start.strftime("%b %Y")
            if previous_end == month_end(previous_start)
            else (
                f"{previous_start.strftime('%b %d')}–"
                f"{previous_end.strftime('%b %d, %Y')}"
            )
        )
        return previous_start, previous_end, label, basis

    raise ValueError(f"Unsupported comparison grain: {grain}")


def _enrich_period_metric_previous(
    metric: PeriodMetric,
    scope_df: pd.DataFrame,
    config: AppConfig = CONFIG,
) -> PeriodMetric:
    """Populate immediate previous-period fields on a PeriodMetric."""
    (
        previous_start,
        previous_end,
        previous_label,
        comparison_basis,
    ) = _previous_equivalent_window(
        grain=metric.grain,
        period_start=metric.period_start,
        period_end=metric.period_end,
        data_through=metric.data_through,
    )

    previous_df = scope_df[
        scope_df["Date"].between(
            previous_start,
            previous_end,
            inclusive="both",
        )
    ].copy()
    previous_positive, previous_responses, previous_rate = weighted_totals(
        previous_df
    )

    metric.previous_period_start = previous_start
    metric.previous_period_end = previous_end
    metric.previous_period_label = previous_label
    metric.previous_positive = previous_positive
    metric.previous_responses = previous_responses
    metric.previous_rate = previous_rate
    metric.previous_delta = (
        metric.actual_rate - previous_rate
        if pd.notna(metric.actual_rate) and pd.notna(previous_rate)
        else np.nan
    )
    metric.performance_status = comparison_status(
        metric.actual_rate,
        previous_rate,
        higher_is_better=True,
        config=config,
    )
    (
        metric.volume_change_pct,
        metric.volume_status,
    ) = volume_change_metrics(
        metric.actual_responses,
        previous_responses,
        config,
    )
    metric.comparison_basis = comparison_basis
    return metric


