                drive_service=drive_service,
                file_id=DEEP_DIVE_SOURCE_SPREADSHEET_ID,
            )
            source_name = source_metadata.get(
                "name",
                DEEP_DIVE_SOURCE_SHEET_NAME,
            )
            modified_time = source_metadata.get("modifiedTime", "")
            file_size_mb = get_file_size_mb(source_metadata)
        except Exception as meta_exc:
            print(
                "  Could not read Deep Dive file metadata; "
                f"continuing with sheet read. Details: {meta_exc}"
            )

        # Header-based read:
        # Read a wide source range, then resolve the needed fields by header
        # name. This protects the output if Form Responses 2 columns shift.
        read_range_suffix = str(DEEP_DIVE_SOURCE_READ_RANGE).strip()
        a1_range = (
            f"{quote_sheet_title_for_a1(DEEP_DIVE_SOURCE_SHEET_NAME)}!"
            f"{read_range_suffix}"
        )

        values = get_sheet_values(
            sheets_service=sheets_service,
            spreadsheet_id=DEEP_DIVE_SOURCE_SPREADSHEET_ID,
            a1_range=a1_range,
        )

        if not values:
            file_status = "SUCCESS_EMPTY_SOURCE"
            print("Deep Dive source sheet has no values.")
            return empty_result

        headers = [
            normalize_header(header)
            for header in values[0]
        ]

        if not headers:
            raise ValueError(
                "Deep Dive source has no header row. "
                f"Range read: {a1_range}"
            )

        ticket_index = find_header_index_by_alias(
            headers,
            DEEP_DIVE_TICKET_HEADER_ALIASES,
        )
        if ticket_index is None:
            raise ValueError(
                "Deep Dive source missing required ticket column. "
                f"Expected one of: {DEEP_DIVE_TICKET_HEADER_ALIASES}. "
                f"Found headers: {headers}"
            )

        timestamp_index = find_header_index_by_alias(
            headers,
            DEEP_DIVE_TIMESTAMP_HEADER_ALIASES,
        )
        if timestamp_index is None:
            print(
                "  WARNING: Deep Dive timestamp column was not found. "
                "Duplicate Ticket Numbers will use the last matching row "
                "from the source sheet."
            )

        response_indexes = {}
        missing_response_headers = []

        for output_column in DEEP_DIVE_OUTPUT_COLUMNS:
            aliases = DEEP_DIVE_SOURCE_HEADER_ALIASES.get(
                output_column,
                [output_column],
            )
            index = find_header_index_by_alias(headers, aliases)
            if index is None:
                missing_response_headers.append(output_column)
            else:
                response_indexes[output_column] = index

        if missing_response_headers:
            raise ValueError(
                "Deep Dive source missing required response columns: "
                f"{missing_response_headers}. "
                f"Found headers: {headers}"
            )

        required_width_indexes = [
            ticket_index,
            *response_indexes.values(),
        ]
        if timestamp_index is not None:
            required_width_indexes.append(timestamp_index)

        required_width = max(required_width_indexes) + 1

        data_rows = values[1:]
        if not data_rows:
            file_status = "SUCCESS_HEADER_ONLY"
            print("Deep Dive source sheet only has headers.")
            return empty_result

        padded_rows = [
            row + [""] * max(required_width - len(row), 0)
            for row in data_rows
        ]

        deep_dive_df = pd.DataFrame(padded_rows)

        ticket_id_series = normalize_ticket_id_series(
            deep_dive_df.iloc[:, ticket_index]
        )

        if timestamp_index is not None:
            timestamp_series = parse_dates_general(
                deep_dive_df.iloc[:, timestamp_index]
            )
        else:
            timestamp_series = pd.Series(
                pd.NaT,
                index=deep_dive_df.index,
                dtype="datetime64[ns]",
            )

        valid_timestamps = timestamp_series[timestamp_series.notna()]
        if not valid_timestamps.empty:
            latest_timestamp_date = str(valid_timestamps.max().date())

        response_df = pd.DataFrame(
            {
                output_column: deep_dive_df.iloc[:, source_index]
                for output_column, source_index in response_indexes.items()
            },
            index=deep_dive_df.index,
        )

        # Force stable output order even if source columns moved.
        response_df = response_df[DEEP_DIVE_OUTPUT_COLUMNS]

        lookup_df = response_df.copy()
        lookup_df["_ticket_id"] = ticket_id_series
        lookup_df["_timestamp"] = timestamp_series
        lookup_df["_source_row_number"] = list(
            range(2, 2 + len(lookup_df))
        )

        match_mask = (
            lookup_df["_ticket_id"].ne("")
            & lookup_df["_ticket_id"].isin(needed_ticket_ids)
        )
        lookup_df = lookup_df.loc[match_mask].copy()
        matched_rows = len(lookup_df)

        if lookup_df.empty:
            print("No Deep Dive rows matched Merchant Ticket IDs.")
            return empty_result

        # Latest response wins. Timestamp is the primary recency field.
        # If Timestamp is blank or invalid, source row number keeps the last
        # matching row as fallback.
        lookup_df["_timestamp_sort"] = lookup_df["_timestamp"].fillna(
            pd.Timestamp.min
        )
        lookup_df = lookup_df.sort_values(
            by=[
                "_ticket_id",
                "_timestamp_sort",
                "_source_row_number",
            ],
            ascending=[True, True, True],
        )
        latest_df = lookup_df.drop_duplicates(
            subset=["_ticket_id"],
            keep="last",
        )

        deep_dive_by_ticket_id = {}
        for _, row in latest_df.iterrows():
            ticket_id = row["_ticket_id"]
            row_output = {}
            for column in DEEP_DIVE_OUTPUT_COLUMNS:
                if column == "Contact Category":
                    row_output[column] = normalize_contact_category_output_value(
                        row[column]
                    )
                else:
                    row_output[column] = normalize_no_data_output_value(
                        row[column]
                    )

            deep_dive_by_ticket_id[ticket_id] = row_output

        print("Deep Dive header-based mapping used:")
        print(f"  Ticket column: {headers[ticket_index]}")
        if timestamp_index is not None:
            print(f"  Timestamp column: {headers[timestamp_index]}")
        else:
            print("  Timestamp column: not found; using source row order")
        for output_column in DEEP_DIVE_OUTPUT_COLUMNS:
            source_index = response_indexes[output_column]
            print(
                f"  {output_column}: source column "
                f"{column_number_to_letter(source_index + 1)} "
                f"({headers[source_index]})"
            )

        print(
            f"Deep Dive matched source rows: "
            f"{matched_rows:,}"
        )
        print(
            f"Deep Dive unique matched Ticket IDs: "
            f"{len(deep_dive_by_ticket_id):,}"
        )

        return {
            "deep_dive_by_ticket_id": deep_dive_by_ticket_id,
        }

    except Exception as exc:
        file_status = f"FAILED: {exc}"
        print(f"ERROR processing Deep Dive source sheet: {exc}")
        raise

    finally:
        summary_rows.append(
            [
                "DEEP_DIVE_LOOKUPS",
                run_timestamp,
                LOOKBACK_WEEKS,
                str(window_start_date),
                str(window_end_date),
                source_name,
                latest_timestamp_date,
                f"{DEEP_DIVE_SOURCE_SHEET_NAME} "
                f"(gid={DEEP_DIVE_SOURCE_GID})",
                modified_time,
                file_size_mb,
                matched_rows,
                file_status,
            ]
        )
        PROGRESS.update(1, "Deep Dive lookup complete")



