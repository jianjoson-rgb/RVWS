            return _docx_v570_join_bullets(teammate_lines, max_chars=max_chars)
        if grain in {"DAILY", "WEEKLY"}:
            return "Not applicable — Monthly only."
        return "N/A"

    if area_key == "recommended action":
        return _docx_v570_join_bullets(
            _docx_v570_block_paragraph_texts(readout, ["recommended action"]),
