def prepare_needed_lookup_keys(merchant_df):
    if merchant_df.empty:
        return set(), set(), set()

    ticket_ids = set(
        normalize_ticket_id_series(
            merchant_df["Ticket ID"]
        ).tolist()
    )
    ticket_ids.discard("")

    combined_keys = set(
        build_combined_key_series(
            merchant_df["Ticket ID"],
            merchant_df["Employee Name"],
        ).tolist()
    )
    combined_keys.discard("")

    name_keys = set(
        normalize_lookup_series(
            merchant_df["Employee Name"]
        ).tolist()
    )
    name_keys.discard("")

    return ticket_ids, combined_keys, name_keys


