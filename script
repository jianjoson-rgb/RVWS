def _v573_clean_hierarchy_label(value: Any) -> str:
    cleaned = _v572_clean_driver_label(value)
    if normalize_text(cleaned).lower() in V573_MISSING_LABELS:
        return ""
    return normalize_text(cleaned)


def _v573_prepare_hierarchy_frame(
    source_df: pd.DataFrame,
    columns: Sequence[str],
) -> pd.DataFrame:
    if source_df is None or not isinstance(source_df, pd.DataFrame) or source_df.empty:
        return pd.DataFrame()

    work = source_df.copy()
    for col in columns:
        if col not in work.columns:
            work[col] = ""
        work[col] = work[col].map(_v573_clean_hierarchy_label)

    responses = _v572_response_series(work).reindex(work.index).fillna(0.0).clip(lower=0.0)
    smiley_rate = (
        normalize_rate_series(work["Smiley Rate"]).reindex(work.index).fillna(0.0).clip(lower=0.0, upper=1.0)
        if "Smiley Rate" in work.columns
        else pd.Series(0.0, index=work.index)
    )
    masks = _v572_outcome_masks(work)

    work["_v573_responses"] = responses
    work["_v573_smiley_count"] = smiley_rate * responses
    work["_v573_smiley_mask"] = masks["smiley"].reindex(work.index).fillna(False).astype(bool)
    work["_v573_non_smiley_mask"] = masks["non_smiley"].reindex(work.index).fillna(False).astype(bool)
    return work


def _v573_top_values_for_subset(
    df: pd.DataFrame,
    column: str,
    *,
    top_n: int,
) -> List[str]:
    if df is None or df.empty or column not in df.columns:
        return []
    usable = df[df[column].map(normalize_text).ne("")].copy()
    if usable.empty:
        return []
    grouped = (
        usable.groupby(column, dropna=False)["_v573_responses"]
        .sum()
        .reset_index(name="_Volume")
        .sort_values(["_Volume", column], ascending=[False, True])
    )
    return [normalize_text(value) for value in grouped[column].head(top_n).tolist() if normalize_text(value)]


def _v573_top_drilldown_for_subset(df: pd.DataFrame, drilldown_col: Optional[str]) -> str:
    if not drilldown_col or df is None or df.empty or drilldown_col not in df.columns:
        return ""
    values = _v573_top_values_for_subset(df, drilldown_col, top_n=1)
    return values[0] if values else ""


def _v573_path_mask(
    df: pd.DataFrame,
    level1_col: str,
    level2_col: str,
    level3_col: str,
    drilldown_col: Optional[str],
    level1_value: str,
    level2_value: str,
    level3_value: str,
    drilldown_value: str = "",
) -> pd.Series:
    mask = df[level1_col].eq(level1_value)
    if level2_value:
        mask = mask & df[level2_col].eq(level2_value)
    if level3_value:
        mask = mask & df[level3_col].eq(level3_value)
    if drilldown_col and drilldown_value and drilldown_col in df.columns:
        mask = mask & df[drilldown_col].eq(drilldown_value)
    return mask.fillna(False)


def _v573_human_path(*parts: Any) -> str:
    clean_parts = [_v573_clean_hierarchy_label(part) for part in parts if _v573_clean_hierarchy_label(part)]
    return " → ".join(clean_parts) if clean_parts else "N/A"


def _v573_hierarchy_records_for_grain(
    df: pd.DataFrame,
    *,
    grain: str,
    period_label: str,
    level1_col: str,
    level2_col: str,
    level3_col: str,
    drilldown_col: Optional[str] = None,
    metric_kind: str = "reason",
    valid_mask: Optional[pd.Series] = None,
) -> List[Dict[str, Any]]:
    columns = [level1_col, level2_col, level3_col] + ([drilldown_col] if drilldown_col else [])
    work = _v573_prepare_hierarchy_frame(df, columns)
    if work.empty or level1_col not in work.columns:
        return []

    base_mask = work["_v573_non_smiley_mask"].fillna(False)
    if valid_mask is not None:
        try:
            valid_aligned = valid_mask.reindex(work.index).fillna(False).astype(bool)
            base_mask = base_mask & valid_aligned
        except Exception:
            pass

    selection = work[base_mask & work[level1_col].map(normalize_text).ne("")].copy()
    if selection.empty:
        return []

    total_non_smiley = float(selection["_v573_responses"].sum())
    if total_non_smiley <= 0:
        total_non_smiley = float(len(selection))
    if total_non_smiley <= 0:
        return []

    records: List[Dict[str, Any]] = []
    l1_values = _v573_top_values_for_subset(selection, level1_col, top_n=2)
    for l1_index, l1_value in enumerate(l1_values, start=1):
        l1_subset = selection[selection[level1_col].eq(l1_value)].copy()
        l2_values = _v573_top_values_for_subset(l1_subset, level2_col, top_n=2)
        if not l2_values:
            l2_values = [""]

        for l2_index, l2_value in enumerate(l2_values, start=1):
            l2_subset = l1_subset[l1_subset[level2_col].eq(l2_value)].copy() if l2_value else l1_subset.copy()
            l3_values = _v573_top_values_for_subset(l2_subset, level3_col, top_n=3)
            if not l3_values:
                l3_values = [""]

            for l3_index, l3_value in enumerate(l3_values, start=1):
                l3_subset = l2_subset[l2_subset[level3_col].eq(l3_value)].copy() if l3_value else l2_subset.copy()
                drilldown_value = _v573_top_drilldown_for_subset(l3_subset, drilldown_col)
                path_mask = _v573_path_mask(
                    work,
                    level1_col,
                    level2_col,
                    level3_col,
                    drilldown_col,
                    l1_value,
                    l2_value,
                    l3_value,
                    drilldown_value,
                )
                path_non_smiley_mask = path_mask & work["_v573_non_smiley_mask"]
                if valid_mask is not None:
                    try:
                        path_non_smiley_mask = path_non_smiley_mask & valid_mask.reindex(work.index).fillna(False).astype(bool)
                    except Exception:
                        pass

                path_non_smiley = work[path_non_smiley_mask].copy()
                non_smiley_surveys = float(path_non_smiley["_v573_responses"].sum()) if not path_non_smiley.empty else 0.0
                if non_smiley_surveys <= 0:
                    continue

                path_all = work[path_mask].copy()
                total_responses = float(path_all["_v573_responses"].sum()) if not path_all.empty else 0.0
                smiley_rate_value = (
                    safe_rate(float(path_all["_v573_smiley_count"].sum()), total_responses)
                    if total_responses > 0
                    else np.nan
                )

                record: Dict[str, Any] = {
                    "Path Rank": f"{l1_index}.{l2_index}.{l3_index}",
                    "Grain": normalize_text(grain).title(),
                    "Period": normalize_text(period_label),
                    "Level 1": l1_value or "N/A",
                    "Level 2": l2_value or "N/A",
                    "Level 3": l3_value or "N/A",
                    "Drilldown": drilldown_value or "N/A",
                    "Path": _v573_human_path(l1_value, l2_value, l3_value, drilldown_value),
                    "Non-Smiley Surveys": non_smiley_surveys,
                    "Share": safe_rate(non_smiley_surveys, total_non_smiley),
                    "Smiley Rate": smiley_rate_value,
                    "Sample": sample_size_label(non_smiley_surveys),
                }

                if metric_kind == "aht":
                    aht_values = _v572_numeric_series(work, "Chat Average Handle Time")
                    if not aht_values.empty:
                        valid_aht = aht_values.notna()
                        smiley_values = aht_values[path_mask & work["_v573_smiley_mask"] & valid_aht]
                        non_smiley_values = aht_values[path_mask & work["_v573_non_smiley_mask"] & valid_aht]
                        smiley_avg = float(smiley_values.mean()) if not smiley_values.empty else np.nan
                        non_smiley_avg = float(non_smiley_values.mean()) if not non_smiley_values.empty else np.nan
                        record["Smiley Avg AHT"] = smiley_avg
                        record["Non-Smiley Avg AHT"] = non_smiley_avg
                        record["AHT Gap"] = (
                            non_smiley_avg - smiley_avg
                            if pd.notna(smiley_avg) and pd.notna(non_smiley_avg)
                            else np.nan
                        )
                        record["Valid AHT Surveys"] = int((path_mask & valid_aht).sum())
                    else:
                        record["Smiley Avg AHT"] = np.nan
                        record["Non-Smiley Avg AHT"] = np.nan
                        record["AHT Gap"] = np.nan
                        record["Valid AHT Surveys"] = 0

                elif metric_kind == "aftr":
                    path_df = work[path_mask].copy()
                    smiles = path_df[path_df["_v573_smiley_mask"]].copy()
                    nons = path_df[path_df["_v573_non_smiley_mask"]].copy()
                    smiley_aftr = _v572_aftr_rate(smiles).get("rate", np.nan)
                    non_smiley_aftr = _v572_aftr_rate(nons).get("rate", np.nan)
                    record["Smiley AFTR %"] = smiley_aftr
                    record["Non-Smiley AFTR %"] = non_smiley_aftr
                    record["AFTR Gap"] = (
                        smiley_aftr - non_smiley_aftr
                        if pd.notna(smiley_aftr) and pd.notna(non_smiley_aftr)
                        else np.nan
                    )
                    try:
                        record["Valid AFTR Surveys"] = int((_v572_aftr_valid_mask(path_df)).sum())
                    except Exception:
                        record["Valid AFTR Surveys"] = 0

                records.append(record)

    return records


def _v573_hierarchy_records(
    grain_results: Mapping[str, GrainResult],
    *,
    level1_col: str,
    level2_col: str,
    level3_col: str,
    drilldown_col: Optional[str] = None,
    metric_kind: str = "reason",
    allowed_grains: Sequence[str] = V572_GRAIN_ORDER,
) -> List[Dict[str, Any]]:
    records: List[Dict[str, Any]] = []
    for grain in allowed_grains:
        result = grain_results.get(grain) if isinstance(grain_results, Mapping) else None
        if result is None:
            continue
        df = getattr(result, "current_period_df", pd.DataFrame())
        metric = getattr(result, "overall", None)
        if df is None or not isinstance(df, pd.DataFrame) or df.empty:
            continue

        valid_mask = None
        if metric_kind == "aht":
            aht_series = _v572_numeric_series(df, "Chat Average Handle Time")
            valid_mask = aht_series.notna() if not aht_series.empty else pd.Series(False, index=df.index)
        elif metric_kind == "aftr":
            valid_mask = _v572_aftr_valid_mask(df)

        records.extend(
            _v573_hierarchy_records_for_grain(
                df,
                grain=grain,
                period_label=_email_v551_current_period_label(metric) if metric is not None else grain.title(),
                level1_col=level1_col,
                level2_col=level2_col,
                level3_col=level3_col,
                drilldown_col=drilldown_col,
                metric_kind=metric_kind,
                valid_mask=valid_mask,
            )
        )
    return records


def _v573_first_hierarchy_path(records: Sequence[Mapping[str, Any]], *, grain: Optional[str] = None) -> Optional[Mapping[str, Any]]:
    candidates = [
        record
        for record in records
        if (not grain or normalize_text(record.get("Grain", "")).lower() == normalize_text(grain).lower())
    ]
    if not candidates:
        return None
    return sorted(
        candidates,
        key=lambda item: (
            _email_v551_num(item.get("Non-Smiley Surveys", 0.0)) if pd.notna(_email_v551_num(item.get("Non-Smiley Surveys", 0.0))) else 0.0,
            _email_v551_num(item.get("Share", 0.0)) if pd.notna(_email_v551_num(item.get("Share", 0.0))) else 0.0,
        ),
        reverse=True,
    )[0]


