def _v572_numeric_series(df: pd.DataFrame, column: str) -> pd.Series:
    if df is None or not isinstance(df, pd.DataFrame) or df.empty or column not in df.columns:
        return pd.Series(dtype="float64")
    return _email_v567_clean_numeric_series(df, column)


def _v572_response_series(df: pd.DataFrame) -> pd.Series:
    if df is None or not isinstance(df, pd.DataFrame) or df.empty:
        return pd.Series(dtype="float64")
    if "Responses" in df.columns:
        values = pd.to_numeric(df["Responses"], errors="coerce").fillna(0.0)
    else:
        values = pd.Series(1.0, index=df.index, dtype="float64")
    return values.clip(lower=0.0)


def _v572_outcome_masks(df: pd.DataFrame) -> Dict[str, pd.Series]:
    if df is None or not isinstance(df, pd.DataFrame) or df.empty:
        blank = pd.Series(dtype="bool")
        return {"smiley": blank, "non_smiley": blank}
    outcomes = _email_v565_outcome_series(df)
    smiley = outcomes.eq("Smiley")
    non_smiley = outcomes.isin(["Neutral", "Frownie", "Non-Smiley"])
    if "Non-Smiley Survey" in df.columns:
        non_smiley_raw = pd.to_numeric(df["Non-Smiley Survey"], errors="coerce").fillna(0.0).gt(0)
        non_smiley = non_smiley | non_smiley_raw
    if "Smiley Rate" in df.columns:
        smiley_raw = normalize_rate_series(df["Smiley Rate"]).fillna(0.0).gt(0)
        smiley = smiley | smiley_raw
        non_smiley = non_smiley | normalize_rate_series(df["Smiley Rate"]).fillna(0.0).eq(0)
    return {"smiley": smiley.fillna(False), "non_smiley": non_smiley.fillna(False)}


def _v572_filtered_outcome_df(df: pd.DataFrame, outcome: str) -> pd.DataFrame:
    if df is None or not isinstance(df, pd.DataFrame) or df.empty:
        return pd.DataFrame()
    masks = _v572_outcome_masks(df)
    outcome_key = normalize_text(outcome).lower()
    if outcome_key == "smiley":
        return df[masks["smiley"]].copy()
    if outcome_key in {"non-smiley", "non_smiley", "non smiley"}:
        return df[masks["non_smiley"]].copy()
    return df.copy()


def _v572_clean_driver_label(value: Any) -> str:
    try:
        cleaned = _email_v565_clean_label(value)
    except Exception:
        cleaned = normalize_text(value)
        if cleaned.lower() in {"", "-", "–", "—", "null", "none", "nan", "n/a", "na", "(blank)", "blank", "no data"}:
            return ""
    return normalize_text(cleaned)


def _v572_top_path_record(
    source_df: pd.DataFrame,
    columns: Sequence[str],
    *,
    outcome: Optional[str] = None,
    label: str = "driver",
) -> Dict[str, Any]:
    """Return the top path split into separate columns and weighted by rated responses."""
    empty_result: Dict[str, Any] = {
        "available": False,
        "label": label,
        "path": "",
        "count": 0.0,
        "share": np.nan,
        "smiley_rate": np.nan,
    }
    for col in columns:
        empty_result[col] = ""

    if source_df is None or not isinstance(source_df, pd.DataFrame) or source_df.empty:
        return empty_result

    work = source_df.copy()
    if outcome:
        work = _v572_filtered_outcome_df(work, outcome)
    if work.empty:
        return empty_result

    available_columns = [col for col in columns if col in work.columns]
    if not available_columns:
        return empty_result

    responses = _v572_response_series(work)
    smiley_total_series = (
        normalize_rate_series(work["Smiley Rate"]).fillna(0.0).clip(lower=0.0)
        if "Smiley Rate" in work.columns
        else pd.Series(0.0, index=work.index)
    )
    denominator = float(responses.sum())
    if denominator <= 0:
        denominator = float(len(work))

    cleaned_cols: Dict[str, List[str]] = {}
    for col in available_columns:
        cleaned_cols[col] = [_v572_clean_driver_label(value) for value in work[col].tolist()]

    tmp = pd.DataFrame(cleaned_cols, index=work.index)
    tmp["_Responses"] = responses.reindex(work.index).fillna(0.0).values
    tmp["_Smiley"] = smiley_total_series.reindex(work.index).fillna(0.0).values
    keep = pd.Series(False, index=tmp.index)
    for col in available_columns:
        keep = keep | tmp[col].map(normalize_text).ne("")
    tmp = tmp[keep].copy()
    if tmp.empty:
        return empty_result

    group_cols = available_columns
    grouped = (
        tmp.groupby(group_cols, dropna=False)
        .agg(Responses=("_Responses", "sum"), Smiley=("_Smiley", "sum"))
        .reset_index()
    )
    grouped = grouped[grouped["Responses"].gt(0)].copy()
    if grouped.empty:
        return empty_result

    grouped["_Path"] = grouped[group_cols].apply(
        lambda row: " → ".join([normalize_text(row[col]) for col in group_cols if normalize_text(row[col])]),
        axis=1,
    )
    grouped = grouped[grouped["_Path"].map(normalize_text).ne("")].copy()
    if grouped.empty:
        return empty_result

    grouped["_SmileyRate"] = grouped.apply(lambda row: safe_rate(row["Smiley"], row["Responses"]), axis=1)
    grouped = grouped.sort_values(["Responses", "_Path"], ascending=[False, True], na_position="last")
    top = grouped.iloc[0]

    result = {
        "available": True,
        "label": label,
        "path": normalize_text(top.get("_Path", "")),
        "count": float(top.get("Responses", 0.0) or 0.0),
        "share": safe_rate(float(top.get("Responses", 0.0) or 0.0), denominator),
        "smiley_rate": top.get("_SmileyRate", np.nan),
    }
    for col in columns:
        result[col] = normalize_text(top.get(col, "")) if col in top.index else ""
    return result


def _v572_top_path_string(path_record: Mapping[str, Any], fallback: str = "No usable driver path") -> str:
    if not path_record or not path_record.get("available"):
