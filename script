        file_size_mb = (
            round(
                int(file_meta.get("size", 0))
                / (1024 * 1024),
                2,
            )
            if file_meta.get("size")
            else ""
        )
        matched_rows = 0
        invalid_date_rows = 0
        file_status = "SUCCESS"
        local_csv = None

        print("--------------------------------------------------")
        print(f"Processing taxonomy file: {file_name}")
        PROGRESS.set_message(
            f"Processing taxonomy file: {file_name}"
        )

        try:
            local_csv = download_drive_file_with_retry(
                drive_service,
                file_meta["id"],
                file_name,
                "taxonomy_csv_",
            )

            header_df = pd.read_csv(
