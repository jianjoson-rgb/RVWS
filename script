def _authoritative_smiley_metrics_v565(
    group: pd.DataFrame,
) -> Dict[str, Any]:
    """
    Calculate the exact rate definition used by the main trend charts.

    Smiley Rate = SUM(Smiley Numerator) / SUM(Responses)
    Unhappy Rate = 1 - Smiley Rate

    This helper is intentionally used only for timeframe-table display values.
    Existing narratives, charts, QA analysis, and other report logic remain
    unchanged.
    """
    if group is None or group.empty:
        return {
            "Rated": 0.0,
            "Positive": 0.0,
            "Smiley Rate": np.nan,
            "Unhappy Rate": np.nan,
        }

    responses = pd.to_numeric(
        group.get("Responses", pd.Series(0, index=group.index)),
        errors="coerce",
    ).fillna(0.0).sum()

    positive = pd.to_numeric(
        group.get(
            "Smiley Numerator",
            pd.Series(0, index=group.index),
        ),
        errors="coerce",
    ).fillna(0.0).sum()

    rate = (
        float(positive) / float(responses)
        if float(responses) > 0
        else np.nan
    )
    if pd.notna(rate):
        rate = float(min(1.0, max(0.0, rate)))

    unhappy_rate = (
        1.0 - rate
        if pd.notna(rate)
        else np.nan
    )

    return {
        "Rated": float(responses),
        "Positive": float(positive),
        "Smiley Rate": rate,
        "Unhappy Rate": unhappy_rate,
    }


def _authoritative_population_metrics_v565(
    group: pd.DataFrame,
) -> Dict[str, Any]:
    """
    Return table-only All / Finance / Other metrics using trend-chart math.
    """
    if group is None:
        group = pd.DataFrame()

    if "Finance Classification" not in group.columns:
        classifications = pd.Series(
            "",
            index=group.index,
            dtype="object",
        )
    else:
        classifications = group["Finance Classification"].map(
            normalize_text
        )

    subsets = {
        "All": group,
        "Finance": group[
            classifications.eq("Finance")
        ],
        "Other": group[
            classifications.eq("Other")
        ],
    }

    output: Dict[str, Any] = {}
    for prefix, subset in subsets.items():
        metrics = _authoritative_smiley_metrics_v565(subset)
        output[f"Table {prefix} Rated"] = metrics["Rated"]
        output[
            f"Table {prefix} Smiley Rate"
        ] = metrics["Smiley Rate"]
        output[
            f"Table {prefix} Unhappy Rate"
        ] = metrics["Unhappy Rate"]

    finance_smiley = output["Table Finance Smiley Rate"]
    other_smiley = output["Table Other Smiley Rate"]
    output["Table Finance vs Other Smiley Gap (pp)"] = (
        (finance_smiley - other_smiley) * 100
        if pd.notna(finance_smiley)
        and pd.notna(other_smiley)
        else np.nan
    )

    finance_unhappy = output["Table Finance Unhappy Rate"]
    other_unhappy = output["Table Other Unhappy Rate"]
    output["Table Finance vs Other Unhappy Gap (pp)"] = (
        (finance_unhappy - other_unhappy) * 100
        if pd.notna(finance_unhappy)
        and pd.notna(other_unhappy)
        else np.nan
    )
    return output




def _smiley_registered_view_v567(
    df: pd.DataFrame,
) -> pd.DataFrame:
    """
    Build an isolated trend/timeframe view keyed only by Smiley Registered At.

    This does NOT mutate the report's original Date field outside this view.
    It is used only for:
      - trend image calculations
      - timeframe table calculations

    Smiley Registered At is treated exactly as supplied by the source because
    the column does not declare a timezone.
    """
    if df is None or df.empty:
        return pd.DataFrame(columns=getattr(df, "columns", None))

    if "Smiley Registered At" not in df.columns:
        raise ValueError(
            "The source is missing the required 'Smiley Registered At' column."
        )

    work = df.copy()
    registered_at = pd.to_datetime(
        work["Smiley Registered At"],
        errors="coerce",
    )
    work["_Smiley Registered Timestamp"] = registered_at
    work["Smiley Registered Date"] = registered_at.dt.normalize()

    # Trend-only Date dimensions. Original report calculations continue using
    # their own untouched DataFrame.
    work["Date"] = work["Smiley Registered Date"]
    work["Month Key"] = work["Date"].dt.strftime("%Y-%m")
    work["Month Start"] = (
        work["Date"].dt.to_period("M").dt.to_timestamp()
    )
    work["Week Start"] = work["Date"].apply(
        lambda value: (
            sunday_week_start(value)
            if pd.notna(value)
            else pd.NaT
        )
    )
    work["Week End"] = (
        work["Week Start"] + pd.Timedelta(days=6)
    )

    # Rows with no Smiley Registered At cannot participate in either the trend
    # images or timeframe tables because both are now keyed to that timestamp.
    return work[
        work["_Smiley Registered Timestamp"].notna()
    ].copy()


def _build_smiley_registered_trend_context_v567(
    filtered_df: pd.DataFrame,
    selection: ReportSelection,
    grains: Sequence[str],
