    lob = safe_filename(normalize_text(getattr(selection, "lob", "")) or "LOB")
    label = safe_filename(normalize_text(report_scope.get("report_label", "")) or "report")
    stamp = timestamp_slug()
    candidates = [
        Path(getattr(config, "output_dir", "/content/whitepaper_report")),
        Path(getattr(config, "local_fallback_output_dir", "/mnt/data/whitepaper_report")),
        Path("/tmp/whitepaper_report"),
    ]

    last_error: Optional[Exception] = None
    for base in candidates:
        try:
            output_dir = base / "email_grain_charts" / safe_filename(f"{lob}_{label}_{stamp}")
            output_dir.mkdir(parents=True, exist_ok=True)
            return output_dir
        except Exception as exc:
            last_error = exc
            continue

    raise RuntimeError(f"Could not create email grain chart output folder: {last_error}")


def _email_v560_chart_filename_for_grain(
    grain: str,
    readout: Mapping[str, Any],
) -> str:
    """Build a stable, readable file name for an email grain chart."""
    grain_label = normalize_text(grain).upper() or "GRAIN"
    period = safe_filename(normalize_text(readout.get("period_label", "")) or "period")
    return safe_filename(f"{grain_label}_Email_Trend_Chart_{period}.png")



def _email_v561_set_panel_header_and_legend(
    ax,
    title: str,
    grain: str,
    metric: PeriodMetric,
    config: AppConfig = CONFIG,
) -> None:
    """
    Email-only single-panel chart header.

    The main dashboard keeps the approved combined-dashboard layout.  The email
    doc uses one chart per grain, so the global dashboard title is intentionally
    removed and the legend is placed on its own line to prevent overlap with the
    panel title when Google Docs/Gmail scales the embedded image.
    """
    ax.text(
        0.0,
        1.205,
        title,
        transform=ax.transAxes,
        ha="left",
        va="bottom",
        fontsize=14.4,
        fontweight="bold",
        color=config.chart_title_color,
        clip_on=False,
    )

    if not config.chart_show_panel_legends:
        return

    handles = _panel_legend_handles(grain, metric, config)
    grain = normalize_text(grain).upper()
    ncol = 5 if grain == "DAILY" else 4

    ax.legend(
        handles=handles,
        loc="lower left",
        bbox_to_anchor=(0.0, 1.065),
        ncol=ncol,
        frameon=False,
        fontsize=7.15,
        handlelength=2.05,
        columnspacing=0.82,
        handletextpad=0.42,
        borderaxespad=0.0,
    )


def _email_v561_build_clean_single_grain_chart(
    *,
    grain: str,
    metric: PeriodMetric,
    output_path: Path,
    selection: ReportSelection,
    report_scope: Mapping[str, Any],
    config: AppConfig = CONFIG,
) -> str:
    """Build a clean one-grain email chart without overlapping title/legend text."""
    grain = normalize_text(grain).upper()
    if grain not in {"DAILY", "WEEKLY", "MONTHLY"}:
        return ""
    if metric is None:
        return ""

    try:
        data_through = pd.Timestamp(
            report_scope.get(
                "data_through",
                getattr(metric, "period_end", now_manila().tz_localize(None)),
            )
        )
    except Exception:
        data_through = now_manila().tz_localize(None)

    figure_height = max(5.25, float(getattr(config, "chart_panel_height_inches", 4.2)) + 1.60)
    fig = plt.figure(
        figsize=(config.chart_width_inches, figure_height),
        facecolor="white",
    )
    gs = GridSpec(
        1,
        2,
        figure=fig,
        width_ratios=[6.1, 1.08],
        left=0.058,
        right=0.986,
        top=0.775,
        bottom=0.165,
        wspace=0.04,
    )

    ax = fig.add_subplot(gs[0, 0])
    card_ax = fig.add_subplot(gs[0, 1])

    original_header = globals().get("_set_panel_header_and_legend")
    globals()["_set_panel_header_and_legend"] = _email_v561_set_panel_header_and_legend

    try:
        if grain == "DAILY":
            _plot_daily_panel(ax, card_ax, metric, config, shared_ylim=None)
        elif grain == "WEEKLY":
            _plot_weekly_panel(ax, card_ax, metric, config, shared_ylim=None)
        elif grain == "MONTHLY":
            _plot_monthly_panel(ax, card_ax, metric, config, shared_ylim=None)
    finally:
        if original_header is not None:
            globals()["_set_panel_header_and_legend"] = original_header

    _add_panel_border(fig, ax, card_ax, config)

    lob_label = normalize_text(getattr(selection, "lob", "")) or ""
    report_label = normalize_text(report_scope.get("report_label", "")) or grain.title()
    footer_color = "#172033"
    fig.text(
        0.012,
        0.032,
        f"pp = percentage points | Smiley Target = {format_rate(config.target_rate, decimals=1)}",
        ha="left",
        va="bottom",
        fontsize=8.2,
        color=footer_color,
    )
    fig.text(
        0.5,
        0.032,
        f"{lob_label.title()} | {report_label} | Data through: "
        f"{pd.Timestamp(data_through).strftime('%b %d, %Y')}",
        ha="center",
        va="bottom",
        fontsize=8.2,
        color=footer_color,
    )

    output = Path(output_path)
    output.parent.mkdir(parents=True, exist_ok=True)
    fig.savefig(
        output,
        dpi=config.chart_dpi,
        bbox_inches="tight",
        pad_inches=0.16,
        facecolor="white",
    )
    plt.close(fig)
    return str(output)


def _email_v560_build_grain_chart(
    *,
    grain: str,
    grain_result: GrainResult,
    output_path: Path,
    selection: ReportSelection,
    report_scope: Mapping[str, Any],
    config: AppConfig = CONFIG,
) -> str:
    """
    Build one clean grain trend chart for the email-only Google Doc.

    v5.7.61 keeps the main executive dashboard unchanged.  The email-only
    separated charts are rendered with a dedicated single-panel layout so the
    chart title, legend, KPI card, x-axis labels, and footer do not overlap
    when imported into Google Docs or viewed in Gmail.
    """
    grain = normalize_text(grain).upper()
    metric = getattr(grain_result, "overall", None)
    if metric is None:
        return ""

    try:
        return _email_v561_build_clean_single_grain_chart(
            grain=grain,
            metric=metric,
            output_path=output_path,
            selection=selection,
            report_scope=report_scope,
            config=config,
        )
    except Exception as exc:
        LOGGER.warning("Could not build clean %s email trend chart: %s", grain, exc)
        return ""

def _email_v560_attach_grain_charts_to_payload(
    payload: MutableMapping[str, Any],
    *,
    selection: ReportSelection,
    report_scope: Mapping[str, Any],
    grain_results: Mapping[str, GrainResult],
    config: AppConfig = CONFIG,
) -> Dict[str, Any]:
    """Attach local one-grain chart paths to detailed readout payload blocks."""
    readouts = payload.get("detailed_readouts", [])
    if not isinstance(readouts, list) or not readouts:
        return dict(payload)

    try:
        output_dir = _email_v560_chart_output_dir(selection, report_scope, config=config)
    except Exception as exc:
        LOGGER.warning("Email grain chart folder could not be created: %s", exc)
        return dict(payload)

    updated_readouts: List[Dict[str, Any]] = []
    for readout in readouts:
        if not isinstance(readout, Mapping):
            updated_readouts.append(dict(readout or {}))
            continue

        readout_copy = dict(readout)
        grain = normalize_text(readout_copy.get("grain", "")).upper()
        if not grain:
            title = normalize_text(readout_copy.get("title", "")).upper()
            if "DAILY" in title:
                grain = "DAILY"
            elif "WEEKLY" in title:
                grain = "WEEKLY"
            elif "MONTHLY" in title:
                grain = "MONTHLY"

        grain_result = grain_results.get(grain)
        if grain_result is None:
            updated_readouts.append(readout_copy)
            continue

        output_path = output_dir / _email_v560_chart_filename_for_grain(grain, readout_copy)
        chart_path = _email_v560_build_grain_chart(
            grain=grain,
            grain_result=grain_result,
            output_path=output_path,
            selection=selection,
            report_scope=report_scope,
            config=config,
        )
        if chart_path and Path(chart_path).exists():
            readout_copy["chart_path"] = chart_path
            readout_copy["chart_title"] = {
                "DAILY": "Daily Smiley Trend Chart",
                "WEEKLY": "Weekly Smiley Trend Chart",
                "MONTHLY": "Monthly Smiley Trend Chart",
            }.get(grain, f"{grain.title()} Smiley Trend Chart")
            readout_copy["chart_alt_text"] = (
                f"{readout_copy['chart_title']} for "
                f"{normalize_text(readout_copy.get('period_label', 'the selected period'))}"
            )

        updated_readouts.append(readout_copy)

    payload["detailed_readouts"] = updated_readouts
    payload["email_grain_chart_paths"] = [
        normalize_text(readout.get("chart_path", ""))
        for readout in updated_readouts
        if normalize_text(readout.get("chart_path", ""))
    ]
    return dict(payload)


