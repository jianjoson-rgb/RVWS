class ProgressTracker:
    def __init__(self, enabled=True, description="Master Loader"):
        self.enabled = bool(enabled and tqdm is not None)
        self.description = description
        self.bar = None
        self.total = 0
        self.completed = 0
        self.started = False

    def start(self):
        self.started = True
        if self.enabled:
            self.bar = tqdm(
                total=0,
                desc=self.description,
                unit="step",
                dynamic_ncols=True,
            )
        else:
            print(f"{self.description} started.")

    def add_total(self, units=1):
        units = int(max(units or 0, 0))
        if units == 0:
            return
        self.total += units
        if self.bar is not None:
            self.bar.total = self.total
            self.bar.refresh()

    def update(self, units=1, message=None):
        units = int(max(units or 0, 0))
        if units == 0:
            return
        self.completed += units
        if self.bar is not None:
            if message:
                self.bar.set_description_str(str(message)[:80])
            self.bar.update(units)
            self.bar.refresh()
        elif message:
            print(f"[{self.completed}/{self.total}] {message}")

    def set_message(self, message):
        if self.bar is not None:
            self.bar.set_description_str(str(message)[:80])
            self.bar.refresh()
        elif message:
            print(message)

    def close(self):
        if self.bar is not None:
            self.bar.close()
        elif self.started:
            print(f"{self.description} complete.")


