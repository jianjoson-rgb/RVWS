    site_grain_results: Mapping[str, GrainResult],
    overall_grain_results: Mapping[str, GrainResult],
    active: Sequence[str],
    config: AppConfig = CONFIG,
) -> List[List[Dict[str, Any]]]:
    """Build site-specific Executive Signal Banner bullets."""
    del selection
    site_key = normalize_text(site)
    if not active:
        return []

    signal = _email_v565_overall_signal_status(site_grain_results, active)
    sharp = _email_v565_sharpest_grain(site_grain_results, active)
    sharp_result = site_grain_results.get(sharp) if sharp else None
    metric = getattr(sharp_result, "overall", None) if sharp_result is not None else None
    source_df = sharp_result.current_period_df if sharp_result is not None else pd.DataFrame()
    overall_metric = (
        overall_grain_results.get(sharp).overall
        if sharp and sharp in overall_grain_results
        else None
    )

    rate = _email_v551_num(getattr(metric, "actual_rate", np.nan)) if metric is not None else np.nan
    delta = _email_v551_num(getattr(metric, "delta", np.nan)) if metric is not None else np.nan
    responses = _email_v551_num(getattr(metric, "actual_responses", 0.0), 0.0) if metric is not None else 0.0
    overall_rate = _email_v551_num(getattr(overall_metric, "actual_rate", np.nan)) if overall_metric is not None else np.nan
    overall_gap = rate - overall_rate if pd.notna(rate) and pd.notna(overall_rate) else np.nan
