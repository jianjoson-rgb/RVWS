def _email_v557_squad_smiley_rows(
    grain_result: GrainResult,
    config: AppConfig = CONFIG,
    limit: int = 5,
) -> pd.DataFrame:
    """Return bottom squads by Smiley Rate for one detailed email grain."""
    table = getattr(grain_result, "squad_summary", pd.DataFrame())
    if table is None or not isinstance(table, pd.DataFrame) or table.empty:
        return pd.DataFrame()

    work = table.copy()
    try:
        work = filter_rows_to_approved_sites(work, config)
    except Exception:
        pass

    if work.empty or not {"Site", "Squad Code", "Smiley Rate"}.issubset(work.columns):
        return pd.DataFrame()

    response_col = "Responses" if "Responses" in work.columns else "Rated"
    if response_col not in work.columns:
        work[response_col] = 0

    work["_Rate"] = pd.to_numeric(work["Smiley Rate"], errors="coerce")
    work["_Responses"] = pd.to_numeric(work[response_col], errors="coerce").fillna(0.0)
    work["_Impact"] = pd.to_numeric(
        work.get("Official Impact", pd.Series(np.nan, index=work.index)),
        errors="coerce",
    )
    work["Site"] = work["Site"].map(normalize_text)
    work["Squad Code"] = work["Squad Code"].map(normalize_text)

    work = work[
        work["Site"].ne("")
        & work["Squad Code"].ne("")
        & work["_Responses"].gt(0)
        & work["_Rate"].notna()
    ].copy()
    if work.empty:
        return pd.DataFrame()

    return (
        work.sort_values(
            ["_Rate", "_Impact", "_Responses"],
            ascending=[True, True, False],
            na_position="last",
        )
        .head(max(1, int(limit)))
        .reset_index(drop=True)
    )


def _email_v557_attribute_fail_text_for_group(
    group: pd.DataFrame,
    limit: int = 2,
) -> str:
    """Return weakest QA attributes for one site/squad group."""
    parts: List[str] = []
    for attribute in [column for column in QA_ATTRIBUTE_COLUMNS if column in group.columns]:
        values = pd.to_numeric(group[attribute], errors="coerce")
        values = values[values.isin([0, 1])]
        audited = int(values.notna().sum())
        if audited <= 0:
            continue
        failed = int(values.eq(0).sum())
        failure_rate = safe_rate(failed, audited)
        parts.append(
            {
                "attribute": normalize_text(attribute),
                "failure_rate": failure_rate,
                "audited": audited,
            }
        )

    if not parts:
        return "QA attributes unavailable"

    ranked = sorted(
        parts,
        key=lambda item: (
            -float(item["failure_rate"]) if pd.notna(item["failure_rate"]) else 0.0,
            -int(item["audited"]),
        ),
    )[: max(1, int(limit))]

    return "; ".join(
        f"{item['attribute']} {format_rate(item['failure_rate'], 1)} fail rate"
        for item in ranked
        if item.get("attribute")
    ) or "QA attributes unavailable"


def _email_v557_squad_qa_rows(
    source_df: pd.DataFrame,
    config: AppConfig = CONFIG,
    limit: int = 5,
) -> pd.DataFrame:
    """Return bottom squads by QA pass rate for one detailed email grain."""
    if source_df is None or not isinstance(source_df, pd.DataFrame) or source_df.empty:
        return pd.DataFrame()

    qa_columns = [column for column in QA_ATTRIBUTE_COLUMNS if column in source_df.columns]
    if not qa_columns or not {"Site", "Squad Code"}.issubset(source_df.columns):
        return pd.DataFrame()

    work = source_df.copy()
    try:
        work = filter_rows_to_approved_sites(work, config)
    except Exception:
        pass

    work["Site"] = work["Site"].map(normalize_text)
    work["Squad Code"] = work["Squad Code"].map(normalize_text)
    work = work[work["Site"].ne("") & work["Squad Code"].ne("")].copy()
    if work.empty:
        return pd.DataFrame()

    records: List[Dict[str, Any]] = []
    for (site, squad), group in work.groupby(["Site", "Squad Code"], dropna=False):
        qa_values = group[qa_columns].apply(pd.to_numeric, errors="coerce")
        valid = qa_values.where(qa_values.isin([0, 1]))
        audited = int(valid.notna().sum().sum())
        if audited <= 0:
            continue
        passed = int(valid.eq(1).sum().sum())
        failed = int(valid.eq(0).sum().sum())
        pass_rate = safe_rate(passed, audited)
        records.append(
            {
                "Site": normalize_text(site),
                "Squad Code": normalize_text(squad),
                "Audited": audited,
                "Passed": passed,
                "Failed": failed,
                "QA Pass Rate": pass_rate,
                "QA Failure Rate": safe_rate(failed, audited),
                "Weakest QA Attributes": _email_v557_attribute_fail_text_for_group(
                    group,
                    limit=2,
                ),
            }
        )

    if not records:
        return pd.DataFrame()

    output = pd.DataFrame(records)
    return (
        output.sort_values(
            ["QA Pass Rate", "Audited", "Failed"],
            ascending=[True, False, False],
            na_position="last",
        )
        .head(max(1, int(limit)))
        .reset_index(drop=True)
    )


