        )
        if teammate_segments:
            paragraphs.append({"level": 0, "segments": teammate_segments})

    paragraphs.extend(
        [
            {"level": 0, "segments": _email_v551_qa_attribute_segments(source_df, "Overall", config=config)},
            {"level": 0, "segments": _email_v551_volume_mix_segments(source_df, metric)},
        ]
    )

    return paragraphs


def _email_v551_recommended_action_segments(
    grain_result: GrainResult,
    qa_summary: pd.DataFrame,
    teammate_df: pd.DataFrame,
    config: AppConfig = CONFIG,
) -> List[Dict[str, Any]]:
    """
    v5.7.62 recommended action.

    Removes the previous "...validate 0 teammate coaching opportunity rows..."
    language. Daily and Weekly never mention teammate coaching. Monthly only
    references the consolidated teammate narrative when rows exist.
    """
    site_row_df = _top_site_rows(grain_result, "negative", 1, config=config)
    site = ""
    if not site_row_df.empty:
        site = normalize_text(site_row_df.iloc[0].get("Site", ""))

    squad = _email_v551_top_squad_driver(grain_result, "negative", config=config)
    squad_name = normalize_text(squad.get("Squad Code", ""))
    squad_site = normalize_text(squad.get("Site", site))

    qa_drivers = _email_v551_top_qa_attributes(
        source_df=grain_result.current_period_df,
        scope_name="Overall",
        config=config,
        limit=2,
    )
    qa_names = [
        normalize_text(value)
        for value in qa_drivers.get("QA Attribute", pd.Series(dtype="object")).tolist()
        if normalize_text(value)
    ]

    segments: List[Dict[str, Any]] = [
        _email_v551_seg("Prioritize "),
        _email_v551_seg(site or "the primary drag site", color=EMAIL_V551_RED, bold=True),
        _email_v551_seg(" and "),
        _email_v551_seg(
            f"{squad_name} ({squad_site})" if squad_name else "the highest-risk squad",
            color=EMAIL_V551_RED,
            bold=True,
        ),
        _email_v551_seg("; coach "),
        _email_v551_seg(_human_join(qa_names, "the top QA drivers"), bold=True),
    ]

    grain = normalize_text(getattr(grain_result, "grain", "")).upper()
    has_teammate_rows = teammate_df is not None and isinstance(teammate_df, pd.DataFrame) and not teammate_df.empty
    if grain == "MONTHLY" and has_teammate_rows:
        segments.extend(
            [
                _email_v551_seg("; use the monthly consolidated Teammate Coaching narrative to target repeated below-baseline movement"),
            ]
        )

    segments.append(_email_v551_seg("."))
    return segments




