def _teammate_coaching_consolidated_opportunities_v546(
    site_reports: Optional[Mapping[str, SiteReport]],
    config: AppConfig = CONFIG,
) -> pd.DataFrame:
    """
    Consolidate the already-selected per-site teammate opportunity rows.

    This intentionally does not recalculate a separate Overall teammate list.
    Each row keeps the site-level benchmark, site-level rank, and Site tag from
    its source site chapter.
    """
    if not site_reports:
        return pd.DataFrame()

    frames: List[pd.DataFrame] = []
    ordered_sites = _ordered_scope_sites_v541(site_reports, config)
    site_order_map = {
        normalize_text(site).upper(): index
        for index, site in enumerate(ordered_sites)
    }

    for site in ordered_sites:
        site_report = site_reports.get(site)
        if site_report is None:
            continue

        opportunities = getattr(
            site_report,
            "teammate_coaching_opportunities_v540",
            pd.DataFrame(),
        )
        if opportunities is None or opportunities.empty:
            continue

        frame = opportunities.copy()
        site_label = normalize_text(site)
        if "Site" not in frame.columns:
            frame["Site"] = site_label
        else:
            frame["Site"] = frame["Site"].map(normalize_text).replace("", site_label)

        frame["_Site Order"] = site_order_map.get(site_label.upper(), len(site_order_map))
        frame["_Site Rank"] = pd.to_numeric(
            frame.get("Rank", pd.Series(range(1, len(frame) + 1), index=frame.index)),
            errors="coerce",
        ).fillna(9999)
        frames.append(frame)

    if not frames:
        return pd.DataFrame()

    combined = pd.concat(frames, ignore_index=True, sort=False)
    combined = (
        combined.sort_values(
            ["_Site Order", "_Site Rank", "Estimated Monthly Opportunity"],
            ascending=[True, True, False],
            na_position="last",
        )
        .reset_index(drop=True)
    )
    combined["Overall Consolidated Rank"] = range(1, len(combined) + 1)
    combined = combined.drop(columns=["_Site Order", "_Site Rank"], errors="ignore")
    return combined


