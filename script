def _finance_taxonomy_grain_narrative_v527(
    analysis: FinanceQAGrainAnalysis,
) -> str:
    """
    Build a compact executive narrative for taxonomy tables using Taxonomy
    Level One only.

    v5.7.30:
    - Removes repeated methodology wording from every grain narrative.
    - Makes Smiley-count and Non-Smiley-count movement language follow the
      sign of the delta.
    - Keeps the story aligned to Taxonomy Level One while Level Two tables
      remain available below.
    """
    if analysis is None:
        return (
            "Taxonomy Level One performance below is shown by topic using the "
            "selected report period and grain."
        )

    level_one = getattr(analysis, "level_one_summary", None)
    if level_one is None or level_one.empty:
        return (
            "Taxonomy Level One performance below is shown by topic using the "
            "selected report period and grain. No Level One rows were available "
            "for a detailed narrative."
        )

    combined = level_one.copy()
    if combined.empty:
        return (
            "Taxonomy Level One performance below is shown by topic using the "
            "selected report period and grain."
        )

    combined["Rated Numeric"] = pd.to_numeric(
        combined.get("Rated"),
        errors="coerce",
    ).fillna(0)
    combined["Smiley Rate Numeric"] = pd.to_numeric(
        combined.get("Smiley Rate"),
        errors="coerce",
    )
    combined["Contribution Numeric"] = pd.to_numeric(
        combined.get("Contribution to Finance Unhappy"),
        errors="coerce",
    )
    combined["Rate Delta Numeric"] = pd.to_numeric(
        combined.get("Smiley Rate Delta pp"),
        errors="coerce",
    )
    combined["Smiley Count Delta Numeric"] = pd.to_numeric(
        combined.get("Smiley Count Delta"),
        errors="coerce",
    )
    combined["Non-Smiley Count Delta Numeric"] = pd.to_numeric(
        combined.get("Non-Smiley Count Delta"),
        errors="coerce",
    )

    enough_volume = combined[combined["Rated Numeric"].ge(5)].copy()
    analysis_pool = enough_volume if not enough_volume.empty else combined

    narrative_parts: List[str] = []
    grain_label = normalize_text(getattr(analysis, "grain", "")).title() or "Selected grain"
    period_label = normalize_text(getattr(analysis, "period_label", ""))
    rolling_label = _taxonomy_rolling_label_v530(getattr(analysis, "grain", ""))

    opening = f"{grain_label} Level One taxonomy readout"
    if period_label:
        opening += f" for {period_label}"
    opening += f" versus {rolling_label.lower()}."
    narrative_parts.append(opening)

    valid_rate = analysis_pool[analysis_pool["Smiley Rate Numeric"].notna()].copy()
    if not valid_rate.empty:
        best = valid_rate.sort_values(
            ["Smiley Rate Numeric", "Rated Numeric"],
            ascending=[False, False],
        ).iloc[0]
        narrative_parts.append(
            f"{normalize_text(best.get('Topic'))} led Smiley Rate at "
            f"{format_rate(best.get('Smiley Rate Numeric'))} across "
            f"{int(best.get('Rated Numeric', 0)):,} rated responses."
        )

    valid_contribution = analysis_pool[analysis_pool["Contribution Numeric"].notna()].copy()
    if not valid_contribution.empty:
        pressure = valid_contribution.sort_values(
            ["Contribution Numeric", "Rated Numeric"],
            ascending=[False, False],
        ).iloc[0]
        narrative_parts.append(
            f"{normalize_text(pressure.get('Topic'))} contributed the largest "
            f"non-smiley share at {format_rate(pressure.get('Contribution Numeric'))}."
        )

    valid_rate_delta = analysis_pool[analysis_pool["Rate Delta Numeric"].notna()].copy()
    if not valid_rate_delta.empty:
        gain = valid_rate_delta.sort_values("Rate Delta Numeric", ascending=False).iloc[0]
        drop = valid_rate_delta.sort_values("Rate Delta Numeric", ascending=True).iloc[0]
        if float(gain.get("Rate Delta Numeric", 0)) > 0:
            narrative_parts.append(
                f"Biggest rate improvement: {normalize_text(gain.get('Topic'))} "
                f"({float(gain.get('Rate Delta Numeric')):+.1f} pp)."
            )
        if float(drop.get("Rate Delta Numeric", 0)) < 0:
            narrative_parts.append(
                f"Biggest rate regression: {normalize_text(drop.get('Topic'))} "
                f"({float(drop.get('Rate Delta Numeric')):+.1f} pp)."
            )

    valid_smiley_delta = analysis_pool[
        analysis_pool["Smiley Count Delta Numeric"].notna()
    ].copy()
    if not valid_smiley_delta.empty:
        max_smiley_gain = valid_smiley_delta.sort_values(
            "Smiley Count Delta Numeric",
            ascending=False,
        ).iloc[0]
        max_smiley_drop = valid_smiley_delta.sort_values(
            "Smiley Count Delta Numeric",
            ascending=True,
        ).iloc[0]

        gain_value = float(max_smiley_gain.get("Smiley Count Delta Numeric", 0))
        drop_value = float(max_smiley_drop.get("Smiley Count Delta Numeric", 0))

        if gain_value >= 0.5:
            narrative_parts.append(
                f"Smiley count increased most in {normalize_text(max_smiley_gain.get('Topic'))} "
                f"({gain_value:+.1f} vs {rolling_label.lower()})."
            )
        elif drop_value <= -0.5:
            narrative_parts.append(
                f"Smiley count declined most in {normalize_text(max_smiley_drop.get('Topic'))} "
                f"({drop_value:+.1f} vs {rolling_label.lower()})."
            )

    valid_non_smiley_delta = analysis_pool[
        analysis_pool["Non-Smiley Count Delta Numeric"].notna()
    ].copy()
    if not valid_non_smiley_delta.empty:
        max_pressure_increase = valid_non_smiley_delta.sort_values(
            "Non-Smiley Count Delta Numeric",
            ascending=False,
        ).iloc[0]
        max_pressure_decrease = valid_non_smiley_delta.sort_values(
            "Non-Smiley Count Delta Numeric",
            ascending=True,
        ).iloc[0]

        increase_value = float(max_pressure_increase.get("Non-Smiley Count Delta Numeric", 0))
        decrease_value = float(max_pressure_decrease.get("Non-Smiley Count Delta Numeric", 0))

        if increase_value >= 0.5:
            narrative_parts.append(
                f"Non-smiley pressure increased most in {normalize_text(max_pressure_increase.get('Topic'))} "
                f"({increase_value:+.1f} Neutral/Frownie responses vs {rolling_label.lower()})."
            )
        elif decrease_value <= -0.5:
            narrative_parts.append(
                f"Non-smiley pressure decreased most in {normalize_text(max_pressure_decrease.get('Topic'))} "
                f"({decrease_value:+.1f} Neutral/Frownie responses vs {rolling_label.lower()})."
            )

    return " ".join(part for part in narrative_parts if normalize_text(part))


