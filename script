def executive_summary_line(metric: PeriodMetric) -> str:
    """Executive narrative including baseline and previous-timeframe status."""
    classification = delta_label(metric.delta)
    grain_title = metric.grain.title()
    baseline_unit = {
        "DAILY": "day",
        "WEEKLY": "week",
        "MONTHLY": "month",
    }.get(metric.grain, "period")

    base = (
        f"{grain_title} Trend: {classification} at "
        f"{format_rate(metric.actual_rate)}, "
        f"{movement_phrase(metric.delta)} versus the preceding "
        f"{metric.baseline_period_count}-{baseline_unit} average"
    )

    if pd.notna(metric.previous_rate):
        base += (
            f". Previous-timeframe indicator: "
            f"{_status_with_delta(metric.performance_status, metric.previous_delta)} "
            f"versus {metric.previous_period_label}; "
            f"{_volume_display(metric.volume_status, metric.volume_change_pct)}"
        )
        if metric.comparison_basis:
            base += f" using {metric.comparison_basis}"
    else:
        base += (
            ". Previous-timeframe indicator: insufficient previous data"
        )

    if (
        metric.grain in {"WEEKLY", "MONTHLY"}
        and metric.is_incomplete
        and pd.notna(metric.projected_rate)
    ):
        base += (
            f". Projected close: {format_rate(metric.projected_rate)} "
            f"({format_pp(metric.projected_delta)} versus baseline) across "
            f"approximately {format_int(metric.projected_responses)} responses"
        )

    return base + "."


def site_summary_table_rows(
    site_report: SiteReport,
) -> List[List[str]]:
    """Site metric rows with compact period-over-period indicators."""
    rows: List[List[str]] = []
    for grain in ["DAILY", "WEEKLY", "MONTHLY"]:
        metric = site_report.grain_metrics.get(grain)
        if metric is None:
            continue

        actual_display = (
            f"{format_rate(metric.actual_rate)} | "
            f"{metric.performance_status}"
        )
        responses_display = (
            f"{format_int(metric.actual_responses)} | "
            f"{_volume_display(metric.volume_status, metric.volume_change_pct)}"
        )
        rows.append(
            [
                grain.title(),
                actual_display,
                format_rate(metric.baseline_rate),
                format_pp(metric.delta),
                responses_display,
                (
                    format_rate(metric.projected_rate)
                    if metric.is_incomplete
                    else "Complete"
                ),
                sample_size_label(metric.actual_responses),
            ]
        )
    return rows


def build_executive_summary_table(
    selection: ReportSelection,
