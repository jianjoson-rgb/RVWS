def compute_week_label(series: pd.Series) -> pd.Series:
    valid = series.notna()
    out = pd.Series(
        [""] * len(series),
        index=series.index,
        dtype="object",
    )
    if valid.any():
        base_dates = series.loc[valid].dt.normalize()
        days_since_sunday = (base_dates.dt.weekday + 1) % 7
        result_dates = (
            base_dates
            - pd.to_timedelta(days_since_sunday, unit="D")
        )
        out.loc[valid] = "WB" + result_dates.dt.strftime("%m%d")
    return out


