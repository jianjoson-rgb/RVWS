        action_title = "3. Final Push for Month-End"
        action_sentences = [
            (
                f"With {metric.remaining_days} calendar day(s) remaining, the month is "
                f"projected to close at {format_rate(metric.projected_rate)} across "
                f"approximately {format_int(metric.projected_responses)} responses."
