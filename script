def _drive_escape_query_text_v571(value: Any) -> str:
    """Escape text used in a Google Drive v3 query."""
    return normalize_text(value).replace("\\", "\\\\").replace("'", "\\'")


def _drive_find_exact_file_v571(
    drive_service,
    file_name: str,
    parent_folder_id: str,
    mime_type: str = "",
) -> Optional[Dict[str, Any]]:
    """
    Find an exact non-trashed item inside the requested parent folder.

    Used after upload timeouts so a successful server-side create is recovered
    instead of duplicated on the next retry.
    """
    escaped_name = _drive_escape_query_text_v571(file_name)
    escaped_parent = _drive_escape_query_text_v571(parent_folder_id)

    clauses = [
        f"name = '{escaped_name}'",
        f"'{escaped_parent}' in parents",
        "trashed = false",
    ]
    if normalize_text(mime_type):
        clauses.append(
            f"mimeType = '{_drive_escape_query_text_v571(mime_type)}'"
        )

    response = run_with_retry(
        lambda: (
            drive_service.files()
            .list(
                q=" and ".join(clauses),
                spaces="drive",
                fields="files(id,name,mimeType,driveId,webViewLink,modifiedTime)",
                pageSize=20,
                supportsAllDrives=True,
                includeItemsFromAllDrives=True,
            )
            .execute()
        ),
        f"Find Drive file {file_name}",
        max_retries=max(2, int(CONFIG.drive_max_retries)),
        base_sleep=max(1.0, float(CONFIG.drive_backoff_seconds)),
    )

    files = response.get("files", [])
    if not files:
        return None

    # The run folder is unique, but if duplicates somehow exist, keep the most
    # recently modified result.
    files = sorted(
        files,
        key=lambda item: normalize_text(item.get("modifiedTime", "")),
        reverse=True,
    )
    return files[0]


def _drive_file_result_v571(
    item: Mapping[str, Any],
    fallback_name: str,
    fallback_mime_type: str,
) -> Dict[str, str]:
    """Normalize a Drive API item into the report's link dictionary."""
    file_id = normalize_text(item.get("id", ""))
    mime_type = normalize_text(
        item.get("mimeType", fallback_mime_type)
    )
    if mime_type == GOOGLE_DOC_MIME_TYPE:
        fallback_url = (
            f"https://docs.google.com/document/d/{file_id}/edit"
            if file_id else ""
        )
    else:
        fallback_url = (
            f"https://drive.google.com/file/d/{file_id}/view"
            if file_id else ""
        )
    return {
        "id": file_id,
        "name": normalize_text(item.get("name", fallback_name)),
        "mime_type": mime_type,
        "shared_drive_id": normalize_text(item.get("driveId", "")),
        "url": normalize_text(item.get("webViewLink", "")) or fallback_url,
    }



def _publish_docx_google_doc_v571(
    drive_service,
    docx_path: str,
    google_doc_name: str,
    parent_folder_id: str,
    config: AppConfig = CONFIG,
) -> Dict[str, str]:
    """
    Publish a fresh DOCX as a native Google Doc.

    Exact-name lookup is used ONLY after a failed/timed-out create attempt.
    This prevents a rerun from silently returning stale content from an older
    same-name Google Doc.
    """
    local_file = Path(docx_path)
    if not local_file.exists() or local_file.stat().st_size == 0:
        raise FileNotFoundError(
            f"Google Docs conversion source is missing or empty: {docx_path}"
        )

    max_retries = max(1, int(config.drive_max_retries))
    base_sleep = max(1.0, float(config.drive_backoff_seconds))
    last_error: Optional[Exception] = None

    for attempt in range(1, max_retries + 1):
        try:
            return import_docx_as_google_doc(
                drive_service=drive_service,
                docx_path=docx_path,
                google_doc_name=google_doc_name,
                parent_folder_id=parent_folder_id,
            )
        except Exception as exc:
            last_error = exc

            # Recovery only: a timeout may happen after Google successfully
            # created the converted Doc. Recover that server-side result.
            try:
                recovered = _drive_find_exact_file_v571(
                    drive_service=drive_service,
                    file_name=google_doc_name,
                    parent_folder_id=parent_folder_id,
                    mime_type=GOOGLE_DOC_MIME_TYPE,
                )
                if recovered:
                    return _drive_file_result_v571(
                        recovered,
                        fallback_name=google_doc_name,
                        fallback_mime_type=GOOGLE_DOC_MIME_TYPE,
                    )
            except Exception as recovery_exc:
                LOGGER.warning(
                    "Drive timeout recovery search failed for %s: %s",
                    google_doc_name,
                    recovery_exc,
                )

            if attempt >= max_retries:
                break

            sleep_seconds = min(
                45.0,
                base_sleep * (2 ** (attempt - 1))
                + random.uniform(0, 1),
            )
            LOGGER.warning(
                "Google Docs publishing failed for %s on attempt %d/%d: %s. "
                "Retrying in %.1fs.",
                google_doc_name,
                attempt,
                max_retries,
                exc,
                sleep_seconds,
            )
            time.sleep(sleep_seconds)

    raise RuntimeError(
        f"Google Docs publishing failed for {google_doc_name} "
        f"after {max_retries} attempts."
    ) from last_error




def _publish_binary_file_v571(
    drive_service,
    local_path: str,
    drive_name: str,
    parent_folder_id: str,
    mime_type: str,
    config: AppConfig = CONFIG,
) -> Dict[str, str]:
    """Best-effort binary upload with timeout recovery and duplicate protection."""
    max_retries = max(1, int(config.drive_chart_upload_retries))
    last_error: Optional[Exception] = None

    for attempt in range(1, max_retries + 1):
        try:
            existing = _drive_find_exact_file_v571(
                drive_service=drive_service,
                file_name=drive_name,
                parent_folder_id=parent_folder_id,
                mime_type=mime_type,
            )
            if existing:
                return _drive_file_result_v571(
                    existing,
                    fallback_name=drive_name,
                    fallback_mime_type=mime_type,
                )

            return upload_binary_file(
                drive_service=drive_service,
                local_path=local_path,
                drive_name=drive_name,
                parent_folder_id=parent_folder_id,
                mime_type=mime_type,
            )
        except Exception as exc:
            last_error = exc
            if attempt >= max_retries:
                break
            sleep_seconds = min(
                20.0,
                max(1.0, float(config.drive_backoff_seconds))
                * (2 ** (attempt - 1))
                + random.uniform(0, 1),
            )
            LOGGER.warning(
                "Drive binary upload failed for %s on attempt %d/%d: %s. "
                "Retrying in %.1fs.",
                drive_name,
                attempt,
                max_retries,
                exc,
                sleep_seconds,
            )
            time.sleep(sleep_seconds)

    raise RuntimeError(
        f"Drive binary upload failed for {drive_name}."
    ) from last_error


