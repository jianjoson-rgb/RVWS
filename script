def _squad_outcome_series_v531(source_df: pd.DataFrame) -> pd.Series:
    """
    Return Smiley/Neutral/Frownie outcome labels for squad response-mix tables.

    Primary source is the normalized Smiley Rating text. A defensive fallback uses
    Smiley Numerator only when the label is missing, so report generation does not
    fail if a source row has an unexpected blank rating.
    """
    if source_df is None or source_df.empty:
        return pd.Series(dtype="object")

    if "Smiley Rating" in source_df.columns:
        outcome = source_df["Smiley Rating"].map(normalize_smiley_outcome)
    else:
        outcome = pd.Series("", index=source_df.index, dtype="object")

    outcome = outcome.fillna("").astype(str)
    missing = outcome.eq("")

    if missing.any():
        numerator = pd.to_numeric(
            source_df.get("Smiley Numerator", pd.Series(np.nan, index=source_df.index)),
            errors="coerce",
        ).fillna(0)
        responses = pd.to_numeric(
            source_df.get("Responses", pd.Series(0, index=source_df.index)),
            errors="coerce",
        ).fillna(0)
        fallback = pd.Series("", index=source_df.index, dtype="object")
        fallback.loc[numerator.gt(0)] = "Smiley"
        # We cannot reliably split blank non-smiley labels into Neutral versus Frownie.
        # Treat them as Frownie only as a last-resort non-smiley bucket so the table
        # still reconciles as non-smiley pressure instead of silently dropping rows.
        fallback.loc[numerator.le(0) & responses.gt(0)] = "Frownie"
        outcome.loc[missing] = fallback.loc[missing]

    return outcome



def _squad_prepare_source_v531(
    source_df: pd.DataFrame,
    squad_column: str = "Squad Code",
) -> pd.DataFrame:
    """Prepare source rows for deterministic squad response-mix aggregation."""
    if source_df is None or source_df.empty:
        return pd.DataFrame()

    required = {"Responses", "Smiley Numerator", squad_column}
    if not required.issubset(set(source_df.columns)):
        return pd.DataFrame()

    work = source_df.copy()

    if "Site" in work.columns:
        work["_Squad Site"] = work["Site"].map(normalize_text)
    else:
        work["_Squad Site"] = "Unknown Site"
    work["_Squad Site"] = work["_Squad Site"].replace("", "Unknown Site")

    work[squad_column] = work[squad_column].map(normalize_text)
    work[squad_column] = work[squad_column].replace("", "Unknown Squad")
    work["_Squad Outcome"] = _squad_outcome_series_v531(work)
    work = work[work["_Squad Outcome"].isin(["Smiley", "Neutral", "Frownie"])].copy()
    if work.empty:
        return work

    work["Responses"] = pd.to_numeric(work["Responses"], errors="coerce").fillna(0.0)
    work["Smiley Numerator"] = pd.to_numeric(
        work["Smiley Numerator"],
        errors="coerce",
    ).fillna(0.0)
    work = work[work["Responses"].gt(0)].copy()
    return work

def _squad_baseline_subset_v531(
    scope_df: pd.DataFrame,
    metric: PeriodMetric,
) -> pd.DataFrame:
    """
    Return the rolling squad baseline window.

    This intentionally follows the approved taxonomy baseline logic:
      - Daily: last 12 days including current day
      - Weekly: last 12 weeks including current week
      - Monthly: last 3 months including current month
    """
    if scope_df is None or scope_df.empty or metric is None:
        return pd.DataFrame()

    period_start = pd.Timestamp(metric.period_start).normalize()
    period_end = min(
        pd.Timestamp(metric.period_end).normalize(),
        pd.Timestamp(metric.data_through).normalize(),
    )
    rolling_start = _finance_rolling_window_start_v527(
        metric.grain,
        period_start,
    )
    if "Date" not in scope_df.columns:
        return pd.DataFrame()

    return scope_df[
        pd.to_datetime(scope_df["Date"], errors="coerce").between(
            rolling_start,
            period_end,
            inclusive="both",
        )
    ].copy()



def _squad_baseline_map_v531(
    baseline_df: pd.DataFrame,
    grain: str,
    squad_column: str = "Squad Code",
) -> Dict[Tuple[str, str], Dict[str, Any]]:
    """Build rolling baseline values by site+squad using ratio-of-sums for rates."""
    baseline = _squad_prepare_source_v531(baseline_df, squad_column=squad_column)
    if baseline.empty:
        return {}

    period_count = max(1, int(_finance_rolling_period_count_v527(grain)))
    output: Dict[Tuple[str, str], Dict[str, Any]] = {}

    for (site, squad), group in baseline.groupby(["_Squad Site", squad_column], dropna=False):
        site_name = normalize_text(site) or "Unknown Site"
        squad_name = normalize_text(squad) or "Unknown Squad"
        rated = float(pd.to_numeric(group["Responses"], errors="coerce").fillna(0).sum())
        smiley = float(
            pd.to_numeric(group["Smiley Numerator"], errors="coerce").fillna(0).sum()
        )
        neutral = int(group["_Squad Outcome"].eq("Neutral").sum())
        frownie = int(group["_Squad Outcome"].eq("Frownie").sum())
        non_smiley = neutral + frownie
        output[(site_name, squad_name)] = {
            "Baseline Rated": rated,
            "Baseline Smiley": smiley,
            "Baseline Neutral": neutral,
            "Baseline Frownie": frownie,
            "Baseline Non-Smiley": non_smiley,
            "Baseline Smiley Rate": safe_rate(smiley, rated),
            "Avg Smiley Count": smiley / period_count,
            "Avg Non-Smiley Count": non_smiley / period_count,
        }

    return output


def _build_squad_response_mix_frame_v531(
    scope_df: pd.DataFrame,
    metric: PeriodMetric,
    scope_name: str,
    config: AppConfig = CONFIG,
    squad_column: str = "Squad Code",
) -> pd.DataFrame:
    """
    Build taxonomy-style squad response-mix rows.

    Current values use the selected grain period. Rolling deltas compare against
    the 12D / 12W / 3M rolling window including the current period, matching the
    approved taxonomy analysis approach.

    v5.7.35 groups by Site + Squad so the squad table can align to focus-site
    recommended actions without including every squad from a focus site.
    """
    columns = [
        "Scope",
        "Grain",
        "Period Label",
        "Site",
        "Squad",
        "Rated",
        "Smiley",
        "Neutral",
        "Frownie",
        "Non-Smiley",
        "Smiley Rate",
        "Smiley Rate Delta pp",
        "Smiley Count Delta",
        "Non-Smiley Count Delta",
        "Contribution to Non-Smiley",
        "Sample Status",
    ]

    if scope_df is None or scope_df.empty or metric is None:
        return pd.DataFrame(columns=columns)

    current_df = current_period_dataframe(scope_df, metric)
    current = _squad_prepare_source_v531(current_df, squad_column=squad_column)
    if current.empty:
        return pd.DataFrame(columns=columns)

    baseline_df = _squad_baseline_subset_v531(scope_df, metric)
    baseline_map = _squad_baseline_map_v531(
        baseline_df,
        grain=metric.grain,
        squad_column=squad_column,
    )

    total_non_smiley = int(
        current["_Squad Outcome"].isin(["Neutral", "Frownie"]).sum()
    )

    rows: List[Dict[str, Any]] = []
    group_columns = ["_Squad Site", squad_column]
    for (site, squad), group in current.groupby(group_columns, dropna=False):
        site_name = normalize_text(site) or "Unknown Site"
        squad_name = normalize_text(squad) or "Unknown Squad"
        rated = float(pd.to_numeric(group["Responses"], errors="coerce").fillna(0).sum())
        smiley = float(
            pd.to_numeric(group["Smiley Numerator"], errors="coerce").fillna(0).sum()
        )
        neutral = int(group["_Squad Outcome"].eq("Neutral").sum())
        frownie = int(group["_Squad Outcome"].eq("Frownie").sum())
        non_smiley = neutral + frownie
        smiley_rate = safe_rate(smiley, rated)

        baseline = baseline_map.get((site_name, squad_name), {})
        baseline_rate = baseline.get("Baseline Smiley Rate", np.nan)
        baseline_avg_smiley = baseline.get("Avg Smiley Count", np.nan)
        baseline_avg_non_smiley = baseline.get("Avg Non-Smiley Count", np.nan)

        delta_rate_pp = (
            (float(smiley_rate) - float(baseline_rate)) * 100
            if pd.notna(smiley_rate) and pd.notna(baseline_rate)
            else np.nan
        )
        delta_smiley_count = (
            float(smiley) - float(baseline_avg_smiley)
            if pd.notna(baseline_avg_smiley)
            else np.nan
        )
        delta_non_smiley_count = (
            float(non_smiley) - float(baseline_avg_non_smiley)
            if pd.notna(baseline_avg_non_smiley)
            else np.nan
        )

        rows.append(
            {
                "Scope": scope_name,
                "Grain": metric.grain,
                "Period Label": metric.period_label,
                "Site": site_name,
                "Squad": squad_name,
                "Rated": rated,
                "Smiley": smiley,
                "Neutral": neutral,
                "Frownie": frownie,
                "Non-Smiley": non_smiley,
                "Smiley Rate": smiley_rate,
                "Smiley Rate Delta pp": delta_rate_pp,
                "Smiley Count Delta": delta_smiley_count,
                "Non-Smiley Count Delta": delta_non_smiley_count,
                "Contribution to Non-Smiley": safe_rate(non_smiley, total_non_smiley),
                "Sample Status": sample_size_label(rated),
            }
        )

    if not rows:
        return pd.DataFrame(columns=columns)

    output = pd.DataFrame(rows, columns=columns)
    return (
        output.sort_values(
            ["Non-Smiley", "Rated", "Smiley Rate"],
            ascending=[False, False, True],
            na_position="last",
        )
        .reset_index(drop=True)
    )


