def _email_v567_clean_numeric_series(df: pd.DataFrame, column: str) -> pd.Series:
    """Return numeric values aligned to df.index, treating staging missing labels as blanks."""
    if df is None or not isinstance(df, pd.DataFrame) or df.empty:
        return pd.Series(dtype="float64")
    if column not in df.columns:
        return pd.Series(np.nan, index=df.index, dtype="float64")
    cleaned = (
        df[column]
        .replace(
            {
                "null": np.nan,
                "NULL": np.nan,
                "No data": np.nan,
                "no data": np.nan,
                "NO DATA": np.nan,
                "": np.nan,
                "-": np.nan,
                "nan": np.nan,
                "NaN": np.nan,
                "None": np.nan,
            }
        )
    )
    return pd.to_numeric(cleaned, errors="coerce").reindex(df.index)


def _email_v567_outcome_frames(source_df: pd.DataFrame) -> Dict[str, pd.DataFrame]:
    """Split same-period survey rows into Smiley and Non-Smiley frames; Frownie is retained only for internal outcome classification."""
    if source_df is None or not isinstance(source_df, pd.DataFrame) or source_df.empty:
        empty = pd.DataFrame()
        return {"all": empty, "smiley": empty, "non_smiley": empty, "frownie": empty}

    work = source_df.copy()
    outcomes = _email_v565_outcome_series(work).reindex(work.index).fillna("")
    smiley_df = work[outcomes.eq("Smiley")].copy()
    frownie_df = work[outcomes.eq("Frownie")].copy()
    non_smiley_df = work[outcomes.isin(["Neutral", "Frownie", "Non-Smiley"])].copy()

    # Fallback for binary Smiley Rate-only data where Neutral/Frownie labels are not available.
    if non_smiley_df.empty and "Non-Smiley Survey" in work.columns:
        non_smiley_flag = _email_v567_clean_numeric_series(work, "Non-Smiley Survey").fillna(0)
        non_smiley_df = work[non_smiley_flag.gt(0)].copy()

    return {
        "all": work,
        "smiley": smiley_df,
        "non_smiley": non_smiley_df,
        "frownie": frownie_df,
    }


def _email_v567_mean_for_df(df: pd.DataFrame, column: str) -> float:
    """Mean numeric value for a column in a frame."""
    if df is None or not isinstance(df, pd.DataFrame) or df.empty:
        return np.nan
    values = _email_v567_clean_numeric_series(df, column).dropna()
    if values.empty:
        return np.nan
    return float(values.mean())


def _email_v567_sum_for_df(df: pd.DataFrame, column: str) -> float:
    """Sum numeric value for a column in a frame."""
    if df is None or not isinstance(df, pd.DataFrame) or df.empty:
        return 0.0
    values = _email_v567_clean_numeric_series(df, column).dropna()
    if values.empty:
        return 0.0
    return float(values.sum())


def _email_v567_aftr_rate_for_df(df: pd.DataFrame) -> Dict[str, Any]:
    """AFTR rate using numerator / denominator for one outcome frame."""
    numerator_col = "advisor_first_touch_resolution_rate_numerator"
    denominator_col = "advisor_first_touch_resolution_rate_denominator"
    if (
        df is None
        or not isinstance(df, pd.DataFrame)
        or df.empty
        or numerator_col not in df.columns
        or denominator_col not in df.columns
    ):
        return {"available": False, "rate": np.nan, "numerator": 0.0, "denominator": 0.0}

    numerator = _email_v567_clean_numeric_series(df, numerator_col)
    denominator = _email_v567_clean_numeric_series(df, denominator_col)
    valid = numerator.notna() & denominator.notna() & denominator.gt(0)
    if not bool(valid.any()):
        return {"available": False, "rate": np.nan, "numerator": 0.0, "denominator": 0.0}

    numerator_total = float(numerator[valid].sum())
    denominator_total = float(denominator[valid].sum())
    return {
        "available": denominator_total > 0,
        "rate": safe_rate(numerator_total, denominator_total),
        "numerator": numerator_total,
        "denominator": denominator_total,
    }


def _email_v567_minutes_text(value: Any) -> str:
    numeric = _email_v551_num(value)
    if pd.isna(numeric):
        return "N/A"
    return f"{numeric:.1f} minutes"


def _email_v567_minutes_gap_text(value: Any) -> str:
    numeric = _email_v551_num(value)
    if pd.isna(numeric):
        return "N/A"
    return f"{numeric:+.1f} min"


def _email_v567_gap_color(value: Any, *, lower_is_better: bool = False) -> str:
    numeric = _email_v551_num(value)
    if pd.isna(numeric) or abs(numeric) < 1e-12:
        return EMAIL_V551_GRAY
    if lower_is_better:
        return EMAIL_V551_RED if numeric > 0 else EMAIL_V551_GREEN
    return EMAIL_V551_GREEN if numeric > 0 else EMAIL_V551_RED


def _email_v567_async_share_color(value: Any) -> str:
    numeric = _email_v551_num(value)
    if pd.isna(numeric) or numeric <= 0:
        return EMAIL_V551_GRAY
    return EMAIL_V551_RED


def _email_v565_aftr_summary(
    source_df: pd.DataFrame,
) -> Dict[str, Any]:
    """
    v5.7.68-compatible AFTR summary.

    Keeps the original aggregate keys, and adds Smiley / Non-Smiley
    split metrics for Weekly and Monthly email readouts.
    """
    numerator_col = "advisor_first_touch_resolution_rate_numerator"
    denominator_col = "advisor_first_touch_resolution_rate_denominator"
    base_empty = {
        "available": False,
        "rate": np.nan,
        "denominator": 0.0,
        "miss_count": 0.0,
        "path": "",
        "smiley_rate": np.nan,
        "smiley_denominator": 0.0,
        "non_smiley_rate": np.nan,
        "non_smiley_denominator": 0.0,
        "frownie_rate": np.nan,
        "frownie_denominator": 0.0,
        "split_gap": np.nan,
        "split_available": False,
    }
    if (
        source_df is None
        or not isinstance(source_df, pd.DataFrame)
        or source_df.empty
        or numerator_col not in source_df.columns
        or denominator_col not in source_df.columns
    ):
        return base_empty

    work = source_df.copy()
    numerator = _email_v567_clean_numeric_series(work, numerator_col)
    denominator = _email_v567_clean_numeric_series(work, denominator_col)
    valid = numerator.notna() & denominator.notna() & denominator.gt(0)
    if not bool(valid.any()):
        return base_empty

    valid_work = work[valid].copy()
    numerator_valid = numerator[valid]
    denominator_valid = denominator[valid]

    aggregate_rate = safe_rate(float(numerator_valid.sum()), float(denominator_valid.sum()))
    miss_mask = numerator_valid.lt(denominator_valid)
    miss_df = valid_work[miss_mask].copy()
    miss_count = float(denominator_valid[miss_mask].sum() - numerator_valid[miss_mask].sum())
    path = _email_v565_path_summary(
        miss_df,
        ["AFTR L1", "AFTR L2", "AFTR L3"],
        label="AFTR miss",
    )

    frames = _email_v567_outcome_frames(valid_work)
    smiley = _email_v567_aftr_rate_for_df(frames["smiley"])
    non_smiley = _email_v567_aftr_rate_for_df(frames["non_smiley"])
    frownie = _email_v567_aftr_rate_for_df(frames["frownie"])
    split_gap = (
        smiley["rate"] - non_smiley["rate"]
        if smiley.get("available") and non_smiley.get("available")
        else np.nan
    )

    return {
        "available": True,
        "rate": aggregate_rate,
        "denominator": float(denominator_valid.sum()),
        "miss_count": miss_count,
        "path": normalize_text(path.get("path", "")),
        "path_share": path.get("share", np.nan),
        "path_count": path.get("count", 0.0),
        "smiley_rate": smiley.get("rate", np.nan),
        "smiley_denominator": smiley.get("denominator", 0.0),
        "non_smiley_rate": non_smiley.get("rate", np.nan),
        "non_smiley_denominator": non_smiley.get("denominator", 0.0),
        "frownie_rate": frownie.get("rate", np.nan),
        "frownie_denominator": frownie.get("denominator", 0.0),
        "split_gap": split_gap,
        "split_available": smiley.get("available") and non_smiley.get("available"),
    }


def _email_v565_aht_signal(
    source_df: pd.DataFrame,
) -> Dict[str, Any]:
    """
    v5.7.68-compatible AHT summary.

    Keeps original average/path keys and adds Smiley / Non-Smiley
    outcome split metrics for email narratives.
    """
    if source_df is None or not isinstance(source_df, pd.DataFrame) or source_df.empty:
        return {
            "available": False,
            "avg_aht": np.nan,
            "path": "",
            "smiley_avg": np.nan,
            "non_smiley_avg": np.nan,
            "frownie_avg": np.nan,
            "split_gap": np.nan,
            "split_available": False,
        }

    avg_aht = _email_v567_mean_for_df(source_df, "Chat Average Handle Time")
    frames = _email_v567_outcome_frames(source_df)
    smiley_avg = _email_v567_mean_for_df(frames["smiley"], "Chat Average Handle Time")
    non_smiley_avg = _email_v567_mean_for_df(frames["non_smiley"], "Chat Average Handle Time")
    frownie_avg = _email_v567_mean_for_df(frames["frownie"], "Chat Average Handle Time")
    split_gap = (
        non_smiley_avg - smiley_avg
        if pd.notna(non_smiley_avg) and pd.notna(smiley_avg)
        else np.nan
    )

    non_smiley_df = frames["non_smiley"]
    signal_df = non_smiley_df if not non_smiley_df.empty else source_df.copy()

    if "Chat Average Handle Time" in signal_df.columns:
        aht_values = _email_v567_clean_numeric_series(signal_df, "Chat Average Handle Time")
        if aht_values.notna().sum() >= 3:
            threshold = float(aht_values.quantile(0.75))
            signal_df = signal_df[aht_values.ge(threshold)].copy()
            if signal_df.empty:
                signal_df = non_smiley_df if not non_smiley_df.empty else source_df.copy()

    path = _email_v565_path_summary(
        signal_df,
        ["AHT L1", "AHT L2", "AHT L3", "AHT Drilldown"],
        label="AHT",
    )

    return {
        "available": pd.notna(avg_aht) or bool(path.get("available")),
        "avg_aht": avg_aht,
        "path": normalize_text(path.get("path", "")),
        "path_share": path.get("share", np.nan),
        "path_count": path.get("count", 0.0),
        "smiley_avg": smiley_avg,
        "non_smiley_avg": non_smiley_avg,
        "frownie_avg": frownie_avg,
        "split_gap": split_gap,
        "split_available": pd.notna(smiley_avg) and pd.notna(non_smiley_avg),
    }


def _email_v565_queue_async_summary(
    source_df: pd.DataFrame,
) -> Dict[str, Any]:
    """
    v5.7.68-compatible queue and async summary.

    Keeps original keys and adds Smiley / Non-Smiley split metrics.
    """
    base = {
        "queue_avg": np.nan,
        "async_avg": np.nan,
        "async_total": 0.0,
        "non_smiley_async": 0.0,
        "non_smiley_async_share": np.nan,
        "smiley_queue_avg": np.nan,
        "non_smiley_queue_avg": np.nan,
        "frownie_queue_avg": np.nan,
        "queue_gap": np.nan,
        "smiley_async": 0.0,
        "smiley_async_share": np.nan,
        "frownie_async": 0.0,
        "frownie_async_share": np.nan,
        "non_smiley_async_avg": np.nan,
        "smiley_async_avg": np.nan,
        "frownie_async_avg": np.nan,
    }
    if source_df is None or not isinstance(source_df, pd.DataFrame) or source_df.empty:
        return base

    work = source_df.copy()
    frames = _email_v567_outcome_frames(work)

    queue_avg = _email_v567_mean_for_df(work, "chat__queue_duration_min")
    smiley_queue_avg = _email_v567_mean_for_df(frames["smiley"], "chat__queue_duration_min")
    non_smiley_queue_avg = _email_v567_mean_for_df(frames["non_smiley"], "chat__queue_duration_min")
    frownie_queue_avg = _email_v567_mean_for_df(frames["frownie"], "chat__queue_duration_min")
    queue_gap = (
        non_smiley_queue_avg - smiley_queue_avg
        if pd.notna(non_smiley_queue_avg) and pd.notna(smiley_queue_avg)
        else np.nan
    )

    async_all = _email_v567_clean_numeric_series(work, "Async_follow_up_count").dropna()
    async_total = float(async_all.sum()) if not async_all.empty else 0.0
    async_avg = float(async_all.mean()) if not async_all.empty else np.nan

    smiley_async = _email_v567_sum_for_df(frames["smiley"], "Async_follow_up_count")
    non_smiley_async = _email_v567_sum_for_df(frames["non_smiley"], "Async_follow_up_count")
    frownie_async = _email_v567_sum_for_df(frames["frownie"], "Async_follow_up_count")
    smiley_async_avg = _email_v567_mean_for_df(frames["smiley"], "Async_follow_up_count")
    non_smiley_async_avg = _email_v567_mean_for_df(frames["non_smiley"], "Async_follow_up_count")
    frownie_async_avg = _email_v567_mean_for_df(frames["frownie"], "Async_follow_up_count")

    base.update(
        {
            "queue_avg": queue_avg,
            "async_avg": async_avg,
            "async_total": async_total,
            "non_smiley_async": non_smiley_async,
            "non_smiley_async_share": safe_rate(non_smiley_async, async_total),
            "smiley_queue_avg": smiley_queue_avg,
            "non_smiley_queue_avg": non_smiley_queue_avg,
            "frownie_queue_avg": frownie_queue_avg,
            "queue_gap": queue_gap,
            "smiley_async": smiley_async,
            "smiley_async_share": safe_rate(smiley_async, async_total),
            "frownie_async": frownie_async,
            "frownie_async_share": safe_rate(frownie_async, async_total),
            "non_smiley_async_avg": non_smiley_async_avg,
            "smiley_async_avg": smiley_async_avg,
            "frownie_async_avg": frownie_async_avg,
        }
    )
    return base


def _email_v567_handling_signal_segments(
    grain: str,
