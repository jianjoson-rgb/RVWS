def _docx_v553_spacing_for_style(style_name: str, *, email_only: bool) -> Tuple[float, float, float]:
    """Return (space_before_pt, space_after_pt, line_spacing) by style."""
    normalized = normalize_text(style_name).lower()

    if normalized == "title":
        return (0, 8, 1.06)
    if normalized == "heading 1":
        return (6, 8, 1.05)
    if normalized == "heading 2":
        return (10, 6, 1.06)
    if normalized == "heading 3":
        return (7, 4, 1.05)
    if "list bullet 2" in normalized:
        return (0, 3, 1.08)
    if "list bullet" in normalized:
        return (0, 4 if email_only else 3, 1.08)

    return (0, 6 if email_only else 4, 1.10 if email_only else 1.08)


def _docx_v553_apply_paragraph_spacing(
    paragraph,
    *,
    email_only: bool = False,
    table_cell: bool = False,
    config: AppConfig = CONFIG,
) -> None:
    """Apply consistent spacing to a python-docx paragraph."""
    if paragraph is None:
        return

    try:
        style_name = paragraph.style.name if paragraph.style is not None else ""
    except Exception:
        style_name = ""

    before, after, line_spacing = _docx_v553_spacing_for_style(style_name, email_only=email_only)

    if table_cell:
        before, after, line_spacing = (0, 0, 1.0)

    pf = paragraph.paragraph_format
    pf.space_before = Pt(before)
    pf.space_after = Pt(after)
    pf.line_spacing = line_spacing

    normalized_style = normalize_text(style_name).lower()
    if normalized_style.startswith("heading"):
        pf.keep_with_next = True
    elif not table_cell:
        pf.keep_with_next = False

    if "list bullet" in normalized_style and not table_cell:
        try:
            paragraph.paragraph_format.left_indent = Inches(0.22 if email_only else 0.18)
            paragraph.paragraph_format.first_line_indent = Inches(-0.12)
        except Exception:
            pass

    for run in paragraph.runs:
        _docx_v553_apply_run_defaults(
            run,
            font_size=(None if table_cell else (9.2 if email_only else 9.0)),
            font_name=getattr(config, "docx_font_name", None),
        )


def _docx_v553_apply_global_spacing(
    document: Document,
    *,
    email_only: bool = False,
    config: AppConfig = CONFIG,
) -> None:
    """
    Final DOCX spacing pass applied before every save.

    This is intentionally formatting-only:
    - no Smiley, QA, taxonomy, squad, ticket-age, teammate, or Google API logic
      is changed;
    - body paragraphs, bullets, headings, and table cells receive consistent
      before/after spacing and line height;
    - table cells remain compact so wide report tables do not expand vertically.
    """
    if document is None:
        return

    try:
        normal = document.styles["Normal"]
        normal.font.name = config.docx_font_name
        normal._element.rPr.rFonts.set(qn("w:eastAsia"), config.docx_font_name)
        normal.font.size = Pt(10.0 if email_only else 9.0)
        normal.paragraph_format.space_before = Pt(0)
        normal.paragraph_format.space_after = Pt(6 if email_only else 4)
        normal.paragraph_format.line_spacing = 1.10 if email_only else 1.08
    except Exception:
        pass

    for style_name, size, before, after in [
        ("Title", 24, 0, 8),
        ("Heading 1", 18 if email_only else 17, 6, 8),
        ("Heading 2", 14 if email_only else 13, 10, 6),
        ("Heading 3", 10.5, 7, 4),
    ]:
        try:
            style = document.styles[style_name]
            style.font.name = config.docx_font_name
            style._element.rPr.rFonts.set(qn("w:eastAsia"), config.docx_font_name)
            style.font.size = Pt(size)
            style.paragraph_format.space_before = Pt(before)
            style.paragraph_format.space_after = Pt(after)
            style.paragraph_format.line_spacing = 1.06
            style.paragraph_format.keep_with_next = True
        except Exception:
            continue

    for paragraph in document.paragraphs:
        _docx_v553_apply_paragraph_spacing(
            paragraph,
            email_only=email_only,
            table_cell=False,
            config=config,
        )

    for table in document.tables:
        for row in table.rows:
            for cell in row.cells:
                try:
                    cell.vertical_alignment = WD_CELL_VERTICAL_ALIGNMENT.CENTER
                except Exception:
                    pass
                for paragraph in cell.paragraphs:
                    _docx_v553_apply_paragraph_spacing(
                        paragraph,
                        email_only=email_only,
                        table_cell=True,
                        config=config,
                    )


# =========================================================
# V5.7.38 CENTRALIZED GRAIN MATURITY PERIOD RESOLUTION
# =========================================================
# Business rule:
# - Keep the full source dataset available for rolling history.
# - Daily uses the latest available source date.
# - Weekly uses Sunday-Saturday, but if the latest available date is Sunday,
#   the Weekly grain uses the previous completed week because a one-day Sunday
#   week is already covered by Daily.
# - Monthly uses current MTD only on day 7 or later; days 1-6 use the previous
#   completed month.
# - Specific / historical period modes still respect the selected Anchor Date
#   and selected historical period, with the effective source date limited to
#   that selected period.
_v537_build_report_scope = build_report_scope


def _v538_valid_report_dates(df: pd.DataFrame) -> pd.Series:
    """Return normalized valid Date values from the full source view."""
    if df is None or df.empty or "Date" not in df.columns:
        return pd.Series(dtype="datetime64[ns]")
    dates = pd.to_datetime(df["Date"], errors="coerce").dropna()
    if dates.empty:
        return pd.Series(dtype="datetime64[ns]")
    return dates.dt.normalize()


def _v538_date_range_rows(
    df: pd.DataFrame,
    start: Any,
    end: Any,
) -> pd.DataFrame:
    """Return rows inside an inclusive Date range without mutating the source."""
    if df is None or df.empty or "Date" not in df.columns:
        return pd.DataFrame()
    start_ts = pd.Timestamp(start).normalize()
    end_ts = pd.Timestamp(end).normalize()
    dates = pd.to_datetime(df["Date"], errors="coerce").dt.normalize()
    return df.loc[dates.between(start_ts, end_ts, inclusive="both")].copy()


def _v538_effective_week_for_latest_date(
    latest_date: Any,
    apply_sunday_guard: bool = True,
) -> Dict[str, pd.Timestamp]:
    """
    Resolve the Weekly grain period.

    Sunday is treated as too early for a new Weekly readout only for live/current
    runs. Historical/specific runs can still use their selected week.
    """
    latest = pd.Timestamp(latest_date).normalize()
    weekly_data_through = latest

    if apply_sunday_guard and latest.dayofweek == 6:
        weekly_data_through = latest - pd.Timedelta(days=1)

    week_start = sunday_week_start(weekly_data_through)
    week_end = week_start + pd.Timedelta(days=6)
    return {
        "weekly_report_start": week_start,
        "weekly_report_end": week_end,
        "weekly_source_data_through": min(weekly_data_through, week_end),
        "weekly_guard_applied": bool(apply_sunday_guard and latest.dayofweek == 6),
    }


def _v538_effective_month_for_latest_date(
    latest_date: Any,
    apply_month_guard: bool = True,
) -> Dict[str, Any]:
    """
    Resolve the Monthly grain period.

    Current month is shown only once at least seven source days are available in
    that month. Until then, use the previous completed month.
    """
    latest = pd.Timestamp(latest_date).normalize()
    month_guard_applied = bool(apply_month_guard and latest.day < 7)

    if month_guard_applied:
        reference_start = month_start(latest) - pd.DateOffset(months=1)
        reference_start = pd.Timestamp(reference_start).normalize()
        data_through = month_end(reference_start)
        is_incomplete = False
    else:
        reference_start = month_start(latest)
        data_through = latest
        is_incomplete = bool(data_through < month_end(reference_start))

    return {
        "reference_month_start": reference_start,
        "reference_month_end": month_end(reference_start),
        "monthly_data_through": pd.Timestamp(data_through).normalize(),
        "current_month_incomplete": bool(is_incomplete),
        "monthly_guard_applied": month_guard_applied,
    }


def _v538_period_label_for_selection(
    selection_value: str,
    start: pd.Timestamp,
    end: pd.Timestamp,
) -> str:
    """Return the display label for the selected report period."""
    selection_value = normalize_text(selection_value).upper()
    if "WEEK" in selection_value:
        return (
            f"{week_beginning_chart_label(start)} "
            f"({start.strftime('%m/%d/%Y')}–{end.strftime('%m/%d/%Y')})"
        )
    if "DAY" in selection_value:
        return start.strftime("%m/%d/%Y")
    return month_label(start)


def build_report_scope(
    df: pd.DataFrame,
    report_month_selection: str,
    anchor_date: Any = "",
    config: AppConfig = CONFIG,
) -> Dict[str, Any]:
    """
    Build report scope with v5.7.38 grain maturity rules.

    The source DataFrame is not truncated before grain calculations. This scope
    only resolves the effective current period per grain so the executive trend
    chart, taxonomy tables, squad tables, and per-site views do not disagree.
    """
    if df is None or df.empty:
        raise ValueError("The business-filtered dataset is empty.")
    if "Date" not in df.columns:
        raise ValueError("The normalized source is missing the Date column.")

    valid_dates = _v538_valid_report_dates(df)
    if valid_dates.empty:
        raise ValueError("Date has no valid values after business filtering.")

    latest_source_date = pd.Timestamp(valid_dates.max()).normalize()
    current = now_manila().tz_localize(None).normalize()
    selection_value = normalize_text(report_month_selection).upper()

    month_offsets = {
        "CURRENT MONTH": 0,
        "PREVIOUS MONTH": 1,
        "MONTH BEFORE PREVIOUS MONTH": 2,
    }
    week_offsets = {
        "CURRENT WEEK": 0,
        "PREVIOUS WEEK": 1,
        "WEEK BEFORE PREVIOUS WEEK": 2,
    }
    specific_modes = {
        "SPECIFIC MONTH",
        "SPECIFIC WEEK",
        "SPECIFIC DAY",
    }
    allowed_modes = set(month_offsets) | set(week_offsets) | specific_modes

    if selection_value not in allowed_modes:
        raise ValueError(
            "Unsupported report-period selection. Choose Current Month, "
            "Previous Month, Month Before Previous Month, Current Week, "
            "Previous Week, Week Before Previous Week, Specific Month, "
            "Specific Week, or Specific Day. "
            f"Received: {report_month_selection!r}"
        )

    if selection_value in specific_modes and anchor_date in (None, ""):
        raise ValueError(f"{report_month_selection} requires an Anchor Date.")

    parsed_anchor = _parse_report_anchor_date(
        anchor_date,
        fallback_date=latest_source_date,
    )

    live_current_mode = selection_value in {"CURRENT MONTH", "CURRENT WEEK"}
    all_months = False
    grace_period_applied = False

    if selection_value in month_offsets or selection_value == "SPECIFIC MONTH":
        period_type = "MONTH"
        if selection_value == "SPECIFIC MONTH":
            anchor_resolved = parsed_anchor
            report_start = month_start(anchor_resolved)
        else:
            months_back = month_offsets[selection_value]
            anchor_resolved = latest_source_date - pd.DateOffset(months=months_back)
            report_start = month_start(anchor_resolved)
        report_end = month_end(report_start)

    elif selection_value in week_offsets or selection_value == "SPECIFIC WEEK":
        period_type = "WEEK"
        if selection_value == "SPECIFIC WEEK":
            anchor_resolved = parsed_anchor
            report_start = sunday_week_start(anchor_resolved)
        else:
            weeks_back = week_offsets[selection_value]
            base_week_date = latest_source_date
            if selection_value == "CURRENT WEEK" and latest_source_date.dayofweek == 6:
                base_week_date = latest_source_date - pd.Timedelta(days=1)
            anchor_resolved = base_week_date - pd.Timedelta(days=7 * weeks_back)
            report_start = sunday_week_start(anchor_resolved)
        report_end = report_start + pd.Timedelta(days=6)

    else:
        period_type = "DAY"
        anchor_resolved = parsed_anchor
        report_start = anchor_resolved
        report_end = anchor_resolved

    report_start = pd.Timestamp(report_start).normalize()
    report_end = pd.Timestamp(report_end).normalize()
    report_label = _v538_period_label_for_selection(selection_value, report_start, report_end)

    display_df = _period_rows_or_error(
        df,
        report_start,
        report_end,
        report_label,
    )

    # For live/current reporting, use the freshest source date as the grain
    # resolver anchor. For previous/specific backfills, keep the grain anchor
    # inside the selected period to preserve historical report behavior.
    if live_current_mode:
        grain_anchor_date = latest_source_date
    else:
        grain_anchor_date = pd.Timestamp(
            pd.to_datetime(display_df["Date"], errors="coerce").max()
        ).normalize()

    # Daily is always the effective anchor date.
    daily_data_through = grain_anchor_date

    # Weekly maturity guard: a Sunday-only new week is not published as Weekly.
    weekly_resolution = _v538_effective_week_for_latest_date(
        grain_anchor_date,
        apply_sunday_guard=live_current_mode,
    )

    # Monthly maturity guard: days 1-6 use the previous completed month.
    monthly_resolution = _v538_effective_month_for_latest_date(
        grain_anchor_date,
        apply_month_guard=live_current_mode,
    )

    weekly_report_start = weekly_resolution["weekly_report_start"]
    weekly_report_end = weekly_resolution["weekly_report_end"]
    weekly_source_data_through = weekly_resolution["weekly_source_data_through"]

    reference_month_start = monthly_resolution["reference_month_start"]
    reference_month_end = monthly_resolution["reference_month_end"]
    monthly_data_through = monthly_resolution["monthly_data_through"]
    current_month_incomplete = bool(monthly_resolution["current_month_incomplete"])

    weekly_rows = _v538_date_range_rows(df, weekly_report_start, weekly_report_end)
    if not weekly_rows.empty:
        weekly_source_data_through = min(
            pd.Timestamp(pd.to_datetime(weekly_rows["Date"], errors="coerce").max()).normalize(),
            weekly_source_data_through,
            weekly_report_end,
        )

    monthly_scope_df = _v538_date_range_rows(
        df,
        reference_month_start,
        reference_month_end,
    )
    if monthly_scope_df.empty:
        # Defensive fallback: never fail a daily/weekly report just because the
        # monthly maturity target is unavailable in a short historical extract.
        LOGGER.warning(
            "Monthly effective period %s to %s has no rows. Falling back to selected display period.",
            reference_month_start.strftime("%Y-%m-%d"),
            reference_month_end.strftime("%Y-%m-%d"),
        )
        monthly_scope_df = display_df.copy()
        reference_month_start = month_start(grain_anchor_date)
        reference_month_end = month_end(reference_month_start)
        monthly_data_through = min(grain_anchor_date, reference_month_end)
        current_month_incomplete = bool(monthly_data_through < reference_month_end)

    is_live_reporting_month = reference_month_start == month_start(current)
    weekly_allow_projection = bool(
        live_current_mode
        and not weekly_resolution.get("weekly_guard_applied", False)
        and weekly_source_data_through < weekly_report_end
    )

    pattern_start = report_start
    observed_display_end = min(
        pd.Timestamp(pd.to_datetime(display_df["Date"], errors="coerce").max()).normalize(),
        report_end,
    )
    pattern_end = observed_display_end

    resolution_notes = [
        f"{report_month_selection} resolved to {report_label} from available source data through {latest_source_date:%Y-%m-%d}.",
        f"Daily effective date: {daily_data_through:%Y-%m-%d}.",
        (
            f"Weekly effective period: {week_beginning_chart_label(weekly_report_start)} "
            f"({weekly_report_start:%m/%d/%Y}–{weekly_report_end:%m/%d/%Y})"
            f" through {weekly_source_data_through:%m/%d/%Y}."
        ),
        (
            f"Monthly effective period: {reference_month_start:%B %Y}"
            f" through {monthly_data_through:%m/%d/%Y}."
        ),
    ]
    if weekly_resolution.get("weekly_guard_applied", False):
        resolution_notes.append(
            "Sunday weekly guard applied; Weekly uses the previous completed Sunday-Saturday week."
        )
    if monthly_resolution.get("monthly_guard_applied", False):
        resolution_notes.append(
            "Monthly maturity guard applied; Monthly uses the previous completed month because the latest source day is before day 7."
        )
    resolution_reason = " ".join(resolution_notes)

    return {
        "month_selection": report_month_selection,
        "period_selection": report_month_selection,
        "period_type": period_type,
        "anchor_date": anchor_resolved,
        "report_start": report_start,
        "report_end": report_end,
        "report_label": report_label,
        "all_months": all_months,
        "display_df": display_df,
        "monthly_scope_df": monthly_scope_df,
        "data_through": daily_data_through,
        "operational_data_through": daily_data_through,
        "daily_data_through": daily_data_through,
        "weekly_source_data_through": weekly_source_data_through,
        "weekly_report_start": weekly_report_start,
        "weekly_report_end": weekly_report_end,
        "weekly_allow_projection": weekly_allow_projection,
        "monthly_data_through": monthly_data_through,
        "latest_source_date": latest_source_date,
        "reference_month_start": reference_month_start,
        "reference_month_end": reference_month_end,
        "pattern_start": pattern_start,
        "pattern_end": pattern_end,
        "pattern_label": (
            f"{pattern_start.strftime('%m/%d/%Y')}–{pattern_end.strftime('%m/%d/%Y')}"
            if pattern_start != pattern_end
            else pattern_start.strftime("%m/%d/%Y")
        ),
        "current_month_incomplete": current_month_incomplete,
        "is_live_reporting_month": is_live_reporting_month,
        "latest_available_month_grace_days": int(
            config.latest_available_month_grace_days
        ),
        "grace_period_applied": grace_period_applied,
        "weekly_sunday_guard_applied_v538": bool(
            weekly_resolution.get("weekly_guard_applied", False)
        ),
        "monthly_maturity_guard_applied_v538": bool(
            monthly_resolution.get("monthly_guard_applied", False)
        ),
        "effective_grain_periods_v538": {
            "DAILY": {
                "period_start": daily_data_through,
                "period_end": daily_data_through,
                "data_through": daily_data_through,
                "label": daily_data_through.strftime("%b %d, %Y"),
            },
            "WEEKLY": {
                "period_start": weekly_report_start,
                "period_end": weekly_report_end,
                "data_through": weekly_source_data_through,
                "label": week_beginning_chart_label(weekly_report_start),
                "sunday_guard_applied": bool(
                    weekly_resolution.get("weekly_guard_applied", False)
                ),
            },
            "MONTHLY": {
                "period_start": reference_month_start,
                "period_end": reference_month_end,
                "data_through": monthly_data_through,
                "label": month_label(reference_month_start),
                "maturity_guard_applied": bool(
                    monthly_resolution.get("monthly_guard_applied", False)
                ),
            },
        },
        "month_resolution_reason": resolution_reason,
        "period_resolution_reason": resolution_reason,
        "grain_period_resolution_reason_v538": resolution_reason,
    }


# =========================================================
# V5.7.39 PRE-PUBLISH GRAIN PERIOD VALIDATION
# =========================================================
def _v539_timestamp_or_none(value: Any) -> Optional[pd.Timestamp]:
    """Normalize a timestamp-like value without raising for blanks/NaT."""
    if value in (None, ""):
        return None
    try:
        parsed = pd.Timestamp(value)
    except Exception:
        return None
    if pd.isna(parsed):
        return None
    return parsed.normalize()


def _v539_latest_date_from_df(df: Optional[pd.DataFrame]) -> Optional[pd.Timestamp]:
    """Return the latest normalized Date from a source DataFrame."""
    if df is None or df.empty or "Date" not in df.columns:
        return None
    dates = pd.to_datetime(df["Date"], errors="coerce").dropna()
    if dates.empty:
        return None
    return pd.Timestamp(dates.max()).normalize()


def _v539_weekday_name(value: Any) -> str:
    """Return a weekday label for period-validation output."""
    parsed = _v539_timestamp_or_none(value)
    return "" if parsed is None else parsed.day_name()


def _v539_selected_grains(selected_grains: Optional[Sequence[str]]) -> Set[str]:
    """Normalize selected grains for validation checks."""
    if not selected_grains:
        return {"DAILY", "WEEKLY", "MONTHLY"}
    normalized: Set[str] = set()
    for grain in selected_grains:
        grain_text = normalize_text(grain).upper()
        if grain_text == "ALL GRAINS":
            normalized.update({"DAILY", "WEEKLY", "MONTHLY"})
        elif grain_text in {"DAILY", "WEEKLY", "MONTHLY"}:
            normalized.add(grain_text)
    return normalized or {"DAILY", "WEEKLY", "MONTHLY"}


def validate_and_print_resolved_grain_periods_v539(
    report_scope: Mapping[str, Any],
    selected_grains: Optional[Sequence[str]] = None,
    context_label: str = "",
) -> None:
    """
    Print and fail-fast validate the resolved Daily / Weekly / Monthly periods.

    This intentionally does not recalculate Smiley, rolling baselines, taxonomy,
    squad, or dashboard metrics. It only validates the period values already
    resolved by the working v5.7.38 grain maturity logic.
    """
    if not isinstance(report_scope, Mapping):
        raise ValueError("report_scope is required for grain period validation.")

    grains = _v539_selected_grains(selected_grains)

    latest_source_date = _v539_timestamp_or_none(
        report_scope.get("latest_source_date")
    )
    daily_data_through = _v539_timestamp_or_none(
        report_scope.get(
            "daily_data_through",
            report_scope.get("operational_data_through", report_scope.get("data_through")),
        )
    )
    weekly_start = _v539_timestamp_or_none(report_scope.get("weekly_report_start"))
    weekly_end = _v539_timestamp_or_none(report_scope.get("weekly_report_end"))
    weekly_data_through = _v539_timestamp_or_none(
        report_scope.get("weekly_source_data_through")
    )
    monthly_start = _v539_timestamp_or_none(report_scope.get("reference_month_start"))
    monthly_data_through = _v539_timestamp_or_none(
        report_scope.get("monthly_data_through")
    )

    missing = []
    if latest_source_date is None:
        missing.append("latest_source_date")
    if daily_data_through is None:
        missing.append("daily_data_through")
    if weekly_start is None:
        missing.append("weekly_report_start")
    if weekly_end is None:
        missing.append("weekly_report_end")
    if weekly_data_through is None:
        missing.append("weekly_source_data_through")
    if monthly_start is None:
        missing.append("reference_month_start")
    if monthly_data_through is None:
        missing.append("monthly_data_through")
    if missing:
        raise ValueError(
            "Resolved grain period validation failed because report_scope is "
            "missing: " + ", ".join(missing)
        )

    selection_value = normalize_text(
        report_scope.get("period_selection", report_scope.get("month_selection", ""))
    ).upper()
    is_live_current_mode = selection_value in {"CURRENT MONTH", "CURRENT WEEK"}

    # Fail fast before publishing if a live/current Sunday source date tries to
    # publish the brand-new Sunday-start week as the Weekly readout.
    if (
        "WEEKLY" in grains
        and is_live_current_mode
        and latest_source_date.dayofweek == 6
        and weekly_start == sunday_week_start(latest_source_date)
    ):
        raise RuntimeError(
            "Pre-publish grain validation failed: latest source date is Sunday "
            f"({latest_source_date:%Y-%m-%d}), but Weekly resolved to the new "
            f"Sunday-start week {week_beginning_chart_label(weekly_start)} "
            f"({weekly_start:%Y-%m-%d} to {weekly_end:%Y-%m-%d}). "
            "Weekly must use the previous completed Sunday-Saturday week."
        )

    # Fail fast if a live/current day 1-6 source date tries to publish the new
    # month instead of the previous completed month.
    if (
        "MONTHLY" in grains
        and is_live_current_mode
        and latest_source_date.day < 7
        and monthly_start == month_start(latest_source_date)
    ):
        raise RuntimeError(
            "Pre-publish grain validation failed: latest source date is within "
            f"monthly maturity days 1-6 ({latest_source_date:%Y-%m-%d}), but "
            f"Monthly resolved to {month_label(monthly_start)}. Monthly must "
            "use the previous completed month until source day 7."
        )

    title = "PRE-PUBLISH GRAIN PERIOD VALIDATION"
    if context_label:
        title += f" | {context_label}"
    print("\n" + "=" * 72)
    print(title)
    print("=" * 72)
    print(
        "Latest data date: "
        f"{latest_source_date:%Y-%m-%d} {_v539_weekday_name(latest_source_date)}"
    )
    print(f"Resolved Daily: {daily_data_through:%Y-%m-%d}")
    print(
        "Resolved Weekly: "
        f"{week_beginning_chart_label(weekly_start)} | "
        f"{weekly_start:%Y-%m-%d} to {weekly_end:%Y-%m-%d}"
    )
    print(
        "Resolved Monthly: "
        f"{month_label(monthly_start)} through {monthly_data_through:%Y-%m-%d}"
    )
    print("=" * 72)


def _v539_lob_latest_date_warning(
    normalized_source_df: Optional[pd.DataFrame],
    filtered_df: Optional[pd.DataFrame],
    lob: Any,
) -> str:
    """
    Return a warning when the selected LOB latest date differs from the global
    source latest date. Periods are still resolved from the LOB-filtered data.
    """
    global_latest = _v539_latest_date_from_df(normalized_source_df)
    lob_latest = _v539_latest_date_from_df(filtered_df)
    if global_latest is None or lob_latest is None or global_latest == lob_latest:
        return ""

    lob_label = normalize_text(lob) or "Selected LOB"
    return (
        f"{lob_label} latest data date is {lob_latest:%Y-%m-%d}, while the "
        f"global source latest date is {global_latest:%Y-%m-%d}. Grain periods "
        f"for this run are resolved using the {lob_label} filtered latest date."
    )



def _v538_validate_effective_grain_scope() -> None:
    """Lightweight validation so missing grain-period resolver pieces fail fast."""
    required = (
        "_v538_valid_report_dates",
        "_v538_effective_week_for_latest_date",
        "_v538_effective_month_for_latest_date",
        "validate_and_print_resolved_grain_periods_v539",
        "build_report_scope",
