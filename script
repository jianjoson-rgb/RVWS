def build_site_grain_narrative(
    site_report: SiteReport,
    grain: str,
    report_scope: Mapping[str, Any],
    config: AppConfig = CONFIG,
) -> Dict[str, Any]:
    """
    Build the VP-approved, email-ready narrative for one site and one grain.

    The paragraph is intentionally compact but complete:
    site result -> squad drivers -> cohort/contact/QA pattern -> action.
    """
    grain = grain.upper()
    metric = site_report.grain_metrics.get(grain)
    if metric is None:
        return {
            "grain": grain,
            "period_heading": grain.title(),
            "squad_focus_title": "1. Squad Focus",
            "squad_focus_body": "No metric was available for this grain.",
            "negative_squads": [],
            "high_performer_title": "2. High-Performing Squads",
            "high_performer_body": "No metric was available for this grain.",
            "positive_squads": [],
            "action_title": "" if grain == "DAILY" else "3. Period Assessment",
            "action_body": (
                ""
                if grain == "DAILY"
                else "No action narrative was generated because the metric was unavailable."
            ),
        }

    tables = site_report.driver_tables.get(grain, {})
    squad_table = tables.get("Squad", pd.DataFrame())
    tenure_table = tables.get("Agent Tenure", pd.DataFrame())
    crafter_table = tables.get("Crafter", pd.DataFrame())
    level_one_table = tables.get("Level One", pd.DataFrame())

    negative_squad_rows = _valid_driver_rows(
        squad_table,
        "Squad Code",
        "negative",
        minimum_responses=config.site_narrative_min_squad_responses,
    ).head(config.site_narrative_negative_squads)
    positive_squad_rows = _valid_driver_rows(
        squad_table,
        "Squad Code",
        "positive",
        minimum_responses=config.site_narrative_min_squad_responses,
    ).head(config.site_narrative_positive_squads)

    negative_squads = (
        negative_squad_rows["Squad Code"].astype(str).tolist()
        if not negative_squad_rows.empty
        else []
    )
    positive_squads = (
        positive_squad_rows["Squad Code"].astype(str).tolist()
        if not positive_squad_rows.empty
        else []
    )

    negative_tenures = _driver_names(
        tenure_table,
        "Agent Tenure",
        "negative",
        config.site_narrative_tenures,
    )
    positive_tenures = _driver_names(
        tenure_table,
        "Agent Tenure",
        "positive",
        config.site_narrative_tenures,
    )
    negative_crafters = _driver_names(
        crafter_table,
        "Crafter",
        "negative",
        min(2, config.site_narrative_crafters),
        minimum_responses=config.site_narrative_min_crafter_responses,
    )
    positive_crafters = _driver_names(
        crafter_table,
        "Crafter",
        "positive",
        min(2, config.site_narrative_crafters),
        minimum_responses=config.site_narrative_min_crafter_responses,
    )
    negative_taxonomies = _driver_names(
        level_one_table,
        "Level One",
        "negative",
        config.site_narrative_taxonomies,
    )
    positive_taxonomies = _driver_names(
        level_one_table,
        "Level One",
        "positive",
        config.site_narrative_taxonomies,
    )

    site = site_report.site
    period_label = {
        "DAILY": "Latest Date",
        "WEEKLY": "Latest Week",
        "MONTHLY": "Current Month",
    }[grain]

    focus_sentences = [
        (
            f"{site} posted {format_rate(metric.actual_rate)} for the "
            f"{period_label.lower()}, {movement_phrase(metric.delta)} versus the "
            f"preceding {metric.baseline_period_count}-period average across "
            f"{format_int(metric.actual_responses)} responses."
        )
    ]

    if not negative_squad_rows.empty:
        lead = negative_squad_rows.iloc[0]
        lead_name = normalize_text(lead.get("Squad Code", ""))
        focus_title = (
            f"1. Squad Focus: {lead_name} — Primary Drag for {period_label}"
        )
        focus_sentences.append(
            (
                f"{lead_name} was the largest squad-level drag at "
                f"{format_rate(lead.get('Current Rate'))} across "
                f"{format_int(lead.get('Current Responses'))} responses, "
                f"{format_pp(lead.get('Delta vs Baseline'))} versus baseline."
            )
        )
        if len(negative_squads) > 1:
            focus_sentences.append(
                f"Additional pressure came from "
                f"{_human_join(negative_squads[1:])}."
            )
    else:
        focus_title = f"1. Squad Focus — {period_label}"
        focus_sentences.append(
            "No squad produced a qualifying negative estimated impact in this period."
        )

    risk_patterns: List[str] = []
    if negative_tenures:
        risk_patterns.append(
            f"tenure cohorts {_human_join(negative_tenures)}"
        )
    if negative_taxonomies:
        risk_patterns.append(
            f"contact drivers {_human_join(negative_taxonomies)}"
        )
    if negative_crafters:
        risk_patterns.append(
            f"priority crafters {_human_join(negative_crafters)}"
        )
    if risk_patterns:
        focus_sentences.append(
            "The negative movement is concentrated in "
            + ", ".join(risk_patterns)
            + "."
        )

    focus_sentences.append(
        _site_qa_failure_text(
            site_report,
            focus_squads=negative_squads,
            limit=3,
        )
    )
    focus_sentences.append(
        (
            f"Recommended action: prioritize recent non-smiley tickets from "
            f"{_human_join(negative_squads, 'the leading negative squads')}, "
            f"target {_human_join(negative_tenures, 'the identified tenure cohorts')} "
            f"and {_human_join(negative_taxonomies, 'the leading contact drivers')}, "
            "and coach the highest-frequency QA gaps."
        )
    )

    high_title = f"2. High-Performing Squads — {period_label}"
    high_sentences: List[str] = []

    if not positive_squad_rows.empty:
        lead_positive = positive_squad_rows.iloc[0]
        lead_positive_name = normalize_text(lead_positive.get("Squad Code", ""))
        high_sentences.append(
            (
                f"{lead_positive_name} delivered the strongest positive squad impact "
                f"at {format_rate(lead_positive.get('Current Rate'))} across "
                f"{format_int(lead_positive.get('Current Responses'))} responses."
            )
        )
        if len(positive_squads) > 1:
            high_sentences.append(
                f"{_human_join(positive_squads[1:])} also helped offset the site decline."
            )
    else:
        high_sentences.append(
            "No squad produced a qualifying positive estimated impact in this period."
        )

    positive_patterns: List[str] = []
    if positive_tenures:
        positive_patterns.append(
            f"tenure cohorts {_human_join(positive_tenures)}"
        )
    if positive_taxonomies:
        positive_patterns.append(
            f"contact drivers {_human_join(positive_taxonomies)}"
        )
    if positive_crafters:
        positive_patterns.append(
            f"priority crafters {_human_join(positive_crafters)}"
        )
    if positive_patterns:
        high_sentences.append(
            "Positive movement is concentrated in "
            + ", ".join(positive_patterns)
            + "."
        )

    high_sentences.append(
        (
            f"Recommended action: protect "
            f"{_human_join(positive_squads, 'the strongest available squads')}, "
            "validate the handling and coaching practices behind their results, "
            "and transfer only proven behaviors to the focus squads."
        )
    )

    if grain == "DAILY":
        # The latest-date view is a completed snapshot. Per VP direction, it has
        # no separate Immediate Action / Final Push block.
        action_title = ""
        action_sentences = []
    elif grain == "WEEKLY" and metric.is_incomplete:
        smileys_needed = _period_target_smileys_needed(metric, config.target_rate)
        action_title = "3. Final Push for Week-End"
        action_sentences = [
            (
                f"Through {pd.Timestamp(metric.data_through).strftime('%A, %B %d')}, "
                f"{site} is projected to finish the Sunday-Saturday week at "
                f"{format_rate(metric.projected_rate)} across approximately "
                f"{format_int(metric.projected_responses)} responses."
            ),
            (
                f"With {metric.remaining_days} calendar day(s) remaining, prioritize "
                f"{_human_join(negative_squads, 'the focus squads')} and the top QA "
                f"gaps while protecting "
                f"{_human_join(positive_squads, 'the strongest squads')}."
            ),
            (
                f"{smileys_needed:,} additional positive response(s) are needed within "
                f"projected volume to reach the {format_rate(config.target_rate)} target."
                if smileys_needed > 0
                else (
                    f"The projected close is at or above the "
                    f"{format_rate(config.target_rate)} target; the priority is to "
                    "prevent late-week dilution."
                )
            ),
        ]
    elif grain == "WEEKLY":
        action_title = "3. Week Closing Assessment"
        action_sentences = [
            (
                f"{site} closed the Sunday-Saturday week at "
                f"{format_rate(metric.actual_rate)}, {movement_phrase(metric.delta)} "
                f"versus the preceding {metric.baseline_period_count}-week average."
            ),
            (
                f"Carry the recovery plan for "
                f"{_human_join(negative_squads, 'the focus squads')} into the new week "
                f"while protecting "
                f"{_human_join(positive_squads, 'the strongest squads')}."
            ),
            "Confirm whether the movement persists before changing long-term controls.",
        ]
    elif metric.is_incomplete:
        smileys_needed = _period_target_smileys_needed(metric, config.target_rate)
        action_title = "3. Final Push for Month-End"
        action_sentences = [
            (
                f"With {metric.remaining_days} calendar day(s) remaining, {site} is "
                f"projected to close the month at {format_rate(metric.projected_rate)} "
                f"across approximately {format_int(metric.projected_responses)} responses."
            ),
            (
                f"The projected close is {format_pp(metric.projected_delta)} versus the "
                f"preceding {metric.baseline_period_count}-month average."
            ),
            (
                f"Focus on {_human_join(negative_squads, 'the priority squads')}, "
                f"{_human_join(negative_tenures, 'the identified tenure cohorts')}, and "
                f"{_human_join(negative_taxonomies, 'the leading contact drivers')} "
                f"while protecting {_human_join(positive_squads, 'the strongest squads')}."
            ),
            (
                f"{smileys_needed:,} additional positive response(s) are needed within "
                f"projected volume to reach the {format_rate(config.target_rate)} target."
                if smileys_needed > 0
                else (
                    f"The projected close is at or above the "
                    f"{format_rate(config.target_rate)} target; protect current "
                    "performance through month-end."
                )
            ),
        ]
    else:
        action_title = "3. Month-End Closing Assessment"
        action_sentences = [
            (
                f"{site} closed the selected month at "
                f"{format_rate(metric.actual_rate)}, {movement_phrase(metric.delta)} "
                f"versus the preceding {metric.baseline_period_count}-month average."
            ),
            (
                f"Carry the recovery plan for "
                f"{_human_join(negative_squads, 'the focus squads')} into the next month "
                f"while protecting "
                f"{_human_join(positive_squads, 'the strongest squads')}."
            ),
            "Use the closing result to set the next monthly coaching priorities.",
        ]

    return {
        "grain": grain,
        "period_heading": _grain_period_heading(metric),
        "squad_focus_title": focus_title,
        "squad_focus_body": " ".join(focus_sentences),
        "negative_squads": negative_squads,
        "high_performer_title": high_title,
        "high_performer_body": " ".join(high_sentences),
        "positive_squads": positive_squads,
        "action_title": action_title,
        "action_body": " ".join(action_sentences),
    }


def build_site_executive_narrative(
    site_report: SiteReport,
    report_scope: Mapping[str, Any],
    config: AppConfig = CONFIG,
) -> Dict[str, Any]:
    """
    Return all three site narratives in one backward-compatible structure.

    New report builders consume ``grain_narratives``. Legacy fields mirror the
    Monthly narrative so older audit functions remain safe.
    """
    grain_narratives = {
        grain: build_site_grain_narrative(
            site_report,
            grain,
            report_scope,
            config,
        )
        for grain in ["DAILY", "WEEKLY", "MONTHLY"]
        if grain in site_report.grain_metrics
    }
    representative = (
        grain_narratives.get("MONTHLY")
        or grain_narratives.get("WEEKLY")
        or grain_narratives.get("DAILY")
        or {}
    )
    return {
        "site": site_report.site,
        "representative_grain": representative.get("grain", ""),
        "grain_narratives": grain_narratives,
        "squad_focus_title": representative.get("squad_focus_title", ""),
        "squad_focus_body": representative.get("squad_focus_body", ""),
        "negative_squads": representative.get("negative_squads", []),
        "high_performer_title": representative.get("high_performer_title", ""),
        "high_performer_body": representative.get("high_performer_body", ""),
        "positive_squads": representative.get("positive_squads", []),
        "what_went_well": representative.get("high_performer_body", ""),
        "what_went_wrong": representative.get("squad_focus_body", ""),
        "priority_focus_cohorts": representative.get("action_body", ""),
        "recommended_action": representative.get("action_body", ""),
        "best_practice_action": representative.get("high_performer_body", ""),
        "final_push_title": representative.get("action_title", ""),
        "final_push_body": representative.get("action_body", ""),
        "smileys_needed": _period_target_smileys_needed(
            site_report.grain_metrics.get("MONTHLY"),
            config.target_rate,
        ),
    }


def build_site_narrative_output(
    site_reports: Mapping[str, SiteReport],
    report_scope: Mapping[str, Any],
    config: AppConfig = CONFIG,
) -> pd.DataFrame:
    """Create one auditable narrative row per site and grain."""
    rows: List[Dict[str, Any]] = []
    for site in config.site_detail_sites:
        report = site_reports.get(site)
        if report is None:
            continue
        for grain in ["DAILY", "WEEKLY", "MONTHLY"]:
            if grain not in report.grain_metrics:
                continue
            narrative = build_site_grain_narrative(
                report,
                grain,
                report_scope,
                config,
            )
            rows.append(
                {
                    "Site": site,
                    "Grain": grain,
                    "Period": narrative["period_heading"],
                    "Squad Focus Title": narrative["squad_focus_title"],
                    "Squad Focus Narrative": narrative["squad_focus_body"],
                    "High-Performing Squads Title": narrative["high_performer_title"],
                    "High-Performing Squads Narrative": narrative["high_performer_body"],
                    "Action Title": narrative["action_title"],
                    "Action Narrative": narrative["action_body"],
                    "Negative Squads": ", ".join(narrative["negative_squads"]),
                    "Positive Squads": ", ".join(narrative["positive_squads"]),
                }
            )
    return pd.DataFrame(rows)



