def _email_v551_num(value: Any, default: float = np.nan) -> float:
    """Safely return a float for email narrative calculations."""
    parsed = pd.to_numeric(pd.Series([value]), errors="coerce").iloc[0]
    if pd.isna(parsed):
        return default
    try:
        return float(parsed)
    except Exception:
        return default


def _email_v552_preserve_run_spacing(value: Any) -> str:
    """
    Normalize text for color-coded email/DOCX runs without stripping intentional
    leading/trailing spaces.

    The generic normalize_text() strips edge spaces, which is normally correct,
    but the email renderer builds a sentence from many styled runs. Stripping
    those spaces caused output like "Rateclosed at75.54%" and "ppvs". This
    helper keeps one leading/trailing space when the original segment needs it,
    while still cleaning duplicated internal whitespace.
    """
    if value is None or (isinstance(value, float) and np.isnan(value)):
        return ""
    raw = str(value).replace("\n", " ").replace("\r", " ")
    if raw == "":
        return ""
    leading = " " if raw[0].isspace() else ""
    trailing = " " if raw[-1].isspace() else ""
    core = re.sub(r"\s+", " ", raw).strip()
    if not core:
        return " " if leading or trailing else ""
    return f"{leading}{core}{trailing}"


def _email_v552_clean_joined_text(value: Any) -> str:
    """Clean a fully joined sentence while preserving normal readable spacing."""
    if value is None:
        return ""
    cleaned = str(value).replace("\n", " ").replace("\r", " ")
    cleaned = re.sub(r"\s+", " ", cleaned).strip()
    # Clean spaces before punctuation that can appear after joining styled runs.
    cleaned = re.sub(r"\s+([,.;:)])", r"\1", cleaned)
    cleaned = re.sub(r"([(])\s+", r"\1", cleaned)
    return cleaned


def _email_v551_seg(
    text_value: Any,
    *,
    color: str = EMAIL_V551_BLACK,
