def _window_label_v550(
    start: Any,
    end: Any,
    period_type: str = "",
    include_utc: bool = True,
) -> str:
    start_ts = pd.to_datetime(start, errors="coerce")
    end_ts = pd.to_datetime(end, errors="coerce")
    if pd.isna(start_ts) or pd.isna(end_ts):
        return "Not available"

    start_ts = pd.Timestamp(start_ts).normalize()
    end_ts = pd.Timestamp(end_ts).normalize()
    suffix = " UTC" if include_utc else ""
    period_key = normalize_text(period_type).upper()

    if period_key == "WEEK":
        return (
            f"{week_beginning_chart_label(start_ts)} "
            f"({start_ts.strftime('%b %d')}–"
            f"{end_ts.strftime('%b %d, %Y')}){suffix}"
        )
    if start_ts == end_ts:
        return f"{start_ts.strftime('%b %d, %Y')}{suffix}"
    if start_ts.year == end_ts.year:
        if start_ts.month == end_ts.month:
            return (
                f"{start_ts.strftime('%b %d')}–"
                f"{end_ts.strftime('%d, %Y')}{suffix}"
            )
        return (
            f"{start_ts.strftime('%b %d')}–"
            f"{end_ts.strftime('%b %d, %Y')}{suffix}"
        )
    return (
        f"{start_ts.strftime('%b %d, %Y')}–"
        f"{end_ts.strftime('%b %d, %Y')}{suffix}"
    )


