def normalize_source_schema(
    raw_df: pd.DataFrame,
    config: AppConfig = CONFIG,
) -> Tuple[pd.DataFrame, Dict[str, Any]]:
    df = raw_df.copy()
    df.columns = [normalize_text(column) for column in df.columns]

    if "Column 1" in df.columns:
        df = df.drop(columns=["Column 1"])

    rename_map: Dict[str, str] = {}
    for source_column, target_column in RAW_HEADER_RENAME_MAP.items():
        if source_column in df.columns and target_column not in df.columns:
            rename_map[source_column] = target_column
    if rename_map:
        df = df.rename(columns=rename_map)

    missing_core = [c for c in CORE_REQUIRED_COLUMNS if c not in df.columns]
    if missing_core:
        raise ValueError(
            "Missing required source columns: "
            + ", ".join(missing_core)
            + f". Source: {config.source_tab}!{config.source_range}"
        )

    for column, default_value in OPTIONAL_DEFAULT_COLUMNS.items():
        if column not in df.columns:
            df[column] = default_value

    object_columns = df.select_dtypes(include=["object"]).columns
    for column in object_columns:
        df[column] = (
            df[column]
            .fillna("")
            .astype(str)
            .str.replace("\n", " ", regex=False)
            .str.replace("\r", " ", regex=False)
            .str.replace(r"\s+", " ", regex=True)
            .str.strip()
        )

    df["Ticket ID"] = df["Ticket ID"].apply(clean_ticket_id)
    df["Date"] = pd.to_datetime(df["Date"], errors="coerce").dt.normalize()
    # Created Date is the interaction timestamp and is interpreted in UTC.
    # Preserve the full timestamp for hour/day analysis, and also keep a
    # normalized timezone-naive UTC date for Daily/Weekly/Monthly joins.
    created_date_utc = pd.to_datetime(
        df["Created Date"],
        errors="coerce",
        utc=True,
    )
    df["_Created Date UTC"] = created_date_utc
    df["Created Date"] = (
        created_date_utc
        .dt.tz_convert("UTC")
        .dt.tz_localize(None)
        .dt.normalize()
    )
    df["Smiley Registered At"] = pd.to_datetime(
        df["Smiley Registered At"], errors="coerce"
    )

    df["Responses"] = to_numeric_clean(df["Responses"]).fillna(0.0)
    df["Smiley Numerator"] = normalize_rate_series(df["Smiley Rate"])
    df["Non-Smiley Survey"] = to_numeric_clean(df["Non-Smiley Survey"])

    rating_normalized = (
        df["Smiley Rating"].fillna("").astype(str).str.strip().str.lower()
    )
    negative_rating_mask = rating_normalized.str.contains(
        "frown|negative|non.?smiley|nss", regex=True
    )
    positive_rating_mask = (
        rating_normalized.str.contains("smiley|positive", regex=True)
        & ~negative_rating_mask
    )
    derived_smiley = np.where(
        negative_rating_mask,
        0.0,
        np.where(positive_rating_mask, 1.0, np.nan),
    )
    missing_numerator = df["Smiley Numerator"].isna()
    df.loc[missing_numerator, "Smiley Numerator"] = pd.Series(
        derived_smiley, index=df.index
    ).loc[missing_numerator]

    response_fix_mask = (
        df["Responses"].le(0)
        & df["Smiley Numerator"].notna()
        & df["Ticket ID"].ne("")
    )
    response_rows_repaired = int(response_fix_mask.sum())
    if response_rows_repaired:
        LOGGER.warning(
            "Set Responses to 1 for %d rows with a valid rating but zero/missing "
            "Responses. This repair is logged in the validation output.",
            response_rows_repaired,
        )
        df.loc[response_fix_mask, "Responses"] = 1.0

    # Smiley Numerator should represent positive responses, not a rate multiplied
    # by Responses. Preserve the original whitepaper logic:
    # SUM(Smiley Rate) / SUM(Responses).
    invalid_numerator_mask = (
        df["Smiley Numerator"].lt(0)
        | df["Smiley Numerator"].gt(df["Responses"].where(df["Responses"].gt(0), 1))
    )
    invalid_numerator_count = int(invalid_numerator_mask.fillna(False).sum())

    df["Company"] = df["Company"].map(normalize_text)
    df["Team Code"] = df["Team Code"].map(normalize_text)
    df["Squad Code"] = df["Squad Code"].map(normalize_text)
    df["Level Of Detail Value"] = df["Level Of Detail Value"].map(normalize_text)
    df["Ticket Channel"] = df["Ticket Channel"].map(normalize_text)
    df["Site"] = df["Site"].map(normalize_text).replace(BPO_LOCATION_CODE_MAP)
    df["Smiley Comment"] = df["Smiley Comment"].map(normalize_text)
    df["Level One"] = df["Level One"].map(normalize_text)
    df["Level Two"] = df["Level Two"].map(normalize_text)
    df["Type of Audit"] = df["Type of Audit"].map(normalize_text)

    df["Month Key"] = df["Date"].dt.strftime("%Y-%m")
    df["Month Start"] = df["Date"].dt.to_period("M").dt.to_timestamp()
    df["Week Start"] = df["Date"].apply(
        lambda value: sunday_week_start(value) if pd.notna(value) else pd.NaT
    )
    df["Week End"] = df["Week Start"] + pd.Timedelta(days=6)

    qa_validation: Dict[str, Dict[str, int]] = {}
    for column in QA_ATTRIBUTE_COLUMNS:
        raw_numeric = to_numeric_clean(df[column])
        valid_mask = raw_numeric.isin([0, 1]) | raw_numeric.isna()
        invalid_count = int((~valid_mask).sum())
        df[column] = raw_numeric.where(raw_numeric.isin([0, 1]), np.nan)
        qa_validation[column] = {
            "audited": int(df[column].notna().sum()),
            "passed": int(df[column].eq(1).sum()),
            "failed": int(df[column].eq(0).sum()),
            "invalid": invalid_count,
        }

    for impact_column in SOURCE_IMPACT_COLUMNS.values():
        df[impact_column] = to_numeric_clean(df[impact_column])

    invalid_date_count = int(df["Date"].isna().sum())
    invalid_created_date_count = int(df["_Created Date UTC"].isna().sum())
    created_date_valid_count = int(df["_Created Date UTC"].notna().sum())
    created_date_min_utc = (
        df["_Created Date UTC"].min()
        if created_date_valid_count
        else pd.NaT
    )
    created_date_max_utc = (
        df["_Created Date UTC"].max()
        if created_date_valid_count
        else pd.NaT
    )
    created_date_distinct_utc_hours = int(
        df.loc[
            df["_Created Date UTC"].notna(),
            "_Created Date UTC",
        ].dt.hour.nunique()
    )
    empty_ticket_id_count = int(df["Ticket ID"].eq("").sum())
    zero_response_count = int(df["Responses"].le(0).sum())

    before_bad_row_removal = len(df)
    df = df[
        df["Date"].notna()
        & df["Ticket ID"].ne("")
        & df["Responses"].gt(0)
        & df["Smiley Numerator"].notna()
    ].copy()
    removed_bad_rows = before_bad_row_removal - len(df)

    duplicate_count = int(df.duplicated(subset=["Ticket ID"], keep=False).sum())
    duplicate_ticket_ids = int(
        df.loc[df.duplicated(subset=["Ticket ID"], keep=False), "Ticket ID"].nunique()
    )

    duplicate_audit = pd.DataFrame()
    if config.deduplicate_tickets and duplicate_count:
        duplicate_audit = df[
            df.duplicated(subset=["Ticket ID"], keep=False)
        ].copy()
        sort_date = df["Smiley Registered At"].fillna(
            df["Date"] + pd.Timedelta(hours=23, minutes=59)
        )
        df = (
            df.assign(_dedup_sort_date=sort_date)
            .sort_values(["Ticket ID", "_dedup_sort_date"])
            .drop_duplicates(subset=["Ticket ID"], keep="last")
            .drop(columns=["_dedup_sort_date"])
            .reset_index(drop=True)
        )

    reporting_missing = [
        column
        for column in REPORTING_RECOMMENDED_COLUMNS
        if column not in raw_df.columns and column not in RAW_HEADER_RENAME_MAP.values()
    ]
    qa_columns_present = [
        column for column in QA_ATTRIBUTE_COLUMNS if column in raw_df.columns
    ]
    impact_columns_present = [
        column for column in SOURCE_IMPACT_COLUMNS.values() if column in raw_df.columns
    ]

    validation = {
        "raw_rows": int(len(raw_df)),
        "normalized_rows": int(len(df)),
        "raw_columns": int(len(raw_df.columns)),
        "removed_bad_rows": int(removed_bad_rows),
        "invalid_date_count": invalid_date_count,
        "invalid_created_date_count": invalid_created_date_count,
        "created_date_valid_count": created_date_valid_count,
        "created_date_min_utc": (
            created_date_min_utc.isoformat()
            if pd.notna(created_date_min_utc)
            else ""
        ),
        "created_date_max_utc": (
            created_date_max_utc.isoformat()
            if pd.notna(created_date_max_utc)
            else ""
        ),
        "created_date_distinct_utc_hours": created_date_distinct_utc_hours,
        "empty_ticket_id_count": empty_ticket_id_count,
        "zero_response_count_before_removal": zero_response_count,
        "response_rows_repaired": response_rows_repaired,
        "invalid_numerator_count": invalid_numerator_count,
        "duplicate_rows_before_dedup": duplicate_count,
        "duplicate_ticket_ids": duplicate_ticket_ids,
        "deduplicate_tickets_enabled": config.deduplicate_tickets,
        "reporting_recommended_missing": reporting_missing,
        "qa_columns_present": qa_columns_present,
        "impact_columns_present": impact_columns_present,
        "qa_validation": qa_validation,
        "duplicate_audit": duplicate_audit,
    }

    if df.empty:
        raise ValueError("No valid rows remain after source validation.")

    LOGGER.info(
        "Source normalization complete: %d valid rows, %d unique tickets.",
        len(df),
        df["Ticket ID"].nunique(),
    )
    return df, validation


def validation_summary_dataframe(validation: Mapping[str, Any]) -> pd.DataFrame:
    rows: List[Dict[str, Any]] = []
    scalar_keys = [
        "raw_rows",
        "normalized_rows",
        "raw_columns",
        "removed_bad_rows",
        "invalid_date_count",
        "invalid_created_date_count",
        "created_date_valid_count",
        "created_date_min_utc",
        "created_date_max_utc",
        "created_date_distinct_utc_hours",
        "empty_ticket_id_count",
        "zero_response_count_before_removal",
        "response_rows_repaired",
        "invalid_numerator_count",
        "duplicate_rows_before_dedup",
        "duplicate_ticket_ids",
        "deduplicate_tickets_enabled",
    ]
    for key in scalar_keys:
        rows.append({"Validation Item": key, "Value": validation.get(key, "")})

    rows.append(
        {
            "Validation Item": "reporting_recommended_missing",
            "Value": ", ".join(validation.get("reporting_recommended_missing", []))
            or "None",
        }
    )
    rows.append(
        {
            "Validation Item": "qa_columns_present",
            "Value": ", ".join(validation.get("qa_columns_present", [])) or "None",
        }
    )
    rows.append(
        {
            "Validation Item": "impact_columns_present",
            "Value": ", ".join(validation.get("impact_columns_present", []))
            or "None",
        }
    )

    raw_staging_validation = validation.get("raw_staging_validation_v563", {})
    if raw_staging_validation:
        rows.append(
            {
                "Validation Item": "raw_staging_source_range",
                "Value": raw_staging_validation.get("source_range", ""),
            }
        )
        rows.append(
            {
                "Validation Item": "raw_staging_expected_columns",
                "Value": raw_staging_validation.get("expected_columns", ""),
            }
        )
        rows.append(
            {
                "Validation Item": "raw_staging_actual_columns",
                "Value": raw_staging_validation.get("actual_columns", ""),
            }
        )
        rows.append(
            {
                "Validation Item": "raw_staging_missing_columns",
                "Value": ", ".join(raw_staging_validation.get("missing_columns", []))
                or "None",
            }
        )

    for column, stats in validation.get("qa_validation", {}).items():
        rows.append(
            {
                "Validation Item": f"QA: {column}",
                "Value": json.dumps(stats),
            }
        )
    return pd.DataFrame(rows)


