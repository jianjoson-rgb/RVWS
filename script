def _docx_v560_add_email_grain_chart(
    document: Document,
    readout: Mapping[str, Any],
    *,
    config: AppConfig = CONFIG,
) -> bool:
    """Add one email grain chart image with clean spacing."""
    chart_path = normalize_text(readout.get("chart_path", ""))
    if not chart_path or not Path(chart_path).exists():
        return False

    chart_title = normalize_text(readout.get("chart_title", "")) or "Smiley Trend Chart"
    chart_heading = document.add_heading(chart_title, level=2)
    try:
        chart_heading.paragraph_format.space_before = Pt(8)
        chart_heading.paragraph_format.space_after = Pt(4)
    except Exception:
        pass

    paragraph = document.add_paragraph()
    paragraph.alignment = WD_ALIGN_PARAGRAPH.CENTER
    paragraph.paragraph_format.space_before = Pt(0)
    paragraph.paragraph_format.space_after = Pt(8)
    paragraph.paragraph_format.line_spacing = 1.0

    try:
        run = paragraph.add_run()
        run.add_picture(chart_path, width=Inches(7.05))
    except Exception as exc:
        LOGGER.warning("Could not embed email chart %s: %s", chart_path, exc)
        try:
            fallback = document.add_paragraph(f"[Chart unavailable: {chart_title}]")
            fallback.paragraph_format.space_after = Pt(6)
            for run in fallback.runs:
                run.font.size = Pt(8.8)
                run.font.italic = True
                run.font.color.rgb = RGBColor.from_string(EMAIL_V551_GRAY)
        except Exception:
            pass
        return False

    try:
        inline_shapes = document.inline_shapes
        if inline_shapes:
            inline_shape = inline_shapes[-1]
            descr = normalize_text(readout.get("chart_alt_text", chart_title))
            inline_shape._inline.docPr.set("descr", descr)
            inline_shape._inline.docPr.set("title", chart_title)
    except Exception:
        pass

    return True


def _docx_add_email_body(
    document: Document,
    payload: Mapping[str, Any],
    config: AppConfig = CONFIG,
) -> None:
    """
    v5.7.61 FOR EMAIL ONLY DOCX renderer.

    Sequence:
    Overall readout -> Daily chart -> Daily detailed readout -> Weekly chart ->
    Weekly detailed readout -> Monthly chart -> Monthly detailed readout ->
    Key Performance Drivers & Recommended Actions.
    """
    if not payload.get("detailed_readouts"):
        _v559_docx_add_email_body(document, payload, config=config)
        return

    lob = normalize_text(payload.get("lob", ""))
    heading = f"{lob} Executive Summary" if lob else "Email Executive Summary"
    document.add_heading(heading, level=1)

    subject = document.add_paragraph()
    subject.paragraph_format.space_after = Pt(4)
    subject_run = subject.add_run("Subject: ")
    subject_run.bold = True
    subject_run.font.color.rgb = RGBColor.from_string(EMAIL_V551_BLUE)
    subject_run.font.size = Pt(9.2)
    subject_value = subject.add_run(normalize_text(payload.get("subject", "")))
    subject_value.font.size = Pt(9.2)

    document.add_heading(
        normalize_text(payload.get("overview_title", "Overall Performance & Bottom Line")),
        level=2,
    )
    _docx_add_email_segment_paragraph_v551(
        document,
        payload.get("overview_segments", []),
        font_size=9.0,
    )

    for readout in payload.get("detailed_readouts", []):
        if not isinstance(readout, Mapping):
            continue

        _docx_v560_add_email_grain_chart(
            document,
            readout,
            config=config,
        )

        title = normalize_text(readout.get("title", "Detailed Readout"))
        period = normalize_text(readout.get("period_label", ""))
        heading_text = title if not period else f"{title} — {period}"
        document.add_heading(heading_text, level=2)

        for block in readout.get("blocks", []):
            label = normalize_text(block.get("label", ""))
            paragraphs = block.get("paragraphs", [])
            if not paragraphs:
                continue
            _docx_v558_add_email_block(
                document,
                label,
                paragraphs,
                label_font_size=8.8,
                bullet_font_size=8.45,
            )

    document.add_heading(
        "Key Performance Drivers & Recommended Actions",
        level=2,
    )
    for section in payload.get("sections", []):
        title = normalize_text(section.get("title", ""))
        if title:
            document.add_heading(title, level=3)

        for paragraph_text in section.get("paragraphs", []):
            if normalize_text(paragraph_text):
                paragraph = document.add_paragraph(normalize_text(paragraph_text))
                paragraph.paragraph_format.space_after = Pt(3)
                paragraph.paragraph_format.line_spacing = 1.08
                for run in paragraph.runs:
                    run.font.size = Pt(8.8)

        action_heading = normalize_text(section.get("action_heading", ""))
        if action_heading:
            paragraph = document.add_paragraph()
            paragraph.paragraph_format.space_after = Pt(2)
            paragraph.paragraph_format.line_spacing = 1.08
            run = paragraph.add_run(action_heading)
            run.bold = True
            run.font.size = Pt(8.8)
            run.font.color.rgb = RGBColor.from_string(EMAIL_V551_BLUE)

        for action in section.get("actions", []):
            action_text = _email_v557_action_text(action)
            if not action_text:
                continue
            _docx_v557_add_action_bullet(
                document,
                action_text,
                level=0,
                font_size=8.8,
            )
            for sub_action in _email_v557_action_sub_actions(action):
                _docx_v557_add_action_bullet(
                    document,
                    sub_action,
                    level=1,
                    font_size=8.4,
                )

    followup = normalize_text(payload.get("followup_line", ""))
    if followup:
        paragraph = document.add_paragraph(followup)
        paragraph.paragraph_format.space_before = Pt(6)
        paragraph.paragraph_format.line_spacing = 1.08
        for run in paragraph.runs:
            run.font.size = Pt(8.8)


def _email_plain_text_from_payload(payload: Mapping[str, Any]) -> str:
    """Render the structured email payload as copy/paste text with chart placeholders."""
    if not payload.get("detailed_readouts"):
        return _v559_email_plain_text_from_payload(payload)

    lines: List[str] = []
    lob = normalize_text(payload.get("lob", ""))
    lines.append(f"{lob} Executive Summary" if lob else "Executive Summary")
    lines.append("")

    overview_title = normalize_text(payload.get("overview_title", "Overall Performance & Bottom Line"))
    lines.append(overview_title)
    overview_text = _email_v551_segments_text(payload.get("overview_segments", []))
    if overview_text:
        lines.append(overview_text)
    lines.append("")

    for readout in payload.get("detailed_readouts", []):
        chart_title = normalize_text(readout.get("chart_title", ""))
        if chart_title:
            lines.append(chart_title)
            lines.append("[Chart embedded in the FOR EMAIL ONLY Google Doc]")
            lines.append("")

        title = normalize_text(readout.get("title", "Detailed Readout"))
        period = normalize_text(readout.get("period_label", ""))
        lines.append(title if not period else f"{title} — {period}")
        for block in readout.get("blocks", []):
            label = normalize_text(block.get("label", ""))
            if label:
                lines.append(label)
            for paragraph in block.get("paragraphs", []):
                paragraph_text = _email_v551_segments_text(paragraph.get("segments", []))
                if paragraph_text:
                    level = int(paragraph.get("level", 0) or 0)
                    prefix = "  • " if level > 0 else "• "
                    lines.append(f"{prefix}{paragraph_text}")
        lines.append("")

    lines.append("Key Performance Drivers & Recommended Actions")
    lines.append("")
    for section in payload.get("sections", []):
        title = normalize_text(section.get("title", ""))
        if title:
            lines.append(title)
        for paragraph in section.get("paragraphs", []):
            paragraph_text = normalize_text(paragraph)
            if paragraph_text:
                lines.append(paragraph_text)
        action_heading = normalize_text(section.get("action_heading", ""))
        if action_heading:
            lines.append(action_heading)
        for action in section.get("actions", []):
            action_text = _email_v557_action_text(action)
            if action_text:
                lines.append(f"• {action_text}")
            for sub_action in _email_v557_action_sub_actions(action):
                if normalize_text(sub_action):
                    lines.append(f"  • {normalize_text(sub_action)}")
        lines.append("")

    followup = normalize_text(payload.get("followup_line", ""))
    if followup:
        lines.append(followup)
        lines.append("")

    return "\n".join(lines).strip() + "\n"


def _email_html_from_payload(payload: Mapping[str, Any]) -> str:
    """Render the structured email payload as Gmail-friendly HTML with chart placeholders."""
    if not payload.get("detailed_readouts"):
        return _v559_email_html_from_payload(payload)

    esc = html.escape
    parts: List[str] = [
        "<div style=\"font-family:Arial,Helvetica,sans-serif;font-size:14px;line-height:1.45;color:#202124;\">",
    ]
    lob = normalize_text(payload.get("lob", ""))
    parts.append(f"<h2>{esc(lob + ' Executive Summary' if lob else 'Executive Summary')}</h2>")

    overview_title = normalize_text(payload.get("overview_title", "Overall Performance & Bottom Line"))
    parts.append(f"<h3>{esc(overview_title)}</h3>")
    overview_html = _email_html_segments_v551(payload.get("overview_segments", []))
    if overview_html:
        parts.append(f"<p>{overview_html}</p>")

    for readout in payload.get("detailed_readouts", []):
        chart_title = normalize_text(readout.get("chart_title", ""))
        if chart_title:
            parts.append(f"<h3>{esc(chart_title)}</h3>")
            parts.append("<p><em>Chart embedded in the FOR EMAIL ONLY Google Doc.</em></p>")

        title = normalize_text(readout.get("title", "Detailed Readout"))
        period = normalize_text(readout.get("period_label", ""))
        parts.append(f"<h3>{esc(title if not period else title + ' — ' + period)}</h3>")
        for block in readout.get("blocks", []):
            label = normalize_text(block.get("label", ""))
            if label:
                parts.append(f"<p><strong>{esc(label)}</strong></p>")
            block_paragraphs = block.get("paragraphs", [])
            if block_paragraphs:
                parts.append("<ul>")
                for paragraph in block_paragraphs:
                    segment_html = _email_html_segments_v551(paragraph.get("segments", []))
                    if not segment_html:
                        continue
                    if int(paragraph.get("level", 0) or 0) > 0:
                        parts.append(f"<li style=\"margin-left:20px;\">{segment_html}</li>")
                    else:
                        parts.append(f"<li>{segment_html}</li>")
                parts.append("</ul>")

    parts.append("<p style=\"margin-top:18px;\"><strong>Key Performance Drivers &amp; Recommended Actions</strong></p>")
    for section in payload.get("sections", []):
        title = esc(normalize_text(section.get("title", "")))
        if title:
            parts.append(f"<p style=\"margin-top:16px;\"><strong>{title}</strong></p>")
        for paragraph in section.get("paragraphs", []):
            paragraph_text = normalize_text(paragraph)
            if paragraph_text:
                parts.append(f"<p>{esc(paragraph_text)}</p>")
        action_heading = normalize_text(section.get("action_heading", ""))
        if action_heading:
            parts.append(f"<p><strong>{esc(action_heading)}</strong></p>")
        actions = [
            action for action in section.get("actions", [])
            if _email_v557_action_text(action)
        ]
        if actions:
            parts.append("<ul>")
            for action in actions:
                parts.append(f"<li>{esc(_email_v557_action_text(action))}</li>")
                sub_actions = _email_v557_action_sub_actions(action)
                if sub_actions:
                    parts.append("<ul>")
                    for sub_action in sub_actions:
                        if normalize_text(sub_action):
                            parts.append(f"<li>{esc(normalize_text(sub_action))}</li>")
                    parts.append("</ul>")
            parts.append("</ul>")

    followup = normalize_text(payload.get("followup_line", ""))
    if followup:
        parts.append(f"<p style=\"margin-top:18px;\">{esc(followup)}</p>")
    parts.append("</div>")
    return "\n".join(parts)





