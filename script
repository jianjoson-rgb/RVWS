def movement_phrase(delta: float) -> str:
    if delta is None or pd.isna(delta):
        return "with insufficient baseline history"
    if delta > 0:
        return f"up {format_pp(delta, signed=False)}"
    if delta < 0:
        return f"down {format_pp(abs(delta), signed=False)}"
    return "flat"

def executive_summary_line(metric: PeriodMetric) -> str:
    classification = delta_label(metric.delta)
    if metric.grain == "DAILY":
        return (
            f"Daily Trend: {classification} at {format_rate(metric.actual_rate)}, "
            f"{movement_phrase(metric.delta)} versus the preceding "
            f"{metric.baseline_period_count}-day average, across "
            f"{format_int(metric.actual_responses)} responses."
        )

    if metric.grain == "WEEKLY":
        base = (
            f"Weekly Trend: {classification} at {format_rate(metric.actual_rate)}, "
            f"{movement_phrase(metric.delta)} versus the preceding "
            f"{metric.baseline_period_count}-week average"
        )
        if metric.is_incomplete and pd.notna(metric.projected_rate):
            base += (
                f", projected to finish the selected week window at "
                f"{format_rate(metric.projected_rate)} "
                f"({format_pp(metric.projected_delta)} versus baseline) across "
                f"approximately {format_int(metric.projected_responses)} responses"
            )
        return base + "."

    base = (
        f"Monthly Trend: {classification} at {format_rate(metric.actual_rate)}, "
        f"{movement_phrase(metric.delta)} versus the preceding "
        f"{metric.baseline_period_count}-month average"
    )
    if metric.is_incomplete and pd.notna(metric.projected_rate):
        base += (
            f", projected to close at {format_rate(metric.projected_rate)} "
            f"({format_pp(metric.projected_delta)} versus baseline) across "
            f"approximately {format_int(metric.projected_responses)} responses"
        )
    return base + "."


def site_metric_row(
    grain: str,
    result: GrainResult,
    site: str,
) -> Optional[pd.Series]:
    subset = result.site_summary[result.site_summary["Site"].eq(site)]
    if subset.empty:
        return None
    return subset.iloc[0]


def primary_site_narrative(
    primary_site: str,
    grain_results: Mapping[str, GrainResult],
) -> str:
    fragments = []
    for grain in ["MONTHLY", "WEEKLY", "DAILY"]:
        if grain not in grain_results:
            continue
        row = site_metric_row(grain, grain_results[grain], primary_site)
        if row is None:
            continue
        fragments.append(
            f"{grain.title()} {format_pp(row['Official Impact'])} impact at "
            f"{format_rate(row['Smiley Rate'])}"
        )

    if not fragments:
        return (
            f"{primary_site} is the lowest-ranked site in the selected view, "
            "but detailed grain metrics were unavailable."
        )

    negative_count = sum(
        1
        for grain, result in grain_results.items()
        if (
            (row := site_metric_row(grain, result, primary_site)) is not None
            and float(row["Official Impact"]) < 0
        )
    )
    if negative_count == len(grain_results):
        role = "the primary drag across all selected timeframes"
    elif negative_count:
        role = "the primary recovery focus across the selected timeframes"
    else:
        role = "the lowest positive contributor in the selected timeframes"

    return (
        f"{primary_site} is {role}. "
        + "; ".join(fragments)
        + "."
    )


def daily_rebound_note(
    primary_site: str,
    grain_results: Mapping[str, GrainResult],
) -> str:
    if "DAILY" not in grain_results:
        return ""
    row = site_metric_row("DAILY", grain_results["DAILY"], primary_site)
    if row is None:
        return ""
    delta_vs_scope = float(row["Delta vs Scope"])
    if delta_vs_scope >= 0:
        return (
            f"Daily Note: {primary_site}'s latest daily score reached "
            f"{format_rate(row['Smiley Rate'])}, above the overall daily result by "
            f"{format_pp(delta_vs_scope, signed=False)}."
        )
    return (
        f"Daily Note: {primary_site}'s latest daily score was "
        f"{format_rate(row['Smiley Rate'])}, trailing the overall daily result by "
        f"{format_pp(abs(delta_vs_scope), signed=False)}."
    )


