def normalize_finance_topic(value: Any) -> str:
    """Normalize Level One / Level Two values for deterministic matching."""
    text_value = normalize_text(value).casefold()
    text_value = text_value.replace("&", " and ")
    text_value = re.sub(r"[_/\\\-]+", " ", text_value)
    text_value = re.sub(r"[^a-z0-9 ]+", " ", text_value)
    return re.sub(r"\s+", " ", text_value).strip()


def normalize_smiley_outcome(value: Any) -> str:
    """
    Map the approved Smiley Rating values to canonical outcomes.

    Supported source values:
      - Smiley
      - Neutral
      - Frownie

    Unexpected nonblank values return an empty string and are excluded from
    the Finance QA outcome calculations while being surfaced in validation.
    """
    normalized = normalize_text(value).casefold()
    mapping = {
        "smiley": "Smiley",
        "neutral": "Neutral",
        "frownie": "Frownie",
    }
    return mapping.get(normalized, "")


def _finance_match_sets(
    config: AppConfig = CONFIG,
) -> Tuple[set[str], Tuple[str, ...], set[str]]:
    exact_values = {
        normalize_finance_topic(value)
        for value in config.finance_topic_exact_values
        if normalize_finance_topic(value)
    }
    keywords = tuple(
        dict.fromkeys(
            normalize_finance_topic(value)
            for value in config.finance_topic_keywords
            if normalize_finance_topic(value)
        )
    )
    untagged_values = {
        normalize_finance_topic(value)
        for value in config.finance_untagged_values
    }
    return exact_values, keywords, untagged_values


def classify_finance_population(
    df: pd.DataFrame,
    config: AppConfig = CONFIG,
) -> pd.DataFrame:
    """
    Add deterministic Finance / Other / Untagged classifications.

    Finance is assigned when normalized Level One OR Level Two exactly matches
    an approved Finance value or contains an approved Finance keyword. Rows
    where both taxonomy levels are blank/misc/unknown remain Untagged and are
    kept separate from the Finance-versus-Other comparison.
    """
    work = df.copy()
    for column in ("Level One", "Level Two"):
        if column not in work.columns:
            work[column] = ""

    exact_values, keywords, untagged_values = _finance_match_sets(config)
    level_one_norm = work["Level One"].map(normalize_finance_topic)
    level_two_norm = work["Level Two"].map(normalize_finance_topic)

    exact_match = (
        level_one_norm.isin(exact_values)
        | level_two_norm.isin(exact_values)
    )

    keyword_match = pd.Series(False, index=work.index)
    for keyword in keywords:
        keyword_match = (
            keyword_match
            | level_one_norm.str.contains(
                re.escape(keyword),
                regex=True,
                na=False,
            )
            | level_two_norm.str.contains(
                re.escape(keyword),
                regex=True,
                na=False,
            )
        )

    level_one_untagged = level_one_norm.isin(untagged_values)
    level_two_untagged = level_two_norm.isin(untagged_values)
    untagged = level_one_untagged & level_two_untagged

    work["Finance Classification"] = np.select(
        [
            untagged,
            exact_match | keyword_match,
        ],
        [
            "Untagged",
            "Finance",
        ],
        default="Other",
    )
    work["Level One Normalized"] = level_one_norm
    work["Level Two Normalized"] = level_two_norm
    work["Smiley Outcome"] = work["Smiley Rating"].map(
        normalize_smiley_outcome
    )
    return work


def _finance_sample_status(
    rated: int,
    config: AppConfig = CONFIG,
) -> str:
    if rated >= int(config.finance_qa_topic_min_responses):
        return "Finding"
    if rated >= int(config.finance_qa_directional_min_responses):
        return "Directional"
    return "Small sample"


def _finance_population_summary(
    work: pd.DataFrame,
) -> pd.DataFrame:
    valid = work[work["Smiley Outcome"].ne("")].copy()
    records: List[Dict[str, Any]] = []
    total_rated = int(len(valid))

    for segment in ["Finance", "Other", "Untagged"]:
        subset = valid[
            valid["Finance Classification"].eq(segment)
        ]
        rated = int(len(subset))
        smiley = int(subset["Smiley Outcome"].eq("Smiley").sum())
        neutral = int(subset["Smiley Outcome"].eq("Neutral").sum())
        frownie = int(subset["Smiley Outcome"].eq("Frownie").sum())
        unhappy = neutral + frownie
        records.append(
            {
                "Segment": segment,
                "Rated": rated,
                "Smiley": smiley,
                "Neutral": neutral,
                "Frownie": frownie,
                "Smiley Rate": safe_rate(smiley, rated),
                "Neutral Share": safe_rate(neutral, rated),
                "Frownie Share": safe_rate(frownie, rated),
                "Unhappy": unhappy,
                "Unhappy Rate": safe_rate(unhappy, rated),
                "Share of Rated": safe_rate(rated, total_rated),
            }
        )

    summary = pd.DataFrame(records)
    finance_row = summary[summary["Segment"].eq("Finance")]
    other_row = summary[summary["Segment"].eq("Other")]
    finance_unhappy = (
        float(finance_row.iloc[0]["Unhappy Rate"])
        if not finance_row.empty
        else np.nan
    )
    other_unhappy = (
        float(other_row.iloc[0]["Unhappy Rate"])
        if not other_row.empty
        else np.nan
    )
    summary["Finance vs Other Unhappy Gap (pp)"] = np.nan
    if pd.notna(finance_unhappy) and pd.notna(other_unhappy):
        summary.loc[
            summary["Segment"].eq("Finance"),
            "Finance vs Other Unhappy Gap (pp)",
        ] = (finance_unhappy - other_unhappy) * 100
    return summary


def _segment_qa_counts(
    subset: pd.DataFrame,
    attribute: str,
) -> Tuple[int, int, int, float, float]:
    values = pd.to_numeric(
        subset[attribute],
        errors="coerce",
    )
    valid = values[values.isin([0, 1])]
    audited = int(valid.notna().sum())
    passed = int(valid.eq(1).sum())
    failed = int(valid.eq(0).sum())
    pass_rate = safe_rate(passed, audited)
    failure_rate = safe_rate(failed, audited)
    return audited, passed, failed, pass_rate, failure_rate


def _finance_qa_attribute_summary(
    work: pd.DataFrame,
    config: AppConfig = CONFIG,
) -> pd.DataFrame:
    records: List[Dict[str, Any]] = []

    for attribute in QA_ATTRIBUTE_COLUMNS:
        finance = work[
            work["Finance Classification"].eq("Finance")
        ]
        other = work[
            work["Finance Classification"].eq("Other")
        ]

        (
            finance_audited,
            finance_passed,
            finance_failed,
            finance_pass_rate,
            finance_failure_rate,
        ) = _segment_qa_counts(finance, attribute)
        (
            other_audited,
            other_passed,
            other_failed,
            other_pass_rate,
            other_failure_rate,
        ) = _segment_qa_counts(other, attribute)

        outcome_failure_rates: Dict[str, float] = {}
        outcome_audits: Dict[str, int] = {}
        for outcome in ["Smiley", "Neutral", "Frownie"]:
            outcome_subset = finance[
                finance["Smiley Outcome"].eq(outcome)
            ]
            audited, _, _, _, failure_rate = _segment_qa_counts(
                outcome_subset,
                attribute,
            )
            outcome_audits[outcome] = audited
            outcome_failure_rates[outcome] = failure_rate

        gap_pp = (
            (finance_pass_rate - other_pass_rate) * 100
            if pd.notna(finance_pass_rate) and pd.notna(other_pass_rate)
            else np.nan
        )

        records.append(
            {
                "QA Attribute": attribute,
                "Finance Audited": finance_audited,
                "Finance Passed": finance_passed,
                "Finance Failed": finance_failed,
                "Finance Pass Rate": finance_pass_rate,
                "Finance Failure Rate": finance_failure_rate,
                "Other Audited": other_audited,
                "Other Passed": other_passed,
                "Other Failed": other_failed,
                "Other Pass Rate": other_pass_rate,
                "Other Failure Rate": other_failure_rate,
                "Finance vs Other Pass Gap (pp)": gap_pp,
                "Finance Smiley Audited": outcome_audits["Smiley"],
                "Finance Smiley Failure Rate": outcome_failure_rates["Smiley"],
                "Finance Neutral Audited": outcome_audits["Neutral"],
                "Finance Neutral Failure Rate": outcome_failure_rates["Neutral"],
                "Finance Frownie Audited": outcome_audits["Frownie"],
                "Finance Frownie Failure Rate": outcome_failure_rates["Frownie"],
                "Minimum Audit Threshold Met": (
                    finance_audited
                    >= int(config.finance_qa_min_attribute_audits)
                    and other_audited
                    >= int(config.finance_qa_min_attribute_audits)
                ),
            }
        )

    return pd.DataFrame(records)



def _finance_rolling_window_start_v527(
    grain: str,
    period_start: pd.Timestamp,
) -> pd.Timestamp:
    """
    v5.7.28 taxonomy baseline windows.
    Daily: last 12 days including current day.
    Weekly: last 12 weeks including current week.
    Monthly: last 3 months including current month.
    """
    grain_key = normalize_text(grain).upper()
    start = pd.Timestamp(period_start).normalize()
    if grain_key == "DAILY":
        return start - pd.Timedelta(days=11)
    if grain_key == "WEEKLY":
        return start - pd.Timedelta(weeks=11)
    if grain_key == "MONTHLY":
        return start - pd.DateOffset(months=2)
    return start


def _finance_rolling_period_count_v527(grain: str) -> int:
    grain_key = normalize_text(grain).upper()
    if grain_key == "DAILY":
        return 12
    if grain_key == "WEEKLY":
        return 12
    if grain_key == "MONTHLY":
        return 3
    return 1


def _finance_topic_baseline_map_v527(
    baseline_work: pd.DataFrame,
    topic_column: str,
    grain: str,
    config: AppConfig = CONFIG,
) -> Dict[str, Dict[str, Any]]:
    """
    Build rolling baseline values by taxonomy topic using the same ratio-of-sums
    style as the executive performance trend chart.

    Rates use SUM(Smiley) / SUM(Rated).
    Count deltas compare the current period count against the average count per
    rolling period in the baseline window.
    """
    if baseline_work is None or baseline_work.empty or topic_column not in baseline_work.columns:
        return {}

    finance = baseline_work[
        baseline_work["Finance Classification"].eq("Finance")
        & baseline_work["Smiley Outcome"].isin(["Smiley", "Neutral", "Frownie"])
    ].copy()
    if finance.empty:
        return {}

    finance[topic_column] = finance[topic_column].map(normalize_text)
    finance = finance[finance[topic_column].ne("")].copy()
    if finance.empty:
        return {}

    period_count = max(1, int(_finance_rolling_period_count_v527(grain)))
    baseline: Dict[str, Dict[str, Any]] = {}
    for topic, group in finance.groupby(topic_column, dropna=False):
        rated = int(len(group))
        smiley = int(group["Smiley Outcome"].eq("Smiley").sum())
        neutral = int(group["Smiley Outcome"].eq("Neutral").sum())
        frownie = int(group["Smiley Outcome"].eq("Frownie").sum())
        non_smiley = neutral + frownie
        baseline[normalize_text(topic)] = {
            "Baseline Rated": rated,
            "Baseline Smiley": smiley,
            "Baseline Neutral": neutral,
            "Baseline Frownie": frownie,
            "Baseline Non-Smiley": non_smiley,
            "Baseline Smiley Rate": safe_rate(smiley, rated),
            "Avg Smiley Count": smiley / period_count,
            "Avg Non-Smiley Count": non_smiley / period_count,
        }
    return baseline


def _format_pp_delta_v527(value: Any) -> str:
    numeric = pd.to_numeric(pd.Series([value]), errors="coerce").iloc[0]
    if pd.isna(numeric):
        return "N/A"
    if abs(float(numeric)) < 0.05:
        return "0.0 pp"
    arrow = "▲" if float(numeric) > 0 else "▼"
    return f"{arrow} {float(numeric):+.1f} pp"


def _format_count_delta_v527(value: Any, positive_good: bool = True) -> str:
    numeric = pd.to_numeric(pd.Series([value]), errors="coerce").iloc[0]
    if pd.isna(numeric):
        return "N/A"
    if abs(float(numeric)) < 0.05:
        return "0.0"
    if positive_good:
        arrow = "▲" if float(numeric) > 0 else "▼"
    else:
        arrow = "▲" if float(numeric) > 0 else "▼"
    return f"{arrow} {float(numeric):+.1f}"


def _finance_topic_summary(
    work: pd.DataFrame,
    topic_column: str,
    config: AppConfig = CONFIG,
    baseline_work: Optional[pd.DataFrame] = None,
    grain: str = "",
) -> pd.DataFrame:
    if topic_column not in work.columns:
        return pd.DataFrame()

    finance = work[
        work["Finance Classification"].eq("Finance")
        & work["Smiley Outcome"].isin(["Smiley", "Neutral", "Frownie"])
    ].copy()
    finance[topic_column] = finance[topic_column].map(normalize_text)
    finance = finance[finance[topic_column].ne("")].copy()
    if finance.empty:
        return pd.DataFrame()

    baseline_map = _finance_topic_baseline_map_v527(
        baseline_work if baseline_work is not None else pd.DataFrame(),
        topic_column,
        grain,
        config,
    )

    total_finance_unhappy = int(
        finance["Smiley Outcome"].isin(["Neutral", "Frownie"]).sum()
    )
    rows: List[Dict[str, Any]] = []

    for topic, group in finance.groupby(topic_column, dropna=False):
        topic_name = normalize_text(topic)
        rated = int(len(group))
        smiley = int(group["Smiley Outcome"].eq("Smiley").sum())
        neutral = int(group["Smiley Outcome"].eq("Neutral").sum())
        frownie = int(group["Smiley Outcome"].eq("Frownie").sum())
        unhappy = neutral + frownie
        smiley_rate = safe_rate(smiley, rated)

        baseline = baseline_map.get(topic_name, {})
        baseline_rate = baseline.get("Baseline Smiley Rate", np.nan)
        baseline_avg_smiley = baseline.get("Avg Smiley Count", np.nan)
        baseline_avg_non_smiley = baseline.get("Avg Non-Smiley Count", np.nan)

        if pd.notna(baseline_rate):
            delta_rate_pp = (float(smiley_rate) - float(baseline_rate)) * 100
        else:
            delta_rate_pp = np.nan

        if pd.notna(baseline_avg_smiley):
            delta_smiley_count = float(smiley) - float(baseline_avg_smiley)
        else:
            delta_smiley_count = np.nan

        if pd.notna(baseline_avg_non_smiley):
            delta_non_smiley_count = float(unhappy) - float(baseline_avg_non_smiley)
        else:
            delta_non_smiley_count = np.nan

        qa_values = group[list(QA_ATTRIBUTE_COLUMNS)].apply(
            pd.to_numeric,
            errors="coerce",
        )
        valid_qa = qa_values.where(qa_values.isin([0, 1]))
        qa_audited = int(valid_qa.notna().sum().sum())
        qa_passed = int(valid_qa.eq(1).sum().sum())

        rows.append(
            {
                "Topic Level": topic_column,
                "Topic": topic_name,
                "Rated": rated,
                "Smiley": smiley,
                "Neutral": neutral,
                "Frownie": frownie,
                "Unhappy": unhappy,
                "Smiley Rate": smiley_rate,
                "Unhappy Rate": safe_rate(unhappy, rated),
                "Smiley Rate Delta pp": delta_rate_pp,
                "Smiley Count Delta": delta_smiley_count,
                "Non-Smiley Count Delta": delta_non_smiley_count,
                "Baseline Smiley Rate": baseline_rate,
                "Baseline Avg Smiley Count": baseline_avg_smiley,
                "Baseline Avg Non-Smiley Count": baseline_avg_non_smiley,
                "Contribution to Finance Unhappy": safe_rate(
                    unhappy,
                    total_finance_unhappy,
                ),
                "QA Audited Checks": qa_audited,
                "QA Pass Rate": safe_rate(qa_passed, qa_audited),
                "Sample Status": _finance_sample_status(rated, config),
            }
        )

    return (
        pd.DataFrame(rows)
        .sort_values(
            [
                "Unhappy",
                "Rated",
                "Unhappy Rate",
            ],
            ascending=[False, False, False],
        )
        .reset_index(drop=True)
    )



def _finance_qa_insights(
    grain: str,
    period_label: str,
    population_summary: pd.DataFrame,
    qa_summary: pd.DataFrame,
    level_one_summary: pd.DataFrame,
    level_two_summary: pd.DataFrame,
    config: AppConfig = CONFIG,
) -> List[str]:
    """Build executive Finance/QA insights using Smiley Rate language."""
    insights: List[str] = []

    finance = population_summary[
        population_summary["Segment"].eq("Finance")
    ]
    other = population_summary[
        population_summary["Segment"].eq("Other")
    ]

    if finance.empty or int(finance.iloc[0]["Rated"]) == 0:
        return [
            (
                f"{grain.title()} ({period_label}): no rated Finance rows were "
                "identified from Level One and Level Two using the configured "
                "taxonomy rules."
            )
        ]

    finance_row = finance.iloc[0]
    other_row = other.iloc[0] if not other.empty else None
    finance_rate = pd.to_numeric(
        pd.Series([finance_row.get("Smiley Rate")]),
        errors="coerce",
    ).iloc[0]
    finance_rated = int(finance_row["Rated"])

    if (
        other_row is not None
        and int(other_row["Rated"]) > 0
        and pd.notna(other_row.get("Smiley Rate"))
        and pd.notna(finance_rate)
    ):
        other_rate = float(other_row["Smiley Rate"])
        gap_pp = (float(finance_rate) - other_rate) * 100
        if gap_pp > 0:
            comparison_text = f"{abs(gap_pp):.1f} pp higher than Other"
        elif gap_pp < 0:
            comparison_text = f"{abs(gap_pp):.1f} pp lower than Other"
        else:
            comparison_text = "the same as Other"
        insights.append(
            (
                f"{grain.title()} {period_label}: Finance recorded "
                f"{finance_rated:,} rated responses at a "
                f"{format_rate(finance_rate)} Smiley Rate, which is "
                f"{comparison_text} ({format_rate(other_rate)})."
            )
        )
    else:
        insights.append(
            (
                f"{grain.title()} {period_label}: Finance recorded "
                f"{finance_rated:,} rated responses at a "
                f"{format_rate(finance_rate)} Smiley Rate; no eligible Other "
                "comparison was available."
            )
        )

    eligible_qa = qa_summary[
        qa_summary["Minimum Audit Threshold Met"].eq(True)
        & qa_summary["Finance vs Other Pass Gap (pp)"].notna()
    ].copy()
    if not eligible_qa.empty:
        weakest_gap = eligible_qa.sort_values(
            "Finance vs Other Pass Gap (pp)",
            ascending=True,
        ).iloc[0]
        insights.append(
            (
                f"The largest eligible Finance QA disadvantage is "
                f"{weakest_gap['QA Attribute']} at "
                f"{float(weakest_gap['Finance vs Other Pass Gap (pp)']):+.1f} pp "
                "versus Other. This is an association, not a causal claim."
            )
        )

    for outcome, column in [
        ("Neutral", "Finance Neutral Failure Rate"),
        ("Frownie", "Finance Frownie Failure Rate"),
    ]:
        audit_column = f"Finance {outcome} Audited"
        eligible = qa_summary[
            qa_summary[audit_column].ge(
                int(config.finance_qa_min_attribute_audits)
            )
            & qa_summary[column].notna()
        ]
        if not eligible.empty:
            top = eligible.sort_values(column, ascending=False).iloc[0]
            insights.append(
                (
                    f"Among Finance {outcome} ratings with sufficient audits, "
                    f"{top['QA Attribute']} has the highest failure rate at "
                    f"{format_rate(top[column])}."
                )
            )

    combined_topics: List[pd.DataFrame] = []
    for topic_table in [level_two_summary, level_one_summary]:
        if topic_table is None or topic_table.empty:
            continue
        eligible = topic_table[
            topic_table["Rated"].ge(
                int(config.finance_qa_topic_min_responses)
            )
        ].copy()
        if not eligible.empty:
            combined_topics.append(eligible)

    if combined_topics:
        topics = pd.concat(
            combined_topics,
            ignore_index=True,
            sort=False,
        ).drop_duplicates(["Topic Level", "Topic"])
        priority = topics.sort_values(
            ["Unhappy", "Unhappy Rate", "Rated"],
            ascending=[False, False, False],
        ).iloc[0]
        insights.append(
            (
                f"The largest eligible Finance non-smiley contributor is "
                f"{priority['Topic']} ({priority['Topic Level']}) with "
                f"{int(priority['Unhappy']):,} Neutral/Frownie ratings across "
                f"{int(priority['Rated']):,} rated responses."
            )
        )

    return insights



def build_finance_qa_grain_analyses(
    filtered_df: pd.DataFrame,
    grain_results: Mapping[str, GrainResult],
    config: AppConfig = CONFIG,
) -> Dict[str, FinanceQAGrainAnalysis]:
    """
    Build Finance-versus-Other QA analysis for Daily, Weekly, and Monthly only.

    Grain membership uses Created Date in UTC. No YTD population is created.
    """
    analyses: Dict[str, FinanceQAGrainAnalysis] = {}
    classified = _prepare_finance_qa_source_utc(
        filtered_df,
        config,
    )
    unexpected_ratings = sorted(
        {
            normalize_text(value)
            for value in classified.loc[
                classified["Smiley Outcome"].eq("")
                & classified["Smiley Rating"].map(normalize_text).ne(""),
                "Smiley Rating",
            ].tolist()
            if normalize_text(value)
        }
    )

    for grain in ["DAILY", "WEEKLY", "MONTHLY"]:
        result = grain_results.get(grain)
        if result is None:
            continue

        metric = result.overall
        period_start = pd.Timestamp(metric.period_start).normalize()
        period_end = min(
            pd.Timestamp(metric.period_end).normalize(),
            pd.Timestamp(metric.data_through).normalize(),
        )

        period_df = classified[
            classified["Created Date"].between(
                period_start,
                period_end,
                inclusive="both",
            )
        ].copy()

        baseline_start_v527 = _finance_rolling_window_start_v527(
            grain,
            period_start,
        )
        baseline_df_v527 = classified[
            classified["Created Date"].between(
                baseline_start_v527,
                period_end,
                inclusive="both",
            )
        ].copy()

        population_summary = _finance_population_summary(period_df)
        qa_summary = _finance_qa_attribute_summary(period_df, config)
        level_one_summary = _finance_topic_summary(
            period_df,
            "Level One",
            config,
            baseline_work=baseline_df_v527,
            grain=grain,
        )
        level_two_summary = _finance_topic_summary(
            period_df,
            "Level Two",
            config,
            baseline_work=baseline_df_v527,
            grain=grain,
        )

        validation_notes = [
            (
                "Created Date grain assignment uses UTC calendar dates from "
                f"{period_start.strftime('%Y-%m-%d')} through "
                f"{period_end.strftime('%Y-%m-%d')}."
            ),
            (
                "Finance is determined from Level One OR Level Two using the "
                "configured exact values and keywords."
            ),
            (
                "Untagged/misc rows are kept separate from Other."
            ),
        ]
        if unexpected_ratings:
            validation_notes.append(
                "Unexpected Smiley Rating values excluded: "
                + ", ".join(unexpected_ratings)
            )

        analyses[grain] = FinanceQAGrainAnalysis(
            grain=grain,
            period_label=metric.period_label,
            period_start=period_start,
            period_end=period_end,
            population_summary=population_summary,
            qa_attribute_summary=qa_summary,
            level_one_summary=level_one_summary,
            level_two_summary=level_two_summary,
            insights=_finance_qa_insights(
                grain=grain,
                period_label=metric.period_label,
                population_summary=population_summary,
                qa_summary=qa_summary,
                level_one_summary=level_one_summary,
                level_two_summary=level_two_summary,
                config=config,
            ),
            validation_notes=validation_notes,
        )

    return analyses



def _prepare_finance_qa_source_utc(
    source_df: pd.DataFrame,
    config: AppConfig = CONFIG,
) -> pd.DataFrame:
    """
    Prepare the deterministic Finance source while preserving UTC timestamps.

    The normalized source should already contain ``_Created Date UTC``. A
    defensive fallback reparses ``Created Date`` only when the preserved
    timestamp is unavailable.
    """
    source = source_df.copy()

    if "_Created Date UTC" in source.columns:
        preserved_utc = pd.to_datetime(
            source["_Created Date UTC"],
            errors="coerce",
            utc=True,
        )
    else:
        preserved_utc = pd.Series(
            pd.NaT,
            index=source.index,
            dtype="datetime64[ns, UTC]",
        )

    if "Created Date" not in source.columns:
        source["Created Date"] = pd.NaT

    fallback_utc = pd.to_datetime(
        source["Created Date"],
        errors="coerce",
        utc=True,
    )
    created_utc = preserved_utc.where(
        preserved_utc.notna(),
        fallback_utc,
    )

    source["_Created Date UTC"] = created_utc
    source["Created Date"] = (
        created_utc
        .dt.tz_convert("UTC")
        .dt.tz_localize(None)
        .dt.normalize()
    )
    return classify_finance_population(source, config)

def _finance_metric_period_subset(
    classified: pd.DataFrame,
    metric: MetricResult,
) -> pd.DataFrame:
    """Return rows inside one reporting-grain period using UTC calendar dates."""
    period_start = pd.Timestamp(metric.period_start).normalize()
    period_end = min(
        pd.Timestamp(metric.period_end).normalize(),
        pd.Timestamp(metric.data_through).normalize(),
    )
    return classified[
        classified["Created Date"].between(
            period_start,
            period_end,
            inclusive="both",
        )
    ].copy()


def _two_proportion_p_value(
    successes_a: int,
    total_a: int,
    successes_b: int,
    total_b: int,
) -> float:
    """Two-sided pooled two-proportion z-test p-value without SciPy."""
    if total_a <= 0 or total_b <= 0:
        return np.nan

    pooled = (successes_a + successes_b) / (total_a + total_b)
    variance = pooled * (1.0 - pooled) * (
        (1.0 / total_a) + (1.0 / total_b)
    )
    if variance <= 0:
        return 1.0

    rate_a = successes_a / total_a
    rate_b = successes_b / total_b
    z_score = (rate_a - rate_b) / math.sqrt(variance)
    return float(math.erfc(abs(z_score) / math.sqrt(2.0)))


def _finance_squad_summary(
    period_df: pd.DataFrame,
    scope_name: str,
    grain: str,
    config: AppConfig = CONFIG,
) -> pd.DataFrame:
    """
    Compare Finance unhappy rates by Squad Code for one scope and grain.

    Better/Worse requires:
      - at least finance_qa_squad_comparison_n rated rows in the squad;
      - at least that many rated rows in the remaining Finance population;
      - an absolute practical difference of at least the configured pp gap;
      - a two-sided pooled proportion p-value below alpha.
    """
    columns = [
        "Scope",
        "Grain",
        "Squad Code",
        "Rated",
        "Smiley",
        "Neutral",
        "Frownie",
        "Unhappy",
        "Smiley Rate",
        "Unhappy Rate",
        "Scope Finance Average",
        "Gap vs Finance Average (pp)",
        "P Value vs Remaining Finance",
        "Assessment",
        "Sample Status",
    ]

    if period_df.empty or "Squad Code" not in period_df.columns:
        return pd.DataFrame(columns=columns)

    finance = period_df[
        period_df["Finance Classification"].eq("Finance")
        & period_df["Smiley Outcome"].isin(
            ["Smiley", "Neutral", "Frownie"]
        )
    ].copy()
    finance["Squad Code"] = finance["Squad Code"].map(normalize_text)
    finance = finance[finance["Squad Code"].ne("")].copy()
    if finance.empty:
        return pd.DataFrame(columns=columns)

    total_rated = int(len(finance))
    total_unhappy = int(
        finance["Smiley Outcome"].isin(["Neutral", "Frownie"]).sum()
    )
    scope_average = safe_rate(total_unhappy, total_rated)

    rows: List[Dict[str, Any]] = []
    for squad, group in finance.groupby("Squad Code", dropna=False):
        rated = int(len(group))
        smiley = int(group["Smiley Outcome"].eq("Smiley").sum())
        neutral = int(group["Smiley Outcome"].eq("Neutral").sum())
        frownie = int(group["Smiley Outcome"].eq("Frownie").sum())
        unhappy = neutral + frownie
        unhappy_rate = safe_rate(unhappy, rated)
        gap_pp = (
            (unhappy_rate - scope_average) * 100
            if pd.notna(unhappy_rate) and pd.notna(scope_average)
            else np.nan
        )

        remaining_rated = total_rated - rated
        remaining_unhappy = total_unhappy - unhappy
        p_value = _two_proportion_p_value(
            unhappy,
            rated,
            remaining_unhappy,
            remaining_rated,
        )

        if rated < int(config.finance_qa_squad_small_sample_n):
            sample_status = "Small sample"
            assessment = "Small sample"
        elif rated < int(config.finance_qa_squad_comparison_n):
            sample_status = "Directional"
            assessment = "Directional"
        else:
            sample_status = "Eligible"
            practical = (
                pd.notna(gap_pp)
                and abs(float(gap_pp))
                >= float(config.finance_qa_squad_practical_gap_pp)
            )
            statistically_supported = (
                remaining_rated
                >= int(config.finance_qa_squad_comparison_n)
                and pd.notna(p_value)
                and float(p_value)
                < float(config.finance_qa_squad_significance_alpha)
            )
            if practical and statistically_supported:
                assessment = (
                    "Worse than average"
                    if float(gap_pp) > 0
                    else "Better than average"
                )
            else:
                assessment = "No clear difference"

        rows.append(
            {
                "Scope": scope_name,
                "Grain": grain,
                "Squad Code": normalize_text(squad),
                "Rated": rated,
                "Smiley": smiley,
                "Neutral": neutral,
                "Frownie": frownie,
                "Unhappy": unhappy,
                "Smiley Rate": safe_rate(smiley, rated),
                "Unhappy Rate": unhappy_rate,
                "Scope Finance Average": scope_average,
                "Gap vs Finance Average (pp)": gap_pp,
                "P Value vs Remaining Finance": p_value,
                "Assessment": assessment,
                "Sample Status": sample_status,
            }
        )

    return (
        pd.DataFrame(rows, columns=columns)
        .sort_values(
            ["Unhappy Rate", "Rated"],
            ascending=[False, False],
        )
        .reset_index(drop=True)
    )


def _finance_outcome_summary_row(
    group: pd.DataFrame,
) -> Dict[str, Any]:
    """Return standard volume and outcome metrics for a Finance group."""
    rated = int(len(group))
    smiley = int(group["Smiley Outcome"].eq("Smiley").sum())
    neutral = int(group["Smiley Outcome"].eq("Neutral").sum())
    frownie = int(group["Smiley Outcome"].eq("Frownie").sum())
    unhappy = neutral + frownie
    return {
        "Rated": rated,
        "Smiley": smiley,
        "Neutral": neutral,
        "Frownie": frownie,
        "Unhappy": unhappy,
        "Smiley Rate": safe_rate(smiley, rated),
        "Unhappy Rate": safe_rate(unhappy, rated),
    }


def _population_comparison_metrics(
    group: pd.DataFrame,
) -> Dict[str, Any]:
    """
    Return All/Finance/Other outcome metrics for one population slice.

    All includes Finance, Other, and Untagged rated rows. Finance and Other are
    shown separately; Untagged is also counted for audit transparency.
    """
    rated = group[
        group["Smiley Outcome"].isin(["Smiley", "Neutral", "Frownie"])
    ].copy()

    def metrics_for(frame: pd.DataFrame, prefix: str) -> Dict[str, Any]:
        values = _finance_outcome_summary_row(frame)
        return {
            f"{prefix} Rated": values["Rated"],
            f"{prefix} Smiley": values["Smiley"],
            f"{prefix} Neutral": values["Neutral"],
            f"{prefix} Frownie": values["Frownie"],
            f"{prefix} Unhappy": values["Unhappy"],
            f"{prefix} Smiley Rate": values["Smiley Rate"],
            f"{prefix} Unhappy Rate": values["Unhappy Rate"],
        }

    output: Dict[str, Any] = {}
    output.update(metrics_for(rated, "All"))
    output.update(
        metrics_for(
            rated[rated["Finance Classification"].eq("Finance")],
            "Finance",
        )
    )
    output.update(
        metrics_for(
            rated[rated["Finance Classification"].eq("Other")],
            "Other",
        )
    )
    output.update(
        metrics_for(
            rated[rated["Finance Classification"].eq("Untagged")],
            "Untagged",
        )
    )

    finance_rate = output["Finance Unhappy Rate"]
    other_rate = output["Other Unhappy Rate"]
    output["Finance vs Other Unhappy Gap (pp)"] = (
        (finance_rate - other_rate) * 100
        if pd.notna(finance_rate) and pd.notna(other_rate)
        else np.nan
    )
    return output


def _finance_monthly_trend(
    classified: pd.DataFrame,
    report_scope: Mapping[str, Any],
    config: AppConfig = CONFIG,
) -> pd.DataFrame:
    """
    Build an All/Finance/Other rolling monthly trend.

    The selected anchor month plus the previous configured months is shown.
    This is not a year-to-date analysis.
    """
    reference_month_start = pd.Timestamp(
        report_scope["reference_month_start"]
    ).normalize().replace(day=1)
    month_count = max(1, int(config.finance_qa_monthly_trend_months))
    first_month = reference_month_start - pd.DateOffset(
        months=month_count - 1
    )
    month_starts = pd.date_range(
        first_month,
        reference_month_start,
        freq="MS",
    )

    cutoff = pd.Timestamp(
        report_scope.get(
            "monthly_data_through",
            report_scope.get("data_through", reference_month_start),
        )
    ).normalize()

    rows: List[Dict[str, Any]] = []
    previous_all_rate = np.nan
    for month_value in month_starts:
        month_value = pd.Timestamp(month_value).normalize()
        full_month_end = month_end(month_value)
        effective_end = (
            min(full_month_end, cutoff)
            if month_value == reference_month_start
            else full_month_end
        )
        if effective_end < month_value:
            group = classified.iloc[0:0].copy()
        else:
            group = classified[
                classified["Created Date"].between(
                    month_value,
                    effective_end,
                    inclusive="both",
                )
            ].copy()

        metrics = _population_comparison_metrics(group)
        all_rate = metrics["All Unhappy Rate"]
        metrics.update(
            {
                "Month": month_value.strftime("%b %Y")
                + (
                    " (partial)"
                    if (
                        month_value == reference_month_start
                        and effective_end < full_month_end
                    )
                    else ""
                ),
                "Month Start": month_value,
                "Month End": effective_end,
                "All MoM Unhappy Change (pp)": (
                    (all_rate - previous_all_rate) * 100
                    if pd.notna(all_rate)
                    and pd.notna(previous_all_rate)
                    else np.nan
                ),
            }
        )
        rows.append(metrics)
        previous_all_rate = all_rate

    return pd.DataFrame(rows)

def _selected_reporting_month_finance(
    classified: pd.DataFrame,
    report_scope: Mapping[str, Any],
) -> pd.DataFrame:
    """
    Return the full rated population for the selected pattern window.

    The legacy function name is retained for compatibility. In v5.3.0 the
    returned data includes All rated rows so timing patterns are no longer
    Finance-only.
    """
    pattern_start = pd.Timestamp(
        report_scope.get(
            "pattern_start",
            report_scope["reference_month_start"],
        )
    ).normalize()
    pattern_end = pd.Timestamp(
        report_scope.get(
            "pattern_end",
            report_scope.get("data_through", pattern_start),
        )
    ).normalize()

    return classified[
        classified["Created Date"].between(
            pattern_start,
            pattern_end,
            inclusive="both",
        )
        & classified["Smiley Outcome"].isin(
            ["Smiley", "Neutral", "Frownie"]
        )
    ].copy()

def _finance_segment_summary(
    population: pd.DataFrame,
    segment_column: str,
    segment_order: Sequence[Any],
    segment_label: str,
) -> pd.DataFrame:
    """
    Summarize All/Finance/Other volume and unhappy rates by segment.

    The legacy function name is retained because existing report builders call
    it, but the output is no longer Finance-only.
    """
    rows: List[Dict[str, Any]] = []
    for segment in segment_order:
        group = population[population[segment_column].eq(segment)].copy()
        metrics = _population_comparison_metrics(group)
        metrics[segment_label] = segment
        rows.append(metrics)
    return pd.DataFrame(rows)

def _finance_time_of_day_summary(
    population: pd.DataFrame,
    config: AppConfig = CONFIG,
) -> pd.DataFrame:
    """Build All/Finance/Other performance for three fixed UTC time blocks."""
    work = population.copy()
    if "_Created Date UTC" not in work.columns:
        work["_Created Date UTC"] = pd.NaT

    full_timestamp = pd.to_datetime(
        work["_Created Date UTC"],
        errors="coerce",
        utc=True,
    )
    work["_Created Date UTC"] = full_timestamp
    hours = full_timestamp.dt.hour

    labels = pd.Series("", index=work.index, dtype="object")
    for start_hour, end_hour, label in config.finance_qa_time_buckets_utc:
        labels.loc[hours.between(start_hour, end_hour)] = label
    work["UTC Time Block"] = labels

    ordered_labels = [
        label
        for _, _, label in config.finance_qa_time_buckets_utc
    ]
    return _finance_segment_summary(
        work,
        "UTC Time Block",
        ordered_labels,
        "UTC Time Block",
    )

def _finance_day_of_week_summary(
    population: pd.DataFrame,
) -> pd.DataFrame:
    """Build All/Finance/Other Monday-Sunday performance in UTC."""
    work = population.copy()
    if "_Created Date UTC" not in work.columns:
        work["_Created Date UTC"] = pd.NaT
    full_timestamp = pd.to_datetime(
        work["_Created Date UTC"],
        errors="coerce",
        utc=True,
    )
    work["UTC Day of Week"] = full_timestamp.dt.day_name()
    order = [
        "Monday",
        "Tuesday",
        "Wednesday",
        "Thursday",
        "Friday",
        "Saturday",
        "Sunday",
    ]
    return _finance_segment_summary(
        work,
        "UTC Day of Week",
        order,
        "UTC Day of Week",
    )

def _finance_day_of_month_summaries(
    population: pd.DataFrame,
) -> Tuple[pd.DataFrame, pd.DataFrame]:
    """
    Return All/Finance/Other executive and detailed UTC day-of-month tables.
    """
    work = population.copy()
    if "_Created Date UTC" not in work.columns:
        work["_Created Date UTC"] = pd.NaT
    full_timestamp = pd.to_datetime(
        work["_Created Date UTC"],
        errors="coerce",
        utc=True,
    )
    day_values = full_timestamp.dt.day
    work["UTC Day of Month"] = day_values

    part_labels = pd.Series("", index=work.index, dtype="object")
    part_labels.loc[day_values.between(1, 10)] = "Early (1-10)"
    part_labels.loc[day_values.between(11, 20)] = "Middle (11-20)"
    part_labels.loc[day_values.between(21, 31)] = "Late (21-31)"
    work["Part of Month"] = part_labels

    executive = _finance_segment_summary(
        work,
        "Part of Month",
        ["Early (1-10)", "Middle (11-20)", "Late (21-31)"],
        "Part of Month",
    )
    detail = _finance_segment_summary(
        work,
        "UTC Day of Month",
        list(range(1, 32)),
        "UTC Day of Month",
    )
    return executive, detail

