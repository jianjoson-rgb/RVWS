def build_finance_qa_scope_analyses(
    filtered_df: pd.DataFrame,
    grain_results: Mapping[str, GrainResult],
    report_scope: Mapping[str, Any],
    config: AppConfig = CONFIG,
) -> Dict[str, FinanceQAScopeAnalysis]:
    """Add previous-period statuses to Overall and approved-site scope tables."""
    output = _v532_build_finance_qa_scope_analyses(
        filtered_df=filtered_df,
        grain_results=grain_results,
        report_scope=report_scope,
        config=config,
    )

    scope_sources: Dict[str, pd.DataFrame] = {}
    if config.finance_qa_include_overall_scope:
        scope_sources["OVERALL"] = filtered_df.copy()

    if config.finance_qa_include_approved_site_scopes:
        normalized_sites = (
            filtered_df["Site"].map(normalize_text).str.upper()
            if "Site" in filtered_df.columns
            else pd.Series("", index=filtered_df.index)
        )
        for site in config.site_detail_sites:
            site_code = normalize_text(site).upper()
            scope_sources[site_code] = filtered_df[
                normalized_sites.eq(site_code)
            ].copy()

    (
        previous_pattern_start,
        previous_pattern_end,
        previous_pattern_label,
    ) = _pattern_comparison_window(report_scope)

    current_pattern_start = pd.Timestamp(
        report_scope["pattern_start"]
    ).normalize()
    current_pattern_end = pd.Timestamp(
        report_scope["pattern_end"]
    ).normalize()

    for scope_key, scope_analysis in output.items():
        source_df = scope_sources.get(scope_key)
        if source_df is None:
            continue

        classified = _prepare_finance_qa_source_utc(
            source_df,
            config,
        )
        current_pattern = classified[
            classified["Created Date"].between(
                current_pattern_start,
                current_pattern_end,
                inclusive="both",
            )
        ].copy()
        previous_pattern = classified[
            classified["Created Date"].between(
                previous_pattern_start,
                previous_pattern_end,
                inclusive="both",
            )
        ].copy()

        # Recompute the timing tables and attach explicit prior metrics/status.
        current_time = _finance_time_of_day_summary(
            current_pattern,
            config,
        )
        previous_time = _finance_time_of_day_summary(
            previous_pattern,
            config,
        )
        scope_analysis.time_of_day_summary = _merge_segment_previous(
            current_time,
            previous_time,
            "UTC Time Block",
            config,
        )

        current_dow = _finance_day_of_week_summary(
            current_pattern
        )
        previous_dow = _finance_day_of_week_summary(
            previous_pattern
        )
        scope_analysis.day_of_week_summary = _merge_segment_previous(
            current_dow,
            previous_dow,
            "UTC Day of Week",
            config,
        )

        current_dom, current_dom_detail = (
            _finance_day_of_month_summaries(
                current_pattern
            )
        )
        previous_dom, previous_dom_detail = (
            _finance_day_of_month_summaries(
                previous_pattern
            )
        )
        scope_analysis.day_of_month_summary = _merge_segment_previous(
            current_dom,
            previous_dom,
            "Part of Month",
            config,
        )
        scope_analysis.day_of_month_detail = _merge_segment_previous(
            current_dom_detail,
            previous_dom_detail,
            "UTC Day of Month",
            config,
        )
        scope_analysis.monthly_trend = _enrich_monthly_trend_status(
            scope_analysis.monthly_trend,
            config,
        )

        # ----------------------------------------------------------
        # v5.6.5 TABLE-ONLY AUTHORITATIVE METRICS
        # ----------------------------------------------------------
        # Do not alter existing analysis/narrative columns. Attach parallel
        # Table * fields calculated with the same numerator/denominator as the
        # main trend chart: SUM(Smiley Numerator) / SUM(Responses).
        monthly_table_metrics = _authoritative_monthly_display_metrics_v566(
            classified,
            scope_analysis.monthly_trend,
        )
        scope_analysis.monthly_trend = (
            _attach_monthly_table_metrics_v565(
                scope_analysis.monthly_trend,
                monthly_table_metrics,
            )
        )

        # TABLE-ONLY population uses reporting Date, matching the trend chart.
        # Created Date UTC is retained only for timing-segment assignment.
        table_current_pattern = _table_report_date_subset_v566(
            classified,
            current_pattern_start,
            current_pattern_end,
        )

        current_time_for_table = table_current_pattern.copy()
        if "_Created Date UTC" not in current_time_for_table.columns:
            current_time_for_table["_Created Date UTC"] = pd.NaT
        _table_timestamp = pd.to_datetime(
            current_time_for_table["_Created Date UTC"],
            errors="coerce",
            utc=True,
        )
        _table_hours = _table_timestamp.dt.hour
        _table_time_labels = pd.Series(
            "",
            index=current_time_for_table.index,
            dtype="object",
        )
        for (
            _table_start_hour,
            _table_end_hour,
            _table_label,
        ) in config.finance_qa_time_buckets_utc:
            _table_time_labels.loc[
                _table_hours.between(
                    _table_start_hour,
                    _table_end_hour,
                )
            ] = _table_label
        current_time_for_table[
            "UTC Time Block"
        ] = _table_time_labels

        time_table_metrics = _authoritative_segment_table_metrics_v565(
            current_time_for_table,
            "UTC Time Block",
            [
                label
                for _, _, label
                in config.finance_qa_time_buckets_utc
            ],
        )
        scope_analysis.time_of_day_summary = (
            _attach_table_metrics_v565(
                scope_analysis.time_of_day_summary,
                time_table_metrics,
                "UTC Time Block",
            )
        )

        current_dow_for_table = table_current_pattern.copy()
        if "_Created Date UTC" not in current_dow_for_table.columns:
            current_dow_for_table["_Created Date UTC"] = pd.NaT
        _dow_timestamp = pd.to_datetime(
            current_dow_for_table["_Created Date UTC"],
            errors="coerce",
            utc=True,
        )
        current_dow_for_table[
            "UTC Day of Week"
        ] = _dow_timestamp.dt.day_name()
        _dow_order = [
            "Monday",
            "Tuesday",
            "Wednesday",
            "Thursday",
            "Friday",
            "Saturday",
            "Sunday",
        ]
        dow_table_metrics = _authoritative_segment_table_metrics_v565(
            current_dow_for_table,
            "UTC Day of Week",
            _dow_order,
        )
        scope_analysis.day_of_week_summary = (
            _attach_table_metrics_v565(
                scope_analysis.day_of_week_summary,
                dow_table_metrics,
                "UTC Day of Week",
            )
        )

        current_dom_for_table = table_current_pattern.copy()
        if "_Created Date UTC" not in current_dom_for_table.columns:
            current_dom_for_table["_Created Date UTC"] = pd.NaT
        _dom_timestamp = pd.to_datetime(
            current_dom_for_table["_Created Date UTC"],
            errors="coerce",
            utc=True,
        )
        _dom_day = _dom_timestamp.dt.day
        _dom_part = pd.Series(
            "",
            index=current_dom_for_table.index,
            dtype="object",
        )
        _dom_part.loc[
            _dom_day.between(1, 10)
        ] = "Early (1-10)"
        _dom_part.loc[
            _dom_day.between(11, 20)
        ] = "Middle (11-20)"
        _dom_part.loc[
            _dom_day.between(21, 31)
        ] = "Late (21-31)"
        current_dom_for_table[
            "Part of Month"
        ] = _dom_part

        dom_table_metrics = _authoritative_segment_table_metrics_v565(
            current_dom_for_table,
            "Part of Month",
            [
                "Early (1-10)",
                "Middle (11-20)",
                "Late (21-31)",
            ],
        )
        scope_analysis.day_of_month_summary = (
            _attach_table_metrics_v565(
                scope_analysis.day_of_month_summary,
                dom_table_metrics,
                "Part of Month",
            )
        )
        scope_analysis.comparison_label = (
            previous_pattern_label
        )
        scope_analysis.previous_pattern_start = (
            previous_pattern_start
        )
        scope_analysis.previous_pattern_end = (
            previous_pattern_end
        )
        scope_analysis.current_pattern_start = current_pattern_start
        scope_analysis.current_pattern_end = current_pattern_end
        scope_analysis.current_pattern_label = normalize_text(
            report_scope.get("pattern_label", "")
        )
        scope_analysis.pattern_period_type = normalize_text(
            report_scope.get("period_type", "")
        ).upper()
        scope_analysis.selected_report_label = normalize_text(
            report_scope.get("report_label", "")
        )

        # Enrich Finance squad results for every grain.
        for grain, analysis in scope_analysis.grain_analyses.items():
            result = grain_results.get(grain)
            if result is None:
                continue

            current_period = _finance_metric_period_subset(
                classified,
                result.overall,
            )
            previous_period = classified[
                classified["Created Date"].between(
                    result.overall.previous_period_start,
                    result.overall.previous_period_end,
                    inclusive="both",
                )
            ].copy()
            previous_squad = _finance_squad_summary(
                period_df=previous_period,
                scope_name=scope_analysis.scope_name,
                grain=grain,
                config=config,
            )
            analysis.squad_summary = _enrich_squad_previous(
                analysis.squad_summary,
                previous_squad,
                config,
            )

        scope_analysis.validation_notes.append(
            "Previous-timeframe timing comparison: "
            f"{previous_pattern_label} "
            f"({previous_pattern_start.strftime('%m/%d/%Y')}–"
            f"{previous_pattern_end.strftime('%m/%d/%Y')})."
        )

    return output







