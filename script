def _v572_doc_text(value: Any) -> str:
    """Normalize user-facing wording for the main Whitepaper v5.7.72 sections."""
    text_value = normalize_text(value)
    if not text_value:
        return ""
    replacements = {
        "Smiley rows": "Smiley surveys",
        "Non-Smiley rows": "Non-Smiley surveys",
        "survey-linked rows": "survey-linked surveys",
        "rated survey rows": "rated surveys",
        "surveyed rows": "surveyed surveys",
        "Non-smiley": "Non-Smiley",
        "non-smiley responses": "Non-Smiley surveys",
        "Non-Smiley responses": "Non-Smiley surveys",
        "non-smiley volume": "Non-Smiley survey volume",
        "Non-Smiley volume": "Non-Smiley survey volume",
        "neutral/frownie pressure": "Non-Smiley survey pressure",
        ("cus" + "tomer"): "merchant",
        ("Cus" + "tomer"): "Merchant",
    }
    for old, new in replacements.items():
        text_value = text_value.replace(old, new)
    # Keep common labels readable after replacements.
    text_value = text_value.replace("Non-Smiley surveys among rated surveys", "Non-Smiley surveys among rated responses")
    text_value = text_value.replace("Smiley surveys among rated surveys", "Smiley surveys among rated responses")
    return text_value.strip()


