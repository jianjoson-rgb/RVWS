def _top_positive_squad_names(
    result: GrainResult,
    site: str,
    limit: int = 3,
) -> List[str]:
    if result.squad_summary.empty:
        return []
    subset = result.squad_summary[result.squad_summary["Site"].eq(site)]
    top = top_squads(subset, "positive", limit, minimum_responses=1)
    return top["Squad Code"].astype(str).tolist() if not top.empty else []


def build_high_performer_narratives_with_squads(
    grain_results: Mapping[str, GrainResult],
    monthly_anchor: Optional[pd.Series],
) -> List[str]:
    lines: List[str] = []
    for grain, title in [("DAILY", "Daily Winner"), ("WEEKLY", "Weekly Winner")]:
        result = grain_results.get(grain)
        if result is None:
            continue
        winner = identify_grain_winner(result)
        if winner is None:
            continue
        squads = _top_positive_squad_names(
            result,
            normalize_text(winner["Site"]),
            limit=3,
        )
        squad_text = (
            f" Top squads: {', '.join(squads)}."
            if squads
            else ""
        )
        lines.append(
            f"{title}: {winner['Site']} "
            f"({format_pp(winner['Official Impact'])} impact, "
            f"{format_rate(winner['Smiley Rate'])}, "
            f"{format_int(winner['Responses'])} responses)."
            f"{squad_text}"
        )

    if monthly_anchor is not None:
        monthly_result = grain_results.get("MONTHLY")
        squads = (
            _top_positive_squad_names(
                monthly_result,
                normalize_text(monthly_anchor["Site"]),
                limit=3,
            )
            if monthly_result is not None
            else []
        )
        squad_text = (
            f" Top squads: {', '.join(squads)}."
            if squads
            else ""
        )
        lines.append(
            f"Monthly Anchor: {monthly_anchor['Site']} maintained "
            f"{format_rate(monthly_anchor['Smiley Rate'])} across "
            f"{format_int(monthly_anchor['Responses'])} responses "
            f"({monthly_anchor['Response Share']:.1%} of monthly volume)."
            f"{squad_text}"
        )
    return lines


