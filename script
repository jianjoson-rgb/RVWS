def _pattern_comparison_window(
    report_scope: Mapping[str, Any],
) -> Tuple[pd.Timestamp, pd.Timestamp, str]:
    """Return previous equivalent pattern window for month/week/day selections."""
    period_type = normalize_text(
        report_scope.get("period_type", "MONTH")
    ).upper()
    current_start = pd.Timestamp(
        report_scope["pattern_start"]
    ).normalize()
    current_end = pd.Timestamp(
        report_scope["pattern_end"]
    ).normalize()

    if period_type == "DAY":
        previous_start = current_start - pd.Timedelta(days=1)
        previous_end = previous_start
        label = previous_start.strftime("%m/%d/%Y")
        return previous_start, previous_end, label

    if period_type == "WEEK":
        previous_start = current_start - pd.Timedelta(days=7)
        elapsed_days = max(0, (current_end - current_start).days)
        previous_end = previous_start + pd.Timedelta(
            days=min(elapsed_days, 6)
        )
        label = (
            f"{week_beginning_chart_label(previous_start)} "
            f"({previous_start.strftime('%m/%d/%Y')}–"
            f"{previous_end.strftime('%m/%d/%Y')})"
        )
        return previous_start, previous_end, label

    previous_start = month_start(current_start) - pd.DateOffset(
        months=1
    )
    if current_end >= month_end(current_start):
        previous_end = month_end(previous_start)
    else:
        elapsed_days = max(0, (current_end - current_start).days)
        previous_end = min(
            month_end(previous_start),
            previous_start + pd.Timedelta(days=elapsed_days),
        )
    label = (
        previous_start.strftime("%b %Y")
        if previous_end == month_end(previous_start)
        else (
            f"{previous_start.strftime('%b %d')}–"
            f"{previous_end.strftime('%b %d, %Y')}"
        )
    )
    return previous_start, previous_end, label


def _merge_segment_previous(
    current: pd.DataFrame,
    previous: pd.DataFrame,
    label_column: str,
    config: AppConfig = CONFIG,
) -> pd.DataFrame:
    if current is None or current.empty:
        return current

    previous_columns = [label_column]
    for prefix in ["All", "Finance", "Other"]:
        previous_columns.extend(
            [
                f"{prefix} Rated",
                f"{prefix} Unhappy Rate",
            ]
        )

    previous_keep = previous[previous_columns].copy()
    rename_map: Dict[str, str] = {}
    for prefix in ["All", "Finance", "Other"]:
        rename_map[f"{prefix} Rated"] = (
            f"Previous {prefix} Rated"
        )
        rename_map[f"{prefix} Unhappy Rate"] = (
            f"Previous {prefix} Unhappy Rate"
        )
    previous_keep = previous_keep.rename(columns=rename_map)

    output = current.merge(
        previous_keep,
        on=label_column,
        how="left",
    )

    for prefix in ["All", "Finance", "Other"]:
        output[f"{prefix} Unhappy Delta vs Previous (pp)"] = (
            output[f"{prefix} Unhappy Rate"]
            - output[f"Previous {prefix} Unhappy Rate"]
        ) * 100
        output[f"{prefix} Trend Status"] = output.apply(
            lambda row, metric_prefix=prefix: comparison_status(
                row.get(f"{metric_prefix} Unhappy Rate"),
                row.get(
                    f"Previous {metric_prefix} Unhappy Rate"
                ),
                higher_is_better=False,
                config=config,
            ),
            axis=1,
        )

        volume_values = output.apply(
            lambda row, metric_prefix=prefix: volume_change_metrics(
                row.get(f"{metric_prefix} Rated"),
                row.get(f"Previous {metric_prefix} Rated"),
                config,
            ),
            axis=1,
        )
        output[f"{prefix} Volume Change %"] = [
            value[0] for value in volume_values
        ]
        output[f"{prefix} Volume Status"] = [
            value[1] for value in volume_values
        ]

    return output


