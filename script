def _email_trend_short_label_v552(
    label: Any,
    section_key: str,
) -> str:
    value = normalize_text(label)
    if section_key == "TIME":
        return (
            value.replace("UTC ", "")
            .replace(":00", "")
            .replace("-07:59", "–08")
            .replace("-15:59", "–16")
            .replace("-23:59", "–24")
        )
    if section_key == "DOW":
        return value[:3]
    if section_key == "DOM":
        return (
            value.replace("Early ", "Early\n")
            .replace("Middle ", "Middle\n")
            .replace("Late ", "Late\n")
        )
    return value


def _email_trend_y_limits_v552(
    current_values: Sequence[float],
    previous_values: Sequence[float],
) -> Tuple[float, float]:
    values = [
        float(value)
        for value in [*current_values, *previous_values]
        if pd.notna(value)
    ]
    if not values:
        return 0.0, 100.0
    minimum = max(0.0, min(values) - 7.0)
    maximum = min(100.0, max(values) + 7.0)
    if maximum - minimum < 15.0:
        midpoint = (maximum + minimum) / 2
        minimum = max(0.0, midpoint - 7.5)
        maximum = min(100.0, midpoint + 7.5)
    return minimum, maximum


def _email_trend_segment_colors_v552(
    comparisons: pd.DataFrame,
) -> List[str]:
    color_map = {
        "Improving": "#2E7D32",
        "Regressing": "#C62828",
        "Stable": "#7A7A7A",
        "Insufficient comparable data": "#B7791F",
    }
    return [
        color_map.get(normalize_text(status), "#7A7A7A")
        for status in comparisons.get(
            "Status",
            pd.Series(dtype="object"),
        ).tolist()
    ]


def _email_matplotlib_color_v554(
    color_value: Any,
    fallback: str = "#6B7280",
) -> str:
    """
    Convert a report status color to a Matplotlib-safe value.

    This helper is intentionally private to the supplemental email image
    renderer. It does not change the shared palette or any original report
    chart/image function.
    """
    value = normalize_text(color_value)
    fallback_value = normalize_text(fallback) or "#6B7280"

    if re.fullmatch(r"[0-9A-Fa-f]{6}", value):
        return f"#{value}"
    if re.fullmatch(r"#[0-9A-Fa-f]{6}", value):
        return value

    if re.fullmatch(r"[0-9A-Fa-f]{6}", fallback_value):
        fallback_value = f"#{fallback_value}"
    if not re.fullmatch(r"#[0-9A-Fa-f]{6}", fallback_value):
        fallback_value = "#6B7280"

    LOGGER.warning(
        "Invalid supplemental email chart color %r; using %s.",
        color_value,
        fallback_value,
    )
    return fallback_value


def _plot_email_timing_panel_v552(
    ax: Any,
    frame: pd.DataFrame,
    label_column: str,
    section_key: str,
    title: str,
    config: AppConfig = CONFIG,
) -> None:
