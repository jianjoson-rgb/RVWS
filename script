def _finance_topic_summary(
    work: pd.DataFrame,
    topic_column: str,
    config: AppConfig = CONFIG,
    baseline_work: Optional[pd.DataFrame] = None,
    grain: str = "",
) -> pd.DataFrame:
    """
    v5.7.57 taxonomy cleanup.

    Blank, "-", and "null" taxonomy values are excluded from both Level One and
    Level Two summaries before table/narrative generation. This keeps placeholder
    values from appearing as published topics.
    """
    topic_label = normalize_text(topic_column)
    if topic_label in {"Level One", "Level Two"}:
        work = work.copy() if work is not None else pd.DataFrame()
        if topic_label in work.columns:
            work[topic_label] = work[topic_label].map(_taxonomy_clean_value_v557)

        if baseline_work is not None and isinstance(baseline_work, pd.DataFrame):
            baseline_work = baseline_work.copy()
            if topic_label in baseline_work.columns:
                baseline_work[topic_label] = baseline_work[topic_label].map(
                    _taxonomy_clean_value_v557
                )

    output = _v556_finance_topic_summary(
        work=work,
        topic_column=topic_column,
        config=config,
        baseline_work=baseline_work,
        grain=grain,
    )

    if output is not None and not output.empty and "Topic" in output.columns:
        output = output[
            output["Topic"].map(_taxonomy_is_valid_value_v557)
        ].copy()
        output["Topic"] = output["Topic"].map(_taxonomy_clean_value_v557)
        output = output.reset_index(drop=True)

    return output


