def _docx_v571_replace_site_driver_line(
    readout: MutableMapping[str, Any],
    site_segments: Sequence[Mapping[str, Any]],
) -> MutableMapping[str, Any]:
    """Replace the cross-site Site driver line with a site-position line."""
    if not isinstance(readout, MutableMapping):
        return readout

    replacement = {"level": 0, "segments": list(site_segments)}
    for block in readout.get("blocks", []):
        if not isinstance(block, MutableMapping):
            continue
        label = normalize_text(block.get("label", "")).lower()
        if "driver readout" not in label:
            continue

        paragraphs = block.get("paragraphs", [])
        if not isinstance(paragraphs, list):
            block["paragraphs"] = [replacement]
            return readout

        for idx, paragraph_data in enumerate(paragraphs):
            if not isinstance(paragraph_data, Mapping):
                continue
            line_text = _docx_v570_segment_text(paragraph_data.get("segments", []))
            if normalize_text(line_text).lower().startswith("site:"):
                paragraphs[idx] = replacement
                return readout

        paragraphs.insert(0, replacement)
        return readout

    readout.setdefault("blocks", []).insert(
        1,
        {
            "label": "Driver Readout",
            "paragraphs": [replacement],
        },
    )
    return readout


def _docx_v571_build_site_grain_results(
    site: str,
    site_report: SiteReport,
    selection: ReportSelection,
    report_scope: Mapping[str, Any],
    grain_results: Mapping[str, GrainResult],
    config: AppConfig = CONFIG,
) -> Dict[str, GrainResult]:
    """Create site-scoped GrainResult objects for the summary matrix."""
    del selection
    site_grain_results: Dict[str, GrainResult] = {}
    site_key = normalize_text(site)

    for grain in ["DAILY", "WEEKLY", "MONTHLY"]:
        grain_key = normalize_text(grain).upper()
        metric = None
        try:
            metric = site_report.grain_metrics.get(grain_key)
        except Exception:
            metric = None
        if metric is None:
            continue

        overall_result = grain_results.get(grain_key)
        source_df = _docx_v571_site_current_period_df(
            report_scope=report_scope,
            metric=metric,
            site=site_key,
        )
        site_summary = _docx_v571_site_summary_row(
            site=site_key,
            site_metric=metric,
            overall_result=overall_result,
        )
        squad_summary = _docx_v571_site_squad_summary(
            site=site_key,
            site_report=site_report,
            grain=grain_key,
        )

        site_grain_results[grain_key] = GrainResult(
            grain=grain_key,
            overall=metric,
            current_period_df=source_df,
            site_summary=site_summary,
            squad_summary=squad_summary,
            source_impact_valid=bool(getattr(overall_result, "source_impact_valid", True)) if overall_result is not None else True,
            source_impact_message=normalize_text(getattr(overall_result, "source_impact_message", "")) if overall_result is not None else "",
            executive_reconciliation=pd.DataFrame(),
        )

    return site_grain_results


def _docx_v571_site_banner_bullets(
