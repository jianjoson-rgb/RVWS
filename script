def _email_v551_build_grain_readout(
    selection: ReportSelection,
    report_scope: Mapping[str, Any],
    grain_result: GrainResult,
    qa_summary: pd.DataFrame,
    teammate_df: pd.DataFrame,
    config: AppConfig = CONFIG,
) -> Dict[str, Any]:
    """Build the detailed email readout for one active grain."""
    metric = grain_result.overall
    grain = normalize_text(grain_result.grain).upper()
    source_df = grain_result.current_period_df.copy()
    title = {
        "DAILY": "Daily Detailed Readout",
        "WEEKLY": "Weekly Detailed Readout",
        "MONTHLY": "Monthly Detailed Readout",
    }.get(grain, f"{grain.title()} Detailed Readout")

    driver_paragraphs = [
        {"segments": _email_v551_site_segments(grain_result, metric, config=config)},
        {"segments": _email_v551_ticket_age_segments(source_df, "Overall", metric, config=config)},
        {"segments": _email_v551_taxonomy_segments(source_df, metric)},
        {"segments": _email_v551_tenure_segments(source_df, metric)},
        {"segments": _email_v551_squad_segments(grain_result, qa_summary, config=config)},
        {"segments": _email_v551_teammate_segments(teammate_df)},
        {"segments": _email_v551_qa_attribute_segments(source_df, "Overall", config=config)},
        {"segments": _email_v551_volume_mix_segments(source_df, metric)},
    ]

    projection_title = (
        "Daily Close / Recovery Requirement"
        if grain == "DAILY"
        else "Forecast / Projection"
    )

    return {
        "grain": grain,
        "title": title,
        "period_label": _email_v551_current_period_label(metric),
        "blocks": [
            {
                "label": "Current Performance",
                "paragraphs": [{"segments": _email_v551_current_performance_segments(selection, metric, config=config)}],
            },
            {
                "label": "Driver Readout",
                "paragraphs": driver_paragraphs,
            },
            {
                "label": projection_title,
                "paragraphs": [{"segments": _email_v551_projection_segments(metric, config=config)}],
            },
            {
                "label": "Recommended Action",
                "paragraphs": [{"segments": _email_v551_recommended_action_segments(grain_result, qa_summary, teammate_df, config=config)}],
            },
        ],
    }


