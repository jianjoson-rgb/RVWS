def _v528_set_table_preferred_width_pct(
    table: Any,
    width_pct: float = 100.0,
) -> None:
    """
    Set a DOCX table preferred width as a percent of the available text area.

    Google Docs import does not always honor every DOCX table property, so this
    helper is intentionally best-effort and never blocks report generation.
    """
    try:
        if table is None:
            return
        table.alignment = WD_TABLE_ALIGNMENT.CENTER
        tbl_pr = table._tbl.tblPr
        tbl_w = tbl_pr.find(qn("w:tblW"))
        if tbl_w is None:
            tbl_w = OxmlElement("w:tblW")
            tbl_pr.append(tbl_w)
        # Word stores percentage widths in fiftieths of a percent.
        tbl_w.set(qn("w:w"), str(int(float(width_pct) * 50)))
        tbl_w.set(qn("w:type"), "pct")
    except Exception as exc:
        logging.warning("Could not set DOCX table width: %s", exc)


def _v528_format_taxonomy_table_layout(table: Any) -> None:
    """
    Keep Taxonomy Level One/Two tables visually tied to their narrative callout.

    The table is centered and uses the full body width; cell margins are kept
    compact so the added rolling-delta columns remain readable.
    """
    try:
        if table is None:
            return
        _v528_set_table_preferred_width_pct(table, 100.0)
        for row in table.rows:
            for cell in row.cells:
                _set_cell_margins(cell, top=45, start=55, bottom=45, end=55)
    except Exception as exc:
        logging.warning("Could not format taxonomy table layout: %s", exc)


