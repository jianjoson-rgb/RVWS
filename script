def _ordered_scope_sites_v541(
    site_reports: Mapping[str, SiteReport],
    config: AppConfig = CONFIG,
) -> List[str]:
    """
    Return approved sites in configured business order, followed by any
    unexpected valid extras in deterministic order.
    """
    available = {
        normalize_text(site).upper(): site
        for site in site_reports
        if normalize_text(site)
    }
    ordered: List[str] = []

    for configured_site in config.site_detail_sites:
        key = normalize_text(configured_site).upper()
        if key in available:
            ordered.append(available.pop(key))

    ordered.extend(
        sorted(
            available.values(),
            key=lambda value: normalize_text(value).upper(),
        )
    )
    return ordered


def _scope_finance_analysis_v541(
    scope_analyses: Optional[
        Mapping[str, FinanceQAScopeAnalysis]
    ],
    scope_name: str,
) -> Optional[FinanceQAScopeAnalysis]:
    """Return one scope analysis using normalized case-insensitive keys."""
    if not scope_analyses:
        return None

    normalized_scope = normalize_text(scope_name).upper()
    direct = scope_analyses.get(normalized_scope)
    if direct is not None:
        return direct

    for key, analysis in scope_analyses.items():
        key_name = normalize_text(key).upper()
        analysis_name = normalize_text(
            getattr(analysis, "scope_name", "")
        ).upper()
        if normalized_scope in {key_name, analysis_name}:
            return analysis
    return None



