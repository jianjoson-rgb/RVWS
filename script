def _grain_callout_v572(
    grain_summary: pd.DataFrame,
) -> str:
    """Return one concise executive sentence for Performance by Grain."""
    if grain_summary is None or grain_summary.empty:
        return "No grain-level comparison is available for the selected period."

    work = grain_summary.copy()
    work["_delta"] = pd.to_numeric(
        work.get("Smiley Δ pp"),
        errors="coerce",
    )
    work["_signal"] = work.get(
        "Signal",
        pd.Series("", index=work.index),
    ).map(normalize_text)

    comparable = work[work["_delta"].notna()].copy()
    if comparable.empty:
        return "Current grain performance is shown; no prior comparable period is available."

    signals = {
        normalize_text(value).upper()
        for value in comparable["_signal"].tolist()
        if normalize_text(value)
    }

    if signals == {"REGRESSING"}:
        worst = comparable.sort_values(
            "_delta",
            ascending=True,
        ).iloc[0]
        return (
            f"All active grains are regressing; "
            f"{normalize_text(worst.get('Grain', ''))} shows the largest decline "
            f"({_fmt_pp_v570(worst['_delta'])})."
        )

    if signals == {"IMPROVING"}:
        best = comparable.sort_values(
            "_delta",
            ascending=False,
        ).iloc[0]
        return (
            f"All active grains are improving; "
            f"{normalize_text(best.get('Grain', ''))} shows the strongest gain "
            f"({_fmt_pp_v570(best['_delta'])})."
        )

    if signals == {"STABLE"}:
        return "All active grains are stable versus their comparable prior periods."

    parts: List[str] = []
    for _, row in comparable.iterrows():
        grain = normalize_text(row.get("Grain", ""))
        signal = normalize_text(row.get("Signal", "")).lower()
        if grain and signal:
            parts.append(f"{grain} {signal}")

    return (
        "Mixed grain direction: " + "; ".join(parts[:3]) + "."
        if parts
        else "Grain performance is mixed versus the comparable prior periods."
    )


def _timeframe_section_callout_v572(
    frame: pd.DataFrame,
    analysis_type: str,
) -> str:
    """Return one short data-driven sentence for one timeframe table."""
    if frame is None or frame.empty:
        return "No data is available for this timeframe."

    work = frame.copy()
    work["_rate"] = pd.to_numeric(
        work.get("Smiley Rate"),
        errors="coerce",
    )
    work["_delta"] = pd.to_numeric(
        work.get("Smiley Δ pp"),
        errors="coerce",
    )
    work["_unhappy"] = pd.to_numeric(
        work.get("Unhappy Rate"),
        errors="coerce",
    )

    if analysis_type == "By Month":
        row = work.iloc[-1]
        segment = normalize_text(
            row.get("Segment / Period", "Current period")
        )
        rate = row["_rate"]
        delta = row["_delta"]
        unhappy = row["_unhappy"]

        rate_text = (
            format_rate(rate)
            if pd.notna(rate)
            else "N/A"
        )
        unhappy_text = (
            format_rate(unhappy)
            if pd.notna(unhappy)
            else "N/A"
        )

        if pd.notna(delta):
            if float(delta) > 0:
                comparison = (
                    f"up {abs(float(delta)):.1f} pp versus "
                    "the prior comparable period"
                )
            elif float(delta) < 0:
                comparison = (
                    f"down {abs(float(delta)):.1f} pp versus "
                    "the prior comparable period"
                )
            else:
                comparison = (
                    "flat versus the prior comparable period"
                )

            return (
                f"{segment}: Smiley Rate is {rate_text}, {comparison}; "
                f"Unhappy Rate is {unhappy_text}."
            )

        return (
            f"{segment}: Smiley Rate is {rate_text}; "
            f"Unhappy Rate is {unhappy_text}. "
            "No prior comparison is available."
        )

    valid_rates = work[
        work["_rate"].notna()
    ].copy()
    if valid_rates.empty:
        return "No valid Smiley Rate is available for this timeframe."

    weakest = valid_rates.sort_values(
        "_rate",
        ascending=True,
    ).iloc[0]
    weakest_segment = normalize_text(
        weakest.get("Segment / Period", "")
    )
    weakest_text = (
        f"Weakest current segment: {weakest_segment} at "
        f"{format_rate(weakest['_rate'])}."
    )

    comparable = work[
        work["_delta"].notna()
    ].copy()
    if comparable.empty:
        return (
            weakest_text
            + " No prior comparison is available."
        )

    worst = comparable.sort_values(
        "_delta",
        ascending=True,
    ).iloc[0]
    best = comparable.sort_values(
        "_delta",
        ascending=False,
    ).iloc[0]

    movement_parts: List[str] = []
    if float(worst["_delta"]) < 0:
        movement_parts.append(
            f"Largest regression: "
            f"{normalize_text(worst.get('Segment / Period', ''))} "
            f"({_fmt_pp_v570(worst['_delta'])})"
        )

    if float(best["_delta"]) > 0:
        movement_parts.append(
            f"strongest improvement: "
            f"{normalize_text(best.get('Segment / Period', ''))} "
            f"({_fmt_pp_v570(best['_delta'])})"
        )

    if not movement_parts:
        return weakest_text + " Comparable segments are stable."

    return (
        weakest_text
        + " "
        + "; ".join(movement_parts)
        + "."
    )



def _pil_exec_font_v575(
    size: int,
    bold: bool = False,
) -> ImageFont.FreeTypeFont:
    """Load a stable Colab font for repeatable pixel-level rendering."""
    candidates = (
        [
            "/usr/share/fonts/truetype/dejavu/DejaVuSans-Bold.ttf",
            "/usr/share/fonts/truetype/liberation2/LiberationSans-Bold.ttf",
        ]
        if bold
        else [
            "/usr/share/fonts/truetype/dejavu/DejaVuSans.ttf",
            "/usr/share/fonts/truetype/liberation2/LiberationSans-Regular.ttf",
        ]
    )

    for candidate in candidates:
        if Path(candidate).exists():
            return ImageFont.truetype(
                candidate,
                size=size,
            )

    return ImageFont.load_default()


def _pil_exec_text_width_v575(
    draw: ImageDraw.ImageDraw,
    text: str,
    font,
) -> int:
    bbox = draw.textbbox(
        (0, 0),
        str(text),
        font=font,
    )
    return int(bbox[2] - bbox[0])


def _pil_exec_wrap_v575(
    draw: ImageDraw.ImageDraw,
    text: str,
    font,
    max_width: int,
) -> List[str]:
    """Wrap text by actual pixel width."""
    words = normalize_text(text).split()
    if not words:
        return [""]

    lines: List[str] = []
    current = words[0]

    for word in words[1:]:
        candidate = f"{current} {word}"
        if (
            _pil_exec_text_width_v575(
                draw,
                candidate,
                font,
            )
            <= max_width
        ):
            current = candidate
        else:
            lines.append(current)
            current = word

    lines.append(current)
    return lines


def _pil_exec_rate_color_v575(
    rate: Any,
    good_if_high: bool,
) -> Tuple[str, str]:
    numeric = pd.to_numeric(
        pd.Series([rate]),
        errors="coerce",
    ).iloc[0]

    if pd.isna(numeric):
        return "#F2F4F7", "#667085"

    good = (
        float(numeric) >= 0.80
        if good_if_high
        else float(numeric) <= 0.20
    )

    return (
        ("#E6F4EA", "#176B2C")
        if good
        else ("#FCE8E6", "#B42318")
    )


def _pil_exec_delta_color_v575(
    delta: Any,
    positive_is_good: bool,
) -> Tuple[str, str]:
    numeric = pd.to_numeric(
        pd.Series([delta]),
        errors="coerce",
    ).iloc[0]

    if pd.isna(numeric):
        return "#F2F4F7", "#667085"

    if abs(float(numeric)) < 0.05:
        return "#FFF4CC", "#8A6100"

    improving = (
        float(numeric) > 0
        if positive_is_good
        else float(numeric) < 0
    )

    return (
        ("#E6F4EA", "#176B2C")
        if improving
        else ("#FCE8E6", "#B42318")
    )


def _pil_exec_signal_style_v575(
    signal: Any,
) -> Tuple[str, str, str]:
    upper = normalize_text(signal).upper()

    if upper == "IMPROVING":
        return "#E6F4EA", "#176B2C", "↑ Improving"
    if upper == "REGRESSING":
        return "#FCE8E6", "#B42318", "↓ Regressing"
    if upper == "STABLE":
        return "#FFF4CC", "#8A6100", "→ Stable"

    return "#F2F4F7", "#667085", "— No Prior"


def _pil_exec_draw_table_v575(
    draw: ImageDraw.ImageDraw,
    x: int,
    y: int,
    width: int,
    rows: Sequence[Mapping[str, Any]],
    headers: Sequence[str],
    col_widths: Sequence[float],
    header_fill: str,
    first_col_key: str,
    row_height: int = 46,
    header_height: int = 44,
    highlight_weakest: bool = True,
) -> int:
    """
    Draw one executive timeframe table and return the next y-coordinate.
    """
    grid = "#D0D5DD"
    text = "#101828"
    alt_row = "#F8FAFC"
    weak_outline = "#B42318"

    font_header = _pil_exec_font_v575(
        18,
        bold=True,
    )
    font_body = _pil_exec_font_v575(
        18,
        bold=False,
    )
    font_body_bold = _pil_exec_font_v575(
        18,
        bold=True,
    )

    total = sum(col_widths)
    px_widths = [
        int(width * (value / total))
        for value in col_widths
    ]
    px_widths[-1] += width - sum(px_widths)

    x_positions = [x]
    running = x
    for cw in px_widths:
        running += cw
        x_positions.append(running)

    draw.rounded_rectangle(
        [
            x,
            y,
            x + width,
            y + header_height,
        ],
        radius=8,
        fill=header_fill,
        outline=header_fill,
    )

    for col_index, header in enumerate(headers):
        left = x_positions[col_index]
        right = x_positions[col_index + 1]

        if col_index > 0:
            draw.line(
                [
                    left,
                    y,
                    left,
                    y + header_height,
                ],
                fill="#FFFFFF",
                width=1,
            )

        label = str(header)
        tw = _pil_exec_text_width_v575(
            draw,
            label,
            font_header,
        )

        draw.text(
            (
                left
                + (
                    right
                    - left
                    - tw
                )
                / 2,
                y + 10,
            ),
            label,
            font=font_header,
            fill="#FFFFFF",
        )

    current_y = y + header_height

    weakest_index = None
    if highlight_weakest and rows:
        valid_rates = []
        for idx, row in enumerate(rows):
            rate = pd.to_numeric(
                pd.Series(
                    [row.get("Smiley Rate")]
                ),
                errors="coerce",
            ).iloc[0]
            if pd.notna(rate):
                valid_rates.append(
                    (
                        idx,
                        float(rate),
                    )
                )

        if valid_rates:
            weakest_index = min(
                valid_rates,
                key=lambda pair: pair[1],
            )[0]

    for row_index, row in enumerate(rows):
        row_fill = (
            "#FFFFFF"
            if row_index % 2 == 0
            else alt_row
        )

        draw.rectangle(
            [
                x,
                current_y,
                x + width,
                current_y + row_height,
            ],
            fill=row_fill,
            outline=grid,
            width=1,
        )

        values = [
            normalize_text(
                row.get(
                    first_col_key,
                    "",
                )
            ),
            format_int(
                row.get("Responses")
            ),
            _fmt_rate_v570(
                row.get("Smiley Rate")
            ),
            _fmt_pp_v570(
                row.get("Smiley Δ pp")
            ),
            _fmt_rate_v570(
                row.get("Unhappy Rate")
            ),
            _fmt_pp_v570(
                row.get("Unhappy Δ pp")
            ),
            normalize_text(
                row.get("Signal")
            ),
        ]

        for col_index, value in enumerate(values):
            left = x_positions[col_index]
            right = x_positions[col_index + 1]

            if col_index > 0:
                draw.line(
                    [
                        left,
                        current_y,
                        left,
                        current_y + row_height,
                    ],
                    fill=grid,
                    width=1,
                )

            fill = None
            text_color = text
            font = font_body

            if col_index == 0:
                font = font_body_bold

            elif col_index == 2:
                fill, text_color = _pil_exec_rate_color_v575(
                    row.get("Smiley Rate"),
                    good_if_high=True,
                )
                font = font_body_bold

            elif col_index == 3:
                fill, text_color = _pil_exec_delta_color_v575(
                    row.get("Smiley Δ pp"),
                    positive_is_good=True,
                )
                font = font_body_bold

            elif col_index == 4:
                fill, text_color = _pil_exec_rate_color_v575(
                    row.get("Unhappy Rate"),
                    good_if_high=False,
                )
                font = font_body_bold

            elif col_index == 5:
                fill, text_color = _pil_exec_delta_color_v575(
                    row.get("Unhappy Δ pp"),
                    positive_is_good=False,
                )
                font = font_body_bold

            elif col_index == 6:
                (
                    fill,
                    text_color,
                    value,
                ) = _pil_exec_signal_style_v575(
                    row.get("Signal")
                )
                font = font_body_bold

            if fill:
                draw.rectangle(
                    [
                        left + 1,
                        current_y + 1,
                        right - 1,
                        current_y + row_height - 1,
                    ],
                    fill=fill,
                )

            value = str(value)
            tw = _pil_exec_text_width_v575(
                draw,
                value,
                font,
            )

            tx = (
                left + 14
                if col_index == 0
                else left
                + (
                    right
                    - left
                    - tw
                )
                / 2
            )

            draw.text(
                (
                    tx,
                    current_y + 12,
                ),
                value,
                font=font,
                fill=text_color,
            )

        if (
            weakest_index is not None
            and row_index == weakest_index
        ):
            draw.rectangle(
                [
                    x,
                    current_y,
                    x + width,
                    current_y + row_height,
                ],
                outline=weak_outline,
                width=2,
            )

        current_y += row_height

    return current_y


def _render_consolidated_email_reporting_image_v570(
    grain_summary: pd.DataFrame,
    timeframe: pd.DataFrame,
    output_path: str,
    config: AppConfig = CONFIG,
) -> str:
    """
    Render the executive email view as one fixed-pixel PNG.

    The PNG starts directly with Performance by Grain and then contains
    separate By Month, By Time of Day, By Day of Week, and By Day of Month
    tables. No document-level title or email-use label is rendered.
    """
    output = Path(output_path)
    output.parent.mkdir(
        parents=True,
        exist_ok=True,
    )

    CANVAS_W = 1600
    LEFT = 36
    RIGHT = 36
    CONTENT_W = CANVAS_W - LEFT - RIGHT

    NAVY = "#122B66"
    TEXT = "#101828"
    DIVIDER = "#D0D5DD"

    section_colors: Dict[str, str] = {
        "By Month": "#6F2C91",
        "By Time of Day": "#087A92",
        "By Day of Week": "#174EA6",
        "By Day of Month": "#E66A00",
    }

    font_section = _pil_exec_font_v575(
        30,
        bold=True,
    )
    font_subsection = _pil_exec_font_v575(
        26,
        bold=True,
    )
    font_callout = _pil_exec_font_v575(
        20,
        bold=False,
    )

    grain_rows: List[Dict[str, Any]] = []
    for _, row in grain_summary.iterrows():
        grain_rows.append(
            {
                "Grain": normalize_text(
                    row.get("Grain", "")
                ),
                "Period": normalize_text(
                    row.get("Period", "")
                ),
                "Responses": row.get("Responses"),
                "Smiley Rate": row.get("Smiley Rate"),
                "Smiley Δ pp": row.get("Smiley Δ pp"),
                "Unhappy Rate": row.get("Unhappy Rate"),
                "Unhappy Δ pp": row.get("Unhappy Δ pp"),
                "Signal": row.get("Signal"),
            }
        )

    timeframe_sections: List[
        Tuple[
            str,
            str,
            List[Dict[str, Any]],
        ]
    ] = []

    order = [
        ("By Month", "Period"),
        ("By Time of Day", "Time Block"),
        ("By Day of Week", "Day of Week"),
        ("By Day of Month", "Part of Month"),
    ]

    if (
        timeframe is not None
        and not timeframe.empty
    ):
        for (
            analysis_type,
            first_label,
        ) in order:
            section = timeframe[
                timeframe[
                    "Analysis Type"
                ]
                .map(normalize_text)
                .eq(analysis_type)
            ].copy()

            if not section.empty:
                timeframe_sections.append(
                    (
                        analysis_type,
                        first_label,
                        section.to_dict(
                            "records"
                        ),
                    )
                )

    # Dynamic vertical size using fixed row/header heights.
    total_h = 28
    total_h += (
        42
        + 40
        + 16
        + 44
        + 46 * max(1, len(grain_rows))
        + 42
    )
    total_h += 70

    for (
        analysis_type,
        _,
        rows,
    ) in timeframe_sections:
        section_df = pd.DataFrame(rows)
        callout = _timeframe_section_callout_v572(
            section_df,
            analysis_type,
        )
        callout_lines = (
            2
            if len(callout) > 125
            else 1
        )
        total_h += (
            38
            + 28 * callout_lines
            + 16
            + 44
            + 46 * max(1, len(rows))
            + 30
        )

    total_h += 24

    image = Image.new(
        "RGB",
        (
            CANVAS_W,
            int(total_h),
        ),
        "#FFFFFF",
    )
    draw = ImageDraw.Draw(image)

    y = 28

    # ------------------------------------------------------
    # Performance by Grain
    # ------------------------------------------------------
    draw.text(
        (
            LEFT,
            y,
        ),
        "Performance by Grain",
        font=font_section,
        fill=NAVY,
    )
    y += 42

    grain_callout = _grain_callout_v572(
        grain_summary
    )
    for line in _pil_exec_wrap_v575(
        draw,
        grain_callout,
        font_callout,
        CONTENT_W,
    )[:2]:
        draw.text(
            (
                LEFT,
                y,
            ),
            line,
            font=font_callout,
            fill=TEXT,
        )
        y += 26

    y += 12

    # 8-column grain table.
    grain_headers = [
        "Grain",
        "Period",
        "Responses",
        "Smiley Rate",
        "Δ vs Prior (pp)",
        "Unhappy Rate",
        "Δ vs Prior (pp)",
        "Signal",
    ]
    grain_width_weights = [
        0.10,
        0.21,
        0.09,
        0.11,
        0.12,
        0.11,
        0.12,
        0.14,
    ]

    grid = "#D0D5DD"
    alt_row = "#F8FAFC"
    font_header = _pil_exec_font_v575(
        18,
        bold=True,
    )
    font_body = _pil_exec_font_v575(
        18,
        bold=False,
    )
    font_body_bold = _pil_exec_font_v575(
        18,
        bold=True,
    )

    total_weight = sum(
        grain_width_weights
    )
    grain_px_widths = [
        int(
            CONTENT_W
            * weight
            / total_weight
        )
        for weight in grain_width_weights
    ]
    grain_px_widths[-1] += (
        CONTENT_W
        - sum(grain_px_widths)
    )

    x_positions = [LEFT]
    running_x = LEFT
    for col_width in grain_px_widths:
        running_x += col_width
        x_positions.append(
            running_x
        )

    header_h = 44
    row_h = 46

    draw.rounded_rectangle(
        [
            LEFT,
            y,
            LEFT + CONTENT_W,
            y + header_h,
        ],
        radius=8,
        fill=NAVY,
        outline=NAVY,
    )

    for ci, header in enumerate(
        grain_headers
    ):
        l = x_positions[ci]
        r = x_positions[ci + 1]

        if ci > 0:
            draw.line(
                [
                    l,
                    y,
                    l,
                    y + header_h,
                ],
                fill="#FFFFFF",
                width=1,
            )

        tw = _pil_exec_text_width_v575(
            draw,
            header,
            font_header,
        )
        draw.text(
            (
                l
                + (
                    r
                    - l
                    - tw
                )
                / 2,
                y + 10,
            ),
            header,
            font=font_header,
            fill="#FFFFFF",
        )

    y += header_h

    for ri, row in enumerate(
        grain_rows
    ):
        draw.rectangle(
            [
                LEFT,
                y,
                LEFT + CONTENT_W,
                y + row_h,
            ],
            fill=(
                "#FFFFFF"
                if ri % 2 == 0
                else alt_row
            ),
            outline=grid,
            width=1,
        )

        values = [
            row["Grain"],
            row["Period"],
            format_int(
                row["Responses"]
            ),
            _fmt_rate_v570(
                row["Smiley Rate"]
            ),
            _fmt_pp_v570(
                row["Smiley Δ pp"]
            ),
            _fmt_rate_v570(
                row["Unhappy Rate"]
            ),
            _fmt_pp_v570(
                row["Unhappy Δ pp"]
            ),
            row["Signal"],
        ]

        for ci, value in enumerate(
            values
        ):
            l = x_positions[ci]
            r = x_positions[ci + 1]

            if ci > 0:
                draw.line(
                    [
                        l,
                        y,
                        l,
                        y + row_h,
                    ],
                    fill=grid,
                    width=1,
                )

            fill = None
            text_color = TEXT
            font = font_body

            if ci == 0:
                font = font_body_bold
                text_color = NAVY

            elif ci == 3:
                (
                    fill,
                    text_color,
                ) = _pil_exec_rate_color_v575(
                    row["Smiley Rate"],
                    good_if_high=True,
                )
                font = font_body_bold

            elif ci == 4:
                (
                    fill,
                    text_color,
                ) = _pil_exec_delta_color_v575(
                    row["Smiley Δ pp"],
                    positive_is_good=True,
                )
                font = font_body_bold

            elif ci == 5:
                (
                    fill,
                    text_color,
                ) = _pil_exec_rate_color_v575(
                    row["Unhappy Rate"],
                    good_if_high=False,
                )
                font = font_body_bold

            elif ci == 6:
                (
                    fill,
                    text_color,
                ) = _pil_exec_delta_color_v575(
                    row["Unhappy Δ pp"],
                    positive_is_good=False,
                )
                font = font_body_bold

            elif ci == 7:
                (
                    fill,
                    text_color,
                    value,
                ) = _pil_exec_signal_style_v575(
                    row["Signal"]
                )
                font = font_body_bold

            if fill:
                draw.rectangle(
                    [
                        l + 1,
                        y + 1,
                        r - 1,
                        y + row_h - 1,
                    ],
                    fill=fill,
                )

            value = str(value)
            tw = _pil_exec_text_width_v575(
                draw,
                value,
                font,
            )
            tx = (
                l + 14
                if ci == 0
                else l
                + (
                    r
                    - l
                    - tw
                )
                / 2
            )

            draw.text(
                (
                    tx,
                    y + 12,
                ),
                value,
                font=font,
                fill=text_color,
            )

        y += row_h

    # ------------------------------------------------------
    # Timeframe & Timing Analysis
    # ------------------------------------------------------
    y += 28
    draw.line(
        [
            LEFT,
            y,
            LEFT + CONTENT_W,
            y,
        ],
        fill=DIVIDER,
        width=2,
    )
    y += 18

    draw.text(
        (
            LEFT,
            y,
        ),
        "Timeframe & Timing Analysis",
        font=font_section,
        fill=NAVY,
    )
    y += 50

    for (
        analysis_type,
        first_label,
        rows,
    ) in timeframe_sections:
        section_color = (
            section_colors.get(
                analysis_type,
                NAVY,
            )
        )

        draw.text(
            (
                LEFT,
                y,
            ),
            analysis_type,
            font=font_subsection,
            fill=section_color,
        )
        y += 34

        frame = pd.DataFrame(rows)
        callout = _timeframe_section_callout_v572(
            frame,
            analysis_type,
        )

        for line in _pil_exec_wrap_v575(
            draw,
            callout,
            font_callout,
            CONTENT_W,
        )[:2]:
            draw.text(
                (
                    LEFT,
                    y,
                ),
                line,
                font=font_callout,
                fill=TEXT,
            )
            y += 26

        y += 10

        prepared_rows: List[
            Dict[str, Any]
        ] = []

        for row in rows:
            prepared_rows.append(
                {
                    first_label: normalize_text(
                        row.get(
                            "Segment / Period",
                            "",
                        )
                    ),
                    "Responses": row.get(
                        "Responses"
                    ),
                    "Smiley Rate": row.get(
                        "Smiley Rate"
                    ),
                    "Smiley Δ pp": row.get(
                        "Smiley Δ pp"
                    ),
                    "Unhappy Rate": row.get(
                        "Unhappy Rate"
                    ),
                    "Unhappy Δ pp": row.get(
                        "Unhappy Δ pp"
                    ),
                    "Signal": row.get(
                        "Signal"
                    ),
                }
            )

        y = _pil_exec_draw_table_v575(
            draw=draw,
            x=LEFT,
            y=y,
            width=CONTENT_W,
            rows=prepared_rows,
            headers=[
                first_label,
                "Responses",
                "Smiley Rate",
                "Δ vs Prior (pp)",
                "Unhappy Rate",
                "Δ vs Prior (pp)",
                "Signal",
            ],
            col_widths=[
                0.24,
                0.10,
                0.13,
                0.13,
                0.13,
                0.13,
                0.14,
            ],
            header_fill=section_color,
            first_col_key=first_label,
            row_height=46,
            header_height=44,
            highlight_weakest=True,
        )

        y += 28

    final_height = min(
        image.height,
        int(y + 22),
    )

    image = image.crop(
        (
            0,
            0,
            CANVAS_W,
            final_height,
        )
    )

    image.save(
        output,
        format="PNG",
        optimize=True,
    )

    if (
        not output.exists()
        or output.stat().st_size == 0
    ):
        raise RuntimeError(
            "PIL executive image generation failed: "
            f"{output}"
        )

    return str(output)













def _validate_email_grain_summary_v574(
    grain_summary: pd.DataFrame,
) -> None:
    """
    Fail before rendering if the email grain summary falls back to the old
    v5.7.2 behavior.

    Guards:
      - Weekly label must be exactly WBMMDD.
      - A row with a valid Smiley Rate cannot display zero/blank Responses.
    """
    if grain_summary is None or grain_summary.empty:
        return

    for _, row in grain_summary.iterrows():
        grain = normalize_text(row.get("Grain", "")).upper()
        period = normalize_text(row.get("Period", ""))
        rate = pd.to_numeric(
            pd.Series([row.get("Smiley Rate")]),
            errors="coerce",
        ).iloc[0]
        responses = pd.to_numeric(
            pd.Series([row.get("Responses")]),
            errors="coerce",
        ).iloc[0]

        if grain == "WEEKLY":
            if not re.fullmatch(r"WB\d{4}", period):
                raise RuntimeError(
                    "Email grain summary audit failed: Weekly display must be "
                    f"WBMMDD only, received {period!r}. "
                    f"Active script version: v{__version__}."
                )

        if pd.notna(rate) and (
            pd.isna(responses) or float(responses) <= 0
        ):
            raise RuntimeError(
                "Email grain summary audit failed: a valid Smiley Rate was "
                f"paired with invalid Responses for {grain or 'UNKNOWN'} "
