def _v572_aftr_valid_mask(df: pd.DataFrame) -> pd.Series:
    if df is None or not isinstance(df, pd.DataFrame) or df.empty:
        return pd.Series(dtype="bool")
    numerator_col = "advisor_first_touch_resolution_rate_numerator"
    denominator_col = "advisor_first_touch_resolution_rate_denominator"
    if numerator_col not in df.columns or denominator_col not in df.columns:
        return pd.Series(False, index=df.index)
    numerator = _v572_numeric_series(df, numerator_col)
    denominator = _v572_numeric_series(df, denominator_col)
    return numerator.notna() & denominator.notna() & denominator.gt(0)


def _v572_aftr_rate(df: pd.DataFrame) -> Dict[str, Any]:
    numerator_col = "advisor_first_touch_resolution_rate_numerator"
    denominator_col = "advisor_first_touch_resolution_rate_denominator"
    if df is None or not isinstance(df, pd.DataFrame) or df.empty:
        return {"available": False, "rate": np.nan, "numerator": 0.0, "denominator": 0.0, "valid_surveys": 0}
    if numerator_col not in df.columns or denominator_col not in df.columns:
        return {"available": False, "rate": np.nan, "numerator": 0.0, "denominator": 0.0, "valid_surveys": 0}
    numerator = _v572_numeric_series(df, numerator_col)
    denominator = _v572_numeric_series(df, denominator_col)
    valid = numerator.notna() & denominator.notna() & denominator.gt(0)
    if not bool(valid.any()):
        return {"available": False, "rate": np.nan, "numerator": 0.0, "denominator": 0.0, "valid_surveys": 0}
    numerator_total = float(numerator[valid].sum())
    denominator_total = float(denominator[valid].sum())
    return {
        "available": denominator_total > 0,
        "rate": safe_rate(numerator_total, denominator_total),
        "numerator": numerator_total,
        "denominator": denominator_total,
        "valid_surveys": int(valid.sum()),
    }


def _v572_aftr_records(
    selection: ReportSelection,
    grain_results: Mapping[str, GrainResult],
    config: AppConfig = CONFIG,
) -> List[Dict[str, Any]]:
    del selection, config
    records: List[Dict[str, Any]] = []
    for grain in V572_AFTR_GRAINS:
        result = grain_results.get(grain) if isinstance(grain_results, Mapping) else None
        if result is None:
            continue
        df = getattr(result, "current_period_df", pd.DataFrame())
        metric = getattr(result, "overall", None)
        if df is None or not isinstance(df, pd.DataFrame) or df.empty:
            continue

        counts = _email_v565_response_summary(df)
        masks = _v572_outcome_masks(df)
        valid = _v572_aftr_valid_mask(df)
        if valid.empty or not bool(valid.any()):
            records.append(
                {
                    "Grain": grain.title(),
                    "Rated Responses": counts.get("Rated", 0.0),
                    "Valid AFTR Surveys": 0,
                    "Smiley AFTR %": np.nan,
                    "Non-Smiley AFTR %": np.nan,
                    "AFTR Gap": np.nan,
                    "Top AFTR L1": "N/A",
                    "Top AFTR L2": "N/A",
                    "Top AFTR L3": "N/A",
                    "Sample": "No usable AFTR data",
                    "_Path": "",
                }
            )
            continue

        smiley_df = df[valid & masks["smiley"]].copy()
        non_smiley_df = df[valid & masks["non_smiley"]].copy()
        smiley_aftr = _v572_aftr_rate(smiley_df)
        non_smiley_aftr = _v572_aftr_rate(non_smiley_df)
        smiley_rate = smiley_aftr.get("rate", np.nan)
        non_smiley_rate = non_smiley_aftr.get("rate", np.nan)
        gap = smiley_rate - non_smiley_rate if pd.notna(smiley_rate) and pd.notna(non_smiley_rate) else np.nan

        numerator_col = "advisor_first_touch_resolution_rate_numerator"
        denominator_col = "advisor_first_touch_resolution_rate_denominator"
        numerator = _v572_numeric_series(df, numerator_col)
        denominator = _v572_numeric_series(df, denominator_col)
        miss_mask = valid & masks["non_smiley"] & numerator.lt(denominator)
        driver_df = df[miss_mask].copy()
        if driver_df.empty:
            driver_df = non_smiley_df.copy()
        if driver_df.empty:
            driver_df = df[valid].copy()
        path = _v572_top_path_record(
            driver_df,
            ["AFTR L1", "AFTR L2", "AFTR L3"],
            label="AFTR",
        )

        records.append(
            {
                "Grain": grain.title(),
                "Period": _email_v551_current_period_label(metric) if metric is not None else grain.title(),
                "Rated Responses": counts.get("Rated", 0.0),
                "Valid AFTR Surveys": int(valid.sum()),
                "Smiley AFTR %": smiley_rate,
                "Non-Smiley AFTR %": non_smiley_rate,
                "AFTR Gap": gap,
                "Top AFTR L1": normalize_text(path.get("AFTR L1", "")) or "N/A",
                "Top AFTR L2": normalize_text(path.get("AFTR L2", "")) or "N/A",
                "Top AFTR L3": normalize_text(path.get("AFTR L3", "")) or "N/A",
                "Sample": sample_size_label(int(valid.sum())),
                "_Path": _v572_top_path_string(path, "No usable AFTR driver path"),
            }
        )
    return records


def _v572_aftr_table_rows(records: Sequence[Mapping[str, Any]]) -> List[List[str]]:
    rows: List[List[str]] = []
    for record in records:
        rows.append(
