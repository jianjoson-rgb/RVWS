def _v573_aftr_narrative(
    scope_name: str,
    summary_records: Sequence[Mapping[str, Any]],
    hierarchy_records: Sequence[Mapping[str, Any]],
    *,
    site_specific: bool = False,
) -> List[str]:
    bullets: List[str] = []
    if site_specific:
        bullets.append(f"AFTR Impact for {scope_name} reviews whether first-touch resolution differs between Smiley surveys and Non-Smiley surveys for Weekly and Monthly.")
    else:
        bullets.append("AFTR Impact reviews survey-linked first-touch resolution performance for Weekly and Monthly only.")

    for grain in ("Weekly", "Monthly"):
        record = next((item for item in summary_records if normalize_text(item.get("Grain", "")).lower() == grain.lower()), None)
        if not record:
            continue
        bullets.append(
            f"{grain} AFTR: Smiley surveys had {format_rate(record.get('Smiley AFTR %', np.nan))} AFTR versus "
            f"Non-Smiley surveys at {format_rate(record.get('Non-Smiley AFTR %', np.nan))}, creating a "
            f"{format_pp(record.get('AFTR Gap', np.nan))} gap across {format_int(record.get('Valid AFTR Surveys', 0.0))} valid AFTR surveys."
        )

    top = _v573_first_hierarchy_path(hierarchy_records)
    if top:
        bullets.append(
            f"AFTR Driver: the leading Non-Smiley AFTR path was {_v573_human_path(top.get('Level 1'), top.get('Level 2'), top.get('Level 3'))}, "
            f"representing {format_rate(top.get('Share', np.nan), 1)} of valid Non-Smiley surveys in the AFTR drilldown."
        )
    else:
        bullets.append("AFTR Driver: no usable AFTR L1/L2/L3 hierarchy was available.")

    if site_specific:
        bullets.append(f"Site Readout: if Non-Smiley surveys have weaker AFTR, {scope_name} should validate whether unresolved first-touch issues are connected to the leading taxonomy, squad, and QA drivers.")
    else:
        bullets.append("Executive Readout: if Non-Smiley surveys show materially lower AFTR, first-touch resolution should be treated as a likely contributor to merchant Smiley movement.")
    return bullets


