def build_squad_impact_chart(
    squad_table: pd.DataFrame,
    site: str,
    grain: str,
    output_path: str,
    config: AppConfig = CONFIG,
) -> str:
    if squad_table is None or squad_table.empty:
        return ""

    negative = top_squads(
        squad_table,
        "negative",
        config.top_squads_per_direction,
        minimum_responses=config.directional_n,
    )
    positive = top_squads(
        squad_table,
        "positive",
        config.top_squads_per_direction,
        minimum_responses=config.directional_n,
    )
    selected = pd.concat([negative, positive], ignore_index=True).drop_duplicates(
        subset=["Squad Code"]
    )
    if selected.empty:
        return ""

    selected = selected.sort_values("Official Impact", ascending=True)
    impacts_pp = selected["Official Impact"].astype(float) * 100
    labels = [
        f"{row['Squad Code']} | {format_int(row['Responses'])} rsp"
        for _, row in selected.iterrows()
    ]
    colors = [
        config.chart_negative_color if value < 0 else config.chart_positive_color
        for value in impacts_pp
    ]

    fig, ax = plt.subplots(figsize=(10.5, max(4.2, len(selected) * 0.43 + 1.4)))
    y = np.arange(len(selected))
    bars = ax.barh(y, impacts_pp, color=colors, alpha=0.90)
    ax.axvline(0, color="#6B7280", linewidth=1)
    ax.set_yticks(y)
    ax.set_yticklabels(labels, fontsize=9)
    ax.set_xlabel("Impact versus target (percentage points)", fontsize=9)
    ax.set_title(
        f"{site} {grain.title()} Squad Impact — Positive and Negative Drivers",
        loc="left",
        fontsize=14,
        fontweight="bold",
        color=config.chart_title_color,
        pad=12,
    )
    ax.grid(axis="x", color=config.chart_grid_color, linewidth=0.7)
    ax.set_axisbelow(True)
    ax.spines["top"].set_visible(False)
    ax.spines["right"].set_visible(False)

    for bar, value in zip(bars, impacts_pp):
        x = value + (0.03 if value >= 0 else -0.03)
        ax.text(
            x,
            bar.get_y() + bar.get_height() / 2,
            f"{value:+.2f} pp",
            va="center",
            ha="left" if value >= 0 else "right",
            fontsize=8.5,
            fontweight="bold",
            color=config.chart_neutral_color,
        )

    output = Path(output_path)
    output.parent.mkdir(parents=True, exist_ok=True)
    fig.tight_layout()
    fig.savefig(output, dpi=config.chart_dpi, bbox_inches="tight", facecolor="white")
    plt.close(fig)
    return str(output)


def build_qa_heatmap(
    qa_summary: pd.DataFrame,
    site: str,
    focus_squads: Sequence[str],
    output_path: str,
    config: AppConfig = CONFIG,
) -> str:
    """
    Build an executive QA pass-rate heatmap.

    Visual rule:
    - Values below the configured QA target are always red.
    - Values at or above the configured QA target are always green.
    - Text color is selected automatically for contrast.
    - Missing / not-audited values are shown in light gray as N/A.
    """
    if qa_summary is None or qa_summary.empty:
        return ""

    required_columns = {
        "Site",
        "Squad Code",
        "QA Attribute",
        "Pass Rate",
        "Audited",
    }
    missing_columns = sorted(required_columns.difference(qa_summary.columns))
    if missing_columns:
        LOGGER.warning(
            "QA heatmap skipped for %s. Missing columns: %s",
            site,
            missing_columns,
        )
        return ""

    focus_squad_set = {
        normalize_text(value)
        for value in focus_squads
        if normalize_text(value)
    }
    if not focus_squad_set:
        return ""

    focus = qa_summary[
        qa_summary["Site"].astype(str).str.strip().eq(str(site).strip())
        & qa_summary["Squad Code"].astype(str).str.strip().isin(focus_squad_set)
        & pd.to_numeric(qa_summary["Audited"], errors="coerce").fillna(0).gt(0)
    ].copy()
    if focus.empty:
        return ""

    focus["Pass Rate"] = pd.to_numeric(focus["Pass Rate"], errors="coerce")
    focus["Squad Code"] = focus["Squad Code"].astype(str).str.strip()
    focus["QA Attribute"] = focus["QA Attribute"].astype(str).str.strip()

    pivot = focus.pivot_table(
        index="Squad Code",
        columns="QA Attribute",
        values="Pass Rate",
        aggfunc="mean",
    )

    ordered_columns = [
        column
        for column in QA_ATTRIBUTE_COLUMNS
        if column in pivot.columns
    ]
    pivot = pivot.reindex(columns=ordered_columns)

    ordered_squads = [
        normalize_text(squad)
        for squad in focus_squads
        if normalize_text(squad) in pivot.index
    ]
    remaining_squads = [
        squad
        for squad in pivot.index
        if squad not in set(ordered_squads)
    ]
    pivot = pivot.reindex(index=ordered_squads + remaining_squads)

    if pivot.empty:
        return ""

    target = float(np.clip(config.qa_heatmap_target_rate, 0.01, 0.99))

    # The boundaries create a hard visual break at the target.
    # Every interval below target uses a red shade; every interval from
    # target upward uses a green shade.
    red_mid_boundary = target * (2.0 / 3.0)
    red_high_boundary = target * (13.0 / 15.0)
    green_mid_boundary = target + ((1.0 - target) * 0.40)
    green_high_boundary = target + ((1.0 - target) * 0.80)

    boundaries = [
        0.0,
        red_mid_boundary,
        red_high_boundary,
        target,
        green_mid_boundary,
        green_high_boundary,
        1.000001,
    ]
    heatmap_colors = [
        config.qa_heatmap_red_dark,
        config.qa_heatmap_red_medium,
        config.qa_heatmap_red_light,
        config.qa_heatmap_green_light,
        config.qa_heatmap_green_medium,
        config.qa_heatmap_green_dark,
    ]

    cmap = ListedColormap(heatmap_colors, name="qa_target_heatmap")
    cmap.set_bad(config.qa_heatmap_na_color)
    norm = BoundaryNorm(boundaries, cmap.N, clip=True)

    data = pivot.to_numpy(dtype=float)
    clipped_data = np.clip(data, 0.0, 1.0)
    masked = np.ma.masked_invalid(clipped_data)

    figure_height = max(3.6, len(pivot.index) * 0.58 + 2.25)
    fig, ax = plt.subplots(figsize=(11.0, figure_height))

    image = ax.imshow(
        masked,
        aspect="auto",
        cmap=cmap,
        norm=norm,
        interpolation="nearest",
    )

    ax.set_xticks(np.arange(len(pivot.columns)))
    ax.set_xticklabels(
        pivot.columns,
        rotation=32,
        ha="right",
        rotation_mode="anchor",
        fontsize=8.5,
    )
    ax.set_yticks(np.arange(len(pivot.index)))
    ax.set_yticklabels(pivot.index, fontsize=9)

    ax.set_title(
        f"{site} Focus-Squad QA Attribute Pass Rates",
        loc="left",
        fontsize=14,
        fontweight="bold",
        color=config.chart_title_color,
        pad=23,
    )
    ax.text(
        0.0,
        1.015,
        (
            f"Red = below {target:.0%} target  |  "
            f"Green = {target:.0%} or above  |  Gray = not audited"
        ),
        transform=ax.transAxes,
        ha="left",
        va="bottom",
        fontsize=8.8,
        color=config.chart_neutral_color,
    )

    # Clear white cell borders improve readability when adjacent cells
    # have similar shades.
    ax.set_xticks(
        np.arange(-0.5, len(pivot.columns), 1.0),
        minor=True,
    )
    ax.set_yticks(
        np.arange(-0.5, len(pivot.index), 1.0),
        minor=True,
    )
    ax.grid(
        which="minor",
        color=config.qa_heatmap_cell_border_color,
        linestyle="-",
        linewidth=1.4,
    )
    ax.tick_params(which="minor", bottom=False, left=False)

    # Label each cell and automatically choose black or white text
    # based on the rendered background luminance.
    for row_idx in range(data.shape[0]):
        for col_idx in range(data.shape[1]):
            original_value = data[row_idx, col_idx]

            if np.isnan(original_value):
                label = "N/A"
                text_color = "#374151"
            else:
                bounded_value = float(np.clip(original_value, 0.0, 1.0))
                label = f"{bounded_value:.0%}"

                red, green, blue, _ = cmap(norm(bounded_value))
                luminance = (
                    0.2126 * red
                    + 0.7152 * green
                    + 0.0722 * blue
                )
                text_color = "#FFFFFF" if luminance < 0.48 else "#111827"

            ax.text(
                col_idx,
                row_idx,
                label,
                ha="center",
                va="center",
                fontsize=8.4,
                fontweight="bold",
                color=text_color,
            )

    colorbar = fig.colorbar(
        image,
        ax=ax,
        fraction=0.026,
        pad=0.022,
        boundaries=boundaries,
    )
    colorbar_ticks = sorted(
        {
            0.0,
            0.50,
            target,
            min(1.0, target + ((1.0 - target) * 0.40)),
            1.0,
        }
    )
    colorbar.set_ticks(colorbar_ticks)
    colorbar.ax.yaxis.set_major_formatter(
        ticker.PercentFormatter(xmax=1.0, decimals=0)
    )
    colorbar.set_label("QA Pass Rate", fontsize=8.5)
    colorbar.ax.axhline(
        target,
        color="#111827",
        linewidth=2.0,
    )

    ax.set_xlabel("")
    ax.set_ylabel("Squad Code")
    ax.spines["top"].set_visible(False)
    ax.spines["right"].set_visible(False)

    fig.tight_layout(pad=1.2)

    output = Path(output_path)
    output.parent.mkdir(parents=True, exist_ok=True)
    fig.savefig(
        output,
        dpi=config.chart_dpi,
        bbox_inches="tight",
        facecolor="white",
    )
    plt.close(fig)
    return str(output)

