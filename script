                folder_url = normalize_text(artifacts.get("drive_folder_url", ""))
                main_cell = (
                    f"<a href='{main_url}' target='_blank'>Open main Doc</a>"
                    if main_url
                    else normalize_text(artifacts.get("docx_path", ""))
                )
                email_cell = (
                    f"<a href='{email_url}' target='_blank'>Open email Doc</a>"
                    if email_url
                    else normalize_text(artifacts.get("email_body_docx_path", ""))
                )
                folder_cell = (
                    f"<a href='{folder_url}' target='_blank'>Open folder</a>"
                    if folder_url
                    else normalize_text(artifacts.get("output_dir", ""))
                )
                status = "<span style='color:#166534;font-weight:700;'>Completed</span>"
            else:
                main_cell = ""
                email_cell = ""
                folder_cell = ""
                status = (
                    "<span style='color:#B91C1C;font-weight:700;'>Failed: "
                    + html.escape(normalize_text(errors_by_lob.get(lob, "Unknown error")))
                    + "</span>"
                )
            lines.append(
                "<tr>"
                f"<td style='border:1px solid #D1D5DB;padding:6px;font-weight:700;'>{html.escape(lob)}</td>"
                f"<td style='border:1px solid #D1D5DB;padding:6px;'>{main_cell}</td>"
                f"<td style='border:1px solid #D1D5DB;padding:6px;'>{email_cell}</td>"
                f"<td style='border:1px solid #D1D5DB;padding:6px;'>{folder_cell}</td>"
                f"<td style='border:1px solid #D1D5DB;padding:6px;'>{status}</td>"
                "</tr>"
            )
        lines.append("</table>")
        if warnings_list:
            warning_html = "<br>".join(html.escape(normalize_text(w)) for w in warnings_list)
            lines.append(
                "<div style='margin-top:8px;color:#92400E;'><b>Warnings:</b><br>"
                f"{warning_html}</div>"
            )
        return "".join(lines)

    artifacts = results["artifacts"]
    link_lines = [
        "<h4 style='color:#166534;'>Report completed</h4>",
        "<div><b>Output mode:</b> Docs only</div>",
        f"<div><b>Local DOCX source:</b> {html.escape(normalize_text(artifacts.get('docx_path', '')))}</div>",
    ]
    if artifacts.get("google_doc_url"):
        link_lines.append(
            f"<div><a href='{artifacts['google_doc_url']}' "
            "target='_blank'>Open Google Docs report</a></div>"
        )
    if artifacts.get("email_body_google_doc_url"):
        link_lines.append(
            f"<div><a href='{artifacts['email_body_google_doc_url']}' "
            "target='_blank'>Open FOR EMAIL ONLY Google Doc</a></div>"
        )
    if artifacts.get("drive_folder_url"):
        link_lines.append(
            f"<div><a href='{artifacts['drive_folder_url']}' "
            "target='_blank'>Open Shared Drive Report Folder</a></div>"
        )
    return "".join(link_lines)


def run_executive_report(
    selection: ReportSelection,
    clients: Optional[GoogleClients] = None,
    spreadsheet=None,
    normalized_source_df: Optional[pd.DataFrame] = None,
    source_validation: Optional[Dict[str, Any]] = None,
    config: AppConfig = CONFIG,
) -> Dict[str, Any]:
    """
    Run the approved VP executive Smiley report end to end.

    This function can be called directly without widgets:
        run_executive_report(
            ReportSelection(
                "SPECIFIC WEEK",
                "PREMIUM",
                "ALL GRAINS",
                anchor_date="2026-07-26",
            )
        )
    """
    config = enforce_docs_only_staging_mode_v563(config)

    if is_all_lobs_one_each_selection(selection.lob):
        return run_all_lobs_one_each_v536(
            selection=selection,
            clients=clients,
            spreadsheet=spreadsheet,
            normalized_source_df=normalized_source_df,
            source_validation=source_validation,
            config=config,
        )

    started_at = time.time()
    warnings_list: List[str] = []
    _validate_v560_runtime_symbols_v561()
    _v538_validate_effective_grain_scope()
    validate_app_config(config)

    # Resolve the detailed-site population for this LOB without restricting the
    # all-site Executive Summary population.
    resolved_detail_sites = resolve_site_detail_sites(selection.lob, config)
    config = replace(config, site_detail_sites=resolved_detail_sites)

    output_root = make_output_dir(config)
    run_dir = output_root / safe_filename(
        f"{selection.lob}_{selection.report_month}_"
        f"{selection.grain}_{timestamp_slug()}"
    )
    run_dir.mkdir(parents=True, exist_ok=True)

    LOGGER.info("Starting executive report: %s", selection)

    if clients is None:
        clients = authenticate_google()
    if spreadsheet is None:
        spreadsheet = open_source_spreadsheet(clients, config)

    if normalized_source_df is None:
        raw_df = load_source_values(spreadsheet, config)
        raw_staging_validation_v563 = validate_raw_staging_headers_v563(
            raw_df,
            config,
        )
        normalized_source_df, source_validation = normalize_source_schema(
            raw_df, config
        )
        if source_validation is not None:
            source_validation["raw_staging_validation_v563"] = raw_staging_validation_v563
    elif source_validation is None:
        source_validation = {
            "raw_rows": len(normalized_source_df),
            "normalized_rows": len(normalized_source_df),
            "raw_columns": len(normalized_source_df.columns),
            "removed_bad_rows": 0,
            "invalid_date_count": 0,
            "invalid_created_date_count": 0,
            "created_date_valid_count": int(
                pd.to_datetime(
                    normalized_source_df.get(
                        "_Created Date UTC",
                        pd.Series(pd.NaT, index=normalized_source_df.index),
                    ),
                    errors="coerce",
                    utc=True,
                ).notna().sum()
            ),
            "created_date_min_utc": normalize_text(
                pd.to_datetime(
                    normalized_source_df.get(
                        "_Created Date UTC",
                        pd.Series(pd.NaT, index=normalized_source_df.index),
                    ),
                    errors="coerce",
                    utc=True,
                ).min()
            ),
            "created_date_max_utc": normalize_text(
                pd.to_datetime(
                    normalized_source_df.get(
                        "_Created Date UTC",
                        pd.Series(pd.NaT, index=normalized_source_df.index),
                    ),
                    errors="coerce",
                    utc=True,
                ).max()
            ),
            "created_date_distinct_utc_hours": int(
                pd.to_datetime(
                    normalized_source_df.get(
                        "_Created Date UTC",
                        pd.Series(pd.NaT, index=normalized_source_df.index),
                    ),
                    errors="coerce",
                    utc=True,
                ).dt.hour.nunique()
            ),
            "empty_ticket_id_count": 0,
            "zero_response_count_before_removal": 0,
            "response_rows_repaired": 0,
            "invalid_numerator_count": 0,
            "duplicate_rows_before_dedup": 0,
            "duplicate_ticket_ids": 0,
            "deduplicate_tickets_enabled": config.deduplicate_tickets,
            "reporting_recommended_missing": [],
            "qa_columns_present": [
                column
                for column in QA_ATTRIBUTE_COLUMNS
                if column in normalized_source_df.columns
            ],
            "impact_columns_present": [
                column
                for column in SOURCE_IMPACT_COLUMNS.values()
                if column in normalized_source_df.columns
            ],
            "qa_validation": {},
            "duplicate_audit": pd.DataFrame(),
        }

    filtered_df, filter_summary = apply_business_filter(
        normalized_source_df,
        selection.lob,
        config,
    )
    lob_latest_warning = _v539_lob_latest_date_warning(
        normalized_source_df=normalized_source_df,
        filtered_df=filtered_df,
        lob=selection.lob,
    )
    if lob_latest_warning:
        warnings_list.append(lob_latest_warning)
        print(f"PERIOD WARNING: {lob_latest_warning}")

    report_scope = build_report_scope(
        filtered_df,
        selection.report_month,
        anchor_date=selection.anchor_date,
        config=config,
    )
    selected_output_grains = _active_grains_v570(selection)
    # v5.7.0: Grain is a report-wide analysis mode.
    # ALL GRAINS runs Daily, Weekly, and Monthly independently.
    # A specific grain runs only that grain across grain-sensitive sections.
    grains = list(selected_output_grains)

    validate_and_print_resolved_grain_periods_v539(
        report_scope=report_scope,
        selected_grains=grains,
        context_label=(
            f"{selection.lob} | {selection.report_month} | {selection.grain}"
        ),
    )

    grain_results: Dict[str, GrainResult] = {}
    for grain in grains:
        grain_results[grain] = build_grain_result(
            filtered_df,
            grain,
            report_scope,
            config,
        )
        if grain_results[grain].overall.baseline_period_count < {
            "DAILY": config.daily_baseline_periods,
            "WEEKLY": config.weekly_baseline_periods,
            "MONTHLY": config.monthly_baseline_periods,
        }[grain]:
            warnings_list.append(
                f"{grain} used only "
                f"{grain_results[grain].overall.baseline_period_count} available "
                "baseline periods."
            )
        if not grain_results[grain].source_impact_valid:
            warnings_list.append(
                grain_results[grain].source_impact_message
            )

        reconciliation_total = grain_results[grain].executive_reconciliation
        reconciliation_total = reconciliation_total[
            reconciliation_total["Site"].eq("EXECUTIVE ALL SITES")
        ]
        if not reconciliation_total.empty:
            missing_sites = normalize_text(
                reconciliation_total.iloc[0].get("Missing Detailed Sites", "")
            )
            if missing_sites:
                warnings_list.append(
                    f"{grain} executive rollup has no current-period responses "
                    f"for detailed site(s): {missing_sites}. The executive rate "
                    "uses only all sites with available responses."
                )

    analysis_report_scope = _analysis_scope_for_selection_v570(
        report_scope=report_scope,
        grain_results=grain_results,
        selection=selection,
        source_df=filtered_df,
    )

    # ----------------------------------------------------------
    # v5.6.7 TREND/TIMEFRAME DATE SOURCE
    # ----------------------------------------------------------
    # Existing report calculations remain on filtered_df/report_scope.
    # Trend images and timeframe tables use Smiley Registered At only.
    (
        registered_trend_df,
        registered_trend_scope,
        registered_trend_grain_results,
    ) = _build_smiley_registered_trend_context_v567(
        filtered_df=filtered_df,
        selection=selection,
        grains=grains,
        config=config,
    )

    registered_analysis_scope = _analysis_scope_for_selection_v570(
        report_scope=registered_trend_scope,
        grain_results=registered_trend_grain_results,
        selection=selection,
        source_df=registered_trend_df,
    )

    report_content_date = _report_content_date_v568(
        registered_analysis_scope
    )
    document_names = _report_document_names_v568(
        selection.lob,
        report_content_date,
    )

    # Store exact native Google Docs titles in both the original and active
    # analysis scopes so publishing remains stable for every Grain mode.
    for _scope in (report_scope, analysis_report_scope):
        _scope["output_google_doc_name"] = (
            document_names["google_doc_name"]
        )
        _scope["output_email_google_doc_name"] = (
            document_names["email_google_doc_name"]
        )
        _scope["output_report_content_date"] = (
            document_names["report_date"]
        )

    registered_missing_count = int(
        pd.to_datetime(
            filtered_df["Smiley Registered At"],
            errors="coerce",
        ).isna().sum()
    )
    if registered_missing_count:
        warnings_list.append(
            f"{registered_missing_count:,} row(s) were excluded from trend "
            "images and timeframe tables because Smiley Registered At was blank "
            "or invalid."
        )

    # Keep the executive calculations and graph inputs on the full all-site LOB
    # population. Build a separate document-safe view so Google Docs and
    # email narratives never name a site outside the approved LOB site list.
    document_grain_results = build_document_grain_results(
        grain_results,
        config,
    )

    finance_qa_analyses: Dict[str, FinanceQAGrainAnalysis] = {}
    finance_qa_scope_analyses: Dict[
        str,
        FinanceQAScopeAnalysis,
    ] = {}
    if config.enable_finance_qa_analysis:
        finance_qa_scope_analyses = build_finance_qa_scope_analyses(
            filtered_df=filtered_df,
            grain_results=grain_results,
            report_scope=analysis_report_scope,
            config=config,
        )
        # Timeframe/timing table publishing was removed in v5.7.23.
        # Keep Finance/QA analyses and executive trend charts intact, but do not
        # realign or publish any timeframe table fields.
        for _scope_analysis in finance_qa_scope_analyses.values():
            _scope_analysis.active_grains_v570 = list(grains)

        overall_scope = finance_qa_scope_analyses.get("OVERALL")
        finance_qa_analyses = (
            overall_scope.grain_analyses
            if overall_scope is not None
            else build_finance_qa_grain_analyses(
                filtered_df=filtered_df,
                grain_results=grain_results,
                config=config,
            )
        )
        # Time-of-day/day-of-week/day-of-month table validations are intentionally
        # skipped because timeframe/timing tables are no longer published.
        detected_ratings = sorted(
            {
                normalize_text(value)
                for value in filtered_df["Smiley Rating"].tolist()
                if normalize_text(value)
            }
        )
        unexpected_ratings = [
            value
            for value in detected_ratings
            if normalize_smiley_outcome(value) == ""
        ]
        if unexpected_ratings:
            warnings_list.append(
                "Finance QA analysis excluded unexpected Smiley Rating values: "
                + ", ".join(unexpected_ratings)
            )

    primary_site, primary_site_ranking = identify_primary_site(
        document_grain_results,
        config,
    )
    focus_squad_df = combined_underperforming_squads(
        primary_site,
        document_grain_results,
        limit=config.underperforming_squad_limit,
        config=config,
    )
    focus_squads = (
        focus_squad_df["Squad Code"].astype(str).tolist()
        if not focus_squad_df.empty
        else []
    )

    report_df = _analysis_population_v570(
        report_scope=analysis_report_scope,
        grain_results=grain_results,
        selection=selection,
        source_df=filtered_df,
    )
    qa_enriched_report_df = add_ticket_qa_metrics(report_df)
    qa_summary = build_qa_attribute_summary(qa_enriched_report_df)

    # Document-facing QA and scrub outputs are restricted to approved sites.
    # The all-site report_df and qa_summary remain available for audit writeback.
    document_report_df = filter_rows_to_approved_sites(report_df, config)
    document_qa_enriched_df = add_ticket_qa_metrics(document_report_df)
    document_qa_summary = build_qa_attribute_summary(
        document_qa_enriched_df
    )
    raw_scrubbed_tickets = build_scrubbed_tickets(
        report_df=document_report_df,
        primary_site=primary_site,
        focus_squads=focus_squads,
        config=config,
    )
    document_scrubbed_tickets = prepare_scrubbed_tickets_for_export(
        scrubbed_tickets=raw_scrubbed_tickets,
        source_df=document_report_df,
        config=config,
    )
    # Backward-compatible aliases for internal writeback functions. These are
    # intentionally document-safe and contain approved sites only.
    scrubbed_tickets = document_scrubbed_tickets

    site_reports = build_site_report_metrics(
        df=filtered_df,
        grains=grains,
        report_scope=analysis_report_scope,
        qa_summary=document_qa_summary,
        scrubbed_tickets=document_scrubbed_tickets,
        grain_results=document_grain_results,
        config=config,
    )

    overall_dashboard_path = run_dir / "Executive_Trend_Dashboard.png"
    build_executive_dashboard(
        metrics={
            grain: result.overall
            for grain, result in registered_trend_grain_results.items()
            if grain in selected_output_grains
        },
        output_path=str(overall_dashboard_path),
        report_label=registered_analysis_scope["report_label"],
        lob_label=selection.lob,
        data_through=registered_analysis_scope["data_through"],
        config=config,
    )
    all_sites_overview_path = run_dir / "All_Sites_Rolling_Overview.png"
    if config.generate_all_sites_rolling_overview:
        if len(grains) == 3:
            build_all_sites_rolling_overview(
                filtered_df=registered_trend_df,
                grain_results=registered_trend_grain_results,
                attention_site=primary_site,
                selection=selection,
                report_scope=registered_analysis_scope,
                output_path=str(all_sites_overview_path),
                config=config,
            )
        elif grains:
            build_selected_grain_sites_overview_v570(
                filtered_df=registered_trend_df,
                grain_result=registered_trend_grain_results[grains[0]],
                output_path=str(all_sites_overview_path),
                config=config,
            )

    finance_qa_chart_path = run_dir / "Finance_vs_Other_QA_Attributes.png"
    if config.enable_finance_qa_analysis and finance_qa_analyses:
        build_finance_qa_comparison_chart(
            analyses=finance_qa_analyses,
            output_path=str(finance_qa_chart_path),
            config=config,
        )

    chart_paths: Dict[str, str] = {
        "overall_dashboard": str(overall_dashboard_path)
    }
    if all_sites_overview_path.exists():
        chart_paths["all_sites_rolling_overview"] = str(all_sites_overview_path)
    if finance_qa_chart_path.exists():
        chart_paths["finance_qa_comparison"] = str(finance_qa_chart_path)
    chart_paths.update(
        generate_site_visuals(
            site_reports=site_reports,
            output_dir=run_dir,
            report_scope=analysis_report_scope,
            selection=selection,
            config=config,
        )
    )
    chart_paths.update(
        _overwrite_site_trend_dashboards_v567(
            site_reports=site_reports,
            registered_df=registered_trend_df,
            registered_grain_results=registered_trend_grain_results,
            registered_report_scope=registered_analysis_scope,
            selection=selection,
            config=config,
        )
    )

    monthly_anchor = (
        identify_monthly_anchor(
            document_grain_results.get("MONTHLY"),
            filter_rows_to_approved_sites(filtered_df, config),
            analysis_report_scope,
        )
        if "MONTHLY" in document_grain_results
        else None
    )

    email_payload: Dict[str, Any] = {}
    email_body_docx_path = ""
    if config.generate_email_body:
        email_payload = _selection_aware_email_payload_v570(
            selection=selection,
            report_scope=analysis_report_scope,
            grain_results=document_grain_results,
            primary_site=primary_site,
            focus_squads=focus_squads,
            monthly_anchor=monthly_anchor,
            qa_summary=document_qa_summary,
            scrubbed_tickets=document_scrubbed_tickets,
            config=config,
        )
        # v5.7.23: Do not generate or attach timeframe/timing images to the
        # FOR EMAIL ONLY document. The email doc keeps the executive summary only.
        if config.email_body_create_google_doc:
            email_docx_filename = (
                document_names["email_docx_filename"]
            )
            email_body_docx_path = build_email_body_docx(
                output_path=str(run_dir / email_docx_filename),
                payload=email_payload,
                config=config,
            )

    docx_filename = document_names["docx_filename"]
    docx_path = run_dir / docx_filename
    build_docx_report(
        selection=selection,
        report_scope=analysis_report_scope,
        grain_results=document_grain_results,
        primary_site=primary_site,
        primary_site_ranking=primary_site_ranking,
        focus_squads=focus_squads,
        monthly_anchor=monthly_anchor,
        site_reports=site_reports,
        qa_summary=document_qa_summary,
        scrubbed_tickets=document_scrubbed_tickets,
        dashboard_path=str(overall_dashboard_path),
        output_path=str(docx_path),
        all_sites_overview_path=str(all_sites_overview_path),
        finance_qa_analyses=finance_qa_analyses,
        finance_qa_scope_analyses=finance_qa_scope_analyses,
        finance_qa_chart_path=str(finance_qa_chart_path),
        config=config,
    )

    # Google Sheets writeback is useful for auditability, but it must not block
    # Google Docs generation or Shared Drive delivery. Any tab failure is logged as a warning.
    sheet_tabs: List[str] = []
    if config.write_google_sheets_outputs:
        try:
            sheet_tabs = write_executive_output_tabs(
                spreadsheet=spreadsheet,
                selection=selection,
                report_scope=analysis_report_scope,
                grain_results=document_grain_results,
                primary_site=primary_site,
                primary_site_ranking=primary_site_ranking,
                monthly_anchor=monthly_anchor,
                site_reports=site_reports,
                qa_summary=document_qa_summary,
                scrubbed_tickets=document_scrubbed_tickets,
                validation=source_validation or {},
                filter_summary=filter_summary,
                finance_qa_analyses=finance_qa_analyses,
                finance_qa_scope_analyses=finance_qa_scope_analyses,
                config=config,
            )
        except Exception as exc:
            warning = (
                "One or more Google Sheets output tabs could not be written. "
                f"The DOCX and Google Docs source were still created: {exc}"
            )
            LOGGER.exception(warning)
            warnings_list.append(warning)

    upload_result = {
        "google_doc_url": "",
        "drive_folder_url": "",
        "shared_drive_id": "",
        "chart_urls": {},
        "email_body_google_doc_url": "",
    }
    if config.upload_to_drive:
        try:
            upload_result = upload_report_artifacts(
                clients=clients,
                selection=selection,
                report_scope=analysis_report_scope,
                docx_path=str(docx_path),
                chart_paths=chart_paths,
                email_body_docx_path=email_body_docx_path,
                config=config,
            )
            for publish_warning in upload_result.get(
                "publish_warnings",
                [],
            ):
                if normalize_text(publish_warning):
                    warnings_list.append(
                        normalize_text(publish_warning)
                    )
        except Exception as exc:
            warning = (
                "Shared Drive destination could not be established after retries. "
                f"The local DOCX conversion source remains at {docx_path}: {exc}"
            )
            LOGGER.exception(warning)
            warnings_list.append(warning)

    artifacts = RunArtifacts(
        output_dir=str(run_dir),
        dashboard_path=str(overall_dashboard_path),
        all_sites_overview_path=str(all_sites_overview_path),
        docx_path=str(docx_path),
        finance_qa_chart_path=str(finance_qa_chart_path),
        google_doc_url=upload_result.get("google_doc_url", ""),
        drive_folder_url=upload_result.get("drive_folder_url", ""),
        shared_drive_id=upload_result.get("shared_drive_id", ""),
        chart_urls=upload_result.get("chart_urls", {}),
        email_body_docx_path=email_body_docx_path,
        email_body_google_doc_url=upload_result.get(
            "email_body_google_doc_url",
            "",
        ),
        sheet_tab_names=sheet_tabs,
    )

    if config.write_google_sheets_outputs:
        try:
            link_row = {
                "Generated At": now_manila().strftime("%Y-%m-%d %H:%M:%S %Z"),
                "Reporting Month": analysis_report_scope["report_label"],
                "LOB": selection.lob,
                "Detailed Sites": ", ".join(config.site_detail_sites),
                "Grain": selection.grain,
                "Data Through": pd.Timestamp(
                    analysis_report_scope["data_through"]
                ).strftime("%Y-%m-%d"),
                "Google Docs Report": (
                    f'=HYPERLINK("{artifacts.google_doc_url}","Open Google Docs")'
                    if artifacts.google_doc_url
                    else str(docx_path)
                ),
                "Shared Drive Folder": (
                    f'=HYPERLINK("{artifacts.drive_folder_url}","Open Shared Drive Folder")'
                    if artifacts.drive_folder_url
                    else str(run_dir)
                ),
                "Dashboard Image": (
                    f'=HYPERLINK("{artifacts.chart_urls.get("overall_dashboard", "")}",'
                    f'"Open Dashboard")'
