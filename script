_PII_TEXT_PATTERNS: Tuple[Tuple[str, str], ...] = (
    (
        r"(?i)\b[A-Z0-9._%+\-]+@[A-Z0-9.\-]+\.[A-Z]{2,}\b",
        "[EMAIL REDACTED]",
    ),
    (
        r"(?i)\b(?:https?://|www\.)\S+\b",
        "[URL REDACTED]",
    ),
    (
        r"(?<!\w)(?:\+?\d[\d\s().\-]{7,}\d)(?!\w)",
        "[PHONE/NUMBER REDACTED]",
    ),
    (
        r"\b(?:\d[ -]*?){13,19}\b",
        "[PAYMENT NUMBER REDACTED]",
    ),
    (
        r"\b\d{3}-\d{2}-\d{4}\b",
        "[GOVERNMENT ID REDACTED]",
    ),
    (
        r"(?i)\b(?:dob|date of birth|birthdate)\s*[:\-]?\s*"
        r"(?:\d{1,2}[\/\-]\d{1,2}[\/\-]\d{2,4}|"
        r"[A-Z][a-z]+\s+\d{1,2},?\s+\d{4})\b",
        "[DATE OF BIRTH REDACTED]",
    ),
    (
        r"\b(?:\d{1,3}\.){3}\d{1,3}\b",
        "[IP ADDRESS REDACTED]",
    ),
    (
        r"(?i)\b(?:account|order|invoice|store|merchant|case|ticket)"
        r"\s*(?:id|number|no\.?|#)?\s*[:\-#]?\s*[A-Z0-9][A-Z0-9\-]{4,}\b",
        "[REFERENCE ID REDACTED]",
    ),
    (
        r"(?i)\b\d{1,6}\s+[A-Z0-9][A-Z0-9 .'\-]{1,40}\s+"
        r"(?:street|st\.?|road|rd\.?|avenue|ave\.?|boulevard|blvd\.?|"
        r"lane|ln\.?|drive|dr\.?|court|ct\.?|way)\b",
        "[ADDRESS REDACTED]",
    ),
    (
        r"(?i)\b(?:zip|postal code)\s*[:\-]?\s*[A-Z0-9][A-Z0-9 \-]{2,9}\b",
        "[POSTAL CODE REDACTED]",
    ),
    (
        r"(?<!\w)@[A-Za-z0-9_]{2,}(?!\w)",
        "[SOCIAL HANDLE REDACTED]",
    ),
    (
        r"(?i)\b(?:my name is|merchant name|name)\s*[:\-]?\s*"
        r"[A-Z][A-Za-z'’-]+(?:\s+[A-Z][A-Za-z'’-]+){0,3}\b",
        "[NAME REDACTED]",
    ),
)


def validate_app_config(config: AppConfig = CONFIG) -> None:
    """Validate independent Smiley, QA, and privacy controls before processing."""
    for field_name, value in (
        ("target_rate", config.target_rate),
        ("qa_heatmap_target_rate", config.qa_heatmap_target_rate),
    ):
        if value is None or not 0 < float(value) <= 1:
            raise ValueError(
                f"{field_name} must be expressed as a decimal between 0 and 1. "
                f"Got: {value!r}"
            )

    # Smiley and QA have separate approved business targets.
    # Do not require equality between target_rate and qa_heatmap_target_rate.

    comment_policy = normalize_text(
        config.scrub_appendix_comment_policy
    ).upper()
    if comment_policy not in {"REMOVE", "REDACT"}:
        raise ValueError(
            "scrub_appendix_comment_policy must be REMOVE or REDACT. "
            f"Got: {config.scrub_appendix_comment_policy!r}"
        )

    date_granularity = normalize_text(
        config.scrub_appendix_date_granularity
    ).upper()
    if date_granularity not in {"DAY", "MONTH"}:
        raise ValueError(
            "scrub_appendix_date_granularity must be DAY or MONTH. "
            f"Got: {config.scrub_appendix_date_granularity!r}"
        )

    grace_days = int(config.latest_available_month_grace_days)
    if grace_days < 0 or grace_days > 15:
        raise ValueError(
            "latest_available_month_grace_days must be between 0 and 15. "
            f"Got: {config.latest_available_month_grace_days!r}"
        )

    if config.upload_to_drive and not normalize_text(config.drive_lob_folder_name):
        raise ValueError(
            "drive_lob_folder_name cannot be blank when Shared Drive publishing is enabled."
        )

    required_lob_site_keys = {"CORE", "PREMIUM", "RETAIL", "PLUS"}
    configured_lob_site_keys = {
        normalize_text(key).upper()
        for key in dict(config.site_detail_sites_by_lob)
    }
    missing_lob_site_keys = sorted(
        required_lob_site_keys - configured_lob_site_keys
    )
    if missing_lob_site_keys:
        raise ValueError(
            "site_detail_sites_by_lob is missing required LOB key(s): "
            + ", ".join(missing_lob_site_keys)
        )

    for lob_name in sorted(required_lob_site_keys):
        sites = resolve_site_detail_sites(lob_name, config)
        if len(sites) != len(set(sites)):
            raise ValueError(
                f"Duplicate detailed sites found for {lob_name}: {sites}"
            )

    if int(config.email_body_top_scrub_summaries) < 0:
        raise ValueError(
            "email_body_top_scrub_summaries must be zero or greater."
        )
    if config.generate_email_body and not normalize_text(
        config.email_body_subject_prefix
    ):
        raise ValueError(
            "email_body_subject_prefix cannot be blank when email output is enabled."
        )
    if (
        config.generate_email_body
        and config.email_body_create_google_doc
        and not normalize_text(config.email_body_google_doc_name_prefix)
    ):
        raise ValueError(
            "email_body_google_doc_name_prefix cannot be blank when the "
            "email Executive Summary Google Docs output is enabled."
        )

    if config.enable_finance_qa_analysis:
        if int(config.finance_qa_topic_min_responses) <= 0:
            raise ValueError(
                "finance_qa_topic_min_responses must be greater than zero."
            )
        if int(config.finance_qa_directional_min_responses) <= 0:
            raise ValueError(
                "finance_qa_directional_min_responses must be greater than zero."
            )
        if (
            int(config.finance_qa_directional_min_responses)
            > int(config.finance_qa_topic_min_responses)
        ):
            raise ValueError(
                "finance_qa_directional_min_responses cannot exceed "
                "finance_qa_topic_min_responses."
            )
        if int(config.finance_qa_min_attribute_audits) <= 0:
            raise ValueError(
                "finance_qa_min_attribute_audits must be greater than zero."
            )
        if (
            not config.finance_topic_exact_values
            and not config.finance_topic_keywords
        ):
            raise ValueError(
                "At least one Finance topic exact value or keyword is required."
            )


def _known_person_names(source_df: Optional[pd.DataFrame]) -> List[str]:
    """Collect known employee/SSA names for optional free-text redaction."""
    if source_df is None or not isinstance(source_df, pd.DataFrame):
        return []

    names: set[str] = set()
    for column in ("Employee Name", "SSA Name(s)", "Crafter"):
        if column not in source_df.columns:
            continue
        for raw_value in source_df[column].dropna().astype(str):
            for candidate in re.split(r"[,;/|]+", raw_value):
                normalized = normalize_text(candidate)
                if len(normalized) >= 3:
                    names.add(normalized)

    return sorted(names, key=len, reverse=True)


def redact_pii_text(
    value: Any,
    known_names: Optional[Sequence[str]] = None,
    redaction_token: str = "[REDACTED]",
) -> str:
    """
    Redact common PII patterns from text.

    This is a best-effort sanitizer. The default appendix policy removes free
    text entirely because regex-based detection cannot guarantee discovery of
    every possible personal name or contextual identifier.
    """
    text_value = normalize_text(value)
    if not text_value:
        return ""

    redacted = text_value
    for pattern, replacement in _PII_TEXT_PATTERNS:
        redacted = re.sub(pattern, replacement, redacted)

    for name in known_names or ():
        escaped = re.escape(normalize_text(name))
        if escaped:
            redacted = re.sub(
                rf"(?i)(?<!\w){escaped}(?!\w)",
                "[NAME REDACTED]",
                redacted,
            )

    # Redact any remaining unusually long numeric token that may represent an
    # internal account, order, phone, or merchant reference.
    redacted = re.sub(
        r"(?<!\w)[A-Z]*\d[A-Z0-9\-]{7,}(?!\w)",
        "[IDENTIFIER REDACTED]",
        redacted,
        flags=re.I,
    )

    redacted = re.sub(r"\s+", " ", redacted).strip()
    return redacted or redaction_token


def prepare_scrubbed_tickets_for_export(
    scrubbed_tickets: pd.DataFrame,
    source_df: Optional[pd.DataFrame] = None,
    config: AppConfig = CONFIG,
) -> pd.DataFrame:
    """
    Prepare the scrubbed-ticket appendix for Sheets and Google Docs.

    Approved privacy behavior:
    - Keep the original Ticket ID unchanged for operational backtracking.
    - Do not pseudonymize, hash, truncate, or replace Ticket IDs.
    - Apply PII redaction only to the Smiley Comment column.
    - Preserve structured business fields exactly as provided.
    - Employee/SSA fields are not part of the approved appendix schema and are
      therefore not exported, but they are not modified in the source DataFrame.
    """
    validate_app_config(config)

    if scrubbed_tickets is None or not isinstance(scrubbed_tickets, pd.DataFrame):
        return pd.DataFrame()

    safe = scrubbed_tickets.copy(deep=True)
    if safe.empty:
        return safe

    # Ticket ID must remain unchanged for traceability.
    if "Ticket ID" in safe.columns:
        safe["Ticket ID"] = safe["Ticket ID"].map(clean_ticket_id)

    known_names = _known_person_names(source_df)

    # PII redaction is intentionally limited to the free-text comment column.
    if "Smiley Comment" in safe.columns:
        if config.scrub_appendix_redact_pii:
            safe["Smiley Comment"] = safe["Smiley Comment"].map(
                lambda value: redact_pii_text(
                    value,
                    known_names=known_names,
                    redaction_token=config.scrub_appendix_redaction_token,
                )
            )
        else:
            LOGGER.warning(
                "Smiley Comment PII redaction is disabled. "
                "Ticket IDs will still be retained unchanged."
            )
            safe["Smiley Comment"] = safe["Smiley Comment"].map(normalize_text)

    if "Date" in safe.columns:
        parsed_dates = pd.to_datetime(safe["Date"], errors="coerce")
        if normalize_text(config.scrub_appendix_date_granularity).upper() == "MONTH":
            safe["Date"] = parsed_dates.dt.strftime("%Y-%m").fillna("")
        else:
            safe["Date"] = parsed_dates.dt.strftime("%Y-%m-%d").fillna("")

    if config.scrub_appendix_include_redaction_status:
        safe["PII Redaction Status"] = (
            "Ticket ID retained; PII redacted only in Smiley Comment"
            if config.scrub_appendix_redact_pii
            else "Ticket ID retained; Smiley Comment not redacted"
        )

    preferred_columns = [
        "Ticket ID",
        "Date",
        "Site",
        "Squad Code",
        "Smiley Rating",
        "Smiley Comment",
        "Level One",
        "Level Two",
        "Type of Audit",
        "QA Pass Rate",
        "Audited Attribute Count",
        "Passed Attribute Count",
        "Failed Attribute Count",
        "Failed Attributes",
        "Impact (Day)",
        "Impact (Week)",
        "Impact (Month)",
        "Priority Site",
        "Priority Squad",
        "PII Redaction Status",
    ]
    return safe[
        [column for column in preferred_columns if column in safe.columns]
    ].copy()


def qa_summary_for_squad(
    qa_summary: pd.DataFrame,
    site: str,
    squad: str,
) -> pd.DataFrame:
    required_columns = {"Site", "Squad Code", "Audited", "Failure Rate"}
    if (
        qa_summary is None
        or not isinstance(qa_summary, pd.DataFrame)
        or qa_summary.empty
        or not required_columns.issubset(qa_summary.columns)
    ):
        return pd.DataFrame()
    subset = qa_summary[
        qa_summary["Site"].eq(site)
        & qa_summary["Squad Code"].eq(squad)
        & pd.to_numeric(qa_summary["Audited"], errors="coerce").fillna(0).gt(0)
    ].copy()
    return subset.sort_values(
        ["Failure Rate", "Audited"],
        ascending=[False, False],
    )


def summarize_scrubbed_squad(
    scrubbed_tickets: pd.DataFrame,
    qa_summary: pd.DataFrame,
    site: str,
    squad: str,
) -> str:
    required_ticket_columns = {"Site", "Squad Code"}
    if (
        scrubbed_tickets is None
        or not isinstance(scrubbed_tickets, pd.DataFrame)
        or scrubbed_tickets.empty
        or not required_ticket_columns.issubset(scrubbed_tickets.columns)
    ):
        return (
            f"{squad}: no qualifying audited non-smiley or failed-attribute "
            "tickets were found in the selected reporting scope."
        )

    tickets = scrubbed_tickets[
        scrubbed_tickets["Site"].eq(site)
        & scrubbed_tickets["Squad Code"].eq(squad)
    ].copy()
    if tickets.empty:
        return (
            f"{squad}: no qualifying audited non-smiley or failed-attribute "
            "tickets were found in the selected reporting scope."
        )

    attribute_summary = qa_summary_for_squad(qa_summary, site, squad)
    top_failures = attribute_summary.head(2)
    failure_texts = []
    for _, row in top_failures.iterrows():
        qa_attribute = normalize_text(row.get("QA Attribute", ""))
        failure_rate = pd.to_numeric(
            pd.Series([row.get("Failure Rate")]),
            errors="coerce",
        ).iloc[0]
        if qa_attribute and pd.notna(failure_rate):
            failure_texts.append(
                f"{qa_attribute} at {format_rate(failure_rate, 1)}"
            )

    failed_attribute_count = (
        pd.to_numeric(
            tickets.get(
                "Failed Attribute Count",
                pd.Series(0, index=tickets.index),
            ),
            errors="coerce",
        )
        .fillna(0)
    )
    multi_fail_count = int(failed_attribute_count.ge(2).sum())

    level_one_series = tickets.get(
        "Level One",
        pd.Series("", index=tickets.index, dtype="object"),
    )
    level_one = (
        level_one_series.fillna("")
        .astype(str)
        .replace("", np.nan)
        .dropna()
        .value_counts()
        .head(1)
    )
    taxonomy_text = (
        f" Dominant Level One taxonomy: {level_one.index[0]}."
        if not level_one.empty
        else ""
    )
    failure_sentence = (
        " Most frequent failures: " + ", ".join(failure_texts) + "."
        if failure_texts
        else ""
    )

    return (
        f"{squad}: {len(tickets):,} qualifying audited tickets reviewed; "
        f"{multi_fail_count:,} failed two or more QA attributes."
        f"{failure_sentence}{taxonomy_text}"
    )



