def _docx_add_overall_scope_v541(
    document: Document,
    selection: ReportSelection,
    report_scope: Mapping[str, Any],
    grain_results: Mapping[str, GrainResult],
    primary_site: str,
    focus_squads: Sequence[str],
    qa_summary: pd.DataFrame,
    scrubbed_tickets: pd.DataFrame,
    dashboard_path: str,
    all_sites_overview_path: str,
    site_reports: Optional[Mapping[str, SiteReport]] = None,
    finance_scope_analysis: Optional[FinanceQAScopeAnalysis] = None,
    finance_qa_analyses: Optional[Mapping[str, FinanceQAGrainAnalysis]] = None,
    finance_qa_chart_path: str = "",
    config: AppConfig = CONFIG,
) -> None:
    """v5.7.72 Overall chapter renderer with added AFTR/AHT/Async/Driver impact sections."""
    runtime_config = (
        config
        if _monthly_teammate_coaching_enabled_v557(selection=selection, config=config)
        else _config_without_teammate_coaching_v557(config)
    )

    document.add_page_break()
    document.add_heading(
        "OVERALL — Complete Scope Readout",
        level=1,
    )

    document.add_heading("Executive Summary", level=2)
    for grain in ["DAILY", "WEEKLY", "MONTHLY"]:
        result = grain_results.get(grain)
        if result is not None:
            add_bullet(
                document,
                _v572_doc_text(executive_summary_line(result.overall)),
            )

    note = document.add_paragraph()
    note.add_run("Executive rollup method: ").bold = True
    note.add_run(
        "SUM positive responses ÷ SUM rated responses across all sites that "
        "pass the selected LOB/business filters. Grain-sensitive sections "
        f"use {selection.grain} as the report-wide analysis mode."
    )

    if dashboard_path and Path(dashboard_path).exists():
        document.add_heading(
            "Overall Executive Trend Dashboard",
            level=2,
        )
        paragraph = document.add_paragraph()
        paragraph.alignment = WD_ALIGN_PARAGRAPH.CENTER
        paragraph.add_run().add_picture(
            dashboard_path,
            width=Inches(runtime_config.docx_chart_width_inches),
        )

    if (
        all_sites_overview_path
        and Path(all_sites_overview_path).exists()
    ):
        document.add_heading(
            "Site Performance vs Overall Performance with Volume",
            level=2,
        )
        paragraph = document.add_paragraph()
        paragraph.alignment = WD_ALIGN_PARAGRAPH.CENTER
        paragraph.add_run().add_picture(
            all_sites_overview_path,
            width=Inches(runtime_config.docx_chart_width_inches),
        )

    _docx_add_ticket_age_impact_v548(
        document=document,
        impact_df=_overall_ticket_age_impact_v548(
            report_scope=report_scope,
            config=runtime_config,
        ),
        scope_name="Overall",
        config=runtime_config,
        heading_level=2,
    )

    _docx_add_qa_attribute_impact_v549(
        document=document,
        impact_df=_overall_qa_attribute_impact_v549(
            report_scope=report_scope,
            config=runtime_config,
        ),
        scope_name="Overall",
        config=runtime_config,
        heading_level=2,
    )

    _docx_v572_add_extended_impact_sections(
        document=document,
        scope_name="Overall",
        selection=selection,
        grain_results=grain_results,
        site_specific=False,
        heading_level=2,
        config=runtime_config,
    )

    _docx_add_overall_teammate_coaching_consolidated_v546(
        document=document,
        site_reports=site_reports,
        config=runtime_config,
    )

    document.add_heading(
        "Performance, Drivers, and Recommended Actions",
        level=2,
    )
    for grain in ["DAILY", "WEEKLY", "MONTHLY"]:
        result = grain_results.get(grain)
        if result is None:
            continue
        narrative = build_overall_grain_driver_narrative(
            result,
            report_scope,
            runtime_config,
        )
        _docx_add_driver_section(
            document,
            narrative,
            heading_level=3,
        )

    for squad_grain in _active_grains_v570(selection):
        grain_result = grain_results.get(squad_grain)
        if grain_result is None:
            continue

        overall_squad_table = getattr(
            grain_result,
            "squad_response_mix_v531",
            pd.DataFrame(),
        )
        overall_squad_rows = _squad_response_mix_rows_v531(
            overall_squad_table,
            runtime_config,
            focus_squads=focus_squads,
        )
        if not overall_squad_rows:
            continue

        document.add_heading(
            (
                "Performance by Squad — Response Mix "
                f"({squad_grain.title()})"
            ),
            level=2,
        )
        _docx_add_squad_narrative_callout_v532(
            document,
            _v572_doc_text(
                _squad_response_mix_narrative_v531(
                    squad_df=overall_squad_table,
                    grain=squad_grain,
                    period_label=getattr(grain_result.overall, "period_label", ""),
                    scope_name="Overall",
                    focus_squads=focus_squads,
                    config=runtime_config,
                )
            ),
        )
        _docx_add_squad_response_mix_table_v531(
            document,
            rows=overall_squad_rows,
            grain=squad_grain,
            font_size=5.2,
        )

    if focus_squads:
        document.add_heading(
            "Focus-Squad QA Scrub Summary",
            level=2,
        )
        for squad in focus_squads[
            : runtime_config.underperforming_squad_limit
        ]:
            add_bullet(
                document,
                _v572_doc_text(
                    summarize_scrubbed_squad(
                        scrubbed_tickets=scrubbed_tickets,
                        qa_summary=qa_summary,
                        site=primary_site,
                        squad=squad,
                    )
                ),
            )

    if finance_scope_analysis is not None:
        _docx_add_finance_scope_v52(
            document=document,
            scope_analysis=finance_scope_analysis,
            chart_path=finance_qa_chart_path,
            config=runtime_config,
            grouped=True,
        )
    elif (
        runtime_config.enable_finance_qa_analysis
        and finance_qa_analyses
    ):
        _docx_add_finance_qa_section(
            document=document,
            analyses=finance_qa_analyses,
            chart_path=finance_qa_chart_path,
            config=runtime_config,
        )


def _docx_add_site_scope_v541(
    document: Document,
    site: str,
    site_report: SiteReport,
    selection: ReportSelection,
    report_scope: Mapping[str, Any],
    qa_summary: pd.DataFrame,
    scrubbed_tickets: pd.DataFrame,
    finance_scope_analysis: Optional[FinanceQAScopeAnalysis],
    focus_squads: Optional[Sequence[str]] = None,
    config: AppConfig = CONFIG,
) -> None:
    """
    v5.7.72 site chapter renderer.

    Keeps all site charts/graphs and existing evidence tables, converts the site
    summary to paragraph bullets, and adds site-specific AFTR/AHT/Async/Driver
    impact proof tables filtered only to that site.
    """
    runtime_config = (
        config
        if _monthly_teammate_coaching_enabled_v557(selection=selection, config=config)
        else _config_without_teammate_coaching_v557(config)
    )

    document.add_page_break()
    document.add_heading(
        f"{site} — Complete Scope Readout",
        level=1,
    )

    document.add_heading("Executive Summary", level=2)
    for line in build_site_summary_text(site_report):
        add_bullet(document, _v572_doc_text(line))

    site_grain_results_for_v572: Dict[str, GrainResult] = {}
    if getattr(runtime_config, "main_summary_add_driver_overview", True):
        try:
            site_payload = _docx_v571_build_site_summary_payload(
                site=site,
                site_report=site_report,
                selection=selection,
                report_scope=report_scope,
                grain_results=globals().get("_CURRENT_GRAIN_RESULTS_FOR_SITE_SUMMARY_V571", {}),
                config=runtime_config,
            )
            if site_payload.get("detailed_readouts"):
                _docx_v570_add_main_summary_driver_overview(
                    document=document,
                    payload=site_payload,
                    config=runtime_config,
                )
            site_grain_results_for_v572 = _docx_v571_build_site_grain_results(
                site=site,
                site_report=site_report,
                selection=selection,
                report_scope=report_scope,
                grain_results=globals().get("_CURRENT_GRAIN_RESULTS_FOR_SITE_SUMMARY_V571", {}),
                config=runtime_config,
            )
        except Exception as exc:
            LOGGER.warning(
                "%s Executive Signal & Driver Summary could not be generated; continuing site report: %s",
                site,
                exc,
            )
            site_grain_results_for_v572 = {}
    else:
        try:
            site_grain_results_for_v572 = _docx_v571_build_site_grain_results(
                site=site,
                site_report=site_report,
                selection=selection,
                report_scope=report_scope,
                grain_results=globals().get("_CURRENT_GRAIN_RESULTS_FOR_SITE_SUMMARY_V571", {}),
                config=runtime_config,
            )
        except Exception:
            site_grain_results_for_v572 = {}

    document.add_heading(
        "Performance, Drivers, and Recommended Actions",
        level=2,
    )
    for grain in ["DAILY", "WEEKLY", "MONTHLY"]:
        if grain not in site_report.grain_metrics:
            continue
        narrative = build_site_grain_narrative(
            site_report,
            grain,
            report_scope,
            runtime_config,
        )
        _docx_add_driver_section(
            document,
            narrative,
            heading_level=3,
        )

    document.add_heading("Supporting Site Evidence", level=2)
    rows = site_summary_table_rows(site_report)
    if rows:
        add_executive_table(
            document,
            headers=[
                "Grain",
                "Actual",
                "Baseline",
                "Delta",
                "Responses",
                "Projection",
                "Sample",
            ],
            rows=rows,
            font_size=7.8,
        )

    _docx_add_ticket_age_impact_v548(
        document=document,
        impact_df=getattr(site_report, "ticket_age_impact_v548", pd.DataFrame()),
        scope_name=site,
        config=runtime_config,
        heading_level=2,
    )

    _docx_add_qa_attribute_impact_v549(
        document=document,
        impact_df=getattr(site_report, "qa_attribute_impact_v549", pd.DataFrame()),
        scope_name=site,
        config=runtime_config,
        heading_level=2,
    )

    if site_grain_results_for_v572:
        _docx_v572_add_extended_impact_sections(
            document=document,
            scope_name=normalize_text(site),
            selection=selection,
            grain_results=site_grain_results_for_v572,
            site_specific=True,
            heading_level=2,
            config=runtime_config,
        )

    squad_visuals = getattr(
        site_report,
        "squad_chart_paths_v570",
        {},
    )
    visual_paths = [site_report.dashboard_path]
    visual_paths.extend(
        [
            squad_visuals.get(grain, "")
            for grain in _active_grains_v570(selection)
        ]
    )
    visual_paths.append(site_report.qa_heatmap_path)

    for visual_path in list(dict.fromkeys(visual_paths)):
        if visual_path and Path(visual_path).exists():
            paragraph = document.add_paragraph()
            paragraph.alignment = WD_ALIGN_PARAGRAPH.CENTER
            paragraph.add_run().add_picture(
                visual_path,
                width=Inches(
                    runtime_config.docx_site_chart_width_inches
                ),
            )

    squad_response_mix_tables = getattr(
        site_report,
        "squad_response_mix_tables_v531",
        {},
    )
    for squad_grain in _active_grains_v570(selection):
        squad_table = squad_response_mix_tables.get(
            squad_grain,
            pd.DataFrame(),
        )
        squad_rows = _squad_response_mix_rows_v531(
            squad_table,
            runtime_config,
            focus_squads=focus_squads,
        )
        if not squad_rows:
            continue

        document.add_heading(
            (
                "Performance by Squad — Response Mix "
                f"({squad_grain.title()})"
            ),
            level=2,
        )
        _docx_add_squad_narrative_callout_v532(
            document,
            _v572_doc_text(
                _squad_response_mix_narrative_v531(
                    squad_df=squad_table,
                    grain=squad_grain,
                    period_label=normalize_text(
                        site_report.grain_metrics.get(squad_grain).period_label
                        if site_report.grain_metrics.get(squad_grain) is not None
                        else ""
                    ),
                    scope_name=site,
                    focus_squads=focus_squads,
                    config=runtime_config,
                )
            ),
        )
        _docx_add_squad_response_mix_table_v531(
            document,
            rows=squad_rows,
            grain=squad_grain,
            font_size=5.2,
        )

    if getattr(runtime_config, "enable_teammate_coaching_opportunities", True):
        teammate_opportunities_v540 = getattr(
            site_report,
            "teammate_coaching_opportunities_v540",
            pd.DataFrame(),
        )
        teammate_rows_v540 = _teammate_coaching_rows_v540(
            teammate_opportunities_v540,
            runtime_config,
        )
        show_empty_teammate_callout_v542 = bool(
            getattr(runtime_config, "teammate_coaching_show_no_result_callout", True)
        )
        if teammate_rows_v540 or show_empty_teammate_callout_v542:
            document.add_heading(
                TEAMMATE_COACHING_SECTION_TITLE_V540,
                level=2,
            )
            _docx_add_squad_narrative_callout_v532(
                document,
                _v572_doc_text(
                    _teammate_coaching_narrative_v540(
                        site=site,
                        opportunity_df=teammate_opportunities_v540,
                        config=runtime_config,
                    )
                ),
                font_size=7.0,
            )
            if teammate_rows_v540:
                _docx_add_teammate_coaching_table_v540(
