    teammate_df: pd.DataFrame,
    config: AppConfig = CONFIG,
) -> List[Dict[str, Any]]:
    """
    v5.7.62 driver readout.

    Teammate Coaching Opportunities appears only for Monthly and only as the
    consolidated narrative. Daily and Weekly omit teammate coaching completely.
    """
    paragraphs: List[Dict[str, Any]] = [
        {"level": 0, "segments": _email_v551_site_segments(grain_result, metric, config=config)},
        {"level": 0, "segments": _email_v551_ticket_age_segments(source_df, "Overall", metric, config=config)},
        {"level": 0, "segments": _email_v551_taxonomy_segments(source_df, metric)},
        {"level": 0, "segments": _email_v551_tenure_segments(source_df, metric)},
    ]

    paragraphs.extend(
        _email_v558_squad_smiley_with_qa_paragraphs(
            grain_result=grain_result,
            source_df=source_df,
            config=config,
            limit=3,
        )
    )

    grain_key = normalize_text(grain).upper()
    if grain_key == "MONTHLY":
        teammate_segments = _email_v562_teammate_consolidated_segments(
            teammate_df,
