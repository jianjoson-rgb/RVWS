def immediate_period_action(
    grain_results: Mapping[str, GrainResult],
    primary_site: str,
    focus_squads: Sequence[str],
    report_scope: Mapping[str, Any],
) -> Tuple[str, str]:
    monthly = grain_results.get("MONTHLY")
    weekly = grain_results.get("WEEKLY")

    if monthly and monthly.overall.is_incomplete:
        metric = monthly.overall
        title = "Final Push for Month-End"
        squad_text = ", ".join(focus_squads[:4]) or "the lowest-performing squads"
        body = (
            f"With {metric.remaining_days} calendar days remaining in "
            f"{report_scope['reference_month_start'].strftime('%B')}, the month "
            f"is projected to close at {format_rate(metric.projected_rate)} across "
            f"approximately {format_int(metric.projected_responses)} responses. "
            f"Immediate Action: concentrate operational support on {primary_site}, "
            f"especially squads {squad_text}, to minimize further score dilution "
            "and close the gap to baseline and target."
        )
        return title, body

    if weekly and weekly.overall.is_incomplete:
        metric = weekly.overall
        title = "Final Push for Week-End"
        squad_text = ", ".join(focus_squads[:4]) or "the lowest-performing squads"
        body = (
            f"With {metric.remaining_days} reporting days remaining, the selected "
            f"week window is projected to close at {format_rate(metric.projected_rate)} "
            f"across approximately {format_int(metric.projected_responses)} responses. "
            f"Immediate Action: prioritize {primary_site} and squads {squad_text}."
        )
        return title, body

    title = "Period Closing Assessment"
    latest_metric = (
        monthly.overall
        if monthly is not None
        else weekly.overall
        if weekly is not None
        else next(iter(grain_results.values())).overall
    )
    body = (
        f"The selected period closed at {format_rate(latest_metric.actual_rate)}, "
        f"{movement_phrase(latest_metric.delta)} versus baseline. Carry forward "
        f"focused recovery actions for {primary_site} and maintain the practices "
        "demonstrated by the top positive-contributing sites and squads."
    )
    return title, body


def build_site_summary_text(
    site_report: SiteReport,
) -> List[str]:
    """Return VP-style Daily, Weekly, and Monthly trend lines for one site."""
    lines: List[str] = []
    for grain in ["DAILY", "WEEKLY", "MONTHLY"]:
        metric = site_report.grain_metrics.get(grain)
        if metric is None:
            continue
        lines.append(executive_summary_line(metric))
    return lines


def site_representative_grain(site_report: SiteReport) -> str:
    """Return the preferred grain for site driver narratives."""
    for grain in ("MONTHLY", "WEEKLY", "DAILY"):
        if grain in site_report.grain_metrics:
            return grain
    return next(iter(site_report.grain_metrics), "MONTHLY")


def _valid_driver_rows(
    table: pd.DataFrame,
    dimension_column: str,
    direction: str,
    minimum_responses: int = 1,
) -> pd.DataFrame:
    """Filter a driver table for positive or negative narrative candidates."""
    if (
        table is None
        or not isinstance(table, pd.DataFrame)
        or table.empty
        or dimension_column not in table.columns
    ):
        return pd.DataFrame()

    work = table.copy()
    work["Official Impact"] = pd.to_numeric(
        work.get("Official Impact"),
        errors="coerce",
    )
    work["Current Responses"] = pd.to_numeric(
        work.get("Current Responses"),
        errors="coerce",
    ).fillna(0)
    work[dimension_column] = (
        work[dimension_column]
        .fillna("")
        .astype(str)
        .str.replace(r"\s+", " ", regex=True)
        .str.strip()
    )
    work = work[
        work[dimension_column].ne("")
        & work["Current Responses"].ge(max(1, int(minimum_responses)))
        & work["Official Impact"].notna()
    ]

    if direction.lower() == "positive":
        work = work[work["Official Impact"].gt(0)].sort_values(
            ["Official Impact", "Current Responses"],
            ascending=[False, False],
        )
    else:
        work = work[work["Official Impact"].lt(0)].sort_values(
            ["Official Impact", "Current Responses"],
            ascending=[True, False],
        )
    return work.reset_index(drop=True)


def _driver_names(
    table: pd.DataFrame,
    dimension_column: str,
    direction: str,
    limit: int,
    minimum_responses: int = 1,
) -> List[str]:
    rows = _valid_driver_rows(
        table=table,
        dimension_column=dimension_column,
        direction=direction,
        minimum_responses=minimum_responses,
    ).head(max(0, int(limit)))
    if rows.empty:
        return []
    return rows[dimension_column].astype(str).tolist()


def _format_driver_entry(
    row: pd.Series,
    dimension_column: str,
    include_taxonomy: bool = False,
) -> str:
    name = normalize_text(row.get(dimension_column, ""))
    impact = format_pp(row.get("Official Impact"))
    delta = format_pp(row.get("Delta vs Baseline"))
    rate = format_rate(row.get("Current Rate"))
    volume = format_int(row.get("Current Responses"))
    entry = (
        f"{name} (Impact {impact}, Delta {delta}, "
        f"Rate {rate}, Vol {volume})"
    )
    taxonomy = normalize_text(row.get("Main Level One", ""))
    if include_taxonomy and taxonomy:
        entry += f", primarily {taxonomy}"
    return entry


def _driver_list_text(
    table: pd.DataFrame,
    dimension_column: str,
    direction: str,
    limit: int,
    minimum_responses: int = 1,
    include_taxonomy: bool = False,
) -> str:
    rows = _valid_driver_rows(
        table=table,
        dimension_column=dimension_column,
        direction=direction,
        minimum_responses=minimum_responses,
    ).head(max(0, int(limit)))
    if rows.empty:
        return "No qualifying driver identified"
    return "; ".join(
        _format_driver_entry(
            row,
            dimension_column=dimension_column,
            include_taxonomy=include_taxonomy,
        )
        for _, row in rows.iterrows()
    )


def _site_qa_failure_text(
    site_report: SiteReport,
    focus_squads: Sequence[str],
    limit: int = 3,
) -> str:
    qa = site_report.qa_summary
    if qa is None or qa.empty:
        return "No audited QA attribute results were available."

    work = qa.copy()
    if focus_squads:
        work = work[work["Squad Code"].isin(list(focus_squads))]
    work = work[pd.to_numeric(work["Audited"], errors="coerce").fillna(0).gt(0)]
    if work.empty:
        return "No audited QA attribute results were available for the focus squads."

    grouped = (
        work.groupby("QA Attribute", dropna=False)
        .agg(
            Audited=("Audited", "sum"),
            Failed=("Failed", "sum"),
        )
        .reset_index()
    )
    grouped["Failure Rate"] = np.where(
        grouped["Audited"].gt(0),
        grouped["Failed"] / grouped["Audited"],
        np.nan,
    )
    grouped = grouped.sort_values(
        ["Failure Rate", "Audited"],
        ascending=[False, False],
    ).head(max(1, int(limit)))

    parts = [
        f"{normalize_text(row['QA Attribute'])} "
        f"({format_rate(row['Failure Rate'], 1)} failure rate; "
        f"{format_int(row['Audited'])} audited)"
        for _, row in grouped.iterrows()
        if pd.notna(row.get("Failure Rate"))
    ]
    if not parts:
        return "No audited QA failures were available for the focus squads."
    return "Most frequent QA failures: " + ", ".join(parts) + "."


def _month_end_smileys_needed(
    metric: Optional[PeriodMetric],
    target_rate: float,
) -> int:
    if metric is None:
        return 0

    if metric.is_incomplete and pd.notna(metric.projected_responses):
        responses = float(metric.projected_responses)
        positive = (
            float(metric.projected_positive)
            if pd.notna(metric.projected_positive)
            else float(metric.actual_positive)
        )
    else:
        responses = float(metric.actual_responses)
        positive = float(metric.actual_positive)

    if not np.isfinite(responses) or responses <= 0:
        return 0
    if not np.isfinite(positive):
        positive = 0.0
    return max(int(math.ceil(target_rate * responses - positive)), 0)


def build_site_executive_narrative(
    site_report: SiteReport,
    report_scope: Mapping[str, Any],
    config: AppConfig = CONFIG,
) -> Dict[str, Any]:
    """
    Build the site-level equivalent of the overall VP Executive Summary.

    Structure:
      1. Squad Focus
      2. High-Performing Squads
      3. Final Push for Month-End / Period Closing Assessment
      + What Went Well, What Went Wrong, and Priority Focus Cohorts
    """
    site = site_report.site
    grain = site_representative_grain(site_report)
    tables = site_report.driver_tables.get(grain, {})

    squad_table = tables.get("Squad", pd.DataFrame())
    tenure_table = tables.get("Agent Tenure", pd.DataFrame())
    crafter_table = tables.get("Crafter", pd.DataFrame())
    level_one_table = tables.get("Level One", pd.DataFrame())

    negative_squad_rows = _valid_driver_rows(
        squad_table,
        "Squad Code",
        "negative",
        minimum_responses=config.site_narrative_min_squad_responses,
    ).head(config.site_narrative_negative_squads)
    positive_squad_rows = _valid_driver_rows(
        squad_table,
        "Squad Code",
        "positive",
        minimum_responses=config.site_narrative_min_squad_responses,
    ).head(config.site_narrative_positive_squads)

    negative_squads = (
        negative_squad_rows["Squad Code"].astype(str).tolist()
        if not negative_squad_rows.empty
        else []
    )
    positive_squads = (
        positive_squad_rows["Squad Code"].astype(str).tolist()
        if not positive_squad_rows.empty
        else []
    )

    negative_tenures = _driver_names(
        tenure_table,
        "Agent Tenure",
        "negative",
        config.site_narrative_tenures,
    )
    positive_tenures = _driver_names(
        tenure_table,
        "Agent Tenure",
        "positive",
        config.site_narrative_tenures,
    )
    negative_crafters = _driver_names(
        crafter_table,
        "Crafter",
        "negative",
        config.site_narrative_crafters,
        minimum_responses=config.site_narrative_min_crafter_responses,
    )
    positive_crafters = _driver_names(
        crafter_table,
        "Crafter",
        "positive",
        config.site_narrative_crafters,
        minimum_responses=config.site_narrative_min_crafter_responses,
    )
    negative_taxonomies = _driver_names(
        level_one_table,
        "Level One",
        "negative",
        config.site_narrative_taxonomies,
    )
    positive_taxonomies = _driver_names(
        level_one_table,
        "Level One",
        "positive",
        config.site_narrative_taxonomies,
    )

    if not negative_squad_rows.empty:
        primary_negative = negative_squad_rows.iloc[0]
        primary_negative_name = normalize_text(
            primary_negative.get("Squad Code", "")
        )
        squad_focus_title = (
            f"1. Squad Focus: {primary_negative_name} "
            f"(Primary Drag Within {site})"
        )
        supporting_negative = [
            normalize_text(value)
            for value in negative_squads[1:]
            if normalize_text(value)
        ]
        supporting_text = (
            f" Supporting negative squads are {', '.join(supporting_negative)}."
            if supporting_negative
            else ""
        )
        taxonomy = normalize_text(primary_negative.get("Main Level One", ""))
        taxonomy_text = (
            f" Its dominant Level One driver is {taxonomy}."
            if taxonomy
            else ""
        )
        squad_focus_body = (
            f"{primary_negative_name} is the largest negative squad-level driver "
            f"for {site} in the {grain.title()} view, recording "
            f"{format_rate(primary_negative.get('Current Rate'))} across "
            f"{format_int(primary_negative.get('Current Responses'))} responses. "
            f"It is {format_pp(primary_negative.get('Delta vs Baseline'))} versus "
            f"its comparison baseline and contributes an estimated "
            f"{format_pp(primary_negative.get('Official Impact'))} to the site's "
            f"movement.{supporting_text}{taxonomy_text}"
        )
    else:
        primary_negative_name = ""
        squad_focus_title = f"1. Squad Focus: No Negative Squad Identified Within {site}"
        squad_focus_body = (
            f"No squad generated a negative estimated impact in the selected "
            f"{grain.title()} view for {site}. Continue monitoring low-volume "
