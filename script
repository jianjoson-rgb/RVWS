) -> List[Dict[str, Any]]:
    """Return current performance as separate copy/paste-friendly bullets."""
    grain_key = normalize_text(metric.grain).upper()
    grain_title = grain_key.title()
    baseline_label = _email_v551_baseline_label(metric)
    previous_delta = _email_v551_num(getattr(metric, "previous_delta", np.nan))
    previous_label = normalize_text(getattr(metric, "previous_period_label", "prior comparable period")) or "prior comparable period"
    volume_change = _email_v551_num(getattr(metric, "volume_change_pct", np.nan))
    volume_phrase = (
        "stayed stable"
        if pd.isna(volume_change) or abs(volume_change) < 0.0005
        else ("increased" if volume_change > 0 else "decreased")
    )

    state_word = "closed at" if grain_key == "DAILY" else "is tracking at"
    movement_word = (
        "held steady"
        if pd.isna(previous_delta) or abs(previous_delta) < 0.0005
        else ("improved" if previous_delta > 0 else "regressed")
    )

    return [
        {
            "level": 0,
            "segments": [
                _email_v551_seg(f"{grain_title} Smiley Rate {state_word} "),
                _email_v551_seg(
