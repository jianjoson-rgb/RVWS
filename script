def _email_v565_active_grains(
    selection: ReportSelection,
    grain_results: Mapping[str, GrainResult],
) -> List[str]:
    active = [
        normalize_text(grain).upper()
        for grain in _active_grains_v570(selection)
        if normalize_text(grain).upper() in grain_results
    ]
    if not active:
        active = [normalize_text(grain).upper() for grain in grain_results.keys()]
    return [grain for grain in ["DAILY", "WEEKLY", "MONTHLY"] if grain in set(active)] or active


def _email_v565_overall_signal_status(grain_results: Mapping[str, GrainResult], active: Sequence[str]) -> str:
    deltas = [
        _email_v551_num(getattr(grain_results[grain].overall, "delta", np.nan))
        for grain in active
        if grain in grain_results and getattr(grain_results[grain], "overall", None) is not None
    ]
    deltas = [delta for delta in deltas if pd.notna(delta)]
    if not deltas:
        return "Mixed"
    threshold = 0.0005
    if all(delta > threshold for delta in deltas):
        return "Improved"
    if all(delta < -threshold for delta in deltas):
        return "Declined"
    if all(abs(delta) <= threshold for delta in deltas):
        return "Held Steady"
    return "Mixed"


def _email_v565_sharpest_grain(
    grain_results: Mapping[str, GrainResult],
    active: Sequence[str],
) -> str:
    ranked: List[Tuple[float, str]] = []
    for grain in active:
        if grain not in grain_results:
            continue
        metric = getattr(grain_results[grain], "overall", None)
        if metric is None:
            continue
        delta = _email_v551_num(getattr(metric, "delta", np.nan))
        if pd.notna(delta):
            ranked.append((abs(delta), grain))
    if not ranked:
        return active[0] if active else ""
    return sorted(ranked, reverse=True)[0][1]


def _email_v565_subject(
    selection: ReportSelection,
    report_scope: Mapping[str, Any],
    grain_results: Mapping[str, GrainResult],
    active: Sequence[str],
    primary_site: str,
) -> str:
    signal = _email_v565_overall_signal_status(grain_results, active)
    report_date = pd.Timestamp(report_scope.get("data_through", now_manila())).strftime("%Y-%m-%d")
    attention = normalize_text(primary_site)
