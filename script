    }
    payload["plain_text"] = _email_plain_text_from_payload(payload)
    payload["html"] = _email_html_from_payload(payload)
    return payload


def _attach_previous_table_metrics_v570(
    frame: pd.DataFrame,
    previous_metrics: pd.DataFrame,
    key_column: str,
) -> pd.DataFrame:
    """Attach previous Smiley/Unhappy table metrics using Table Previous * names."""
    if frame is None:
        frame = pd.DataFrame()
    output = frame.copy()
    if output.empty or key_column not in output.columns:
        return output
    if (
        previous_metrics is None
        or previous_metrics.empty
        or key_column not in previous_metrics.columns
    ):
        return output

    rename_map = {
        column: column.replace("Table ", "Table Previous ", 1)
        for column in previous_metrics.columns
        if column.startswith("Table ")
    }
    prior = previous_metrics.rename(columns=rename_map)
    prior_columns = [key_column] + list(rename_map.values())

    output = output.drop(
        columns=[
            column
            for column in output.columns
            if column.startswith("Table Previous ")
        ],
        errors="ignore",
    )
    return output.merge(
        prior[prior_columns],
        on=key_column,
        how="left",
        sort=False,
    )


def _segment_registered_population_v570(
    frame: pd.DataFrame,
    config: AppConfig = CONFIG,
) -> Dict[str, pd.DataFrame]:
    """Assign Smiley Registered At rows to all executive timing dimensions."""
    work = frame.copy()
    ts = pd.to_datetime(
        work.get(
            "_Smiley Registered Timestamp",
            pd.Series(pd.NaT, index=work.index),
        ),
        errors="coerce",
    )

    hours = ts.dt.hour
    time_labels = pd.Series("", index=work.index, dtype="object")
    display_time_order: List[str] = []
    for start_hour, end_hour, original_label in config.finance_qa_time_buckets_utc:
        clean_label = re.sub(
            r"^\s*UTC\s+",
            "",
            normalize_text(original_label),
            flags=re.IGNORECASE,
        )
        time_labels.loc[
            hours.between(start_hour, end_hour)
        ] = original_label
        display_time_order.append(original_label)
    work["UTC Time Block"] = time_labels

    work["UTC Day of Week"] = ts.dt.day_name()
    day = ts.dt.day
    part = pd.Series("", index=work.index, dtype="object")
    part.loc[day.between(1, 10)] = "Early (1-10)"
    part.loc[day.between(11, 20)] = "Middle (11-20)"
    part.loc[day.between(21, 31)] = "Late (21-31)"
    work["Part of Month"] = part

    return {
        "frame": work,
        "time_order": display_time_order,
        "dow_order": [
            "Monday",
            "Tuesday",
            "Wednesday",
            "Thursday",
            "Friday",
            "Saturday",
            "Sunday",
        ],
        "dom_order": [
            "Early (1-10)",
            "Middle (11-20)",
            "Late (21-31)",
        ],
    }


def _align_timeframe_tables_to_smiley_registered_v570(
    scope_analyses: Mapping[str, FinanceQAScopeAnalysis],
    registered_df: pd.DataFrame,
    registered_report_scope: Mapping[str, Any],
    config: AppConfig = CONFIG,
) -> None:
    """
    Align current and prior timeframe table values to Smiley Registered At.

    The existing v5.6.7 function populates current Table * metrics. This
    extension also computes Table Previous * metrics from the same timestamp.
    """
    _align_timeframe_tables_to_smiley_registered_v567(
        scope_analyses=scope_analyses,
        registered_df=registered_df,
        registered_report_scope=registered_report_scope,
        config=config,
    )
    if not scope_analyses or registered_df is None or registered_df.empty:
        return

    current_start = pd.Timestamp(
        registered_report_scope["pattern_start"]
    ).normalize()
    current_end = pd.Timestamp(
        registered_report_scope["pattern_end"]
    ).normalize()
    previous_start, previous_end, previous_label = (
        _pattern_comparison_window(registered_report_scope)
    )

    normalized_sites = (
        registered_df["Site"].map(normalize_text).str.upper()
        if "Site" in registered_df.columns
        else pd.Series("", index=registered_df.index)
    )

    for scope_key, analysis in scope_analyses.items():
        if scope_key == "OVERALL":
            scope_source = registered_df.copy()
        else:
            scope_source = registered_df[
                normalized_sites.eq(normalize_text(scope_key).upper())
            ].copy()
        if scope_source.empty:
            continue

        classified = classify_finance_population(scope_source, config)
        dates = pd.to_datetime(
            classified["Date"],
            errors="coerce",
        ).dt.normalize()
        previous = classified[
            dates.between(
                previous_start,
                previous_end,
                inclusive="both",
            )
        ].copy()

        segmented = _segment_registered_population_v570(
            previous,
            config,
        )
        prior_frame = segmented["frame"]

        prior_time = _authoritative_segment_table_metrics_v565(
            prior_frame,
            "UTC Time Block",
            segmented["time_order"],
        )
        prior_dow = _authoritative_segment_table_metrics_v565(
            prior_frame,
            "UTC Day of Week",
            segmented["dow_order"],
        )
        prior_dom = _authoritative_segment_table_metrics_v565(
            prior_frame,
            "Part of Month",
            segmented["dom_order"],
        )

        analysis.time_of_day_summary = _attach_previous_table_metrics_v570(
            analysis.time_of_day_summary,
            prior_time,
            "UTC Time Block",
        )
        analysis.day_of_week_summary = _attach_previous_table_metrics_v570(
            analysis.day_of_week_summary,
            prior_dow,
            "UTC Day of Week",
        )
        analysis.day_of_month_summary = _attach_previous_table_metrics_v570(
            analysis.day_of_month_summary,
            prior_dom,
            "Part of Month",
        )
        analysis.table_previous_pattern_start = previous_start
        analysis.table_previous_pattern_end = previous_end
        analysis.table_previous_pattern_label = previous_label


def _table_number_v570(row: Mapping[str, Any], column: str) -> float:
    return pd.to_numeric(
        pd.Series([row.get(column, np.nan)]),
        errors="coerce",
    ).iloc[0]


def _timeframe_signal_v570(
    smiley_delta_pp: Any,
    config: AppConfig = CONFIG,
) -> str:
    value = pd.to_numeric(
        pd.Series([smiley_delta_pp]),
        errors="coerce",
    ).iloc[0]
    if pd.isna(value):
        return "No prior"
    threshold = float(config.performance_status_threshold_pp)
    if value >= threshold:
        return "Improving"
    if value <= -threshold:
        return "Regressing"
    return "Stable"


def _timeframe_takeaway_v570(
    analysis_type: str,
    segment: str,
    smiley_rate: Any,
    delta_pp: Any,
    signal: str,
) -> str:
    rate = pd.to_numeric(
        pd.Series([smiley_rate]),
        errors="coerce",
    ).iloc[0]
    delta = pd.to_numeric(
        pd.Series([delta_pp]),
        errors="coerce",
    ).iloc[0]

    label = f"{analysis_type} — {segment}"
    if signal == "Improving" and pd.notna(delta):
        return f"{label} improved {delta:+.1f} pp versus the comparable prior period."
    if signal == "Regressing" and pd.notna(delta):
        return f"{label} regressed {delta:+.1f} pp versus the comparable prior period."
    if signal == "Stable" and pd.notna(rate):
        return f"{label} was stable at {rate:.1%}."
    return f"{label} has insufficient comparable prior data."



def _build_grain_summary_frame_v570(
    grain_results: Mapping[str, GrainResult],
    selection: ReportSelection,
    config: AppConfig = CONFIG,
) -> pd.DataFrame:
    """
    Build the executive grain summary.

    Weekly display is intentionally compact: WBMMDD only.
    The underlying Sunday-Saturday calculation and comparison logic are not
    changed.
    """
    rows: List[Dict[str, Any]] = []

    for grain in _active_grains_v570(selection):
        result = grain_results.get(grain)
        if result is None:
            continue

        metric = result.overall

        smiley_delta_pp = (
            metric.previous_delta * 100
            if pd.notna(metric.previous_delta)
            else np.nan
        )
        unhappy_rate = (
            1.0 - metric.actual_rate
            if pd.notna(metric.actual_rate)
            else np.nan
        )
        unhappy_delta_pp = (
            -smiley_delta_pp
            if pd.notna(smiley_delta_pp)
            else np.nan
        )

        # Display-only simplification requested for the executive table.
        # Weekly logic remains Sunday-Saturday; only the visible label changes.
        if normalize_text(grain).upper() == "WEEKLY":
            period_display = week_beginning_chart_label(
                metric.period_start
            )
        else:
            period_display = normalize_text(
                metric.period_label
            )

        rows.append(
            {
                "Grain": grain.title(),
                "Period": period_display,
                # v5.7.2 omitted Responses from this DataFrame, causing the
                # renderer to display zero. Use the already-calculated metric.
                "Responses": metric.actual_responses,
                "Smiley Rate": metric.actual_rate,
                "Smiley Δ pp": smiley_delta_pp,
                "Unhappy Rate": unhappy_rate,
                "Unhappy Δ pp": unhappy_delta_pp,
                "Signal": _timeframe_signal_v570(
                    smiley_delta_pp,
                    config,
                ),
            }
        )

    return pd.DataFrame(rows)




def _build_consolidated_timeframe_frame_v570(
    analysis: FinanceQAScopeAnalysis,
    selection: ReportSelection,
    config: AppConfig = CONFIG,
) -> pd.DataFrame:
    """
    Consolidate Overall Smiley and Unhappy timeframe views into one table.

    Only All Rated values are shown in the email reporting view. Finance/Other
    detail remains available in the full Whitepaper report.
    """
    rows: List[Dict[str, Any]] = []

    active_grains = _active_grains_v570(selection)
    monthly = analysis.monthly_trend.copy()
    if "MONTHLY" in active_grains and not monthly.empty:
        rated = pd.to_numeric(
            monthly.get("Table All Rated"),
            errors="coerce",
        )
        candidates = monthly[rated.fillna(0).gt(0)].copy()
        if not candidates.empty:
            current = candidates.iloc[-1]
            current_idx = candidates.index[-1]
            prior_rate = np.nan
            if len(candidates) >= 2:
                previous = candidates.iloc[-2]
                prior_rate = _table_number_v570(
                    previous,
                    "Table All Smiley Rate",
                )
            smiley = _table_number_v570(
                current,
                "Table All Smiley Rate",
            )
            unhappy = _table_number_v570(
                current,
                "Table All Unhappy Rate",
            )
            delta_pp = (
                (smiley - prior_rate) * 100
                if pd.notna(smiley) and pd.notna(prior_rate)
                else np.nan
            )
            signal = _timeframe_signal_v570(delta_pp, config)
            segment = normalize_text(current.get("Month", "Current Month"))
            rows.append(
                {
                    "Analysis Type": "By Month",
                    "Segment / Period": segment,
                    "Responses": _table_number_v570(
                        current,
                        "Table All Rated",
                    ),
                    "Smiley Rate": smiley,
                    "Smiley Δ pp": delta_pp,
                    "Unhappy Rate": unhappy,
                    "Unhappy Δ pp": (
                        -delta_pp if pd.notna(delta_pp) else np.nan
                    ),
                    "Signal": signal,
                    "Key Takeaway": _timeframe_takeaway_v570(
                        "Month",
                        segment,
                        smiley,
                        delta_pp,
                        signal,
                    ),
                }
            )

    segment_specs = [
        (
            "By Time of Day",
            analysis.time_of_day_summary,
            "UTC Time Block",
        ),
        (
            "By Day of Week",
            analysis.day_of_week_summary,
            "UTC Day of Week",
        ),
        (
            "By Day of Month",
            analysis.day_of_month_summary,
            "Part of Month",
        ),
    ]

    for analysis_type, frame, key in segment_specs:
        if frame is None or frame.empty:
            continue
        for _, row in frame.iterrows():
            rated = _table_number_v570(
                row,
                "Table All Rated",
            )
            if pd.isna(rated) or rated <= 0:
                continue

            smiley = _table_number_v570(
                row,
                "Table All Smiley Rate",
            )
            unhappy = _table_number_v570(
                row,
                "Table All Unhappy Rate",
            )
            previous_smiley = _table_number_v570(
                row,
                "Table Previous All Smiley Rate",
            )
            delta_pp = (
                (smiley - previous_smiley) * 100
                if pd.notna(smiley) and pd.notna(previous_smiley)
                else np.nan
            )
            signal = _timeframe_signal_v570(
                delta_pp,
                config,
            )
            segment = normalize_text(row.get(key, ""))
            segment = re.sub(
                r"^\s*UTC\s+",
                "",
                segment,
                flags=re.IGNORECASE,
            )
            rows.append(
                {
                    "Analysis Type": analysis_type,
                    "Segment / Period": segment,
                    "Responses": rated,
                    "Smiley Rate": smiley,
                    "Smiley Δ pp": delta_pp,
                    "Unhappy Rate": unhappy,
                    "Unhappy Δ pp": (
                        -delta_pp if pd.notna(delta_pp) else np.nan
                    ),
                    "Signal": signal,
                    "Key Takeaway": _timeframe_takeaway_v570(
                        analysis_type.replace("By ", ""),
                        segment,
                        smiley,
                        delta_pp,
                        signal,
                    ),
                }
            )

    return pd.DataFrame(rows)




def _executive_timeframe_callouts_v570(
    grain_summary: pd.DataFrame,
    timeframe: pd.DataFrame,
) -> List[str]:
    callouts: List[str] = []

    if not grain_summary.empty:
        for _, row in grain_summary.iterrows():
            delta = pd.to_numeric(
                pd.Series([row.get("Smiley Δ pp")]),
                errors="coerce",
            ).iloc[0]
            if pd.notna(delta):
                callouts.append(
                    f"{row.get('Grain')} performance is "
                    f"{str(row.get('Signal', '')).lower()} at "
                    f"{format_rate(row.get('Smiley Rate'))}, "
                    f"{delta:+.1f} pp versus the comparable prior period."
                )

    comparable = timeframe[
        pd.to_numeric(
            timeframe.get("Smiley Δ pp"),
            errors="coerce",
        ).notna()
    ].copy() if not timeframe.empty else pd.DataFrame()

    if not comparable.empty:
        comparable["_delta"] = pd.to_numeric(
            comparable["Smiley Δ pp"],
            errors="coerce",
        )
        best = comparable.sort_values(
            "_delta",
            ascending=False,
        ).iloc[0]
        worst = comparable.sort_values(
            "_delta",
            ascending=True,
        ).iloc[0]
        if float(best["_delta"]) > 0:
            callouts.append(
                f"Strongest improvement: {best['Analysis Type']} — "
                f"{best['Segment / Period']} ({float(best['_delta']):+.1f} pp)."
            )
        if float(worst["_delta"]) < 0:
            callouts.append(
                f"Largest regression: {worst['Analysis Type']} — "
                f"{worst['Segment / Period']} ({float(worst['_delta']):+.1f} pp)."
            )

    if not timeframe.empty:
        valid_rates = timeframe[
            pd.to_numeric(
                timeframe["Smiley Rate"],
                errors="coerce",
            ).notna()
        ].copy()
        if not valid_rates.empty:
            valid_rates["_rate"] = pd.to_numeric(
                valid_rates["Smiley Rate"],
                errors="coerce",
            )
            weakest = valid_rates.sort_values(
                "_rate",
                ascending=True,
            ).iloc[0]
            callouts.append(
                f"Lowest current segment: {weakest['Analysis Type']} — "
                f"{weakest['Segment / Period']} "
                f"({format_rate(weakest['Smiley Rate'])})."
            )

    return callouts[:6]


