def clean_mojibake_datetime_series(series: pd.Series) -> pd.Series:
    out = series.fillna("").astype(str)
    out = out.str.replace("\u202f", " ", regex=False)
    out = out.str.replace("\xa0", " ", regex=False)
    out = out.str.replace("â€¯", " ", regex=False)
    out = out.str.replace(r"\s+", " ", regex=True).str.strip()
    out = out.str.replace(r",\s+", ", ", regex=True)
    out = out.str.replace(
        r"(?i)(\d)(am|pm)\b",
        lambda match: f"{match.group(1)} {match.group(2).upper()}",
        regex=True,
    )
    out = out.str.replace(
        r"(?i)\b(am|pm)\b",
        lambda match: match.group(1).upper(),
        regex=True,
    )
    return out


def parse_dates_with_known_formats(
    series: pd.Series,
    formats: list[str],
) -> pd.Series:
    cleaned = clean_mojibake_datetime_series(series)
    parsed = pd.Series(
        pd.NaT,
        index=series.index,
        dtype="datetime64[ns]",
    )

    remaining_mask = cleaned.ne("")

    for fmt in formats:
        if not remaining_mask.any():
            break

        candidate = pd.to_datetime(
            cleaned.loc[remaining_mask],
            errors="coerce",
            format=fmt,
        )

        success_mask = candidate.notna()
        if success_mask.any():
            success_index = candidate.index[success_mask]
            parsed.loc[success_index] = candidate.loc[success_index]
            remaining_mask.loc[success_index] = False

    if remaining_mask.any():
        try:
            fallback = pd.to_datetime(
                cleaned.loc[remaining_mask],
                errors="coerce",
                format="mixed",
            )
        except (TypeError, ValueError):
            with warnings.catch_warnings():
                warnings.simplefilter("ignore", UserWarning)
                fallback = pd.to_datetime(
                    cleaned.loc[remaining_mask],
                    errors="coerce",
                )

        success_mask = fallback.notna()
        if success_mask.any():
            success_index = fallback.index[success_mask]
            parsed.loc[success_index] = fallback.loc[success_index]

    try:
        if getattr(parsed.dt, "tz", None) is not None:
            parsed = parsed.dt.tz_convert(None)
    except Exception:
        pass

    try:
        parsed = parsed.dt.tz_localize(None)
    except Exception:
        pass

    return parsed


