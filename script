def _weighted_rate_v550(
    frame: pd.DataFrame,
    rated_column: str,
    rate_column: str,
) -> float:
    if (
        frame is None
        or frame.empty
        or rated_column not in frame.columns
        or rate_column not in frame.columns
    ):
        return np.nan
    rated = pd.to_numeric(frame[rated_column], errors="coerce").fillna(0)
    rates = pd.to_numeric(frame[rate_column], errors="coerce")
    valid = rated.gt(0) & rates.notna()
    denominator = float(rated[valid].sum())
    if denominator <= 0:
        return np.nan
    return float((rated[valid] * rates[valid]).sum() / denominator)



def _smiley_rate_series_v552(
    frame: pd.DataFrame,
    prefix: str,
    previous: bool = False,
) -> pd.Series:
    """Return a numeric Smiley Rate series, deriving it from the complement when needed."""
    lead = "Previous " if previous else ""
    smiley_column = f"{lead}{prefix} Smiley Rate"
    unhappy_column = f"{lead}{prefix} Unhappy Rate"

    if smiley_column in frame.columns:
        values = pd.to_numeric(frame[smiley_column], errors="coerce")
    elif unhappy_column in frame.columns:
        values = 1.0 - pd.to_numeric(frame[unhappy_column], errors="coerce")
    else:
        values = pd.Series(np.nan, index=frame.index, dtype="float64")

    return values.clip(lower=0.0, upper=1.0)


def _smiley_rate_from_row_v552(
    row: Mapping[str, Any],
    prefix: str,
    previous: bool = False,
) -> float:
    lead = "Previous " if previous else ""
    smiley_value = pd.to_numeric(
        pd.Series([row.get(f"{lead}{prefix} Smiley Rate")]),
        errors="coerce",
    ).iloc[0]
    if pd.notna(smiley_value):
        return float(min(1.0, max(0.0, smiley_value)))

    unhappy_value = pd.to_numeric(
        pd.Series([row.get(f"{lead}{prefix} Unhappy Rate")]),
        errors="coerce",
    ).iloc[0]
    if pd.notna(unhappy_value):
        return float(min(1.0, max(0.0, 1.0 - unhappy_value)))
    return np.nan


def _smiley_gap_pp_v552(
    row: Mapping[str, Any],
) -> float:
    finance_rate = _smiley_rate_from_row_v552(row, "Finance")
    other_rate = _smiley_rate_from_row_v552(row, "Other")
    if pd.isna(finance_rate) or pd.isna(other_rate):
        return np.nan
    return (finance_rate - other_rate) * 100

def _aggregate_timing_comparison_v550(
    frame: pd.DataFrame,
    config: AppConfig = CONFIG,
) -> Dict[str, Any]:
    """Aggregate the timing table using All-Rated Smiley Rate."""
    if frame is None or frame.empty:
        return {
            "current_rate": np.nan,
            "previous_rate": np.nan,
            "delta_pp": np.nan,
            "status": "Insufficient previous data",
        }

    work = frame.copy()
    work["_Current Smiley Rate"] = _smiley_rate_series_v552(
        work,
        "All",
        previous=False,
    )
    work["_Previous Smiley Rate"] = _smiley_rate_series_v552(
        work,
        "All",
        previous=True,
    )
    current_rate = _weighted_rate_v550(
        work,
        "All Rated",
        "_Current Smiley Rate",
    )
    previous_rate = _weighted_rate_v550(
        work,
        "Previous All Rated",
        "_Previous Smiley Rate",
    )
    status = comparison_status(
        current_rate,
        previous_rate,
        higher_is_better=True,
        config=config,
    )
    delta_pp = (
        (current_rate - previous_rate) * 100
        if pd.notna(current_rate) and pd.notna(previous_rate)
        else np.nan
    )
    return {
        "current_rate": current_rate,
        "previous_rate": previous_rate,
        "delta_pp": delta_pp,
        "status": status,
    }



def _segment_noun_v551(section_key: str, count: int = 1) -> str:
    """Return a business-readable segment noun for one timing section."""
    key = normalize_text(section_key).upper()
    singular = {
        "TIME": "time block",
        "DOW": "day",
        "DOM": "month segment",
    }.get(key, "segment")
    return singular if count == 1 else f"{singular}s"


def _compact_label_list_v551(values: Sequence[str]) -> str:
    """Join labels compactly without creating an overcrowded narrative."""
    clean = [normalize_text(value) for value in values if normalize_text(value)]
    if not clean:
        return ""
    if len(clean) == 1:
        return clean[0]
    if len(clean) == 2:
        return f"{clean[0]} and {clean[1]}"
    return f"{clean[0]}, {clean[1]}, and {len(clean) - 2} more"



def _segment_comparisons_v551(
    frame: pd.DataFrame,
    label_column: str,
    config: AppConfig = CONFIG,
) -> pd.DataFrame:
    """
    Return matching-segment Smiley Rate movements.

    A segment is comparable only when both current and previous windows have
    positive rated volume and valid Smiley Rates. Missing or future segments
    remain unavailable instead of being labeled Stable.
    """
    output_columns = [
        "Label",
        "Current Rated",
        "Previous Rated",
        "Current Rate",
        "Previous Rate",
        "Delta pp",
        "Status",
    ]
    if frame is None or frame.empty or label_column not in frame.columns:
        return pd.DataFrame(columns=output_columns)

    work = frame.copy()
    for column in ["All Rated", "Previous All Rated"]:
        if column not in work.columns:
            work[column] = np.nan
        work[column] = pd.to_numeric(work[column], errors="coerce")

    work["_Current Smiley Rate"] = _smiley_rate_series_v552(
        work,
        "All",
        previous=False,
    )
    work["_Previous Smiley Rate"] = _smiley_rate_series_v552(
        work,
        "All",
        previous=True,
    )

    rows: List[Dict[str, Any]] = []
    threshold = _status_threshold_pp(config)

    for _, row in work.iterrows():
        label = normalize_text(row.get(label_column, ""))
        current_rated = row.get("All Rated")
        previous_rated = row.get("Previous All Rated")
        current_rate = row.get("_Current Smiley Rate")
        previous_rate = row.get("_Previous Smiley Rate")

        comparable = (
            pd.notna(current_rated)
            and pd.notna(previous_rated)
            and float(current_rated) > 0
            and float(previous_rated) > 0
            and pd.notna(current_rate)
            and pd.notna(previous_rate)
        )

        if comparable:
            delta_pp = (float(current_rate) - float(previous_rate)) * 100
            if abs(delta_pp) < threshold:
                status = "Stable"
            elif delta_pp > 0:
                status = "Improving"
            else:
                status = "Regressing"
        else:
            delta_pp = np.nan
            status = "Insufficient comparable data"

        rows.append(
            {
                "Label": label,
                "Current Rated": current_rated,
                "Previous Rated": previous_rated,
                "Current Rate": current_rate,
                "Previous Rate": previous_rate,
                "Delta pp": delta_pp,
                "Status": status,
            }
        )

    return pd.DataFrame(rows, columns=output_columns)



def _segment_section_status_v551(
    comparisons: pd.DataFrame,
) -> str:
    """Summarize segment statuses into one section-level conclusion."""
    if comparisons is None or comparisons.empty:
        return "Insufficient data"

    statuses = comparisons["Status"].map(normalize_text).str.upper()
    improving = statuses.eq("IMPROVING").any()
    regressing = statuses.eq("REGRESSING").any()
    stable = statuses.eq("STABLE").any()

    if improving and regressing:
        return "Mixed"
    if regressing:
        return "Regressing"
    if improving:
        return "Improving"
    if stable:
        return "Stable"
    return "Insufficient data"


def _format_segment_move_v551(
    row: pd.Series,
) -> str:
    """Format one compact segment movement for the executive narrative."""
    label = normalize_text(row.get("Label", "")) or "Segment"
    delta_pp = pd.to_numeric(
        pd.Series([row.get("Delta pp")]),
        errors="coerce",
    ).iloc[0]
    if pd.isna(delta_pp):
        return label
    sign = "+" if float(delta_pp) > 0 else ""
    return f"{label} ({sign}{float(delta_pp):.1f} pp)"


def _trend_phrase_v550(
    frame: pd.DataFrame,
    label_column: str,
    section_key: str,
    config: AppConfig = CONFIG,
) -> Tuple[str, str]:
    """
    Build a segment-specific timing conclusion.

    Unlike the prior aggregate narrative, this compares each time block,
    weekday, or month segment with the same segment in the immediately
    previous equivalent window. The title receives one overall conclusion,
    while the short phrase identifies the strongest improving/regressing
    segments without repeating status text in every table cell.
    """
    comparisons = _segment_comparisons_v551(
        frame,
        label_column,
        config,
    )
    status = _segment_section_status_v551(comparisons)

    if comparisons.empty:
        return (
            status,
            "No timing segments were available for the selected scope and period.",
        )

    improving = comparisons[
        comparisons["Status"].eq("Improving")
    ].sort_values("Delta pp", ascending=True)
    regressing = comparisons[
        comparisons["Status"].eq("Regressing")
    ].sort_values("Delta pp", ascending=False)
    stable = comparisons[
        comparisons["Status"].eq("Stable")
    ]
    unavailable = comparisons[
        comparisons["Status"].eq("Insufficient comparable data")
    ]

    sentences: List[str] = []

    if not regressing.empty:
        labels = [
            _format_segment_move_v551(row)
            for _, row in regressing.head(2).iterrows()
        ]
        verb = "regressed" if len(labels) == 1 else "regressed"
        sentences.append(
            f"{_compact_label_list_v551(labels)} {verb} versus the same "
            "segment in the previous comparable period."
        )

    if not improving.empty:
        labels = [
            _format_segment_move_v551(row)
            for _, row in improving.head(2).iterrows()
        ]
        connector = "Meanwhile, " if sentences else ""
        sentences.append(
            f"{connector}{_compact_label_list_v551(labels)} improved versus "
            "the same segment in the previous comparable period."
        )

    if stable.shape[0] > 0:
        stable_labels = stable["Label"].map(normalize_text).tolist()
        if not sentences:
            sentences.append(
                f"All {stable.shape[0]} comparable "
                f"{_segment_noun_v551(section_key, stable.shape[0])} remained "
                f"within ±{_status_threshold_pp(config):.1f} pp."
            )
        elif stable.shape[0] <= 2:
            sentences.append(
                f"{_compact_label_list_v551(stable_labels)} remained stable."
            )
        else:
            sentences.append(
                f"{stable.shape[0]} other comparable "
                f"{_segment_noun_v551(section_key, stable.shape[0])} remained stable."
            )

    if unavailable.shape[0] > 0:
        unavailable_labels = (
            unavailable["Label"].map(normalize_text).tolist()
        )
        if section_key == "DOM":
            sentences.append(
                f"{_compact_label_list_v551(unavailable_labels)} had no "
                "like-for-like rated data yet."
            )
        elif unavailable.shape[0] <= 2:
            sentences.append(
                f"{_compact_label_list_v551(unavailable_labels)} lacked "
                "comparable rated data."
            )
        else:
            sentences.append(
                f"{unavailable.shape[0]} additional "
                f"{_segment_noun_v551(section_key, unavailable.shape[0])} "
                "lacked comparable rated data."
            )

    if not sentences:
        sentences.append(
            "No segment had enough rated responses in both periods for a "
            "directional comparison."
        )

    return status, " ".join(sentences[:3])



def _monthly_trend_phrase_v551(
    scope_analysis: FinanceQAScopeAnalysis,
    config: AppConfig = CONFIG,
) -> Tuple[str, str]:
    """
    Build a Smiley Rate monthly conclusion using the like-for-like selected
    period and the direction across completed months in the rolling table.
    """
    comparison = _aggregate_timing_comparison_v550(
        scope_analysis.time_of_day_summary,
        config,
    )
    status = normalize_text(comparison.get("status")) or "Insufficient data"
    current_rate = comparison.get("current_rate")
    delta_pp = comparison.get("delta_pp")

    sentences: List[str] = []
    if pd.isna(delta_pp):
        sentences.append(
            "The previous equivalent window does not have enough rated volume "
            "for a like-for-like Smiley Rate comparison."
        )
    elif abs(float(delta_pp)) < _status_threshold_pp(config):
        sentences.append(
            f"Smiley Rate was stable at {format_rate(current_rate)}, "
            f"a {float(delta_pp):+.1f} pp change versus the previous equivalent window."
        )
    elif float(delta_pp) > 0:
        sentences.append(
            f"Smiley Rate improved by {abs(float(delta_pp)):.1f} pp "
            f"to {format_rate(current_rate)} versus the previous equivalent window."
        )
    else:
        sentences.append(
            f"Smiley Rate regressed by {abs(float(delta_pp)):.1f} pp "
            f"to {format_rate(current_rate)} versus the previous equivalent window."
        )

    monthly = getattr(scope_analysis, "monthly_trend", pd.DataFrame())
    if monthly is not None and not monthly.empty:
        completed = monthly.copy()
        if "Month" in completed.columns:
            completed = completed[
                ~completed["Month"].astype(str).str.contains(
                    "partial",
                    case=False,
                    na=False,
                )
            ]

        completed["All Rated"] = pd.to_numeric(
            completed.get("All Rated"),
            errors="coerce",
        )
        completed["_All Smiley Rate"] = _smiley_rate_series_v552(
            completed,
            "All",
            previous=False,
        )
        completed = completed[
            completed["All Rated"].fillna(0).gt(0)
            & completed["_All Smiley Rate"].notna()
        ]

        if completed.shape[0] >= 2:
            first = completed.iloc[0]
            last = completed.iloc[-1]
            first_rate = float(first["_All Smiley Rate"])
            last_rate = float(last["_All Smiley Rate"])
            rolling_delta_pp = (last_rate - first_rate) * 100
            first_label = normalize_text(first.get("Month", "first month"))
            last_label = normalize_text(last.get("Month", "latest month"))

            if abs(rolling_delta_pp) < _status_threshold_pp(config):
                direction = "was broadly stable"
            elif rolling_delta_pp > 0:
                direction = f"improved by {abs(rolling_delta_pp):.1f} pp"
            else:
                direction = f"regressed by {abs(rolling_delta_pp):.1f} pp"

            sentences.append(
                f"Across completed months shown, Smiley Rate {direction} "
                f"from {format_rate(first_rate)} in {first_label} to "
                f"{format_rate(last_rate)} in {last_label}."
            )

    return status, " ".join(sentences[:2])




