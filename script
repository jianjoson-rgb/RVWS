        return "N/A"
    return f"{numeric:+.1f}%"


def _email_v551_format_pp_from_pp(value_pp: Any, decimals: int = 1) -> str:
    numeric = _email_v551_num(value_pp)
    if pd.isna(numeric):
        return "N/A"
    return f"{numeric:+.{decimals}f} pp"


def _email_v551_metric_period_unit(metric: PeriodMetric) -> str:
    grain = normalize_text(metric.grain).upper()
    if grain == "DAILY":
        return "day"
    if grain == "WEEKLY":
        return "week"
    if grain == "MONTHLY":
        return "month"
    return "period"


def _email_v551_baseline_label(metric: PeriodMetric) -> str:
    unit = _email_v551_metric_period_unit(metric)
    count = int(getattr(metric, "baseline_period_count", 0) or 0)
    if count > 0:
        return f"{count}-{unit} rolling average"
    return "rolling baseline"


def _email_v551_current_period_label(metric: PeriodMetric) -> str:
    label = normalize_text(getattr(metric, "period_label", ""))
    if label:
        return label
    try:
        start = pd.Timestamp(metric.period_start)
        end = pd.Timestamp(metric.data_through)
        if metric.grain.upper() == "DAILY":
            return start.strftime("%b %d, %Y")
        if metric.grain.upper() == "WEEKLY":
            return f"{week_beginning_chart_label(start)} ({start:%m/%d/%Y}–{end:%m/%d/%Y})"
        return start.strftime("%B %Y")
    except Exception:
        return metric.grain.title()


def _email_v551_outcome_counts(source_df: pd.DataFrame) -> Dict[str, float]:
    """Return response-weighted Smiley/Neutral/Frownie counts for a population."""
    if source_df is None or source_df.empty:
        return {
            "Rated": 0.0,
            "Smiley": 0.0,
            "Neutral": 0.0,
            "Frownie": 0.0,
            "Non-Smiley": 0.0,
            "Smiley Rate": np.nan,
            "Non-Smiley Rate": np.nan,
        }

    work = source_df.copy()
    responses = pd.to_numeric(
        work.get("Responses", pd.Series(0.0, index=work.index)),
        errors="coerce",
    ).fillna(0.0)
    outcomes = _squad_outcome_series_v531(work)

    smiley = float(responses[outcomes.eq("Smiley")].sum())
    neutral = float(responses[outcomes.eq("Neutral")].sum())
    frownie = float(responses[outcomes.eq("Frownie")].sum())
    rated = float(responses[outcomes.isin(["Smiley", "Neutral", "Frownie"])].sum())
    non_smiley = neutral + frownie
    return {
        "Rated": rated,
        "Smiley": smiley,
        "Neutral": neutral,
        "Frownie": frownie,
        "Non-Smiley": non_smiley,
        "Smiley Rate": safe_rate(smiley, rated),
        "Non-Smiley Rate": safe_rate(non_smiley, rated),
    }


def _email_v551_group_response_mix(
    source_df: pd.DataFrame,
    group_column: str,
    scope_name: str = "Overall",
) -> pd.DataFrame:
    """Build a compact response-mix table for one grouping column."""
    columns = [
        group_column,
        "Rated",
        "Smiley",
        "Neutral",
        "Frownie",
        "Non-Smiley",
        "Smiley Rate",
        "Non-Smiley Share",
        "Gap vs Scope",
    ]
    if source_df is None or source_df.empty or group_column not in source_df.columns:
        return pd.DataFrame(columns=columns)

    work = source_df.copy()
    work[group_column] = work[group_column].map(normalize_text)
    work = work[work[group_column].ne("")].copy()
    if work.empty:
        return pd.DataFrame(columns=columns)

    work["_Outcome"] = _squad_outcome_series_v531(work)
    work["_Responses"] = pd.to_numeric(
        work.get("Responses", pd.Series(0.0, index=work.index)),
        errors="coerce",
    ).fillna(0.0)
    work["_Smiley"] = np.where(work["_Outcome"].eq("Smiley"), work["_Responses"], 0.0)
    work["_Neutral"] = np.where(work["_Outcome"].eq("Neutral"), work["_Responses"], 0.0)
    work["_Frownie"] = np.where(work["_Outcome"].eq("Frownie"), work["_Responses"], 0.0)

    scope_counts = _email_v551_outcome_counts(work)
    scope_rate = scope_counts["Smiley Rate"]
    total_non_smiley = scope_counts["Non-Smiley"]

    records: List[Dict[str, Any]] = []
    for value, group in work.groupby(group_column, dropna=False):
        responses = pd.to_numeric(group["_Responses"], errors="coerce").fillna(0.0)
        rated = float(responses.sum())
        if rated <= 0:
            continue
        smiley = float(pd.to_numeric(group["_Smiley"], errors="coerce").fillna(0.0).sum())
        neutral = float(pd.to_numeric(group["_Neutral"], errors="coerce").fillna(0.0).sum())
        frownie = float(pd.to_numeric(group["_Frownie"], errors="coerce").fillna(0.0).sum())
        non_smiley = neutral + frownie
        rate = safe_rate(smiley, rated)
        records.append(
            {
                group_column: normalize_text(value),
                "Rated": rated,
                "Smiley": smiley,
                "Neutral": neutral,
                "Frownie": frownie,
                "Non-Smiley": non_smiley,
                "Smiley Rate": rate,
                "Non-Smiley Share": safe_rate(non_smiley, total_non_smiley),
                "Gap vs Scope": (
                    float(rate) - float(scope_rate)
                    if pd.notna(rate) and pd.notna(scope_rate)
                    else np.nan
                ),
            }
        )

    if not records:
        return pd.DataFrame(columns=columns)
    return pd.DataFrame(records, columns=columns)


def _email_v551_top_ticket_age_driver(
    source_df: pd.DataFrame,
    scope_name: str,
    config: AppConfig = CONFIG,
) -> Dict[str, Any]:
    """Return strongest Ticket Age risk by non-smiley share and weak Smiley Rate."""
    table = build_ticket_age_impact_table_v548(
        source_df=source_df,
        scope_name=scope_name,
        config=config,
    )
    if table is None or table.empty:
        return {}

    work = table.copy()
    work["_Rated"] = pd.to_numeric(work.get("Rated", 0), errors="coerce").fillna(0.0)
    work["_Rate"] = pd.to_numeric(work.get("Smiley Rate", np.nan), errors="coerce")
    work["_NS Share"] = pd.to_numeric(
        work.get("Non-Smiley Share", np.nan),
        errors="coerce",
    ).fillna(0.0)
    work = work[work["_Rated"].gt(0)].copy()
    if work.empty:
        return {}

    # Prefer high non-smiley contribution first; use weaker rate as tiebreaker.
    risk = work.sort_values(
        ["_NS Share", "_Rate", "_Rated"],
        ascending=[False, True, False],
        na_position="last",
    ).iloc[0]
    weakest = work.sort_values(
        ["_Rate", "_NS Share", "_Rated"],
        ascending=[True, False, False],
        na_position="last",
    ).iloc[0]
    return {
        "risk": risk.to_dict(),
        "weakest": weakest.to_dict(),
    }


def _email_v551_top_taxonomy_driver(
    source_df: pd.DataFrame,
    config: AppConfig = CONFIG,
) -> Dict[str, Any]:
    """Return top Level One and Level Two non-smiley taxonomy drivers."""
    result: Dict[str, Any] = {}
    for column, key in [("Level One", "level_one"), ("Level Two", "level_two")]:
        table = _email_v551_group_response_mix(source_df, column)
        if table.empty:
            continue
        work = table.copy()
        work["_NS Share"] = pd.to_numeric(
            work.get("Non-Smiley Share", np.nan),
            errors="coerce",
        ).fillna(0.0)
        work["_Non-Smiley"] = pd.to_numeric(
            work.get("Non-Smiley", np.nan),
            errors="coerce",
        ).fillna(0.0)
        work["_Rated"] = pd.to_numeric(
            work.get("Rated", np.nan),
            errors="coerce",
        ).fillna(0.0)
        work["_Rate"] = pd.to_numeric(
