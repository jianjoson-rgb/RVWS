def _docx_v570_add_summary_matrix_table(
    document: Document,
    payload: Mapping[str, Any],
    config: AppConfig = CONFIG,
) -> None:
    """Add the expanded Daily / Weekly / Monthly driver matrix to the main report."""
    readouts = _docx_v570_readouts_by_grain(payload)
    ordered_grains = [grain for grain in ("DAILY", "WEEKLY", "MONTHLY") if grain in readouts]
    if not ordered_grains:
        note = document.add_paragraph(
            "No Daily / Weekly / Monthly detailed readout data was available for the selected reporting scope."
        )
        note.runs[0].italic = True
        return

    max_chars = int(getattr(config, "main_summary_driver_table_max_chars", 900))
    font_size = float(getattr(config, "main_summary_driver_table_font_size", 5.7))

    row_labels: List[str] = [
        "Current Performance",
        "Site Driver",
        "Ticket Age Volume Share",
        "Taxonomy Non-Smiley Contributors",
        "Tenure Group",
        "Driver Handling Context",
        "Squad Drivers",
        "QA Attribute Signal",
        "Non-Smiley / AFTR / AHT Deep-Dive Signal",
        "Non-Smiley + Async Follow-Up Signal",
        "Recovery / Projection",
        "Week-End / Closing Assessment",
        "Teammate Coaching Signal",
        "Recommended Action",
    ]

    headers = ["Summary Area"] + [_docx_v570_period_title(readouts[grain]) for grain in ordered_grains]
    table = document.add_table(rows=1, cols=len(headers))
    table.style = "Table Grid"
    table.alignment = WD_TABLE_ALIGNMENT.CENTER
    try:
        table.allow_autofit = True
    except Exception:
        pass
    _v528_set_table_preferred_width_pct(table, 100.0)

    for idx, header in enumerate(headers):
        cell = table.rows[0].cells[idx]
        _set_cell_shading(cell, "002060")
        _set_table_cell_text(
            cell,
            header,
            bold=True,
            color_hex="FFFFFF",
            font_size=font_size,
            alignment=WD_ALIGN_PARAGRAPH.CENTER,
        )
        _set_cell_margins(cell, top=55, start=55, bottom=55, end=55)

    always_keep = {
        "Current Performance",
        "Site Driver",
        "Ticket Age Volume Share",
        "Taxonomy Non-Smiley Contributors",
        "Tenure Group",
        "Driver Handling Context",
        "Squad Drivers",
        "QA Attribute Signal",
        "Non-Smiley / AFTR / AHT Deep-Dive Signal",
        "Non-Smiley + Async Follow-Up Signal",
        "Recovery / Projection",
        "Recommended Action",
    }

    for row_idx, label in enumerate(row_labels):
        row_values = [label]
        has_detail = False
        for grain in ordered_grains:
            value = _docx_v570_summary_cell_for_area(
                readouts[grain],
                label,
                max_chars=max_chars,
            )
            if value not in {"", "N/A"}:
                has_detail = True
            row_values.append(value)

        if not has_detail and label not in always_keep:
            continue

        row_cells = table.add_row().cells
        for idx, value in enumerate(row_values):
            cell = row_cells[idx]
            fill = "F3F6FA" if idx == 0 else ("FAFBFC" if row_idx % 2 else "FFFFFF")
            _set_cell_shading(cell, fill)
            _set_table_cell_text(
                cell,
                value,
                bold=(idx == 0),
                color_hex="1F2937",
                font_size=font_size,
                alignment=WD_ALIGN_PARAGRAPH.LEFT,
            )
            _set_cell_margins(cell, top=45, start=50, bottom=45, end=50)
            for paragraph in cell.paragraphs:
                paragraph.paragraph_format.space_before = Pt(0)
                paragraph.paragraph_format.space_after = Pt(0)
                paragraph.paragraph_format.line_spacing = 1.0
                for run in paragraph.runs:
                    run.font.size = Pt(font_size)
                    run.font.name = config.docx_font_name

    try:
        _v526_apply_docx_table_conditional_formatting(table, headers)
    except Exception as exc:
        LOGGER.warning("Executive Signal & Driver Summary table formatting skipped: %s", exc)


