SPREADSHEET_METADATA_CACHE = {}


def invalidate_spreadsheet_metadata_cache(spreadsheet_id=None):
    if spreadsheet_id is None:
        SPREADSHEET_METADATA_CACHE.clear()
        return

    SPREADSHEET_METADATA_CACHE.pop(spreadsheet_id, None)


def get_spreadsheet_metadata(
    sheets_service,
    spreadsheet_id,
    force_refresh=False,
):
    if (
        CACHE_SPREADSHEET_METADATA
        and not force_refresh
        and spreadsheet_id in SPREADSHEET_METADATA_CACHE
    ):
        return SPREADSHEET_METADATA_CACHE[spreadsheet_id]

    metadata = run_with_retry(
        "Get spreadsheet metadata",
        lambda: sheets_service.spreadsheets().get(
            spreadsheetId=spreadsheet_id,
            fields=(
                "properties(title),"
                "sheets(properties(sheetId,title,gridProperties))"
            ),
        ).execute(),
    )

    if CACHE_SPREADSHEET_METADATA:
        SPREADSHEET_METADATA_CACHE[spreadsheet_id] = metadata

    return metadata


def ensure_sheet_exists(
    sheets_service,
    spreadsheet_id,
    sheet_name,
):
    metadata = get_spreadsheet_metadata(
        sheets_service,
        spreadsheet_id,
    )
    existing_names = [
        sheet["properties"]["title"]
        for sheet in metadata.get("sheets", [])
    ]

    if sheet_name in existing_names:
        return

    body = {
        "requests": [
            {
                "addSheet": {
                    "properties": {"title": sheet_name}
                }
            }
        ]
    }

    run_with_retry(
        f"Create sheet '{sheet_name}'",
        lambda: sheets_service.spreadsheets().batchUpdate(
            spreadsheetId=spreadsheet_id,
            body=body,
        ).execute(),
    )
    invalidate_spreadsheet_metadata_cache(spreadsheet_id)
    get_spreadsheet_metadata(
        sheets_service,
        spreadsheet_id,
        force_refresh=True,
    )


def get_sheet_id_by_name(
    sheets_service,
    spreadsheet_id,
    sheet_name,
):
    metadata = get_spreadsheet_metadata(
        sheets_service,
        spreadsheet_id,
    )

    for sheet in metadata.get("sheets", []):
        properties = sheet.get("properties", {})
        if properties.get("title") == sheet_name:
            return properties.get("sheetId")

    raise ValueError(f"Sheet '{sheet_name}' not found.")


def get_sheet_properties_by_name(
    sheets_service,
    spreadsheet_id,
    sheet_name,
    force_refresh=False,
):
    metadata = get_spreadsheet_metadata(
        sheets_service,
        spreadsheet_id,
        force_refresh=force_refresh,
    )

    for sheet in metadata.get("sheets", []):
        properties = sheet.get("properties", {})
        if properties.get("title") == sheet_name:
            grid_properties = properties.get("gridProperties", {})
            return {
                "spreadsheet_title": (
                    metadata.get("properties", {}).get("title", "")
                ),
                "sheet_id": properties.get("sheetId"),
                "sheet_title": properties.get("title"),
                "row_count": int(grid_properties.get("rowCount", 0) or 0),
                "column_count": int(grid_properties.get("columnCount", 0) or 0),
                "metadata": metadata,
            }

    available = [
        sheet.get("properties", {}).get("title")
        for sheet in metadata.get("sheets", [])
    ]

    raise ValueError(
        f"Sheet '{sheet_name}' not found in spreadsheet "
        f"{spreadsheet_id}. Available sheets: {available}"
    )


def calculate_workbook_cell_usage(metadata):
    usage_rows = []
    total_cells = 0

    for sheet in metadata.get("sheets", []):
        properties = sheet.get("properties", {})
        grid_properties = properties.get("gridProperties", {})
        row_count = int(grid_properties.get("rowCount", 0) or 0)
        column_count = int(grid_properties.get("columnCount", 0) or 0)
        cells = row_count * column_count
        total_cells += cells

        usage_rows.append(
            {
                "sheet_title": properties.get("title", ""),
                "sheet_id": properties.get("sheetId"),
                "row_count": row_count,
                "column_count": column_count,
                "cells": cells,
            }
        )

    return total_cells, usage_rows


def log_top_sheet_cell_usage(usage_rows, top_n=8):
    sorted_rows = sorted(
        usage_rows,
        key=lambda row: row.get("cells", 0),
        reverse=True,
    )

    print("Largest sheets by allocated cells:")
    for row in sorted_rows[:top_n]:
        print(
            "  "
            f"{row['sheet_title']}: "
            f"{row['row_count']:,} rows x "
            f"{row['column_count']:,} cols = "
            f"{row['cells']:,} cells"
        )



def prepare_target_workbook_output_tabs(
    sheets_service,
    spreadsheet_id,
    keep_sheet_names=None,
):
    """
    Keep the target workbook lean by retaining only generated output tabs.

    This affects TARGET_SPREADSHEET_ID only. It does not touch any source
    folders or source spreadsheets.

    When DELETE_NON_OUTPUT_TABS_FROM_TARGET is True, all sheets except the
    configured keep tabs are permanently deleted. This prevents old signal,
    analysis, helper, pivot, and temporary tabs from consuming workbook cells.
    """
    keep_sheet_names = list(
        keep_sheet_names or TARGET_OUTPUT_SHEETS_TO_KEEP
    )
    keep_set = set(keep_sheet_names)

    if not keep_sheet_names:
        raise ValueError(
            "keep_sheet_names cannot be empty. At least one sheet must be kept."
        )

    if not DELETE_NON_OUTPUT_TABS_FROM_TARGET:
        print(
            "Target workbook cleanup is disabled. "
            "Ensuring output tabs exist only."
        )
        for sheet_name in keep_sheet_names:
            ensure_sheet_exists(
                sheets_service=sheets_service,
                spreadsheet_id=spreadsheet_id,
                sheet_name=sheet_name,
            )
        return

    print("======================================")
    print("TARGET WORKBOOK CLEANUP START")
    print("======================================")
    print(
        "Target workbook will keep only: "
        f"{', '.join(keep_sheet_names)}"
    )

    metadata = get_spreadsheet_metadata(
        sheets_service=sheets_service,
        spreadsheet_id=spreadsheet_id,
        force_refresh=True,
    )
    sheets = metadata.get("sheets", [])

    if not sheets:
        raise RuntimeError(
            "Target spreadsheet metadata returned no sheets. "
            "Cannot prepare output workbook."
        )

    current_titles = [
        sheet.get("properties", {}).get("title", "")
        for sheet in sheets
    ]

    existing_keep_titles = [
        title for title in current_titles if title in keep_set
    ]

    # If the workbook does not yet contain any of the keep tabs, rename the
    # first existing tab to raw instead of adding a new tab. This avoids
    # unnecessary cell growth in already-full workbooks.
    if not existing_keep_titles:
        first_sheet = sheets[0].get("properties", {})
        first_sheet_id = first_sheet.get("sheetId")
        first_sheet_title = first_sheet.get("title", "")
        primary_keep_title = keep_sheet_names[0]

        print(
            "No output tabs were found. Renaming first existing tab "
            f"'{first_sheet_title}' to '{primary_keep_title}'."
        )

        run_with_retry(
            f"Rename sheet '{first_sheet_title}' to '{primary_keep_title}'",
            lambda: sheets_service.spreadsheets().batchUpdate(
                spreadsheetId=spreadsheet_id,
                body={
                    "requests": [
                        {
                            "updateSheetProperties": {
                                "properties": {
                                    "sheetId": first_sheet_id,
                                    "title": primary_keep_title,
                                },
                                "fields": "title",
                            }
                        }
                    ]
                },
            ).execute(),
        )
        invalidate_spreadsheet_metadata_cache(spreadsheet_id)

        metadata = get_spreadsheet_metadata(
            sheets_service=sheets_service,
            spreadsheet_id=spreadsheet_id,
            force_refresh=True,
        )
        sheets = metadata.get("sheets", [])

    sheets_to_delete = []
    for sheet in sheets:
        properties = sheet.get("properties", {})
        title = properties.get("title", "")
        sheet_id = properties.get("sheetId")

        if title not in keep_set:
            sheets_to_delete.append(
                {
                    "title": title,
                    "sheet_id": sheet_id,
                }
            )

    if sheets_to_delete:
        print("Deleting non-output tabs from target workbook:")
        for item in sheets_to_delete:
            print(f"  - {item['title']}")

        delete_requests = [
            {
                "deleteSheet": {
                    "sheetId": item["sheet_id"]
                }
            }
            for item in sheets_to_delete
        ]

        # Batch delete requests. This is safer for workbooks with many tabs.
        batch_size = 100
        for batch_number, start_index in enumerate(
            range(0, len(delete_requests), batch_size),
            start=1,
        ):
            request_batch = delete_requests[
                start_index:start_index + batch_size
            ]
            run_with_retry(
                f"Delete old target tabs batch {batch_number}",
                lambda request_batch=request_batch: (
                    sheets_service.spreadsheets().batchUpdate(
                        spreadsheetId=spreadsheet_id,
                        body={"requests": request_batch},
                    ).execute()
                ),
            )

        invalidate_spreadsheet_metadata_cache(spreadsheet_id)
    else:
        print("No non-output tabs found. Nothing to delete.")

    # Ensure both required generated tabs exist after cleanup.
    for sheet_name in keep_sheet_names:
        ensure_sheet_exists(
            sheets_service=sheets_service,
            spreadsheet_id=spreadsheet_id,
            sheet_name=sheet_name,
        )

    metadata = get_spreadsheet_metadata(
        sheets_service=sheets_service,
        spreadsheet_id=spreadsheet_id,
        force_refresh=True,
    )
    remaining_titles = [
        sheet.get("properties", {}).get("title", "")
        for sheet in metadata.get("sheets", [])
    ]

    print("Target workbook tabs after cleanup:")
    for title in remaining_titles:
        print(f"  - {title}")

    unexpected_tabs = [
        title for title in remaining_titles if title not in keep_set
    ]
    if unexpected_tabs:
        raise RuntimeError(
            "Target workbook cleanup did not complete as expected. "
            f"Unexpected remaining tabs: {unexpected_tabs}"
        )

    print("TARGET WORKBOOK CLEANUP COMPLETE")


def validate_projected_workbook_cell_usage(
    sheets_service,
    spreadsheet_id,
    generated_sheet_name,
    required_rows,
    required_columns,
):
    sheet_props = get_sheet_properties_by_name(
        sheets_service=sheets_service,
        spreadsheet_id=spreadsheet_id,
        sheet_name=generated_sheet_name,
        force_refresh=True,
    )
    metadata = sheet_props["metadata"]
    current_total_cells, usage_rows = calculate_workbook_cell_usage(metadata)

    current_generated_cells = (
        sheet_props["row_count"] * sheet_props["column_count"]
    )
    planned_generated_cells = int(required_rows) * int(required_columns)
    projected_total_cells = (
        current_total_cells
        - current_generated_cells
        + planned_generated_cells
    )

    print("Google Sheets cell usage check:")
    print(f"  Current workbook cells : {current_total_cells:,}")
    print(
        f"  Current {generated_sheet_name} cells: "
        f"{current_generated_cells:,}"
    )
    print(
        f"  Planned {generated_sheet_name} cells: "
        f"{planned_generated_cells:,}"
    )
    print(f"  Projected workbook cells: {projected_total_cells:,}")
    print(f"  Workbook cell limit    : {GOOGLE_SHEETS_CELL_LIMIT:,}")

    if projected_total_cells > GOOGLE_SHEETS_CELL_LIMIT:
        log_top_sheet_cell_usage(usage_rows)

        raise RuntimeError(
            "Google Sheets cell limit would still be exceeded after "
            f"resizing generated sheet '{generated_sheet_name}' to the "
            f"required output size. Projected cells: "
            f"{projected_total_cells:,}; limit: "
            f"{GOOGLE_SHEETS_CELL_LIMIT:,}. Delete unused rows/columns "
            "from other tabs in the workbook, move archive tabs to another "
            "file, or reduce the raw output window before rerunning."
        )

    return {
        "current_total_cells": current_total_cells,
        "current_generated_cells": current_generated_cells,
        "planned_generated_cells": planned_generated_cells,
        "projected_total_cells": projected_total_cells,
        "usage_rows": usage_rows,
    }


def resize_generated_sheet_grid(
    sheets_service,
    spreadsheet_id,
    sheet_name,
    required_rows,
    required_columns,
):
    required_rows = int(max(required_rows or 1, 1))
    required_columns = int(max(required_columns or 1, 1))

    if not RESIZE_GENERATED_SHEETS_BEFORE_WRITE:
        return

    sheet_props = get_sheet_properties_by_name(
        sheets_service=sheets_service,
        spreadsheet_id=spreadsheet_id,
        sheet_name=sheet_name,
        force_refresh=True,
    )

    sheet_id = sheet_props["sheet_id"]
    current_rows = int(sheet_props["row_count"])
    current_columns = int(sheet_props["column_count"])

    print(
        f"Preparing generated sheet '{sheet_name}' size: "
        f"current {current_rows:,} rows x {current_columns:,} cols; "
        f"required {required_rows:,} rows x {required_columns:,} cols"
    )

    shrink_requests = []

    # Shrink rows first. This is the key fix for workbook cell-limit errors
    # when expanding the raw output from A:AK to A:AW.
    if current_rows > required_rows:
        shrink_requests.append(
            {
                "deleteDimension": {
                    "range": {
                        "sheetId": sheet_id,
                        "dimension": "ROWS",
                        "startIndex": required_rows,
                        "endIndex": current_rows,
                    }
                }
            }
        )
        current_rows = required_rows

    if current_columns > required_columns:
        shrink_requests.append(
            {
                "deleteDimension": {
                    "range": {
                        "sheetId": sheet_id,
                        "dimension": "COLUMNS",
                        "startIndex": required_columns,
                        "endIndex": current_columns,
                    }
                }
            }
        )
        current_columns = required_columns

    if shrink_requests:
        run_with_retry(
            f"Shrink generated sheet '{sheet_name}'",
            lambda: sheets_service.spreadsheets().batchUpdate(
                spreadsheetId=spreadsheet_id,
                body={"requests": shrink_requests},
            ).execute(),
        )
        invalidate_spreadsheet_metadata_cache(spreadsheet_id)

        sheet_props = get_sheet_properties_by_name(
            sheets_service=sheets_service,
            spreadsheet_id=spreadsheet_id,
            sheet_name=sheet_name,
            force_refresh=True,
        )
        current_rows = int(sheet_props["row_count"])
        current_columns = int(sheet_props["column_count"])

    grow_requests = []

    if current_columns < required_columns:
        grow_requests.append(
            {
                "appendDimension": {
                    "sheetId": sheet_id,
                    "dimension": "COLUMNS",
                    "length": required_columns - current_columns,
                }
            }
        )

    if current_rows < required_rows:
        grow_requests.append(
            {
                "appendDimension": {
                    "sheetId": sheet_id,
                    "dimension": "ROWS",
                    "length": required_rows - current_rows,
                }
            }
        )

    if grow_requests:
        run_with_retry(
            f"Grow generated sheet '{sheet_name}'",
            lambda: sheets_service.spreadsheets().batchUpdate(
                spreadsheetId=spreadsheet_id,
                body={"requests": grow_requests},
            ).execute(),
        )
        invalidate_spreadsheet_metadata_cache(spreadsheet_id)

    final_props = get_sheet_properties_by_name(
        sheets_service=sheets_service,
        spreadsheet_id=spreadsheet_id,
        sheet_name=sheet_name,
        force_refresh=True,
    )

    if (
        final_props["row_count"] < required_rows
        or final_props["column_count"] < required_columns
    ):
        raise RuntimeError(
            f"Sheet '{sheet_name}' was not resized correctly. "
            f"Required {required_rows} rows x {required_columns} columns, "
            f"but found {final_props['row_count']} rows x "
            f"{final_props['column_count']} columns."
        )

    print(
        f"Generated sheet '{sheet_name}' ready: "
        f"{final_props['row_count']:,} rows x "
        f"{final_props['column_count']:,} cols"
    )


def build_bounded_a1_range(
    sheet_name,
    start_column,
    end_column,
    start_row,
    end_row,
):
    return (
        f"{sheet_name}!"
        f"{start_column}{int(start_row)}:"
        f"{end_column}{int(end_row)}"
    )



def get_sheet_properties_by_gid(
    sheets_service,
    spreadsheet_id,
    sheet_gid,
):
    metadata = get_spreadsheet_metadata(
        sheets_service,
        spreadsheet_id,
    )

    for sheet in metadata.get("sheets", []):
        properties = sheet.get("properties", {})
        if int(properties.get("sheetId", -1)) == int(sheet_gid):
            return {
                "spreadsheet_title": (
                    metadata.get("properties", {}).get("title", "")
                ),
                "sheet_id": properties.get("sheetId"),
                "sheet_title": properties.get("title"),
                "row_count": (
                    properties.get("gridProperties", {})
                    .get("rowCount", 0)
                ),
                "column_count": (
                    properties.get("gridProperties", {})
                    .get("columnCount", 0)
                ),
            }

    available = [
        {
            "sheetId": sheet.get("properties", {}).get("sheetId"),
            "title": sheet.get("properties", {}).get("title"),
        }
        for sheet in metadata.get("sheets", [])
    ]

    raise ValueError(
        f"Sheet gid {sheet_gid} was not found in spreadsheet "
        f"{spreadsheet_id}. Available sheets: {available}"
    )


def quote_sheet_title_for_a1(sheet_title: str) -> str:
    escaped = str(sheet_title).replace("'", "''")
    return f"'{escaped}'"


