    return key


def _squad_focus_key_variants_v532(value: Any) -> Set[str]:
    """Return defensive squad-key variants for matching GUD and GUD Squad."""
    key = _squad_focus_key_v532(value)
    if not key:
        return set()
    variants = {key}
    if key.endswith(" squad"):
        variants.add(key[:-6].strip())
    else:
        variants.add(f"{key} squad")
    return {variant for variant in variants if variant}


def _focus_squad_rank_map_v532(focus_squads: Optional[Sequence[Any]]) -> Dict[str, int]:
    """Build an ordered lookup for focus squads used by Recommended Actions."""
    rank_map: Dict[str, int] = {}
    for index, squad in enumerate(focus_squads or []):
        for key in _squad_focus_key_variants_v532(squad):
            rank_map.setdefault(key, index)
    return rank_map


def _squad_priority_score_v532(row: pd.Series) -> float:
    """Risk score used only for ordering non-focus squads after focus squads."""
    rated = pd.to_numeric(pd.Series([row.get("Rated", 0)]), errors="coerce").fillna(0).iloc[0]
    non_smiley = pd.to_numeric(pd.Series([row.get("Non-Smiley", 0)]), errors="coerce").fillna(0).iloc[0]
    smiley_rate = pd.to_numeric(pd.Series([row.get("Smiley Rate", np.nan)]), errors="coerce").iloc[0]
    rate_delta = pd.to_numeric(pd.Series([row.get("Smiley Rate Delta pp", 0)]), errors="coerce").fillna(0).iloc[0]
    non_smiley_delta = pd.to_numeric(pd.Series([row.get("Non-Smiley Count Delta", 0)]), errors="coerce").fillna(0).iloc[0]
    contribution = pd.to_numeric(pd.Series([row.get("Contribution to Non-Smiley", 0)]), errors="coerce").fillna(0).iloc[0]

    smiley_pct = float(smiley_rate) * 100 if pd.notna(smiley_rate) else 0.0
    below_threshold_pressure = max(0.0, 80.0 - smiley_pct)
    negative_rate_pressure = max(0.0, -float(rate_delta))
    non_smiley_pressure = max(0.0, float(non_smiley_delta))

    return (
        float(non_smiley) * 8.0
        + float(contribution) * 100.0
        + below_threshold_pressure * 2.0
        + negative_rate_pressure * 1.5
        + non_smiley_pressure * 4.0
        + float(rated) * 0.05
    )


def _prioritize_squad_response_mix_frame_v532(
    squad_df: pd.DataFrame,
    focus_squads: Optional[Sequence[Any]] = None,
    config: AppConfig = CONFIG,
) -> pd.DataFrame:
    """
    Prioritize top focus squads from Recommended Actions, then fill remaining
    rows with highest-risk squads. This intentionally does NOT include every
    squad from the focus site.
    """
    if squad_df is None or squad_df.empty:
        return pd.DataFrame()

    work = squad_df.copy()
    focus_rank = _focus_squad_rank_map_v532(focus_squads)
    has_focus = bool(focus_rank)

    def row_focus_rank(row: pd.Series) -> int:
        if not has_focus:
            return 999999
        variants = _squad_focus_key_variants_v532(row.get("Squad", ""))
        matches = [focus_rank[key] for key in variants if key in focus_rank]
        return min(matches) if matches else 999999

    work["_Focus Rank v532"] = work.apply(row_focus_rank, axis=1)
    work["_Is Focus v532"] = work["_Focus Rank v532"].lt(999999)
    work["_Risk Score v532"] = work.apply(_squad_priority_score_v532, axis=1)

    return (
        work.sort_values(
            [
                "_Focus Rank v532",
                "_Is Focus v532",
                "_Risk Score v532",
                "Non-Smiley",
                "Rated",
                "Smiley Rate",
            ],
            ascending=[True, False, False, False, False, True],
            na_position="last",
        )
        .drop(columns=[
            column
            for column in ["_Focus Rank v532", "_Is Focus v532", "_Risk Score v532"]
            if column in work.columns
        ])
        .reset_index(drop=True)
    )


def _squad_response_mix_rows_v531(
    squad_df: pd.DataFrame,
    config: AppConfig = CONFIG,
    focus_squads: Optional[Sequence[Any]] = None,
) -> List[List[str]]:
    """Render squad response-mix rows with compact rolling deltas and Site."""
    if squad_df is None or squad_df.empty:
        return []

    limit = max(
        int(getattr(config, "finance_qa_top_topics_per_level", 10)),
        int(getattr(config, "top_squads_per_direction", 3)) * 2,
    )
    prioritized = _prioritize_squad_response_mix_frame_v532(
        squad_df=squad_df,
        focus_squads=focus_squads,
        config=config,
    )
    rows: List[List[str]] = []

    for _, row in prioritized.head(limit).iterrows():
        rated = pd.to_numeric(pd.Series([row.get("Rated", 0)]), errors="coerce").fillna(0).iloc[0]
        neutral = pd.to_numeric(pd.Series([row.get("Neutral", 0)]), errors="coerce").fillna(0).iloc[0]
        frownie = pd.to_numeric(pd.Series([row.get("Frownie", 0)]), errors="coerce").fillna(0).iloc[0]
        rows.append(
            [
                normalize_text(row.get("Site", "")) or "Unknown Site",
                normalize_text(row.get("Squad", "")),
                format_int(rated),
                format_int(neutral),
                format_int(frownie),
                format_rate(row.get("Smiley Rate")),
                _format_pp_delta_v527(row.get("Smiley Rate Delta pp")),
                _format_count_delta_v527(row.get("Smiley Count Delta"), positive_good=True),
                _format_count_delta_v527(row.get("Non-Smiley Count Delta"), positive_good=False),
                format_rate(row.get("Contribution to Non-Smiley")),
                normalize_text(row.get("Sample Status", "")),
            ]
        )

    return rows


def _squad_response_mix_narrative_v531(
    squad_df: pd.DataFrame,
    grain: Any,
    period_label: str,
    scope_name: str,
    focus_squads: Optional[Sequence[Any]] = None,
    config: AppConfig = CONFIG,
) -> str:
    """Create a concise Level-One-style narrative for squad response-mix tables."""
    if squad_df is None or squad_df.empty:
        return (
            f"{normalize_text(scope_name) or 'Selected scope'} squad readout for "
            f"{normalize_text(period_label) or normalize_text(grain).title()} has no "
            "qualifying squad rows for this grain."
        )

    limit = max(
        int(getattr(config, "finance_qa_top_topics_per_level", 10)),
        int(getattr(config, "top_squads_per_direction", 3)) * 2,
    )
    work = _prioritize_squad_response_mix_frame_v532(
        squad_df=squad_df,
        focus_squads=focus_squads,
        config=config,
    ).head(limit).copy()

    work["Rated Numeric"] = pd.to_numeric(work.get("Rated"), errors="coerce").fillna(0)
    work["Smiley Rate Numeric"] = pd.to_numeric(work.get("Smiley Rate"), errors="coerce")
    work["Contribution Numeric"] = pd.to_numeric(
        work.get("Contribution to Non-Smiley"),
        errors="coerce",
    )
    work["Rate Delta Numeric"] = pd.to_numeric(
        work.get("Smiley Rate Delta pp"),
        errors="coerce",
    )
    work["Smiley Count Delta Numeric"] = pd.to_numeric(
        work.get("Smiley Count Delta"),
        errors="coerce",
    )
    work["Non-Smiley Count Delta Numeric"] = pd.to_numeric(
        work.get("Non-Smiley Count Delta"),
        errors="coerce",
    )

    enough_volume = work[work["Rated Numeric"].ge(5)].copy()
    analysis_pool = enough_volume if not enough_volume.empty else work
    rolling_label = _squad_rolling_label_v531(grain)

    parts: List[str] = []
    grain_label = normalize_text(grain).title() or "Selected grain"
    period_text = normalize_text(period_label)
    scope_text = normalize_text(scope_name) or "Selected scope"
    opening = f"{scope_text} {grain_label} squad readout"
    if period_text:
        opening += f" for {period_text}"
    opening += f" versus {rolling_label.lower()}."
    parts.append(opening)

    focus_rank = _focus_squad_rank_map_v532(focus_squads)
    if focus_rank:
        focus_present: List[str] = []
        for _, row in work.iterrows():
            variants = _squad_focus_key_variants_v532(row.get("Squad", ""))
            if any(key in focus_rank for key in variants):
                label = normalize_text(row.get("Squad", ""))
                if label and label not in focus_present:
                    focus_present.append(label)
        if focus_present:
            parts.append(
                f"Focus squads prioritized in the table: "
                f"{_human_join(focus_present[:4])}."
            )

    valid_rate = analysis_pool[analysis_pool["Smiley Rate Numeric"].notna()].copy()
    if not valid_rate.empty:
        best = valid_rate.sort_values(
            ["Smiley Rate Numeric", "Rated Numeric"],
            ascending=[False, False],
        ).iloc[0]
        best_site = normalize_text(best.get("Site", ""))
        squad_label = normalize_text(best.get("Squad"))
        if best_site and best_site != "Unknown Site":
            squad_label = f"{best_site} / {squad_label}"
        parts.append(
            f"{squad_label} led Smiley Rate at "
            f"{format_rate(best.get('Smiley Rate Numeric'))} across "
            f"{int(best.get('Rated Numeric', 0)):,} rated responses."
        )

    valid_contribution = analysis_pool[
        analysis_pool["Contribution Numeric"].notna()
    ].copy()
    if not valid_contribution.empty:
        pressure = valid_contribution.sort_values(
            ["Contribution Numeric", "Rated Numeric"],
            ascending=[False, False],
        ).iloc[0]
        pressure_site = normalize_text(pressure.get("Site", ""))
        pressure_label = normalize_text(pressure.get("Squad"))
        if pressure_site and pressure_site != "Unknown Site":
            pressure_label = f"{pressure_site} / {pressure_label}"
        parts.append(
            f"{pressure_label} contributed the largest "
            f"non-smiley share at {format_rate(pressure.get('Contribution Numeric'))}."
        )

    valid_rate_delta = analysis_pool[
        analysis_pool["Rate Delta Numeric"].notna()
    ].copy()
    if not valid_rate_delta.empty:
        gain = valid_rate_delta.sort_values(
            "Rate Delta Numeric",
            ascending=False,
        ).iloc[0]
        drop = valid_rate_delta.sort_values(
            "Rate Delta Numeric",
            ascending=True,
        ).iloc[0]
        gain_value = float(gain.get("Rate Delta Numeric", 0))
        drop_value = float(drop.get("Rate Delta Numeric", 0))
        if gain_value > 0:
            parts.append(
                f"Biggest rate improvement: {normalize_text(gain.get('Squad'))} "
                f"({gain_value:+.1f} pp)."
            )
        if drop_value < 0:
            parts.append(
                f"Biggest rate regression: {normalize_text(drop.get('Squad'))} "
                f"({drop_value:+.1f} pp)."
            )

    valid_smiley_delta = analysis_pool[
        analysis_pool["Smiley Count Delta Numeric"].notna()
    ].copy()
    if not valid_smiley_delta.empty:
        smiley_gain = valid_smiley_delta.sort_values(
            "Smiley Count Delta Numeric",
            ascending=False,
        ).iloc[0]
        smiley_drop = valid_smiley_delta.sort_values(
            "Smiley Count Delta Numeric",
            ascending=True,
        ).iloc[0]
        gain_value = float(smiley_gain.get("Smiley Count Delta Numeric", 0))
        drop_value = float(smiley_drop.get("Smiley Count Delta Numeric", 0))
        if gain_value >= 0.5:
            parts.append(
                f"Smiley count increased most in {normalize_text(smiley_gain.get('Squad'))} "
                f"({gain_value:+.1f} vs {rolling_label.lower()})."
            )
        elif drop_value <= -0.5:
            parts.append(
                f"Smiley count declined most in {normalize_text(smiley_drop.get('Squad'))} "
                f"({drop_value:+.1f} vs {rolling_label.lower()})."
            )

    valid_non_smiley_delta = analysis_pool[
        analysis_pool["Non-Smiley Count Delta Numeric"].notna()
    ].copy()
    if not valid_non_smiley_delta.empty:
        pressure_increase = valid_non_smiley_delta.sort_values(
            "Non-Smiley Count Delta Numeric",
            ascending=False,
        ).iloc[0]
        pressure_decrease = valid_non_smiley_delta.sort_values(
            "Non-Smiley Count Delta Numeric",
            ascending=True,
        ).iloc[0]
        increase_value = float(
            pressure_increase.get("Non-Smiley Count Delta Numeric", 0)
        )
        decrease_value = float(
            pressure_decrease.get("Non-Smiley Count Delta Numeric", 0)
        )
        if increase_value >= 0.5:
            parts.append(
                f"Non-smiley pressure increased most in {normalize_text(pressure_increase.get('Squad'))} "
                f"({increase_value:+.1f} Neutral/Frownie responses vs {rolling_label.lower()})."
            )
        elif decrease_value <= -0.5:
            parts.append(
                f"Non-smiley pressure decreased most in {normalize_text(pressure_decrease.get('Squad'))} "
                f"({decrease_value:+.1f} Neutral/Frownie responses vs {rolling_label.lower()})."
            )

    return " ".join(part for part in parts if normalize_text(part))


def _v532_document_text_width_twips(document: Document) -> int:
    """Return usable document text width in twips for exact DOCX table sizing."""
    try:
        section = document.sections[0]
        width_emu = int(section.page_width) - int(section.left_margin) - int(section.right_margin)
        return max(1440, int(width_emu / 635))
    except Exception:
        # Landscape letter with 0.45" margins is roughly 14,544 twips usable.
        return 14544


def _v532_force_table_width_twips(
    table: Any,
    total_width_twips: int,
    column_count: int,
) -> None:
    """Force a table/grid to a fixed width so Google Docs imports it consistently."""
    try:
        if table is None or column_count <= 0:
            return
        table.alignment = WD_TABLE_ALIGNMENT.CENTER
        table.autofit = False
        try:
            table.allow_autofit = False
        except Exception:
            pass

        tbl_pr = table._tbl.tblPr
        tbl_w = tbl_pr.find(qn("w:tblW"))
        if tbl_w is None:
            tbl_w = OxmlElement("w:tblW")
            tbl_pr.append(tbl_w)
        tbl_w.set(qn("w:w"), str(int(total_width_twips)))
        tbl_w.set(qn("w:type"), "dxa")

        tbl_grid = table._tbl.find(qn("w:tblGrid"))
        if tbl_grid is None:
            tbl_grid = OxmlElement("w:tblGrid")
            table._tbl.insert(1, tbl_grid)
        for child in list(tbl_grid):
            tbl_grid.remove(child)

        base_width = max(1, int(total_width_twips / column_count))
        widths = [base_width for _ in range(column_count)]
        widths[-1] = int(total_width_twips) - sum(widths[:-1])
        for width in widths:
            grid_col = OxmlElement("w:gridCol")
            grid_col.set(qn("w:w"), str(max(1, int(width))))
            tbl_grid.append(grid_col)

        for row in table.rows:
            for index, cell in enumerate(row.cells):
                tc_pr = cell._tc.get_or_add_tcPr()
                tc_w = tc_pr.find(qn("w:tcW"))
                if tc_w is None:
                    tc_w = OxmlElement("w:tcW")
                    tc_pr.append(tc_w)
                tc_w.set(qn("w:w"), str(max(1, int(widths[min(index, len(widths) - 1)]))))
                tc_w.set(qn("w:type"), "dxa")
    except Exception as exc:
        logging.warning("Could not force squad DOCX table width: %s", exc)


def _docx_add_squad_narrative_callout_v532(
    document: Document,
    narrative: str,
    font_size: float = 7.2,
) -> Any:
    """
    Render the squad narrative as a standalone paragraph callout, not a DOCX table.

    v5.7.35: Google Docs imported the one-cell squad narrative table as a narrow
    left-side box in some reports, even when the same helper worked for taxonomy.
    To fully split the narrative from the squad table, this now uses a bordered,
    shaded paragraph. Paragraph shading/borders render at the body text width in
    Google Docs and will not be merged visually with the table grid below.
    """
    clean_narrative = normalize_text(narrative)
    if not clean_narrative:
        clean_narrative = (
            "Squad performance below is shown for the selected reporting grain."
        )

    paragraph = document.add_paragraph()
    paragraph.style = document.styles["Normal"]
    paragraph.alignment = WD_ALIGN_PARAGRAPH.LEFT
    paragraph.paragraph_format.left_indent = Pt(0)
    paragraph.paragraph_format.right_indent = Pt(0)
    paragraph.paragraph_format.first_line_indent = Pt(0)
    paragraph.paragraph_format.space_before = Pt(2)
    paragraph.paragraph_format.space_after = Pt(7)
    paragraph.paragraph_format.line_spacing = 1.08
    paragraph.paragraph_format.keep_together = True
    paragraph.paragraph_format.keep_with_next = False

    p_pr = paragraph._p.get_or_add_pPr()

    shd = p_pr.find(qn("w:shd"))
    if shd is None:
        shd = OxmlElement("w:shd")
        p_pr.append(shd)
    shd.set(qn("w:val"), "clear")
    shd.set(qn("w:color"), "auto")
    shd.set(qn("w:fill"), "EAF2F8")

    p_bdr = p_pr.find(qn("w:pBdr"))
    if p_bdr is None:
        p_bdr = OxmlElement("w:pBdr")
        p_pr.append(p_bdr)

    for border_name in ("top", "left", "bottom", "right"):
        border = p_bdr.find(qn(f"w:{border_name}"))
        if border is None:
            border = OxmlElement(f"w:{border_name}")
            p_bdr.append(border)
        border.set(qn("w:val"), "single")
        border.set(qn("w:sz"), "6")
        border.set(qn("w:space"), "4")
        border.set(qn("w:color"), "7F8EA3")

    run = paragraph.add_run(clean_narrative)
    run.bold = False
    run.font.size = Pt(font_size)
    run.font.color.rgb = RGBColor.from_string("1F2937")
    try:
        run.font.name = "Arial"
    except Exception:
        pass

    # Add a true paragraph boundary after the box so Google Docs does not visually
    # combine the callout with the following wide table.
    spacer = document.add_paragraph()
    spacer.paragraph_format.space_before = Pt(0)
    spacer.paragraph_format.space_after = Pt(2)
    return paragraph


def _docx_add_squad_response_mix_table_v531(
    document: Document,
    rows: Sequence[Sequence[Any]],
    grain: Any,
    font_size: float = 5.2,
) -> Any:
    """Add squad response-mix table using the same compact style as taxonomy."""
    headers = _squad_table_headers_for_grain_v531(grain)
    table = add_executive_table(
        document,
        headers=headers,
        rows=rows,
        font_size=font_size,
    )
    _v528_format_taxonomy_table_layout(table)
    _v532_force_table_width_twips(
        table,
        _v532_document_text_width_twips(document),
        len(headers),
    )
    return table



