@dataclass
class GoogleClients:
    credentials: Any
    sheets_client: gspread.Client
    drive_service: Any


def authenticate_google() -> GoogleClients:
    """
    Authenticate for Google Sheets and Drive.
    In Colab, this opens the standard Google authentication flow.
    """
    scopes = [
        "https://www.googleapis.com/auth/spreadsheets",
        "https://www.googleapis.com/auth/drive",
    ]

    try:
        from google.colab import auth as colab_auth  # type: ignore

        colab_auth.authenticate_user()
        LOGGER.info("Google Colab authentication completed.")
    except Exception as exc:
        LOGGER.info(
            "Colab authentication was not used. Falling back to default credentials: %s",
            exc,
        )

    credentials, _ = google_auth_default(scopes=scopes)
    sheets_client = gspread.authorize(credentials)
    drive_service = build_google_service(
        "drive", "v3", credentials=credentials, cache_discovery=False
    )
    return GoogleClients(
        credentials=credentials,
        sheets_client=sheets_client,
        drive_service=drive_service,
    )


def _is_non_retryable_payload_error(exc: Exception) -> bool:
    """
    Return True for deterministic local payload problems.

    Retrying API calls cannot resolve Python objects that are not JSON serializable.
    Detecting these errors prevents multi-minute exponential-backoff loops.
    """
    message = str(exc).lower()
    serialization_markers = (
        "not json serializable",
        "is not json serializable",
        "out of range float values are not json compliant",
        "circular reference detected",
    )
    return isinstance(exc, (TypeError, ValueError)) and any(
        marker in message for marker in serialization_markers
    )



_LAST_SHEETS_WRITE_AT = 0.0


def _is_google_sheets_quota_error(exc: Exception) -> bool:
    """Identify Google Sheets throttling / HTTP 429 failures."""
    message = str(exc).lower()
    markers = (
        "429",
        "quota exceeded",
        "rate limit exceeded",
        "resource_exhausted",
        "write requests per minute",
        "too many requests",
    )
    return any(marker in message for marker in markers)


def _pace_google_sheets_write(
    config: AppConfig = CONFIG,
) -> None:
    """Pace consecutive Sheets writes below the configured burst rate."""
    global _LAST_SHEETS_WRITE_AT

    minimum_interval = max(
        0.0,
        float(config.sheets_min_write_interval_seconds),
    )
    if minimum_interval <= 0:
        return

    elapsed = time.monotonic() - _LAST_SHEETS_WRITE_AT
    wait_seconds = minimum_interval - elapsed
    if wait_seconds > 0:
        time.sleep(wait_seconds)


def run_sheet_write_with_retry(
    operation,
    description: str,
    config: AppConfig = CONFIG,
):
    """
    Execute one Sheets write with pacing plus quota-aware retry.

    HTTP 429 gets a full rolling-window cooldown. Other transient failures
    continue to use exponential backoff.
    """
    global _LAST_SHEETS_WRITE_AT

    max_retries = max(1, int(config.sheets_max_retries))
    base_sleep = max(0.1, float(config.sheets_backoff_seconds))
    last_error: Optional[Exception] = None

    for attempt in range(1, max_retries + 1):
        _pace_google_sheets_write(config)
        try:
            result = operation()
            _LAST_SHEETS_WRITE_AT = time.monotonic()
            return result
        except Exception as exc:
            last_error = exc
            _LAST_SHEETS_WRITE_AT = time.monotonic()

            if _is_non_retryable_payload_error(exc):
                raise

            if attempt >= max_retries:
                break

            if _is_google_sheets_quota_error(exc):
                sleep_seconds = max(
                    float(config.sheets_quota_cooldown_seconds),
                    base_sleep * (2 ** (attempt - 1)),
                )
                LOGGER.warning(
                    "%s hit Google Sheets write quota on attempt %d/%d. "
                    "Cooling down %.1fs before retrying.",
                    description,
                    attempt,
                    max_retries,
                    sleep_seconds,
                )
            else:
                sleep_seconds = min(
                    60.0,
                    base_sleep * (2 ** (attempt - 1))
                    + random.uniform(0, 1),
                )
                LOGGER.warning(
                    "%s failed on attempt %d/%d: %s. Retrying in %.1fs.",
                    description,
                    attempt,
                    max_retries,
                    exc,
                    sleep_seconds,
                )

            time.sleep(sleep_seconds)

    raise RuntimeError(
        f"{description} failed after {max_retries} attempts."
    ) from last_error

def run_with_retry(
    operation,
    description: str,
    max_retries: int = CONFIG.sheets_max_retries,
    base_sleep: float = CONFIG.sheets_backoff_seconds,
):
    last_error: Optional[Exception] = None
    for attempt in range(1, max_retries + 1):
        try:
            return operation()
        except Exception as exc:
            last_error = exc

            if _is_non_retryable_payload_error(exc):
                LOGGER.error(
                    "%s failed because the request payload is not JSON-safe: %s",
                    description,
                    exc,
                )
                raise

            if attempt >= max_retries:
                break
            sleep_seconds = min(
                60.0,
                base_sleep * (2 ** (attempt - 1)) + random.uniform(0, 1),
            )
            LOGGER.warning(
                "%s failed on attempt %d/%d: %s. Retrying in %.1fs.",
                description,
                attempt,
                max_retries,
                exc,
                sleep_seconds,
            )
            time.sleep(sleep_seconds)
    raise RuntimeError(f"{description} failed after {max_retries} attempts.") from last_error


def open_source_spreadsheet(
    clients: GoogleClients,
    config: AppConfig = CONFIG,
):
    return run_with_retry(
        lambda: clients.sheets_client.open_by_key(config.spreadsheet_id),
        "Open source spreadsheet",
    )


def load_source_values(
    spreadsheet,
    config: AppConfig = CONFIG,
) -> pd.DataFrame:
    worksheet = run_with_retry(
        lambda: spreadsheet.worksheet(config.source_tab),
        f"Open source tab '{config.source_tab}'",
    )
    values = run_with_retry(
        lambda: worksheet.get(config.source_range),
        f"Read {config.source_tab}!{config.source_range}",
    )

    if not values:
        raise ValueError(
            f"No data found in {config.source_tab}!{config.source_range}."
        )

    header = [normalize_text(value) for value in values[0]]
    if not any(header):
        raise ValueError("The source range contains an empty header row.")

    width = len(header)
    normalized_rows = []
    for row in values[1:]:
        padded = list(row[:width]) + [""] * max(0, width - len(row))
        normalized_rows.append(padded[:width])

    df = pd.DataFrame(normalized_rows, columns=header)
    LOGGER.info("Loaded %d raw rows and %d columns.", len(df), len(df.columns))
    return df


def _format_sheet_datetime(value: Any) -> str:
    """Format datetime-like values consistently for Google Sheets."""
    timestamp = pd.Timestamp(value)
    if pd.isna(timestamp):
        return ""

    if (
        timestamp.hour == 0
        and timestamp.minute == 0
        and timestamp.second == 0
        and timestamp.microsecond == 0
    ):
        return timestamp.strftime("%Y-%m-%d")
    return timestamp.strftime("%Y-%m-%d %H:%M:%S")


def _json_safe_sheet_cell(value: Any) -> Any:
    """
    Convert one value to a Google Sheets / JSON-safe scalar.

    This intentionally handles datetime objects inside object-dtype columns.
    Pandas commonly creates mixed object columns such as the Filter_Summary
    ``Value`` column, where a pd.Timestamp is not detected by a column-level
    datetime dtype check.
    """
    if value is None or value is pd.NA:
        return ""

    if isinstance(value, Mapping):
        normalized_mapping = {
            str(key): _json_safe_sheet_cell(item)
            for key, item in value.items()
        }
        return json.dumps(
            normalized_mapping,
            ensure_ascii=False,
            sort_keys=True,
        )

    if isinstance(value, (list, tuple, set, frozenset, np.ndarray, pd.Series)):
        normalized_items = [_json_safe_sheet_cell(item) for item in list(value)]
        return json.dumps(normalized_items, ensure_ascii=False)

    if isinstance(value, (pd.Timestamp, datetime, date, np.datetime64)):
        return _format_sheet_datetime(value)

    if isinstance(value, pd.Period):
        return str(value)

    if isinstance(value, (pd.Timedelta, timedelta, np.timedelta64)):
        return str(pd.Timedelta(value))

    if isinstance(value, (np.bool_, bool)):
        return bool(value)

    if isinstance(value, (np.integer,)):
        return int(value)

    if isinstance(value, (np.floating, float, Decimal)):
        numeric_value = float(value)
        return numeric_value if math.isfinite(numeric_value) else ""

    if isinstance(value, int):
        return value

    if isinstance(value, bytes):
        return value.decode("utf-8", errors="replace")

    try:
        missing = pd.isna(value)
        if isinstance(missing, (bool, np.bool_)) and bool(missing):
            return ""
    except (TypeError, ValueError):
        pass

    if isinstance(value, str):
        return value

    # Google Sheets accepts strings, numbers, and booleans. Stringifying an
    # unknown object is safer than sending a custom Python object to requests.
    return str(value)


def _spreadsheet_values(df: pd.DataFrame) -> List[List[Any]]:
    """
    Convert a DataFrame into a JSON-safe two-dimensional list.

    Every cell is normalized individually instead of relying only on pandas
    column dtypes. This fixes mixed object columns containing pd.Timestamp,
    numpy scalars, nested objects, NaT, pd.NA, or infinite values.
    """
    if df is None:
        df = pd.DataFrame()
    if not isinstance(df, pd.DataFrame):
        df = pd.DataFrame(df)

    values: List[List[Any]] = [
        [_json_safe_sheet_cell(column) for column in df.columns]
    ]
    values.extend(
        [
            [_json_safe_sheet_cell(value) for value in row]
            for row in df.itertuples(index=False, name=None)
        ]
    )
    return values


def _strict_json_sheet_payload(
    payload: Sequence[Sequence[Any]],
    worksheet_title: str,
    start_row: int,
) -> List[List[Any]]:
    """
    Convert and validate a Google Sheets payload using a JSON round trip.

    The round trip guarantees that gspread/simplejson receives only plain
    Python strings, numbers, booleans, lists, and null-safe values. This
    prevents pd.Timestamp values hidden inside mixed object columns from
    reaching the API request body.
    """
    normalized = [
        [_json_safe_sheet_cell(value) for value in row]
        for row in payload
    ]
    try:
        encoded = json.dumps(
            normalized,
            ensure_ascii=False,
            allow_nan=False,
        )
        decoded = json.loads(encoded)
    except (TypeError, ValueError) as exc:
        end_row = start_row + max(0, len(payload) - 1)
        raise TypeError(
            f"Worksheet '{worksheet_title}' rows {start_row}-{end_row} "
            f"contain a value that cannot be serialized to JSON: {exc}"
        ) from exc
    return decoded




def _local_a1_range_for_worksheet_batch_v537(
    range_name: Any,
) -> str:
    """
    Return a worksheet-local A1 range for Worksheet.batch_update.

    gspread mutates batch_update payload ranges by prefixing the worksheet
    title before sending the request. If the same list object is retried, the
    title can be prefixed repeatedly and Google Sheets rejects the request as
    an invalid range. This helper strips any existing sheet prefix so each
    retry starts from a clean worksheet-local range.
    """
    raw = normalize_text(range_name)
    if not raw:
        return "A1"

    # Keep only the part after the final !. This safely converts:
    #   "'Finance_DOM_Detail'!A1:AW156" -> "A1:AW156"
    #   "'Finance_DOM_Detail'!'Finance_DOM_Detail'!A1:AW156" -> "A1:AW156"
    if "!" in raw:
        raw = raw.split("!")[-1]

    raw = raw.strip().strip("'").strip('"').replace("$", "")
    return raw or "A1"


def _fresh_worksheet_batch_payload_v537(
    data: Sequence[Mapping[str, Any]],
) -> List[Dict[str, Any]]:
    """
    Build a fresh Worksheet.batch_update payload for every retry.

    The key safety point is that this returns a new list/dict object and uses a
    worksheet-local A1 range. This prevents repeated retry attempts from
    accumulating duplicated sheet names such as:
      'Finance_DOM_Detail'!Finance_DOM_Detail'!A1:AW156
    """
    fresh_payload: List[Dict[str, Any]] = []
    for entry in data or []:
        if not isinstance(entry, Mapping):
            continue
        fresh_payload.append(
            {
                "range": _local_a1_range_for_worksheet_batch_v537(
                    entry.get("range", "A1")
                ),
                "values": copy.deepcopy(entry.get("values", [])),
            }
        )
    return fresh_payload

def _validate_json_safe_sheet_payload(
    payload: Sequence[Sequence[Any]],
    worksheet_title: str,
    start_row: int,
) -> None:
    """Backward-compatible validator for callers that only need validation."""
    _strict_json_sheet_payload(payload, worksheet_title, start_row)



def _ensure_worksheet(
    spreadsheet,
    title: str,
    rows: int,
    cols: int,
    config: AppConfig = CONFIG,
):
    """
    Return an existing worksheet or create it with quota-aware write handling.

    Grid resizing is centralized in write_dataframe_to_sheet so worksheet
    lookup cannot trigger an unprotected resize request.
    """
    if is_docs_only_staging_mode_v563(config):
        raise RuntimeError(
            "Google Sheets worksheet creation is disabled in docs-only staging mode. "
            f"Attempted worksheet: {title!r}. The Whitepaper script reads raw!A:AV "
            "and publishes Google Docs only."
        )

    try:
        return spreadsheet.worksheet(title)
    except gspread.WorksheetNotFound:
        return run_sheet_write_with_retry(
            lambda: spreadsheet.add_worksheet(
                title=title,
                rows=max(100, rows),
                cols=max(20, cols),
            ),
            f"Create worksheet {title}",
            config,
        )




def _column_letter(index_1_based: int) -> str:
    result = ""
    n = index_1_based
    while n:
        n, remainder = divmod(n - 1, 26)
        result = chr(65 + remainder) + result
    return result



def write_dataframe_to_sheet(
    spreadsheet,
    title: str,
    df: pd.DataFrame,
    config: AppConfig = CONFIG,
) -> str:
    """
    Replace one worksheet with quota-efficient batched writes.

    All data chunks are submitted in one value batch request, and all
    formatting is submitted in one Sheets batch_update request.
    """
    if is_docs_only_staging_mode_v563(config):
        LOGGER.info(
            "Docs-only staging mode active; skipped Google Sheets tab write: %s",
            title,
        )
        return ""

    df = pd.DataFrame() if df is None else df.copy()
    values = _spreadsheet_values(df)

    row_count = max(2, len(values))
    col_count = max(1, len(df.columns))

    # Guarantee the payload covers every cell in the exact output grid so an
    # old second row cannot survive when a DataFrame becomes empty.
    if not values:
        values = [[""] * col_count]
    values = [
        list(row) + [""] * max(0, col_count - len(row))
        for row in values
    ]
    while len(values) < row_count:
        values.append([""] * col_count)

    worksheet = _ensure_worksheet(
        spreadsheet,
        title,
        row_count,
        col_count,
        config,
    )

    existing_rows = int(getattr(worksheet, "row_count", 0) or 0)
    existing_cols = int(getattr(worksheet, "col_count", 0) or 0)

    # Exact sizing removes stale rows/columns from a prior larger run.
    if existing_rows != row_count or existing_cols != col_count:
        run_sheet_write_with_retry(
            lambda: worksheet.resize(
                rows=row_count,
                cols=col_count,
            ),
            f"Resize worksheet {title}",
            config,
        )

    rows_per_chunk = max(
        1,
        int(config.sheets_max_cells_per_update)
        // max(1, col_count),
    )

    batch_data: List[Dict[str, Any]] = []
    for start in range(0, len(values), rows_per_chunk):
        chunk = values[start:start + rows_per_chunk]
        start_row = start + 1
        end_row = start_row + len(chunk) - 1
        end_col = _column_letter(col_count)
        range_name = f"A{start_row}:{end_col}{end_row}"

        safe_chunk = _strict_json_sheet_payload(
            payload=chunk,
            worksheet_title=title,
            start_row=start_row,
        )
        batch_data.append(
            {
                "range": range_name,
                "values": safe_chunk,
            }
        )

    if batch_data:
        run_sheet_write_with_retry(
            lambda: worksheet.batch_update(
                data=_fresh_worksheet_batch_payload_v537(batch_data),
                value_input_option="USER_ENTERED",
            ),
            f"Batch write worksheet {title}",
            config,
        )

    if not bool(config.sheets_batch_formatting):
        return title

    requests: List[Dict[str, Any]] = [
        {
            "updateSheetProperties": {
                "properties": {
                    "sheetId": worksheet.id,
                    "gridProperties": {
                        "frozenRowCount": 1,
                    },
                },
                "fields": "gridProperties.frozenRowCount",
            }
        },
        {
            "repeatCell": {
                "range": {
                    "sheetId": worksheet.id,
                    "startRowIndex": 0,
                    "endRowIndex": 1,
                    "startColumnIndex": 0,
                    "endColumnIndex": col_count,
                },
                "cell": {
                    "userEnteredFormat": {
                        "backgroundColor": {
                            "red": 0.0,
                            "green": 0.125,
                            "blue": 0.376,
                        },
                        "textFormat": {
                            "foregroundColor": {
                                "red": 1.0,
                                "green": 1.0,
                                "blue": 1.0,
                            },
                            "bold": True,
                        },
                        "horizontalAlignment": "CENTER",
                        "verticalAlignment": "MIDDLE",
                    }
                },
                "fields": "userEnteredFormat",
            }
        },
        {
            "repeatCell": {
                "range": {
                    "sheetId": worksheet.id,
                    "startRowIndex": 1,
                    "endRowIndex": row_count,
                    "startColumnIndex": 0,
                    "endColumnIndex": col_count,
                },
                "cell": {
                    "userEnteredFormat": {
                        "verticalAlignment": "MIDDLE",
                    }
                },
                "fields": "userEnteredFormat.verticalAlignment",
            }
        },
    ]

    percent_columns = [
        idx
        for idx, column in enumerate(df.columns)
        if (
            " Rate" in str(column)
            or str(column).endswith("_rate")
            or (
                "Baseline" in str(column)
                and "pp" not in str(column)
            )
            or (
                "Projection" in str(column)
                and "pp" not in str(column)
            )
            or "Pass Rate" in str(column)
        )
    ]

    for col_idx in percent_columns:
        requests.append(
            {
                "repeatCell": {
                    "range": {
                        "sheetId": worksheet.id,
                        "startRowIndex": 1,
                        "endRowIndex": row_count,
                        "startColumnIndex": col_idx,
                        "endColumnIndex": col_idx + 1,
                    },
                    "cell": {
                        "userEnteredFormat": {
                            "numberFormat": {
                                "type": "PERCENT",
                                "pattern": "0.00%",
                            }
                        }
                    },
                    "fields": "userEnteredFormat.numberFormat",
                }
            }
        )

    requests.append(
        {
            "autoResizeDimensions": {
                "dimensions": {
                    "sheetId": worksheet.id,
                    "dimension": "COLUMNS",
                    "startIndex": 0,
                    "endIndex": col_count,
                }
            }
        }
    )

    try:
        run_sheet_write_with_retry(
            lambda: spreadsheet.batch_update(
                {"requests": requests}
            ),
            f"Format worksheet {title}",
            config,
        )
    except Exception as exc:
        # Successful data should remain usable even if cosmetic formatting
        # cannot be applied after all retries.
        LOGGER.warning(
            "Sheet formatting warning for %s after retries: %s",
            title,
            exc,
        )

    return title





def _ensure_worksheet_min_grid_v554(
    worksheet,
    title: str,
    min_rows: int,
    min_cols: int,
    config: AppConfig = CONFIG,
) -> None:
    """
    Ensure a worksheet grid is large enough before a range-based write.

    Google Sheets value batch updates are not true appends: the target A1
    range must already exist inside the worksheet grid. The
    Executive_Report_Links tab is created with 100 rows by default, so the
    101st link write can fail with:
        Range (Executive_Report_Links!A101) exceeds grid limits.
    This helper grows the sheet immediately before appending while preserving
    the v5.7.37 fresh-payload/range-safety behavior.
    """
    current_rows = int(getattr(worksheet, "row_count", 0) or 0)
    current_cols = int(getattr(worksheet, "col_count", 0) or 0)

    target_rows = max(100, current_rows, int(min_rows))
    target_cols = max(1, current_cols, int(min_cols))

    if current_rows >= target_rows and current_cols >= target_cols:
        return

    run_sheet_write_with_retry(
        lambda: worksheet.resize(rows=target_rows, cols=target_cols),
        f"Resize worksheet {title} before append",
        config,
    )


def append_report_link_row(
    spreadsheet,
    row_data: Dict[str, Any],
    config: AppConfig = CONFIG,
) -> str:
    """Append one docs-only report-link row with quota-aware writes."""
    title = "Executive_Report_Links"
    if is_docs_only_staging_mode_v563(config):
        LOGGER.info(
            "Docs-only staging mode active; skipped report-link write to %s.",
            title,
        )
        return ""
    columns = [
        "Generated At",
        "Reporting Month",
        "LOB",
        "Grain",
        "Data Through",
        "Google Docs Report",
        "Shared Drive Folder",
        "Dashboard Image",
    ]

    worksheet = _ensure_worksheet(
        spreadsheet,
        title,
        100,
        len(columns),
        config,
    )
    existing = run_with_retry(
        lambda: worksheet.get_all_values(),
        f"Read worksheet {title}",
    )

    existing_rows = int(
        getattr(worksheet, "row_count", 100) or 100
    )
    existing_cols = int(
        getattr(worksheet, "col_count", len(columns))
        or len(columns)
    )
    if existing_cols != len(columns):
        run_sheet_write_with_retry(
            lambda: worksheet.resize(
                rows=max(100, existing_rows),
                cols=len(columns),
            ),
            f"Resize worksheet {title}",
            config,
        )

    current_header = (
        [normalize_text(value) for value in existing[0]]
        if existing
        else []
    )
    header_matches = current_header == columns

    if existing and not header_matches:
        run_sheet_write_with_retry(
            lambda: worksheet.batch_clear(["A:ZZ"]),
            f"Clear worksheet {title} after schema change",
            config,
        )
        existing = []

    next_row = len(existing) + 1 if existing else 2
    values = [
        [
            _json_safe_sheet_cell(
                row_data.get(column, "")
            )
            for column in columns
        ]
    ]
    values = _strict_json_sheet_payload(
        payload=values,
        worksheet_title=title,
        start_row=next_row,
    )

    updates: List[Dict[str, Any]] = []
    if not existing:
        updates.append(
            {
                "range": "A1",
                "values": [columns],
            }
        )
    updates.append(
        {
            "range": f"A{next_row}",
            "values": values,
        }
    )

    # v5.7.54: range-based Worksheet.batch_update requires the target row to
    # already be inside the worksheet grid. Grow the audit-link tab before
    # writing so row 101+ appends do not fail after the default 100-row grid.
    required_rows = max(
        next_row,
        1 if existing else 2,
    )
    required_cols = len(columns)
    _ensure_worksheet_min_grid_v554(
        worksheet=worksheet,
        title=title,
        min_rows=required_rows,
        min_cols=required_cols,
        config=config,
    )

    run_sheet_write_with_retry(
        lambda: worksheet.batch_update(
            data=_fresh_worksheet_batch_payload_v537(updates),
            value_input_option="USER_ENTERED",
        ),
        f"Append worksheet {title}",
        config,
    )

    if not existing:
        try:
            run_sheet_write_with_retry(
                lambda: spreadsheet.batch_update(
                    {
                        "requests": [
                            {
                                "updateSheetProperties": {
                                    "properties": {
                                        "sheetId": worksheet.id,
                                        "gridProperties": {
                                            "frozenRowCount": 1,
                                        },
                                    },
                                    "fields": (
                                        "gridProperties.frozenRowCount"
                                    ),
                                }
                            },
                            {
                                "repeatCell": {
                                    "range": {
                                        "sheetId": worksheet.id,
                                        "startRowIndex": 0,
                                        "endRowIndex": 1,
                                        "startColumnIndex": 0,
                                        "endColumnIndex": len(columns),
                                    },
                                    "cell": {
                                        "userEnteredFormat": {
                                            "backgroundColor": {
                                                "red": 0.0,
                                                "green": 0.125,
                                                "blue": 0.376,
                                            },
                                            "textFormat": {
                                                "foregroundColor": {
                                                    "red": 1.0,
                                                    "green": 1.0,
                                                    "blue": 1.0,
                                                },
                                                "bold": True,
                                            },
                                        }
                                    },
                                    "fields": "userEnteredFormat",
                                }
                            },
                        ]
                    }
                ),
                f"Format worksheet {title}",
                config,
            )
        except Exception as exc:
            LOGGER.warning(
                "Could not format Executive_Report_Links "
                "after retries: %s",
                exc,
            )

    return title





