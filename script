            "Rated": "Previous Rated",
            "Smiley Rate": "Previous Smiley Rate",
            "Unhappy Rate": "Previous Unhappy Rate",
        }
    )
    output = current.merge(
        previous_keep,
        on="Segment",
        how="left",
    )
    output["Smiley Delta vs Previous (pp)"] = (
        output["Smiley Rate"] - output["Previous Smiley Rate"]
    ) * 100
    output["Unhappy Delta vs Previous (pp)"] = (
        output["Unhappy Rate"] - output["Previous Unhappy Rate"]
    ) * 100
    output["Smiley Trend Status"] = output.apply(
        lambda row: comparison_status(
            row.get("Smiley Rate"),
            row.get("Previous Smiley Rate"),
            higher_is_better=True,
            config=config,
        ),
        axis=1,
    )
    output["Unhappy Trend Status"] = output.apply(
        lambda row: comparison_status(
            row.get("Unhappy Rate"),
            row.get("Previous Unhappy Rate"),
            higher_is_better=False,
            config=config,
        ),
        axis=1,
    )

    volume_values = output.apply(
        lambda row: volume_change_metrics(
            row.get("Rated"),
            row.get("Previous Rated"),
            config,
        ),
        axis=1,
    )
    output["Volume Change %"] = [
        value[0] for value in volume_values
    ]
    output["Volume Status"] = [
        value[1] for value in volume_values
    ]
    return output


def _comparison_columns_for_qa(
    current: pd.DataFrame,
    previous: pd.DataFrame,
    config: AppConfig = CONFIG,
) -> pd.DataFrame:
    if current is None or current.empty:
        return current

    previous_keep = previous[
        [
            "QA Attribute",
            "Finance Audited",
            "Finance Pass Rate",
            "Other Audited",
            "Other Pass Rate",
            "Finance Neutral Audited",
            "Finance Neutral Failure Rate",
            "Finance Frownie Audited",
            "Finance Frownie Failure Rate",
        ]
    ].rename(
        columns={
            "Finance Audited": "Previous Finance Audited",
            "Finance Pass Rate": "Previous Finance Pass Rate",
            "Other Audited": "Previous Other Audited",
            "Other Pass Rate": "Previous Other Pass Rate",
            "Finance Neutral Audited": (
                "Previous Finance Neutral Audited"
            ),
            "Finance Neutral Failure Rate": (
                "Previous Finance Neutral Failure Rate"
            ),
            "Finance Frownie Audited": (
                "Previous Finance Frownie Audited"
            ),
            "Finance Frownie Failure Rate": (
                "Previous Finance Frownie Failure Rate"
            ),
        }
    )
    output = current.merge(
        previous_keep,
        on="QA Attribute",
        how="left",
    )

    for prefix, higher_is_better in [
        ("Finance Pass", True),
        ("Other Pass", True),
        ("Finance Neutral Failure", False),
        ("Finance Frownie Failure", False),
    ]:
        current_column = f"{prefix} Rate"
        previous_column = f"Previous {prefix} Rate"
        delta_column = f"{prefix} Delta vs Previous (pp)"
        status_column = f"{prefix} Trend Status"

        output[delta_column] = (
            output[current_column] - output[previous_column]
        ) * 100
        output[status_column] = output.apply(
            lambda row, current_col=current_column,
            previous_col=previous_column,
            higher=higher_is_better: comparison_status(
                row.get(current_col),
                row.get(previous_col),
                higher_is_better=higher,
                config=config,
            ),
            axis=1,
        )

    return output


def build_finance_qa_grain_analyses(
    filtered_df: pd.DataFrame,
    grain_results: Mapping[str, GrainResult],
    config: AppConfig = CONFIG,
) -> Dict[str, FinanceQAGrainAnalysis]:
    """Preserve v5.3 Finance/QA outputs and add prior-equivalent comparisons."""
    analyses = _v532_build_finance_qa_grain_analyses(
        filtered_df=filtered_df,
        grain_results=grain_results,
        config=config,
    )
    classified = _prepare_finance_qa_source_utc(
        filtered_df,
        config,
    )

    for grain, analysis in analyses.items():
        result = grain_results.get(grain)
        if result is None:
            continue

        metric = result.overall
        previous_start = metric.previous_period_start
        previous_end = metric.previous_period_end
        previous_df = classified[
            classified["Created Date"].between(
                previous_start,
                previous_end,
                inclusive="both",
            )
        ].copy()

        previous_population = _finance_population_summary(
            previous_df
        )
        previous_qa = _finance_qa_attribute_summary(
            previous_df,
            config,
        )
        analysis.population_summary = _comparison_columns_for_population(
            analysis.population_summary,
            previous_population,
            config,
        )
        analysis.qa_attribute_summary = _comparison_columns_for_qa(
            analysis.qa_attribute_summary,
            previous_qa,
            config,
        )
        analysis.previous_period_start = previous_start
        analysis.previous_period_end = previous_end
        analysis.previous_period_label = metric.previous_period_label

        finance_rows = analysis.population_summary[
            analysis.population_summary["Segment"].eq("Finance")
        ]
        if not finance_rows.empty:
            finance_row = finance_rows.iloc[0]
            analysis.insights.append(
                "Previous-timeframe Finance indicator: "
                f"{finance_row.get('Unhappy Trend Status', 'N/A')} "
                f"({finance_row.get('Unhappy Delta vs Previous (pp)', np.nan):+.1f} pp) "
                f"versus {metric.previous_period_label}; "
                f"{finance_row.get('Volume Status', 'N/A')}."
            )
        analysis.validation_notes.append(
            "Previous-timeframe comparison uses "
            f"{metric.comparison_basis}: {metric.previous_period_label}."
        )

    return analyses


