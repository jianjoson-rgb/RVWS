def _chart_ylim(
    values: Sequence[float],
    config: AppConfig = CONFIG,
) -> Tuple[float, float]:
    valid = [float(v) for v in values if v is not None and pd.notna(v)]
    valid.extend([config.target_rate])
    if not valid:
        return config.chart_y_min, config.chart_y_max

    low = min(valid)
    high = max(valid)
    y_min = min(config.chart_y_min, math.floor((low - 0.03) * 20) / 20)
    y_max = max(config.chart_y_max, math.ceil((high + 0.03) * 20) / 20)
    y_min = max(0.0, y_min)
    y_max = min(1.0, y_max)
    if y_max - y_min < 0.20:
        center = (y_max + y_min) / 2
        y_min = max(0, center - 0.10)
        y_max = min(1, center + 0.10)
    return y_min, y_max


def _style_main_axis(
    ax,
    y_min: float,
    y_max: float,
    config: AppConfig = CONFIG,
) -> None:
    ax.set_ylim(y_min, y_max)
    ax.yaxis.set_major_formatter(ticker.PercentFormatter(xmax=1.0, decimals=0))
    ax.grid(axis="y", color=config.chart_grid_color, linewidth=0.8, alpha=0.85)
    ax.grid(axis="x", visible=False)
    ax.spines["top"].set_visible(False)
    ax.spines["right"].set_visible(False)
    ax.spines["left"].set_color("#C7CDD4")
    ax.spines["bottom"].set_color("#C7CDD4")
    ax.tick_params(axis="both", labelsize=9, colors="#182234")
    ax.set_axisbelow(True)


def _add_panel_border(fig, ax_left, ax_right, config: AppConfig = CONFIG) -> None:
    left_box = ax_left.get_position()
    right_box = ax_right.get_position()
    x0 = left_box.x0 - 0.018
    y0 = min(left_box.y0, right_box.y0) - 0.040
    x1 = right_box.x1 + 0.012
    y1 = max(left_box.y1, right_box.y1) + 0.082
    patch = FancyBboxPatch(
        (x0, y0),
        x1 - x0,
        y1 - y0,
        transform=fig.transFigure,
        boxstyle="round,pad=0.006,rounding_size=0.008",
        facecolor="white",
        edgecolor=config.chart_border_color,
        linewidth=0.8,
        zorder=-20,
    )
    fig.patches.append(patch)


def _add_reference_lines(
    ax,
    baseline_rate: float,
    target_rate: float,
    config: AppConfig = CONFIG,
    baseline_label: str = "Average",
) -> None:
    if pd.notna(baseline_rate):
        ax.axhline(
            baseline_rate,
            color=config.chart_average_color,
            linestyle=(0, (5, 5)),
