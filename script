def resolve_site_detail_sites(
    lob_mode: str,
    config: AppConfig = CONFIG,
) -> Tuple[str, ...]:
    """
    Return the approved detailed-site list for the selected LOB.

    Executive metrics are never restricted by this list. It controls only
    per-site narratives, site visuals, squad analysis, QA heatmaps, and
    site-level scrubbed-ticket sections.
    """
    mode = normalize_text(lob_mode).upper()
    mapping = {
        normalize_text(key).upper(): tuple(
            normalize_text(site).upper()
            for site in value
            if normalize_text(site)
        )
        for key, value in dict(config.site_detail_sites_by_lob).items()
    }
    if mode not in mapping:
        fallback = tuple(
            normalize_text(site).upper()
            for site in config.site_detail_sites
            if normalize_text(site)
        )
        if not fallback:
            raise ValueError(
                f"No detailed-site configuration exists for LOB {mode!r}."
            )
        return fallback

    sites = tuple(dict.fromkeys(mapping[mode]))
    if not sites:
        raise ValueError(
            f"The detailed-site configuration for LOB {mode!r} is empty."
        )
    return sites


def approved_site_set(config: AppConfig = CONFIG) -> set[str]:
    """Return normalized approved document-facing sites for the active LOB."""
    return {
        normalize_text(site).upper()
        for site in config.site_detail_sites
        if normalize_text(site)
    }


def filter_rows_to_approved_sites(
    df: Optional[pd.DataFrame],
    config: AppConfig = CONFIG,
) -> pd.DataFrame:
    """
    Restrict a DataFrame to approved document-facing sites.

    This helper is intentionally not used for executive overall calculations or
    the overall trend dashboard. It is used only for document-facing narratives,
    tables, QA summaries, and scrubbed-ticket appendices.
    """
    if df is None or not isinstance(df, pd.DataFrame):
        return pd.DataFrame()
    work = df.copy()
    if not config.document_approved_sites_only or "Site" not in work.columns:
        return work
    allowed = approved_site_set(config)
    normalized_site = (
        work["Site"].fillna("").astype(str).str.strip().str.upper()
    )
    return work[normalized_site.isin(allowed)].copy()


def build_document_grain_results(
    grain_results: Mapping[str, "GrainResult"],
    config: AppConfig = CONFIG,
) -> Dict[str, "GrainResult"]:
    """
    Create document-safe GrainResult objects.

    Overall PeriodMetric values remain unchanged and therefore still represent
    every site in the selected LOB. Site- and squad-level rows used to name
    drivers in Google Docs, email summaries, and published support tabs are
    restricted to the approved site list. Reconciliation retains approved sites
    plus aggregate subtotal rows, so non-approved site names are never exposed.
    The original grain_results remain available for graph generation and internal
    all-site calculations.
    """
    allowed = approved_site_set(config)
    aggregate_labels = {
        "DISPLAYED SITES SUBTOTAL",
        "OTHER SITES SUBTOTAL",
        "EXECUTIVE ALL SITES",
    }

    output: Dict[str, GrainResult] = {}
    for grain, result in grain_results.items():
        reconciliation = (
            result.executive_reconciliation.copy()
            if isinstance(result.executive_reconciliation, pd.DataFrame)
            else pd.DataFrame()
        )
        if (
            config.document_approved_sites_only
            and not reconciliation.empty
            and "Site" in reconciliation.columns
        ):
            site_text = (
                reconciliation["Site"]
                .fillna("")
                .astype(str)
                .str.strip()
                .str.upper()
            )
            reconciliation = reconciliation[
                site_text.isin(allowed | aggregate_labels)
            ].copy()

        output[grain] = replace(
            result,
            site_summary=filter_rows_to_approved_sites(
                result.site_summary,
                config,
            ),
            squad_summary=filter_rows_to_approved_sites(
                result.squad_summary,
                config,
            ),
            executive_reconciliation=reconciliation,
        )
    return output


