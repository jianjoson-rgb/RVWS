def _email_v551_rate_color(
    value: Any,
    *,
    threshold: float = 0.80,
    higher_is_better: bool = True,
) -> str:
    numeric = _email_v551_num(value)
    if pd.isna(numeric):
        return EMAIL_V551_GRAY
    if higher_is_better:
        return EMAIL_V551_GREEN if numeric >= threshold else EMAIL_V551_RED
    return EMAIL_V551_RED if numeric >= threshold else EMAIL_V551_GREEN


def _email_v551_delta_color(
    value: Any,
    *,
    higher_is_better: bool = True,
) -> str:
    numeric = _email_v551_num(value)
    if pd.isna(numeric) or abs(numeric) < 1e-12:
        return EMAIL_V551_GRAY
    if higher_is_better:
        return EMAIL_V551_GREEN if numeric > 0 else EMAIL_V551_RED
    return EMAIL_V551_RED if numeric > 0 else EMAIL_V551_GREEN


def _email_v551_pp_color(value_pp: Any, *, higher_is_better: bool = True) -> str:
    numeric = _email_v551_num(value_pp)
