def _email_v551_enrich_priority_sections(
    base_sections: Sequence[Mapping[str, Any]],
    primary_site: str,
    focus_squads: Sequence[str],
    qa_summary: pd.DataFrame,
    grain_results: Mapping[str, GrainResult],
    config: AppConfig = CONFIG,
) -> List[Dict[str, Any]]:
    """Keep the existing Key Performance Drivers section and add QA per squad."""
    sections: List[Dict[str, Any]] = [
        {
            "title": normalize_text(section.get("title", "")),
            "paragraphs": [
                normalize_text(value)
                for value in section.get("paragraphs", [])
                if normalize_text(value)
            ],
            "action_heading": normalize_text(section.get("action_heading", "")),
            "actions": [
                normalize_text(value)
                for value in section.get("actions", [])
                if normalize_text(value)
            ],
        }
        for section in base_sections
    ]

    if not sections:
        return sections

    squads: List[str] = []
    for grain, result in grain_results.items():
        if result is None:
            continue
        site = normalize_text(primary_site)
        if site:
            squads.extend(_email_top_squad_names(result, site, "negative", 3))
    squads.extend([normalize_text(value) for value in focus_squads if normalize_text(value)])
    squads = list(dict.fromkeys([squad for squad in squads if squad]))

    qa_actions = _email_v551_priority_squad_qa_actions(
        qa_summary=qa_summary,
        primary_site=primary_site,
        squads=squads,
        config=config,
    )
    if qa_actions:
        actions = sections[0].setdefault("actions", [])
        existing = {normalize_text(action) for action in actions}
        for action in qa_actions:
            if normalize_text(action) not in existing:
                actions.append(action)
    return sections


def _email_v551_subject(
    base_payload: Mapping[str, Any],
    selection: ReportSelection,
    report_scope: Mapping[str, Any],
    grain_results: Mapping[str, GrainResult],
    primary_site: str,
) -> str:
    subject = normalize_text(base_payload.get("subject", ""))
    if subject:
        return subject
    subject_date = pd.Timestamp(report_scope["data_through"]).strftime("%Y-%m-%d")
    attention_site = normalize_text(primary_site) or "N/A"
    active = [
        grain.title()
        for grain in _active_grains_v570(selection)
        if grain in grain_results
    ]
    return (
        f"{CONFIG.email_body_subject_prefix} {subject_date} | "
        f"{'/'.join(active) or 'Report'} readout "
        f"(Attention: {attention_site})"
    )


def _selection_aware_email_payload_v570(
    selection: ReportSelection,
    report_scope: Mapping[str, Any],
    grain_results: Mapping[str, GrainResult],
    primary_site: str,
    focus_squads: Sequence[str],
    monthly_anchor: Optional[pd.Series],
    qa_summary: pd.DataFrame,
    scrubbed_tickets: pd.DataFrame,
    config: AppConfig = CONFIG,
) -> Dict[str, Any]:
    """
    v5.7.52 email payload.

    Replaces the simple top Executive Summary bullets with detailed Daily,
    Weekly and Monthly executive readouts. Daily is post-mortem only; Weekly
    and Monthly retain forecast/projection when the period is incomplete.
    The existing Key Performance Drivers & Recommended Actions section remains
    after the per-grain readouts, with QA attributes attached to priority squads.
    """
    active = [
        grain
        for grain in _active_grains_v570(selection)
        if grain in grain_results
    ]
    if not active:
        active = list(grain_results.keys())

    # Build the old section payload for subject and the action section. Use the
    # saved v5.7.50 builders directly so this override does not recurse.
    if len(active) > 1:
        base_payload = _v550_build_cross_grain_email_body(
            selection=selection,
            report_scope=report_scope,
            grain_results=grain_results,
            primary_site=primary_site,
            focus_squads=focus_squads,
            monthly_anchor=monthly_anchor,
            qa_summary=qa_summary,
            scrubbed_tickets=scrubbed_tickets,
            config=config,
        )
    else:
        base_payload = _v550_selection_aware_email_payload_v570(
            selection=selection,
            report_scope=report_scope,
            grain_results=grain_results,
            primary_site=primary_site,
            focus_squads=focus_squads,
            monthly_anchor=monthly_anchor,
            qa_summary=qa_summary,
            scrubbed_tickets=scrubbed_tickets,
            config=config,
        )

    teammate_df = _email_v551_build_teammate_opportunities_from_scope(
        report_scope=report_scope,
        config=config,
    )

    detailed_readouts = [
        _email_v551_build_grain_readout(
            selection=selection,
            report_scope=report_scope,
            grain_result=grain_results[grain],
            qa_summary=qa_summary,
            teammate_df=teammate_df,
            config=config,
        )
        for grain in active
        if grain in grain_results
    ]

    sections = _email_v551_enrich_priority_sections(
        base_sections=base_payload.get("sections", []),
        primary_site=primary_site,
        focus_squads=focus_squads,
        qa_summary=qa_summary,
        grain_results=grain_results,
        config=config,
    )

    payload: Dict[str, Any] = {
        "subject": _email_v551_subject(
            base_payload,
            selection,
            report_scope,
            grain_results,
            primary_site,
        ),
        "lob": selection.lob.upper(),
        "analysis_mode": "ALL GRAINS" if len(active) > 1 else active[0],
        "overview_title": "Overall Performance & Bottom Line",
        "overview_segments": _email_v551_overview_segments(
            selection=selection,
            grain_results=grain_results,
            active_grains=active,
            config=config,
        ),
        "detailed_readouts": detailed_readouts,
        # Preserve for compatibility/audit tabs, but the DOCX renderer uses the
        # detailed readouts instead of these old simple bullets.
        "executive_summary": [
            executive_summary_line(grain_results[grain].overall)
            for grain in active
            if grain in grain_results
        ],
        "sections": sections,
        "followup_line": (
            config.email_body_followup_line
            if config.email_body_include_followup_line
            else ""
        ),
    }
    payload["plain_text"] = _email_plain_text_from_payload(payload)
    payload["html"] = _email_html_from_payload(payload)
    return payload


def _email_plain_text_from_payload(payload: Mapping[str, Any]) -> str:
    """Render the v5.7.52 structured email payload as copy/paste text."""
    if not payload.get("detailed_readouts"):
        return _v550_email_plain_text_from_payload(payload)

    lines: List[str] = []
    lob = normalize_text(payload.get("lob", ""))
    lines.append(f"{lob} Executive Summary" if lob else "Executive Summary")
    lines.append("")

    overview_title = normalize_text(payload.get("overview_title", "Overall Performance & Bottom Line"))
    lines.append(overview_title)
    overview_segments = payload.get("overview_segments", [])
    overview_text = _email_v551_segments_text(overview_segments)
    if overview_text:
        lines.append(overview_text)
    lines.append("")

    for readout in payload.get("detailed_readouts", []):
        title = normalize_text(readout.get("title", "Detailed Readout"))
        period = normalize_text(readout.get("period_label", ""))
        lines.append(title if not period else f"{title} — {period}")
        for block in readout.get("blocks", []):
            label = normalize_text(block.get("label", ""))
            if label:
                lines.append(label)
            for paragraph in block.get("paragraphs", []):
                paragraph_text = _email_v551_segments_text(paragraph.get("segments", []))
                if paragraph_text:
                    lines.append(f"• {paragraph_text}")
        lines.append("")

    lines.append("Key Performance Drivers & Recommended Actions")
    lines.append("")
    for section in payload.get("sections", []):
        title = normalize_text(section.get("title", ""))
        if title:
            lines.append(title)
        for paragraph in section.get("paragraphs", []):
            paragraph_text = normalize_text(paragraph)
            if paragraph_text:
                lines.append(paragraph_text)
        action_heading = normalize_text(section.get("action_heading", ""))
        if action_heading:
            lines.append(action_heading)
        for action in section.get("actions", []):
            action_text = normalize_text(action)
            if action_text:
                lines.append(f"• {action_text}")
        lines.append("")

    followup = normalize_text(payload.get("followup_line", ""))
    if followup:
        lines.append(followup)
        lines.append("")

    return "\n".join(lines).strip() + "\n"


def _email_html_segments_v551(segments: Sequence[Mapping[str, Any]]) -> str:
    parts: List[str] = []
    for segment in segments:
        text_value_raw = _email_v552_preserve_run_spacing(segment.get("text", ""))
        if not text_value_raw:
            continue
        text_value = html.escape(text_value_raw)
        color = normalize_text(segment.get("color", EMAIL_V551_BLACK)) or EMAIL_V551_BLACK
        weight = "font-weight:bold;" if bool(segment.get("bold", False)) else ""
        parts.append(f"<span style=\"color:#{color};{weight}\">{text_value}</span>")
    return "".join(parts)


def _email_html_from_payload(payload: Mapping[str, Any]) -> str:
    """Render the v5.7.52 structured email payload as Gmail-friendly HTML."""
    if not payload.get("detailed_readouts"):
        return _v550_email_html_from_payload(payload)

    esc = html.escape
    parts: List[str] = [
        "<div style=\"font-family:Arial,Helvetica,sans-serif;font-size:14px;line-height:1.45;color:#202124;\">",
    ]
    lob = normalize_text(payload.get("lob", ""))
    parts.append(f"<h2>{esc(lob + ' Executive Summary' if lob else 'Executive Summary')}</h2>")

    overview_title = normalize_text(payload.get("overview_title", "Overall Performance & Bottom Line"))
    parts.append(f"<h3>{esc(overview_title)}</h3>")
    overview_html = _email_html_segments_v551(payload.get("overview_segments", []))
    if overview_html:
        parts.append(f"<p>{overview_html}</p>")

    for readout in payload.get("detailed_readouts", []):
        title = normalize_text(readout.get("title", "Detailed Readout"))
        period = normalize_text(readout.get("period_label", ""))
        parts.append(f"<h3>{esc(title if not period else title + ' — ' + period)}</h3>")
        for block in readout.get("blocks", []):
            label = normalize_text(block.get("label", ""))
            if label:
                parts.append(f"<p><strong>{esc(label)}</strong></p>")
            block_paragraphs = block.get("paragraphs", [])
            if block_paragraphs:
                parts.append("<ul>")
                for paragraph in block_paragraphs:
                    segment_html = _email_html_segments_v551(paragraph.get("segments", []))
                    if segment_html:
                        parts.append(f"<li>{segment_html}</li>")
                parts.append("</ul>")

    parts.append("<p style=\"margin-top:18px;\"><strong>Key Performance Drivers &amp; Recommended Actions</strong></p>")
    for section in payload.get("sections", []):
        title = esc(normalize_text(section.get("title", "")))
        if title:
            parts.append(f"<p style=\"margin-top:16px;\"><strong>{title}</strong></p>")
        for paragraph in section.get("paragraphs", []):
            paragraph_text = normalize_text(paragraph)
            if paragraph_text:
                parts.append(f"<p>{esc(paragraph_text)}</p>")
        action_heading = normalize_text(section.get("action_heading", ""))
        if action_heading:
            parts.append(f"<p><strong>{esc(action_heading)}</strong></p>")
        actions = [
            normalize_text(action)
            for action in section.get("actions", [])
            if normalize_text(action)
        ]
        if actions:
            parts.append("<ul>")
            parts.extend(f"<li>{esc(action)}</li>" for action in actions)
            parts.append("</ul>")

    followup = normalize_text(payload.get("followup_line", ""))
    if followup:
        parts.append(f"<p style=\"margin-top:18px;\">{esc(followup)}</p>")
    parts.append("</div>")
    return "\n".join(parts)


def _docx_add_email_segments_v551(
    paragraph,
    segments: Sequence[Mapping[str, Any]],
    *,
    font_size: float = 9.0,
) -> None:
    """Append color-coded runs to a DOCX paragraph with readable spacing."""
    for segment in segments:
        text_value = _email_v552_preserve_run_spacing(segment.get("text", ""))
        if not text_value:
            continue
        run = paragraph.add_run(text_value)
        run.font.size = Pt(font_size)
        run.bold = bool(segment.get("bold", False))
        color = normalize_text(segment.get("color", EMAIL_V551_BLACK)) or EMAIL_V551_BLACK
        try:
            run.font.color.rgb = RGBColor.from_string(color)
        except Exception:
            run.font.color.rgb = RGBColor.from_string(EMAIL_V551_BLACK)


def _docx_add_email_segment_paragraph_v551(
    document: Document,
    segments: Sequence[Mapping[str, Any]],
    *,
    style: Optional[str] = None,
    font_size: float = 9.0,
    left_indent: float = 0.0,
) -> None:
    paragraph = document.add_paragraph(style=style) if style else document.add_paragraph()
    paragraph.paragraph_format.space_after = Pt(4)
    paragraph.paragraph_format.line_spacing = 1.08
    if left_indent:
        paragraph.paragraph_format.left_indent = Inches(left_indent)
