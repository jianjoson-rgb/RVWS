def _email_v569_ticket_age_volume_rows(
    source_df: pd.DataFrame,
    *,
    limit: int = 2,
) -> List[Dict[str, Any]]:
    """Return top Ticket Age buckets by rated survey volume share."""
    if (
        source_df is None
        or not isinstance(source_df, pd.DataFrame)
        or source_df.empty
        or "Ticket Age" not in source_df.columns
    ):
        return []

    work = source_df.copy()

    def _clean_age(value: Any) -> str:
        try:
            cleaned = _normalize_ticket_age_bucket_v548(value)
        except Exception:
            cleaned = _email_v565_clean_label(value)
        return _email_v565_clean_label(cleaned)

    work["_EmailTicketAge"] = work["Ticket Age"].map(_clean_age)
    work = work[work["_EmailTicketAge"].map(normalize_text).ne("")].copy()
    if work.empty:
        return []

    total_counts = _email_v565_response_summary(work)
    total_rated = float(total_counts.get("Rated", 0.0) or 0.0)
    total_non_smiley = float(total_counts.get("Non-Smiley", 0.0) or 0.0)
    if total_rated <= 0:
        return []

    rows: List[Dict[str, Any]] = []
    for age, group in work.groupby("_EmailTicketAge", dropna=False):
        label = normalize_text(age)
        if not label:
            continue
        counts = _email_v565_response_summary(group)
        rated = float(counts.get("Rated", 0.0) or 0.0)
        if rated <= 0:
            continue
        non_smiley = float(counts.get("Non-Smiley", 0.0) or 0.0)
        rows.append(
            {
                "Ticket Age": label,
                "Rated": rated,
                "Rated Share": safe_rate(rated, total_rated),
                "Smiley Rate": counts.get("Smiley Rate", np.nan),
                "Non-Smiley": non_smiley,
                "Non-Smiley Share": safe_rate(non_smiley, total_non_smiley),
            }
        )

    if not rows:
        return []

    ranked = pd.DataFrame(rows).sort_values(
        ["Rated", "Rated Share", "Non-Smiley", "Smiley Rate"],
        ascending=[False, False, False, True],
        na_position="last",
    )
    return ranked.head(max(1, int(limit))).to_dict("records")


