def _safe_percent_from_ratio_v560(value: Any) -> str:
    """Format a 0-1 rate safely for executive tables."""
    numeric = pd.to_numeric(
        pd.Series([value]),
        errors="coerce",
    ).iloc[0]
    if pd.isna(numeric):
        return "N/A"
    return f"{float(numeric):.2%}"


def _unhappy_rate_ratio_v560(
    non_smiley: Any,
    responses: Any,
) -> float:
    """Return Non-Smiley / Responses with safe numeric handling."""
    non_smiley_numeric = pd.to_numeric(
        pd.Series([non_smiley]),
        errors="coerce",
    ).iloc[0]
    responses_numeric = pd.to_numeric(
        pd.Series([responses]),
        errors="coerce",
    ).iloc[0]
    if (
        pd.isna(non_smiley_numeric)
        or pd.isna(responses_numeric)
        or float(responses_numeric) <= 0
    ):
        return np.nan
    return float(non_smiley_numeric) / float(responses_numeric)


def _overall_unhappy_squad_rows_v560(
    squad_table: pd.DataFrame,
    config: AppConfig = CONFIG,
) -> List[List[str]]:
    """
    Build a separate all-rated Unhappy Rate squad table.

    The selected squads match the existing Smiley Rate table. The displayed
    Unhappy Gap is the inverse of the existing Smiley impact so positive values
    mean a higher (worse) Unhappy Rate than the comparison population.
    """
    if squad_table is None or squad_table.empty:
        return []

    negative = top_squads(
        squad_table,
        "negative",
        config.top_squads_per_direction,
        minimum_responses=config.directional_n,
    )
    positive = top_squads(
        squad_table,
        "positive",
        config.top_squads_per_direction,
        minimum_responses=config.directional_n,
    )
    combined = pd.concat(
        [negative, positive],
        ignore_index=True,
    ).drop_duplicates(subset=["Squad Code"])
    if combined.empty:
        return []

    combined = combined.sort_values(
        "Official Impact",
        ascending=True,
        kind="stable",
    )

    rows: List[List[str]] = []
    for _, row in combined.iterrows():
        unhappy_ratio = _unhappy_rate_ratio_v560(
            row.get("Non_Smiley_Count"),
            row.get("Responses"),
        )
        official_impact = pd.to_numeric(
            pd.Series([row.get("Official Impact")]),
            errors="coerce",
        ).iloc[0]
        unhappy_gap = (
            -float(official_impact)
            if pd.notna(official_impact)
            else np.nan
        )
        rows.append(
            [
                normalize_text(row.get("Squad Code", "")),
                _safe_percent_from_ratio_v560(unhappy_ratio),
                format_pp(unhappy_gap),
                format_int(row.get("Responses")),
                format_int(row.get("Non_Smiley_Count")),
                normalize_text(
                    row.get("Sample Size Classification", "")
                ),
            ]
        )
    return rows


