def _email_v551_top_tenure_driver(
    source_df: pd.DataFrame,
    metric: PeriodMetric,
) -> Dict[str, Any]:
    """Return the tenure segment carrying the clearest risk."""
    for column in ["Tenure Group", "Agent Tenure"]:
        if source_df is not None and column in source_df.columns:
            table = _email_v551_group_response_mix(source_df, column)
            if table.empty:
                continue
            work = table.copy()
            work["_Rated"] = pd.to_numeric(work.get("Rated", 0), errors="coerce").fillna(0.0)
            work["_Rate"] = pd.to_numeric(work.get("Smiley Rate", np.nan), errors="coerce")
            work["_NS Share"] = pd.to_numeric(
                work.get("Non-Smiley Share", np.nan),
                errors="coerce",
            ).fillna(0.0)
            work["_Gap"] = (
                work["_Rate"] - float(metric.actual_rate)
                if pd.notna(metric.actual_rate)
                else np.nan
            )
            work = work[work["_Rated"].gt(0)].copy()
            if work.empty:
                continue
            below = work[work["_Gap"].lt(0)].copy()
            candidate_pool = below if not below.empty else work
            top = candidate_pool.sort_values(
                ["_NS Share", "_Gap", "_Rate", "_Rated"],
                ascending=[False, True, True, False],
                na_position="last",
            ).iloc[0]
            output = top.to_dict()
            output["_Column"] = column
            return output
    return {}


def _email_v551_top_squad_driver(
    grain_result: GrainResult,
    direction: str = "negative",
    config: AppConfig = CONFIG,
) -> Dict[str, Any]:
    """Return the top squad row across approved sites for one grain."""
    table = grain_result.squad_summary
    if table is None or table.empty:
        return {}
    work = table.copy()
    try:
        work = filter_rows_to_approved_sites(work, config)
    except Exception:
        pass
    if work.empty or "Official Impact" not in work.columns:
        return {}

    work["_Impact"] = pd.to_numeric(work["Official Impact"], errors="coerce")
    work["_Responses"] = pd.to_numeric(
        work.get("Responses", pd.Series(0.0, index=work.index)),
        errors="coerce",
    ).fillna(0.0)
    work = work[work["_Impact"].notna() & work["_Responses"].gt(0)].copy()
    if work.empty:
        return {}

    if normalize_text(direction).lower() == "positive":
        work = work[work["_Impact"].gt(0)].sort_values(
            ["_Impact", "_Responses"],
            ascending=[False, False],
        )
    else:
        work = work[work["_Impact"].lt(0)].sort_values(
            ["_Impact", "_Responses"],
            ascending=[True, False],
        )
    if work.empty:
        return {}
    return work.iloc[0].to_dict()


def _email_v551_top_qa_attributes(
    source_df: pd.DataFrame,
    scope_name: str,
    config: AppConfig = CONFIG,
    limit: int = 2,
) -> pd.DataFrame:
    """Return the two strongest QA attribute drivers for the selected grain."""
    impact = build_qa_attribute_impact_table_v549(
        source_df=source_df,
        scope_name=scope_name,
        config=config,
    )
    if impact is None or impact.empty:
        return pd.DataFrame()

    work = impact.copy()
    work["_Audited"] = pd.to_numeric(work.get("Audited", 0), errors="coerce").fillna(0.0)
    work["_Gap"] = pd.to_numeric(work.get("Gap", np.nan), errors="coerce").fillna(0.0).clip(lower=0.0)
    work["_NS Share"] = pd.to_numeric(
        work.get("Non-Smiley Fail Share", np.nan),
        errors="coerce",
    ).fillna(0.0)
    work["_Fail Rate"] = pd.to_numeric(
        work.get("Fail Rate", np.nan),
        errors="coerce",
    ).fillna(0.0)
    work["_TM Gap"] = pd.to_numeric(
        work.get("TM QA Gap", np.nan),
        errors="coerce",
    ).fillna(0.0).clip(lower=0.0)
    work["_Score"] = (
        work["_Gap"] * 100.0
        + work["_NS Share"] * 50.0
        + work["_Fail Rate"] * 25.0
        + work["_TM Gap"] * 25.0
    )
    min_audits = int(
        getattr(
            config,
            "qa_attribute_impact_min_audits",
            getattr(config, "directional_n", 5),
        )
    )
    eligible = work[work["_Audited"].ge(min_audits)].copy()
    if eligible.empty:
        eligible = work[work["_Audited"].gt(0)].copy()
    if eligible.empty:
        return pd.DataFrame()

    return (
        eligible.sort_values(
            ["_Score", "_NS Share", "_Fail Rate", "_Audited"],
            ascending=[False, False, False, False],
            na_position="last",
        )
        .head(max(1, int(limit)))
        .drop(columns=[c for c in eligible.columns if c.startswith("_")], errors="ignore")
        .reset_index(drop=True)
    )


def _email_v551_squad_qa_focus_text(
    qa_summary: pd.DataFrame,
    site: str,
    squad: str,
    limit: int = 2,
) -> str:
    """Return top QA attribute failure rates for one site/squad."""
    focus = qa_summary_for_squad(qa_summary, site, squad)
    if focus is None or focus.empty:
        return "QA attributes unavailable"

    work = focus.copy()
    work["_Failure Rate"] = pd.to_numeric(
        work.get("Failure Rate", np.nan),
        errors="coerce",
    )
    work["_Audited"] = pd.to_numeric(
        work.get("Audited", np.nan),
        errors="coerce",
    ).fillna(0.0)
    work = work[work["_Audited"].gt(0) & work["_Failure Rate"].notna()].copy()
    if work.empty:
        return "QA attributes unavailable"

    # Prefer actual failed behaviors; when all are zero, show the largest audited
    # checks as context so the priority squad still has QA attributes attached.
    nonzero = work[work["_Failure Rate"].gt(0)].copy()
    ranked = nonzero if not nonzero.empty else work
    ranked = ranked.sort_values(
        ["_Failure Rate", "_Audited"],
        ascending=[False, False],
        na_position="last",
    ).head(max(1, int(limit)))

    parts: List[str] = []
    for _, row in ranked.iterrows():
        attribute = normalize_text(row.get("QA Attribute", ""))
        failure_rate = _email_v551_num(row.get("_Failure Rate"))
        if attribute and pd.notna(failure_rate):
            parts.append(f"{attribute} {format_rate(failure_rate, 1)} fail rate")
    return "; ".join(parts) if parts else "QA attributes unavailable"


def _email_v551_priority_squad_qa_actions(
    qa_summary: pd.DataFrame,
    primary_site: str,
    squads: Sequence[str],
    config: AppConfig = CONFIG,
) -> List[str]:
    """Return action bullets that attach two QA attributes to each priority squad."""
    site_label = normalize_text(primary_site)
    if not site_label or not squads:
        return []

    actions: List[str] = []
    seen: set[str] = set()
    for squad in squads[: max(1, int(getattr(config, "underperforming_squad_limit", 8)))]:
        squad_label = normalize_text(squad)
        if not squad_label or squad_label.upper() in seen:
            continue
        seen.add(squad_label.upper())
        qa_text = _email_v551_squad_qa_focus_text(
            qa_summary=qa_summary,
            site=site_label,
            squad=squad_label,
            limit=2,
        )
        actions.append(
            f"{squad_label} QA focus: {qa_text}."
        )
    return actions


def _email_v551_build_teammate_opportunities_from_scope(
    report_scope: Mapping[str, Any],
    config: AppConfig = CONFIG,
) -> pd.DataFrame:
    """Build the same site-level teammate opportunity rows for email context."""
    source_df = report_scope.get("display_df", pd.DataFrame())
    if source_df is None or not isinstance(source_df, pd.DataFrame) or source_df.empty:
        return pd.DataFrame()
    if "Site" not in source_df.columns:
        return pd.DataFrame()

    approved_sites = [
        normalize_text(site)
        for site in getattr(config, "site_detail_sites", ())
        if normalize_text(site)
    ]
    if not approved_sites:
        approved_sites = sorted(
            source_df["Site"].dropna().map(normalize_text).replace("", np.nan).dropna().unique()
        )

    frames: List[pd.DataFrame] = []
    for site in approved_sites:
        site_mask = source_df["Site"].map(lambda value: normalize_text(value).upper()).eq(site.upper())
        site_df = source_df[site_mask].copy()
        if site_df.empty:
            continue
        try:
            rows = build_teammate_coaching_opportunities_v540(
                site_df=site_df,
                site=site,
                report_scope=report_scope,
                config=config,
            )
        except Exception as exc:
            LOGGER.warning(
                "Email teammate opportunity context skipped for %s: %s",
                site,
                exc,
            )
            rows = pd.DataFrame()
        if rows is not None and not rows.empty:
            frames.append(rows.copy())

    if not frames:
        return pd.DataFrame()
    combined = pd.concat(frames, ignore_index=True, sort=False)
    if "Site" in combined.columns:
        site_order = {site.upper(): idx for idx, site in enumerate(approved_sites)}
        combined["_Site Sort"] = combined["Site"].map(
            lambda value: site_order.get(normalize_text(value).upper(), 999)
        )
        combined["_Rank Sort"] = pd.to_numeric(
            combined.get("Rank", pd.Series(999, index=combined.index)),
            errors="coerce",
        ).fillna(999)
        combined = combined.sort_values(
            ["_Site Sort", "_Rank Sort", "Estimated Monthly Opportunity"],
            ascending=[True, True, False],
            na_position="last",
        ).drop(columns=["_Site Sort", "_Rank Sort"], errors="ignore")
    return combined.reset_index(drop=True)


def _email_v551_teammate_segments(
    opportunity_df: pd.DataFrame,
) -> List[Dict[str, Any]]:
    if opportunity_df is None or opportunity_df.empty:
        return [
            _email_v551_seg(
                "Teammate: No teammate coaching rows qualified under the current site-level inclusion rules."
            )
        ]

    site_counts = (
        opportunity_df.get("Site", pd.Series("", index=opportunity_df.index))
        .map(normalize_text)
        .replace("", "Unknown")
        .value_counts()
    )
    site_mix = ", ".join(f"{site} {count}" for site, count in site_counts.items())

    baseline_rated = pd.to_numeric(
        opportunity_df.get("Baseline Rated", pd.Series(0.0, index=opportunity_df.index)),
        errors="coerce",
    ).fillna(0.0)
    baseline_smiley = pd.to_numeric(
        opportunity_df.get("Baseline Smiley", pd.Series(0.0, index=opportunity_df.index)),
        errors="coerce",
    ).fillna(0.0)
    group_rate = safe_rate(float(baseline_smiley.sum()), float(baseline_rated.sum()))

    avg_gap_pp = pd.to_numeric(
        opportunity_df.get("Gap vs Site pp", pd.Series(np.nan, index=opportunity_df.index)),
        errors="coerce",
    ).mean()

    top = opportunity_df.copy()
    top["_Opp"] = pd.to_numeric(
        top.get("Estimated Monthly Opportunity", pd.Series(0.0, index=top.index)),
        errors="coerce",
    ).fillna(0.0)
    top = top.sort_values("_Opp", ascending=False, na_position="last").iloc[0]
    top_employee = truncate_text(normalize_text(top.get("Employee Name", "")), 35)
    top_site = normalize_text(top.get("Site", ""))
    top_opp = _email_v551_num(top.get("_Opp"), 0.0)

    latest_delta = pd.to_numeric(
        opportunity_df.get("W-1 Delta pp", pd.Series(np.nan, index=opportunity_df.index)),
        errors="coerce",
    )
    below_count = int(latest_delta.lt(0).sum())
    recovered_count = int(latest_delta.ge(0).sum())

    return [
        _email_v551_seg("Teammate: "),
        _email_v551_seg(f"{len(opportunity_df)} qualifying teammates", bold=True),
        _email_v551_seg(f" across {site_mix} averaged "),
        _email_v551_seg(
            format_rate(group_rate),
            color=_email_v551_rate_color(group_rate),
            bold=True,
        ),
        _email_v551_seg(" 3M Smiley and "),
        _email_v551_seg(
            _email_v551_format_pp_from_pp(avg_gap_pp),
            color=_email_v551_pp_color(avg_gap_pp),
            bold=True,
        ),
        _email_v551_seg(
            " vs site benchmarks. In the latest completed WB, "
            f"{below_count} remained below their own baseline and "
            f"{recovered_count} were at/above baseline. Highest monthly opportunity: "
        ),
        _email_v551_seg(f"{top_employee} ({top_site})", bold=True),
        _email_v551_seg(f" at {top_opp:.1f} recoverable smileys/month."),
    ]


