    if ranked_rate.empty:
        return (
            f"{scope_label} Ticket Age Impact has no rated volume after ticket-age "
            "normalization."
        )

    best = ranked_rate.sort_values(
        ["_Smiley Rate", "_Rated"],
        ascending=[False, False],
        na_position="last",
    ).iloc[0]
    weakest = ranked_rate.sort_values(
        ["_Smiley Rate", "_Rated"],
        ascending=[True, False],
        na_position="last",
    ).iloc[0]

    ns_rank = impact_df.copy()
    ns_rank["_NS Share"] = pd.to_numeric(
        ns_rank.get("Non-Smiley Share", pd.Series(dtype="float64")),
        errors="coerce",
    ).fillna(0.0)
    ns_rank = ns_rank.sort_values(
        ["_NS Share", "Non-Smiley"],
        ascending=[False, False],
        na_position="last",
    )
    top_ns = ns_rank.iloc[0]

    aged_row = impact_df[impact_df["Ticket Age"].eq(">7 days")]
    aged_sentence = ""
    if not aged_row.empty:
        aged = aged_row.iloc[0]
        aged_rate = aged.get("Smiley Rate", np.nan)
        aged_delta_pp = (
            (float(aged_rate) - float(scope_rate)) * 100.0
            if pd.notna(aged_rate) and pd.notna(scope_rate)
            else np.nan
        )
        aged_sentence = (
            f" >7 days delivered {format_rate(aged_rate)} "
            f"({_format_pp_delta_v527(aged_delta_pp)} vs scope) and contributed "
            f"{format_rate(aged.get('Non-Smiley Share', np.nan))} of neutral/frownie pressure."
        )

    return (
        f"{scope_label} Ticket Age Impact covers {format_int(rated_total)} rated "
        f"responses. Strongest bucket: {normalize_text(best.get('Ticket Age', ''))} "
        f"at {format_rate(best.get('Smiley Rate', np.nan))}; lowest bucket: "
        f"{normalize_text(weakest.get('Ticket Age', ''))} at "
        f"{format_rate(weakest.get('Smiley Rate', np.nan))}."
        f"{aged_sentence} Largest non-smiley share came from "
        f"{normalize_text(top_ns.get('Ticket Age', ''))} at "
        f"{format_rate(top_ns.get('Non-Smiley Share', np.nan))}."
    )


