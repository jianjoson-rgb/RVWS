            ]
        )
    return rows


def _v572_aftr_narrative(scope_name: str, records: Sequence[Mapping[str, Any]], *, site_specific: bool = False) -> List[str]:
    if not records:
        return [
            f"AFTR Impact {'for ' + scope_name if site_specific else 'reviews'} survey-linked first-touch resolution performance for Weekly and Monthly only.",
            "No usable Weekly or Monthly AFTR data was available for this scope.",
        ]

    bullets: List[str] = []
    if site_specific:
        bullets.append(f"AFTR Impact for {scope_name} reviews whether first-touch resolution differs between Smiley surveys and Non-Smiley surveys.")
    else:
        bullets.append("AFTR Impact reviews survey-linked first-touch resolution performance for Weekly and Monthly only.")

    for grain in ("Weekly", "Monthly"):
        record = next((item for item in records if normalize_text(item.get("Grain", "")).lower() == grain.lower()), None)
        if not record:
