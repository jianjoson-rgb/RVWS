                    _compact_chart_number(volume),
                    ha="center",
                    va="bottom",
                    fontsize=6.5,
                    color="#475467",
                    fontweight="bold",
                    zorder=1,
                )

            positive_mask = (
                np.isfinite(site_values)
                & np.isfinite(overall_values)
                & (site_values >= overall_values)
            )
            negative_mask = (
                np.isfinite(site_values)
                & np.isfinite(overall_values)
                & (site_values < overall_values)
            )

            if has_site_data:
                ax.fill_between(
                    x,
                    site_values,
                    overall_values,
                    where=positive_mask,
                    interpolate=True,
                    color="#DDEFD8",
                    alpha=0.85,
                    zorder=3,
                )
                ax.fill_between(
                    x,
                    site_values,
                    overall_values,
                    where=negative_mask,
                    interpolate=True,
                    color="#F7DBDB",
                    alpha=0.90,
                    zorder=3,
                )

            # Overall benchmark: dashed line only, without markers or labels.
            ax.plot(
                x,
                overall_values,
                color="#1F2937",
                linestyle=(0, (4, 3)),
                linewidth=1.35,
                label="Overall LOB Performance",
                zorder=5,
            )

            if has_site_data:
                ax.plot(
