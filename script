def _finance_squad_table_rows_v52(
    squad_df: pd.DataFrame,
    config: AppConfig = CONFIG,
) -> List[List[str]]:
    """Render Finance squad performance using Smiley Rate."""
    if squad_df is None or squad_df.empty:
        return []

    rows: List[List[str]] = []
    for _, row in squad_df.head(
        int(config.finance_qa_top_squads_report)
    ).iterrows():
        rated = int(pd.to_numeric(
            pd.Series([row.get("Rated", 0)]),
            errors="coerce",
        ).fillna(0).iloc[0])
        non_smiley = int(pd.to_numeric(
            pd.Series([row.get("Unhappy", 0)]),
            errors="coerce",
        ).fillna(0).iloc[0])
        smiley = max(0, rated - non_smiley)

        unhappy_rate = pd.to_numeric(
            pd.Series([row.get("Unhappy Rate")]),
            errors="coerce",
        ).iloc[0]
        smiley_rate = (
            1.0 - float(unhappy_rate)
            if pd.notna(unhappy_rate)
            else safe_rate(smiley, rated)
        )

        scope_unhappy = pd.to_numeric(
            pd.Series([row.get("Scope Finance Average")]),
            errors="coerce",
        ).iloc[0]
        scope_smiley = (
            1.0 - float(scope_unhappy)
            if pd.notna(scope_unhappy)
            else np.nan
        )

        old_gap = pd.to_numeric(
            pd.Series([row.get("Gap vs Finance Average (pp)")]),
            errors="coerce",
        ).iloc[0]
        smiley_gap = -float(old_gap) if pd.notna(old_gap) else np.nan

        previous_unhappy = pd.to_numeric(
            pd.Series([row.get("Previous Unhappy Rate")]),
            errors="coerce",
        ).iloc[0]
        previous_smiley = (
            1.0 - float(previous_unhappy)
            if pd.notna(previous_unhappy)
            else np.nan
        )
        smiley_delta = (
            (smiley_rate - previous_smiley) * 100
            if pd.notna(smiley_rate) and pd.notna(previous_smiley)
            else np.nan
        )
        status = normalize_text(row.get("Trend Status", ""))
        trend_text = (
            status or "Insufficient previous data"
            if pd.isna(smiley_delta)
            else f"{smiley_delta:+.1f} pp | {status}"
        )

        rated_text = (
            f"{rated:,} | "
            f"{_volume_display(row.get('Volume Status', ''), row.get('Volume Change %'))}"
        )
        rows.append(
            [
                normalize_text(row.get("Squad Code", "")),
                rated_text,
                f"{smiley:,}",
                f"{format_rate(smiley_rate)} | {trend_text}",
                format_rate(scope_smiley),
                f"{smiley_gap:+.1f}" if pd.notna(smiley_gap) else "N/A",
                normalize_text(row.get("Assessment", "")),
                normalize_text(row.get("Sample Status", "")),
            ]
        )
    return rows






