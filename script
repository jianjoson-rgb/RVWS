        ax.text(
            0.5,
            0.5,
            "No comparable data",
            transform=ax.transAxes,
            ha="center",
            va="center",
            fontsize=10,
        )
        ax.set_axis_off()
        return

    labels = [
        _email_trend_short_label_v552(value, section_key)
        for value in comparisons["Label"].tolist()
    ]
    current_values = (
        pd.to_numeric(
            comparisons["Current Rate"],
            errors="coerce",
        )
        * 100
    ).tolist()
    previous_values = (
        pd.to_numeric(
            comparisons["Previous Rate"],
            errors="coerce",
        )
        * 100
    ).tolist()
    x_values = np.arange(len(labels))
    bar_colors = _email_trend_segment_colors_v552(comparisons)

    ax.bar(
