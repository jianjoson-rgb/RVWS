}


def _taxonomy_clean_value_v557(value: Any) -> str:
    """Return a clean taxonomy label or blank for invalid placeholder values."""
    cleaned = normalize_text(value)
    if cleaned.lower() in TAXONOMY_INVALID_VALUES_V557:
        return ""
    return cleaned


def _taxonomy_is_valid_value_v557(value: Any) -> bool:
    """True when a taxonomy value should be used in published analysis."""
