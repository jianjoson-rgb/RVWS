def _finance_population_table_rows(
    analysis: FinanceQAGrainAnalysis,
) -> List[List[str]]:
    """Render Finance/Other distribution with Smiley Rate and Smiley trend."""
    rows: List[List[str]] = []
    for _, row in analysis.population_summary.iterrows():
        volume_text = _volume_display(
            normalize_text(row.get("Volume Status", "")),
            row.get("Volume Change %"),
        )
        smiley_rate = pd.to_numeric(
            pd.Series([row.get("Smiley Rate")]),
            errors="coerce",
        ).iloc[0]
        smiley_delta = pd.to_numeric(
            pd.Series([row.get("Smiley Delta vs Previous (pp)")]),
            errors="coerce",
        ).iloc[0]
        smiley_status = normalize_text(
            row.get("Smiley Trend Status", "")
        ) or "Insufficient previous data"
        trend_text = (
            f"{smiley_status}"
            if pd.isna(smiley_delta)
            else f"{smiley_delta:+.1f} pp | {smiley_status}"
        )
        rows.append(
            [
                normalize_text(row.get("Segment", "")),
                f"{int(row.get('Rated', 0)):,} | {volume_text}",
                f"{int(row.get('Smiley', 0)):,}",
                f"{int(row.get('Neutral', 0)):,}",
                f"{int(row.get('Frownie', 0)):,}",
                format_rate(smiley_rate),
                trend_text,
            ]
        )
    return rows



