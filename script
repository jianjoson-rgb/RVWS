def _v573_reason_driver_narrative(
    scope_name: str,
    records: Sequence[Mapping[str, Any]],
    *,
    site_specific: bool = False,
) -> List[str]:
    bullets: List[str] = []
    if site_specific:
        bullets.append(f"Non-Smiley Driver Impact for {scope_name} explains which survey reason themes are most connected to Non-Smiley outcomes.")
    else:
        bullets.append("Non-Smiley Driver Impact explains the leading reason themes behind Non-Smiley surveys.")

    for grain in ("Daily", "Weekly", "Monthly"):
        top = _v573_first_hierarchy_path(records, grain=grain)
        if not top:
            continue
        path = _v573_human_path(top.get("Level 1"), top.get("Level 2"), top.get("Level 3"), top.get("Drilldown"))
        if site_specific:
            bullets.append(
                f"{grain} Driver: Non-Smiley surveys were mainly tied to {path}, representing "
                f"{format_rate(top.get('Share', np.nan), 1)} of {grain.lower()} Non-Smiley surveys for {scope_name}."
            )
        else:
            bullets.append(
                f"{grain} Driver: Non-Smiley surveys were mainly tied to {path}, representing "
                f"{format_rate(top.get('Share', np.nan), 1)} of {grain.lower()} Non-Smiley surveys."
            )

    if not any(record for record in records):
        bullets.append("No usable Non-Smiley reason hierarchy was available.")

    if site_specific:
        bullets.append(f"Site Readout: this should be reviewed with {scope_name} taxonomy, QA, squad, AFTR, AHT, and async follow-up signals to confirm the strongest coaching or process action.")
    else:
        bullets.append("Executive Readout: this section connects Non-Smiley reason paths with taxonomy, QA, AFTR, AHT, and async follow-up signals so leaders can identify communication, process, knowledge, hygiene, system, policy, or uncontrollable issue mix.")
    return bullets


