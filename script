def _docx_v571_site_overview_bullets(
    site: str,
    site_grain_results: Mapping[str, GrainResult],
    overall_grain_results: Mapping[str, GrainResult],
    active: Sequence[str],
    config: AppConfig = CONFIG,
) -> List[List[Dict[str, Any]]]:
    """Build site-specific bottom-line bullets by active grain."""
    site_key = normalize_text(site)
    bullets: List[List[Dict[str, Any]]] = []
    baseline_map = {
        "DAILY": "12-day rolling",
        "WEEKLY": "12-week rolling",
        "MONTHLY": "3-month rolling",
    }

    for grain in ["DAILY", "WEEKLY", "MONTHLY"]:
        if grain not in active or grain not in site_grain_results:
            continue
        metric = site_grain_results[grain].overall
        overall_metric = overall_grain_results.get(grain).overall if grain in overall_grain_results else None
        site_rate = _email_v551_num(getattr(metric, "actual_rate", np.nan))
        overall_rate = _email_v551_num(getattr(overall_metric, "actual_rate", np.nan)) if overall_metric is not None else np.nan
        overall_gap = site_rate - overall_rate if pd.notna(site_rate) and pd.notna(overall_rate) else np.nan

        bullets.append(
            [
                _email_v551_seg(f"{grain.title()}: "),
                _email_v551_seg(
                    format_rate(site_rate),
                    color=_email_v551_rate_color(site_rate, threshold=float(getattr(config, "target_rate", 0.815))),
                    bold=True,
                ),
                _email_v551_seg(" Smiley, "),
                _email_v551_seg(format_pp(metric.delta), color=_email_v551_delta_color(metric.delta), bold=True),
                _email_v551_seg(f" vs {baseline_map.get(grain, 'rolling baseline')}, "),
                _email_v551_seg(format_pp(overall_gap), color=_email_v551_delta_color(overall_gap), bold=True),
                _email_v551_seg(f" vs same-period overall benchmark, across {format_int(metric.actual_responses)} rated responses."),
            ]
        )

    bullets.append(
        [
            _email_v551_seg(
                f"Site context: {site_key} movement is supported by that site's rated-response patterns across ticket age, taxonomy, tenure, squads, QA, and survey-linked handling indicators."
            ),
        ]
    )
    return bullets


def _docx_v571_build_site_summary_payload(
    site: str,
    site_report: SiteReport,
    selection: ReportSelection,
    report_scope: Mapping[str, Any],
    grain_results: Mapping[str, GrainResult],
    config: AppConfig = CONFIG,
) -> Dict[str, Any]:
    """Build a payload compatible with the v5.7.70 main summary renderer for one site."""
    site_key = normalize_text(site)
    site_grain_results = _docx_v571_build_site_grain_results(
        site=site_key,
        site_report=site_report,
        selection=selection,
        report_scope=report_scope,
        grain_results=grain_results,
        config=config,
    )
    active = _email_v565_active_grains(selection, site_grain_results)

    teammate_df = (
        getattr(site_report, "teammate_coaching_opportunities_v540", pd.DataFrame())
        if _monthly_teammate_coaching_enabled_v557(selection=selection, config=config)
        else pd.DataFrame()
    )

    detailed_readouts: List[Dict[str, Any]] = []
    for grain in active:
        if grain not in site_grain_results:
            continue
        fake_result = site_grain_results[grain]
        readout = _email_v565_build_grain_readout(
            selection=selection,
            report_scope=report_scope,
            grain_result=fake_result,
            qa_summary=getattr(site_report, "qa_summary", pd.DataFrame()),
            teammate_df=teammate_df,
            config=config,
        )
        readout = _docx_v571_replace_site_driver_line(
            readout,
            _docx_v571_site_position_segments(
                site=site_key,
                site_metric=fake_result.overall,
                overall_metric=grain_results.get(grain).overall if grain in grain_results else None,
            ),
        )
        detailed_readouts.append(readout)

    return {
        "lob": f"{selection.lob.upper()} | {site_key}",
        "analysis_mode": "ALL GRAINS" if len(active) > 1 else (active[0] if active else "REPORT"),
        "summary_scope_name": site_key,
        "summary_heading_level": 2,
        "summary_intro": (
            f"This site-specific summary uses only {site_key} rated surveys. "
            "It compares the site to its own rolling baseline and to the same-period overall benchmark, "
            "then summarizes the site's ticket age, taxonomy, tenure, squad, QA, and survey-linked handling drivers."
        ),
        "banner_title": "Site Executive Signal Banner",
        "overview_title": f"{site_key} Performance & Bottom Line",
        "banner_bullets": _docx_v571_site_banner_bullets(
            selection=selection,
            site=site_key,
            site_grain_results=site_grain_results,
            overall_grain_results=grain_results,
            active=active,
            config=config,
        ),
        "overview_bullets": _docx_v571_site_overview_bullets(
            site=site_key,
            site_grain_results=site_grain_results,
            overall_grain_results=grain_results,
            active=active,
            config=config,
        ),
        "detailed_readouts": detailed_readouts,
    }


def _docx_v570_add_main_summary_callout(
    document: Document,
    payload: Mapping[str, Any],
    config: AppConfig = CONFIG,
) -> None:
    """v5.7.71 callout renderer with scope-aware headings."""
    banner_title = normalize_text(payload.get("banner_title", "Executive Signal Banner")) or "Executive Signal Banner"
    overview_title = normalize_text(payload.get("overview_title", "Overall Performance & Bottom Line")) or "Overall Performance & Bottom Line"

    banner_lines = [
        _docx_v570_segment_text(bullet)
        for bullet in payload.get("banner_bullets", [])
        if _docx_v570_segment_text(bullet)
    ]
    overview_lines = [
        _docx_v570_segment_text(bullet)
        for bullet in payload.get("overview_bullets", [])
        if _docx_v570_segment_text(bullet)
    ]

    callout_lines: List[str] = []
    if banner_lines:
        callout_lines.append(banner_title)
        callout_lines.extend([f"• {line}" for line in banner_lines])

    if overview_lines:
        if callout_lines:
            callout_lines.append("")
        callout_lines.append(overview_title)
        callout_lines.extend([f"• {line}" for line in overview_lines])

    if not callout_lines:
        callout_lines = [
            "Executive Signal Summary",
            "• No structured executive signal was available for the selected reporting scope.",
        ]

    table = document.add_table(rows=1, cols=1)
    table.style = "Table Grid"
    table.alignment = WD_TABLE_ALIGNMENT.CENTER
    _v528_set_table_preferred_width_pct(table, 100.0)

    cell = table.rows[0].cells[0]
    _set_cell_shading(cell, "EAF2F8")
    _set_cell_margins(cell, top=120, start=140, bottom=120, end=140)
    cell.text = ""

    section_titles = {banner_title, overview_title, "Executive Signal Summary"}
    for idx, line in enumerate(callout_lines):
        paragraph = cell.paragraphs[0] if idx == 0 else cell.add_paragraph()
        paragraph.alignment = WD_ALIGN_PARAGRAPH.LEFT
        paragraph.paragraph_format.space_before = Pt(0)
        paragraph.paragraph_format.space_after = Pt(2 if line else 5)
        paragraph.paragraph_format.line_spacing = 1.08

        run = paragraph.add_run(line)
        run.font.name = config.docx_font_name
        run.font.size = Pt(8.2)
        run.font.color.rgb = RGBColor.from_string("1F2937")
        if line in section_titles:
            run.bold = True
            run.font.size = Pt(8.8)
            run.font.color.rgb = RGBColor.from_string("002060")


def _docx_v570_add_main_summary_driver_overview(
    document: Document,
    payload: Mapping[str, Any],
    config: AppConfig = CONFIG,
) -> None:
    """
    v5.7.71 scope-aware summary overview renderer.

    Overall payloads render as the cross-site Executive Signal & Driver Summary.
    Site payloads render as site-specific Executive Signal & Driver Summary
    sections inside each site chapter.
    """
    if document is None:
        return

    scope_name = normalize_text(payload.get("summary_scope_name", "Overall")) or "Overall"
    heading_level = int(payload.get("summary_heading_level", 1) or 1)
    heading_text = (
        "Executive Signal & Driver Summary"
        if scope_name.upper() == "OVERALL"
        else f"{scope_name} Executive Signal & Driver Summary"
    )
    document.add_heading(heading_text, level=max(1, min(3, heading_level)))

    intro_text = normalize_text(
        payload.get(
            "summary_intro",
            "This section expands the executive signal used by the email readout into "
            "a main-report summary. It keeps the overview scan-friendly while showing "
            "the key Daily, Weekly, and Monthly driver details by grain. All handling "
            "metrics are survey-linked and should not be read as total operation volume.",
        )
    )
    if intro_text:
        intro = document.add_paragraph()
        intro.paragraph_format.space_after = Pt(4)
        intro.paragraph_format.line_spacing = 1.08
        run = intro.add_run(intro_text)
        run.font.size = Pt(8.8)
        run.font.color.rgb = RGBColor.from_string("4B5563")

    _docx_v570_add_main_summary_callout(
        document=document,
        payload=payload,
        config=config,
    )

    table_title = (
        "Daily / Weekly / Monthly Site Driver Summary Table"
        if scope_name.upper() != "OVERALL"
        else "Daily / Weekly / Monthly Driver Summary Table"
    )
    heading = document.add_heading(table_title, level=max(2, min(4, heading_level + 1)))
    try:
        heading.paragraph_format.space_before = Pt(10)
        heading.paragraph_format.space_after = Pt(4)
    except Exception:
        pass

    _docx_v570_add_summary_matrix_table(
        document=document,
        payload=payload,
        config=config,
    )


def _docx_add_site_scope_v541(
    document: Document,
    site: str,
    site_report: SiteReport,
    selection: ReportSelection,
    report_scope: Mapping[str, Any],
    qa_summary: pd.DataFrame,
    scrubbed_tickets: pd.DataFrame,
    finance_scope_analysis: Optional[FinanceQAScopeAnalysis],
    focus_squads: Optional[Sequence[str]] = None,
    config: AppConfig = CONFIG,
) -> None:
    """
    v5.7.71 site scope renderer.

    Adds a site-specific Executive Signal & Driver Summary immediately after
    the standard site Executive Summary, then preserves the existing site
    chapter sections and calculation logic.
    """
    runtime_config = (
        config
        if _monthly_teammate_coaching_enabled_v557(selection=selection, config=config)
        else _config_without_teammate_coaching_v557(config)
    )

    document.add_page_break()
    document.add_heading(
        f"{site} — Complete Scope Readout",
        level=1,
    )

    document.add_heading("Executive Summary", level=2)
    for line in build_site_summary_text(site_report):
        add_bullet(document, line)

    if getattr(runtime_config, "main_summary_add_driver_overview", True):
        try:
            site_payload = _docx_v571_build_site_summary_payload(
                site=site,
                site_report=site_report,
                selection=selection,
                report_scope=report_scope,
                grain_results=globals().get("_CURRENT_GRAIN_RESULTS_FOR_SITE_SUMMARY_V571", {}),
                config=runtime_config,
            )
            # Fallback: when build_docx_report has not provided the global context,
            # do not fail the site chapter.
            if site_payload.get("detailed_readouts"):
                _docx_v570_add_main_summary_driver_overview(
                    document=document,
                    payload=site_payload,
                    config=runtime_config,
                )
        except Exception as exc:
            LOGGER.warning(
                "%s Executive Signal & Driver Summary could not be generated; continuing site report: %s",
                site,
                exc,
            )

    document.add_heading(
        "Performance, Drivers, and Recommended Actions",
        level=2,
    )
    for grain in ["DAILY", "WEEKLY", "MONTHLY"]:
        if grain not in site_report.grain_metrics:
            continue
        narrative = build_site_grain_narrative(
            site_report,
            grain,
            report_scope,
            runtime_config,
        )
        _docx_add_driver_section(
            document,
            narrative,
            heading_level=3,
        )

    document.add_heading("Supporting Site Evidence", level=2)
    rows = site_summary_table_rows(site_report)
    if rows:
        add_executive_table(
            document,
            headers=[
                "Grain",
                "Actual",
                "Baseline",
                "Delta",
                "Responses",
                "Projection",
                "Sample",
            ],
            rows=rows,
            font_size=7.8,
        )

    _docx_add_ticket_age_impact_v548(
        document=document,
        impact_df=getattr(site_report, "ticket_age_impact_v548", pd.DataFrame()),
        scope_name=site,
        config=runtime_config,
        heading_level=2,
    )

    _docx_add_qa_attribute_impact_v549(
        document=document,
        impact_df=getattr(site_report, "qa_attribute_impact_v549", pd.DataFrame()),
        scope_name=site,
        config=runtime_config,
        heading_level=2,
    )

    squad_visuals = getattr(
        site_report,
        "squad_chart_paths_v570",
        {},
    )
    visual_paths = [site_report.dashboard_path]
    visual_paths.extend(
        [
            squad_visuals.get(grain, "")
            for grain in _active_grains_v570(selection)
        ]
    )
    visual_paths.append(site_report.qa_heatmap_path)

    for visual_path in list(dict.fromkeys(visual_paths)):
        if visual_path and Path(visual_path).exists():
            paragraph = document.add_paragraph()
            paragraph.alignment = WD_ALIGN_PARAGRAPH.CENTER
            paragraph.add_run().add_picture(
                visual_path,
                width=Inches(
                    runtime_config.docx_site_chart_width_inches
                ),
            )

    squad_response_mix_tables = getattr(
        site_report,
        "squad_response_mix_tables_v531",
        {},
    )
    for squad_grain in _active_grains_v570(selection):
        squad_table = squad_response_mix_tables.get(
            squad_grain,
            pd.DataFrame(),
        )
        squad_rows = _squad_response_mix_rows_v531(
            squad_table,
            runtime_config,
            focus_squads=focus_squads,
        )
        if not squad_rows:
            continue

        document.add_heading(
            (
                "Performance by Squad — Response Mix "
                f"({squad_grain.title()})"
