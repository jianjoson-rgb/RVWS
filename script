build_high_performer_narratives = build_high_performer_narratives_with_squads



def generate_site_visuals(
    site_reports: Dict[str, SiteReport],
    output_dir: Path,
    report_scope: Mapping[str, Any],
    selection: ReportSelection,
    config: AppConfig = CONFIG,
) -> Dict[str, str]:
    """
    Generate site visuals for every active grain.

    ALL GRAINS produces Daily, Weekly, and Monthly squad-impact images.
    A specific grain produces only that grain's squad-impact image.
    """
    chart_paths: Dict[str, str] = {}
    active_grains = _active_grains_v570(selection)

    for site, report in site_reports.items():
        site_dir = output_dir / "site_charts"
        site_dir.mkdir(parents=True, exist_ok=True)

        dashboard_path = site_dir / (
            f"{safe_filename(site)}_Executive_Trend_Dashboard.png"
        )
        build_executive_dashboard(
            metrics={
                grain: metric
                for grain, metric in report.grain_metrics.items()
                if grain in active_grains
            },
            output_path=str(dashboard_path),
            report_label=report_scope["report_label"],
            lob_label=f"{selection.lob} | {site}",
            data_through=report_scope["data_through"],
            config=config,
        )
        report.dashboard_path = str(dashboard_path)
        chart_paths[f"{site}_dashboard"] = str(dashboard_path)

        squad_chart_paths: Dict[str, str] = {}
        all_focus_squads: List[str] = []

        for grain in active_grains:
            squad_table = report.squad_tables.get(
                grain,
                pd.DataFrame(),
            )
            squad_chart_path = site_dir / (
                f"{safe_filename(site)}_{grain}_Squad_Impact.png"
            )
            rendered = build_squad_impact_chart(
                squad_table=squad_table,
                site=site,
                grain=grain,
                output_path=str(squad_chart_path),
                config=config,
            )
            if rendered:
                squad_chart_paths[grain] = rendered
                chart_paths[
                    f"{site}_squad_impact_{grain.lower()}"
                ] = rendered

            if not squad_table.empty:
                focus = top_squads(
                    squad_table,
                    "negative",
                    config.top_squads_per_direction,
                    minimum_responses=1,
                )
                if not focus.empty:
                    all_focus_squads.extend(
                        focus["Squad Code"].astype(str).tolist()
                    )

        report.squad_chart_paths_v570 = squad_chart_paths
        report.squad_chart_path = (
            squad_chart_paths.get(active_grains[-1], "")
            if active_grains
            else ""
        )

        unique_focus_squads = list(dict.fromkeys(all_focus_squads))
        qa_heatmap_path = site_dir / (
            f"{safe_filename(site)}_QA_Attribute_Heatmap.png"
        )
        report.qa_heatmap_path = build_qa_heatmap(
            qa_summary=report.qa_summary,
            site=site,
            focus_squads=unique_focus_squads,
            output_path=str(qa_heatmap_path),
            config=config,
        )
        if report.qa_heatmap_path:
            chart_paths[f"{site}_qa_heatmap"] = report.qa_heatmap_path

    return chart_paths




