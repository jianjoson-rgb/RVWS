def extract_merchant_data(summary_rows):
    run_timestamp = datetime.now(
        ZoneInfo(TIMEZONE_NAME)
    ).strftime("%Y-%m-%d %H:%M:%S")

    print("======================================")
    print("MERCHANT EXTRACTION START")
    print("======================================")
    PROGRESS.set_message("Listing merchant files")

    all_source_files = list_all_matching_source_files(
        drive_service=drive_service,
        folder_id=MERCHANT_SOURCE_FOLDER_ID,
        filename_parser=parse_merchant_filename,
    )

    if not all_source_files:
        raise ValueError(
            "No files matching "
            "'MMM EOM YYYY Merchant Smileys.csv' were found."
        )

    latest_file = get_latest_file_by_filename(all_source_files)
    latest_file_name = latest_file["name"]
    cached_local_csv_by_file_id = {}

    try:
        PROGRESS.add_total(1)

        if REUSE_DOWNLOADED_LATEST_MERCHANT_FILE:
            print("--------------------------------------------------")
            print(
                "Downloading latest merchant file once for "
                "latest-date scan and processing reuse: "
                f"{latest_file_name}"
            )
            PROGRESS.set_message(
                f"Downloading reusable merchant file: {latest_file_name}"
            )
            latest_local_csv = download_drive_file_with_retry(
                drive_service=drive_service,
                file_id=latest_file["id"],
                file_name=latest_file_name,
                temp_prefix="merchant_smileys_",
            )
            cached_local_csv_by_file_id[latest_file["id"]] = (
                latest_local_csv
            )

            print("--------------------------------------------------")
            print(
                f"Scanning latest date from latest file: "
                f"{latest_file_name}"
            )
            PROGRESS.set_message(
                f"Scanning latest date: {latest_file_name}"
            )
            latest_registered_datetime = get_latest_date_from_local_csv(
                local_csv=latest_local_csv,
                file_name=latest_file_name,
                required_columns=MERCHANT_REQUIRED_COLUMNS,
                date_column=MERCHANT_DATE_COLUMN,
                company_column=MERCHANT_COMPANY_COLUMN,
                company_filter_value=MERCHANT_COMPANY_FILTER_VALUE,
                parse_dates_func=parse_dates_general,
            )
        else:
            latest_registered_datetime = get_latest_date_from_file(
                drive_service=drive_service,
                file_meta=latest_file,
                required_columns=MERCHANT_REQUIRED_COLUMNS,
                date_column=MERCHANT_DATE_COLUMN,
                company_column=MERCHANT_COMPANY_COLUMN,
                company_filter_value=MERCHANT_COMPANY_FILTER_VALUE,
                parse_dates_func=parse_dates_general,
                temp_prefix="merchant_smileys_",
            )

        PROGRESS.update(1, "Merchant latest-date scan complete")

        reference_latest_date = latest_registered_datetime.date()
        window_end_date = reference_latest_date
        window_start_date = (
            reference_latest_date
            - timedelta(weeks=LOOKBACK_WEEKS)
        )

        needed_months = set(
            month_keys_between(window_start_date, window_end_date)
        )
        source_files = [
            file_meta
            for file_meta in all_source_files
            if file_meta["parsed_filename"]["sort_key"]
            in needed_months
        ]

        if not source_files:
            raise ValueError(
                f"No monthly merchant files matched the "
                f"{LOOKBACK_WEEKS}-week window."
            )

        print(
            f"Merchant window: "
            f"{window_start_date} to {window_end_date}"
        )
        print(f"Merchant files to process: {len(source_files)}")
        PROGRESS.add_total(len(source_files))

        frames = []
        total_rows = 0
        start_ts = pd.Timestamp(window_start_date)
        end_ts_exclusive = (
            pd.Timestamp(window_end_date)
            + pd.Timedelta(days=1)
        )
        company_target = MERCHANT_COMPANY_FILTER_VALUE.casefold()

        for file_meta in source_files:
            file_name = file_meta["name"]
            modified_time = file_meta.get("modifiedTime", "")
            file_size_mb = get_file_size_mb(file_meta)
            matched_rows = 0
            file_status = "SUCCESS"
            local_csv = None
            using_cached_local_csv = False

            print("--------------------------------------------------")
            print(f"Processing merchant file: {file_name}")
            PROGRESS.set_message(
                f"Processing merchant file: {file_name}"
            )

            try:
                cached_local_csv = cached_local_csv_by_file_id.get(
                    file_meta["id"]
                )
                if cached_local_csv and os.path.exists(cached_local_csv):
                    local_csv = cached_local_csv
                    using_cached_local_csv = True
                    print(
                        "  Reusing already downloaded latest "
                        "merchant file."
                    )
                else:
                    local_csv = download_drive_file_with_retry(
                        drive_service,
                        file_meta["id"],
                        file_name,
                        "merchant_smileys_",
                    )

                header_df = pd.read_csv(
                    local_csv,
                    nrows=0,
                    dtype=str,
                    keep_default_na=False,
                    low_memory=False,
                )

                actual_columns, rename_map, _ = (
                    validate_and_map_headers(
                        list(header_df.columns),
                        MERCHANT_REQUIRED_COLUMNS,
                        file_name,
                    )
                )

                chunk_iter = pd.read_csv(
                    local_csv,
                    dtype=str,
                    keep_default_na=False,
                    low_memory=False,
                    chunksize=CSV_CHUNK_SIZE,
                    usecols=actual_columns,
                )

                for chunk_number, chunk in enumerate(
                    chunk_iter,
                    start=1,
                ):
                    chunk = chunk.rename(columns=rename_map)

                    company_mask = (
                        normalize_lookup_series(
                            chunk[MERCHANT_COMPANY_COLUMN]
                        )
                        == company_target
                    )
                    date_series = parse_dates_general(
                        chunk[MERCHANT_DATE_COLUMN]
                    )

                    mask = (
                        company_mask
                        & date_series.notna()
                        & (date_series >= start_ts)
                        & (date_series < end_ts_exclusive)
                    )

                    filtered_chunk = chunk.loc[
                        mask,
                        MERCHANT_BASE_OUTPUT_COLUMNS,
                    ].copy()

                    if not filtered_chunk.empty:
                        filtered_chunk[MERCHANT_DATE_COLUMN] = (
                            date_series.loc[filtered_chunk.index]
                        )
                        filtered_chunk["Ticket ID"] = (
                            normalize_ticket_id_series(
                                filtered_chunk["Ticket ID"]
                            )
                        )
                        filtered_chunk = filtered_chunk[
                            filtered_chunk["Ticket ID"] != ""
                        ]

                        if not filtered_chunk.empty:
                            frames.append(filtered_chunk)
                            matched_rows += len(filtered_chunk)
                            total_rows += len(filtered_chunk)

                    if chunk_number % 5 == 0:
                        PROGRESS.set_message(
                            f"Merchant {file_name}: "
                            f"{matched_rows:,} matched rows"
                        )

            except Exception as exc:
                file_status = f"FAILED: {exc}"
                print(
                    f"ERROR processing merchant file "
                    f"{file_name}: {exc}"
                )
                raise

            finally:
                summary_rows.append(
                    [
                        "MERCHANT",
                        run_timestamp,
                        LOOKBACK_WEEKS,
                        str(window_start_date),
                        str(window_end_date),
                        latest_file_name,
                        str(reference_latest_date),
                        file_name,
                        modified_time,
                        file_size_mb,
                        matched_rows,
                        file_status,
                    ]
                )
                if not using_cached_local_csv:
                    safe_cleanup_file(local_csv)
                PROGRESS.update(
                    1,
                    f"Merchant file complete: {file_name}",
                )

        merchant_df = (
            pd.concat(frames, ignore_index=True)
            if frames
            else pd.DataFrame(
                columns=MERCHANT_BASE_OUTPUT_COLUMNS
            )
        )

        print(f"Total merchant rows extracted: {total_rows:,}")

        return {
            "merchant_df": merchant_df,
            "window_start_date": window_start_date,
            "window_end_date": window_end_date,
            "reference_latest_date": reference_latest_date,
            "latest_file_name": latest_file_name,
            "total_rows": total_rows,
        }

    finally:
        for cached_path in set(cached_local_csv_by_file_id.values()):
            safe_cleanup_file(cached_path)


