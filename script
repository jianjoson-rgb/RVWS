def _email_v557_priority_squad_records(
    primary_site: str,
    focus_squads: Sequence[str],
    grain_results: Mapping[str, GrainResult],
    qa_summary: pd.DataFrame,
    config: AppConfig = CONFIG,
    limit: int = 5,
) -> List[Dict[str, Any]]:
    """Collect priority squads with site tags for nested QA focus actions."""
    records: List[Dict[str, Any]] = []
    seen: Set[Tuple[str, str]] = set()

    def add_record(site: Any, squad: Any) -> None:
        site_label = normalize_text(site)
        squad_label = normalize_text(squad)
        if not squad_label:
            return
        if not site_label:
            site_label = normalize_text(primary_site)
        key = (site_label.upper(), squad_label.upper())
        if key in seen:
            return
        seen.add(key)
        qa_text = _email_v551_squad_qa_focus_text(
            qa_summary=qa_summary,
            site=site_label,
            squad=squad_label,
            limit=2,
        )
        records.append(
            {
                "Site": site_label,
                "Squad Code": squad_label,
                "QA Focus": qa_text,
            }
        )

    # Start with focus squads from the action model.
    for squad in focus_squads or []:
        add_record(primary_site, squad)

    # Add low-Smiley squads from each active grain.
    for grain, result in (grain_results or {}).items():
        if result is None:
            continue
        bottom = _email_v557_squad_smiley_rows(
            grain_result=result,
            config=config,
            limit=limit,
        )
        for _, row in bottom.iterrows():
            add_record(row.get("Site", primary_site), row.get("Squad Code", ""))

    # Keep only the first configured priority squads.
    output = records[: max(1, int(limit))]
    return output


