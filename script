def _v572_add_summary_block_from_payload(
    document: Document,
    payload: Mapping[str, Any],
    *,
    config: AppConfig = CONFIG,
) -> None:
    """Render Executive Signal & Driver Summary as paragraph bullets, not a box or matrix."""
    banner_title = normalize_text(payload.get("banner_title", "Executive Signal Banner")) or "Executive Signal Banner"
    overview_title = normalize_text(payload.get("overview_title", "Overall Performance & Bottom Line")) or "Overall Performance & Bottom Line"

    banner_lines = [
        _v572_doc_text(_docx_v570_segment_text(bullet))
        for bullet in payload.get("banner_bullets", [])
        if _v572_doc_text(_docx_v570_segment_text(bullet))
    ]
    overview_lines = [
        _v572_doc_text(_docx_v570_segment_text(bullet))
        for bullet in payload.get("overview_bullets", [])
        if _v572_doc_text(_docx_v570_segment_text(bullet))
    ]

    _v572_add_plain_heading(document, banner_title.replace("Banner", "").strip() or banner_title, level=3)
    if banner_lines:
        for line in banner_lines:
            _v572_add_plain_bullet(document, line, level=0)
    else:
        _v572_add_plain_bullet(document, "No structured executive signal was available for this scope.", level=0)

    if overview_lines:
        _v572_add_plain_heading(document, overview_title, level=3)
        for line in overview_lines:
            _v572_add_plain_bullet(document, line, level=0)

    readouts = _docx_v570_readouts_by_grain(payload)
    for grain in V572_GRAIN_ORDER:
        readout = readouts.get(grain)
        if not readout:
            continue
        title = _docx_v570_period_title(readout)
        _v572_add_plain_heading(document, f"{grain.title()} Driver Summary — {title.split(chr(10))[-1] if title else grain.title()}", level=3)

        def _first_lines(label_tokens: Sequence[str], prefixes: Optional[Sequence[str]] = None, limit: int = 3) -> List[str]:
            if prefixes:
                return [_v572_doc_text(item) for item in _docx_v570_driver_prefix_texts(readout, prefixes)[:limit] if _v572_doc_text(item)]
            return [_v572_doc_text(item) for item in _docx_v570_block_paragraph_texts(readout, label_tokens)[:limit] if _v572_doc_text(item)]

        current_lines = _first_lines(["current performance"], limit=2)
        if current_lines:
            _v572_add_plain_bullet(document, "Current Performance: " + " ".join(current_lines), level=0, bold_prefix="Current Performance:")

        for prefix_label, prefixes in [
            ("Site / Position", ["site:", "position vs overall:"]),
            ("Ticket Age", ["ticket age:"]),
            ("Taxonomy", ["taxonomy:"]),
            ("Tenure", ["tenure group:"]),
            ("Handling", ["handling context:", "resolution / handling context:"]),
        ]:
            lines = _first_lines(["driver readout"], prefixes=prefixes, limit=2)
            if lines:
                _v572_add_plain_bullet(document, f"{prefix_label}: " + " ".join(lines), level=0, bold_prefix=f"{prefix_label}:")

        squad_lines = _first_lines(["squad focus"], limit=3)
        if squad_lines:
            _v572_add_plain_bullet(document, "Squad Signal: top squad driver details are summarized below.", level=0, bold_prefix="Squad Signal:")
            for line in squad_lines:
                _v572_add_plain_bullet(document, line, level=1, font_size=8.1)

        qa_lines = _first_lines(["qa attribute"], limit=2)
        if qa_lines:
            _v572_add_plain_bullet(document, "QA Attribute Signal: " + " ".join(qa_lines), level=0, bold_prefix="QA Attribute Signal:")

        deep_lines = _first_lines(["deep-dive"], limit=4)
        if deep_lines:
            _v572_add_plain_bullet(document, "Non-Smiley / AFTR / AHT Signal: " + " ".join(deep_lines), level=0, bold_prefix="Non-Smiley / AFTR / AHT Signal:")

        async_lines = _first_lines(["non-smiley + async", "async follow-up"], limit=2)
        if async_lines:
            _v572_add_plain_bullet(document, "Non-Smiley + Async Follow-Up Signal: " + " ".join(async_lines), level=0, bold_prefix="Non-Smiley + Async Follow-Up Signal:")

        recovery_lines = _first_lines(["daily close", "forecast", "projection"], limit=2)
        if recovery_lines:
            label = "Daily Close / Recovery Requirement" if grain == "DAILY" else "Forecast / Projection"
            _v572_add_plain_bullet(document, f"{label}: " + " ".join(recovery_lines), level=0, bold_prefix=f"{label}:")

        closing_lines = _first_lines(["final push", "week closing"], limit=2)
        if closing_lines:
            _v572_add_plain_bullet(document, "Week-End / Closing Assessment: " + " ".join(closing_lines), level=0, bold_prefix="Week-End / Closing Assessment:")

        teammate_lines = _first_lines(["teammate coaching"], limit=2)
        if teammate_lines:
            _v572_add_plain_bullet(document, "Teammate Coaching Signal: " + " ".join(teammate_lines), level=0, bold_prefix="Teammate Coaching Signal:")

        action_lines = _first_lines(["recommended action"], limit=2)
        if action_lines:
            _v572_add_plain_bullet(document, "Recommended Action: " + " ".join(action_lines), level=0, bold_prefix="Recommended Action:")


def _docx_v570_add_main_summary_driver_overview(
    document: Document,
    payload: Mapping[str, Any],
    config: AppConfig = CONFIG,
) -> None:
    """
    v5.7.72 paragraph-bullet summary renderer.

    Replaces the previous shaded callout + large matrix table with a scan-friendly
    paragraph/bullet section while preserving the same underlying readout logic.
    """
    if document is None:
        return

    scope_name = normalize_text(payload.get("summary_scope_name", "Overall")) or "Overall"
    heading_level = int(payload.get("summary_heading_level", 1) or 1)
    heading_text = (
        "Executive Signal & Driver Summary"
        if scope_name.upper() == "OVERALL"
        else f"{scope_name} Executive Signal & Driver Summary"
    )
    _v572_add_plain_heading(document, heading_text, level=max(1, min(3, heading_level)))

    intro_text = normalize_text(
        payload.get(
            "summary_intro",
            "This section summarizes the executive signal and driver story in paragraph bullets. "
            "Handling metrics are survey-linked and should not be read as total chat volume.",
        )
    )
    if intro_text:
        paragraph = document.add_paragraph()
        paragraph.paragraph_format.space_after = Pt(4)
        paragraph.paragraph_format.line_spacing = 1.08
        run = paragraph.add_run(_v572_doc_text(intro_text))
        run.font.size = Pt(8.8)
        run.font.color.rgb = RGBColor.from_string("4B5563")

    _v572_add_summary_block_from_payload(document, payload, config=config)


