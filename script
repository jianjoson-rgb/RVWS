def build_service(api_name, api_version, creds):
    http = httplib2.Http(timeout=REQUEST_TIMEOUT_SECONDS)
    authed_http = google_auth_httplib2.AuthorizedHttp(
        creds,
        http=http,
    )
    return build(
        api_name,
        api_version,
        http=authed_http,
        cache_discovery=False,
    )


