def build_email_trend_images_v552(
    scope_analyses: Mapping[str, FinanceQAScopeAnalysis],
    output_dir: Path,
    config: AppConfig = CONFIG,
) -> List[Dict[str, str]]:
    """Generate supplemental email images for Overall and every approved site."""
    if not config.email_body_include_trend_images or not scope_analyses:
        return []

    output_root = Path(output_dir) / "email_trend_images"
    output_root.mkdir(parents=True, exist_ok=True)

    scope_keys = ["OVERALL", *config.site_detail_sites]
    limit = max(1, int(config.email_body_trend_image_max_sites))
    results: List[Dict[str, str]] = []

    for scope_key in scope_keys[:limit]:
        normalized_key = normalize_text(scope_key).upper()
        analysis = scope_analyses.get(normalized_key)
        if analysis is None:
            continue

        scope_name = normalize_text(
            getattr(analysis, "scope_name", scope_key)
        ) or normalize_text(scope_key)
        safe_scope = re.sub(
            r"[^A-Za-z0-9_-]+",
            "_",
            scope_name,
        ).strip("_") or "Overall"
        image_path = output_root / (
            f"{safe_scope}_Trends_Timing_Smiley_Rate.png"
        )
        try:
            generated = build_email_scope_trend_image_v552(
                analysis,
                str(image_path),
                config,
            )
        except Exception as exc:
            LOGGER.exception(
                "Could not generate email trend image for %s: %s",
                scope_name,
                exc,
            )
            continue

        results.append(
            {
                "scope": scope_name,
                "path": generated,
            }
        )

    return results


