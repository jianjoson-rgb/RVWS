    grain_results: Mapping[str, GrainResult],
    config: AppConfig = CONFIG,
) -> List[Dict[str, Any]]:
    """
    Keep Key Performance Drivers & Recommended Actions, but structure QA focus as
    one main action bullet with priority squads as sub-bullets.
    """
    sections: List[Dict[str, Any]] = []
    for section in base_sections or []:
        title = normalize_text(section.get("title", ""))
        paragraphs = [
            normalize_text(value)
            for value in section.get("paragraphs", [])
            if normalize_text(value)
        ]

        # Week-end final push must exist only when Weekly is incomplete.
        weekly_result = (grain_results or {}).get("WEEKLY")
        weekly_complete = bool(
            weekly_result is not None
            and getattr(weekly_result, "overall", None) is not None
            and not bool(getattr(weekly_result.overall, "is_incomplete", False))
        )
        if weekly_complete and "final push for week-end" in title.lower():
            title = re.sub(
                r"(?i)final push for week-end",
                "Week Closing Assessment",
                title,
            )

        actions: List[Any] = []
        for value in section.get("actions", []):
            action_text = _email_v557_action_text(value)
            if not action_text:
                continue
            # Remove older one-bullet-per-squad QA focus lines. v5.7.57 replaces
            # them with one parent QA Focus action and nested squad sub-bullets.
            if re.match(r"(?i)^[A-Za-z0-9 _./&()'-]+\s+QA focus:", action_text):
                continue
            actions.append(value if isinstance(value, Mapping) else action_text)

        sections.append(
            {
                "title": title,
                "paragraphs": paragraphs,
                "action_heading": normalize_text(section.get("action_heading", "")),
                "actions": actions,
            }
        )

    if not sections:
        return sections

    qa_focus_action = _email_v557_priority_qa_focus_action(
        primary_site=primary_site,
        focus_squads=focus_squads,
        grain_results=grain_results,
        qa_summary=qa_summary,
        config=config,
    )
    if qa_focus_action:
        actions = sections[0].setdefault("actions", [])
        existing = {_email_v557_action_text(action) for action in actions}
        if _email_v557_action_text(qa_focus_action) not in existing:
            actions.append(qa_focus_action)

    return sections


def _email_v557_driver_readout_paragraphs(
    grain: str,
    grain_result: GrainResult,
    source_df: pd.DataFrame,
    metric: PeriodMetric,
    qa_summary: pd.DataFrame,
    teammate_df: pd.DataFrame,
    config: AppConfig = CONFIG,
) -> List[Dict[str, Any]]:
    """Build expanded Driver Readout paragraphs for one grain."""
    paragraphs: List[Dict[str, Any]] = [
        {"level": 0, "segments": _email_v551_site_segments(grain_result, metric, config=config)},
        {"level": 0, "segments": _email_v551_ticket_age_segments(source_df, "Overall", metric, config=config)},
        {"level": 0, "segments": _email_v551_taxonomy_segments(source_df, metric)},
        {"level": 0, "segments": _email_v551_tenure_segments(source_df, metric)},
    ]

    paragraphs.extend(
        _email_v557_squad_smiley_paragraphs(
            grain_result=grain_result,
            config=config,
            limit=5,
        )
    )
    paragraphs.extend(
        _email_v557_squad_qa_paragraphs(
            source_df=source_df,
            config=config,
            limit=5,
        )
    )

    # Teammate Coaching Opportunities is monthly-only. Daily and Weekly detailed
    # readouts intentionally omit teammate coaching to avoid applying monthly
    # criteria to shorter reporting grains.
    if normalize_text(grain).upper() == "MONTHLY":
        paragraphs.append({"level": 0, "segments": _email_v551_teammate_segments(teammate_df)})

    paragraphs.extend(
        [
            {"level": 0, "segments": _email_v551_qa_attribute_segments(source_df, "Overall", config=config)},
            {"level": 0, "segments": _email_v551_volume_mix_segments(source_df, metric)},
        ]
    )

    return paragraphs


def _email_v551_build_grain_readout(
    selection: ReportSelection,
    report_scope: Mapping[str, Any],
    grain_result: GrainResult,
    qa_summary: pd.DataFrame,
    teammate_df: pd.DataFrame,
    config: AppConfig = CONFIG,
) -> Dict[str, Any]:
    """
    Build the v5.7.57 detailed email readout for one active grain.

    Squad readout now includes bottom-5 Smiley and bottom-5 QA squad bullets.
    Teammate coaching appears only in Monthly.
    """
    metric = grain_result.overall
    grain = normalize_text(grain_result.grain).upper()
    source_df = grain_result.current_period_df.copy()
    title = {
        "DAILY": "Daily Detailed Readout",
        "WEEKLY": "Weekly Detailed Readout",
        "MONTHLY": "Monthly Detailed Readout",
    }.get(grain, f"{grain.title()} Detailed Readout")

    projection_title = (
        "Daily Close / Recovery Requirement"
        if grain == "DAILY"
        else "Forecast / Projection"
    )

    readout_teammate_df = teammate_df if grain == "MONTHLY" else pd.DataFrame()

    return {
        "grain": grain,
        "title": title,
        "period_label": _email_v551_current_period_label(metric),
        "blocks": [
            {
                "label": "Current Performance",
                "paragraphs": [
                    {
                        "level": 0,
                        "segments": _email_v551_current_performance_segments(
                            selection,
                            metric,
                            config=config,
                        ),
                    }
                ],
            },
            {
                "label": "Driver Readout",
                "paragraphs": _email_v557_driver_readout_paragraphs(
                    grain=grain,
                    grain_result=grain_result,
                    source_df=source_df,
                    metric=metric,
                    qa_summary=qa_summary,
                    teammate_df=readout_teammate_df,
                    config=config,
                ),
            },
            {
                "label": projection_title,
                "paragraphs": [
                    {
                        "level": 0,
                        "segments": _email_v551_projection_segments(
                            metric,
                            config=config,
                        ),
                    }
                ],
            },
            {
                "label": "Recommended Action",
                "paragraphs": [
                    {
                        "level": 0,
                        "segments": _email_v551_recommended_action_segments(
                            grain_result,
                            qa_summary,
                            readout_teammate_df,
                            config=config,
                        ),
                    }
                ],
            },
        ],
    }


def _email_plain_text_from_payload(payload: Mapping[str, Any]) -> str:
    """Render structured email payload with nested QA focus action support."""
    if not payload.get("detailed_readouts"):
        return _v550_email_plain_text_from_payload(payload)

    lines: List[str] = []
    lob = normalize_text(payload.get("lob", ""))
    lines.append(f"{lob} Executive Summary" if lob else "Executive Summary")
    lines.append("")

    overview_title = normalize_text(
        payload.get("overview_title", "Overall Performance & Bottom Line")
    )
    lines.append(overview_title)
    overview_text = _email_v551_segments_text(payload.get("overview_segments", []))
    if overview_text:
        lines.append(overview_text)
    lines.append("")

    for readout in payload.get("detailed_readouts", []):
        title = normalize_text(readout.get("title", "Detailed Readout"))
        period = normalize_text(readout.get("period_label", ""))
        lines.append(title if not period else f"{title} — {period}")
        for block in readout.get("blocks", []):
            label = normalize_text(block.get("label", ""))
            if label:
                lines.append(label)
            for paragraph in block.get("paragraphs", []):
                paragraph_text = _email_v551_segments_text(paragraph.get("segments", []))
                if not paragraph_text:
                    continue
                level = int(paragraph.get("level", 0) or 0)
                prefix = "  - " if level > 0 else "• "
                lines.append(f"{prefix}{paragraph_text}")
        lines.append("")

    lines.append("Key Performance Drivers & Recommended Actions")
    lines.append("")
    for section in payload.get("sections", []):
        title = normalize_text(section.get("title", ""))
        if title:
            lines.append(title)
        for paragraph in section.get("paragraphs", []):
            paragraph_text = normalize_text(paragraph)
            if paragraph_text:
                lines.append(paragraph_text)
        action_heading = normalize_text(section.get("action_heading", ""))
        if action_heading:
            lines.append(action_heading)
        for action in section.get("actions", []):
            action_text = _email_v557_action_text(action)
            if not action_text:
                continue
            lines.append(f"• {action_text}")
            for sub_action in _email_v557_action_sub_actions(action):
                lines.append(f"  - {sub_action}")
        lines.append("")

    followup = normalize_text(payload.get("followup_line", ""))
    if followup:
        lines.append(followup)
        lines.append("")

    return "\n".join(lines).strip() + "\n"


def _email_html_from_payload(payload: Mapping[str, Any]) -> str:
    """Render structured email HTML with nested QA focus action support."""
    if not payload.get("detailed_readouts"):
        return _v550_email_html_from_payload(payload)

    esc = html.escape
    parts: List[str] = [
        "<div style=\"font-family:Arial,Helvetica,sans-serif;font-size:14px;line-height:1.45;color:#202124;\">",
    ]
    lob = normalize_text(payload.get("lob", ""))
    parts.append(f"<h2>{esc(lob + ' Executive Summary' if lob else 'Executive Summary')}</h2>")

    overview_title = normalize_text(
        payload.get("overview_title", "Overall Performance & Bottom Line")
    )
    parts.append(f"<h3>{esc(overview_title)}</h3>")
    overview_html = _email_html_segments_v551(payload.get("overview_segments", []))
    if overview_html:
        parts.append(f"<p>{overview_html}</p>")

    for readout in payload.get("detailed_readouts", []):
        title = normalize_text(readout.get("title", "Detailed Readout"))
        period = normalize_text(readout.get("period_label", ""))
        parts.append(f"<h3>{esc(title if not period else title + ' — ' + period)}</h3>")
        for block in readout.get("blocks", []):
            label = normalize_text(block.get("label", ""))
            if label:
                parts.append(f"<p><strong>{esc(label)}</strong></p>")
            block_paragraphs = block.get("paragraphs", [])
            if block_paragraphs:
                parts.append("<ul>")
                for paragraph in block_paragraphs:
                    segment_html = _email_html_segments_v551(paragraph.get("segments", []))
                    if not segment_html:
                        continue
                    level = int(paragraph.get("level", 0) or 0)
                    if level > 0:
                        parts.append(f"<li style=\"margin-left:20px;\">{segment_html}</li>")
                    else:
                        parts.append(f"<li>{segment_html}</li>")
                parts.append("</ul>")

    parts.append(
        "<p style=\"margin-top:18px;\"><strong>Key Performance Drivers &amp; Recommended Actions</strong></p>"
    )
    for section in payload.get("sections", []):
        title = esc(normalize_text(section.get("title", "")))
        if title:
            parts.append(f"<p style=\"margin-top:16px;\"><strong>{title}</strong></p>")
        for paragraph in section.get("paragraphs", []):
            paragraph_text = normalize_text(paragraph)
            if paragraph_text:
                parts.append(f"<p>{esc(paragraph_text)}</p>")
        action_heading = normalize_text(section.get("action_heading", ""))
        if action_heading:
            parts.append(f"<p><strong>{esc(action_heading)}</strong></p>")
        actions = [action for action in section.get("actions", []) if _email_v557_action_text(action)]
        if actions:
            parts.append("<ul>")
            for action in actions:
                action_text = esc(_email_v557_action_text(action))
                sub_actions = _email_v557_action_sub_actions(action)
                if sub_actions:
                    parts.append(f"<li>{action_text}<ul>")
                    parts.extend(f"<li>{esc(sub_action)}</li>" for sub_action in sub_actions)
                    parts.append("</ul></li>")
                else:
                    parts.append(f"<li>{action_text}</li>")
            parts.append("</ul>")

    followup = normalize_text(payload.get("followup_line", ""))
    if followup:
        parts.append(f"<p style=\"margin-top:18px;\">{esc(followup)}</p>")
    parts.append("</div>")
    return "\n".join(parts)


def _docx_v557_add_action_bullet(
    document: Document,
    text_value: str,
    *,
    level: int = 0,
    font_size: float = 8.8,
) -> None:
    """Add a bullet or nested bullet to the email DOCX body."""
    style_candidates = ["List Bullet 2", "List Bullet"] if level > 0 else ["List Bullet"]
    paragraph = None
    for style_name in style_candidates:
        try:
            paragraph = document.add_paragraph(style=style_name)
            break
        except Exception:
            paragraph = None
    if paragraph is None:
        paragraph = document.add_paragraph()
    if level > 0:
        try:
            paragraph.paragraph_format.left_indent = Inches(0.35)
        except Exception:
            pass
    paragraph.paragraph_format.space_after = Pt(2)
    run = paragraph.add_run(normalize_text(text_value))
    run.font.size = Pt(font_size)


def _docx_add_email_body(
    document: Document,
    payload: Mapping[str, Any],
    config: AppConfig = CONFIG,
) -> None:
    """
    v5.7.57 FOR EMAIL ONLY DOCX renderer.

    Supports expanded squad bullets and nested QA focus actions while preserving
    the v5.7.53 spacing hardening for styled text runs.
    """
    if not payload.get("detailed_readouts"):
        _v550_docx_add_email_body(document, payload, config=config)
        return

    lob = normalize_text(payload.get("lob", ""))
    heading = f"{lob} Executive Summary" if lob else "Email Executive Summary"
    document.add_heading(heading, level=1)

    subject = document.add_paragraph()
    subject.paragraph_format.space_after = Pt(4)
    subject_run = subject.add_run("Subject: ")
    subject_run.bold = True
    subject_run.font.color.rgb = RGBColor.from_string(EMAIL_V551_BLUE)
    subject.add_run(normalize_text(payload.get("subject", "")))

    document.add_heading(
        normalize_text(payload.get("overview_title", "Overall Performance & Bottom Line")),
        level=2,
    )
    _docx_add_email_segment_paragraph_v551(
        document,
        payload.get("overview_segments", []),
        font_size=9.0,
    )

    for readout in payload.get("detailed_readouts", []):
        title = normalize_text(readout.get("title", "Detailed Readout"))
        period = normalize_text(readout.get("period_label", ""))
        heading_text = title if not period else f"{title} — {period}"
        document.add_heading(heading_text, level=2)

        for block in readout.get("blocks", []):
            label = normalize_text(block.get("label", ""))
            paragraphs = block.get("paragraphs", [])
            if not paragraphs:
                continue

            first = True
            for paragraph_data in paragraphs:
                segments = paragraph_data.get("segments", [])
                level = int(paragraph_data.get("level", 0) or 0)
                if first:
                    _docx_add_email_label_and_segments_v551(
                        document,
                        label,
                        segments,
                        font_size=8.8,
                    )
                    first = False
                else:
                    _docx_add_email_segment_paragraph_v551(
                        document,
                        segments,
                        style="List Bullet",
                        font_size=8.4,
                        left_indent=0.22 if level > 0 else 0.0,
                    )

    document.add_heading(
        "Key Performance Drivers & Recommended Actions",
        level=2,
    )
    for section in payload.get("sections", []):
        title = normalize_text(section.get("title", ""))
        if title:
            document.add_heading(title, level=3)

        for paragraph_text in section.get("paragraphs", []):
            if normalize_text(paragraph_text):
                paragraph = document.add_paragraph(normalize_text(paragraph_text))
                paragraph.paragraph_format.space_after = Pt(3)
                for run in paragraph.runs:
                    run.font.size = Pt(8.8)

        action_heading = normalize_text(section.get("action_heading", ""))
        if action_heading:
            paragraph = document.add_paragraph()
            paragraph.paragraph_format.space_after = Pt(2)
            run = paragraph.add_run(action_heading)
            run.bold = True
            run.font.size = Pt(8.8)
            run.font.color.rgb = RGBColor.from_string(EMAIL_V551_BLUE)

        for action in section.get("actions", []):
            action_text = _email_v557_action_text(action)
            if not action_text:
                continue
            _docx_v557_add_action_bullet(
                document,
                action_text,
                level=0,
                font_size=8.8,
            )
            for sub_action in _email_v557_action_sub_actions(action):
                _docx_v557_add_action_bullet(
                    document,
                    sub_action,
                    level=1,
                    font_size=8.4,
                )

    followup = normalize_text(payload.get("followup_line", ""))
    if followup:
        paragraph = document.add_paragraph(followup)
        paragraph.paragraph_format.space_before = Pt(6)
        for run in paragraph.runs:
            run.font.size = Pt(8.8)




