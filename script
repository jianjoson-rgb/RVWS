def timestamp_slug() -> str:
    return now_manila().strftime("%Y%m%d_%H%M%S")


def sunday_week_start(ts: pd.Timestamp) -> pd.Timestamp:
    """Return the Sunday that starts the reporting week containing ``ts``."""
    ts = pd.Timestamp(ts).normalize()
    days_since_sunday = (int(ts.weekday()) + 1) % 7
    return ts - pd.Timedelta(days=days_since_sunday)


def daily_chart_label(ts: Any) -> str:
    """
    Return the approved Daily timeline label in MM/DD format.

    Example:
        2026-08-02 -> 08/02
    """
    timestamp = pd.to_datetime(ts, errors="coerce")
    if pd.isna(timestamp):
        return ""
    return pd.Timestamp(timestamp).strftime("%m/%d")


def week_beginning_chart_label(ts: Any) -> str:
    """
    Return the approved Weekly timeline label in WBMMDD format.

    The date portion always represents the Sunday week-beginning date.

    Example:
        Week beginning 2026-07-26 -> WB0726
    """
    timestamp = pd.to_datetime(ts, errors="coerce")
    if pd.isna(timestamp):
        return ""
    week_start = sunday_week_start(pd.Timestamp(timestamp))
    return f"WB{week_start.strftime('%m%d')}"


def resolve_weekly_reference_date(latest_available_date: pd.Timestamp) -> pd.Timestamp:
    """
    Return the weekly reporting cut-off for a Sunday-Saturday reporting week.

    Standard rule:
      - Use the latest available source date minus one calendar day.

    Monday safeguard:
      - If the latest source date is Monday, minus one day lands on Sunday,
        which is the first day of a new Sunday-Saturday week.
      - In that case, move the cut-off back one additional day to Saturday so
        the report uses the previous completed week, as required.
    """
    latest_available_date = pd.Timestamp(latest_available_date).normalize()
    reference_date = latest_available_date - pd.Timedelta(days=1)
    if latest_available_date.weekday() == 0:  # Monday
        reference_date = reference_date - pd.Timedelta(days=1)
    return reference_date


def month_start(ts: pd.Timestamp) -> pd.Timestamp:
    ts = pd.Timestamp(ts)
    return pd.Timestamp(year=ts.year, month=ts.month, day=1)


def month_end(ts: pd.Timestamp) -> pd.Timestamp:
    return month_start(ts) + pd.offsets.MonthEnd(1)


def month_key(ts: pd.Timestamp) -> str:
    return pd.Timestamp(ts).strftime("%Y-%m")


def month_label(ts: pd.Timestamp) -> str:
    return pd.Timestamp(ts).strftime("%B %Y")


def period_date_range_text(start: pd.Timestamp, end: pd.Timestamp) -> str:
    start = pd.Timestamp(start)
    end = pd.Timestamp(end)
    if start == end:
        return start.strftime("%b %d, %Y")
    if start.year == end.year:
        return f"{start.strftime('%b %d')}–{end.strftime('%b %d, %Y')}"
    return f"{start.strftime('%b %d, %Y')}–{end.strftime('%b %d, %Y')}"


def validate_probability(value: float, name: str) -> None:
    if value is None or pd.isna(value):
        return
    if not 0 <= float(value) <= 1:
        raise ValueError(f"{name} must be between 0 and 1. Received: {value}")


def records_to_dataframe(records: List[Dict[str, Any]]) -> pd.DataFrame:
    return pd.DataFrame(records) if records else pd.DataFrame()

