def _v5725_safe_cleanup_active_output_guard() -> None:
    """
    Non-destructive guard for the v5.7.28 clean build.

    This intentionally does not delete legacy helper functions. Some helpers are
    retained because older validated builders, fallbacks, and notebook callbacks
    may still reference their names. The guard only confirms that approved
    removed outputs are not wired into the active publishing path.
    """
    required_active = (
        "run_executive_report",
        "run_without_widgets",
        "launch_control_panel",
        "ExecutiveReportControlPanel",
        "_docx_add_finance_scope_v52",
        "_docx_add_finance_qa_section",
        "build_selected_grain_sites_overview_v570",
        "_publish_docx_google_doc_v571",
        "_publish_binary_file_v571",
    )
    missing_active = [
        name for name in required_active
        if not callable(globals().get(name))
    ]
    if missing_active:
        raise RuntimeError(
            "Required active report helpers are missing after safe cleanup: "
            + ", ".join(missing_active)
        )

    inactive_output_calls = {
        "build_email_consolidated_reporting_view_v570",
        "_docx_add_email_table_images_v560",
        "_align_timeframe_tables_to_smiley_registered_v570",
    }

    try:
        import ast as _ast
        import inspect as _inspect

        function_sources = []
        for func_name in ("run_executive_report", "build_email_summary_docx_v560"):
            func_obj = globals().get(func_name)
            if callable(func_obj):
                function_sources.append(_inspect.getsource(func_obj))

        for func_source in function_sources:
            parsed = _ast.parse(func_source)
            for node in _ast.walk(parsed):
                if isinstance(node, _ast.Call):
                    if isinstance(node.func, _ast.Name):
                        call_name = node.func.id
                    elif isinstance(node.func, _ast.Attribute):
                        call_name = node.func.attr
                    else:
                        call_name = ""
                    if call_name in inactive_output_calls:
                        raise RuntimeError(
                            "Inactive timeframe/email-table helper is still called "
                            f"in the active report path: {call_name}"
                        )
    except RuntimeError:
        raise
    except Exception as exc:
        LOGGER.warning("Safe cleanup guard could not complete static call audit: %s", exc)



