    Dict[str, Any],
    Dict[str, GrainResult],
]:
    """
    Build chart-only grain results from Smiley Registered At.

    Existing report calculations remain on the original filtered_df.
    """
    trend_df = _smiley_registered_view_v567(
        filtered_df
    )
    if trend_df.empty:
        raise ValueError(
            "No valid Smiley Registered At timestamps remain after filtering."
        )

    trend_scope = build_report_scope(
        trend_df,
        selection.report_month,
