def add_ticket_qa_metrics(df: pd.DataFrame) -> pd.DataFrame:
    work = df.copy()
    qa_frame = work[list(QA_ATTRIBUTE_COLUMNS)].apply(
        pd.to_numeric, errors="coerce"
    )
    work["Audited Attribute Count"] = qa_frame.notna().sum(axis=1)
    work["Passed Attribute Count"] = qa_frame.eq(1).sum(axis=1)
    work["Failed Attribute Count"] = qa_frame.eq(0).sum(axis=1)
    work["QA Pass Rate"] = np.where(
        work["Audited Attribute Count"].gt(0),
        work["Passed Attribute Count"] / work["Audited Attribute Count"],
        np.nan,
    )

    def failed_list(row: pd.Series) -> str:
        failed = [
            column
            for column in QA_ATTRIBUTE_COLUMNS
            if pd.notna(row[column]) and float(row[column]) == 0.0
        ]
        return ", ".join(failed)

    if work.empty:
        work["Failed Attributes"] = pd.Series(index=work.index, dtype="object")
    else:
        work["Failed Attributes"] = work.apply(failed_list, axis=1)
    work["Is Non-Smiley"] = (
        work["Smiley Numerator"].lt(work["Responses"])
        | work["Smiley Rating"]
        .astype(str)
        .str.lower()
        .str.contains("frown|negative|non.?smiley|nss", regex=True)
    )
    return work


def build_qa_attribute_summary(
    report_df: pd.DataFrame,
) -> pd.DataFrame:
    if report_df.empty:
        return pd.DataFrame()

    records: List[Dict[str, Any]] = []
    for (site, squad), group in report_df.groupby(
        ["Site", "Squad Code"], dropna=False
    ):
        for attribute in QA_ATTRIBUTE_COLUMNS:
            values = pd.to_numeric(group[attribute], errors="coerce")
            audited = int(values.notna().sum())
            passed = int(values.eq(1).sum())
            failed = int(values.eq(0).sum())
            pass_rate = safe_rate(passed, audited)
            records.append(
                {
                    "Site": site,
                    "Squad Code": squad,
                    "QA Attribute": attribute,
                    "Audited": audited,
                    "Passed": passed,
                    "Failed": failed,
                    "Pass Rate": pass_rate,
                    "Failure Rate": 1 - pass_rate if pd.notna(pass_rate) else np.nan,
                }
            )
    return pd.DataFrame(records)


def build_scrubbed_tickets(
    report_df: pd.DataFrame,
    primary_site: str,
    focus_squads: Sequence[str],
    config: AppConfig = CONFIG,
) -> pd.DataFrame:
    if report_df.empty:
        return pd.DataFrame()

    work = add_ticket_qa_metrics(report_df)
    focus_squad_set = {normalize_text(value) for value in focus_squads if value}
    work["Priority Site"] = work["Site"].eq(primary_site)
    work["Priority Squad"] = work["Squad Code"].isin(focus_squad_set)

    impact_values = []
    for column in SOURCE_IMPACT_COLUMNS.values():
        if column in work.columns:
            impact_values.append(pd.to_numeric(work[column], errors="coerce").abs())
    if impact_values:
        impact_frame = pd.concat(impact_values, axis=1)
        work["Max Source Impact Abs"] = impact_frame.max(axis=1, skipna=True)
    else:
        work["Max Source Impact Abs"] = np.nan

    eligible = work[
        work["Audited Attribute Count"].gt(0)
        & (
            work["Is Non-Smiley"]
            | work["Failed Attribute Count"].gt(0)
        )
    ].copy()

    if eligible.empty:
        return eligible

    eligible["_comment_present"] = eligible["Smiley Comment"].ne("").astype(int)
    eligible = eligible.sort_values(
        [
            "Priority Site",
            "Priority Squad",
            "Is Non-Smiley",
            "Failed Attribute Count",
            "QA Pass Rate",
            "_comment_present",
            "Max Source Impact Abs",
            "Date",
        ],
        ascending=[False, False, False, False, True, False, False, False],
    )

    per_site = (
        eligible.groupby("Site", group_keys=False)
        .head(config.scrub_ticket_limit_per_site)
        .copy()
    )
    final = per_site.head(config.scrub_ticket_limit).copy()
    final = final.drop(columns=["_comment_present"], errors="ignore")

    output_columns = [
        "Ticket ID",
        "Date",
        "Site",
        "Squad Code",
        "Smiley Rating",
        "Smiley Comment",
        "Level One",
        "Level Two",
        "Type of Audit",
        "QA Pass Rate",
        "Audited Attribute Count",
        "Passed Attribute Count",
        "Failed Attribute Count",
        "Failed Attributes",
        "Impact (Day)",
        "Impact (Week)",
        "Impact (Month)",
        "Priority Site",
        "Priority Squad",
    ]
    return final[[column for column in output_columns if column in final.columns]]


