                        row.get("Smiley Comment", ""),
                        config.max_comment_chars_docx,
                    ),
                ]
            )

        add_executive_table(
            document,
            headers=[
                "Ticket ID",
                "Date",
                "Site",
                "Squad",
                "QA Pass",
                "Failed Attributes",
                "Level One",
                "Level Two",
                "Comment (PII Redacted)",
            ],
            rows=rows,
            font_size=6.8,
        )

    _docx_v553_apply_global_spacing(document, email_only=False, config=config)

    output = Path(output_path)
    output.parent.mkdir(parents=True, exist_ok=True)
    document.save(output)

    if not output.exists() or output.stat().st_size == 0:
        raise RuntimeError(
            f"DOCX generation failed: {output}"
        )

    LOGGER.info(
        "DOCX report created in scope-first order: %s",
        output,
    )
    return str(output)












