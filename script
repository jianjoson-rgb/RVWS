def _ticket_age_population_from_scope_v548(
    report_scope: Mapping[str, Any],
    source_df: Optional[pd.DataFrame] = None,
) -> pd.DataFrame:
    """
    Return the static analysis population used for Ticket Age Impact.

    For ALL GRAINS, this follows report_scope['display_df']. For a single active
    grain, analysis_report_scope already narrows display_df to that grain period.
    """
    if isinstance(report_scope, Mapping):
        display_df = report_scope.get("display_df")
        if isinstance(display_df, pd.DataFrame) and not display_df.empty:
            return display_df.copy()

    if source_df is None or source_df.empty:
        return pd.DataFrame()

    work = source_df.copy()
    if not isinstance(report_scope, Mapping) or "Date" not in work.columns:
        return work

    start = pd.to_datetime(report_scope.get("report_start"), errors="coerce")
    end = pd.to_datetime(
        report_scope.get(
            "data_through",
            report_scope.get("report_end"),
        ),
        errors="coerce",
    )
    if pd.notna(start) and pd.notna(end):
        date_values = pd.to_datetime(work["Date"], errors="coerce")
        work = work[date_values.between(start, end, inclusive="both")].copy()
    return work


def _overall_ticket_age_impact_v548(
    report_scope: Mapping[str, Any],
    config: AppConfig = CONFIG,
) -> pd.DataFrame:
    """Build document-safe Overall Ticket Age Impact using approved site rows."""
    population = _ticket_age_population_from_scope_v548(report_scope)
    if population.empty:
        return pd.DataFrame()
    try:
        population = filter_rows_to_approved_sites(population, config)
    except Exception:
        # Keep report generation non-blocking if the approved-site helper changes.
        if "Site" in population.columns:
            approved = {
                normalize_text(site).upper()
                for site in getattr(config, "site_detail_sites", ())
            }
            if approved:
                population = population[
                    population["Site"].map(lambda value: normalize_text(value).upper()).isin(approved)
                ].copy()
    return build_ticket_age_impact_table_v548(
        source_df=population,
        scope_name="Overall",
        config=config,
    )



