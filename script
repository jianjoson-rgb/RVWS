def _email_v565_clean_label(value: Any) -> str:
    """Normalize a driver/deep-dive label and return blank for placeholders."""
    cleaned = normalize_text(value)
    if cleaned.lower() in EMAIL_V565_INVALID_LABELS:
        return ""
    return cleaned


def _email_v565_period_phrase(grain: str) -> str:
    key = normalize_text(grain).upper()
    if key == "DAILY":
        return "same-day"
    if key == "WEEKLY":
        return "same-week"
    if key == "MONTHLY":
        return "same-month"
    return "same-period"


def _email_v565_outcome_series(df: pd.DataFrame) -> pd.Series:
    """Return canonical Smiley/Neutral/Frownie outcome labels for rows."""
    if df is None or not isinstance(df, pd.DataFrame) or df.empty:
        return pd.Series(dtype="object")
    if "Smiley Rating" in df.columns:
        outcomes = df["Smiley Rating"].map(normalize_smiley_outcome)
    else:
        outcomes = pd.Series("", index=df.index, dtype="object")

    # Fallback for rows where rating text is missing but the binary numerator exists.
    missing = outcomes.eq("")
    if missing.any():
        if "Smiley Numerator" in df.columns:
            numerator = pd.to_numeric(df["Smiley Numerator"], errors="coerce")
        elif "Smiley Rate" in df.columns:
            numerator = normalize_rate_series(df["Smiley Rate"])
        else:
            numerator = pd.Series(np.nan, index=df.index)

        inferred = pd.Series("", index=df.index, dtype="object")
        inferred.loc[numerator.eq(1)] = "Smiley"
        inferred.loc[numerator.eq(0)] = "Non-Smiley"
        outcomes.loc[missing] = inferred.loc[missing]
    return outcomes.fillna("").astype(str)


def _email_v565_response_summary(df: pd.DataFrame) -> Dict[str, float]:
    """Summarize rated, Smiley, Neutral, Frownie, and Non-Smiley counts."""
    if df is None or not isinstance(df, pd.DataFrame) or df.empty:
        return {
            "Rated": 0.0,
            "Smiley": 0.0,
            "Neutral": 0.0,
            "Frownie": 0.0,
            "Non-Smiley": 0.0,
            "Smiley Rate": np.nan,
            "Non-Smiley Rate": np.nan,
        }

    work = df.copy()
    responses = (
        pd.to_numeric(work.get("Responses", pd.Series(1.0, index=work.index)), errors="coerce")
        .fillna(0.0)
        .clip(lower=0.0)
    )

    if "Smiley Numerator" in work.columns:
        smiley = (
            pd.to_numeric(work["Smiley Numerator"], errors="coerce")
            .fillna(0.0)
            .clip(lower=0.0)
        )
    elif "Smiley Rate" in work.columns:
        smiley = normalize_rate_series(work["Smiley Rate"]).fillna(0.0).clip(lower=0.0)
    else:
        smiley = pd.Series(0.0, index=work.index)

    outcomes = _email_v565_outcome_series(work)
    neutral = responses.where(outcomes.eq("Neutral"), 0.0)
    frownie = responses.where(outcomes.eq("Frownie"), 0.0)

    non_smiley_from_outcome = neutral + frownie
    if non_smiley_from_outcome.sum() <= 0 and "Non-Smiley Survey" in work.columns:
        non_smiley_raw = pd.to_numeric(work["Non-Smiley Survey"], errors="coerce").fillna(0.0)
        non_smiley = non_smiley_raw.clip(lower=0.0)
    else:
        non_smiley = non_smiley_from_outcome

    rated_total = float(responses.sum())
    smiley_total = float(smiley.sum())
    non_smiley_total = float(non_smiley.sum())
    return {
        "Rated": rated_total,
        "Smiley": smiley_total,
        "Neutral": float(neutral.sum()),
        "Frownie": float(frownie.sum()),
        "Non-Smiley": non_smiley_total,
        "Smiley Rate": safe_rate(smiley_total, rated_total),
        "Non-Smiley Rate": safe_rate(non_smiley_total, rated_total),
    }


def _email_v565_subset_by_outcome(
    df: pd.DataFrame,
    outcomes: Sequence[str],
) -> pd.DataFrame:
    """Return rows whose canonical outcome is in the requested list."""
    if df is None or not isinstance(df, pd.DataFrame) or df.empty:
        return pd.DataFrame()
    wanted = {normalize_text(value) for value in outcomes}
    outcome_series = _email_v565_outcome_series(df)
    return df[outcome_series.isin(wanted)].copy()


def _email_v565_numeric_series(df: pd.DataFrame, column: str) -> pd.Series:
    """Return a numeric series for a column, treating null/No data as missing."""
    if df is None or not isinstance(df, pd.DataFrame) or df.empty or column not in df.columns:
        return pd.Series(dtype="float64")
    return pd.to_numeric(
        df[column].replace(
            {
                "null": np.nan,
                "No data": np.nan,
                "no data": np.nan,
                "": np.nan,
                "-": np.nan,
            }
        ),
        errors="coerce",
    )


def _email_v565_mean_numeric(df: pd.DataFrame, column: str) -> float:
    values = _email_v565_numeric_series(df, column).dropna()
    if values.empty:
        return np.nan
    return float(values.mean())


def _email_v565_sum_numeric(df: pd.DataFrame, column: str) -> float:
    values = _email_v565_numeric_series(df, column).dropna()
    if values.empty:
        return 0.0
    return float(values.sum())


def _email_v565_row_level_qa_score(
    source_df: pd.DataFrame,
    config: AppConfig = CONFIG,
) -> Dict[str, Any]:
    """Average the row-level QA score across available QA attributes."""
    if source_df is None or not isinstance(source_df, pd.DataFrame) or source_df.empty:
        return {"score": np.nan, "rows": 0, "audited_checks": 0}

    qa_columns = [column for column in QA_ATTRIBUTE_COLUMNS if column in source_df.columns]
    if not qa_columns:
        return {"score": np.nan, "rows": 0, "audited_checks": 0}

    values = source_df[qa_columns].apply(pd.to_numeric, errors="coerce")
    values = values.where(values.isin([0, 1]))
    row_scores = values.mean(axis=1, skipna=True).dropna()
    return {
        "score": float(row_scores.mean()) if not row_scores.empty else np.nan,
        "rows": int(row_scores.shape[0]),
        "audited_checks": int(values.notna().sum().sum()),
    }


def _email_v565_top_qa_attributes_for_df(
    source_df: pd.DataFrame,
    config: AppConfig = CONFIG,
    limit: int = 2,
) -> List[Dict[str, Any]]:
    """Return the highest-failure QA attributes in a DataFrame."""
    if source_df is None or not isinstance(source_df, pd.DataFrame) or source_df.empty:
        return []
    qa_columns = [column for column in QA_ATTRIBUTE_COLUMNS if column in source_df.columns]
    if not qa_columns:
        return []

    records: List[Dict[str, Any]] = []
    for attribute in qa_columns:
        values = pd.to_numeric(source_df[attribute], errors="coerce")
        values = values.where(values.isin([0, 1])).dropna()
        audited = int(values.shape[0])
        if audited <= 0:
            continue
        failed = int(values.eq(0).sum())
        passed = int(values.eq(1).sum())
        records.append(
            {
                "QA Attribute": attribute,
                "Audited": audited,
                "Passed": passed,
                "Failed": failed,
                "Fail Rate": safe_rate(failed, audited),
                "Pass Rate": safe_rate(passed, audited),
            }
        )

    if not records:
        return []
    work = pd.DataFrame(records)
    focus = work[work["Failed"].gt(0)].copy()
    if focus.empty:
        focus = work.copy()
    focus = focus.sort_values(
        ["Fail Rate", "Failed", "Audited"],
        ascending=[False, False, False],
        na_position="last",
    ).head(max(1, int(limit)))
    return focus.to_dict("records")


def _email_v565_qa_attr_names(
    qa_records: Sequence[Mapping[str, Any]],
    default: str = "the top QA attributes",
) -> str:
    names = [normalize_text(row.get("QA Attribute", "")) for row in qa_records if normalize_text(row.get("QA Attribute", ""))]
    return _human_join(names, default)


def _email_v565_path_summary(
    source_df: pd.DataFrame,
    columns: Sequence[str],
    *,
    outcomes: Optional[Sequence[str]] = None,
    label: str = "signal",
) -> Dict[str, Any]:
    """
    Return the top L1->L2->L3->Drilldown style path weighted by Responses.

    Missing labels are excluded; lower-level missing values do not block the row
    as long as at least one requested column has a usable value.
    """
    if source_df is None or not isinstance(source_df, pd.DataFrame) or source_df.empty:
        return {"path": "", "count": 0.0, "share": np.nan, "available": False}

    work = source_df.copy()
    if outcomes is not None:
        work = _email_v565_subset_by_outcome(work, outcomes)
    if work.empty:
        return {"path": "", "count": 0.0, "share": np.nan, "available": False}

    available_columns = [column for column in columns if column in work.columns]
    if not available_columns:
        return {"path": "", "count": 0.0, "share": np.nan, "available": False}

    responses = (
        pd.to_numeric(work.get("Responses", pd.Series(1.0, index=work.index)), errors="coerce")
        .fillna(0.0)
        .clip(lower=0.0)
    )
    denominator = float(responses.sum())
    if denominator <= 0:
        denominator = float(len(work))

    path_values: List[str] = []
    for _, row in work[available_columns].iterrows():
        parts = [_email_v565_clean_label(row.get(column, "")) for column in available_columns]
        parts = [part for part in parts if part]
        path_values.append(" → ".join(parts))

    work = work.assign(_Path=path_values, _Responses=responses.values)
    work = work[work["_Path"].map(normalize_text).ne("")].copy()
    if work.empty:
        return {"path": "", "count": 0.0, "share": np.nan, "available": False}

    grouped = (
        work.groupby("_Path", dropna=False)
        .agg(Count=("_Responses", "sum"))
        .reset_index()
        .sort_values(["Count", "_Path"], ascending=[False, True])
    )
    if grouped.empty:
        return {"path": "", "count": 0.0, "share": np.nan, "available": False}

    top = grouped.iloc[0]
    count = float(top.get("Count", 0.0))
    return {
        "path": normalize_text(top.get("_Path", "")),
        "count": count,
        "share": safe_rate(count, denominator),
        "available": bool(normalize_text(top.get("_Path", ""))),
        "label": label,
    }


def _email_v565_format_path_signal(path_info: Mapping[str, Any], fallback: str) -> str:
    if path_info and path_info.get("available") and normalize_text(path_info.get("path", "")):
        return normalize_text(path_info.get("path", ""))
    return fallback


def _email_v565_top_taxonomy_pair(
    source_df: pd.DataFrame,
) -> Dict[str, Any]:
    """Return top Level One -> Level Two by Non-Smiley pressure."""
    if source_df is None or not isinstance(source_df, pd.DataFrame) or source_df.empty:
        return {}
    if "Level One" not in source_df.columns and "Level Two" not in source_df.columns:
        return {}

    work = source_df.copy()
    for column in ("Level One", "Level Two"):
        if column not in work.columns:
            work[column] = ""
        try:
            work[column] = work[column].map(_taxonomy_clean_value_v557)
        except Exception:
            work[column] = work[column].map(_email_v565_clean_label)

    work = work[
        work["Level One"].map(_email_v565_clean_label).ne("")
        | work["Level Two"].map(_email_v565_clean_label).ne("")
    ].copy()
    if work.empty:
        return {}

    outcomes = _email_v565_outcome_series(work)
    responses = (
        pd.to_numeric(work.get("Responses", pd.Series(1.0, index=work.index)), errors="coerce")
        .fillna(0.0)
        .clip(lower=0.0)
    )
    smiley = (
        pd.to_numeric(work.get("Smiley Numerator", work.get("Smiley Rate", 0)), errors="coerce")
        .fillna(0.0)
        .clip(lower=0.0)
    )
    non_smiley = responses.where(outcomes.isin(["Neutral", "Frownie", "Non-Smiley"]), 0.0)
    total_non_smiley = float(non_smiley.sum())

    work["_Responses"] = responses
    work["_Smiley"] = smiley
    work["_NonSmiley"] = non_smiley

    grouped = (
        work.groupby(["Level One", "Level Two"], dropna=False)
        .agg(
            Rated=("_Responses", "sum"),
            Smiley=("_Smiley", "sum"),
            NonSmiley=("_NonSmiley", "sum"),
        )
        .reset_index()
    )
    grouped["Smiley Rate"] = np.where(grouped["Rated"].gt(0), grouped["Smiley"] / grouped["Rated"], np.nan)
    grouped["Non-Smiley Share"] = np.where(total_non_smiley > 0, grouped["NonSmiley"] / total_non_smiley, np.nan)
    grouped = grouped[grouped["NonSmiley"].gt(0)].copy()
    if grouped.empty:
        return {}

    top = grouped.sort_values(
        ["NonSmiley", "Non-Smiley Share", "Rated"],
        ascending=[False, False, False],
        na_position="last",
    ).iloc[0]
    level_one = _email_v565_clean_label(top.get("Level One", "")) or "Unspecified Level One"
    level_two = _email_v565_clean_label(top.get("Level Two", "")) or "Unspecified Level Two"
    return {
        "Level One": level_one,
        "Level Two": level_two,
        "Path": f"{level_one} → {level_two}",
        "Non-Smiley": float(top.get("NonSmiley", 0.0)),
        "Rated": float(top.get("Rated", 0.0)),
        "Smiley Rate": float(top.get("Smiley Rate", np.nan)),
        "Non-Smiley Share": float(top.get("Non-Smiley Share", np.nan)),
    }


def _email_v565_ticket_age_risk(
    source_df: pd.DataFrame,
    metric: PeriodMetric,
) -> Dict[str, Any]:
    """Return ticket-age risk ranked by non-smiley pressure and performance gap."""
    if source_df is None or not isinstance(source_df, pd.DataFrame) or source_df.empty or "Ticket Age" not in source_df.columns:
        return {}

    work = source_df.copy()
    work["Ticket Age"] = work["Ticket Age"].map(_email_v565_clean_label)
    work = work[work["Ticket Age"].ne("")].copy()
    if work.empty:
        return {}

    summary = []
    total = _email_v565_response_summary(work)
    total_ns = float(total.get("Non-Smiley", 0.0) or 0.0)
    benchmark = _email_v551_num(getattr(metric, "actual_rate", np.nan), np.nan)
    if pd.isna(benchmark):
        benchmark = _email_v551_num(total.get("Smiley Rate", np.nan), np.nan)

    for age, group in work.groupby("Ticket Age", dropna=False):
        counts = _email_v565_response_summary(group)
        rated = float(counts.get("Rated", 0.0) or 0.0)
        rate = _email_v551_num(counts.get("Smiley Rate", np.nan), np.nan)
        ns = float(counts.get("Non-Smiley", 0.0) or 0.0)
        ns_share = safe_rate(ns, total_ns)
        opportunity = max((benchmark - rate), 0.0) * rated if pd.notna(rate) and pd.notna(benchmark) else 0.0
        summary.append(
            {
                "Ticket Age": age,
                "Rated": rated,
                "Smiley Rate": rate,
                "Non-Smiley": ns,
                "Non-Smiley Share": ns_share,
                "Opportunity": opportunity,
            }
        )
    table = pd.DataFrame(summary)
    if table.empty:
        return {}
    risk = table[table["Non-Smiley"].gt(0)].copy()
    if risk.empty:
        risk = table.copy()
    risk = risk.sort_values(
        ["Opportunity", "Non-Smiley", "Non-Smiley Share", "Rated"],
        ascending=[False, False, False, False],
        na_position="last",
    )
    return risk.iloc[0].to_dict()


def _email_v565_tenure_risk(
    source_df: pd.DataFrame,
    metric: PeriodMetric,
) -> Dict[str, Any]:
    """Return the tenure group with the highest non-smiley/performance risk."""
    if source_df is None or not isinstance(source_df, pd.DataFrame) or source_df.empty:
        return {}
    tenure_col = "Tenure Group" if "Tenure Group" in source_df.columns else ("Ramp" if "Ramp" in source_df.columns else "")
    if not tenure_col:
        return {}

    work = source_df.copy()
    work[tenure_col] = work[tenure_col].map(_email_v565_clean_label)
    work = work[work[tenure_col].ne("")].copy()
    if work.empty:
        return {}

    total = _email_v565_response_summary(work)
    total_ns = float(total.get("Non-Smiley", 0.0) or 0.0)
    benchmark = _email_v551_num(getattr(metric, "actual_rate", np.nan), np.nan)
    rows: List[Dict[str, Any]] = []
    for tenure, group in work.groupby(tenure_col, dropna=False):
        counts = _email_v565_response_summary(group)
        rated = float(counts.get("Rated", 0.0) or 0.0)
        rate = _email_v551_num(counts.get("Smiley Rate", np.nan), np.nan)
        ns = float(counts.get("Non-Smiley", 0.0) or 0.0)
        gap = rate - benchmark if pd.notna(rate) and pd.notna(benchmark) else np.nan
        rows.append(
            {
                "Tenure Group": tenure,
                "Rated": rated,
                "Smiley Rate": rate,
                "Non-Smiley": ns,
                "Gap": gap,
                "Non-Smiley Share": safe_rate(ns, total_ns),
                "Opportunity": max((benchmark - rate), 0.0) * rated if pd.notna(rate) and pd.notna(benchmark) else 0.0,
            }
        )
    table = pd.DataFrame(rows)
    if table.empty:
        return {}
    table = table[table["Rated"].gt(0)].copy()
    if table.empty:
        return {}
    risk = table.sort_values(
        ["Opportunity", "Non-Smiley", "Rated", "Smiley Rate"],
        ascending=[False, False, False, True],
        na_position="last",
    )
    return risk.iloc[0].to_dict()


def _email_v565_aftr_summary(
    source_df: pd.DataFrame,
) -> Dict[str, Any]:
    """Return AFTR rate and top miss path for Weekly/Monthly only."""
    numerator_col = "advisor_first_touch_resolution_rate_numerator"
    denominator_col = "advisor_first_touch_resolution_rate_denominator"
    if (
        source_df is None
        or not isinstance(source_df, pd.DataFrame)
        or source_df.empty
        or numerator_col not in source_df.columns
        or denominator_col not in source_df.columns
    ):
        return {"available": False, "rate": np.nan, "denominator": 0.0, "miss_count": 0.0, "path": ""}

    work = source_df.copy()
    numerator = _email_v565_numeric_series(work, numerator_col)
    denominator = _email_v565_numeric_series(work, denominator_col)
    valid = numerator.notna() & denominator.notna() & denominator.gt(0)
    work = work[valid].copy()
    numerator = numerator[valid]
    denominator = denominator[valid]
    if work.empty:
        return {"available": False, "rate": np.nan, "denominator": 0.0, "miss_count": 0.0, "path": ""}

    rate = safe_rate(float(numerator.sum()), float(denominator.sum()))
    miss_mask = numerator.lt(denominator)
    miss_df = work[miss_mask].copy()
    miss_count = float(denominator[miss_mask].sum() - numerator[miss_mask].sum())
    path = _email_v565_path_summary(
        miss_df,
        ["AFTR L1", "AFTR L2", "AFTR L3"],
        label="AFTR miss",
    )

    return {
        "available": True,
        "rate": rate,
        "denominator": float(denominator.sum()),
        "miss_count": miss_count,
        "path": normalize_text(path.get("path", "")),
        "path_share": path.get("share", np.nan),
        "path_count": path.get("count", 0.0),
    }


def _email_v565_aht_signal(
    source_df: pd.DataFrame,
) -> Dict[str, Any]:
    """Return AHT average and top AHT path among non-smiley/high-AHT survey rows."""
    if source_df is None or not isinstance(source_df, pd.DataFrame) or source_df.empty:
        return {"available": False, "avg_aht": np.nan, "path": ""}

    avg_aht = _email_v565_mean_numeric(source_df, "Chat Average Handle Time")
    non_smiley_df = _email_v565_subset_by_outcome(source_df, ["Neutral", "Frownie", "Non-Smiley"])
    signal_df = non_smiley_df if not non_smiley_df.empty else source_df.copy()

    # Prefer high-AHT rows when numeric AHT exists.
    if "Chat Average Handle Time" in signal_df.columns:
        aht_values = _email_v565_numeric_series(signal_df, "Chat Average Handle Time")
        if aht_values.notna().sum() >= 3:
            threshold = float(aht_values.quantile(0.75))
            signal_df = signal_df[aht_values.ge(threshold)].copy()
            if signal_df.empty:
                signal_df = non_smiley_df if not non_smiley_df.empty else source_df.copy()

    path = _email_v565_path_summary(
        signal_df,
        ["AHT L1", "AHT L2", "AHT L3", "AHT Drilldown"],
        label="AHT",
    )
    return {
        "available": pd.notna(avg_aht) or bool(path.get("available")),
        "avg_aht": avg_aht,
        "path": normalize_text(path.get("path", "")),
        "path_share": path.get("share", np.nan),
        "path_count": path.get("count", 0.0),
    }


def _email_v565_queue_async_summary(
