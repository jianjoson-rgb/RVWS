# v5.7.72 safe override: avoid treating missing Smiley Rate values as Non-Smiley.
def _v572_outcome_masks(df: pd.DataFrame) -> Dict[str, pd.Series]:
    if df is None or not isinstance(df, pd.DataFrame) or df.empty:
        blank = pd.Series(dtype="bool")
        return {"smiley": blank, "non_smiley": blank}

    outcomes = _email_v565_outcome_series(df)
    smiley = outcomes.eq("Smiley")
    non_smiley = outcomes.isin(["Neutral", "Frownie", "Non-Smiley"])

    if "Non-Smiley Survey" in df.columns:
        non_smiley_raw = pd.to_numeric(df["Non-Smiley Survey"], errors="coerce")
        non_smiley = non_smiley | non_smiley_raw.fillna(0.0).gt(0)

    if "Smiley Rate" in df.columns:
        smiley_numeric = normalize_rate_series(df["Smiley Rate"])
        smiley = smiley | smiley_numeric.eq(1)
        non_smiley = non_smiley | smiley_numeric.eq(0)

    return {"smiley": smiley.fillna(False), "non_smiley": non_smiley.fillna(False)}


