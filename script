                _email_v551_seg(f" across {format_int(metric.actual_responses)} rated responses, "),
                _email_v551_seg(movement_phrase(metric.delta), color=_email_v551_delta_color(metric.delta), bold=True),
                _email_v551_seg(f" vs {baseline_label}."),
            ],
        },
        {
            "level": 0,
            "segments": [
                _email_v551_seg(f"Prior-period movement: performance {movement_word} by "),
                _email_v551_seg(format_pp(previous_delta), color=_email_v551_delta_color(previous_delta), bold=True),
                _email_v551_seg(f" vs {previous_label}."),
            ],
        },
        {
            "level": 0,
            "segments": [
                _email_v551_seg(f"Rated survey volume {volume_phrase} "),
