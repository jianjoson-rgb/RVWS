            for spine_name in [
                "top",
                "right",
                "left",
                "bottom",
            ]:
                ax2.spines[spine_name].set_visible(False)

            # Volume values remain inside the lower part of each bar.
            for bar, volume in zip(bars, volume_values):
                if volume <= 0:
                    continue
                ax2.text(
                    bar.get_x() + bar.get_width() / 2,
                    max(
                        volume * 0.08,
                        volume * 0.06 + volume_max * 0.01,
