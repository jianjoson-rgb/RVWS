def build_site_driver_output(
    site_reports: Mapping[str, SiteReport],
) -> pd.DataFrame:
    """Flatten per-site driver tables for Google Sheets auditability."""
    frames: List[pd.DataFrame] = []
    for report in site_reports.values():
        for grain, dimension_tables in report.driver_tables.items():
            for dimension, table in dimension_tables.items():
                if table is None or table.empty:
                    continue
                work = table.copy()
                work["Driver Dimension"] = dimension
                work["Narrative Grain"] = grain
                frames.append(work)
    return (
        pd.concat(frames, ignore_index=True, sort=False)
        if frames
        else pd.DataFrame()
    )


