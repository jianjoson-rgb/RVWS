def build_email_body_docx(
    output_path: str,
    payload: Mapping[str, Any],
    config: AppConfig = CONFIG,
) -> str:
    """
    Build a standalone, copy-ready DOCX conversion source for the native Google
    Docs email Executive Summary. The file is portrait-oriented so the formatting
    copies cleanly into Gmail. Timeframe/timing table images are not appended.
    """
    document = Document()
    _configure_docx_styles(document, config)

    # Use a readable portrait email layout independent from the full report's
    # landscape setting.
    for section in document.sections:
        section.orientation = WD_ORIENT.PORTRAIT
        section.page_width = Inches(8.5)
        section.page_height = Inches(11)
        section.top_margin = Inches(0.65)
        section.bottom_margin = Inches(0.65)
        section.left_margin = Inches(0.75)
        section.right_margin = Inches(0.75)

    normal = document.styles["Normal"]
    normal.font.size = Pt(10.5)
    normal.paragraph_format.space_after = Pt(6)
    normal.paragraph_format.line_spacing = 1.08

    for list_style_name in ("List Bullet", "List Bullet 2"):
        if list_style_name in document.styles:
            list_style = document.styles[list_style_name]
            list_style.font.name = config.docx_font_name
            list_style._element.rPr.rFonts.set(
                qn("w:eastAsia"),
                config.docx_font_name,
            )
            list_style.font.size = Pt(10.5)

    _docx_add_email_body(document, payload, config=config)
    _docx_v553_apply_global_spacing(document, email_only=True, config=config)

    output = Path(output_path)
    output.parent.mkdir(parents=True, exist_ok=True)
    document.save(output)
    if not output.exists() or output.stat().st_size == 0:
        raise RuntimeError(
            f"Email Executive Summary DOCX generation failed: {output}"
        )
    LOGGER.info("Email Executive Summary DOCX created: %s", output)
    return str(output)





