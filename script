    ).strftime("%Y-%m-%d %H:%M:%S")

    needed_ticket_ids, _, _ = prepare_needed_lookup_keys(merchant_df)

    print("======================================")
    print("INTERACTION LOOKUPS BUILD START")
    print("======================================")
    print(
        f"Needed interaction Ticket IDs: "
        f"{len(needed_ticket_ids):,}"
    )

