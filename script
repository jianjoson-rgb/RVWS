# V5.7.59 IMPACT-BASED SQUAD FOCUS FOR EMAIL READOUT
# =========================================================
# Scope:
# - Keep all v5.7.58 calculations and sections intact.
# - Update Daily / Weekly / Monthly email Squad Focus selection so it is not
#   driven by the lowest rate alone.
# - Rank bottom squads using combined Smiley impact and response volume.
# - Keep same-period QA attribute performance attached to the selected squads.
# - Do not mention methodology jargon in the client-facing readout.


def _email_v559_squad_response_col(work: pd.DataFrame) -> str:
    """Choose the most reliable response-volume column for squad selection."""
    for candidate in ("Responses", "Rated", "Current Responses", "Current_Responses"):
        if candidate in work.columns:
            return candidate
    return "Responses"


def _email_v559_squad_positive_series(work: pd.DataFrame, responses: pd.Series, rate: pd.Series) -> pd.Series:
    """Return squad positive/smiley counts when available; otherwise infer from rate x volume."""
    for candidate in (
        "Positive",
        "Smiley",
        "Smiley Count",
        "Current Positive",
        "Current_Positive",
    ):
        if candidate in work.columns:
            values = pd.to_numeric(work[candidate], errors="coerce")
            if values.notna().any():
                return values.fillna(rate.fillna(0.0) * responses.fillna(0.0))
    return rate.fillna(0.0) * responses.fillna(0.0)


def _email_v559_squad_non_smiley_series(
    work: pd.DataFrame,
    responses: pd.Series,
    positive: pd.Series,
) -> pd.Series:
    """Return squad non-smiley counts when available; otherwise infer as volume minus smileys."""
    for candidate in (
        "Non_Smiley_Count",
        "Non-Smiley Count",
        "Non Smiley Count",
        "Non-Smiley",
        "Non_Smiley",
    ):
        if candidate in work.columns:
            values = pd.to_numeric(work[candidate], errors="coerce")
            if values.notna().any():
                return values.fillna(0.0)
    return np.maximum(responses.fillna(0.0) - positive.fillna(0.0), 0.0)


def _email_v557_squad_smiley_rows(
    grain_result: GrainResult,
    config: AppConfig = CONFIG,
    limit: int = 5,
) -> pd.DataFrame:
    """
    Return bottom squad drivers for one detailed email grain.

    v5.7.59 selection is impact-based: it prioritizes squads with meaningful
    response volume and below-benchmark Smiley performance, rather than ranking
    by lowest Smiley Rate alone.
    """
    table = getattr(grain_result, "squad_summary", pd.DataFrame())
    if table is None or not isinstance(table, pd.DataFrame) or table.empty:
        return pd.DataFrame()

    work = table.copy()
    try:
        work = filter_rows_to_approved_sites(work, config)
    except Exception:
        pass

    if work.empty or not {"Site", "Squad Code", "Smiley Rate"}.issubset(work.columns):
        return pd.DataFrame()

    response_col = _email_v559_squad_response_col(work)
    if response_col not in work.columns:
        work[response_col] = 0

    work["_Rate"] = pd.to_numeric(work["Smiley Rate"], errors="coerce")
    work["_Responses"] = pd.to_numeric(work[response_col], errors="coerce").fillna(0.0)
    work["_Positive"] = _email_v559_squad_positive_series(
        work=work,
        responses=work["_Responses"],
        rate=work["_Rate"],
    )
    work["_NonSmiley"] = _email_v559_squad_non_smiley_series(
        work=work,
        responses=work["_Responses"],
        positive=work["_Positive"],
    )
    work["_Impact"] = pd.to_numeric(
        work.get("Official Impact", pd.Series(np.nan, index=work.index)),
        errors="coerce",
    )

    overall_metric = getattr(grain_result, "overall", None)
    benchmark = _email_v551_num(getattr(overall_metric, "actual_rate", np.nan))
    if pd.isna(benchmark):
        total_positive = float(work["_Positive"].sum())
        total_responses = float(work["_Responses"].sum())
        benchmark = safe_rate(total_positive, total_responses)
    if pd.isna(benchmark):
        benchmark = float(getattr(config, "target_rate", 0.80))

    total_responses = float(work["_Responses"].sum())
    work["_ResponseShare"] = np.where(
        total_responses > 0,
        work["_Responses"] / total_responses,
        np.nan,
    )
    work["_GapVsBenchmark"] = work["_Rate"] - benchmark
    work["_CalculatedImpactVsBenchmark"] = (
        work["_ResponseShare"] * work["_GapVsBenchmark"]
    )
    work["_ImpactForRanking"] = work["_Impact"].where(
        work["_Impact"].notna(),
        work["_CalculatedImpactVsBenchmark"],
    )
    work["_OpportunityCount"] = np.maximum(
        (benchmark - work["_Rate"]) * work["_Responses"],
        0.0,
    )

    work["Site"] = work["Site"].map(normalize_text)
    work["Squad Code"] = work["Squad Code"].map(normalize_text)

    work = work[
        work["Site"].ne("")
        & work["Squad Code"].ne("")
        & work["_Responses"].gt(0)
        & work["_Rate"].notna()
    ].copy()
    if work.empty:
        return pd.DataFrame()

    eligible = work[
        work["_ImpactForRanking"].lt(0)
        | work["_GapVsBenchmark"].lt(0)
        | work["_OpportunityCount"].gt(0)
    ].copy()
    if eligible.empty:
        return pd.DataFrame()

    return (
        eligible.sort_values(
            [
                "_ImpactForRanking",
                "_OpportunityCount",
                "_NonSmiley",
                "_Responses",
                "_Rate",
            ],
            ascending=[True, False, False, False, True],
            na_position="last",
        )
        .head(max(1, int(limit)))
        .reset_index(drop=True)
    )


