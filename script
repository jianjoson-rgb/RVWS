def _email_v569_top_taxonomy_by_level(
    source_df: pd.DataFrame,
    column: str,
) -> Dict[str, Any]:
    """Return the top taxonomy value for a level by Non-Smiley contribution."""
    if (
        source_df is None
        or not isinstance(source_df, pd.DataFrame)
        or source_df.empty
        or column not in source_df.columns
    ):
        return {}

    work = source_df.copy()
    work["_EmailTaxonomyValue"] = work[column].map(_email_v565_clean_label)
    work = work[work["_EmailTaxonomyValue"].map(normalize_text).ne("")].copy()
    if work.empty:
        return {}

    total_counts = _email_v565_response_summary(work)
    total_non_smiley = float(total_counts.get("Non-Smiley", 0.0) or 0.0)

    rows: List[Dict[str, Any]] = []
    for value, group in work.groupby("_EmailTaxonomyValue", dropna=False):
        label = normalize_text(value)
        if not label:
            continue
        counts = _email_v565_response_summary(group)
        rated = float(counts.get("Rated", 0.0) or 0.0)
        non_smiley = float(counts.get("Non-Smiley", 0.0) or 0.0)
        if rated <= 0:
            continue
        rows.append(
            {
                "Value": label,
                "Rated": rated,
                "Smiley Rate": counts.get("Smiley Rate", np.nan),
                "Non-Smiley": non_smiley,
                "Non-Smiley Share": safe_rate(non_smiley, total_non_smiley),
            }
        )

    if not rows:
        return {}

    table = pd.DataFrame(rows)
    risk = table[table["Non-Smiley"].gt(0)].copy()
    if risk.empty:
        risk = table.copy()

    ranked = risk.sort_values(
        ["Non-Smiley", "Non-Smiley Share", "Rated", "Smiley Rate"],
        ascending=[False, False, False, True],
        na_position="last",
    )
    return ranked.iloc[0].to_dict()


