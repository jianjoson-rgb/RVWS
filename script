        else:
            paragraphs.append(
                {
                    "level": 0,
                    "segments": [
                        _email_v551_seg("AFTR signal: No usable AFTR numerator/denominator data was available for this period.")
                    ],
                }
            )

    aht = _email_v565_aht_signal(source_df)
    if aht.get("split_available"):
        aht_gap = aht.get("split_gap", np.nan)
        aht_segments: List[Dict[str, Any]] = [
            _email_v551_seg("AHT signal: Smiley surveys averaged "),
            _email_v551_seg(_email_v567_minutes_text(aht.get("smiley_avg", np.nan)), color=EMAIL_V551_GREEN, bold=True),
            _email_v551_seg(" vs Non-Smiley surveys at "),
            _email_v551_seg(_email_v567_minutes_text(aht.get("non_smiley_avg", np.nan)), color=EMAIL_V551_RED if pd.notna(aht_gap) and aht_gap > 0 else EMAIL_V551_GREEN, bold=True),
            _email_v551_seg(", a "),
            _email_v551_seg(_email_v567_minutes_gap_text(aht_gap), color=_email_v567_gap_color(aht_gap, lower_is_better=True), bold=True),
            _email_v551_seg(" gap"),
        ]
        aht_path = normalize_text(aht.get("path", ""))
        if aht_path:
            aht_segments.extend(
                [
                    _email_v551_seg(". AHT pressure was concentrated in "),
                    _email_v551_seg(aht_path, color=EMAIL_V551_RED, bold=True),
                ]
            )
        aht_segments.append(_email_v551_seg("."))
        paragraphs.append({"level": 0, "segments": aht_segments})
    elif aht.get("available"):
        paragraphs.append(
            {
                "level": 0,
                "segments": [
                    _email_v551_seg("AHT signal: Survey-linked AHT pressure was concentrated in "),
                    _email_v551_seg(
                        normalize_text(aht.get("path", "")) or "no available AHT L1/L2/L3 signal",
                        color=EMAIL_V551_RED if normalize_text(aht.get("path", "")) else EMAIL_V551_GRAY,
                        bold=True,
                    ),
                    _email_v551_seg(
                        f", with average AHT at {float(aht.get('avg_aht')):.1f} minutes."
                        if pd.notna(aht.get("avg_aht", np.nan))
                        else "."
                    ),
                ],
            }
        )
    else:
        paragraphs.append(
            {
                "level": 0,
                "segments": [_email_v551_seg("AHT signal: No usable survey-linked AHT driver data was available for this period.")],
            }
        )

    return paragraphs


