def run_all_lobs_one_each_v536(
    selection: ReportSelection,
    clients: Optional[GoogleClients] = None,
    spreadsheet=None,
    normalized_source_df: Optional[pd.DataFrame] = None,
    source_validation: Optional[Dict[str, Any]] = None,
    config: AppConfig = CONFIG,
) -> Dict[str, Any]:
    """
    Generate one independent Whitepaper Report per supported LOB.

    This is used by the Colab dropdown option ALL - ONE EACH. It reuses the
    already-loaded source data and Google clients so Tin can run once and publish
    separate Google Docs for CORE, PREMIUM, PLUS, and RETAIL without producing
    a combined ALL LOB report.
    """
    started_at = time.time()
    lob_order = _batch_lob_order_v536(selection.lob)
    results_by_lob: Dict[str, Dict[str, Any]] = {}
    errors_by_lob: Dict[str, str] = {}
    warnings_list: List[str] = []

    print("\nALL - ONE EACH batch selected.")
    print("Generating separate Whitepaper Reports for: " + ", ".join(lob_order))
    if is_docs_only_staging_mode_v563(config):
        print("Docs-only mode: Google Sheets output/audit tabs will not be generated.")
    if config.write_google_sheets_outputs:
        warnings_list.append(
            "ALL - ONE EACH writes Google Sheets audit tabs once per LOB; "
            "shared tab names may reflect the last completed LOB. Google Docs "
            "and Drive folders are still generated separately for each LOB."
        )

    for lob in lob_order:
        child_selection = replace(selection, lob=lob)
        print("\n" + "=" * 72)
        print(f"STARTING {lob} WHITEPAPER REPORT")
        print("=" * 72)
        try:
            child_result = run_executive_report(
                selection=child_selection,
                clients=clients,
                spreadsheet=spreadsheet,
                normalized_source_df=normalized_source_df,
                source_validation=source_validation,
                config=config,
            )
            results_by_lob[lob] = child_result
            print(f"COMPLETED {lob} WHITEPAPER REPORT")
        except Exception as exc:
            error = f"{type(exc).__name__}: {exc}"
            LOGGER.exception("ALL - ONE EACH failed for %s", lob)
            errors_by_lob[lob] = error
            warnings_list.append(f"{lob} report failed: {error}")
            print(f"FAILED {lob} WHITEPAPER REPORT: {error}")

    elapsed = time.time() - started_at
    successful_lobs = list(results_by_lob)
    failed_lobs = list(errors_by_lob)

    print("\n" + "=" * 72)
    print("ALL - ONE EACH BATCH SUMMARY")
    print("=" * 72)
    print("Successful LOBs: " + (", ".join(successful_lobs) if successful_lobs else "None"))
    print("Failed LOBs: " + (", ".join(failed_lobs) if failed_lobs else "None"))
    print(f"Elapsed: {elapsed:.1f} seconds")
    for lob in lob_order:
        child = results_by_lob.get(lob)
        if not child:
            continue
        artifacts = child.get("artifacts", {})
        print(f"\n{lob}")
        print(f"  Main Google Doc: {artifacts.get('google_doc_url', '') or artifacts.get('docx_path', '')}")
        print(f"  Email Google Doc: {artifacts.get('email_body_google_doc_url', '') or artifacts.get('email_body_docx_path', '')}")
        print(f"  Drive Folder: {artifacts.get('drive_folder_url', '') or artifacts.get('output_dir', '')}")

    if not results_by_lob:
        raise RuntimeError(
            "ALL - ONE EACH failed for every LOB. "
            + "; ".join(f"{lob}: {msg}" for lob, msg in errors_by_lob.items())
        )

    return {
        "batch_mode": True,
        "selection": asdict(selection),
        "lob_order": list(lob_order),
        "results_by_lob": results_by_lob,
        "errors_by_lob": errors_by_lob,
        "warnings": warnings_list,
        "elapsed_seconds": elapsed,
    }


