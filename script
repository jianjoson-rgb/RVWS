def apply_business_filter(
    df: pd.DataFrame,
    lob_mode: str,
    config: AppConfig = CONFIG,
) -> Tuple[pd.DataFrame, Dict[str, Any]]:
    """
    Apply Company, channel, LOB, and Team Code rules.

    Important population rule:
    - Executive calculations retain ALL sites that pass the business rules.
    - Detailed site reporting uses the approved LOB-specific site list.
    """
    mode = normalize_text(lob_mode).upper()
    if mode not in BUSINESS_MODE_FILTER_CONFIG:
        raise ValueError(
            f"LOB must be one of {tuple(BUSINESS_MODE_FILTER_CONFIG)}. "
            f"Received: {lob_mode}"
        )

    business_config = BUSINESS_MODE_FILTER_CONFIG[mode]
    business_mask = df["Company"].eq(config.required_company)

    support_channels = business_config["support_channels"]
    if support_channels is not None:
        business_mask &= df["Ticket Channel"].isin(set(support_channels))

    allowed_lobs = business_config["lobs"]
    if allowed_lobs is not None:
        business_mask &= df["Level Of Detail Value"].isin(set(allowed_lobs))

    excluded_lobs = set(business_config.get("excluded_lobs", set()))
    if excluded_lobs:
        business_mask &= ~df["Level Of Detail Value"].isin(excluded_lobs)

    team_mode = business_config["team_code_filter_mode"]
    team_codes = set(business_config.get("team_codes", set()))
    if team_mode == "include" and team_codes:
        business_mask &= df["Team Code"].isin(team_codes)
    elif team_mode == "exclude" and team_codes:
        business_mask &= ~df["Team Code"].isin(team_codes)

    filtered = df.loc[business_mask].copy()
    if filtered.empty:
        raise ValueError(
            f"The selected LOB mode '{mode}' returned zero valid rows. "
            "Check Company, Ticket Channel, Level Of Detail Value, and Team Code values."
        )

    resolved_detail_sites = resolve_site_detail_sites(mode, config)
    detail_sites = set(resolved_detail_sites)
    detail_population = filtered[filtered["Site"].isin(detail_sites)].copy()
    other_population = filtered[~filtered["Site"].isin(detail_sites)].copy()

    all_site_counts = (
        filtered.groupby("Site", dropna=False)
        .size()
        .sort_values(ascending=False)
        .to_dict()
    )
    detail_site_counts = (
        detail_population.groupby("Site", dropna=False)
        .size()
        .sort_values(ascending=False)
        .to_dict()
    )
    other_site_counts = (
        other_population.groupby("Site", dropna=False)
        .size()
        .sort_values(ascending=False)
        .to_dict()
    )

    filter_summary = {
        "lob_mode": mode,
        "input_rows": int(len(df)),
        "output_rows": int(len(filtered)),
        "rows_removed": int(len(df) - len(filtered)),
        "executive_population_scope": "ALL SITES MATCHING BUSINESS FILTERS",
        "site_detail_scope": list(resolved_detail_sites),
        "executive_site_count": int(filtered["Site"].nunique(dropna=False)),
        "detail_population_rows": int(len(detail_population)),
        "other_site_population_rows": int(len(other_population)),
        "sites": sorted(filtered["Site"].fillna("").astype(str).unique().tolist()),
        "all_site_counts": all_site_counts,
        "detail_site_counts": detail_site_counts,
        "other_site_counts": other_site_counts,
        "lobs": sorted(
            filtered["Level Of Detail Value"].dropna().unique().tolist()
        ),
        "channels": sorted(
            filtered["Ticket Channel"].dropna().unique().tolist()
        ),
        "team_codes": sorted(filtered["Team Code"].dropna().unique().tolist()),
    }

    LOGGER.info(
        "Business filter %s retained %d of %d rows across %d sites. "
        "Detailed site sections remain limited to: %s.",
        mode,
        len(filtered),
        len(df),
        filtered["Site"].nunique(dropna=False),
        ", ".join(resolved_detail_sites),
    )
    return filtered, filter_summary

def available_report_period_options(
    df: pd.DataFrame,
) -> List[Tuple[str, str]]:
    """
    Return the approved report-period choices used by the Colab controls.

    The first six are relative periods. Specific Month, Week, and Day use
    Anchor Date. Every Weekly option uses Sunday through Saturday.
    """
    del df
    return [
        ("Current Month", "CURRENT MONTH"),
        ("Previous Month", "PREVIOUS MONTH"),
        (
            "Month Before Previous Month",
            "MONTH BEFORE PREVIOUS MONTH",
        ),
        ("Current Week", "CURRENT WEEK"),
        ("Previous Week", "PREVIOUS WEEK"),
        (
            "Week Before Previous Week",
            "WEEK BEFORE PREVIOUS WEEK",
        ),
        ("Specific Month", "SPECIFIC MONTH"),
        ("Specific Week", "SPECIFIC WEEK"),
        ("Specific Day", "SPECIFIC DAY"),
    ]

def _parse_report_anchor_date(
    anchor_date: Any,
    fallback_date: pd.Timestamp,
) -> pd.Timestamp:
    """
    Parse Anchor Date and return a normalized calendar date.

    The fallback is used only for non-specific period modes. Specific modes
    require a visible Anchor Date value.
    """
    if anchor_date in (None, ""):
        return pd.Timestamp(fallback_date).normalize()

    parsed = pd.to_datetime(anchor_date, errors="coerce")
    if pd.isna(parsed):
        raise ValueError(
            "Anchor Date must be a valid calendar date. "
            f"Received: {anchor_date!r}"
        )
    return pd.Timestamp(parsed).normalize()


def _period_rows_or_error(
    df: pd.DataFrame,
    start: pd.Timestamp,
    end: pd.Timestamp,
    selection_label: str,
) -> pd.DataFrame:
    """Return rows for a period or raise a business-readable validation error."""
    rows = df[
        df["Date"].between(start, end, inclusive="both")
    ].copy()
    if rows.empty:
        min_date = pd.Timestamp(df["Date"].min()).strftime("%Y-%m-%d")
        max_date = pd.Timestamp(df["Date"].max()).strftime("%Y-%m-%d")
        raise ValueError(
            f"No rows exist for {selection_label} "
            f"({start.strftime('%Y-%m-%d')} to {end.strftime('%Y-%m-%d')}). "
            f"Available source dates run from {min_date} to {max_date}."
        )
    return rows


def build_report_scope(
    df: pd.DataFrame,
    report_month_selection: str,
    anchor_date: Any = "",
    config: AppConfig = CONFIG,
) -> Dict[str, Any]:
    """
    Build a relative or Anchor Date report scope.

    Relative selections:
      - Current Month
      - Previous Month
      - Month Before Previous Month
      - Current Week
      - Previous Week
      - Week Before Previous Week

    Anchor Date selections:
      - Specific Month
      - Specific Week
      - Specific Day

    Every Weekly view starts on Sunday and ends on Saturday. Weekly periods
    are never clipped at a month boundary.
    """
    if df is None or df.empty:
        raise ValueError("The business-filtered dataset is empty.")
    if "Date" not in df.columns:
        raise ValueError("The normalized source is missing the Date column.")

    valid_dates = pd.to_datetime(df["Date"], errors="coerce").dropna()
    if valid_dates.empty:
        raise ValueError("Date has no valid values after business filtering.")

    latest_source_date = pd.Timestamp(valid_dates.max()).normalize()
    current = now_manila().tz_localize(None).normalize()
    selection_value = normalize_text(report_month_selection).upper()

    month_offsets = {
        "CURRENT MONTH": 0,
        "PREVIOUS MONTH": 1,
        "MONTH BEFORE PREVIOUS MONTH": 2,
    }
    week_offsets = {
        "CURRENT WEEK": 0,
        "PREVIOUS WEEK": 1,
        "WEEK BEFORE PREVIOUS WEEK": 2,
    }
    specific_modes = {
        "SPECIFIC MONTH",
        "SPECIFIC WEEK",
        "SPECIFIC DAY",
    }
    allowed_modes = set(month_offsets) | set(week_offsets) | specific_modes

    if selection_value not in allowed_modes:
        raise ValueError(
            "Unsupported report-period selection. Choose Current Month, "
            "Previous Month, Month Before Previous Month, Current Week, "
            "Previous Week, Week Before Previous Week, Specific Month, "
            "Specific Week, or Specific Day. "
            f"Received: {report_month_selection!r}"
        )

    if selection_value in specific_modes and anchor_date in (None, ""):
        raise ValueError(
            f"{report_month_selection} requires an Anchor Date."
        )

    parsed_anchor = _parse_report_anchor_date(
        anchor_date,
        fallback_date=latest_source_date,
    )

    all_months = False
    grace_period_applied = False

    if selection_value in month_offsets or selection_value == "SPECIFIC MONTH":
        period_type = "MONTH"
        if selection_value == "SPECIFIC MONTH":
            anchor_resolved = parsed_anchor
            report_start = month_start(anchor_resolved)
        else:
            months_back = month_offsets[selection_value]
            anchor_resolved = current - pd.DateOffset(months=months_back)
            report_start = month_start(anchor_resolved)

        report_end = month_end(report_start)
        report_label = month_label(report_start)

        display_df = _period_rows_or_error(
            df,
            report_start,
            report_end,
            report_label,
        )
        operational_data_through = min(
            pd.Timestamp(display_df["Date"].max()).normalize(),
            report_end,
        )

        reference_month_start = report_start
        reference_month_end = report_end
        monthly_scope_df = display_df.copy()
        monthly_data_through = operational_data_through

        weekly_report_start = sunday_week_start(
            operational_data_through
        )
        weekly_report_end = (
            weekly_report_start + pd.Timedelta(days=6)
        )
        weekly_rows = df[
            df["Date"].between(
                weekly_report_start,
                weekly_report_end,
                inclusive="both",
            )
        ].copy()
        weekly_source_data_through = (
            min(
                pd.Timestamp(weekly_rows["Date"].max()).normalize(),
                weekly_report_end,
            )
            if not weekly_rows.empty
            else operational_data_through
        )

        is_current_month_mode = (
            selection_value == "CURRENT MONTH"
            or (
                selection_value == "SPECIFIC MONTH"
                and report_start == month_start(current)
            )
        )
        weekly_allow_projection = bool(
            is_current_month_mode
            and weekly_report_start <= current <= weekly_report_end
            and weekly_source_data_through < weekly_report_end
        )
        pattern_start = report_start
        pattern_end = operational_data_through
        resolution_reason = (
            f"{report_month_selection} resolved to {report_label}. "
            "The Weekly view uses the complete Sunday-Saturday week "
            f"{week_beginning_chart_label(weekly_report_start)} "
            f"({weekly_report_start.strftime('%m/%d/%Y')}–"
            f"{weekly_report_end.strftime('%m/%d/%Y')})."
        )

    elif selection_value in week_offsets or selection_value == "SPECIFIC WEEK":
        period_type = "WEEK"
        if selection_value == "SPECIFIC WEEK":
            anchor_resolved = parsed_anchor
            weekly_report_start = sunday_week_start(anchor_resolved)
        else:
            weeks_back = week_offsets[selection_value]
            anchor_resolved = current - pd.Timedelta(days=7 * weeks_back)
            weekly_report_start = (
                sunday_week_start(current)
                - pd.Timedelta(days=7 * weeks_back)
            )

        weekly_report_end = (
            weekly_report_start + pd.Timedelta(days=6)
        )
        report_start = weekly_report_start
        report_end = weekly_report_end
        report_label = (
            f"{week_beginning_chart_label(weekly_report_start)} "
            f"({weekly_report_start.strftime('%m/%d/%Y')}–"
            f"{weekly_report_end.strftime('%m/%d/%Y')})"
        )

        display_df = _period_rows_or_error(
            df,
            weekly_report_start,
            weekly_report_end,
            report_label,
        )
        weekly_source_data_through = min(
            pd.Timestamp(display_df["Date"].max()).normalize(),
            weekly_report_end,
        )
        operational_data_through = weekly_source_data_through

        is_current_week_mode = (
            selection_value == "CURRENT WEEK"
            or (
                selection_value == "SPECIFIC WEEK"
                and weekly_report_start == sunday_week_start(current)
            )
        )
        weekly_allow_projection = bool(
            is_current_week_mode
            and weekly_report_start <= current <= weekly_report_end
            and weekly_source_data_through < weekly_report_end
        )

        month_anchor = operational_data_through
        reference_month_start = month_start(month_anchor)
        reference_month_end = month_end(reference_month_start)
        monthly_scope_df = df[
            df["Date"].between(
                reference_month_start,
                reference_month_end,
                inclusive="both",
            )
        ].copy()
        if monthly_scope_df.empty:
            monthly_scope_df = display_df.copy()

        monthly_rows_to_cutoff = monthly_scope_df[
            monthly_scope_df["Date"].le(month_anchor)
        ]
        monthly_data_through = (
            pd.Timestamp(
                monthly_rows_to_cutoff["Date"].max()
            ).normalize()
            if not monthly_rows_to_cutoff.empty
            else month_anchor
        )
        pattern_start = weekly_report_start
        pattern_end = operational_data_through
        resolution_reason = (
            f"{report_month_selection} resolved to {report_label}. "
            "All Weekly calculations use the complete Sunday-Saturday "
            "calendar boundary."
        )

    else:
        period_type = "DAY"
        anchor_resolved = parsed_anchor
        report_start = anchor_resolved
        report_end = anchor_resolved
        report_label = anchor_resolved.strftime("%m/%d/%Y")

        display_df = _period_rows_or_error(
            df,
            report_start,
            report_end,
            report_label,
        )
        operational_data_through = anchor_resolved

        weekly_report_start = sunday_week_start(anchor_resolved)
        weekly_report_end = (
            weekly_report_start + pd.Timedelta(days=6)
        )
        weekly_rows = df[
            df["Date"].between(
                weekly_report_start,
                weekly_report_end,
                inclusive="both",
            )
        ].copy()
        weekly_source_data_through = (
            min(
                pd.Timestamp(weekly_rows["Date"].max()).normalize(),
                weekly_report_end,
            )
            if not weekly_rows.empty
            else anchor_resolved
        )

        reference_month_start = month_start(anchor_resolved)
        reference_month_end = month_end(reference_month_start)
        monthly_scope_df = df[
            df["Date"].between(
                reference_month_start,
                reference_month_end,
                inclusive="both",
            )
        ].copy()
        if monthly_scope_df.empty:
            monthly_scope_df = display_df.copy()

        monthly_rows_to_cutoff = monthly_scope_df[
            monthly_scope_df["Date"].le(anchor_resolved)
        ]
        monthly_data_through = (
            pd.Timestamp(
                monthly_rows_to_cutoff["Date"].max()
            ).normalize()
            if not monthly_rows_to_cutoff.empty
            else anchor_resolved
        )
        weekly_allow_projection = bool(
            weekly_report_start <= current <= weekly_report_end
            and weekly_source_data_through < weekly_report_end
        )
        pattern_start = anchor_resolved
        pattern_end = anchor_resolved
        resolution_reason = (
            f"Specific Day resolved to {report_label}. "
            "The Weekly panel uses the complete Sunday-Saturday week "
            f"{week_beginning_chart_label(weekly_report_start)} "
            f"({weekly_report_start.strftime('%m/%d/%Y')}–"
            f"{weekly_report_end.strftime('%m/%d/%Y')})."
        )

    current_month_start = month_start(current)
    is_live_reporting_month = (
        reference_month_start == current_month_start
    )
    current_month_incomplete = bool(
        is_live_reporting_month
        and monthly_data_through < reference_month_end
    )

    return {
        "month_selection": report_month_selection,
        "period_selection": report_month_selection,
        "period_type": period_type,
        "anchor_date": anchor_resolved,
        "report_start": report_start,
        "report_end": report_end,
        "report_label": report_label,
        "all_months": all_months,
        "display_df": display_df,
        "monthly_scope_df": monthly_scope_df,
        "data_through": operational_data_through,
        "operational_data_through": operational_data_through,
        "daily_data_through": operational_data_through,
        "weekly_source_data_through": weekly_source_data_through,
        "weekly_report_start": weekly_report_start,
        "weekly_report_end": weekly_report_end,
        "weekly_allow_projection": weekly_allow_projection,
        "monthly_data_through": monthly_data_through,
        "latest_source_date": latest_source_date,
        "reference_month_start": reference_month_start,
        "reference_month_end": reference_month_end,
        "pattern_start": pattern_start,
        "pattern_end": pattern_end,
        "pattern_label": (
            f"{pattern_start.strftime('%m/%d/%Y')}–"
            f"{pattern_end.strftime('%m/%d/%Y')}"
            if pattern_start != pattern_end
            else pattern_start.strftime("%m/%d/%Y")
        ),
        "current_month_incomplete": current_month_incomplete,
        "is_live_reporting_month": is_live_reporting_month,
        "latest_available_month_grace_days": int(
            config.latest_available_month_grace_days
        ),
        "grace_period_applied": grace_period_applied,
        "month_resolution_reason": resolution_reason,
        "period_resolution_reason": resolution_reason,
    }

def aggregate_by_date(df: pd.DataFrame) -> pd.DataFrame:
    if df.empty:
        return pd.DataFrame(
            columns=["Date", "Positive", "Responses", "Actual Rate"]
        )
    out = (
        df.groupby("Date", dropna=False)
        .agg(
            Positive=("Smiley Numerator", "sum"),
            Responses=("Responses", "sum"),
        )
        .reset_index()
        .sort_values("Date")
    )
    out["Actual Rate"] = np.where(
        out["Responses"].gt(0),
        out["Positive"] / out["Responses"],
        np.nan,
    )
    return out


def aggregate_by_week(df: pd.DataFrame) -> pd.DataFrame:
    if df.empty:
        return pd.DataFrame(
            columns=["Week Start", "Week End", "Positive", "Responses", "Actual Rate"]
        )
    work = df.copy()
    if "Week Start" not in work.columns:
        work["Week Start"] = work["Date"].apply(sunday_week_start)
    out = (
        work.groupby("Week Start", dropna=False)
        .agg(
            Positive=("Smiley Numerator", "sum"),
            Responses=("Responses", "sum"),
        )
        .reset_index()
        .sort_values("Week Start")
    )
    out["Week End"] = out["Week Start"] + pd.Timedelta(days=6)
    out["Actual Rate"] = np.where(
        out["Responses"].gt(0),
        out["Positive"] / out["Responses"],
        np.nan,
    )
    return out



def build_week_period_labels(weekly_df: pd.DataFrame) -> pd.Series:
    """
    Build WBMMDD labels safely for weekly chart rows.

    The MMDD portion uses the Sunday week-beginning date.

    Pandas 2.x/3.x can return an empty DataFrame from DataFrame.apply(axis=1)
    when the input has zero rows. Assigning that result to one column raises:
        ValueError: Cannot set a DataFrame with multiple columns to the single
        column Period Label

    This vectorized helper always returns exactly one Series, including for:
    - empty weekly histories,
    - sites with only the current week,
    - duplicate source column labels,
    - invalid or missing week dates.
    """
    if weekly_df is None or not isinstance(weekly_df, pd.DataFrame):
        return pd.Series(dtype="object")

    if weekly_df.empty:
        return pd.Series(index=weekly_df.index, dtype="object")

    def _first_series(column_name: str) -> pd.Series:
        if column_name not in weekly_df.columns:
            return pd.Series(pd.NaT, index=weekly_df.index, dtype="datetime64[ns]")
        selected = weekly_df.loc[:, column_name]
        if isinstance(selected, pd.DataFrame):
            # Defensive handling for accidental duplicate column names.
            selected = selected.iloc[:, 0]
        return pd.to_datetime(selected, errors="coerce")

    week_start_series = _first_series("Week Start")

    # Week Start is already normalized to the Sunday reporting boundary.
    # WBMMDD is intentionally compact for executive chart timelines.
    labels = "WB" + week_start_series.dt.strftime("%m%d").fillna("")
    labels = labels.mask(week_start_series.isna(), "")
    return labels.astype("object")


def aggregate_by_month(df: pd.DataFrame) -> pd.DataFrame:
    if df.empty:
        return pd.DataFrame(
            columns=["Month Start", "Month End", "Positive", "Responses", "Actual Rate"]
        )
    work = df.copy()
    if "Month Start" not in work.columns:
        work["Month Start"] = work["Date"].dt.to_period("M").dt.to_timestamp()
    out = (
        work.groupby("Month Start", dropna=False)
        .agg(
            Positive=("Smiley Numerator", "sum"),
            Responses=("Responses", "sum"),
        )
        .reset_index()
        .sort_values("Month Start")
    )
    out["Month End"] = out["Month Start"] + pd.offsets.MonthEnd(1)
    out["Actual Rate"] = np.where(
        out["Responses"].gt(0),
        out["Positive"] / out["Responses"],
        np.nan,
    )
    return out


def _weekday_projection_reference(
    scope_df: pd.DataFrame,
    future_date: pd.Timestamp,
    data_through: pd.Timestamp,
    config: AppConfig = CONFIG,
) -> Tuple[float, float, str]:
    """
    Estimate volume and rate for a future date using the recent same-weekday
    pattern. Falls back to the recent seven available days.
    """
    history_start = data_through - pd.Timedelta(
        days=config.projection_history_days
    )
    recent = scope_df[
        scope_df["Date"].between(history_start, data_through, inclusive="both")
    ].copy()

    daily = aggregate_by_date(recent)
    if daily.empty:
        return 0.0, np.nan, "No projection history"

    same_weekday = daily[daily["Date"].dt.weekday.eq(future_date.weekday())]
    if len(same_weekday) >= 2:
        expected_responses = float(same_weekday["Responses"].median())
        positive = float(same_weekday["Positive"].sum())
        responses = float(same_weekday["Responses"].sum())
        expected_rate = safe_rate(positive, responses)
        return (
            max(0.0, expected_responses),
            expected_rate,
            "Recent same-weekday volume and weighted rate",
        )

    fallback = daily.tail(7)
    expected_responses = float(fallback["Responses"].median())
    expected_rate = safe_rate(
        float(fallback["Positive"].sum()),
        float(fallback["Responses"].sum()),
    )
    return (
        max(0.0, expected_responses),
        expected_rate,
        "Recent seven-day median volume and weighted rate",
    )


def project_remaining_dates(
    scope_df: pd.DataFrame,
    actual_positive: float,
    actual_responses: float,
    data_through: pd.Timestamp,
    projection_end: pd.Timestamp,
    config: AppConfig = CONFIG,
) -> Dict[str, Any]:
    future_dates = pd.date_range(
        data_through + pd.Timedelta(days=1),
        projection_end,
        freq="D",
    )
    if len(future_dates) == 0:
        actual_rate = safe_rate(actual_positive, actual_responses)
        return {
            "projected_positive": actual_positive,
            "projected_responses": actual_responses,
            "projected_rate": actual_rate,
            "remaining_days": 0,
            "projection_basis": "Period complete",
            "daily_projection": pd.DataFrame(),
        }

    rows: List[Dict[str, Any]] = []
    projected_positive = float(actual_positive)
    projected_responses = float(actual_responses)
    basis_values: List[str] = []

    for future_date in future_dates:
        expected_responses, expected_rate, basis = _weekday_projection_reference(
            scope_df=scope_df,
            future_date=pd.Timestamp(future_date),
            data_through=data_through,
            config=config,
        )
        if pd.isna(expected_rate):
            expected_rate = safe_rate(actual_positive, actual_responses)
        if pd.isna(expected_rate):
            expected_rate = config.target_rate

        expected_positive = expected_responses * expected_rate
        projected_positive += expected_positive
        projected_responses += expected_responses
        basis_values.append(basis)
        rows.append(
            {
                "Date": pd.Timestamp(future_date),
                "Expected Responses": expected_responses,
                "Expected Rate": expected_rate,
                "Expected Positive": expected_positive,
                "Projection Basis": basis,
            }
        )

    basis_text = (
        "Recent same-weekday patterns"
        if any("same-weekday" in value for value in basis_values)
        else "Recent seven-day pattern"
    )
    return {
        "projected_positive": projected_positive,
        "projected_responses": projected_responses,
        "projected_rate": safe_rate(projected_positive, projected_responses),
        "remaining_days": len(future_dates),
        "projection_basis": basis_text,
        "daily_projection": pd.DataFrame(rows),
    }



def calculate_daily_metric(
    scope_df: pd.DataFrame,
    data_through: pd.Timestamp,
    scope_name: str,
    config: AppConfig = CONFIG,
    baseline_period_keys: Optional[Sequence[pd.Timestamp]] = None,
) -> PeriodMetric:
    daily = aggregate_by_date(scope_df)
    current_df = scope_df[scope_df["Date"].eq(data_through)].copy()
    actual_positive, actual_responses, actual_rate = weighted_totals(current_df)

    if baseline_period_keys is None:
        prior_dates = (
            daily.loc[daily["Date"].lt(data_through), "Date"]
            .drop_duplicates()
            .sort_values()
            .tail(config.daily_baseline_periods)
            .tolist()
        )
    else:
        prior_dates = sorted(
            {
                pd.Timestamp(value).normalize()
                for value in baseline_period_keys
                if pd.notna(value) and pd.Timestamp(value).normalize() < data_through
            }
        )[-config.daily_baseline_periods:]

    baseline_df = scope_df[scope_df["Date"].isin(prior_dates)].copy()
    baseline_positive, baseline_responses, baseline_rate = weighted_totals(
        baseline_df
    )
    delta = (
        actual_rate - baseline_rate
        if pd.notna(actual_rate) and pd.notna(baseline_rate)
        else np.nan
    )

    chart_df = daily[daily["Date"].le(data_through)].tail(
        config.daily_chart_periods
    ).copy()
    chart_df["Period Label"] = chart_df["Date"].map(daily_chart_label)
    chart_df["Is Current"] = chart_df["Date"].eq(data_through)
    chart_df["Is Projected"] = False
    chart_df["Projected Rate"] = np.nan

    return PeriodMetric(
        grain="DAILY",
        scope_name=scope_name,
        period_label=data_through.strftime("%b %d, %Y"),
        period_start=data_through,
        period_end=data_through,
        data_through=data_through,
        actual_rate=actual_rate,
        actual_positive=actual_positive,
        actual_responses=actual_responses,
        baseline_rate=baseline_rate,
        baseline_positive=baseline_positive,
        baseline_responses=baseline_responses,
        delta=delta,
        baseline_period_count=len(prior_dates),
        is_incomplete=False,
        projected_rate=np.nan,
        projected_positive=np.nan,
        projected_responses=np.nan,
        projected_delta=np.nan,
        remaining_days=0,
        projection_basis="Not applicable for Daily",
        chart_df=chart_df,
        baseline_period_keys=[pd.Timestamp(value).normalize() for value in prior_dates],
        baseline_observed_period_count=int(
            baseline_df["Date"].dropna().nunique()
        ),
    )




def calculate_weekly_metric(
    scope_df: pd.DataFrame,
    data_through: pd.Timestamp,
    report_start: pd.Timestamp,
    report_end: pd.Timestamp,
    allow_projection: bool,
    scope_name: str,
    config: AppConfig = CONFIG,
    baseline_period_keys: Optional[Sequence[pd.Timestamp]] = None,
) -> PeriodMetric:
    """
    Calculate the leadership Weekly view using one fixed calendar rule.

    Every reporting week starts on Sunday and ends on Saturday. No month
    boundary, anchor-date rule, latest-minus-one rule, or Monday safeguard may
    change the selected week.
    """
    selected_week_start = sunday_week_start(
        pd.Timestamp(report_start).normalize()
    )
    selected_week_end = selected_week_start + pd.Timedelta(days=6)

    supplied_end = pd.Timestamp(report_end).normalize()
    if supplied_end != selected_week_end:
        LOGGER.warning(
            "Weekly report_end %s was normalized to Saturday %s for the "
            "Sunday-Saturday reporting rule.",
            supplied_end.strftime("%Y-%m-%d"),
            selected_week_end.strftime("%Y-%m-%d"),
        )

    latest_available_date = pd.Timestamp(data_through).normalize()
    if latest_available_date < selected_week_start:
        raise ValueError(
            "Weekly data-through date is earlier than the selected Sunday. "
            f"Week: {selected_week_start:%Y-%m-%d} to "
            f"{selected_week_end:%Y-%m-%d}; "
            f"data through: {latest_available_date:%Y-%m-%d}."
        )

    weekly_data_through = min(
        latest_available_date,
        selected_week_end,
    )
    current_period_start = selected_week_start
    current_period_end = weekly_data_through

    current_df = scope_df[
        scope_df["Date"].between(
            current_period_start,
            current_period_end,
            inclusive="both",
        )
    ].copy()
    actual_positive, actual_responses, actual_rate = weighted_totals(
        current_df
    )

    weekly = aggregate_by_week(scope_df)
    if baseline_period_keys is None:
        prior_weeks = (
            weekly.loc[
                weekly["Week End"].lt(selected_week_start),
                "Week Start",
            ]
            .drop_duplicates()
            .sort_values()
            .tail(config.weekly_baseline_periods)
            .tolist()
        )
    else:
        prior_weeks = sorted(
            {
                sunday_week_start(pd.Timestamp(value).normalize())
                for value in baseline_period_keys
                if pd.notna(value)
                and sunday_week_start(pd.Timestamp(value).normalize())
                < selected_week_start
            }
        )[-config.weekly_baseline_periods:]

    baseline_df = scope_df[
        scope_df["Week Start"].isin(prior_weeks)
    ].copy()
    baseline_positive, baseline_responses, baseline_rate = weighted_totals(
        baseline_df
    )
    delta = (
        actual_rate - baseline_rate
        if pd.notna(actual_rate) and pd.notna(baseline_rate)
        else np.nan
    )

    is_incomplete = bool(
        allow_projection
        and weekly_data_through < selected_week_end
    )
    projected_rate = np.nan
    projected_positive = np.nan
    projected_responses = np.nan
    projected_delta = np.nan
    remaining_days = 0
    projection_basis = "Period complete"

    if is_incomplete:
        projection = project_remaining_dates(
            scope_df=scope_df,
            actual_positive=actual_positive,
            actual_responses=actual_responses,
            data_through=weekly_data_through,
            projection_end=selected_week_end,
            config=config,
        )
        projected_positive = projection["projected_positive"]
        projected_responses = projection["projected_responses"]
        projected_rate = projection["projected_rate"]
        projected_delta = (
            projected_rate - baseline_rate
            if pd.notna(projected_rate) and pd.notna(baseline_rate)
            else np.nan
        )
        remaining_days = int(projection["remaining_days"])
        projection_basis = projection["projection_basis"]

    completed_chart = weekly[
        weekly["Week End"].lt(selected_week_start)
    ].tail(max(0, config.weekly_chart_periods - 1)).copy()
    completed_chart["Period Label"] = build_week_period_labels(
        completed_chart
    )
    completed_chart["Is Current"] = False
    completed_chart["Is Projected"] = False
    completed_chart["Projected Rate"] = np.nan

    current_chart_row = pd.DataFrame(
        [
            {
                "Week Start": selected_week_start,
                "Week End": selected_week_end,
                "Positive": actual_positive,
                "Responses": actual_responses,
                "Actual Rate": actual_rate,
                "Period Label": week_beginning_chart_label(
                    selected_week_start
                ),
                "Is Current": True,
                "Is Projected": bool(is_incomplete),
                "Projected Rate": projected_rate,
            }
        ]
    )
    chart_df = pd.concat(
        [completed_chart, current_chart_row],
        ignore_index=True,
        sort=False,
    )

    period_label = (
        f"{week_beginning_chart_label(selected_week_start)} "
        f"({selected_week_start.strftime('%m/%d/%Y')}–"
        f"{selected_week_end.strftime('%m/%d/%Y')})"
    )
    if is_incomplete:
        period_label += (
            f" through {weekly_data_through.strftime('%m/%d/%Y')}"
        )

    return PeriodMetric(
        grain="WEEKLY",
        scope_name=scope_name,
        period_label=period_label,
        period_start=selected_week_start,
        period_end=selected_week_end,
        data_through=weekly_data_through,
        actual_rate=actual_rate,
        actual_positive=actual_positive,
        actual_responses=actual_responses,
        baseline_rate=baseline_rate,
        baseline_positive=baseline_positive,
        baseline_responses=baseline_responses,
        delta=delta,
        baseline_period_count=len(prior_weeks),
        is_incomplete=is_incomplete,
        projected_rate=projected_rate,
        projected_positive=projected_positive,
        projected_responses=projected_responses,
        projected_delta=projected_delta,
        remaining_days=remaining_days,
        projection_basis=projection_basis,
        chart_df=chart_df,
        baseline_period_keys=[
            pd.Timestamp(value).normalize()
            for value in prior_weeks
        ],
        baseline_observed_period_count=int(
            baseline_df["Week Start"].dropna().nunique()
        ),
    )

def calculate_monthly_metric(
    scope_df: pd.DataFrame,
    reference_month_start: pd.Timestamp,
    data_through: pd.Timestamp,
    allow_projection: bool,
    scope_name: str,
    config: AppConfig = CONFIG,
    baseline_period_keys: Optional[Sequence[pd.Timestamp]] = None,
) -> PeriodMetric:
    reference_month_end = month_end(reference_month_start)
    current_df = scope_df[
        scope_df["Date"].between(
            reference_month_start,
            data_through,
            inclusive="both",
        )
    ].copy()
    actual_positive, actual_responses, actual_rate = weighted_totals(current_df)

    monthly = aggregate_by_month(scope_df)
    if baseline_period_keys is None:
        prior_months = (
            monthly.loc[
                monthly["Month Start"].lt(reference_month_start),
                "Month Start",
            ]
            .drop_duplicates()
            .sort_values()
            .tail(config.monthly_baseline_periods)
            .tolist()
        )
    else:
        prior_months = sorted(
            {
                month_start(pd.Timestamp(value).normalize())
                for value in baseline_period_keys
                if pd.notna(value)
                and month_start(pd.Timestamp(value).normalize())
                < reference_month_start
            }
        )[-config.monthly_baseline_periods:]

    baseline_df = scope_df[scope_df["Month Start"].isin(prior_months)].copy()
    baseline_positive, baseline_responses, baseline_rate = weighted_totals(
        baseline_df
    )
    delta = (
        actual_rate - baseline_rate
        if pd.notna(actual_rate) and pd.notna(baseline_rate)
        else np.nan
    )

    is_incomplete = bool(allow_projection and data_through < reference_month_end)
    projected_rate = np.nan
    projected_positive = np.nan
    projected_responses = np.nan
    projected_delta = np.nan
    remaining_days = 0
    projection_basis = "Period complete"

    if is_incomplete:
        projection = project_remaining_dates(
            scope_df=scope_df,
            actual_positive=actual_positive,
            actual_responses=actual_responses,
            data_through=data_through,
            projection_end=reference_month_end,
            config=config,
        )
        projected_positive = projection["projected_positive"]
        projected_responses = projection["projected_responses"]
        projected_rate = projection["projected_rate"]
        projected_delta = (
            projected_rate - baseline_rate
            if pd.notna(projected_rate) and pd.notna(baseline_rate)
            else np.nan
        )
        remaining_days = int(projection["remaining_days"])
        projection_basis = projection["projection_basis"]

    completed_chart = monthly[
        monthly["Month Start"].lt(reference_month_start)
    ].tail(max(0, config.monthly_chart_periods - 1)).copy()
    completed_chart["Period Label"] = completed_chart["Month Start"].dt.strftime(
        "%B"
    )
    completed_chart["Is Current"] = False
    completed_chart["Is Projected"] = False
    completed_chart["Projected Rate"] = np.nan

    current_chart_row = pd.DataFrame(
        [
            {
                "Month Start": reference_month_start,
                "Month End": reference_month_end,
                "Positive": actual_positive,
                "Responses": actual_responses,
                "Actual Rate": actual_rate,
                "Period Label": (
                    reference_month_start.strftime("%B")
                    + (" (MTD)" if is_incomplete else " (Actual)")
                ),
                "Is Current": True,
                "Is Projected": bool(is_incomplete),
                "Projected Rate": projected_rate,
            }
        ]
    )
    chart_df = pd.concat(
        [completed_chart, current_chart_row],
        ignore_index=True,
        sort=False,
    )

    return PeriodMetric(
        grain="MONTHLY",
        scope_name=scope_name,
        period_label=reference_month_start.strftime("%B %Y"),
        period_start=reference_month_start,
        period_end=reference_month_end,
        data_through=data_through,
        actual_rate=actual_rate,
        actual_positive=actual_positive,
        actual_responses=actual_responses,
        baseline_rate=baseline_rate,
        baseline_positive=baseline_positive,
        baseline_responses=baseline_responses,
        delta=delta,
        baseline_period_count=len(prior_months),
        is_incomplete=is_incomplete,
        projected_rate=projected_rate,
        projected_positive=projected_positive,
        projected_responses=projected_responses,
        projected_delta=projected_delta,
        remaining_days=remaining_days,
        projection_basis=projection_basis,
        chart_df=chart_df,
        baseline_period_keys=[pd.Timestamp(value).normalize() for value in prior_months],
        baseline_observed_period_count=int(
            baseline_df["Month Start"].dropna().nunique()
        ),
    )



def calculate_period_metric(
    grain: str,
    scope_df: pd.DataFrame,
    scope_name: str,
    report_scope: Mapping[str, Any],
    config: AppConfig = CONFIG,
    baseline_period_keys: Optional[Sequence[pd.Timestamp]] = None,
) -> PeriodMetric:
    """
    Calculate the selected grain using independent cut-off dates.

    Daily and Weekly use the operational data-through date. Monthly uses the
    resolved Monthly reporting scope. Weekly projection is controlled only by
    whether the Sunday-Saturday week is complete; it is not disabled by the
    five-day Monthly grace period.
    """
    grain = grain.upper()
    operational_data_through = pd.Timestamp(
        report_scope.get(
            "operational_data_through",
            report_scope["data_through"],
        )
    ).normalize()
    monthly_data_through = pd.Timestamp(
        report_scope.get(
            "monthly_data_through",
            report_scope["data_through"],
        )
    ).normalize()
    weekly_data_through = pd.Timestamp(
        report_scope.get(
            "weekly_source_data_through",
            operational_data_through,
        )
    ).normalize()

    if grain == "DAILY":
        return calculate_daily_metric(
            scope_df=scope_df,
            data_through=operational_data_through,
            scope_name=scope_name,
            config=config,
            baseline_period_keys=baseline_period_keys,
        )

    if grain == "WEEKLY":
        return calculate_weekly_metric(
            scope_df=scope_df,
            data_through=weekly_data_through,
            report_start=report_scope.get(
                "weekly_report_start",
                report_scope["report_start"],
            ),
            report_end=report_scope.get(
                "weekly_report_end",
                report_scope["report_end"],
            ),
            allow_projection=bool(
                report_scope.get("weekly_allow_projection", True)
            ),
            scope_name=scope_name,
            config=config,
            baseline_period_keys=baseline_period_keys,
        )

    if grain == "MONTHLY":
        return calculate_monthly_metric(
            scope_df=scope_df,
            reference_month_start=report_scope["reference_month_start"],
            data_through=monthly_data_through,
            allow_projection=report_scope["current_month_incomplete"],
            scope_name=scope_name,
            config=config,
            baseline_period_keys=baseline_period_keys,
        )

    raise ValueError(f"Unsupported grain: {grain}")


def current_period_dataframe(
    df: pd.DataFrame,
    metric: PeriodMetric,
) -> pd.DataFrame:
    return df[
        df["Date"].between(
            metric.period_start,
            min(metric.data_through, metric.period_end),
            inclusive="both",
        )
    ].copy()


def baseline_period_dataframe(
    df: pd.DataFrame,
    metric: PeriodMetric,
) -> pd.DataFrame:
    """Return rows from the exact baseline periods selected for the metric."""
    keys = [pd.Timestamp(value).normalize() for value in metric.baseline_period_keys]
    if not keys:
        return df.iloc[0:0].copy()

    grain = metric.grain.upper()
    if grain == "DAILY":
        return df[df["Date"].isin(keys)].copy()
    if grain == "WEEKLY":
        return df[df["Week Start"].isin(keys)].copy()
    if grain == "MONTHLY":
        return df[df["Month Start"].isin(keys)].copy()
    raise ValueError(f"Unsupported grain for baseline extraction: {metric.grain}")



def build_executive_site_reconciliation(
    df: pd.DataFrame,
    metric: PeriodMetric,
    config: AppConfig = CONFIG,
) -> pd.DataFrame:
    """
    Reconcile the all-site Executive Summary population.

    Executive actual and baseline rates use every site that passed the selected
    business filter. Detailed site pages use the approved LOB-specific site list.

    Reconciliation rule:
        DISPLAYED SITES SUBTOTAL + OTHER SITES SUBTOTAL = EXECUTIVE ALL SITES

    Site percentages are never averaged. All rates are calculated as:
        SUM(Smiley Numerator) / SUM(Responses)
    """
    detail_sites = list(config.site_detail_sites)
    detail_set = set(detail_sites)

    current_df = current_period_dataframe(df, metric)
    baseline_df = baseline_period_dataframe(df, metric)

    def _normalize_site_value(value: Any) -> str:
        value_text = normalize_text(value)
        return value_text if value_text else "<blank>"

    def _site_totals(source_df: pd.DataFrame, prefix: str) -> pd.DataFrame:
        if source_df.empty:
            return pd.DataFrame(
                columns=["Site", f"{prefix} Positive", f"{prefix} Responses"]
            )
        work = source_df.copy()
        work["Site"] = work["Site"].map(_normalize_site_value)
        grouped = (
            work.groupby("Site", dropna=False)
            .agg(
                **{
                    f"{prefix} Positive": ("Smiley Numerator", "sum"),
                    f"{prefix} Responses": ("Responses", "sum"),
                }
            )
            .reset_index()
        )
        return grouped

    actual_by_site = _site_totals(current_df, "Actual")
    baseline_by_site = _site_totals(baseline_df, "Baseline")
    reconciliation = actual_by_site.merge(
        baseline_by_site,
        on="Site",
        how="outer",
    )

    # Ensure all four detailed sites appear even when they have no period data.
    required_detail_rows = pd.DataFrame({"Site": detail_sites})
    reconciliation = pd.concat(
        [reconciliation, required_detail_rows],
        ignore_index=True,
        sort=False,
    ).drop_duplicates(subset=["Site"], keep="first")

    for column in [
        "Actual Positive",
        "Actual Responses",
        "Baseline Positive",
        "Baseline Responses",
    ]:
        reconciliation[column] = pd.to_numeric(
            reconciliation[column], errors="coerce"
        ).fillna(0.0)

    reconciliation["Actual Rate"] = np.where(
        reconciliation["Actual Responses"].gt(0),
        reconciliation["Actual Positive"] / reconciliation["Actual Responses"],
        np.nan,
    )
    reconciliation["Baseline Rate"] = np.where(
        reconciliation["Baseline Responses"].gt(0),
        reconciliation["Baseline Positive"] / reconciliation["Baseline Responses"],
        np.nan,
    )
    reconciliation["Population Type"] = np.where(
        reconciliation["Site"].isin(detail_set),
        "DETAILED SITE",
        "OTHER SITE",
    )
    reconciliation["Detailed Site"] = reconciliation["Site"].isin(detail_set)

    raw_actual_positive = float(metric.actual_positive)
    raw_actual_responses = float(metric.actual_responses)
    raw_actual_rate = metric.actual_rate
    raw_baseline_positive = float(metric.baseline_positive)
    raw_baseline_responses = float(metric.baseline_responses)
    raw_baseline_rate = metric.baseline_rate

    detail_mask = reconciliation["Detailed Site"]
    other_mask = ~detail_mask

    def _totals(mask: pd.Series) -> Dict[str, float]:
        actual_positive = float(reconciliation.loc[mask, "Actual Positive"].sum())
        actual_responses = float(reconciliation.loc[mask, "Actual Responses"].sum())
        baseline_positive = float(reconciliation.loc[mask, "Baseline Positive"].sum())
        baseline_responses = float(reconciliation.loc[mask, "Baseline Responses"].sum())
        return {
            "Actual Positive": actual_positive,
            "Actual Responses": actual_responses,
            "Actual Rate": safe_rate(actual_positive, actual_responses),
            "Baseline Positive": baseline_positive,
            "Baseline Responses": baseline_responses,
            "Baseline Rate": safe_rate(baseline_positive, baseline_responses),
        }

    detail_totals = _totals(detail_mask)
    other_totals = _totals(other_mask)
    all_totals = _totals(pd.Series(True, index=reconciliation.index))

    count_tol = config.executive_reconciliation_count_tolerance
    rate_tol = config.executive_reconciliation_rate_tolerance

    counts_match = (
        math.isclose(
            detail_totals["Actual Positive"] + other_totals["Actual Positive"],
            raw_actual_positive,
            abs_tol=count_tol,
        )
        and math.isclose(
            detail_totals["Actual Responses"] + other_totals["Actual Responses"],
            raw_actual_responses,
            abs_tol=count_tol,
        )
        and math.isclose(
            detail_totals["Baseline Positive"] + other_totals["Baseline Positive"],
            raw_baseline_positive,
            abs_tol=count_tol,
        )
        and math.isclose(
            detail_totals["Baseline Responses"] + other_totals["Baseline Responses"],
            raw_baseline_responses,
            abs_tol=count_tol,
        )
    )
    rates_match = (
        (
            pd.isna(all_totals["Actual Rate"]) and pd.isna(raw_actual_rate)
        )
        or (
            pd.notna(all_totals["Actual Rate"])
            and pd.notna(raw_actual_rate)
            and math.isclose(
                float(all_totals["Actual Rate"]),
                float(raw_actual_rate),
                abs_tol=rate_tol,
            )
        )
    ) and (
        (
            pd.isna(all_totals["Baseline Rate"]) and pd.isna(raw_baseline_rate)
        )
        or (
            pd.notna(all_totals["Baseline Rate"])
            and pd.notna(raw_baseline_rate)
            and math.isclose(
                float(all_totals["Baseline Rate"]),
                float(raw_baseline_rate),
                abs_tol=rate_tol,
            )
        )
    )
    reconciliation_pass = bool(counts_match and rates_match)

    if config.enforce_executive_site_reconciliation and not reconciliation_pass:
        raise ValueError(
            f"{metric.grain} all-site executive population failed reconciliation. "
            "Displayed-site subtotal plus other-site subtotal did not equal the "
            "all-site executive total."
        )

    total_actual_responses = all_totals["Actual Responses"]
    reconciliation["Actual Response Share"] = np.where(
        total_actual_responses > 0,
        reconciliation["Actual Responses"] / total_actual_responses,
        np.nan,
    )
    reconciliation["Weighted Contribution to Executive Rate"] = np.where(
        total_actual_responses > 0,
        reconciliation["Actual Positive"] / total_actual_responses,
        np.nan,
    )
    reconciliation["Current Period Has Data"] = reconciliation[
        "Actual Responses"
    ].gt(0)
    reconciliation["Baseline Has Data"] = reconciliation[
        "Baseline Responses"
    ].gt(0)

    missing_detail_sites = [
        site
        for site in detail_sites
        if float(
            reconciliation.loc[
                reconciliation["Site"].eq(site), "Actual Responses"
            ].sum()
        ) <= 0
    ]
    if config.require_all_detail_sites_in_current_period and missing_detail_sites:
        raise ValueError(
            f"{metric.grain} current period is missing detailed site data for: "
            + ", ".join(missing_detail_sites)
        )

    common_fields = {
        "Grain": metric.grain,
        "Period Label": metric.period_label,
        "Period Start": metric.period_start,
        "Period End": min(metric.period_end, metric.data_through),
        "Baseline Period Count": metric.baseline_period_count,
        "Baseline Period Keys": ", ".join(
            pd.Timestamp(value).strftime("%Y-%m-%d")
            for value in metric.baseline_period_keys
        ),
        "Detailed Sites": ", ".join(detail_sites),
        "Missing Detailed Sites": ", ".join(missing_detail_sites),
        "Rollup Method": "SUM positive responses / SUM responses",
    }
    for key, value in common_fields.items():
        reconciliation[key] = value

    def _subtotal_row(
        label: str,
        population_type: str,
        totals: Mapping[str, float],
        detailed_site: bool,
    ) -> Dict[str, Any]:
        return {
            **common_fields,
            "Site": label,
            "Population Type": population_type,
            "Detailed Site": detailed_site,
            **totals,
            "Actual Response Share": (
                totals["Actual Responses"] / total_actual_responses
                if total_actual_responses > 0
                else np.nan
            ),
            "Weighted Contribution to Executive Rate": (
                totals["Actual Positive"] / total_actual_responses
                if total_actual_responses > 0
                else np.nan
            ),
            "Current Period Has Data": totals["Actual Responses"] > 0,
            "Baseline Has Data": totals["Baseline Responses"] > 0,
            "Raw Executive Actual Rate": raw_actual_rate,
            "Actual Rate Difference pp": (
                (totals["Actual Rate"] - raw_actual_rate) * 100
                if label == "EXECUTIVE ALL SITES"
                and pd.notna(totals["Actual Rate"])
                and pd.notna(raw_actual_rate)
                else np.nan
            ),
            "Raw Executive Baseline Rate": raw_baseline_rate,
            "Baseline Rate Difference pp": (
                (totals["Baseline Rate"] - raw_baseline_rate) * 100
                if label == "EXECUTIVE ALL SITES"
                and pd.notna(totals["Baseline Rate"])
                and pd.notna(raw_baseline_rate)
                else np.nan
            ),
            "Reconciliation Status": (
                "PASS" if label == "EXECUTIVE ALL SITES" and reconciliation_pass
                else "SUBTOTAL"
            ),
        }

    subtotal_rows = [
        _subtotal_row(
            "DISPLAYED SITES SUBTOTAL",
            "DISPLAYED SITES SUBTOTAL",
            detail_totals,
            True,
        ),
        _subtotal_row(
            "OTHER SITES SUBTOTAL",
            "OTHER SITES SUBTOTAL",
            other_totals,
            False,
        ),
        _subtotal_row(
            "EXECUTIVE ALL SITES",
            "EXECUTIVE ALL SITES",
            all_totals,
            False,
        ),
    ]

    reconciliation["Raw Executive Actual Rate"] = raw_actual_rate
    reconciliation["Actual Rate Difference pp"] = np.nan
    reconciliation["Raw Executive Baseline Rate"] = raw_baseline_rate
    reconciliation["Baseline Rate Difference pp"] = np.nan
    reconciliation["Reconciliation Status"] = "SITE DETAIL"

    reconciliation = pd.concat(
        [reconciliation, pd.DataFrame(subtotal_rows)],
        ignore_index=True,
        sort=False,
    )

    ordered_columns = [
        "Grain",
        "Period Label",
        "Period Start",
        "Period End",
        "Population Type",
        "Site",
        "Detailed Site",
        "Actual Positive",
        "Actual Responses",
        "Actual Rate",
        "Actual Response Share",
        "Weighted Contribution to Executive Rate",
        "Baseline Positive",
        "Baseline Responses",
        "Baseline Rate",
        "Baseline Period Count",
        "Baseline Period Keys",
        "Current Period Has Data",
        "Baseline Has Data",
        "Detailed Sites",
        "Missing Detailed Sites",
        "Rollup Method",
        "Raw Executive Actual Rate",
        "Actual Rate Difference pp",
        "Raw Executive Baseline Rate",
        "Baseline Rate Difference pp",
        "Reconciliation Status",
    ]
    return reconciliation[
        [column for column in ordered_columns if column in reconciliation.columns]
    ].copy()

