def write_rows_to_sheet_with_retry(
    sheets_service,
    spreadsheet_id,
    sheet_name,
    start_row,
    rows,
    start_col,
    end_col,
):
    if not rows:
        return

    end_row = start_row + len(rows) - 1
    write_range = (
        f"{sheet_name}!{start_col}{start_row}:"
        f"{end_col}{end_row}"
    )
    body = {
        "range": write_range,
        "majorDimension": "ROWS",
        "values": rows,
    }

    run_with_retry(
        f"Write range {write_range}",
        lambda: sheets_service.spreadsheets().values().update(
            spreadsheetId=spreadsheet_id,
            range=write_range,
            valueInputOption="USER_ENTERED",
            body=body,
        ).execute(),
    )


def format_raw_sheet_columns(
    sheets_service,
    spreadsheet_id,
    sheet_name,
):
    sheet_id = get_sheet_id_by_name(
        sheets_service,
        spreadsheet_id,
        sheet_name,
    )

    def build_number_format_request(
        column_name,
        number_format_type,
        pattern,
    ):
        if column_name not in FINAL_OUTPUT_COLUMNS:
            raise ValueError(
                f"Cannot format missing output column: {column_name}"
            )

        column_index = FINAL_OUTPUT_COLUMNS.index(column_name)
        return {
            "repeatCell": {
                "range": {
                    "sheetId": sheet_id,
                    "startRowIndex": 1,
                    "startColumnIndex": column_index,
                    "endColumnIndex": column_index + 1,
                },
                "cell": {
                    "userEnteredFormat": {
                        "numberFormat": {
                            "type": number_format_type,
                            "pattern": pattern,
                        }
                    }
                },
                "fields": "userEnteredFormat.numberFormat",
            }
        }

    requests = []

    for column_name in ["Smiley Registered At", "Created Date"]:
        requests.append(
            build_number_format_request(
                column_name=column_name,
                number_format_type="DATE_TIME",
                pattern="mmm dd, yyyy hh:mm:ss",
            )
        )

    for column_name in DATEVALUE_OUTPUT_COLUMNS:
        requests.append(
            build_number_format_request(
                column_name=column_name,
                number_format_type="DATE",
                pattern="yyyy-mm-dd",
            )
        )

    for column_name in NUMERIC_OUTPUT_COLUMNS:
        requests.append(
            build_number_format_request(
                column_name=column_name,
                number_format_type="NUMBER",
                pattern="0",
            )
        )

    for column_name in MIXED_NUMBER_OUTPUT_COLUMNS:
        if column_name in DECIMAL_NUMBER_OUTPUT_COLUMNS:
            pattern = "0.00"
        else:
            pattern = "0"
        requests.append(
            build_number_format_request(
                column_name=column_name,
                number_format_type="NUMBER",
                pattern=pattern,
            )
        )

    if not requests:
        return

    run_with_retry(
        f"Format sheet {sheet_name}",
        lambda: sheets_service.spreadsheets().batchUpdate(
            spreadsheetId=spreadsheet_id,
            body={"requests": requests},
        ).execute(),
    )



def write_summary_table(
    sheets_service,
    spreadsheet_id,
    summary_sheet_name,
    rows,
):
    ensure_sheet_exists(
        sheets_service,
        spreadsheet_id,
        summary_sheet_name,
    )

    all_rows = [SUMMARY_HEADERS] + rows
    required_summary_rows = max(
        len(all_rows) + SUMMARY_EXTRA_BUFFER_ROWS,
        1,
    )
    required_summary_columns = len(SUMMARY_HEADERS)
    summary_end_col = column_number_to_letter(required_summary_columns)

    validate_projected_workbook_cell_usage(
        sheets_service=sheets_service,
        spreadsheet_id=spreadsheet_id,
        generated_sheet_name=summary_sheet_name,
        required_rows=required_summary_rows,
        required_columns=required_summary_columns,
    )

    resize_generated_sheet_grid(
        sheets_service=sheets_service,
        spreadsheet_id=spreadsheet_id,
        sheet_name=summary_sheet_name,
        required_rows=required_summary_rows,
        required_columns=required_summary_columns,
    )

    bounded_clear_range = build_bounded_a1_range(
        sheet_name=summary_sheet_name,
        start_column="A",
        end_column=summary_end_col,
        start_row=1,
        end_row=required_summary_rows,
    )

    clear_range_with_retry(
        sheets_service,
        spreadsheet_id,
        bounded_clear_range,
    )

    batch_size = 1_000
    total_batches = math.ceil(len(all_rows) / batch_size)
    PROGRESS.add_total(total_batches)

    next_row = 1
    for batch_number, start_index in enumerate(
        range(0, len(all_rows), batch_size),
        start=1,
    ):
        chunk = all_rows[
            start_index:start_index + batch_size
        ]

        write_rows_to_sheet_with_retry(
            sheets_service=sheets_service,
            spreadsheet_id=spreadsheet_id,
            sheet_name=summary_sheet_name,
            start_row=next_row,
            rows=chunk,
            start_col="A",
            end_col=summary_end_col,
        )

        next_row += len(chunk)
        PROGRESS.update(
            1,
            f"Writing load summary batch "
            f"{batch_number}/{total_batches}",
        )



