def _v526_normalize_header_for_cf(header: Any) -> str:
    return re.sub(r"\s+", " ", str(header or "").strip().lower())


def _v526_parse_percent_value(value: Any) -> Optional[float]:
    """
    Parse a percentage-like value safely.

    Supported examples:
    - "82.4%"
    - "82.4"
    - "1,234 / 82.4%"
    - "Smiley 82.4%"
    Returns None when no numeric value can be safely inferred.
    """
    if value is None:
        return None
    text_value = str(value).strip()
    if not text_value or text_value.upper() in {"N/A", "NA", "NONE", "-", "—"}:
        return None

    # Prefer explicit percentage values.
    percent_matches = re.findall(r"[-+]?\d+(?:,\d{3})*(?:\.\d+)?\s*%", text_value)
    if percent_matches:
        token = percent_matches[-1].replace("%", "").replace(",", "").strip()
        try:
            return float(token)
        except Exception:
            return None

    # Fall back to a plain numeric value only when it looks like a rate column cell.
    numeric_matches = re.findall(r"[-+]?\d+(?:,\d{3})*(?:\.\d+)?", text_value)
    if not numeric_matches:
        return None
    try:
        return float(numeric_matches[-1].replace(",", ""))
    except Exception:
        return None


def _v526_parse_signed_delta_value(value: Any) -> Optional[float]:
    """
    Parse impact/delta values safely.

    This intentionally requires a signed value, arrow, or negative-parentheses
    pattern so normal unsiged counts are not color-coded as positive impact.
    """
    if value is None:
        return None
    text_value = str(value).strip()
    if not text_value or text_value.upper() in {"N/A", "NA", "NONE", "-", "—"}:
        return None

    lowered = text_value.lower()
    if any(token in lowered for token in ["stable", "neutral", "no change"]):
        return 0.0

    sign_multiplier = 1.0
    if "▼" in text_value or "↓" in text_value:
        sign_multiplier = -1.0
    elif "▲" in text_value or "↑" in text_value:
        sign_multiplier = 1.0

    # Parentheses are treated as negative only when they wrap a numeric value.
    paren_match = re.search(r"\(\s*(\d+(?:,\d{3})*(?:\.\d+)?)\s*(?:pp|%|pts?|points?)?\s*\)", text_value, flags=re.I)
    if paren_match:
        try:
            return -float(paren_match.group(1).replace(",", ""))
        except Exception:
            return None

    signed_match = re.search(r"([+-]\s*\d+(?:,\d{3})*(?:\.\d+)?)", text_value)
    if signed_match:
        try:
            return float(signed_match.group(1).replace(" ", "").replace(",", ""))
        except Exception:
            return None

    # Arrow with an unsigned number, e.g. "▲ 1.2pp".
    if any(symbol in text_value for symbol in ["▲", "▼", "↑", "↓"]):
        num_match = re.search(r"(\d+(?:,\d{3})*(?:\.\d+)?)", text_value)
        if num_match:
            try:
                return sign_multiplier * float(num_match.group(1).replace(",", ""))
            except Exception:
                return None

    return None


def _v526_is_smiley_rate_header(header: Any) -> bool:
    h = _v526_normalize_header_for_cf(header)
    if "non-smiley" in h or "nonsmiley" in h:
        return False

    # v5.7.30: Delta/count columns such as "Δ Smiley Cnt vs 12D Rolling"
    # must be formatted by the delta/impact rules, not by the 80% Smiley Rate
    # threshold. Without this guard, Google Docs could show Smiley-count deltas
    # as red merely because the numeric delta is below 80.
    delta_or_count_tokens = [
        "Δ",
        "delta",
        "change",
        "movement",
        "cnt",
        "count",
        "rolling",
        "roll",
        "vs ",
        "pp",
    ]
    if any(token in h for token in delta_or_count_tokens):
        return False

    return ("smiley" in h) and (
        "rate" in h
        or "%" in h
        or "percent" in h
        or h == "smiley"
        or h.endswith(" smiley")
        or "smiley %" in h
    )


def _v526_is_impact_header(header: Any) -> bool:
    h = _v526_normalize_header_for_cf(header)
    impact_tokens = [
        "impact",
        "delta",
        "change",
        "variance",
        "movement",
        "lift",
        "gap",
        "vs prior",
        "vs avg",
        "vs average",
        "vs baseline",
        "pp",
        "Δ",
    ]
    return any(token in h for token in impact_tokens)


def _v526_apply_cell_conditional_style(
    cell: Any,
    fill_hex: str,
    text_hex: str,
    bold: bool = True,
) -> None:
    _set_cell_shading(cell, fill_hex)
    _set_cell_text_color(cell, text_hex)
    if bold:
        for paragraph in cell.paragraphs:
            for run in paragraph.runs:
                run.bold = True


def _v526_apply_docx_table_conditional_formatting(
    table: Any,
    headers: Sequence[str],
    smiley_threshold: float = SMILEY_RATE_THRESHOLD_V526,
) -> None:
    """
    Apply soft conditional formatting to DOCX tables without changing values.

    Smiley Rate:
      < 80%  -> soft red
      >=80%  -> soft green

    Impact / delta:
      positive -> soft green
      negative -> soft red
      zero     -> soft neutral gray

    This helper is defensive. It skips cells that cannot be parsed and never
    blocks report generation.
    """
    try:
        if table is None or not headers:
            return

        smiley_cols = {
            idx for idx, header in enumerate(headers)
            if _v526_is_smiley_rate_header(header)
        }
        impact_cols = {
            idx for idx, header in enumerate(headers)
            if _v526_is_impact_header(header)
        }

        if not smiley_cols and not impact_cols:
            return

        for row in list(table.rows)[1:]:
            for col_idx in smiley_cols:
                if col_idx >= len(row.cells):
                    continue
                cell = row.cells[col_idx]
                pct_value = _v526_parse_percent_value(cell.text)
                if pct_value is None:
                    continue
                if pct_value >= smiley_threshold:
                    _v526_apply_cell_conditional_style(
                        cell,
                        DOCX_CF_SOFT_GREEN_FILL_V526,
                        DOCX_CF_GREEN_TEXT_V526,
                    )
                else:
                    _v526_apply_cell_conditional_style(
                        cell,
                        DOCX_CF_SOFT_RED_FILL_V526,
                        DOCX_CF_RED_TEXT_V526,
                    )

            for col_idx in impact_cols:
                if col_idx >= len(row.cells):
                    continue
                cell = row.cells[col_idx]
                delta_value = _v526_parse_signed_delta_value(cell.text)
                if delta_value is None:
                    continue
                header_text = _v526_normalize_header_for_cf(headers[col_idx])
                reverse_direction = (
                    "non-smiley" in header_text
                    or "nonsmiley" in header_text
                    or "frownie" in header_text
                    or "unhappy" in header_text
                )
                if delta_value > 0:
                    _v526_apply_cell_conditional_style(
                        cell,
                        DOCX_CF_SOFT_RED_FILL_V526 if reverse_direction else DOCX_CF_SOFT_GREEN_FILL_V526,
                        DOCX_CF_RED_TEXT_V526 if reverse_direction else DOCX_CF_GREEN_TEXT_V526,
                    )
                elif delta_value < 0:
                    _v526_apply_cell_conditional_style(
                        cell,
                        DOCX_CF_SOFT_GREEN_FILL_V526 if reverse_direction else DOCX_CF_SOFT_RED_FILL_V526,
                        DOCX_CF_GREEN_TEXT_V526 if reverse_direction else DOCX_CF_RED_TEXT_V526,
                    )
                else:
                    _v526_apply_cell_conditional_style(
                        cell,
                        DOCX_CF_NEUTRAL_FILL_V526,
                        DOCX_CF_NEUTRAL_TEXT_V526,
                        bold=False,
                    )
    except Exception as exc:
        # Conditional formatting should never fail the report.
        logging.warning("DOCX conditional formatting skipped for one table: %s", exc)



def add_executive_table(
    document: Document,
    headers: Sequence[str],
    rows: Sequence[Sequence[Any]],
    header_fill: str = "002060",
    font_size: float = 8.0,
) -> Any:
    table = document.add_table(rows=1, cols=len(headers))
    table.style = "Table Grid"
    table.alignment = WD_TABLE_ALIGNMENT.CENTER
    header_cells = table.rows[0].cells

    for index, header in enumerate(headers):
        _set_cell_shading(header_cells[index], header_fill)
        _set_table_cell_text(
            header_cells[index],
            str(header),
            bold=True,
            color_hex="FFFFFF",
            font_size=font_size,
            alignment=WD_ALIGN_PARAGRAPH.CENTER,
        )

    for row_values in rows:
        cells = table.add_row().cells
        for index, value in enumerate(row_values):
            _set_table_cell_text(
                cells[index],
                "" if value is None else str(value),
                font_size=font_size,
                alignment=(
                    WD_ALIGN_PARAGRAPH.LEFT
                    if index == 0
                    else WD_ALIGN_PARAGRAPH.CENTER
                ),
            )
    _v526_apply_docx_table_conditional_formatting(table, headers)
    return table



