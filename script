    smiley_total = float(
        pd.to_numeric(impact_df.get("Smiley", pd.Series(dtype="float64")), errors="coerce")
        .fillna(0.0)
        .sum()
    )
    scope_rate = safe_rate(smiley_total, rated_total)

    ranked_rate = impact_df.copy()
    ranked_rate["_Rated"] = pd.to_numeric(
        ranked_rate.get("Rated", pd.Series(dtype="float64")),
        errors="coerce",
