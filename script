def _normalize_source_impact_candidate(series: pd.Series) -> List[pd.Series]:
    numeric = pd.to_numeric(series, errors="coerce")
    return [numeric, numeric / 100.0]


def validate_source_impact(
    period_df: pd.DataFrame,
    grain: str,
    overall_rate: float,
    target_rate: float,
    config: AppConfig = CONFIG,
) -> Dict[str, Any]:
    impact_column = SOURCE_IMPACT_COLUMNS[grain]
    if impact_column not in period_df.columns:
        return {
            "valid": False,
            "column": impact_column,
            "normalized_series": pd.Series(np.nan, index=period_df.index),
            "message": f"{impact_column} not found; calculated impact used.",
            "coverage": 0.0,
            "difference": np.nan,
        }

    source = pd.to_numeric(period_df[impact_column], errors="coerce")
    coverage = float(source.notna().mean()) if len(source) else 0.0
    expected_total = (
        overall_rate - target_rate
        if pd.notna(overall_rate)
        else np.nan
    )

    best_series = source.copy()
    best_difference = np.inf
    best_total = np.nan
    best_unit = "raw"

    for unit_name, candidate in zip(
        ["raw decimal", "percentage-point / 100"],
        _normalize_source_impact_candidate(source),
    ):
        candidate_total = float(candidate.fillna(0).sum())
        difference = (
            abs(candidate_total - expected_total)
            if pd.notna(expected_total)
            else np.inf
        )
        if difference < best_difference:
            best_difference = difference
            best_series = candidate
            best_total = candidate_total
            best_unit = unit_name

    valid = (
        coverage >= config.source_impact_required_coverage
        and best_difference <= config.source_impact_total_tolerance
    )
    if valid:
        message = (
            f"{impact_column} validated ({coverage:.1%} coverage, {best_unit}, "
            f"total variance {best_difference * 100:.2f} pp)."
        )
    else:
        message = (
            f"{impact_column} not used ({coverage:.1%} coverage, best total "
            f"variance {best_difference * 100:.2f} pp). Calculated impact used."
        )

    return {
        "valid": valid,
        "column": impact_column,
        "normalized_series": best_series,
        "message": message,
        "coverage": coverage,
        "difference": best_difference,
        "total": best_total,
        "expected_total": expected_total,
    }


def build_segment_impact_table(
    period_df: pd.DataFrame,
    segment_columns: Sequence[str],
    target_rate: float,
    source_impact_validation: Optional[Mapping[str, Any]] = None,
    scope_name: str = "Overall",
) -> pd.DataFrame:
    if period_df.empty:
        return pd.DataFrame()

    group_columns = list(segment_columns)
    total_responses = float(period_df["Responses"].sum())
    total_positive = float(period_df["Smiley Numerator"].sum())
    overall_rate = safe_rate(total_positive, total_responses)

    grouped = (
        period_df.groupby(group_columns, dropna=False)
        .agg(
            Positive=("Smiley Numerator", "sum"),
            Responses=("Responses", "sum"),
            Ticket_Count=("Ticket ID", "nunique"),
            Non_Smiley_Count=("Smiley Numerator", lambda s: int((s <= 0).sum())),
        )
        .reset_index()
    )
    grouped["Smiley Rate"] = np.where(
        grouped["Responses"].gt(0),
        grouped["Positive"] / grouped["Responses"],
        np.nan,
    )
    grouped["Response Share"] = np.where(
        total_responses > 0,
        grouped["Responses"] / total_responses,
        np.nan,
    )
    grouped["Calculated Impact"] = (
        grouped["Response Share"] * (grouped["Smiley Rate"] - target_rate)
    )
    grouped["Scope Rate"] = overall_rate
    grouped["Delta vs Scope"] = grouped["Smiley Rate"] - overall_rate
    grouped["Sample Size Classification"] = grouped["Responses"].apply(
        sample_size_label
    )
    grouped["Scope"] = scope_name

    grouped["Source Impact"] = np.nan
    grouped["Official Impact"] = grouped["Calculated Impact"]
    grouped["Impact Method"] = "Calculated vs target"

    if source_impact_validation and source_impact_validation.get("valid"):
        source_series = source_impact_validation["normalized_series"]
        temp = period_df[group_columns].copy()
        temp["_Source Impact"] = source_series.reindex(period_df.index)
        source_grouped = (
            temp.groupby(group_columns, dropna=False)["_Source Impact"]
            .sum(min_count=1)
            .reset_index()
            .rename(columns={"_Source Impact": "Source Impact"})
        )
        grouped = grouped.drop(columns=["Source Impact"]).merge(
            source_grouped,
            on=group_columns,
            how="left",
        )
        grouped["Official Impact"] = grouped["Source Impact"].where(
            grouped["Source Impact"].notna(),
            grouped["Calculated Impact"],
        )
        grouped["Impact Method"] = np.where(
            grouped["Source Impact"].notna(),
            "Validated source impact",
            "Calculated vs target",
        )

    grouped["Impact Variance"] = (
        grouped["Source Impact"] - grouped["Calculated Impact"]
    )
    grouped = grouped.sort_values(
        ["Official Impact", "Responses"],
        ascending=[True, False],
    ).reset_index(drop=True)
    return grouped



def build_grain_result(
    df: pd.DataFrame,
    grain: str,
    report_scope: Mapping[str, Any],
    config: AppConfig = CONFIG,
) -> GrainResult:
    overall_metric = calculate_period_metric(
        grain=grain,
        scope_df=df,
        scope_name="Overall",
        report_scope=report_scope,
        config=config,
    )
    period_df = current_period_dataframe(df, overall_metric)
    source_validation = validate_source_impact(
        period_df=period_df,
        grain=grain,
        overall_rate=overall_metric.actual_rate,
        target_rate=config.target_rate,
        config=config,
    )

    site_summary = build_segment_impact_table(
        period_df=period_df,
        segment_columns=["Site"],
        target_rate=config.target_rate,
        source_impact_validation=source_validation,
        scope_name="Overall",
    )
    site_summary["Grain"] = grain
    site_summary["Period Label"] = overall_metric.period_label

    executive_reconciliation = build_executive_site_reconciliation(
        df=df,
        metric=overall_metric,
        config=config,
    )

    squad_tables: List[pd.DataFrame] = []
    current_sites = sorted(
        period_df["Site"].fillna("").astype(str).unique().tolist()
    )
    for site in current_sites:
        site_df = period_df[period_df["Site"].fillna("").astype(str).eq(site)].copy()
        if site_df.empty:
            continue
        squad_table = build_segment_impact_table(
            period_df=site_df,
            segment_columns=["Site", "Squad Code"],
            target_rate=config.target_rate,
            source_impact_validation=None,
            scope_name=site,
        )
        if not squad_table.empty:
            squad_table["Grain"] = grain
            squad_table["Period Label"] = overall_metric.period_label
            squad_tables.append(squad_table)

    squad_summary = (
        pd.concat(squad_tables, ignore_index=True)
        if squad_tables
        else pd.DataFrame()
    )

    LOGGER.info(
        "%s result: %s, %s vs baseline, %d responses. "
        "Executive all-site population reconciliation: %s.",
        grain,
        format_rate(overall_metric.actual_rate),
        format_pp(overall_metric.delta),
        int(round(overall_metric.actual_responses)),
        executive_reconciliation.loc[
            executive_reconciliation["Site"].eq("EXECUTIVE ALL SITES"),
            "Reconciliation Status",
        ].iloc[0],
    )
    return GrainResult(
        grain=grain,
        overall=overall_metric,
        current_period_df=period_df,
        site_summary=site_summary,
        squad_summary=squad_summary,
        source_impact_valid=bool(source_validation["valid"]),
        source_impact_message=str(source_validation["message"]),
        executive_reconciliation=executive_reconciliation,
    )




def _normalized_segment_values(
    series: pd.Series,
    unknown_label: str,
) -> pd.Series:
    """Return display-safe segment values without silently dropping blanks."""
    values = (
        series.fillna("")
        .astype(str)
        .str.replace(r"\s+", " ", regex=True)
        .str.strip()
    )
    return values.mask(values.eq(""), unknown_label)


def _dominant_text_by_segment(
    current_df: pd.DataFrame,
    segment_column: str,
    value_column: str,
    unknown_segment_label: str,
) -> pd.DataFrame:
    """Return the most frequent nonblank supporting value for each segment."""
    if (
        current_df.empty
        or segment_column not in current_df.columns
        or value_column not in current_df.columns
    ):
        return pd.DataFrame(columns=["Segment", f"Main {value_column}"])

    work = current_df[[segment_column, value_column]].copy()
    work["Segment"] = _normalized_segment_values(
        work[segment_column],
        unknown_segment_label,
    )
    work[value_column] = (
        work[value_column]
        .fillna("")
        .astype(str)
        .str.replace(r"\s+", " ", regex=True)
        .str.strip()
    )
    work = work[work[value_column].ne("")]
    if work.empty:
        return pd.DataFrame(columns=["Segment", f"Main {value_column}"])

    counts = (
        work.groupby(["Segment", value_column], dropna=False)
        .size()
        .reset_index(name="_Count")
        .sort_values(
            ["Segment", "_Count", value_column],
            ascending=[True, False, True],
        )
    )
    dominant = (
        counts.drop_duplicates("Segment", keep="first")
        [["Segment", value_column]]
        .rename(columns={value_column: f"Main {value_column}"})
        .reset_index(drop=True)
    )
    return dominant


def build_site_segment_driver_table(
    site_df: pd.DataFrame,
    metric: PeriodMetric,
    segment_column: str,
    display_label: str,
    unknown_label: str,
    target_rate: float,
) -> pd.DataFrame:
    """
    Build a baseline-aware site driver table for one dimension.

    Impact is estimated as:
        current-period response share x (current rate - segment baseline rate)

    When a segment has no baseline observations, the site's weighted baseline
    rate is used as the fallback. This keeps the narrative auditable while
    avoiding a misleading zero baseline.
    """
    required = {
        "Date",
        "Responses",
        "Smiley Numerator",
        "Ticket ID",
        segment_column,
    }
    if site_df.empty or not required.issubset(site_df.columns):
        return pd.DataFrame()

    current_df = current_period_dataframe(site_df, metric)
    baseline_df = baseline_period_dataframe(site_df, metric)
    if current_df.empty:
        return pd.DataFrame()

    current = current_df.copy()
    baseline = baseline_df.copy()
    current["Segment"] = _normalized_segment_values(
        current[segment_column],
        unknown_label,
    )
    if not baseline.empty:
        baseline["Segment"] = _normalized_segment_values(
            baseline[segment_column],
            unknown_label,
        )
    else:
        baseline["Segment"] = pd.Series(index=baseline.index, dtype="object")

    current_grouped = (
        current.groupby("Segment", dropna=False)
        .agg(
            Current_Positive=("Smiley Numerator", "sum"),
            Current_Responses=("Responses", "sum"),
            Current_Tickets=("Ticket ID", "nunique"),
            Non_Smiley_Count=(
                "Smiley Numerator",
                lambda s: int(pd.to_numeric(s, errors="coerce").fillna(0).le(0).sum()),
            ),
        )
        .reset_index()
    )
    current_grouped["Current Rate"] = np.where(
        current_grouped["Current_Responses"].gt(0),
        current_grouped["Current_Positive"]
        / current_grouped["Current_Responses"],
        np.nan,
    )

    if baseline.empty:
        baseline_grouped = pd.DataFrame(
            columns=[
                "Segment",
                "Baseline Positive",
                "Baseline Responses",
                "Baseline Tickets",
                "Segment Baseline Rate",
            ]
        )
    else:
        baseline_grouped = (
            baseline.groupby("Segment", dropna=False)
            .agg(
                Baseline_Positive=("Smiley Numerator", "sum"),
                Baseline_Responses=("Responses", "sum"),
                Baseline_Tickets=("Ticket ID", "nunique"),
            )
            .reset_index()
        )
        baseline_grouped["Segment Baseline Rate"] = np.where(
            baseline_grouped["Baseline_Responses"].gt(0),
            baseline_grouped["Baseline_Positive"]
            / baseline_grouped["Baseline_Responses"],
            np.nan,
        )
        baseline_grouped = baseline_grouped.rename(
            columns={
                "Baseline_Positive": "Baseline Positive",
                "Baseline_Responses": "Baseline Responses",
                "Baseline_Tickets": "Baseline Tickets",
            }
        )

    result = current_grouped.merge(
        baseline_grouped,
        on="Segment",
        how="left",
    )
    for column in [
        "Baseline Positive",
        "Baseline Responses",
        "Baseline Tickets",
    ]:
        if column not in result.columns:
            result[column] = 0.0
        result[column] = pd.to_numeric(result[column], errors="coerce").fillna(0)

    if "Segment Baseline Rate" not in result.columns:
        result["Segment Baseline Rate"] = np.nan

    result["Effective Baseline Rate"] = result[
        "Segment Baseline Rate"
    ].where(
        result["Segment Baseline Rate"].notna(),
        metric.baseline_rate,
    )
    total_current_responses = float(
        pd.to_numeric(result["Current_Responses"], errors="coerce")
        .fillna(0)
        .sum()
    )
    result["Response Share"] = np.where(
        total_current_responses > 0,
        result["Current_Responses"] / total_current_responses,
        np.nan,
    )
    result["Delta vs Baseline"] = (
        result["Current Rate"] - result["Effective Baseline Rate"]
    )
    result["Impact vs Baseline"] = (
        result["Response Share"] * result["Delta vs Baseline"]
    )
    result["Impact vs Target"] = result["Response Share"] * (
        result["Current Rate"] - target_rate
    )
    result["Official Impact"] = result["Impact vs Baseline"].where(
        result["Impact vs Baseline"].notna(),
        result["Impact vs Target"],
    )
    result["Impact Method"] = np.where(
        result["Impact vs Baseline"].notna(),
        "Response share x delta vs baseline",
        "Response share x delta vs target",
    )
    result["Smileys Needed"] = np.maximum(
        np.ceil(
            target_rate
            * pd.to_numeric(result["Current_Responses"], errors="coerce").fillna(0)
            - pd.to_numeric(result["Current_Positive"], errors="coerce").fillna(0)
        ),
        0,
    ).astype(int)
    result["Sample Size Classification"] = result[
        "Current_Responses"
    ].apply(sample_size_label)
    result["Dimension"] = display_label
    result["Grain"] = metric.grain
    result["Period Label"] = metric.period_label
    result["Site"] = metric.scope_name

    # For squad tables, enrich each row with its dominant Level One taxonomy.
    if segment_column == "Squad Code":
        dominant = _dominant_text_by_segment(
            current,
            segment_column="Squad Code",
            value_column="Level One",
            unknown_segment_label=unknown_label,
        )
        result = result.merge(dominant, on="Segment", how="left")
    else:
        result["Main Level One"] = ""

    result = result.rename(
        columns={
            "Segment": display_label,
            "Current_Positive": "Current Positive",
            "Current_Responses": "Current Responses",
            "Current_Tickets": "Current Tickets",
        }
    )
    ordered_columns = [
        "Site",
        "Grain",
        "Period Label",
        "Dimension",
        display_label,
        "Current Rate",
        "Effective Baseline Rate",
        "Delta vs Baseline",
        "Official Impact",
        "Impact vs Baseline",
        "Impact vs Target",
        "Current Positive",
        "Current Responses",
        "Current Tickets",
        "Response Share",
        "Non_Smiley_Count",
        "Smileys Needed",
        "Main Level One",
        "Sample Size Classification",
        "Baseline Positive",
        "Baseline Responses",
        "Baseline Tickets",
        "Impact Method",
    ]
    result = result[
        [column for column in ordered_columns if column in result.columns]
    ].sort_values(
        ["Official Impact", "Current Responses"],
        ascending=[True, False],
        na_position="last",
    )
    return result.reset_index(drop=True)


def build_site_driver_tables_for_metric(
    site_df: pd.DataFrame,
    metric: PeriodMetric,
    config: AppConfig = CONFIG,
) -> Dict[str, pd.DataFrame]:
    """Build Squad, tenure, crafter, and taxonomy driver tables for one site."""
    specs = {
        "Squad": ("Squad Code", "Squad Code", "Unknown Squad"),
        "Agent Tenure": ("Tenure Group", "Agent Tenure", "Unknown Tenure"),
        "Crafter": ("Employee Name", "Crafter", "Unknown Crafter"),
        "Level One": ("Level One", "Level One", "Unknown Taxonomy"),
    }
    tables: Dict[str, pd.DataFrame] = {}
    for key, (source_column, display_label, unknown_label) in specs.items():
        tables[key] = build_site_segment_driver_table(
            site_df=site_df,
            metric=metric,
            segment_column=source_column,
            display_label=display_label,
            unknown_label=unknown_label,
            target_rate=config.target_rate,
        )
    return tables


def build_site_report_metrics(
    df: pd.DataFrame,
    grains: Sequence[str],
    report_scope: Mapping[str, Any],
    qa_summary: pd.DataFrame,
    scrubbed_tickets: pd.DataFrame,
    grain_results: Mapping[str, GrainResult],
    config: AppConfig = CONFIG,
) -> Dict[str, SiteReport]:
    """
    Build detailed site report objects for the approved LOB-specific site list.

    Executive calculations continue to use every site that passes the selected
    LOB filters. This function deliberately limits only the detailed site pages.
    Every site narrative is calculated from that site's records only.
    """
    site_reports: Dict[str, SiteReport] = {}

    for site in config.site_detail_sites:
        site_df = df[df["Site"].eq(site)].copy()
        if site_df.empty:
            LOGGER.warning(
                "Detailed site %s has no rows after the selected business filters.",
                site,
            )
            continue

        grain_metrics: Dict[str, PeriodMetric] = {}
        squad_tables: Dict[str, pd.DataFrame] = {}
        driver_tables: Dict[str, Dict[str, pd.DataFrame]] = {}

        for grain in grains:
            overall_result = grain_results.get(grain)
            common_baseline_keys = (
                overall_result.overall.baseline_period_keys
                if overall_result is not None
                else None
            )
            metric = calculate_period_metric(
                grain=grain,
                scope_df=site_df,
                scope_name=site,
                report_scope=report_scope,
                config=config,
                baseline_period_keys=common_baseline_keys,
            )
            grain_metrics[grain] = metric
            period_df = current_period_dataframe(site_df, metric)
            squad_tables[grain] = build_segment_impact_table(
                period_df=period_df,
                segment_columns=["Site", "Squad Code"],
                target_rate=config.target_rate,
                source_impact_validation=None,
                scope_name=site,
            )
            driver_tables[grain] = build_site_driver_tables_for_metric(
                site_df=site_df,
                metric=metric,
                config=config,
            )

        # No hidden Monthly fallback. Month-end evidence exists only when
        # Monthly is one of the active report-wide grains.
        month_end_metric = grain_metrics.get("MONTHLY")

        teammate_opportunities_v540 = (
            build_teammate_coaching_opportunities_v540(
                site_df=site_df,
                site=site,
                report_scope=report_scope,
                config=config,
            )
            if getattr(config, "enable_teammate_coaching_opportunities", True)
            else pd.DataFrame()
        )

        ticket_age_population_v548 = _ticket_age_population_from_scope_v548(
            report_scope=report_scope,
            source_df=site_df,
        )
        if (
            not ticket_age_population_v548.empty
            and "Site" in ticket_age_population_v548.columns
        ):
            ticket_age_population_v548 = ticket_age_population_v548[
                ticket_age_population_v548["Site"].eq(site)
            ].copy()
        ticket_age_impact_v548 = (
            build_ticket_age_impact_table_v548(
                source_df=ticket_age_population_v548,
                scope_name=site,
                config=config,
            )
            if getattr(config, "enable_ticket_age_impact", True)
            else pd.DataFrame()
        )

        qa_attribute_population_v549 = _qa_attribute_population_from_scope_v549(
            report_scope=report_scope,
            source_df=site_df,
        )
        if (
            not qa_attribute_population_v549.empty
            and "Site" in qa_attribute_population_v549.columns
        ):
            qa_attribute_population_v549 = qa_attribute_population_v549[
                qa_attribute_population_v549["Site"].eq(site)
            ].copy()
        qa_attribute_impact_v549 = (
            build_qa_attribute_impact_table_v549(
                source_df=qa_attribute_population_v549,
                scope_name=site,
                config=config,
            )
            if getattr(config, "enable_qa_attribute_impact", True)
            else pd.DataFrame()
        )

        site_reports[site] = SiteReport(
            site=site,
            grain_metrics=grain_metrics,
            squad_tables=squad_tables,
            qa_summary=qa_summary[qa_summary["Site"].eq(site)].copy()
            if not qa_summary.empty and "Site" in qa_summary.columns
            else pd.DataFrame(),
            scrubbed_tickets=scrubbed_tickets[
                scrubbed_tickets["Site"].eq(site)
            ].copy()
            if not scrubbed_tickets.empty and "Site" in scrubbed_tickets.columns
            else pd.DataFrame(),
            driver_tables=driver_tables,
            month_end_metric=month_end_metric,
            teammate_coaching_opportunities_v540=teammate_opportunities_v540,
            ticket_age_impact_v548=ticket_age_impact_v548,
            qa_attribute_impact_v549=qa_attribute_impact_v549,
        )

    return site_reports




def weighted_primary_site_score(
    grain_results: Mapping[str, GrainResult],
    config: AppConfig = CONFIG,
) -> pd.DataFrame:
    rows: Dict[str, Dict[str, Any]] = {}

    configured_weights = {
        "DAILY": config.primary_site_weight_daily,
        "WEEKLY": config.primary_site_weight_weekly,
        "MONTHLY": config.primary_site_weight_monthly,
    }
    available_grains = list(grain_results.keys())
    available_weight_total = sum(
        configured_weights[grain] for grain in available_grains
    )
    normalized_weights = {
        grain: configured_weights[grain] / available_weight_total
        for grain in available_grains
    }

    for grain, result in grain_results.items():
        for _, row in result.site_summary.iterrows():
            site = normalize_text(row["Site"])
            if not site:
                continue
            record = rows.setdefault(
                site,
                {
                    "Site": site,
                    "Weighted Impact": 0.0,
                    "Negative Grain Count": 0,
                    "Average Response Share": [],
                    "Total Responses": 0.0,
                },
            )
            impact = float(row["Official Impact"])
            record[f"{grain} Impact"] = impact
            record[f"{grain} Rate"] = float(row["Smiley Rate"])
            record[f"{grain} Responses"] = float(row["Responses"])
            record["Weighted Impact"] += normalized_weights[grain] * impact
            record["Negative Grain Count"] += int(impact < 0)
            record["Average Response Share"].append(float(row["Response Share"]))
            record["Total Responses"] += float(row["Responses"])

    output_rows = []
    for site, record in rows.items():
        shares = record.pop("Average Response Share")
        record["Average Response Share"] = (
            float(np.mean(shares)) if shares else 0.0
        )
        # Persistence adjustment is deliberately small and only breaks close ties.
        record["Priority Score"] = (
            record["Weighted Impact"]
            - record["Negative Grain Count"] * 0.0005
            - record["Average Response Share"] * 0.0001
        )
        output_rows.append(record)

    if not output_rows:
        return pd.DataFrame()
    return pd.DataFrame(output_rows).sort_values(
        ["Priority Score", "Total Responses"],
        ascending=[True, False],
    ).reset_index(drop=True)


def identify_primary_site(
    grain_results: Mapping[str, GrainResult],
    config: AppConfig = CONFIG,
) -> Tuple[str, pd.DataFrame]:
    ranking = weighted_primary_site_score(grain_results, config=config)
    if ranking.empty:
        return "", ranking
    return normalize_text(ranking.iloc[0]["Site"]), ranking


def identify_grain_winner(result: GrainResult) -> Optional[pd.Series]:
    if result.site_summary.empty:
        return None
    ranked = result.site_summary.sort_values(
        ["Official Impact", "Smiley Rate", "Responses"],
        ascending=[False, False, False],
    )
    return ranked.iloc[0]


def identify_monthly_anchor(
    monthly_result: Optional[GrainResult],
    full_df: pd.DataFrame,
    report_scope: Mapping[str, Any],
) -> Optional[pd.Series]:
    if monthly_result is None or monthly_result.site_summary.empty:
        return None

    site_table = monthly_result.site_summary.copy()
    monthly_history = aggregate_by_month(full_df)
    reference_month = report_scope["reference_month_start"]
    prior_months = monthly_history[
        monthly_history["Month Start"].lt(reference_month)
    ]["Month Start"].tail(3)

    stability_rows = []
    for site in site_table["Site"]:
        site_hist = aggregate_by_month(
            full_df[
                full_df["Site"].eq(site)
                & full_df["Month Start"].isin(prior_months)
            ]
        )
        std = (
            float(site_hist["Actual Rate"].std(ddof=0))
            if len(site_hist) > 1
            else 0.0
        )
        stability_rows.append({"Site": site, "Recent Std": std})

    stability = pd.DataFrame(stability_rows)
    site_table = site_table.merge(stability, on="Site", how="left")
    max_share = max(site_table["Response Share"].max(), 1e-9)
    site_table["Anchor Score"] = (
        0.65 * site_table["Response Share"] / max_share
        + 0.25 * site_table["Smiley Rate"].fillna(0)
        - 0.10 * site_table["Recent Std"].fillna(0)
    )
    return site_table.sort_values(
        ["Anchor Score", "Responses"],
        ascending=[False, False],
    ).iloc[0]


def top_squads(
    squad_table: pd.DataFrame,
    direction: str,
    limit: int,
    minimum_responses: int = 1,
) -> pd.DataFrame:
    if squad_table is None or squad_table.empty:
        return pd.DataFrame()
    eligible = squad_table[
        squad_table["Responses"].ge(minimum_responses)
        & squad_table["Squad Code"].astype(str).str.strip().ne("")
    ].copy()
    if direction == "positive":
        return eligible.sort_values(
            ["Official Impact", "Smiley Rate", "Responses"],
            ascending=[False, False, False],
        ).head(limit)
    return eligible.sort_values(
        ["Official Impact", "Smiley Rate", "Responses"],
        ascending=[True, True, False],
    ).head(limit)


def combined_underperforming_squads(
    primary_site: str,
    grain_results: Mapping[str, GrainResult],
    limit: int,
    config: AppConfig = CONFIG,
) -> pd.DataFrame:
    rows: List[pd.DataFrame] = []
    grain_weights = {
        "DAILY": config.primary_site_weight_daily,
        "WEEKLY": config.primary_site_weight_weekly,
        "MONTHLY": config.primary_site_weight_monthly,
    }
    for grain, result in grain_results.items():
        if result.squad_summary.empty:
            continue
        subset = result.squad_summary[
            result.squad_summary["Site"].eq(primary_site)
        ].copy()
        if subset.empty:
            continue
        subset["Weighted Impact Contribution"] = (
            subset["Official Impact"] * grain_weights[grain]
        )
        rows.append(subset)

    if not rows:
        return pd.DataFrame()

    combined = pd.concat(rows, ignore_index=True)
    grouped = (
        combined.groupby(["Site", "Squad Code"], dropna=False)
        .agg(
            Weighted_Impact=("Weighted Impact Contribution", "sum"),
            Worst_Rate=("Smiley Rate", "min"),
            Total_Responses=("Responses", "sum"),
            Negative_Grains=("Official Impact", lambda s: int((s < 0).sum())),
        )
        .reset_index()
    )
    return grouped.sort_values(
        ["Weighted_Impact", "Negative_Grains", "Total_Responses"],
        ascending=[True, False, False],
    ).head(limit)



