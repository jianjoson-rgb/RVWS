def build_selected_grain_sites_overview_v570(
    filtered_df: pd.DataFrame,
    grain_result: GrainResult,
    output_path: str,
    config: AppConfig = CONFIG,
) -> str:
    """
    One-grain four-site overview used when the Grain control is not ALL GRAINS.
    """
    grain = grain_result.grain
    frame = _build_all_sites_rolling_frame(
        filtered_df,
        grain_result.overall,
        grain,
        config,
    )
    allowed = [
        site
        for site in config.rolling_overview_allowed_sites
        if site in {"ARN", "HTW", "MTQ", "PHX"}
    ]

    fig, axes = plt.subplots(
        1,
        len(allowed),
        figsize=(18, 4.8),
        sharey=True,
    )
    if len(allowed) == 1:
        axes = [axes]

    periods = (
        frame[
            ["Period Index", "Period Label", "LOB Smiley Rate"]
        ]
        .drop_duplicates("Period Index")
        .sort_values("Period Index")
        if not frame.empty
        else pd.DataFrame()
    )

    for ax, site in zip(axes, allowed):
        if frame.empty or periods.empty:
            ax.text(0.5, 0.5, "No data", ha="center", va="center")
            ax.set_axis_off()
            continue

        site_frame = (
            frame[frame["Site"].eq(site)]
            .set_index("Period Index")
            .reindex(periods["Period Index"])
        )
        x = np.arange(len(periods))
        overall = (
            pd.to_numeric(periods["LOB Smiley Rate"], errors="coerce")
            .to_numpy(dtype=float)
            * 100
        )
        site_values = (
            pd.to_numeric(site_frame["Smiley Rate"], errors="coerce")
            .to_numpy(dtype=float)
            * 100
        )

        ax.plot(
            x,
            overall,
            linestyle=(0, (4, 3)),
            linewidth=1.3,
            color="#1F2937",
            label="Overall",
        )
        ax.plot(
            x,
            site_values,
            marker="o",
            linewidth=2.0,
            label=site,
        )
        ax.axhline(
            config.target_rate * 100,
            linestyle=(0, (5, 3)),
            linewidth=1.0,
            color="#2E7D32",
        )
        ax.set_title(site, fontsize=12, fontweight="bold")
        ax.set_xticks(x)
        ax.set_xticklabels(
            periods["Period Label"].astype(str).tolist(),
            rotation=38 if grain == "WEEKLY" else 0,
            ha="right" if grain == "WEEKLY" else "center",
            fontsize=7,
        )
        ax.grid(axis="y", alpha=0.25)
        ax.yaxis.set_major_formatter(
            ticker.PercentFormatter(xmax=100, decimals=0)
        )

    fig.suptitle(
        f"{grain.title()} — Site Performance vs Overall",
        fontsize=15,
        fontweight="bold",
    )
    fig.tight_layout(rect=[0, 0, 1, 0.94])
    output = Path(output_path)
    output.parent.mkdir(parents=True, exist_ok=True)
    fig.savefig(
        output,
        dpi=config.chart_dpi,
        bbox_inches="tight",
        facecolor="white",
    )
    plt.close(fig)
    return str(output)

def _report_content_date_v568(
    registered_trend_scope: Mapping[str, Any],
) -> pd.Timestamp:
    """
    Return the maximum Smiley Registered At date inside the selected report.

    The selected report population is the registered trend scope display_df,
    so Previous Month / Specific Week / Specific Day naming reflects that
    selected period rather than the latest date in the full source.
    """
    display_df = registered_trend_scope.get(
        "display_df",
        pd.DataFrame(),
    )
    if display_df is None or display_df.empty:
        raise ValueError(
            "Cannot determine report document date because the selected "
            "Smiley Registered At report population is empty."
        )

    timestamp_series = pd.to_datetime(
        display_df.get(
            "_Smiley Registered Timestamp",
            display_df.get(
                "Smiley Registered At",
                pd.Series(pd.NaT, index=display_df.index),
            ),
        ),
        errors="coerce",
    )
    max_timestamp = timestamp_series.max()

    if pd.isna(max_timestamp):
        raise ValueError(
            "Cannot determine report document date because the selected "
            "report has no valid Smiley Registered At timestamp."
        )

    return pd.Timestamp(max_timestamp).normalize()


