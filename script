def _registered_monthly_table_metrics_v567(
    population: pd.DataFrame,
    display_frame: pd.DataFrame,
    report_scope: Mapping[str, Any],
) -> pd.DataFrame:
    """
    Build monthly table-only values from Smiley Registered At dates.

    Previous completed months use their full calendar month. The selected
    reference month is capped at the same monthly data-through date used by the
    Smiley Registered At trend image.
    """
    columns = [
        "_Table Month Start",
        "Table All Rated",
        "Table All Smiley Rate",
        "Table All Unhappy Rate",
        "Table Finance Rated",
        "Table Finance Smiley Rate",
        "Table Finance Unhappy Rate",
        "Table Other Rated",
        "Table Other Smiley Rate",
        "Table Other Unhappy Rate",
        "Table Finance vs Other Smiley Gap (pp)",
        "Table Finance vs Other Unhappy Gap (pp)",
    ]

    if (
        population is None
        or population.empty
        or display_frame is None
        or display_frame.empty
    ):
        return pd.DataFrame(columns=columns)

    work = population.copy()
    if "Date" not in work.columns:
        return pd.DataFrame(columns=columns)

    work["_Table Registered Date"] = pd.to_datetime(
        work["Date"],
        errors="coerce",
    ).dt.normalize()

    reference_month_start = pd.Timestamp(
        report_scope["reference_month_start"]
    ).normalize()
    monthly_data_through = pd.Timestamp(
        report_scope.get(
            "monthly_data_through",
            report_scope["data_through"],
        )
    ).normalize()

    records: List[Dict[str, Any]] = []
    for _, display_row in display_frame.iterrows():
        label = normalize_text(display_row.get("Month", ""))
        clean_label = re.sub(
            r"\s*\(partial\)\s*$",
            "",
            label,
            flags=re.IGNORECASE,
        )
        month_start_value = pd.to_datetime(
            clean_label,
            format="%b %Y",
            errors="coerce",
        )
        if pd.isna(month_start_value):
            month_start_value = pd.to_datetime(
                display_row.get("Month Start"),
                errors="coerce",
            )
        if pd.isna(month_start_value):
            continue

        month_start_value = pd.Timestamp(
            month_start_value
        ).normalize().replace(day=1)

        month_end_value = month_end(
            month_start_value
        )
        if month_start_value == reference_month_start:
            month_end_value = min(
                month_end_value,
                monthly_data_through,
            )

        subset = work[
            work["_Table Registered Date"].between(
                month_start_value,
                month_end_value,
                inclusive="both",
            )
        ].copy()

        metrics = _authoritative_population_metrics_v565(
            subset
        )
        metrics["_Table Month Start"] = (
            month_start_value
        )
        records.append(metrics)

    if not records:
        return pd.DataFrame(columns=columns)

    return pd.DataFrame(records).reindex(
        columns=columns
    )


def _registered_table_context_v567(
    scope_analysis: FinanceQAScopeAnalysis,
    monthly_view: bool = False,
) -> str:
    """
    Context used by timeframe table images only.

    No UTC suffix is shown because Smiley Registered At is consumed exactly as
    supplied by the source.
    """
    current_start = getattr(
        scope_analysis,
        "table_current_pattern_start",
        getattr(scope_analysis, "current_pattern_start", pd.NaT),
    )
    current_end = getattr(
        scope_analysis,
        "table_current_pattern_end",
        getattr(scope_analysis, "current_pattern_end", pd.NaT),
    )
    previous_start = getattr(
        scope_analysis,
        "table_previous_pattern_start",
        getattr(scope_analysis, "previous_pattern_start", pd.NaT),
    )
    previous_end = getattr(
        scope_analysis,
        "table_previous_pattern_end",
        getattr(scope_analysis, "previous_pattern_end", pd.NaT),
    )
    period_type = getattr(
        scope_analysis,
        "table_pattern_period_type",
        getattr(scope_analysis, "pattern_period_type", ""),
    )

    current_label = _window_label_v550(
        current_start,
        current_end,
        period_type=period_type,
        include_utc=False,
    )
    previous_label = _window_label_v550(
        previous_start,
        previous_end,
        period_type=period_type,
        include_utc=False,
    )

    prefix = "Rolling 4 months | " if monthly_view else ""
    return (
        f"{prefix}Analyzed: {current_label} | "
        f"Compared with: {previous_label}"
    )


def _align_timeframe_tables_to_smiley_registered_v567(
    scope_analyses: Mapping[str, FinanceQAScopeAnalysis],
    registered_df: pd.DataFrame,
    registered_report_scope: Mapping[str, Any],
    config: AppConfig = CONFIG,
) -> None:
    """
    Replace only the Table * fields used by timeframe tables.

    Existing Finance/QA analysis columns and narratives are intentionally left
    unchanged.
    """
    if not scope_analyses or registered_df is None or registered_df.empty:
        return

    (
        previous_start,
        previous_end,
        previous_label,
    ) = _registered_pattern_comparison_window_v567(
        registered_report_scope
    )

    current_start = pd.Timestamp(
        registered_report_scope["pattern_start"]
    ).normalize()
    current_end = pd.Timestamp(
        registered_report_scope["pattern_end"]
    ).normalize()

    normalized_sites = (
        registered_df["Site"].map(normalize_text).str.upper()
        if "Site" in registered_df.columns
        else pd.Series("", index=registered_df.index)
    )

    for scope_key, scope_analysis in scope_analyses.items():
        if scope_key == "OVERALL":
            scope_source = registered_df.copy()
        else:
            scope_source = registered_df[
                normalized_sites.eq(
                    normalize_text(scope_key).upper()
                )
            ].copy()

        if scope_source.empty:
            continue

        classified = classify_finance_population(
            scope_source,
            config,
        )

        # Monthly table metrics.
        monthly_metrics = _registered_monthly_table_metrics_v567(
            classified,
            scope_analysis.monthly_trend,
            registered_report_scope,
        )
        scope_analysis.monthly_trend = (
            _attach_monthly_table_metrics_v565(
                scope_analysis.monthly_trend,
                monthly_metrics,
            )
        )

        # Current timing-table population is filtered by Smiley Registered At
        # date because Date in registered_df is exactly that normalized date.
        current_pattern = classified[
            pd.to_datetime(
                classified["Date"],
                errors="coerce",
            ).dt.normalize().between(
                current_start,
                current_end,
                inclusive="both",
            )
        ].copy()

        registered_ts = pd.to_datetime(
            current_pattern["_Smiley Registered Timestamp"],
            errors="coerce",
        )

        # Time of day.
        hours = registered_ts.dt.hour
        time_labels = pd.Series(
            "",
            index=current_pattern.index,
            dtype="object",
        )
        for start_hour, end_hour, label in (
            config.finance_qa_time_buckets_utc
        ):
            time_labels.loc[
                hours.between(start_hour, end_hour)
            ] = label
        current_pattern["UTC Time Block"] = (
            time_labels
        )

        time_metrics = _authoritative_segment_table_metrics_v565(
            current_pattern,
            "UTC Time Block",
            [
                label
                for _, _, label
                in config.finance_qa_time_buckets_utc
            ],
        )
        scope_analysis.time_of_day_summary = (
            _attach_table_metrics_v565(
                scope_analysis.time_of_day_summary,
                time_metrics,
                "UTC Time Block",
            )
        )

        # Day of week.
        current_pattern["UTC Day of Week"] = (
            registered_ts.dt.day_name()
        )
        dow_order = [
            "Monday",
            "Tuesday",
            "Wednesday",
            "Thursday",
            "Friday",
            "Saturday",
            "Sunday",
        ]
        dow_metrics = _authoritative_segment_table_metrics_v565(
            current_pattern,
            "UTC Day of Week",
            dow_order,
        )
        scope_analysis.day_of_week_summary = (
            _attach_table_metrics_v565(
                scope_analysis.day_of_week_summary,
                dow_metrics,
                "UTC Day of Week",
            )
        )

        # Day of month.
        day_values = registered_ts.dt.day
        part_labels = pd.Series(
            "",
            index=current_pattern.index,
            dtype="object",
        )
        part_labels.loc[
            day_values.between(1, 10)
        ] = "Early (1-10)"
        part_labels.loc[
            day_values.between(11, 20)
        ] = "Middle (11-20)"
        part_labels.loc[
            day_values.between(21, 31)
        ] = "Late (21-31)"
        current_pattern["Part of Month"] = (
            part_labels
        )

        dom_metrics = _authoritative_segment_table_metrics_v565(
            current_pattern,
            "Part of Month",
            [
                "Early (1-10)",
                "Middle (11-20)",
                "Late (21-31)",
            ],
        )
        scope_analysis.day_of_month_summary = (
            _attach_table_metrics_v565(
                scope_analysis.day_of_month_summary,
                dom_metrics,
                "Part of Month",
            )
        )

        # Table-image date labels only.
        scope_analysis.table_current_pattern_start = (
            current_start
        )
        scope_analysis.table_current_pattern_end = (
            current_end
        )
        scope_analysis.table_previous_pattern_start = (
            previous_start
        )
        scope_analysis.table_previous_pattern_end = (
            previous_end
        )
        scope_analysis.table_previous_pattern_label = (
            previous_label
        )
        scope_analysis.table_pattern_period_type = (
            normalize_text(
                registered_report_scope.get(
                    "period_type",
                    "",
                )
            ).upper()
        )


def _build_site_registered_trend_metrics_v567(
    site_df: pd.DataFrame,
    grains: Sequence[str],
    registered_report_scope: Mapping[str, Any],
    registered_grain_results: Mapping[str, GrainResult],
    site_name: str,
    config: AppConfig = CONFIG,
) -> Dict[str, PeriodMetric]:
    """Build chart-only site metrics from Smiley Registered At."""
    output: Dict[str, PeriodMetric] = {}
    for grain in grains:
        overall_result = registered_grain_results.get(grain)
        baseline_keys = (
            overall_result.overall.baseline_period_keys
            if overall_result is not None
            else None
        )
        output[grain] = calculate_period_metric(
            grain=grain,
            scope_df=site_df,
            scope_name=site_name,
            report_scope=registered_report_scope,
            config=config,
            baseline_period_keys=baseline_keys,
        )
    return output



