def _email_metric_site_line(
    grain: str,
    result: Optional[GrainResult],
    site: str,
) -> str:
    """Return a compact site driver statement for one grain."""
    if result is None or not site:
        return ""
    row = site_metric_row(grain, result, site)
    if row is None:
        return ""
    return (
        f"{grain.title()}: {format_pp(row.get('Official Impact'))} impact at "
        f"{format_rate(row.get('Smiley Rate'))} across "
        f"{format_int(row.get('Responses'))} responses"
    )


def _email_top_squad_names(
    result: Optional[GrainResult],
    site: str,
    direction: str,
    limit: int = 3,
) -> List[str]:
    if result is None or not site:
        return []
    rows = _top_squads_for_site_grain(
        result,
        site,
        direction,
        limit=max(1, int(limit)),
    )
    if rows.empty or "Squad Code" not in rows.columns:
        return []
    return [
        normalize_text(value)
        for value in rows["Squad Code"].tolist()
        if normalize_text(value)
    ]


def _email_plain_text_from_payload(payload: Mapping[str, Any]) -> str:
    """Render the structured email payload as copy/paste-ready plain text."""
    lines: List[str] = []
    lines.append("Executive Summary")
    lines.append("")
    for summary_line in payload.get("executive_summary", []):
        lines.append(f"• {summary_line}")
    lines.append("")
    lines.append("Key Performance Drivers & Recommended Actions")
    lines.append("")

    for section in payload.get("sections", []):
        lines.append(normalize_text(section.get("title", "")))
        for paragraph in section.get("paragraphs", []):
            paragraph = normalize_text(paragraph)
            if paragraph:
                lines.append(paragraph)
        action_heading = normalize_text(section.get("action_heading", ""))
        if action_heading:
            lines.append("")
            lines.append(action_heading)
        for bullet in section.get("actions", []):
            bullet = normalize_text(bullet)
            if bullet:
                lines.append(f"• {bullet}")
        lines.append("")

    followup = normalize_text(payload.get("followup_line", ""))
    if followup:
        lines.append(followup)
        lines.append("")

    return "\n".join(lines).strip() + "\n"


def _email_html_from_payload(payload: Mapping[str, Any]) -> str:
    """Render the structured email payload as Gmail-friendly HTML."""
    esc = html.escape
    parts: List[str] = [
        "<div style=\"font-family:Arial,Helvetica,sans-serif;"
        "font-size:14px;line-height:1.45;color:#202124;\">",
        "<p><strong>Executive Summary</strong></p>",
        "<ul>",
    ]
    for summary_line in payload.get("executive_summary", []):
        parts.append(f"<li>{esc(normalize_text(summary_line))}</li>")
    parts.extend(
        [
            "</ul>",
            "<p style=\"margin-top:18px;\"><strong>"
            "Key Performance Drivers &amp; Recommended Actions"
            "</strong></p>",
        ]
    )

    for section in payload.get("sections", []):
        title = esc(normalize_text(section.get("title", "")))
        parts.append(f"<p style=\"margin-top:16px;\"><strong>{title}</strong></p>")
        for paragraph in section.get("paragraphs", []):
            paragraph = normalize_text(paragraph)
            if paragraph:
                parts.append(f"<p>{esc(paragraph)}</p>")
        action_heading = normalize_text(section.get("action_heading", ""))
        actions = [
            normalize_text(action)
            for action in section.get("actions", [])
            if normalize_text(action)
        ]
        if action_heading:
            parts.append(f"<p><strong>{esc(action_heading)}</strong></p>")
        if actions:
            parts.append("<ul>")
            parts.extend(f"<li>{esc(action)}</li>" for action in actions)
            parts.append("</ul>")

    followup = normalize_text(payload.get("followup_line", ""))
    if followup:
        parts.append(f"<p style=\"margin-top:18px;\">{esc(followup)}</p>")
    parts.append("</div>")
    return "\n".join(parts)


def build_cross_grain_email_body(
    selection: ReportSelection,
    report_scope: Mapping[str, Any],
    grain_results: Mapping[str, GrainResult],
    primary_site: str,
    focus_squads: Sequence[str],
    monthly_anchor: Optional[pd.Series],
    qa_summary: pd.DataFrame,
    scrubbed_tickets: pd.DataFrame,
    config: AppConfig = CONFIG,
) -> Dict[str, Any]:
    """
    Build the VP-style email body across Daily, Weekly, and Monthly.

    The body intentionally mirrors the approved email structure:
    Executive Summary -> cross-timeframe Site Focus -> High Performers ->
    week-end push/closing assessment -> month-end push/closing assessment.
    The latest-date view remains in the trend and driver narrative but has no
    separate push/action block.
    """
    executive_summary = [
        executive_summary_line(grain_results[grain].overall)
        for grain in ("DAILY", "WEEKLY", "MONTHLY")
        if grain in grain_results
    ]

    monthly_line = _email_metric_site_line(
        "MONTHLY",
        grain_results.get("MONTHLY"),
        primary_site,
    )
    weekly_line = _email_metric_site_line(
        "WEEKLY",
        grain_results.get("WEEKLY"),
        primary_site,
    )
    daily_line = _email_metric_site_line(
        "DAILY",
        grain_results.get("DAILY"),
        primary_site,
    )
    driver_lines = [value for value in (monthly_line, weekly_line, daily_line) if value]

    primary_role = "Primary Cross-Timeframe Recovery Focus"
    negative_grain_count = 0
    for grain, result in grain_results.items():
        row = site_metric_row(grain, result, primary_site) if primary_site else None
        if row is not None and pd.to_numeric(
            pd.Series([row.get("Official Impact")]),
            errors="coerce",
        ).fillna(0).iloc[0] < 0:
            negative_grain_count += 1
    if primary_site and negative_grain_count == len(grain_results):
        primary_role = "Primary Drag Across All Timeframes"
    elif primary_site and negative_grain_count >= 2:
        primary_role = "Primary Drag Across Weekly and Monthly Timeframes"

    focus_paragraphs: List[str] = []
    if primary_site:
        focus_paragraphs.append(
            f"{primary_site} is the {primary_role.lower()} for the selected "
            f"{selection.lob.title()} population."
        )
        if driver_lines:
            focus_paragraphs.append(". ".join(driver_lines) + ".")
        if focus_squads:
            focus_paragraphs.append(
                f"Underperforming squads requiring review: "
                f"{_human_join(list(focus_squads)[:config.underperforming_squad_limit])}."
            )
        daily_note = daily_rebound_note(primary_site, grain_results)
        if daily_note:
            focus_paragraphs.append(daily_note)
    else:
        focus_paragraphs.append(
            "No single site produced a qualifying cross-timeframe negative impact."
        )

    daily_focus_squads = _email_top_squad_names(
        grain_results.get("DAILY"),
        primary_site,
        "negative",
        3,
    )
    weekly_focus_squads = _email_top_squad_names(
        grain_results.get("WEEKLY"),
        primary_site,
        "negative",
        3,
    )
    monthly_focus_squads = _email_top_squad_names(
        grain_results.get("MONTHLY"),
        primary_site,
        "negative",
        3,
    )
    recovery_squads = list(
        dict.fromkeys(
            [
                *daily_focus_squads,
                *weekly_focus_squads,
                *monthly_focus_squads,
                *[normalize_text(value) for value in focus_squads],
            ]
        )
    )

    focus_actions: List[str] = []
    if primary_site:
        focus_actions.append(
            f"Audit Latest-Date Risks: Review the latest non-smiley contacts for "
            f"{primary_site}, prioritizing "
            f"{_human_join(daily_focus_squads, 'the leading daily risk squads')}."
        )
        focus_actions.append(
            f"Target Cross-Timeframe Recovery: Address recurring weekly and monthly "
            f"drivers in {_human_join(recovery_squads[:5], 'the priority squads')} "
            f"while protecting meaningful response volume."
        )

    scrub_summaries: List[str] = []
    for squad in recovery_squads[: max(0, int(config.email_body_top_scrub_summaries))]:
        summary = summarize_scrubbed_squad(
            scrubbed_tickets=scrubbed_tickets,
            qa_summary=qa_summary,
            site=primary_site,
            squad=squad,
        )
        if summary and "No qualifying" not in summary:
            scrub_summaries.append(summary)
    if scrub_summaries:
        focus_actions.append(
            "Scrubbed Ticket Focus: " + " ".join(scrub_summaries)
        )

    high_performer_lines = build_high_performer_narratives(
        grain_results,
        monthly_anchor,
    )
    daily_winner = identify_grain_winner(grain_results.get("DAILY")) if grain_results.get("DAILY") else None
    weekly_winner = identify_grain_winner(grain_results.get("WEEKLY")) if grain_results.get("WEEKLY") else None
    model_sites = [
        normalize_text(row.get("Site", ""))
        for row in (daily_winner, weekly_winner, monthly_anchor)
        if row is not None and normalize_text(row.get("Site", ""))
    ]
    model_sites = list(dict.fromkeys(model_sites))

    positive_squads: List[str] = []
    if daily_winner is not None:
        positive_squads.extend(
            _email_top_squad_names(
                grain_results.get("DAILY"),
                normalize_text(daily_winner.get("Site", "")),
                "positive",
                3,
            )
        )
    if weekly_winner is not None:
        positive_squads.extend(
            _email_top_squad_names(
                grain_results.get("WEEKLY"),
                normalize_text(weekly_winner.get("Site", "")),
                "positive",
                3,
            )
        )
    positive_squads = list(dict.fromkeys(positive_squads))

    high_paragraphs = [
        (
            "Top-performing sites are providing positive momentum and offsetting "
            "part of the decline in the primary focus population."
        )
    ]
    high_paragraphs.extend(high_performer_lines)

    high_actions = [
        (
            f"Capture & Scale Best Practices: Review the validated handling and "
            f"coaching practices in "
            f"{_human_join(positive_squads[:5], 'the leading model squads')} and "
            f"replicate the relevant behaviors in "
            f"{_human_join(recovery_squads[:5], 'the priority recovery squads')}."
        ),
        (
            f"Maintain Volume Stability: Protect performance in "
            f"{_human_join(model_sites, 'the model sites')}, particularly the "
            "high-volume site that is anchoring the monthly result."
        ),
    ]

    sections: List[Dict[str, Any]] = [
        {
            "title": (
                f"1. Site Focus: {primary_site} ({primary_role})"
                if primary_site
                else "1. Site Focus: No Qualifying Primary Drag"
            ),
            "paragraphs": focus_paragraphs,
            "action_heading": (
                f"Recommended Actions for {primary_site}:"
                if primary_site
                else "Recommended Actions:"
            ),
            "actions": focus_actions,
        },
        {
            "title": (
                f"2. High Performers & Model Sites "
                f"({_human_join(model_sites)})"
                if model_sites
                else "2. High Performers & Model Sites"
            ),
            "paragraphs": high_paragraphs,
            "action_heading": "Recommended Actions for High Performers:",
            "actions": high_actions,
        },
    ]

    weekly_result = grain_results.get("WEEKLY")
    if weekly_result is not None:
        weekly_narrative = build_overall_grain_driver_narrative(
            weekly_result,
            report_scope,
            config,
        )
        sections.append(
            {
                "title": (
                    "3. Final Push for Week-End"
                    if weekly_result.overall.is_incomplete
                    else "3. Week Closing Assessment"
                ),
                "paragraphs": [weekly_narrative.get("action_body", "")],
                "action_heading": "",
                "actions": [],
            }
        )

    monthly_result = grain_results.get("MONTHLY")
    if monthly_result is not None:
        monthly_narrative = build_overall_grain_driver_narrative(
            monthly_result,
            report_scope,
            config,
        )
        sections.append(
            {
                "title": (
                    "4. Final Push for Month-End"
                    if monthly_result.overall.is_incomplete
                    else "4. Month-End Closing Assessment"
                ),
                "paragraphs": [monthly_narrative.get("action_body", "")],
                "action_heading": "",
                "actions": [],
            }
        )

    # Email subject follows the approved leadership format.
    # Daily signal = latest-day Smiley Rate minus the preceding 12-day
    # weighted baseline. Weekly and monthly period logic is intentionally
    # unchanged by this subject-line update.
    daily_result = grain_results.get("DAILY")
    daily_signal = (
        daily_result.overall.delta
        if daily_result is not None and daily_result.overall is not None
        else np.nan
    )
    daily_signal_text = (
        f"{float(daily_signal):+.2%}"
        if pd.notna(daily_signal)
        else "N/A"
    )
    subject_date = pd.Timestamp(
        report_scope["data_through"]
    ).strftime("%Y-%m-%d")
    attention_site = normalize_text(primary_site) or "N/A"

    subject = (
        f"{config.email_body_subject_prefix} {subject_date} | "
        f"Daily signal: {daily_signal_text} "
        f"(Attention: {attention_site})"
    )
    payload: Dict[str, Any] = {
        "subject": subject,
        "executive_summary": executive_summary,
        "sections": sections,
        "followup_line": (
            config.email_body_followup_line
            if config.email_body_include_followup_line
            else ""
        ),
    }
    payload["plain_text"] = _email_plain_text_from_payload(payload)
    payload["html"] = _email_html_from_payload(payload)
    return payload


