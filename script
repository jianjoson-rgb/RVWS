def _finance_topic_table_rows(
    topic_df: pd.DataFrame,
    config: AppConfig = CONFIG,
) -> List[List[str]]:
    """Render taxonomy performance with trend-aligned rolling deltas."""
    if topic_df is None or topic_df.empty:
        return []

    rows: List[List[str]] = []
    for _, row in topic_df.head(
        int(config.finance_qa_top_topics_per_level)
    ).iterrows():
        rated = int(pd.to_numeric(
            pd.Series([row.get("Rated", 0)]),
            errors="coerce",
        ).fillna(0).iloc[0])
        neutral = int(pd.to_numeric(
            pd.Series([row.get("Neutral", 0)]),
            errors="coerce",
        ).fillna(0).iloc[0])
        frownie = int(pd.to_numeric(
            pd.Series([row.get("Frownie", 0)]),
            errors="coerce",
        ).fillna(0).iloc[0])
        smiley = int(pd.to_numeric(
            pd.Series([row.get("Smiley", max(0, rated - neutral - frownie))]),
            errors="coerce",
        ).fillna(0).iloc[0])
        smiley_rate = safe_rate(smiley, rated)
        contribution = row.get("Contribution to Finance Unhappy")
        rows.append(
            [
                normalize_text(row.get("Topic", "")),
                f"{rated:,}",
                f"{neutral:,}",
                f"{frownie:,}",
                format_rate(smiley_rate),
                _format_pp_delta_v527(row.get("Smiley Rate Delta pp")),
                _format_count_delta_v527(row.get("Smiley Count Delta"), positive_good=True),
                _format_count_delta_v527(row.get("Non-Smiley Count Delta"), positive_good=False),
                format_rate(contribution),
                normalize_text(row.get("Sample Status", "")),
            ]
        )
    return rows



def build_finance_qa_comparison_chart(
    analyses: Mapping[str, FinanceQAGrainAnalysis],
    output_path: str,
    config: AppConfig = CONFIG,
) -> str:
    """Build a three-panel Finance-versus-Other QA pass-rate chart."""
    grains = [
        grain
        for grain in ["DAILY", "WEEKLY", "MONTHLY"]
        if grain in analyses
    ]
    if not grains:
        return ""

    fig, axes = plt.subplots(
        len(grains),
        1,
        figsize=(16, 4.2 * len(grains)),
        squeeze=False,
        facecolor="white",
    )

    for row_index, grain in enumerate(grains):
        ax = axes[row_index, 0]
        analysis = analyses[grain]
        qa_df = analysis.qa_attribute_summary.copy()

        if qa_df.empty:
            ax.text(
                0.5,
                0.5,
                "No QA attribute data",
                ha="center",
                va="center",
                transform=ax.transAxes,
            )
            ax.set_axis_off()
            continue

        qa_df = qa_df.iloc[::-1].reset_index(drop=True)
        y = np.arange(len(qa_df))
        bar_height = 0.34

        finance_rates = pd.to_numeric(
            qa_df["Finance Pass Rate"],
            errors="coerce",
        ).mul(100)
        other_rates = pd.to_numeric(
            qa_df["Other Pass Rate"],
            errors="coerce",
        ).mul(100)

        finance_bars = ax.barh(
            y + bar_height / 2,
            finance_rates,
            height=bar_height,
            label="Finance",
            alpha=0.88,
        )
        other_bars = ax.barh(
            y - bar_height / 2,
            other_rates,
            height=bar_height,
            label="Other",
            alpha=0.62,
        )

        for bars, values in [
            (finance_bars, finance_rates),
            (other_bars, other_rates),
        ]:
            for bar, value in zip(bars, values):
                if pd.isna(value):
                    continue
                ax.text(
                    min(float(value) + 0.8, 99.0),
                    bar.get_y() + bar.get_height() / 2,
                    f"{float(value):.1f}%",
                    ha="left",
                    va="center",
                    fontsize=8,
                )

        ax.axvline(
            config.qa_heatmap_target_rate * 100,
            linestyle="--",
            linewidth=1.1,
            label=(
                "QA Target "
                f"{format_rate(config.qa_heatmap_target_rate)}"
            ),
        )
        ax.set_xlim(0, 105)
        ax.set_yticks(y)
        ax.set_yticklabels(
            qa_df["QA Attribute"].astype(str),
            fontsize=9,
        )
        ax.xaxis.set_major_formatter(
            ticker.PercentFormatter(xmax=100, decimals=0)
        )
        ax.grid(axis="x", alpha=0.25)
        ax.set_title(
            f"{grain.title()} — {analysis.period_label}",
            loc="left",
            fontsize=13,
            fontweight="bold",
        )
        ax.spines["top"].set_visible(False)
        ax.spines["right"].set_visible(False)

    handles, labels = axes[0, 0].get_legend_handles_labels()
    fig.legend(
        handles,
        labels,
        loc="lower center",
        ncol=3,
        frameon=False,
        bbox_to_anchor=(0.5, 0.01),
    )
    fig.tight_layout(rect=[0.02, 0.05, 0.98, 0.99])

    output = Path(output_path)
    output.parent.mkdir(parents=True, exist_ok=True)
    fig.savefig(
        output,
        dpi=int(config.finance_qa_chart_dpi),
        bbox_inches="tight",
        facecolor="white",
    )
    plt.close(fig)
    return str(output)


