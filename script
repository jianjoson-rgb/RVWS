def normalize_elevate_qa_key(value) -> str:
    """
    Normalize Elevate QA text keys for safe mapping.

    Handles:
      - leading/trailing spaces
      - repeated whitespace
      - underscores and hyphens
      - case differences
      - blank/null/n/a/none/nan/unknown values
    """
    if pd.isna(value):
        return ""

    text = str(value).strip()
    text = re.sub(r"[_\-]+", " ", text)
    text = re.sub(r"\s+", " ", text).strip().casefold()

    if text in INVALID_LOOKUP_VALUES or text == "unknown":
        return ""

    return text


def normalize_elevate_opportunity_key(value) -> str:
    text = normalize_elevate_qa_key(value)
    if not text:
        return ""
    return text.replace(" ", "_")


def normalize_elevate_opportunity_binary_value(value):
    """
    Convert Elevate Opportunity level to final raw binary values.

    No Opportunity    -> 1
    Minor Opportunity -> 1
    Major Opportunity -> 0
    Blank/unknown     -> NULL_TEXT

    The source score 2 is intentionally never written to raw output.
    """
    key = normalize_elevate_opportunity_key(value)
    if not key:
        return NULL_TEXT
    return ELEVATE_OPPORTUNITY_BINARY_MAP.get(key, NULL_TEXT)


def map_elevate_qa_attribute_to_output(value) -> str:
    key = normalize_elevate_qa_key(value)
    if not key:
        return ""
    return ELEVATE_QA_ATTRIBUTE_TO_OUTPUT_COLUMN.get(key, "")


def build_elevate_qa_file_status(
    base_status,
    blank_ticket_ids,
    unmapped_attributes,
    unknown_opportunities,
):
    warnings_list = []

    if blank_ticket_ids:
        warnings_list.append(
            f"blank ticket IDs skipped: {blank_ticket_ids:,}"
        )

    if unmapped_attributes:
        warnings_list.append(
            f"unmapped attributes skipped: {unmapped_attributes:,}"
        )

    if unknown_opportunities:
        warnings_list.append(
            "unknown opportunity levels skipped: "
            f"{unknown_opportunities:,}"
        )

    if not warnings_list:
        return base_status

    return f"{base_status} with warnings: " + "; ".join(warnings_list)


def build_elevate_qa_wide_lookup(records):
    empty_df = pd.DataFrame(
        columns=["Ticket ID"] + AUDIT_OUTPUT_COLUMNS
    )

    if not records:
        return empty_df

    long_df = pd.DataFrame(records)

    if long_df.empty:
        return empty_df

    long_df["Ticket ID"] = normalize_ticket_id_series(
        long_df["Ticket ID"]
    )
    long_df = long_df[
        long_df["Ticket ID"].ne("")
        & long_df["QA Output Column"].isin(AUDIT_OUTPUT_COLUMNS)
    ].copy()

    if long_df.empty:
        return empty_df

    long_df["binary_value"] = pd.to_numeric(
        long_df["binary_value"],
        errors="coerce",
    )
    long_df = long_df[long_df["binary_value"].isin([0, 1])].copy()

    if long_df.empty:
        return empty_df

    # Same Ticket ID + attribute + same latest file date:
    # conservative score wins, so 0 overrides 1.
    same_date_df = (
        long_df.groupby(
            ["Ticket ID", "QA Output Column", "file_date"],
            as_index=False,
        )["binary_value"]
        .min()
    )

    latest_date_per_attr = same_date_df.groupby(
        ["Ticket ID", "QA Output Column"]
    )["file_date"].transform("max")

    latest_df = same_date_df[
        same_date_df["file_date"].eq(latest_date_per_attr)
    ].copy()

    wide_df = latest_df.pivot(
        index="Ticket ID",
        columns="QA Output Column",
        values="binary_value",
    ).reset_index()

    wide_df.columns.name = None

    for column in AUDIT_OUTPUT_COLUMNS:
        if column not in wide_df.columns:
            wide_df[column] = NULL_TEXT
        else:
            wide_df[column] = wide_df[column].map(
                normalize_audit_binary_value
            )

    wide_df = wide_df[["Ticket ID"] + AUDIT_OUTPUT_COLUMNS].copy()

    if wide_df["Ticket ID"].duplicated().any():
        duplicates = wide_df.loc[
            wide_df["Ticket ID"].duplicated(keep=False),
            "Ticket ID",
        ].unique().tolist()
        raise ValueError(
            "Elevate QA lookup contains duplicate Ticket IDs "
            f"after resolution: {duplicates[:20]}"
        )

    return wide_df


def build_audit_lookup(
    merchant_df,
    window_start_date,
    window_end_date,
    summary_rows,
):
    run_timestamp = datetime.now(
        ZoneInfo(TIMEZONE_NAME)
    ).strftime("%Y-%m-%d %H:%M:%S")

    needed_ticket_ids, _, _ = prepare_needed_lookup_keys(
        merchant_df
    )

    print("======================================")
    print("ELEVATE QA LOOKUP BUILD START")
    print("======================================")
    print(
        f"Needed Elevate QA Ticket IDs: "
        f"{len(needed_ticket_ids):,}"
    )
    PROGRESS.set_message("Preparing Elevate QA lookup")

    empty_df = pd.DataFrame(
        columns=["Ticket ID"] + AUDIT_OUTPUT_COLUMNS
    )

    if not needed_ticket_ids:
        return empty_df

    all_source_files = []

    for folder_number, folder_id in enumerate(
        ELEVATE_QA_SOURCE_FOLDER_IDS,
        start=1,
    ):
        PROGRESS.set_message(
            f"Listing Elevate QA folder {folder_number}"
        )
        folder_files = list_all_matching_source_files(
            drive_service=drive_service,
            folder_id=folder_id,
            filename_parser=parse_elevate_qa_filename,
        )

        for file_meta in folder_files:
            file_meta = dict(file_meta)
            file_meta["source_folder_id"] = folder_id
            file_meta["source_folder_number"] = folder_number
            all_source_files.append(file_meta)

    if not all_source_files:
        print(
            "No Elevate QA files matching "
            "'Elevate_QA_Trends_YYYY_MM-DD.csv' were found."
        )
        summary_rows.append(
            [
                "ELEVATE_QA_LOOKUP",
                run_timestamp,
                LOOKBACK_WEEKS,
                str(window_start_date),
                str(window_end_date),
                "",
                "",
                "",
                "",
                "",
                0,
                "SUCCESS: no matching Elevate QA files found",
            ]
        )
        return empty_df

    source_files = [
        file_meta
        for file_meta in all_source_files
        if (
            window_start_date
            <= file_meta["parsed_filename"]["file_date"]
            <= window_end_date
        )
    ]

    source_files.sort(
        key=lambda item: (
            item["parsed_filename"]["sort_key"],
            item.get("name", ""),
            item.get("id", ""),
        )
    )

    if not source_files:
        latest_any_file = get_latest_file_by_filename(
            all_source_files
        )
        latest_any_date = (
            latest_any_file["parsed_filename"]["file_date"]
        )

        print(
            "No Elevate QA files matched the merchant window "
            f"{window_start_date} to {window_end_date}."
        )
        summary_rows.append(
            [
                "ELEVATE_QA_LOOKUP",
                run_timestamp,
                LOOKBACK_WEEKS,
                str(window_start_date),
                str(window_end_date),
                latest_any_file.get("name", ""),
                str(latest_any_date),
                "",
                "",
                "",
                0,
                "SUCCESS: no Elevate QA files matched merchant window",
            ]
        )
        return empty_df

    latest_file = get_latest_file_by_filename(source_files)
    latest_file_name = latest_file["name"]
    reference_latest_date = latest_file["parsed_filename"][
        "file_date"
    ]

    print(
        f"Elevate QA window: "
        f"{window_start_date} to {window_end_date}"
    )
    print(f"Elevate QA files to process: {len(source_files)}")
    print(f"Elevate QA reference latest file: {latest_file_name}")
    print(f"Elevate QA reference latest date: {reference_latest_date}")

    PROGRESS.add_total(len(source_files))

    records = []
    successful_files = 0
    failed_files = 0

    for file_meta in source_files:
        file_name = file_meta["name"]
        file_date = file_meta["parsed_filename"]["file_date"]
        modified_time = file_meta.get("modifiedTime", "")
        file_size_mb = (
            round(
                int(file_meta.get("size", 0))
                / (1024 * 1024),
                2,
            )
            if file_meta.get("size")
            else ""
        )
        matched_rows = 0
        blank_ticket_ids = 0
        unmapped_attributes = 0
        unknown_opportunities = 0
        file_status = "SUCCESS"
        local_csv = None

        print("--------------------------------------------------")
        print(f"Processing Elevate QA file: {file_name}")
        print(f"  File date: {file_date}")
        PROGRESS.set_message(
            f"Processing Elevate QA file: {file_name}"
        )

        try:
            local_csv = download_drive_file_with_retry(
                drive_service,
                file_meta["id"],
                file_name,
                "elevate_qa_",
            )

            header_df = pd.read_csv(
                local_csv,
                nrows=0,
                dtype=str,
                keep_default_na=False,
                low_memory=False,
            )

            actual_columns, rename_map, _ = (
                validate_and_map_headers(
                    list(header_df.columns),
                    ELEVATE_QA_REQUIRED_COLUMNS,
                    file_name,
                )
            )

            chunk_iter = pd.read_csv(
                local_csv,
                dtype=str,
                keep_default_na=False,
                low_memory=False,
                chunksize=CSV_CHUNK_SIZE,
                usecols=actual_columns,
            )

            for chunk_number, chunk in enumerate(
                chunk_iter,
                start=1,
            ):
                chunk = chunk.rename(columns=rename_map)

                ticket_id_series = normalize_ticket_id_series(
                    chunk["Ticket link"]
                )
                blank_ticket_ids += int(ticket_id_series.eq("").sum())

                needed_mask = ticket_id_series.isin(
                    needed_ticket_ids
                )

                if not needed_mask.any():
                    if chunk_number % 5 == 0:
                        PROGRESS.set_message(
                            f"Elevate QA {file_name}: "
                            f"{matched_rows:,} matched rows"
                        )
                    continue

                candidates = pd.DataFrame(
                    {
                        "Ticket ID": ticket_id_series.loc[
                            needed_mask
                        ].values,
                        "QA Attribute": chunk.loc[
                            needed_mask,
                            "QA Attribute",
                        ].values,
                        "Opportunity level": chunk.loc[
                            needed_mask,
                            "Opportunity level",
                        ].values,
                    }
                )

                candidates["QA Output Column"] = candidates[
                    "QA Attribute"
                ].map(map_elevate_qa_attribute_to_output)

                unmapped_mask = candidates[
                    "QA Output Column"
                ].eq("")
                unmapped_attributes += int(unmapped_mask.sum())

                candidates["binary_value"] = candidates[
                    "Opportunity level"
                ].map(normalize_elevate_opportunity_binary_value)

                unknown_mask = (
                    candidates["QA Output Column"].ne("")
                    & candidates["binary_value"].eq(NULL_TEXT)
                )
                unknown_opportunities += int(unknown_mask.sum())

                valid_mask = (
                    candidates["QA Output Column"].ne("")
                    & candidates["binary_value"].isin([0, 1])
                )

                valid_records = candidates.loc[
                    valid_mask,
                    [
                        "Ticket ID",
                        "QA Output Column",
                        "binary_value",
                    ],
                ].copy()

                if not valid_records.empty:
                    valid_records["file_date"] = file_date
                    records.extend(
                        valid_records.to_dict("records")
                    )
                    matched_rows += len(valid_records)

                if chunk_number % 5 == 0:
                    PROGRESS.set_message(
                        f"Elevate QA {file_name}: "
                        f"{matched_rows:,} matched rows"
                    )

            file_status = build_elevate_qa_file_status(
                base_status="SUCCESS",
                blank_ticket_ids=blank_ticket_ids,
                unmapped_attributes=unmapped_attributes,
                unknown_opportunities=unknown_opportunities,
            )
            successful_files += 1

            print(
                f"  Matched valid Elevate QA rows: "
                f"{matched_rows:,}"
            )
            if blank_ticket_ids:
                print(
                    f"  Blank Ticket IDs skipped: "
                    f"{blank_ticket_ids:,}"
                )
            if unmapped_attributes:
                print(
                    f"  Unmapped attributes skipped: "
                    f"{unmapped_attributes:,}"
                )
            if unknown_opportunities:
                print(
                    f"  Unknown opportunity levels skipped: "
                    f"{unknown_opportunities:,}"
                )

        except Exception as exc:
            failed_files += 1
            file_status = f"FAILED: {exc}"
            print(
                f"ERROR processing Elevate QA file "
                f"{file_name}: {exc}"
            )

        finally:
            summary_rows.append(
                [
                    "ELEVATE_QA_LOOKUP",
                    run_timestamp,
                    LOOKBACK_WEEKS,
                    str(window_start_date),
                    str(window_end_date),
                    latest_file_name,
                    str(reference_latest_date),
                    file_name,
                    modified_time,
                    file_size_mb,
                    matched_rows,
                    file_status,
                ]
            )
            safe_cleanup_file(local_csv)
            PROGRESS.update(
                1,
                f"Elevate QA file complete: {file_name}",
            )

    if successful_files == 0 and failed_files:
        raise ValueError(
            "All Elevate QA files in the merchant window failed "
            "validation or processing. Check required columns: "
            f"{ELEVATE_QA_REQUIRED_COLUMNS}."
        )

    audit_df = build_elevate_qa_wide_lookup(records)

    if audit_df.empty:
        print("No Elevate QA records matched merchant Ticket IDs.")
        return empty_df

    if audit_df["Ticket ID"].duplicated().any():
        duplicates = audit_df.loc[
            audit_df["Ticket ID"].duplicated(keep=False),
            "Ticket ID",
        ].unique().tolist()
        raise ValueError(
            "Elevate QA lookup contains duplicate Ticket IDs "
            f"after final validation: {duplicates[:20]}"
        )

    print(
        f"Elevate QA matched valid source rows: "
        f"{len(records):,}"
    )
    print(
        f"Elevate QA unique matched Ticket IDs: "
        f"{len(audit_df):,}"
    )

    return audit_df


