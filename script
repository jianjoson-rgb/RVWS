def upload_report_artifacts(
    clients: GoogleClients,
    selection: ReportSelection,
    report_scope: Mapping[str, Any],
    docx_path: str,
    chart_paths: Mapping[str, str],
    email_body_docx_path: str = "",
    config: AppConfig = CONFIG,
) -> Dict[str, Any]:
    """
    Publish Google Docs and supporting chart assets without losing successful
    links when a later upload times out.

    Priority:
      1. Resolve the Shared Drive/run folder.
      2. Publish the main Google Doc.
      3. Publish the FOR EMAIL ONLY Google Doc.
      4. Upload chart assets as best-effort supporting files.

    Chart failures never erase successfully-created Google Docs links.
    """
    drive_service = clients.drive_service
    publish_warnings: List[str] = []

    destination = run_with_retry(
        lambda: validate_shared_drive_destination(
            drive_service=drive_service,
            folder_id=config.drive_parent_folder_id,
            require_shared_drive=config.require_shared_drive_destination,
        ),
        "Validate Shared Drive destination",
        max_retries=max(1, int(config.drive_max_retries)),
        base_sleep=max(1.0, float(config.drive_backoff_seconds)),
    )
    shared_drive_id = destination["shared_drive_id"]

    root_folder_id = _get_or_create_drive_folder_v571(
        drive_service=drive_service,
        folder_name=config.drive_root_folder_name,
        parent_id=destination["folder_id"],
        shared_drive_id=shared_drive_id,
        config=config,
    )

    lob_root_folder_id = _get_or_create_drive_folder_v571(
        drive_service=drive_service,
        folder_name=config.drive_lob_folder_name,
        parent_id=root_folder_id,
        shared_drive_id=shared_drive_id,
        config=config,
    )
    lob_folder_name = normalize_text(selection.lob).upper()
    lob_folder_id = _get_or_create_drive_folder_v571(
        drive_service=drive_service,
        folder_name=lob_folder_name,
        parent_id=lob_root_folder_id,
        shared_drive_id=shared_drive_id,
        config=config,
    )

    if config.create_run_subfolder:
        run_folder_name = safe_filename(
            f"{report_scope['report_label']}_{selection.grain}_{timestamp_slug()}"
        )
        run_folder_id = _get_or_create_drive_folder_v571(
            drive_service=drive_service,
            folder_name=run_folder_name,
            parent_id=lob_folder_id,
            shared_drive_id=shared_drive_id,
            config=config,
        )
    else:
        run_folder_id = lob_folder_id

    # Initialize a valid partial result immediately after the destination exists.
    result: Dict[str, Any] = {
        "destination_folder_id": destination["folder_id"],
        "destination_folder_name": destination["folder_name"],
        "root_folder_id": root_folder_id,
        "lob_root_folder_id": lob_root_folder_id,
        "lob_folder_id": lob_folder_id,
        "lob_folder_url": drive_folder_url(lob_folder_id),
        "run_folder_id": run_folder_id,
        "shared_drive_id": shared_drive_id,
        "drive_folder_url": drive_folder_url(run_folder_id),
        "google_doc_url": "",
        "chart_urls": {},
        "email_body_google_doc_url": "",
        "publish_warnings": publish_warnings,
    }

    # Main Google Doc is a required/priority artifact.
    if config.upload_google_doc:
        google_doc_name = normalize_text(
            report_scope.get("output_google_doc_name", "")
        ) or Path(docx_path).stem
        try:
            google_doc = _publish_docx_google_doc_v571(
                drive_service=drive_service,
                docx_path=docx_path,
                google_doc_name=google_doc_name,
                parent_folder_id=run_folder_id,
                config=config,
            )
            result["google_doc_url"] = google_doc.get("url", "")
        except Exception as exc:
            warning = (
                f"Main Google Docs publishing failed after retries: {exc}"
            )
            LOGGER.exception(warning)
            publish_warnings.append(warning)

    # Email-only Google Doc is published before any supporting chart assets.
    if (
        config.email_body_upload_to_shared_drive
        and config.email_body_create_google_doc
        and email_body_docx_path
    ):
        email_doc_name = normalize_text(
            report_scope.get("output_email_google_doc_name", "")
        )
        if not email_doc_name:
            email_doc_name = (
                f"{normalize_text(selection.lob).upper()} "
                "Whitepaper Report - FOR EMAIL ONLY"
            )
        try:
            email_doc = _publish_docx_google_doc_v571(
                drive_service=drive_service,
                docx_path=email_body_docx_path,
                google_doc_name=email_doc_name,
                parent_folder_id=run_folder_id,
                config=config,
            )
            result["email_body_google_doc_url"] = email_doc.get("url", "")
        except Exception as exc:
            warning = (
                f"FOR EMAIL ONLY Google Docs publishing failed after retries: {exc}"
            )
            LOGGER.exception(warning)
            publish_warnings.append(warning)

    # Supporting image assets are best effort. A slow PNG must never blank the
    # main report/document links.
    chart_urls: Dict[str, str] = {}
    for chart_name, local_path in chart_paths.items():
        if not local_path or not Path(local_path).exists():
            continue
        try:
            uploaded = _publish_binary_file_v571(
                drive_service=drive_service,
                local_path=local_path,
                drive_name=Path(local_path).name,
                parent_folder_id=run_folder_id,
                mime_type="image/png",
                config=config,
            )
            chart_urls[chart_name] = uploaded.get("url", "")
        except Exception as exc:
            warning = (
                f"Supporting chart upload skipped after retries "
                f"({chart_name}): {exc}"
            )
            LOGGER.warning(warning)
            publish_warnings.append(warning)

    result["chart_urls"] = chart_urls
    return result








