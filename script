def _email_plain_text_from_payload(payload: Mapping[str, Any]) -> str:
    """Render the v5.7.65 email payload as copy/paste-ready plain text."""
    if not payload.get("detailed_readouts"):
        return _v564_email_plain_text_from_payload(payload)

    lines: List[str] = []
    subject = normalize_text(payload.get("subject", ""))
    if subject:
        lines.append("Subject")
        lines.append(subject)
        lines.append("")

    lob = normalize_text(payload.get("lob", ""))
    lines.append(f"{lob} Executive Summary" if lob else "Executive Summary")
    lines.append("")

    banner_title = normalize_text(payload.get("banner_title", "Executive Signal Banner"))
    lines.append(banner_title)
    for bullet in payload.get("banner_bullets", []):
        text_value = _email_v565_segments_line(bullet)
        if text_value:
            lines.append(f"• {text_value}")
    lines.append("")

    overview_title = normalize_text(payload.get("overview_title", "Overall Performance & Bottom Line"))
    lines.append(overview_title)
    overview_bullets = payload.get("overview_bullets", [])
    if overview_bullets:
        for bullet in overview_bullets:
            text_value = _email_v565_segments_line(bullet)
            if text_value:
                lines.append(f"• {text_value}")
    else:
        overview_text = _email_v565_segments_line(payload.get("overview_segments", []))
        if overview_text:
            lines.append(f"• {overview_text}")
    lines.append("")

    for readout in payload.get("detailed_readouts", []):
        if not isinstance(readout, Mapping):
            continue
        chart_title = normalize_text(readout.get("chart_title", ""))
        if chart_title:
            lines.append(chart_title)
            lines.append("[Chart embedded in the FOR EMAIL ONLY Google Doc]")
            lines.append("")

        title = normalize_text(readout.get("title", "Detailed Readout"))
        period = normalize_text(readout.get("period_label", ""))
        lines.append(title if not period else f"{title} — {period}")

        for block in readout.get("blocks", []):
            label = normalize_text(block.get("label", ""))
            if label:
                lines.append(label)
            for paragraph in block.get("paragraphs", []):
                paragraph_text = _email_v565_segments_line(paragraph.get("segments", []))
                if paragraph_text:
                    lines.append(f"• {paragraph_text}")
            lines.append("")
        lines.append("")

    lines.append("Key Performance Drivers & Recommended Actions")
    lines.append("")
    for section in payload.get("sections", []):
        title = normalize_text(section.get("title", ""))
        if title:
            lines.append(title)
        for paragraph in section.get("paragraphs", []):
            paragraph_text = normalize_text(paragraph)
            if paragraph_text:
                lines.append(f"• {paragraph_text}")
        action_heading = normalize_text(section.get("action_heading", ""))
        if action_heading:
            lines.append(action_heading)
        for action in section.get("actions", []):
            action_text = _email_v557_action_text(action)
            if action_text:
                lines.append(f"• {action_text}")
            for sub_action in _email_v557_action_sub_actions(action):
                if normalize_text(sub_action):
                    lines.append(f"  ◦ {normalize_text(sub_action)}")
        lines.append("")

    followup = normalize_text(payload.get("followup_line", ""))
    if followup:
        lines.append(followup)
        lines.append("")

    return "\n".join(lines).strip() + "\n"


def _email_html_from_payload(payload: Mapping[str, Any]) -> str:
    """Render the v5.7.65 email payload as Gmail-friendly HTML."""
    if not payload.get("detailed_readouts"):
        return _v564_email_html_from_payload(payload)

    esc = html.escape
    parts: List[str] = [
        "<div style=\"font-family:Arial,Helvetica,sans-serif;font-size:14px;line-height:1.45;color:#202124;\">",
    ]
    subject = normalize_text(payload.get("subject", ""))
    if subject:
        parts.append("<p><strong>Subject</strong><br>")
        parts.append(f"{esc(subject)}</p>")

    lob = normalize_text(payload.get("lob", ""))
    parts.append(f"<h2>{esc(lob + ' Executive Summary' if lob else 'Executive Summary')}</h2>")

    parts.append(f"<h3>{esc(normalize_text(payload.get('banner_title', 'Executive Signal Banner')))}</h3>")
    banner_bullets = payload.get("banner_bullets", [])
    if banner_bullets:
        parts.append("<ul>")
        for bullet in banner_bullets:
            bullet_html = _email_html_segments_v551(bullet)
            if bullet_html:
                parts.append(f"<li>{bullet_html}</li>")
        parts.append("</ul>")

    overview_title = normalize_text(payload.get("overview_title", "Overall Performance & Bottom Line"))
    parts.append(f"<h3>{esc(overview_title)}</h3>")
    overview_bullets = payload.get("overview_bullets", [])
    if overview_bullets:
        parts.append("<ul>")
        for bullet in overview_bullets:
            bullet_html = _email_html_segments_v551(bullet)
            if bullet_html:
                parts.append(f"<li>{bullet_html}</li>")
        parts.append("</ul>")
    else:
        overview_html = _email_html_segments_v551(payload.get("overview_segments", []))
        if overview_html:
            parts.append(f"<p>{overview_html}</p>")

    for readout in payload.get("detailed_readouts", []):
        if not isinstance(readout, Mapping):
            continue
        chart_title = normalize_text(readout.get("chart_title", ""))
        if chart_title:
            parts.append(f"<h3>{esc(chart_title)}</h3>")
            parts.append("<p><em>Chart embedded in the FOR EMAIL ONLY Google Doc.</em></p>")

        title = normalize_text(readout.get("title", "Detailed Readout"))
        period = normalize_text(readout.get("period_label", ""))
        parts.append(f"<h3>{esc(title if not period else title + ' — ' + period)}</h3>")
        for block in readout.get("blocks", []):
            label = normalize_text(block.get("label", ""))
            if label:
                parts.append(f"<p><strong>{esc(label)}</strong></p>")
            paragraphs = block.get("paragraphs", [])
            if paragraphs:
                parts.append("<ul>")
                for paragraph in paragraphs:
                    segment_html = _email_html_segments_v551(paragraph.get("segments", []))
                    if segment_html:
                        parts.append(f"<li>{segment_html}</li>")
                parts.append("</ul>")

    parts.append("<h3>Key Performance Drivers &amp; Recommended Actions</h3>")
    for section in payload.get("sections", []):
        title = normalize_text(section.get("title", ""))
        if title:
            parts.append(f"<p style=\"margin-top:16px;\"><strong>{esc(title)}</strong></p>")
        section_items: List[str] = []
        for paragraph in section.get("paragraphs", []):
            paragraph_text = normalize_text(paragraph)
            if paragraph_text:
                section_items.append(f"<li>{esc(paragraph_text)}</li>")
        for action in section.get("actions", []):
            action_text = _email_v557_action_text(action)
            if not action_text:
                continue
            sub_actions = _email_v557_action_sub_actions(action)
            if sub_actions:
                nested = "".join(
                    f"<li>{esc(normalize_text(sub_action))}</li>"
                    for sub_action in sub_actions
                    if normalize_text(sub_action)
                )
                section_items.append(f"<li>{esc(action_text)}<ul>{nested}</ul></li>")
            else:
                section_items.append(f"<li>{esc(action_text)}</li>")
        if section_items:
            parts.append("<ul>")
            parts.extend(section_items)
            parts.append("</ul>")

    followup = normalize_text(payload.get("followup_line", ""))
    if followup:
        parts.append(f"<p style=\"margin-top:18px;\">{esc(followup)}</p>")
    parts.append("</div>")
    return "\n".join(parts)


def _docx_v565_add_bullet_segments(
    document: Document,
    segments: Sequence[Mapping[str, Any]],
    *,
    level: int = 0,
    font_size: float = 8.6,
) -> None:
    """Add one Gmail-friendly bullet with optional color-coded segments."""
    paragraph = None
    style_candidates = ["List Bullet 2", "List Bullet"] if level > 0 else ["List Bullet"]
    for style_name in style_candidates:
        try:
            paragraph = document.add_paragraph(style=style_name)
            break
        except Exception:
            paragraph = None
    if paragraph is None:
        paragraph = document.add_paragraph()

    try:
        paragraph.paragraph_format.left_indent = Inches(0.50 if level > 0 else 0.24)
        paragraph.paragraph_format.first_line_indent = Inches(-0.14)
        paragraph.paragraph_format.space_before = Pt(0)
        paragraph.paragraph_format.space_after = Pt(2.5)
        paragraph.paragraph_format.line_spacing = 1.08
    except Exception:
        pass

    _docx_add_email_segments_v551(paragraph, segments, font_size=font_size)


def _docx_v565_add_plain_bullet(
    document: Document,
    text_value: str,
    *,
    level: int = 0,
    font_size: float = 8.6,
) -> None:
    _docx_v565_add_bullet_segments(
        document,
        [_email_v551_seg(normalize_text(text_value))],
        level=level,
        font_size=font_size,
    )


def _docx_v565_add_section_heading(
    document: Document,
    text_value: str,
    *,
    level: int = 2,
) -> None:
    heading = document.add_heading(normalize_text(text_value), level=level)
    try:
        heading.paragraph_format.space_before = Pt(7 if level <= 2 else 5)
        heading.paragraph_format.space_after = Pt(3)
        heading.paragraph_format.keep_with_next = True
    except Exception:
        pass


def _docx_add_email_body(
    document: Document,
    payload: Mapping[str, Any],
    config: AppConfig = CONFIG,
) -> None:
    """Render the v5.7.65 FOR EMAIL ONLY doc in an email-copy-ready layout."""
    if not payload.get("detailed_readouts"):
        _v564_docx_add_email_body(document, payload, config=config)
        return

    subject = normalize_text(payload.get("subject", ""))
    if subject:
        _docx_v565_add_section_heading(document, "Subject", level=2)
        paragraph = document.add_paragraph()
        paragraph.paragraph_format.space_after = Pt(5)
        run = paragraph.add_run(subject)
        run.font.size = Pt(9.0)

    lob = normalize_text(payload.get("lob", ""))
    heading = f"{lob} Executive Summary" if lob else "Executive Summary"
    document.add_heading(heading, level=1)

    _docx_v565_add_section_heading(
        document,
        normalize_text(payload.get("banner_title", "Executive Signal Banner")),
        level=2,
    )
    for bullet in payload.get("banner_bullets", []):
        _docx_v565_add_bullet_segments(document, bullet, font_size=8.8)

    _docx_v565_add_section_heading(
        document,
        normalize_text(payload.get("overview_title", "Overall Performance & Bottom Line")),
        level=2,
    )
    overview_bullets = payload.get("overview_bullets", [])
    if overview_bullets:
        for bullet in overview_bullets:
            _docx_v565_add_bullet_segments(document, bullet, font_size=8.8)
    else:
        _docx_v565_add_bullet_segments(document, payload.get("overview_segments", []), font_size=8.8)

    for readout in payload.get("detailed_readouts", []):
        if not isinstance(readout, Mapping):
            continue

        _docx_v560_add_email_grain_chart(document, readout, config=config)

        title = normalize_text(readout.get("title", "Detailed Readout"))
        period = normalize_text(readout.get("period_label", ""))
        heading_text = title if not period else f"{title} — {period}"
        _docx_v565_add_section_heading(document, heading_text, level=2)

        for block in readout.get("blocks", []):
            label = normalize_text(block.get("label", ""))
            paragraphs = block.get("paragraphs", [])
            if not paragraphs:
                continue
            if label:
                _docx_v565_add_section_heading(document, label, level=3)
            for paragraph_data in paragraphs:
                _docx_v565_add_bullet_segments(
                    document,
                    paragraph_data.get("segments", []),
                    level=int(paragraph_data.get("level", 0) or 0),
                    font_size=8.45,
                )

    _docx_v565_add_section_heading(
        document,
        "Key Performance Drivers & Recommended Actions",
        level=2,
    )
    for section in payload.get("sections", []):
        title = normalize_text(section.get("title", ""))
        if title:
            _docx_v565_add_section_heading(document, title, level=3)

        for paragraph_text in section.get("paragraphs", []):
            paragraph_text = normalize_text(paragraph_text)
            if paragraph_text:
                _docx_v565_add_plain_bullet(document, paragraph_text, font_size=8.45)

        action_heading = normalize_text(section.get("action_heading", ""))
        if action_heading:
            paragraph = document.add_paragraph()
            paragraph.paragraph_format.space_after = Pt(2)
            run = paragraph.add_run(action_heading)
            run.bold = True
            run.font.size = Pt(8.6)
            run.font.color.rgb = RGBColor.from_string(EMAIL_V551_BLUE)

        for action in section.get("actions", []):
            action_text = _email_v557_action_text(action)
            if action_text:
                _docx_v565_add_plain_bullet(document, action_text, font_size=8.45)
            for sub_action in _email_v557_action_sub_actions(action):
                _docx_v565_add_plain_bullet(document, sub_action, level=1, font_size=8.25)

    followup = normalize_text(payload.get("followup_line", ""))
    if followup:
        paragraph = document.add_paragraph(followup)
        paragraph.paragraph_format.space_before = Pt(6)
        paragraph.paragraph_format.space_after = Pt(3)
        for run in paragraph.runs:
