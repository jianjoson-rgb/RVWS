    extra = [column for column in actual_columns if column and column not in expected_columns]

    summary = {
        "expected_columns": len(expected_columns),
        "actual_columns": len(actual_columns),
        "missing_columns": missing,
        "extra_columns": extra,
        "source_range": f"{config.source_tab}!{config.source_range}",
    }

    if missing:
        LOGGER.warning(
            "raw!A:AV staging validation found missing expected column(s): %s",
