def _safe_chart_rate_array(
    chart: pd.DataFrame,
    column_name: str,
) -> np.ndarray:
    """Return a float array without allowing duplicate-column DataFrames."""
    if chart is None or not isinstance(chart, pd.DataFrame) or chart.empty:
        return np.array([], dtype=float)

    if column_name not in chart.columns:
        return np.full(len(chart), np.nan, dtype=float)

    selected = chart.loc[:, column_name]
    if isinstance(selected, pd.DataFrame):
        selected = selected.iloc[:, 0]

    return pd.to_numeric(selected, errors="coerce").to_numpy(dtype=float)


def _dashboard_shared_ylim(
    metrics: Mapping[str, PeriodMetric],
    config: AppConfig = CONFIG,
) -> Tuple[float, float]:
    """Use one vertical scale across Daily, Weekly, and Monthly panels."""
    values: List[float] = [config.target_rate]

    for metric in metrics.values():
        if metric is None:
            continue

        chart = metric.chart_df
        if isinstance(chart, pd.DataFrame) and not chart.empty:
            values.extend(
                _safe_chart_rate_array(chart, "Actual Rate").tolist()
            )
            values.extend(
                _safe_chart_rate_array(chart, "Projected Rate").tolist()
            )

        values.extend(
            [
                metric.actual_rate,
                metric.baseline_rate,
                metric.projected_rate,
            ]
        )

    return _chart_ylim(values, config)


def _fill_actual_area(
    ax,
    x_values: Sequence[float],
    rates: Sequence[float],
    y_min: float,
    config: AppConfig = CONFIG,
) -> None:
    """Add the VP-style light performance area beneath the actual trend."""
    x_array = np.asarray(x_values, dtype=float)
    rate_array = np.asarray(rates, dtype=float)
    valid_mask = np.isfinite(rate_array)

    if not valid_mask.any():
        return

    ax.fill_between(
        x_array,
        y_min,
        rate_array,
        where=valid_mask,
        interpolate=True,
        color=config.chart_area_fill_color,
        alpha=config.chart_area_fill_alpha,
        linewidth=0,
        zorder=0,
    )


def _fill_gap_to_target(
    ax,
    x_values: Sequence[float],
    rates: Sequence[float],
    target_rate: float,
    config: AppConfig = CONFIG,
) -> None:
    """Shade only the portion below the Smiley target."""
    x_array = np.asarray(x_values, dtype=float)
    rate_array = np.asarray(rates, dtype=float)
    below_target = np.isfinite(rate_array) & (rate_array < target_rate)

    if not below_target.any():
        return

    ax.fill_between(
        x_array,
        rate_array,
        target_rate,
        where=below_target,
        interpolate=True,
        color=config.chart_gap_fill_color,
        alpha=config.chart_gap_fill_alpha,
        linewidth=0,
        zorder=1,
    )


