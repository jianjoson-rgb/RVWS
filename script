def _v540_timestamp_or_none(value: Any) -> Optional[pd.Timestamp]:
    """Normalize a timestamp-like value without raising for blanks or NaT."""
    if value in (None, ""):
        return None
    try:
        parsed = pd.Timestamp(value)
    except Exception:
        return None
    if pd.isna(parsed):
        return None
    return parsed.normalize()


def _v540_numeric_value(value: Any, default: float = 0.0) -> float:
    """Return one numeric value safely for report table/narrative rendering."""
    numeric = pd.to_numeric(pd.Series([value]), errors="coerce").iloc[0]
    return float(default if pd.isna(numeric) else numeric)


def _teammate_prepare_source_v540(source_df: pd.DataFrame) -> pd.DataFrame:
    """
    Prepare employee-name rows for site-only teammate coaching tables.

    The feature uses the same response-mix outcome handling as squad tables:
    Smiley / Neutral / Frownie are read from Smiley Rating first, with a
    defensive Smiley Numerator fallback only when the rating text is blank.
    """
    if source_df is None or source_df.empty:
        return pd.DataFrame()

    required = {"Date", "Site", "Employee Name", "Responses", "Smiley Numerator"}
    missing = [column for column in required if column not in source_df.columns]
    if missing:
        LOGGER.warning(
            "Teammate Coaching Opportunities skipped because required columns are missing: %s",
            ", ".join(missing),
        )
        return pd.DataFrame()

    work = source_df.copy()
    work["Date"] = pd.to_datetime(work["Date"], errors="coerce").dt.normalize()
    work["Site"] = work["Site"].map(normalize_text).replace("", "Unknown Site")
    work["Employee Name"] = work["Employee Name"].map(normalize_text)
    work["Squad Code"] = (
        work["Squad Code"].map(normalize_text).replace("", "Unknown Squad")
        if "Squad Code" in work.columns
        else "Unknown Squad"
    )
    work["Responses"] = pd.to_numeric(work["Responses"], errors="coerce").fillna(0.0)
    work["Smiley Numerator"] = pd.to_numeric(
        work["Smiley Numerator"],
        errors="coerce",
    ).fillna(0.0)
    work["_Teammate Outcome"] = _squad_outcome_series_v531(work)
    if "Week Start" not in work.columns:
        work["Week Start"] = work["Date"].apply(
            lambda value: sunday_week_start(value) if pd.notna(value) else pd.NaT
        )
    else:
        work["Week Start"] = pd.to_datetime(
            work["Week Start"],
            errors="coerce",
        ).dt.normalize()

    work = work[
        work["Date"].notna()
        & work["Week Start"].notna()
        & work["Employee Name"].ne("")
        & work["Responses"].gt(0)
        & work["_Teammate Outcome"].isin(["Smiley", "Neutral", "Frownie"])
    ].copy()

    return work


def _teammate_current_week_start_v540(
    report_scope: Mapping[str, Any],
    source_df: Optional[pd.DataFrame] = None,
) -> Optional[pd.Timestamp]:
    """Return the resolved current weekly start using the existing report scope."""
    if isinstance(report_scope, Mapping):
        resolved = _v540_timestamp_or_none(report_scope.get("weekly_report_start"))
        if resolved is not None:
            return resolved

    if source_df is not None and not source_df.empty and "Date" in source_df.columns:
        dates = pd.to_datetime(source_df["Date"], errors="coerce").dropna()
        if not dates.empty:
            latest = pd.Timestamp(dates.max()).normalize()
            if latest.dayofweek == 6:
                latest = latest - pd.Timedelta(days=1)
            return sunday_week_start(latest)

    return None


def _teammate_trend_week_starts_v540(
    current_week_start: pd.Timestamp,
    config: AppConfig = CONFIG,
) -> List[pd.Timestamp]:
    """Return displayed completed WB starts plus the optional current WB start, oldest to newest."""
    # v5.7.57: display the last 4 completed weekly periods by default, then append
    # the resolved current week as optional because it may still be running.
    completed_weeks = max(
        1,
        int(getattr(config, "teammate_coaching_trend_weeks", 4)),
    )
    current_week = pd.Timestamp(current_week_start).normalize()
    return [
        current_week - pd.Timedelta(weeks=offset)
        for offset in range(completed_weeks, -1, -1)
    ]


def _teammate_baseline_week_starts_v540(
    first_trend_week_start: pd.Timestamp,
    config: AppConfig = CONFIG,
) -> List[pd.Timestamp]:
    """Return the prior 12 completed weekly starts before the first displayed completed week."""
    baseline_weeks = max(1, int(getattr(config, "teammate_coaching_baseline_weeks", 12)))
    first_trend_week = pd.Timestamp(first_trend_week_start).normalize()
    return sorted(
        first_trend_week - pd.Timedelta(weeks=offset)
        for offset in range(1, baseline_weeks + 1)
    )


def _teammate_count_outcomes_v540(group: pd.DataFrame) -> Dict[str, float]:
    """Return standard teammate response-mix counts for an already-prepared group."""
    if group is None or group.empty:
        return {
            "Rated": 0.0,
            "Smiley": 0.0,
            "Neutral": 0.0,
            "Frownie": 0.0,
            "Non-Smiley": 0.0,
            "Smiley Rate": np.nan,
        }

    rated = float(pd.to_numeric(group["Responses"], errors="coerce").fillna(0).sum())
    smiley = float(pd.to_numeric(group["Smiley Numerator"], errors="coerce").fillna(0).sum())
    neutral = float(group["_Teammate Outcome"].eq("Neutral").sum())
    frownie = float(group["_Teammate Outcome"].eq("Frownie").sum())
    non_smiley = neutral + frownie
    return {
        "Rated": rated,
        "Smiley": smiley,
        "Neutral": neutral,
        "Frownie": frownie,
        "Non-Smiley": non_smiley,
        "Smiley Rate": safe_rate(smiley, rated),
    }




def _teammate_qa_counts_v546(group: pd.DataFrame) -> Dict[str, float]:
    """
    Return baseline QA pass-rate metrics for teammate coaching rows.

    QA uses the approved attribute convention already used by the report:
    1 = pass, 0 = fail, blank/unavailable = excluded from the denominator.
    The metric is intentionally descriptive only; it does not block teammate
    inclusion unless future config rules explicitly add a QA threshold.
    """
    if group is None or group.empty:
        return {
            "QA Audited": 0.0,
            "QA Passed": 0.0,
            "QA Failed": 0.0,
            "QA Pass Rate": np.nan,
        }

    qa_columns = [
        column for column in QA_ATTRIBUTE_COLUMNS
        if column in getattr(group, "columns", [])
    ]
    if not qa_columns:
        return {
            "QA Audited": 0.0,
            "QA Passed": 0.0,
            "QA Failed": 0.0,
            "QA Pass Rate": np.nan,
        }

    qa_frame = group[qa_columns].apply(pd.to_numeric, errors="coerce")
    valid = qa_frame.where(qa_frame.isin([0, 1]))
    audited = float(valid.notna().sum().sum())
    passed = float(valid.eq(1).sum().sum())
    failed = float(valid.eq(0).sum().sum())

    return {
        "QA Audited": audited,
        "QA Passed": passed,
        "QA Failed": failed,
        "QA Pass Rate": safe_rate(passed, audited),
    }


def _teammate_dominant_squad_v540(group: pd.DataFrame) -> str:
    """Return the highest-volume squad for a teammate in the baseline window."""
    if group is None or group.empty or "Squad Code" not in group.columns:
        return "Unknown Squad"
    squad_volume = (
        group.assign(_Volume=pd.to_numeric(group["Responses"], errors="coerce").fillna(0))
        .groupby("Squad Code", dropna=False)["_Volume"]
        .sum()
        .sort_values(ascending=False)
    )
    if squad_volume.empty:
        return "Unknown Squad"
    return normalize_text(squad_volume.index[0]) or "Unknown Squad"


def _teammate_week_cell_v540(rate: Any, delta_pp: Any) -> str:
    """Compact weekly cell: Smiley Rate with Δ vs teammate baseline."""
    rate_value = pd.to_numeric(pd.Series([rate]), errors="coerce").iloc[0]
    delta_value = pd.to_numeric(pd.Series([delta_pp]), errors="coerce").iloc[0]
    if pd.isna(rate_value):
        return "—"
    if pd.isna(delta_value):
        return f"{float(rate_value) * 100:.1f}%"
    return f"{float(rate_value) * 100:.1f}% ({float(delta_value):+.1f})"


def _teammate_focus_label_v540(
    meets_strict_rules: bool,
    current_week_delta_pp: Any,
    current_week_rate: Any,
) -> str:
    """Return a concise coaching status label for the table."""
    current_delta = pd.to_numeric(
        pd.Series([current_week_delta_pp]),
        errors="coerce",
    ).iloc[0]
    current_rate = pd.to_numeric(
        pd.Series([current_week_rate]),
        errors="coerce",
    ).iloc[0]

    if pd.isna(current_rate):
        return "Monitor"
    if pd.notna(current_delta) and float(current_delta) <= -5.0:
        return "Priority"
    if pd.notna(current_delta) and float(current_delta) >= 0.0:
        return "Recovering"
    return "Coaching" if meets_strict_rules else "Watchlist"


def build_teammate_coaching_opportunities_v540(
    site_df: pd.DataFrame,
    site: str,
    report_scope: Mapping[str, Any],
    config: AppConfig = CONFIG,
) -> pd.DataFrame:
    """
    Build the site-only Teammate Coaching Opportunities table.

    Selection benchmark:
      - Site-level 3M baseline Smiley Rate, never LOB-level.
      - Teammate baseline must be below the site baseline; no minimum gap is required.
      - Avg Monthly Vol must meet the configured minimum.
      - The teammate must have rated activity in any 2 of the last 4 completed displayed weeks.
      - Current-week activity is optional because the current week may still be running.

    Trend view:
      - Last 4 completed weeks plus optional resolved current week.
      - Headers use actual WBMMDD labels.
      - Each weekly cell is compared to the teammate's own 3M baseline.
    """
    columns = [
        "Rank",
        "Site",
        "Employee Name",
        "Squad",
        "Baseline Start",
        "Baseline End",
        "Site Baseline Smiley Rate",
        "Baseline Rated",
        "Baseline Smiley",
        "Baseline Neutral",
        "Baseline Frownie",
        "Baseline Non-Smiley",
        "Baseline Smiley Rate",
        "Baseline Avg Monthly Rated",
        "Baseline QA Audited",
        "Baseline QA Passed",
        "Baseline QA Pass Rate",
        "Gap vs Site pp",
        "Gap Below Site pp",
        "Non-Smiley Share",
        "Estimated Monthly Opportunity",
        "Completed Weeks With Activity",
        "Meets Strict Rules",
        "W-4 Label",
        "W-4 Rate",
        "W-4 Delta pp",
        "W-4 Rated",
        "W-4 Cell",
        "W-3 Label",
        "W-3 Rate",
        "W-3 Delta pp",
        "W-3 Rated",
        "W-3 Cell",
        "W-2 Label",
        "W-2 Rate",
        "W-2 Delta pp",
        "W-2 Rated",
        "W-2 Cell",
        "W-1 Label",
        "W-1 Rate",
        "W-1 Delta pp",
        "W-1 Rated",
        "W-1 Cell",
        "Current Label",
        "Current Rate",
        "Current Delta pp",
        "Current Rated",
        "Current Cell",
        "Focus",
    ]

    if not getattr(config, "enable_teammate_coaching_opportunities", True):
        return pd.DataFrame(columns=columns)

    work = _teammate_prepare_source_v540(site_df)
    if work.empty:
        return pd.DataFrame(columns=columns)

    site_label = normalize_text(site) or (
        normalize_text(work["Site"].dropna().iloc[0]) if not work.empty else "Site"
    )
    current_week_start = _teammate_current_week_start_v540(report_scope, work)
    if current_week_start is None:
        return pd.DataFrame(columns=columns)

    trend_week_starts = _teammate_trend_week_starts_v540(current_week_start, config)
    if not trend_week_starts:
        return pd.DataFrame(columns=columns)

    baseline_week_starts = _teammate_baseline_week_starts_v540(
        trend_week_starts[0],
        config,
    )
    baseline_work = work[work["Week Start"].isin(baseline_week_starts)].copy()
    if baseline_work.empty:
        LOGGER.warning(
            "Teammate Coaching Opportunities skipped for %s because no baseline rows exist before %s.",
            site_label,
            trend_week_starts[0].strftime("%Y-%m-%d"),
        )
        return pd.DataFrame(columns=columns)

    baseline_months = float(getattr(config, "teammate_coaching_baseline_months", 3.0))
    baseline_months = max(1.0, baseline_months)

    site_baseline_counts = _teammate_count_outcomes_v540(baseline_work)
    site_baseline_rate = site_baseline_counts["Smiley Rate"]
    site_non_smiley_total = float(site_baseline_counts["Non-Smiley"])
    if pd.isna(site_baseline_rate) or float(site_baseline_counts["Rated"]) <= 0:
        return pd.DataFrame(columns=columns)

    # v5.7.45: no minimum gap threshold. Employee baseline Smiley only needs
    # to be below the site 3M benchmark.
    min_avg_monthly_rated = float(
        getattr(config, "teammate_coaching_min_avg_monthly_rated", 5.0)
    )
    min_non_smiley = float(
        getattr(config, "teammate_coaching_min_baseline_non_smiley", 3)
    )
    min_non_smiley_share = float(
        getattr(config, "teammate_coaching_min_non_smiley_share", 0.02)
    )
    limit = max(1, int(getattr(config, "teammate_coaching_limit_per_site", 10)))
    completed_trend_week_count = max(0, len(trend_week_starts) - 1)
    min_active_completed_weeks = max(
        1,
        int(getattr(config, "teammate_coaching_min_active_trend_weeks", 2)),
    )
    min_active_completed_weeks = min(
        min_active_completed_weeks,
        completed_trend_week_count if completed_trend_week_count > 0 else 1,
    )

    trend_work = work[work["Week Start"].isin(trend_week_starts)].copy()
    trend_lookup: Dict[Tuple[str, pd.Timestamp], Dict[str, float]] = {}
    if not trend_work.empty:
        for (employee, week_start), group in trend_work.groupby(
            ["Employee Name", "Week Start"],
            dropna=False,
        ):
            employee_name = normalize_text(employee)
            week_key = pd.Timestamp(week_start).normalize()
            trend_lookup[(employee_name, week_key)] = _teammate_count_outcomes_v540(group)

    records: List[Dict[str, Any]] = []
    for employee, group in baseline_work.groupby("Employee Name", dropna=False):
        employee_name = normalize_text(employee)
        if not employee_name:
            continue

        counts = _teammate_count_outcomes_v540(group)
        baseline_rated = float(counts["Rated"])
        if baseline_rated <= 0:
            continue

        baseline_rate = counts["Smiley Rate"]
        if pd.isna(baseline_rate):
            continue

        avg_monthly_rated = baseline_rated / baseline_months
        gap_vs_site_pp = (float(baseline_rate) - float(site_baseline_rate)) * 100.0
        gap_below_site_pp = max(0.0, -gap_vs_site_pp)
        non_smiley = float(counts["Non-Smiley"])
        non_smiley_share = safe_rate(non_smiley, site_non_smiley_total)
        estimated_monthly_opportunity = (
            avg_monthly_rated * (gap_below_site_pp / 100.0)
        )

        weekly_fields: Dict[str, Any] = {}
        active_completed_week_count = 0
        current_rate = np.nan
        current_delta_pp = np.nan
        latest_completed_rate = np.nan
        latest_completed_delta_pp = np.nan
        latest_available_completed_rate = np.nan
        latest_available_completed_delta_pp = np.nan

        for index, week_start in enumerate(trend_week_starts):
            if index == len(trend_week_starts) - 1:
                prefix = "Current"
            else:
                prefix = f"W-{len(trend_week_starts) - 1 - index}"

            week_metrics = trend_lookup.get(
                (employee_name, pd.Timestamp(week_start).normalize()),
                {},
            )
            week_rate = week_metrics.get("Smiley Rate", np.nan)
            week_rated = float(week_metrics.get("Rated", 0.0) or 0.0)
            week_label = week_beginning_chart_label(week_start)

            weekly_fields[f"{prefix} Label"] = week_label
            weekly_fields[f"{prefix} Rate"] = np.nan
            weekly_fields[f"{prefix} Delta pp"] = np.nan
            weekly_fields[f"{prefix} Rated"] = week_rated
            weekly_fields[f"{prefix} Cell"] = "—"

            if week_rated <= 0 or pd.isna(week_rate):
                # Current week can still be running, so it is optional. Completed
                # weekly periods are non-consecutive: any configured minimum
                # number of the displayed completed weeks can qualify.
                continue

            week_delta_pp = (float(week_rate) - float(baseline_rate)) * 100.0
            weekly_fields[f"{prefix} Rate"] = week_rate
            weekly_fields[f"{prefix} Delta pp"] = week_delta_pp
            weekly_fields[f"{prefix} Rated"] = week_rated
            weekly_fields[f"{prefix} Cell"] = _teammate_week_cell_v540(
                week_rate,
                week_delta_pp,
            )

            if prefix != "Current":
                active_completed_week_count += 1
                latest_available_completed_rate = week_rate
                latest_available_completed_delta_pp = week_delta_pp

            if prefix == "W-1":
                latest_completed_rate = week_rate
                latest_completed_delta_pp = week_delta_pp
            if prefix == "Current":
                current_rate = week_rate
                current_delta_pp = week_delta_pp

        if active_completed_week_count < min_active_completed_weeks:
            continue

        if pd.isna(latest_completed_delta_pp):
            latest_completed_rate = latest_available_completed_rate
            latest_completed_delta_pp = latest_available_completed_delta_pp

        is_below_site_performance = bool(
            pd.notna(baseline_rate)
            and pd.notna(site_baseline_rate)
            and float(baseline_rate) < float(site_baseline_rate)
        )
        qa_counts = _teammate_qa_counts_v546(group)

        meets_strict_rules = bool(
            is_below_site_performance
            and avg_monthly_rated >= min_avg_monthly_rated
            and non_smiley >= min_non_smiley
            and (
                pd.isna(non_smiley_share)
                or float(non_smiley_share) >= min_non_smiley_share
                or site_non_smiley_total < max(
                    1.0,
                    min_non_smiley / max(min_non_smiley_share, 0.001),
                )
            )
        )
        if not meets_strict_rules:
            continue

        record: Dict[str, Any] = {
            "Site": site_label,
            "Employee Name": employee_name,
            "Squad": _teammate_dominant_squad_v540(group),
            "Baseline Start": min(baseline_week_starts),
            "Baseline End": max(baseline_week_starts) + pd.Timedelta(days=6),
            "Site Baseline Smiley Rate": site_baseline_rate,
            "Baseline Rated": baseline_rated,
            "Baseline Smiley": counts["Smiley"],
            "Baseline Neutral": counts["Neutral"],
            "Baseline Frownie": counts["Frownie"],
            "Baseline Non-Smiley": non_smiley,
            "Baseline Smiley Rate": baseline_rate,
            "Baseline Avg Monthly Rated": avg_monthly_rated,
            "Baseline QA Audited": qa_counts["QA Audited"],
            "Baseline QA Passed": qa_counts["QA Passed"],
            "Baseline QA Pass Rate": qa_counts["QA Pass Rate"],
            "Gap vs Site pp": gap_vs_site_pp,
            "Gap Below Site pp": gap_below_site_pp,
            "Non-Smiley Share": non_smiley_share,
            "Estimated Monthly Opportunity": estimated_monthly_opportunity,
            "Completed Weeks With Activity": active_completed_week_count,
            "Meets Strict Rules": meets_strict_rules,
            "Focus": _teammate_focus_label_v540(
                meets_strict_rules=meets_strict_rules,
                current_week_delta_pp=(
                    current_delta_pp
                    if pd.notna(current_delta_pp)
                    else latest_completed_delta_pp
                ),
                current_week_rate=(
                    current_rate
                    if pd.notna(current_rate)
                    else latest_completed_rate
                ),
            ),
        }
        record.update(weekly_fields)
        records.append(record)

    if not records:
        return pd.DataFrame(columns=columns)

    opportunities = pd.DataFrame(records)
    opportunities["_Impact Sort"] = pd.to_numeric(
        opportunities["Estimated Monthly Opportunity"],
        errors="coerce",
    ).fillna(0.0)
    opportunities["_Non-Smiley Sort"] = pd.to_numeric(
        opportunities["Baseline Non-Smiley"],
        errors="coerce",
    ).fillna(0.0)
    opportunities["_NS Share Sort"] = pd.to_numeric(
        opportunities["Non-Smiley Share"],
        errors="coerce",
    ).fillna(0.0)
    opportunities["_Volume Sort"] = pd.to_numeric(
        opportunities["Baseline Avg Monthly Rated"],
        errors="coerce",
    ).fillna(0.0)
    opportunities["_Gap Sort"] = pd.to_numeric(
        opportunities["Gap Below Site pp"],
        errors="coerce",
    ).fillna(0.0)

    opportunities = (
        opportunities.sort_values(
            [
                "_Impact Sort",
                "_Non-Smiley Sort",
                "_NS Share Sort",
                "_Volume Sort",
                "_Gap Sort",
                "Baseline Smiley Rate",
            ],
            ascending=[False, False, False, False, False, True],
            na_position="last",
        )
        .head(limit)
        .reset_index(drop=True)
    )
    opportunities["Rank"] = range(1, len(opportunities) + 1)

    for helper_col in [
        "_Impact Sort",
        "_Non-Smiley Sort",
        "_NS Share Sort",
        "_Volume Sort",
        "_Gap Sort",
    ]:
        if helper_col in opportunities.columns:
            opportunities = opportunities.drop(columns=[helper_col])

    return opportunities.reindex(columns=columns)


def _teammate_coaching_show_current_v540(
    opportunity_df: Optional[pd.DataFrame],
) -> bool:
    """Return True only when at least one selected teammate has current-week activity."""
    if opportunity_df is None or opportunity_df.empty or "Current Rated" not in opportunity_df.columns:
        return False
    current_rated = pd.to_numeric(
        opportunity_df["Current Rated"],
        errors="coerce",
    ).fillna(0.0)
    return bool(current_rated.gt(0).any())


def _teammate_completed_week_prefixes_v555(
    config: AppConfig = CONFIG,
    opportunity_df: Optional[pd.DataFrame] = None,
) -> List[str]:
    """
    Return the completed WB prefixes that should be displayed/required.

    v5.7.57 defaults this to four displayed completed weeks (W-4 through W-1).
    Inclusion only requires activity in the configured minimum number of those
    weeks, so blank weekly cells can still appear when the teammate has at least
    two active completed weeks in any combination.
    """
    completed_weeks = max(
        1,
        int(getattr(config, "teammate_coaching_trend_weeks", 4)),
    )
    prefixes = [f"W-{offset}" for offset in range(completed_weeks, 0, -1)]

    if opportunity_df is None or opportunity_df.empty:
        return prefixes

    available: List[str] = []
    first = opportunity_df.iloc[0]
    for prefix in prefixes:
        label = normalize_text(first.get(f"{prefix} Label", ""))
        cell_values = (
            opportunity_df.get(f"{prefix} Cell", pd.Series(dtype="object"))
            if f"{prefix} Cell" in opportunity_df.columns
            else pd.Series(dtype="object")
        )
        has_cell = bool(
            cell_values.map(lambda value: normalize_text(value) not in {"", "—"}).any()
        )
        if label or has_cell:
            available.append(prefix)

    return available or prefixes


def _teammate_completed_week_activity_summary_v556(
    opportunity_df: Optional[pd.DataFrame],
    config: AppConfig = CONFIG,
) -> Dict[str, Any]:
    """Summarize non-consecutive completed-week activity for teammate narratives."""
    if opportunity_df is None or opportunity_df.empty:
        return {
            "prefixes": [],
            "labels": [],
            "active_counts": pd.Series(dtype="float64"),
            "avg_active_weeks": np.nan,
            "latest_avg_rate": np.nan,
            "latest_below_count": 0,
            "latest_priority_count": 0,
            "latest_recovered_count": 0,
        }

    prefixes = _teammate_completed_week_prefixes_v555(config, opportunity_df)
    first = opportunity_df.iloc[0]
    labels = [
        normalize_text(first.get(f"{prefix} Label", "")) or prefix
        for prefix in prefixes
    ]

    active_counts: List[int] = []
    latest_rates: List[float] = []
    latest_deltas: List[float] = []

    for _, row in opportunity_df.iterrows():
        row_active_count = 0
        row_latest_rate = np.nan
        row_latest_delta = np.nan

        for prefix in prefixes:
            rated = _v540_numeric_value(row.get(f"{prefix} Rated"), default=0.0)
            rate = row.get(f"{prefix} Rate", np.nan)
            delta = row.get(f"{prefix} Delta pp", np.nan)
            if rated <= 0 or pd.isna(rate) or pd.isna(delta):
                continue

            row_active_count += 1
            row_latest_rate = float(rate)
            row_latest_delta = float(delta)

        active_counts.append(row_active_count)
        if row_active_count > 0 and pd.notna(row_latest_rate) and pd.notna(row_latest_delta):
            latest_rates.append(float(row_latest_rate))
            latest_deltas.append(float(row_latest_delta))

    active_series = pd.Series(active_counts, dtype="float64")
    latest_delta_series = pd.Series(latest_deltas, dtype="float64")
    latest_rate_series = pd.Series(latest_rates, dtype="float64")

    return {
        "prefixes": prefixes,
        "labels": labels,
        "active_counts": active_series,
        "avg_active_weeks": active_series.mean() if not active_series.empty else np.nan,
        "latest_avg_rate": latest_rate_series.mean() if not latest_rate_series.empty else np.nan,
        "latest_below_count": int(latest_delta_series.lt(0).sum()) if not latest_delta_series.empty else 0,
        "latest_priority_count": int(latest_delta_series.le(-5.0).sum()) if not latest_delta_series.empty else 0,
        "latest_recovered_count": int(latest_delta_series.ge(0).sum()) if not latest_delta_series.empty else 0,
    }


def _teammate_coaching_rows_v540(
    opportunity_df: pd.DataFrame,
    config: AppConfig = CONFIG,
    include_site: bool = False,
) -> List[List[str]]:
    """Render compact teammate coaching opportunity rows for DOCX."""
    if opportunity_df is None or opportunity_df.empty:
        return []

    show_current = _teammate_coaching_show_current_v540(opportunity_df)
    rows: List[List[str]] = []
    for _, row in opportunity_df.iterrows():
        output_row: List[str] = []
        if include_site:
            output_row.append(truncate_text(normalize_text(row.get("Site", "")), 8))

        output_row.extend(
            [
                truncate_text(normalize_text(row.get("Employee Name", "")), 28),
                truncate_text(normalize_text(row.get("Squad", "")), 18),
                f"{_v540_numeric_value(row.get('Baseline Avg Monthly Rated')):.1f}",
                format_rate(row.get("Baseline Smiley Rate")),
                format_rate(row.get("Baseline QA Pass Rate")),
                _format_pp_delta_v527(row.get("Gap vs Site pp")),
                format_rate(row.get("Non-Smiley Share")),
            ]
        )
        for prefix in _teammate_completed_week_prefixes_v555(config, opportunity_df):
            output_row.append(normalize_text(row.get(f"{prefix} Cell", "")) or "—")
        if show_current:
            output_row.append(normalize_text(row.get("Current Cell", "")) or "—")
        output_row.append(normalize_text(row.get("Focus", "")) or "Monitor")
        rows.append(output_row)
    return rows


def _teammate_coaching_headers_v540(
    opportunity_df: Optional[pd.DataFrame] = None,
    include_site: bool = False,
    config: AppConfig = CONFIG,
) -> List[str]:
    """Return compact one-table headers with actual WBMMDD labels."""
    prefixes = _teammate_completed_week_prefixes_v555(config, opportunity_df)
    week_headers = prefixes

    if opportunity_df is not None and not opportunity_df.empty:
        first = opportunity_df.iloc[0]
        labels = [
            normalize_text(first.get(f"{prefix} Label", ""))
            for prefix in prefixes
        ]
        if labels and all(labels):
            week_headers = labels
        if _teammate_coaching_show_current_v540(opportunity_df):
            current_label = normalize_text(first.get("Current Label", ""))
            week_headers.append(current_label or "Current WB")

    headers = [
        "Employee",
        "Squad",
        "Avg Monthly Vol",
        "3M Smiley",
        "3M QA",
        "Gap vs Site",
        "3M NS Share",
        *week_headers,
        "Focus",
    ]
    if include_site:
        headers.insert(0, "Site")
    return headers


def _teammate_coaching_narrative_v540(
    site: str,
    opportunity_df: pd.DataFrame,
    config: AppConfig = CONFIG,
) -> str:
    """Build a concise, performance-driven shaded callout for the site teammate table."""
    site_label = normalize_text(site) or "Site"
    min_avg_monthly_rated = float(
        getattr(config, "teammate_coaching_min_avg_monthly_rated", 5.0)
    )
    min_non_smiley = float(
        getattr(config, "teammate_coaching_min_baseline_non_smiley", 3)
    )

    completed_week_count = max(1, int(getattr(config, "teammate_coaching_trend_weeks", 4)))
    min_active_completed_weeks = max(
        1,
        int(getattr(config, "teammate_coaching_min_active_trend_weeks", 2)),
    )
    min_active_completed_weeks = min(min_active_completed_weeks, completed_week_count)

    if opportunity_df is None or opportunity_df.empty:
