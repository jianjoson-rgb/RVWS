def extract_google_id(url: str) -> str:
    patterns = [
        r"/d/([a-zA-Z0-9-_]+)",
        r"/folders/([a-zA-Z0-9-_]+)",
        r"id=([a-zA-Z0-9-_]+)",
    ]
    for pattern in patterns:
        match = re.search(pattern, str(url))
        if match:
            return match.group(1)
    raise ValueError(f"Could not extract Google ID from URL: {url}")


def normalize_header(value: str) -> str:
    return re.sub(r"\s+", " ", str(value).strip())


def canonical_header(value: str) -> str:
    return normalize_header(value).casefold()


def normalize_lookup_text(value) -> str:
    if pd.isna(value):
        return ""
    text = re.sub(r"\s+", " ", str(value).strip()).casefold()
    if text in INVALID_LOOKUP_VALUES:
        return ""
    return text


def normalize_display_text(value) -> str:
    if pd.isna(value):
        return ""
    text = re.sub(r"\s+", " ", str(value).strip())
    if text.casefold() in INVALID_LOOKUP_VALUES:
        return ""
    return text


def normalize_audit_binary_value(value):
    """
    Convert final QA binary values safely.

    Supported truthy values:
      yes, 1, 1.0, "1", "1.0"

    Supported falsy values:
      no, 0, 0.0, "0", "0.0"

    Missing, unknown, or unrecognized values return NULL_TEXT.
    Source score 2 is intentionally not accepted for raw output.
    """
    if pd.isna(value):
        return NULL_TEXT

    if isinstance(value, (int, float)) and not isinstance(value, bool):
        numeric_value = float(value)
        if numeric_value == 1.0:
            return 1
        if numeric_value == 0.0:
            return 0
        return NULL_TEXT

    text = normalize_display_text(value).casefold()

    if text in {"yes", "1", "1.0"}:
        return 1
    if text in {"no", "0", "0.0"}:
        return 0
    return NULL_TEXT


def normalize_lookup_series(series: pd.Series) -> pd.Series:
    out = series.fillna("").astype(str).str.strip()
    out = out.str.replace(r"\s+", " ", regex=True).str.casefold()
    out = out.where(~out.isin(INVALID_LOOKUP_VALUES), "")
    return out


def normalize_display_series(series: pd.Series) -> pd.Series:
    out = series.fillna("").astype(str).str.strip()
    out = out.str.replace(r"\s+", " ", regex=True)
    out = out.where(~out.str.casefold().isin(INVALID_LOOKUP_VALUES), "")
    return out


def is_usable_lookup_value(value) -> bool:
    text = normalize_display_text(value)
    return text != "" and text.casefold() not in INVALID_LOOKUP_VALUES


def normalize_no_data_output_value(value):
    """Return a cleaned value or NO_DATA_TEXT for unusable lookup output."""
    if pd.isna(value):
        return NO_DATA_TEXT

    if isinstance(value, (int, float)) and not isinstance(value, bool):
        numeric_value = float(value)
        if pd.isna(numeric_value):
            return NO_DATA_TEXT
        return int(numeric_value) if numeric_value.is_integer() else numeric_value

    text = re.sub(r"\s+", " ", str(value).strip())
    if text.casefold() in NO_DATA_LOOKUP_VALUES:
        return NO_DATA_TEXT
    return text


def normalize_contact_category_output_value(value):
    """
    Return only the Contact Category label before the first dash.

    Example:
      "General Inquiry - Can be answered using..." -> "General Inquiry"

    Blank, n/a, null, none, nan, and unusable values return NO_DATA_TEXT.
    """
    cleaned = normalize_no_data_output_value(value)
    if cleaned == NO_DATA_TEXT:
        return NO_DATA_TEXT

    text = str(cleaned).strip()
    text = re.split(r"\s+-\s+", text, maxsplit=1)[0].strip()
    if not text or text.casefold() in NO_DATA_LOOKUP_VALUES:
        return NO_DATA_TEXT
    return text


def normalize_optional_numeric_output_value(value):
    """Return int/float for usable numeric lookup values, else NO_DATA_TEXT."""
    cleaned = normalize_no_data_output_value(value)
    if cleaned == NO_DATA_TEXT:
        return NO_DATA_TEXT

    if isinstance(cleaned, (int, float)) and not isinstance(cleaned, bool):
        return cleaned

    numeric_text = str(cleaned).replace(",", "").strip()
    numeric_value = pd.to_numeric(numeric_text, errors="coerce")
    if pd.isna(numeric_value):
        return NO_DATA_TEXT

    numeric_value = float(numeric_value)
    return int(numeric_value) if numeric_value.is_integer() else numeric_value


def convert_seconds_to_minutes_output(value):
    """Convert seconds to minutes for chat__queue_duration_sec output."""
    seconds_value = normalize_optional_numeric_output_value(value)
