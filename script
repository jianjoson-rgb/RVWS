def _email_v562_teammate_consolidated_segments(
    opportunity_df: pd.DataFrame,
    config: AppConfig = CONFIG,
) -> List[Dict[str, Any]]:
    """Return the monthly-only consolidated teammate narrative as email segments."""
    if opportunity_df is None or not isinstance(opportunity_df, pd.DataFrame) or opportunity_df.empty:
        return []

    try:
        narrative = _teammate_coaching_consolidated_narrative_v546(
            opportunity_df,
            config,
        )
    except Exception as exc:
        LOGGER.warning("Could not build monthly teammate consolidated narrative for email: %s", exc)
        return []

    narrative = normalize_text(narrative)
    if not narrative or "has no consolidated rows" in narrative.lower():
        return []

    narrative = re.sub(
        r"(?i)^overall teammate coaching opportunities\s+",
        "",
        narrative,
    ).strip()

    return [
        _email_v551_seg("Monthly Teammate Coaching: ", bold=True),
        _email_v551_seg(narrative),
    ]


