def now_manila() -> pd.Timestamp:
    """Return the current timestamp in Asia/Manila."""
    return pd.Timestamp.now(tz="Asia/Manila")


def report_run_date_stamp() -> str:
    """
    Return the business run date as MMDDYY using Asia/Manila time.

    Example:
        August 6, 2026 -> 080626
    """
    return now_manila().strftime("%m%d%y")


def normalize_text(value: Any) -> str:
    if value is None or (isinstance(value, float) and np.isnan(value)):
        return ""
    text = str(value).replace("\n", " ").replace("\r", " ")
    return re.sub(r"\s+", " ", text).strip()


def clean_ticket_id(value: Any) -> str:
    value = normalize_text(value)
    return re.sub(r"\.0$", "", value)


def safe_filename(value: str) -> str:
    value = re.sub(r"[^A-Za-z0-9._-]+", "_", normalize_text(value))
    return value.strip("._") or "output"


def to_numeric_clean(series: pd.Series) -> pd.Series:
    cleaned = (
        series.astype(str)
        .str.replace(",", "", regex=False)
        .str.replace("%", "", regex=False)
        .str.strip()
        .replace({"": np.nan, "None": np.nan, "nan": np.nan, "NaT": np.nan})
    )
    return pd.to_numeric(cleaned, errors="coerce")


def normalize_rate_series(series: pd.Series) -> pd.Series:
    """
    Normalize rates to 0..1 where possible.
    Values over 1 and up to 100 are treated as percentages.
    """
    numeric = to_numeric_clean(series)
    pct_mask = numeric.gt(1) & numeric.le(100)
    numeric.loc[pct_mask] = numeric.loc[pct_mask] / 100.0
    return numeric


def safe_rate(positive: float, responses: float) -> float:
    if responses is None or pd.isna(responses) or float(responses) <= 0:
        return np.nan
    if positive is None or pd.isna(positive):
        return np.nan
    return float(positive) / float(responses)


def format_rate(value: float, decimals: int = 2) -> str:
    if value is None or pd.isna(value):
        return "N/A"
    return f"{float(value):.{decimals}%}"


def format_pp(value: float, decimals: int = 2, signed: bool = True) -> str:
    if value is None or pd.isna(value):
        return "N/A"
    pp_value = float(value) * 100.0
    if signed:
        return f"{pp_value:+.{decimals}f} pp"
    return f"{pp_value:.{decimals}f} pp"


def format_int(value: float) -> str:
    if value is None or pd.isna(value):
        return "0"
    return f"{int(round(float(value))):,}"


def truncate_text(value: Any, max_chars: int) -> str:
    text = normalize_text(value)
    if len(text) <= max_chars:
        return text
    return text[: max(0, max_chars - 1)].rstrip() + "…"


def weighted_rate(df: pd.DataFrame) -> float:
    if df is None or df.empty:
        return np.nan
    positive = pd.to_numeric(df["Smiley Numerator"], errors="coerce").fillna(0).sum()
    responses = pd.to_numeric(df["Responses"], errors="coerce").fillna(0).sum()
    return safe_rate(positive, responses)


def weighted_totals(df: pd.DataFrame) -> Tuple[float, float, float]:
    if df is None or df.empty:
        return 0.0, 0.0, np.nan
    positive = float(
        pd.to_numeric(df["Smiley Numerator"], errors="coerce").fillna(0).sum()
    )
    responses = float(
        pd.to_numeric(df["Responses"], errors="coerce").fillna(0).sum()
    )
    return positive, responses, safe_rate(positive, responses)


def delta_label(delta: float, config: AppConfig = CONFIG) -> str:
    if delta is None or pd.isna(delta):
        return "Insufficient history"
    pp = float(delta) * 100.0
    if pp >= config.strong_positive_pp:
        return "Strong"
    if pp >= config.positive_pp:
        return "Positive"
    if pp > config.slightly_down_pp:
        return "Stable"
    if pp > config.significant_concern_pp:
        return "Slightly down"
    return "Significant concern"


def sample_size_label(responses: float, config: AppConfig = CONFIG) -> str:
    n = int(round(0 if pd.isna(responses) else responses))
    if n < config.directional_n:
        return "Directional only"
    if n < 10:
        return "Low sample"
    if n < config.minimum_reportable_n:
        return "Emerging signal"
    if n < config.preferred_n:
        return "Reportable"
    return "High-confidence / high-volume"


def selected_grains(grain_selection: str) -> List[str]:
