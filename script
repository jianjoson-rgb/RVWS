def _email_table_display_header_v562(header: Any) -> str:
    """Wrap long email-image headers without changing their meaning."""
    value = normalize_text(header)
    replacements = {
        "All Smiley %": "All\nSmiley %",
        "Finance Smiley %": "Finance\nSmiley %",
        "Other Smiley %": "Other\nSmiley %",
        "All Unhappy %": "All\nUnhappy %",
        "Finance Unhappy %": "Finance\nUnhappy %",
        "Other Unhappy %": "Other\nUnhappy %",
        "Finance Rated": "Finance\nRated",
        "Other Rated": "Other\nRated",
        "All Rated": "All\nRated",
        "Fin-Other Gap pp": "Fin-Other\nGap pp",
        "UTC Time Block": "UTC Time Block",
        "UTC Day of Week": "UTC Day of Week",
        "Part of Month": "Part of Month",
    }
    return replacements.get(value, value)


def _email_table_parse_percent_v562(value: Any) -> float:
    """Parse a displayed percentage into percentage points."""
    text = normalize_text(value)
    if not text or text.upper() in {"N/A", "NA", "NONE", "-"}:
        return np.nan
    match = re.search(r"[-+]?\d+(?:\.\d+)?", text.replace(",", ""))
    if not match:
        return np.nan
    return float(match.group(0))


def _email_table_rate_style_v562(
    header: Any,
    value: Any,
) -> Tuple[str, str, str]:
    """
    Return fill, text, and weight for a Smiley/Unhappy rate cell.

    The threshold is expressed only through color:
    Smiley Rate at or above 80% is green.
    Unhappy Rate at or below 20% is green.
    No target or goal label is rendered.
    """
    header_text = normalize_text(header).upper()
    percentage = _email_table_parse_percent_v562(value)

    if pd.isna(percentage):
        return "#F3F4F6", "#6B7280", "normal"

    if "SMILEY %" in header_text:
        meets_threshold = percentage >= 80.0
    elif "UNHAPPY %" in header_text:
        meets_threshold = percentage <= 20.0
    else:
        return "#FFFFFF", "#111827", "normal"

    if meets_threshold:
        return "#E2F0D9", "#1B5E20", "bold"
    return "#FCE8E6", "#B42318", "bold"


def _email_table_column_widths_v562(
    headers: Sequence[str],
) -> List[float]:
    """Allocate more room to labels and compact numeric columns."""
    weights: List[float] = []
    for index, header in enumerate(headers):
        normalized = normalize_text(header).upper()
        if index == 0:
            weight = 1.48
        elif "GAP" in normalized:
            weight = 0.82
        elif "RATED" in normalized:
            weight = 0.78
        elif "%" in normalized:
            weight = 0.94
        else:
            weight = 0.90
        weights.append(weight)

    total = sum(weights) or 1.0
    return [weight / total for weight in weights]



def _build_docx_table_image_v560(
    title: str,
    subtitle: str,
    headers: Sequence[str],
    rows: Sequence[Sequence[Any]],
    output_path: str,
    config: AppConfig = CONFIG,
) -> str:
    """Render one executive table PNG with protected title/subtitle spacing."""
    output = Path(output_path)
    output.parent.mkdir(parents=True, exist_ok=True)

    normalized_headers = [normalize_text(header) for header in headers]
    display_headers = [
        _email_table_display_header_v562(header)
        for header in normalized_headers
    ]
    column_count = max(1, len(normalized_headers))
    visible_rows = [
        ["" if value is None else normalize_text(value) for value in row]
        for row in rows
    ]
    if not visible_rows:
        visible_rows = [["No data available"] + [""] * (column_count - 1)]

    clean_title = normalize_text(title)
    clean_subtitle = normalize_text(subtitle)
    subtitle_lines = (
        textwrap.wrap(clean_subtitle, width=108)
        if clean_subtitle else []
    )

    # Reserve a dedicated header band.  The table never enters this area,
    # which prevents the title/subtitle overlap seen in the previous images.
    header_height = 0.72 + (0.25 * max(1, len(subtitle_lines)))
    row_height = 0.48
    figure_width = max(12.2, min(15.0, 1.62 * column_count))
    figure_height = max(
        3.35,
        min(8.2, header_height + 1.05 + row_height * (len(visible_rows) + 1)),
    )

    fig = plt.figure(figsize=(figure_width, figure_height), facecolor="white")
    try:
        fig.text(
            0.035, 0.955, clean_title,
            ha="left", va="top",
            fontsize=14.2, fontweight="bold", color="#17365D",
        )
        if subtitle_lines:
            fig.text(
                0.035, 0.900,
                "\n".join(subtitle_lines),
                ha="left", va="top",
                fontsize=8.8, color="#4B5563",
                linespacing=1.18,
            )

        top_reserved = min(
            0.30,
            0.105 + 0.034 * max(1, len(subtitle_lines)),
        )
        ax = fig.add_axes([0.035, 0.055, 0.93, 1.0 - top_reserved - 0.055])
        ax.axis("off")

        table = ax.table(
            cellText=visible_rows,
            colLabels=display_headers,
            colWidths=_email_table_column_widths_v562(normalized_headers),
            loc="center",
            cellLoc="center",
            colLoc="center",
            bbox=[0.0, 0.0, 1.0, 1.0],
        )
        table.auto_set_font_size(False)
        table.set_fontsize(8.4)

        for (row_index, column_index), cell in table.get_celld().items():
            cell.set_edgecolor("#AAB4C3")
            cell.set_linewidth(0.55)
            cell.PAD = 0.050

            if row_index == 0:
                cell.set_facecolor("#17365D")
                cell.set_text_props(
                    color="white", weight="bold",
                    fontsize=8.0, va="center",
                )
                continue

            cell.set_facecolor(
                "#FFFFFF" if row_index % 2 == 1 else "#F7F9FC"
            )
            cell.set_text_props(
                color="#111827", weight="normal", va="center",
            )

            if column_index == 0:
                cell.set_facecolor("#EDF2F7")
                cell.set_text_props(
                    color="#17365D", weight="bold", ha="left",
                )
                continue

            if column_index < len(normalized_headers):
                header = normalized_headers[column_index]
                if "SMILEY %" in header.upper() or "UNHAPPY %" in header.upper():
                    fill, text_color, weight = _email_table_rate_style_v562(
                        header,
                        visible_rows[row_index - 1][column_index],
                    )
                    cell.set_facecolor(fill)
                    cell.set_text_props(color=text_color, weight=weight)

        fig.savefig(
            output,
            dpi=max(180, int(config.email_body_table_image_dpi)),
            bbox_inches="tight",
            facecolor="white",
            pad_inches=0.14,
        )
    finally:
        plt.close(fig)

    if not output.exists() or output.stat().st_size == 0:
        raise RuntimeError(f"Table image generation failed: {output}")
    return str(output)


