def _attach_table_metrics_v565(
    display_frame: pd.DataFrame,
    table_metrics: pd.DataFrame,
    key_column: str,
) -> pd.DataFrame:
    """
    Attach table-only metrics without modifying existing analysis columns.
    """
    if display_frame is None:
        display_frame = pd.DataFrame()

    output = display_frame.copy()
    table_columns = [
        column
        for column in table_metrics.columns
        if column.startswith("Table ")
    ]

    if key_column not in output.columns:
        for column in table_columns:
            output[column] = np.nan
        return output

    if (
        table_metrics is None
        or table_metrics.empty
        or key_column not in table_metrics.columns
    ):
        for column in table_columns:
            if column not in output.columns:
                output[column] = np.nan
        return output

    # Prevent duplicate Table columns if this function is called more than once.
    output = output.drop(
        columns=[
            column
            for column in output.columns
            if column.startswith("Table ")
        ],
        errors="ignore",
    )

    return output.merge(
        table_metrics[
            [key_column] + table_columns
        ],
        on=key_column,
        how="left",
        sort=False,
    )


def _attach_monthly_table_metrics_v565(
    display_frame: pd.DataFrame,
    monthly_metrics: pd.DataFrame,
) -> pd.DataFrame:
    """
    Match the displayed monthly rows to authoritative Date-based monthly data.
    """
    if display_frame is None:
        return pd.DataFrame()

    output = display_frame.copy()
    if output.empty:
        return output

    if "Month" not in output.columns:
        return output

    cleaned_labels = (
        output["Month"]
        .map(normalize_text)
        .str.replace(
            r"\s*\(partial\)\s*$",
            "",
            regex=True,
        )
    )
    output["_Table Month Start"] = pd.to_datetime(
        cleaned_labels,
        format="%b %Y",
        errors="coerce",
    )

    table_columns = [
        column
        for column in monthly_metrics.columns
        if column.startswith("Table ")
    ]

    output = output.drop(
        columns=[
            column
            for column in output.columns
            if column.startswith("Table ")
        ],
        errors="ignore",
    )

    if monthly_metrics is not None and not monthly_metrics.empty:
        output = output.merge(
            monthly_metrics[
                ["_Table Month Start"] + table_columns
            ],
            on="_Table Month Start",
            how="left",
            sort=False,
        )

    return output.drop(
        columns=["_Table Month Start"],
        errors="ignore",
    )


def _table_metric_value_v565(
    row: Mapping[str, Any],
    prefix: str,
    metric: str,
    fallback_column: str,
) -> Any:
    """
    Prefer authoritative table-only values; fall back only for legacy frames.
    """
    table_column = f"Table {prefix} {metric}"
    value = row.get(table_column, np.nan)
    numeric = pd.to_numeric(
        pd.Series([value]),
        errors="coerce",
    ).iloc[0]
    if pd.notna(numeric):
        return float(numeric)
    return row.get(fallback_column, np.nan)

def _finance_monthly_rows_v52(
