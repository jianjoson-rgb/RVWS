def build_executive_summary_table(
    selection: ReportSelection,
    report_scope: Mapping[str, Any],
    grain_results: Mapping[str, GrainResult],
    primary_site: str,
    monthly_anchor: Optional[pd.Series],
    config: AppConfig = CONFIG,
) -> pd.DataFrame:
    row: Dict[str, Any] = {
        "Reporting Month": report_scope["report_label"],
        "LOB": selection.lob,
        "Grain": selection.grain,
        "Data Through": report_scope["data_through"],
        "Primary Drag / Focus Site": primary_site,
        "Target Rate": config.target_rate,
        "Executive Population": "All sites matching selected business filters",
        "Detailed Site Pages": ", ".join(config.site_detail_sites),
        "Executive Rollup Method": "SUM all-site positive responses / SUM all-site responses",
        "Site Percentages Averaged": False,
    }

    for grain, result in grain_results.items():
        prefix = grain.title()
        metric = result.overall
        row[f"{prefix} Rate"] = metric.actual_rate
        row[f"{prefix} Positive Responses"] = metric.actual_positive
        row[f"{prefix} Responses"] = metric.actual_responses
        row[f"{prefix} Baseline"] = metric.baseline_rate
        row[f"{prefix} Baseline Positive Responses"] = metric.baseline_positive
        row[f"{prefix} Baseline Responses"] = metric.baseline_responses
        row[f"{prefix} Delta pp"] = (
            metric.delta * 100 if pd.notna(metric.delta) else np.nan
        )
        row[f"{prefix} Projection"] = metric.projected_rate
        row[f"{prefix} Projected Delta pp"] = (
            metric.projected_delta * 100
            if pd.notna(metric.projected_delta)
            else np.nan
        )
        row[f"{prefix} Projected Responses"] = metric.projected_responses
        row[f"{prefix} Classification"] = delta_label(metric.delta)
        row[f"{prefix} Baseline Period Keys"] = ", ".join(
            pd.Timestamp(value).strftime("%Y-%m-%d")
            for value in metric.baseline_period_keys
        )

        total_rows = result.executive_reconciliation[
            result.executive_reconciliation["Site"].eq("EXECUTIVE ALL SITES")
        ] if not result.executive_reconciliation.empty else pd.DataFrame()
        if not total_rows.empty:
            total = total_rows.iloc[0]
            row[f"{prefix} Detailed Sites"] = total.get(
                "Detailed Sites", ""
            )
            row[f"{prefix} Missing Detailed Sites"] = total.get(
                "Missing Detailed Sites", ""
            )
            row[f"{prefix} Reconciliation Status"] = total.get(
                "Reconciliation Status", ""
            )
            row[f"{prefix} Actual Reconciliation Difference pp"] = total.get(
                "Actual Rate Difference pp", np.nan
            )
            row[f"{prefix} Baseline Reconciliation Difference pp"] = total.get(
                "Baseline Rate Difference pp", np.nan
            )

        winner = identify_grain_winner(result)
        row[f"{prefix} Winner"] = winner["Site"] if winner is not None else ""

    row["Monthly Anchor"] = (
        monthly_anchor["Site"] if monthly_anchor is not None else ""
    )
    return pd.DataFrame([row])



def build_site_summary_output(
    grain_results: Mapping[str, GrainResult],
    config: AppConfig = CONFIG,
) -> pd.DataFrame:
    frames: List[pd.DataFrame] = []
    for grain, result in grain_results.items():
        table = result.site_summary.copy()
        if table.empty:
            continue

        reconciliation = result.executive_reconciliation.copy()
        if not reconciliation.empty:
            reconciliation = reconciliation[
                reconciliation["Site"].isin(config.site_detail_sites)
            ].copy()
            reconciliation = reconciliation[
                [
                    "Site",
                    "Actual Positive",
                    "Actual Responses",
                    "Actual Rate",
                    "Baseline Positive",
                    "Baseline Responses",
                    "Baseline Rate",
                    "Baseline Period Count",
                    "Baseline Period Keys",
                    "Current Period Has Data",
                    "Baseline Has Data",
                ]
            ]
            reconciliation["Delta vs Baseline"] = (
                reconciliation["Actual Rate"]
                - reconciliation["Baseline Rate"]
            )
            table = table.merge(
                reconciliation,
                on="Site",
                how="left",
                suffixes=("", " Reconciled"),
            )

        table = table.rename(
            columns={
                "Official Impact": "Official Impact Decimal",
                "Calculated Impact": "Calculated Impact Decimal",
                "Source Impact": "Source Impact Decimal",
                "Impact Variance": "Impact Variance Decimal",
                "Delta vs Baseline": "Delta vs Baseline Decimal",
            }
        )
        table["Official Impact pp"] = table["Official Impact Decimal"] * 100
        table["Calculated Impact pp"] = (
            table["Calculated Impact Decimal"] * 100
        )
        table["Source Impact pp"] = table["Source Impact Decimal"] * 100
        table["Impact Variance pp"] = table["Impact Variance Decimal"] * 100
        if "Delta vs Baseline Decimal" in table.columns:
            table["Delta vs Baseline pp"] = (
                table["Delta vs Baseline Decimal"] * 100
            )

        table["Executive Rollup Method"] = (
            "SUM site positive responses / SUM site responses"
        )
        frames.append(table)

    if not frames:
        return pd.DataFrame()
    return pd.concat(frames, ignore_index=True, sort=False)


def build_squad_summary_output(
    grain_results: Mapping[str, GrainResult],
    qa_summary: pd.DataFrame,
) -> pd.DataFrame:
    frames = []
    for grain, result in grain_results.items():
        table = result.squad_summary.copy()
        if table.empty:
            continue
        table["Official Impact pp"] = table["Official Impact"] * 100
        table["Calculated Impact pp"] = table["Calculated Impact"] * 100
        table["Delta vs Scope pp"] = table["Delta vs Scope"] * 100

        qa_rollup = pd.DataFrame()
        if not qa_summary.empty:
            qa_rollup = (
                qa_summary.groupby(["Site", "Squad Code"], dropna=False)
                .agg(
                    QA_Audited=("Audited", "sum"),
                    QA_Passed=("Passed", "sum"),
                    QA_Failed=("Failed", "sum"),
                )
                .reset_index()
            )
            qa_rollup["QA Pass Rate"] = np.where(
                qa_rollup["QA_Audited"].gt(0),
                qa_rollup["QA_Passed"] / qa_rollup["QA_Audited"],
                np.nan,
            )
        if not qa_rollup.empty:
            table = table.merge(
                qa_rollup,
                on=["Site", "Squad Code"],
                how="left",
            )
        frames.append(table)

    if not frames:
        return pd.DataFrame()
    return pd.concat(frames, ignore_index=True)


def build_trend_data_output(
    grain_results: Mapping[str, GrainResult],
    site_reports: Mapping[str, SiteReport],
    target_rate: float,
) -> pd.DataFrame:
    records: List[Dict[str, Any]] = []

    def append_metric(scope: str, site: str, metric: PeriodMetric) -> None:
        chart = metric.chart_df.copy()
        if chart.empty:
            return
        for _, row in chart.iterrows():
            period_value = (
                row.get("Date")
                if metric.grain == "DAILY"
                else row.get("Week Start")
                if metric.grain == "WEEKLY"
                else row.get("Month Start")
            )
            records.append(
                {
                    "Scope": scope,
                    "Site": site,
                    "Grain": metric.grain,
                    "Period": period_value,
                    "Period Label": row.get("Period Label", ""),
                    "Actual Rate": row.get("Actual Rate", np.nan),
                    "Baseline Rate": metric.baseline_rate,
                    "Target Rate": target_rate,
                    "Projected Rate": row.get("Projected Rate", np.nan),
                    "Responses": row.get("Responses", np.nan),
                    "Is Current Period": bool(row.get("Is Current", False)),
                    "Is Projected": bool(row.get("Is Projected", False)),
                    "Data Through": metric.data_through,
                }
            )

    for result in grain_results.values():
        append_metric("Overall", "", result.overall)

    for site, report in site_reports.items():
        for metric in report.grain_metrics.values():
            append_metric("Site", site, metric)

    return pd.DataFrame(records)




