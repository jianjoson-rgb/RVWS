) -> Dict[str, Any]:
    """
    Validate the new raw!A:AV staging contract without writing to the workbook.

    The validation is intentionally informational except for existing core
    required columns, which are still enforced by normalize_source_schema().
    """
    expected_columns = [
        "Ticket ID",
