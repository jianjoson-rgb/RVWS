def _v573_apply_extended_table_cf(table: Any, headers: Sequence[str]) -> None:
    """Apply section-specific red/green formatting after the generic table CF."""
    try:
        if table is None or not headers:
            return

        normalized_headers = [_v526_normalize_header_for_cf(header) for header in headers]
        for row in list(table.rows)[1:]:
            for idx, header in enumerate(normalized_headers):
                if idx >= len(row.cells):
                    continue
                cell = row.cells[idx]
                cell_text = normalize_text(cell.text)

                if header in {"smiley aftr %", "non-smiley aftr %", "smiley rate"} or (
                    "qa score" in header or "qa performance" in header
                ):
                    pct_value = _v526_parse_percent_value(cell_text)
                    if pct_value is None:
                        continue
                    _v526_apply_cell_conditional_style(
                        cell,
                        DOCX_CF_SOFT_GREEN_FILL_V526 if pct_value >= 80.0 else DOCX_CF_SOFT_RED_FILL_V526,
                        DOCX_CF_GREEN_TEXT_V526 if pct_value >= 80.0 else DOCX_CF_RED_TEXT_V526,
                    )

                elif header in {"aht gap", "queue gap", "async gap", "aftr gap"}:
                    gap_value = _v526_parse_signed_delta_value(cell_text)
                    if gap_value is None:
                        gap_value = _v573_parse_first_number(cell_text)
                    if pd.isna(gap_value):
                        continue
                    if gap_value > 0:
                        _v526_apply_cell_conditional_style(cell, DOCX_CF_SOFT_RED_FILL_V526, DOCX_CF_RED_TEXT_V526)
                    elif gap_value < 0:
                        _v526_apply_cell_conditional_style(cell, DOCX_CF_SOFT_GREEN_FILL_V526, DOCX_CF_GREEN_TEXT_V526)
                    else:
                        _v526_apply_cell_conditional_style(cell, DOCX_CF_NEUTRAL_FILL_V526, DOCX_CF_NEUTRAL_TEXT_V526, bold=False)

                elif header in {"non-smiley async share", "share", "share of non-smiley"}:
                    pct_value = _v526_parse_percent_value(cell_text)
                    if pct_value is None:
                        continue
                    if pct_value >= 50.0:
                        _v526_apply_cell_conditional_style(cell, DOCX_CF_SOFT_RED_FILL_V526, DOCX_CF_RED_TEXT_V526)
    except Exception as exc:
        LOGGER.warning("v5.7.73 extended table color formatting skipped: %s", exc)


