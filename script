        f"Interaction window: "
        f"{window_start_date} to {window_end_date}"
    )
    print(f"Interaction files to process: {len(source_files)}")
    PROGRESS.add_total(len(source_files))

    interaction_best = {}

    for file_meta in source_files:
        file_name = file_meta["name"]
        modified_time = file_meta.get("modifiedTime", "")
        file_size_mb = (
            round(
                int(file_meta.get("size", 0))
                / (1024 * 1024),
                2,
            )
            if file_meta.get("size")
            else ""
        )
        matched_rows = 0
        file_status = "SUCCESS"
        local_csv = None
        record_date = file_meta["parsed_filename"]["end_date"]

        print("--------------------------------------------------")
        print(f"Processing interaction lookup file: {file_name}")
        PROGRESS.set_message(
            f"Processing interaction file: {file_name}"
        )

        try:
            local_csv = download_drive_file_with_retry(
                drive_service,
                file_meta["id"],
                file_name,
                "interactions_csv_",
            )

            header_df = pd.read_csv(
                local_csv,
                nrows=0,
                dtype=str,
                keep_default_na=False,
                low_memory=False,
            )

            actual_columns, rename_map, present_columns = (
                validate_and_map_interaction_headers(
                    list(header_df.columns),
                    file_name,
                )
            )

            missing_metric_columns = [
                column
                for column in INTERACTION_SOURCE_TO_OUTPUT_COLUMN
                if column not in present_columns
            ]
            if missing_metric_columns:
                print(
                    "  Interaction metric columns missing in this file; "
                    "affected output values will be No data: "
                    f"{missing_metric_columns}"
                )
                if file_status == "SUCCESS":
                    file_status = (
                        "SUCCESS_WITH_MISSING_METRIC_COLUMNS"
                    )

            chunk_iter = pd.read_csv(
                local_csv,
                dtype=str,
                keep_default_na=False,
                low_memory=False,
                chunksize=CSV_CHUNK_SIZE,
                usecols=actual_columns,
            )

            for chunk_number, chunk in enumerate(
                chunk_iter,
                start=1,
            ):
                chunk = chunk.rename(columns=rename_map)

                for source_column in INTERACTION_SOURCE_TO_OUTPUT_COLUMN:
                    if source_column not in chunk.columns:
                        chunk[source_column] = ""

                ticket_id_series = normalize_ticket_id_series(
                    chunk["Ticket ID"]
                )
                match_mask = ticket_id_series.isin(needed_ticket_ids)
                matched_rows += int(match_mask.sum())

                for idx in chunk.index[match_mask]:
                    ticket_id = ticket_id_series.loc[idx]
                    existing = interaction_best.get(ticket_id)
                    if (
                        existing is None
                        or record_date >= existing["date"]
                    ):
                        interaction_best[ticket_id] = {
                            "Async_follow_up_count": (
                                normalize_optional_numeric_output_value(
                                    chunk.at[idx, "Async_follow_up_count"]
                                )
                            ),
                            "chat__answered_count": (
                                normalize_optional_numeric_output_value(
                                    chunk.at[idx, "chat__answered_count"]
                                )
                            ),
                            "chat__queue_duration_min": (
                                convert_seconds_to_minutes_output(
                                    chunk.at[idx, "chat__queue_duration_sec"]
                                )
                            ),
                            "Chat Average Handle Time": (
                                normalize_no_data_output_value(
                                    chunk.at[idx, "Chat Average Handle Time"]
                                )
                            ),
                            "date": record_date,
                        }

                if chunk_number % 5 == 0:
                    PROGRESS.set_message(
                        f"Interaction {file_name}: "
                        f"{matched_rows:,} matched rows"
                    )

        except Exception as exc:
            file_status = f"FAILED: {exc}"
            print(
                f"ERROR processing interaction lookup file "
                f"{file_name}: {exc}"
            )
            raise

        finally:
            summary_rows.append(
                [
                    "INTERACTION_LOOKUPS",
                    run_timestamp,
                    LOOKBACK_WEEKS,
                    str(window_start_date),
                    str(window_end_date),
                    latest_file_name,
                    str(reference_latest_date),
                    file_name,
                    modified_time,
                    file_size_mb,
                    matched_rows,
                    file_status,
                ]
            )
            safe_cleanup_file(local_csv)
            PROGRESS.update(
                1,
                f"Interaction file complete: {file_name}",
            )

    interaction_by_ticket_id = {}
    for ticket_id, value in interaction_best.items():
        interaction_by_ticket_id[ticket_id] = {
            column: value.get(column, NO_DATA_TEXT)
            for column in INTERACTION_OUTPUT_COLUMNS
        }

    print(
        f"Interaction unique matched Ticket IDs: "
        f"{len(interaction_by_ticket_id):,}"
    )

    return {
        "interaction_by_ticket_id": interaction_by_ticket_id,
    }



