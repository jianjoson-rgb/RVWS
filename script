def ensure_package(import_name: str, pip_name: Optional[str] = None) -> None:
    """Install a missing package with retry support."""
    if importlib.util.find_spec(import_name) is not None:
        return

    package_name = pip_name or import_name
    last_error: Optional[Exception] = None

    for attempt in range(1, 5):
        try:
            subprocess.check_call(
                [sys.executable, "-m", "pip", "install", "-q", package_name]
            )
            return
        except Exception as exc:  # pragma: no cover - depends on runtime/network
            last_error = exc
            if attempt == 4:
                break
            sleep_seconds = min(30, 2 ** attempt + random.random())
            print(
                f"Package install retry {attempt}/4 for {package_name}. "
                f"Sleeping {sleep_seconds:.1f}s."
            )
            time.sleep(sleep_seconds)

    raise RuntimeError(
        f"Could not install required package: {package_name}"
    ) from last_error


