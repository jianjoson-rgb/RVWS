def _docx_v571_site_current_period_df(
    report_scope: Mapping[str, Any],
    metric: PeriodMetric,
    site: str,
) -> pd.DataFrame:
    """Return same-period, same-site rows for the site summary matrix."""
    display_df = report_scope.get("display_df", pd.DataFrame()) if isinstance(report_scope, Mapping) else pd.DataFrame()
    if display_df is None or not isinstance(display_df, pd.DataFrame) or display_df.empty:
        return pd.DataFrame()

    site_key = normalize_text(site)
    work = display_df.copy()
    if "Site" in work.columns and site_key:
        work = work[work["Site"].map(normalize_text).eq(site_key)].copy()

    if work.empty:
        return work

    try:
        period_df = current_period_dataframe(work, metric)
        if period_df is not None and isinstance(period_df, pd.DataFrame):
            return period_df.copy()
    except Exception as exc:
        LOGGER.debug("v5.7.71 site current-period fallback used for %s: %s", site_key, exc)

    if "Date" not in work.columns:
        return work.copy()

    dates = pd.to_datetime(work["Date"], errors="coerce")
    start = pd.Timestamp(getattr(metric, "period_start", pd.NaT))
    end = pd.Timestamp(getattr(metric, "period_end", pd.NaT))
    if pd.isna(start) or pd.isna(end):
        return work.copy()

    return work[dates.ge(start) & dates.le(end)].copy()


def _docx_v571_site_summary_row(
    site: str,
    site_metric: PeriodMetric,
    overall_result: Optional[GrainResult],
) -> pd.DataFrame:
    """Build a one-row site summary for site-specific readout compatibility."""
    site_key = normalize_text(site)
    if overall_result is not None:
        site_summary = getattr(overall_result, "site_summary", pd.DataFrame())
        if isinstance(site_summary, pd.DataFrame) and not site_summary.empty and "Site" in site_summary.columns:
            row = site_summary[site_summary["Site"].map(normalize_text).eq(site_key)].copy()
            if not row.empty:
                return row.reset_index(drop=True)

    overall_metric = getattr(overall_result, "overall", None) if overall_result is not None else None
    overall_rate = _email_v551_num(getattr(overall_metric, "actual_rate", np.nan))
    site_rate = _email_v551_num(getattr(site_metric, "actual_rate", np.nan))
    responses = _email_v551_num(getattr(site_metric, "actual_responses", 0.0), 0.0)
    impact = np.nan
    if pd.notna(site_rate) and pd.notna(overall_rate):
        impact = site_rate - overall_rate

    return pd.DataFrame(
        [
            {
                "Site": site_key,
                "Smiley Rate": site_rate,
                "Responses": responses,
                "Response Share": np.nan,
                "Official Impact": impact,
            }
        ]
    )


def _docx_v571_site_squad_summary(
    site: str,
    site_report: SiteReport,
    grain: str,
) -> pd.DataFrame:
    """Return the site-level squad impact table for the selected grain."""
    site_key = normalize_text(site)
    grain_key = normalize_text(grain).upper()

    squad_summary = pd.DataFrame()
    try:
        squad_tables = getattr(site_report, "squad_tables", {})
        if isinstance(squad_tables, Mapping):
            candidate = squad_tables.get(grain_key, pd.DataFrame())
            if isinstance(candidate, pd.DataFrame):
                squad_summary = candidate.copy()
    except Exception:
        squad_summary = pd.DataFrame()

    if squad_summary.empty:
        try:
            mix_tables = getattr(site_report, "squad_response_mix_tables_v531", {})
            if isinstance(mix_tables, Mapping):
                candidate = mix_tables.get(grain_key, pd.DataFrame())
                if isinstance(candidate, pd.DataFrame):
                    squad_summary = candidate.copy()
        except Exception:
            squad_summary = pd.DataFrame()

    if squad_summary.empty:
        return pd.DataFrame()

    if "Site" not in squad_summary.columns:
        squad_summary["Site"] = site_key
    else:
        squad_summary = squad_summary[squad_summary["Site"].map(normalize_text).eq(site_key)].copy()

    return squad_summary.reset_index(drop=True)


def _docx_v571_site_position_segments(
    site: str,
    site_metric: PeriodMetric,
    overall_metric: Optional[PeriodMetric],
) -> List[Dict[str, Any]]:
    """Site-specific driver line: compare the site to the same-period overall benchmark."""
    site_key = normalize_text(site) or "Site"
    grain = normalize_text(getattr(site_metric, "grain", "")).title() or "selected grain"
    site_rate = _email_v551_num(getattr(site_metric, "actual_rate", np.nan))
    site_responses = _email_v551_num(getattr(site_metric, "actual_responses", 0.0), 0.0)
    overall_rate = _email_v551_num(getattr(overall_metric, "actual_rate", np.nan)) if overall_metric is not None else np.nan
    overall_responses = _email_v551_num(getattr(overall_metric, "actual_responses", 0.0), 0.0) if overall_metric is not None else 0.0
    gap = site_rate - overall_rate if pd.notna(site_rate) and pd.notna(overall_rate) else np.nan
    share = safe_rate(site_responses, overall_responses)

    if pd.isna(gap):
        status = "was measured against the same-period overall benchmark"
        gap_phrase = "benchmark gap was not available"
    elif abs(gap) < 0.0005:
        status = "matched the same-period overall benchmark"
        gap_phrase = format_pp(gap)
    elif gap > 0:
        status = "outperformed the same-period overall benchmark"
        gap_phrase = format_pp(gap)
    else:
        status = "trailed the same-period overall benchmark"
        gap_phrase = format_pp(gap)

    gap_color = _email_v551_delta_color(gap)
    return [
