def _docx_add_email_body(
    document: Document,
    payload: Mapping[str, Any],
    config: AppConfig = CONFIG,
) -> None:
    """
    v5.7.52 FOR EMAIL ONLY DOCX renderer.

    It replaces the simple Daily/Weekly/Monthly bullet block with detailed
    color-coded readouts, then preserves the existing Key Performance Drivers &
    Recommended Actions section beneath it.
    """
    if not payload.get("detailed_readouts"):
        _v550_docx_add_email_body(document, payload, config=config)
        return

    lob = normalize_text(payload.get("lob", ""))
    heading = f"{lob} Executive Summary" if lob else "Email Executive Summary"
    document.add_heading(heading, level=1)

    subject = document.add_paragraph()
    subject.paragraph_format.space_after = Pt(4)
    subject_run = subject.add_run("Subject: ")
    subject_run.bold = True
    subject_run.font.color.rgb = RGBColor.from_string(EMAIL_V551_BLUE)
    subject.add_run(normalize_text(payload.get("subject", "")))

    document.add_heading(
        normalize_text(payload.get("overview_title", "Overall Performance & Bottom Line")),
        level=2,
    )
    _docx_add_email_segment_paragraph_v551(
        document,
        payload.get("overview_segments", []),
        font_size=9.0,
    )

    for readout in payload.get("detailed_readouts", []):
        title = normalize_text(readout.get("title", "Detailed Readout"))
        period = normalize_text(readout.get("period_label", ""))
        heading_text = title if not period else f"{title} — {period}"
        document.add_heading(heading_text, level=2)

        for block in readout.get("blocks", []):
            label = normalize_text(block.get("label", ""))
            paragraphs = block.get("paragraphs", [])
            if not paragraphs:
                continue

            # The first paragraph receives the block label. Additional driver
            # paragraphs remain as bullets/indented lines under the same block.
            first = True
            for paragraph in paragraphs:
                segments = paragraph.get("segments", [])
                if first:
                    _docx_add_email_label_and_segments_v551(
                        document,
                        label,
                        segments,
                        font_size=8.8,
                    )
                    first = False
                else:
                    _docx_add_email_segment_paragraph_v551(
                        document,
                        segments,
                        style="List Bullet",
                        font_size=8.4,
                    )

    document.add_heading(
        "Key Performance Drivers & Recommended Actions",
        level=2,
    )
    for section in payload.get("sections", []):
        title = normalize_text(section.get("title", ""))
        if title:
            document.add_heading(title, level=3)

        for paragraph_text in section.get("paragraphs", []):
            if normalize_text(paragraph_text):
                paragraph = document.add_paragraph(normalize_text(paragraph_text))
                paragraph.paragraph_format.space_after = Pt(3)
                for run in paragraph.runs:
                    run.font.size = Pt(8.8)

        action_heading = normalize_text(section.get("action_heading", ""))
        if action_heading:
            paragraph = document.add_paragraph()
            paragraph.paragraph_format.space_after = Pt(2)
            run = paragraph.add_run(action_heading)
            run.bold = True
            run.font.size = Pt(8.8)
            run.font.color.rgb = RGBColor.from_string(EMAIL_V551_BLUE)

        for action in section.get("actions", []):
            if normalize_text(action):
                add_bullet(document, normalize_text(action))

    followup = normalize_text(payload.get("followup_line", ""))
    if followup:
        paragraph = document.add_paragraph(followup)
        paragraph.paragraph_format.space_before = Pt(6)
        for run in paragraph.runs:
            run.font.size = Pt(8.8)


# =========================================================
# V5.7.53 GLOBAL DOCX SPACING HARDENING
# =========================================================
def _email_v553_needs_join_space(left: Any, right: Any) -> bool:
    """
    Return True when two styled text runs need a literal space between them.

    This protects all generated DOCX/HTML/plain email summaries from edge-space
    loss when Google Docs imports styled runs independently.
    """
    left_text = "" if left is None else str(left)
    right_text = "" if right is None else str(right)
    if not left_text or not right_text:
        return False

    left_char = left_text[-1]
    right_char = right_text[0]

    if left_char.isspace() or right_char.isspace():
        return False
    if right_char in ",.;:!?%)]}":
        return False
    if left_char in "([{":
        return False
    if left_char in "/":
        return False
    if right_char in "/":
        return False

    # Colons usually introduce labels in this report: "Site: HTW".
    if left_char == ":" and (right_char.isalnum() or right_char in "<>=$"):
        return True

    # Normal words/numbers/rates followed by words/numbers should be separated.
    left_needs = left_char.isalnum() or left_char in "%)]}’”"
    right_needs = right_char.isalnum() or right_char in "<>=$▲▼"
    return bool(left_needs and right_needs)


def _email_v553_join_segment_texts(
    segments: Sequence[Mapping[str, Any]],
    *,
    clean_final: bool = True,
) -> str:
    """Join styled email segments while preserving readable word spacing."""
    parts: List[str] = []
    for segment in segments:
        text_value = _email_v552_preserve_run_spacing(segment.get("text", ""))
        if not text_value:
            continue
        if parts and _email_v553_needs_join_space(parts[-1], text_value):
            parts.append(" ")
        parts.append(text_value)

    joined = "".join(parts)
    if not clean_final:
        return joined
    return _email_v552_clean_joined_text(joined)


def _email_v551_segments_text(segments: Sequence[Mapping[str, Any]]) -> str:
    """v5.7.53 override: render plain text with safe inter-run spacing."""
    return _email_v553_join_segment_texts(segments, clean_final=True)


def _email_html_segments_v551(segments: Sequence[Mapping[str, Any]]) -> str:
    """v5.7.53 override: render HTML with safe inter-run spacing."""
    parts: List[str] = []
    previous_text = ""
    for segment in segments:
        text_value_raw = _email_v552_preserve_run_spacing(segment.get("text", ""))
        if not text_value_raw:
            continue

        if previous_text and _email_v553_needs_join_space(previous_text, text_value_raw):
            parts.append(" ")

        text_value = html.escape(text_value_raw)
        color = normalize_text(segment.get("color", EMAIL_V551_BLACK)) or EMAIL_V551_BLACK
        weight = "font-weight:bold;" if bool(segment.get("bold", False)) else ""
        parts.append(f"<span style=\"color:#{color};{weight}\">{text_value}</span>")
        previous_text = text_value_raw

    return "".join(parts)


def _docx_v553_apply_run_defaults(
    run,
    *,
    font_size: Optional[float] = None,
    font_name: Optional[str] = None,
) -> None:
    """Apply only missing-safe run defaults without removing existing colors/bold."""
    try:
        if font_size is not None and run.font.size is None:
            run.font.size = Pt(font_size)
        if font_name:
            run.font.name = font_name
            run._element.rPr.rFonts.set(qn("w:eastAsia"), font_name)
    except Exception:
        return


def _docx_add_email_segments_v551(
    paragraph,
    segments: Sequence[Mapping[str, Any]],
    *,
    font_size: float = 9.0,
) -> None:
    """
    v5.7.53 override: append color-coded runs with explicit spacer runs when
    adjacent styled segments would otherwise collapse together in Google Docs.
    """
    previous_text = ""

    for segment in segments:
        text_value = _email_v552_preserve_run_spacing(segment.get("text", ""))
        if not text_value:
            continue

        if previous_text and _email_v553_needs_join_space(previous_text, text_value):
            spacer = paragraph.add_run(" ")
            spacer.font.size = Pt(font_size)
            spacer.font.color.rgb = RGBColor.from_string(EMAIL_V551_BLACK)

        run = paragraph.add_run(text_value)
        run.font.size = Pt(font_size)
        run.bold = bool(segment.get("bold", False))
        color = normalize_text(segment.get("color", EMAIL_V551_BLACK)) or EMAIL_V551_BLACK
        try:
            run.font.color.rgb = RGBColor.from_string(color)
        except Exception:
            run.font.color.rgb = RGBColor.from_string(EMAIL_V551_BLACK)

        previous_text = text_value


