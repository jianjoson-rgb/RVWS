def _table_report_date_subset_v566(
    population: pd.DataFrame,
    start_date: Any,
    end_date: Any,
) -> pd.DataFrame:
    """
    Return the table population for the selected reporting window.

    The validated trend charts use the normalized reporting ``Date`` field to
    decide which rows belong to the report period. Timing tables must use the
    same population. ``Created Date UTC`` is used only after this filter to
    assign Time of Day / Day of Week / Day of Month segments.
    """
    if population is None or population.empty:
        return pd.DataFrame(columns=getattr(population, "columns", None))

    work = population.copy()
    if "Date" not in work.columns:
        return work.iloc[0:0].copy()

    report_dates = pd.to_datetime(
        work["Date"],
        errors="coerce",
    ).dt.normalize()

    start_value = pd.Timestamp(start_date).normalize()
    end_value = pd.Timestamp(end_date).normalize()

    return work[
        report_dates.between(
            start_value,
            end_value,
            inclusive="both",
        )
    ].copy()


def _authoritative_monthly_display_metrics_v566(
    population: pd.DataFrame,
    display_frame: pd.DataFrame,
) -> pd.DataFrame:
    """
    Build monthly table metrics for exactly the date bounds displayed.

    This prevents Specific Day / Specific Week runs from accidentally using
    later dates in the same month. Each displayed row's Month Start / Month End
    is respected, while rates still use:
        SUM(Smiley Numerator) / SUM(Responses)
    """
    columns = [
        "_Table Month Start",
        "Table All Rated",
        "Table All Smiley Rate",
        "Table All Unhappy Rate",
        "Table Finance Rated",
        "Table Finance Smiley Rate",
        "Table Finance Unhappy Rate",
        "Table Other Rated",
        "Table Other Smiley Rate",
        "Table Other Unhappy Rate",
        "Table Finance vs Other Smiley Gap (pp)",
        "Table Finance vs Other Unhappy Gap (pp)",
    ]

    if (
        population is None
        or population.empty
        or display_frame is None
        or display_frame.empty
    ):
        return pd.DataFrame(columns=columns)

    work = population.copy()
    if "Date" not in work.columns:
        return pd.DataFrame(columns=columns)

    work["_Table Report Date"] = pd.to_datetime(
        work["Date"],
        errors="coerce",
    ).dt.normalize()

    records: List[Dict[str, Any]] = []
    for _, display_row in display_frame.iterrows():
        month_start_value = pd.to_datetime(
            display_row.get("Month Start"),
            errors="coerce",
        )
        month_end_value = pd.to_datetime(
            display_row.get("Month End"),
            errors="coerce",
        )

        if pd.isna(month_start_value):
            label = normalize_text(display_row.get("Month", ""))
            label = re.sub(
                r"\s*\(partial\)\s*$",
                "",
                label,
                flags=re.IGNORECASE,
            )
            month_start_value = pd.to_datetime(
                label,
                format="%b %Y",
                errors="coerce",
            )

        if pd.isna(month_start_value):
            continue

        month_start_value = pd.Timestamp(
            month_start_value
        ).normalize().replace(day=1)

        if pd.isna(month_end_value):
            month_end_value = month_end(month_start_value)
        else:
            month_end_value = pd.Timestamp(
                month_end_value
            ).normalize()

        subset = work[
            work["_Table Report Date"].between(
                month_start_value,
                month_end_value,
                inclusive="both",
            )
        ].copy()

        metrics = _authoritative_population_metrics_v565(
            subset
        )
        metrics["_Table Month Start"] = month_start_value
        records.append(metrics)

    if not records:
        return pd.DataFrame(columns=columns)

    return pd.DataFrame(records).reindex(columns=columns)

def _authoritative_monthly_table_metrics_v565(
    population: pd.DataFrame,
) -> pd.DataFrame:
    """
    Build monthly table-only metrics using the SAME Date field and
    Smiley Numerator / Responses aggregation used by the main monthly chart.
    """
    columns = [
        "_Table Month Start",
        "Table All Rated",
        "Table All Smiley Rate",
        "Table All Unhappy Rate",
        "Table Finance Rated",
        "Table Finance Smiley Rate",
        "Table Finance Unhappy Rate",
        "Table Other Rated",
        "Table Other Smiley Rate",
        "Table Other Unhappy Rate",
        "Table Finance vs Other Smiley Gap (pp)",
        "Table Finance vs Other Unhappy Gap (pp)",
    ]
    if population is None or population.empty:
        return pd.DataFrame(columns=columns)

    work = population.copy()
    if "Date" not in work.columns:
        return pd.DataFrame(columns=columns)

    work["_Table Date"] = pd.to_datetime(
        work["Date"],
        errors="coerce",
    ).dt.normalize()
    work = work[work["_Table Date"].notna()].copy()
    if work.empty:
        return pd.DataFrame(columns=columns)

    work["_Table Month Start"] = (
        work["_Table Date"]
        .dt.to_period("M")
        .dt.to_timestamp()
    )

    records: List[Dict[str, Any]] = []
    for month_start_value, group in work.groupby(
        "_Table Month Start",
        dropna=False,
        sort=True,
    ):
        metrics = _authoritative_population_metrics_v565(
            group
        )
        metrics["_Table Month Start"] = pd.Timestamp(
            month_start_value
        )
        records.append(metrics)

    return pd.DataFrame(records, columns=columns)


def _authoritative_segment_table_metrics_v565(
    population: pd.DataFrame,
    segment_column: str,
    segment_order: Sequence[Any],
) -> pd.DataFrame:
    """
    Build timing table-only metrics after segment assignment.

    Created Date UTC is used only to assign the timing segment. The metric
    itself always uses Smiley Numerator / Responses, matching the trend chart.
    """
    columns = [
