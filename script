    for grain, result in grain_results.items():
        prefix = grain.title()
        metric = result.overall
        output.loc[:, f"{prefix} Previous Period"] = (
            metric.previous_period_label
        )
        output.loc[:, f"{prefix} Previous Rate"] = metric.previous_rate
        output.loc[:, f"{prefix} vs Previous Delta pp"] = (
            metric.previous_delta * 100
            if pd.notna(metric.previous_delta)
            else np.nan
        )
        output.loc[:, f"{prefix} Trend Status"] = (
            metric.performance_status
        )
        output.loc[:, f"{prefix} Previous Responses"] = (
            metric.previous_responses
        )
        output.loc[:, f"{prefix} Volume Change %"] = (
            metric.volume_change_pct
        )
        output.loc[:, f"{prefix} Volume Status"] = metric.volume_status
        output.loc[:, f"{prefix} Comparison Basis"] = (
            metric.comparison_basis
        )
    return output


def build_grain_result(
    df: pd.DataFrame,
    grain: str,
    report_scope: Mapping[str, Any],
    config: AppConfig = CONFIG,
) -> GrainResult:
    """
    Preserve the existing GrainResult and enrich site rows with prior-period data.
    """
    result = _v532_build_grain_result(
        df=df,
        grain=grain,
        report_scope=report_scope,
        config=config,
    )
    if result.site_summary.empty:
        return result

    table = result.site_summary.copy()
    for column, default_value in [
        ("Previous Period", ""),
        ("Previous Rate", np.nan),
        ("vs Previous Delta pp", np.nan),
        ("Trend Status", "Insufficient previous data"),
        ("Previous Responses", np.nan),
        ("Volume Change %", np.nan),
        ("Volume Status", "Insufficient previous volume"),
        ("Comparison Basis", ""),
    ]:
        table[column] = default_value

    normalized_sites = (
        df["Site"].map(normalize_text)
        if "Site" in df.columns
        else pd.Series("", index=df.index)
    )

    for row_index, site_value in table["Site"].items():
        site_name = normalize_text(site_value)
        site_df = df[normalized_sites.eq(site_name)].copy()
        if site_df.empty:
            continue

        site_metric = calculate_period_metric(
            grain=grain,
            scope_df=site_df,
            scope_name=site_name,
            report_scope=report_scope,
            config=config,
            baseline_period_keys=result.overall.baseline_period_keys,
        )
        table.at[row_index, "Previous Period"] = (
            site_metric.previous_period_label
        )
        table.at[row_index, "Previous Rate"] = site_metric.previous_rate
        table.at[row_index, "vs Previous Delta pp"] = (
            site_metric.previous_delta * 100
            if pd.notna(site_metric.previous_delta)
            else np.nan
        )
        table.at[row_index, "Trend Status"] = (
            site_metric.performance_status
        )
        table.at[row_index, "Previous Responses"] = (
            site_metric.previous_responses
        )
        table.at[row_index, "Volume Change %"] = (
            site_metric.volume_change_pct
        )
        table.at[row_index, "Volume Status"] = site_metric.volume_status
        table.at[row_index, "Comparison Basis"] = (
            site_metric.comparison_basis
        )

    result.site_summary = table
    return result




