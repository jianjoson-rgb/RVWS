def _docx_v570_segment_text(segments: Sequence[Mapping[str, Any]]) -> str:
    """Return plain text from email-style segment dictionaries with safe spacing."""
    try:
        return normalize_text(_email_v551_segments_text(segments))
    except Exception:
        parts: List[str] = []
        for segment in segments or []:
            if isinstance(segment, Mapping):
                parts.append(normalize_text(segment.get("text", "")))
            else:
                parts.append(normalize_text(segment))
        return normalize_text(" ".join(part for part in parts if part))


def _docx_v570_readouts_by_grain(
    payload: Mapping[str, Any],
) -> Dict[str, Mapping[str, Any]]:
    """Map Daily/Weekly/Monthly readouts from the existing email payload."""
    result: Dict[str, Mapping[str, Any]] = {}
    for readout in payload.get("detailed_readouts", []):
        if not isinstance(readout, Mapping):
            continue
        grain = normalize_text(readout.get("grain", "")).upper()
        if not grain:
            title = normalize_text(readout.get("title", "")).upper()
            if "DAILY" in title:
                grain = "DAILY"
            elif "WEEKLY" in title:
                grain = "WEEKLY"
            elif "MONTHLY" in title:
                grain = "MONTHLY"
        if grain:
            result[grain] = readout
    return result


def _docx_v570_period_title(readout: Mapping[str, Any]) -> str:
    """Return compact grain + period title for table headers."""
    grain = normalize_text(readout.get("grain", ""))
    title = normalize_text(readout.get("title", ""))
    period = normalize_text(readout.get("period_label", ""))
    if grain:
        base = grain.title()
    elif title:
        base = title.replace("Detailed Readout", "").strip() or title
    else:
        base = "Grain"
    return f"{base}\n{period}" if period else base


def _docx_v570_block_paragraph_texts(
    readout: Mapping[str, Any],
    label_tokens: Sequence[str],
) -> List[str]:
    """
    Return paragraph text from the first matching block.

    label_tokens are lowercase fragments such as "driver readout" or "qa attribute".
    """
    if not isinstance(readout, Mapping):
        return []
    tokens = [normalize_text(token).lower() for token in label_tokens if normalize_text(token)]
    if not tokens:
        return []

    for block in readout.get("blocks", []):
        if not isinstance(block, Mapping):
            continue
        label = normalize_text(block.get("label", "")).lower()
        if not any(token in label for token in tokens):
            continue
        results: List[str] = []
        for paragraph_data in block.get("paragraphs", []):
            if not isinstance(paragraph_data, Mapping):
                continue
            text_value = _docx_v570_segment_text(paragraph_data.get("segments", []))
            if text_value:
                results.append(text_value)
        return results
    return []


def _docx_v570_driver_prefix_texts(
    readout: Mapping[str, Any],
    prefixes: Sequence[str],
) -> List[str]:
    """Pull specific labeled driver bullets from the Driver Readout block."""
    driver_lines = _docx_v570_block_paragraph_texts(readout, ["driver readout"])
    prefix_values = [normalize_text(prefix).lower() for prefix in prefixes if normalize_text(prefix)]
    if not prefix_values:
        return driver_lines
    selected: List[str] = []
    for line in driver_lines:
        line_norm = normalize_text(line)
        low = line_norm.lower()
        if any(low.startswith(prefix) for prefix in prefix_values):
            selected.append(line_norm)
    return selected


def _docx_v570_join_bullets(
    texts: Sequence[str],
    *,
    max_chars: int = 900,
) -> str:
    """Join text lines into one compact DOCX table-cell bullet list."""
    cleaned = [normalize_text(text) for text in texts if normalize_text(text)]
    if not cleaned:
        return "N/A"
    value = "\n".join(f"• {item}" for item in cleaned)
    limit = max(160, int(max_chars or 900))
    if len(value) <= limit:
        return value
    return value[: max(0, limit - 1)].rstrip() + "…"


