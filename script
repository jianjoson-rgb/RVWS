# =========================================================
# GOOGLE DRIVE / SHARED DRIVE PUBLISHING
# =========================================================
GOOGLE_DOC_MIME_TYPE = "application/vnd.google-apps.document"
GOOGLE_FOLDER_MIME_TYPE = "application/vnd.google-apps.folder"
DOCX_MIME_TYPE = (
    "application/vnd.openxmlformats-officedocument."
    "wordprocessingml.document"
)


def drive_folder_url(folder_id: str) -> str:
    return f"https://drive.google.com/drive/folders/{folder_id}"


def validate_shared_drive_destination(
    drive_service,
    folder_id: str,
    require_shared_drive: bool = True,
) -> Dict[str, str]:
    """
    Validate that the configured destination exists, is a folder, and is inside
    a Shared Drive when require_shared_drive=True.

    This safeguard prevents an accidental fallback to the authenticated user's
    personal My Drive.
    """
    folder_id = normalize_text(folder_id)
    if not folder_id:
        raise ValueError(
            "drive_parent_folder_id is blank. Configure the approved Shared "
            "Drive folder ID before publishing."
        )

    metadata = (
        drive_service.files()
        .get(
            fileId=folder_id,
            fields="id,name,mimeType,driveId,parents,webViewLink",
            supportsAllDrives=True,
        )
        .execute()
    )
    if metadata.get("mimeType") != GOOGLE_FOLDER_MIME_TYPE:
        raise ValueError(
            f"Configured Drive destination is not a folder: {folder_id}"
        )

    shared_drive_id = normalize_text(metadata.get("driveId", ""))
    if require_shared_drive and not shared_drive_id:
        raise RuntimeError(
            "The configured destination is not inside a Shared Drive. "
            "Publishing was stopped to prevent files from being saved to "
            "personal My Drive."
        )

    return {
        "folder_id": metadata["id"],
        "folder_name": metadata.get("name", ""),
        "shared_drive_id": shared_drive_id,
        "url": metadata.get("webViewLink", drive_folder_url(metadata["id"])),
    }


def get_or_create_drive_folder(
    drive_service,
    folder_name: str,
    parent_id: str,
    shared_drive_id: str = "",
) -> str:
    """Find or create a folder under the approved Shared Drive parent."""
    if not normalize_text(parent_id):
        raise ValueError("A parent folder ID is required for Shared Drive output.")

    escaped = folder_name.replace("\\", "\\\\").replace("'", "\\'")
    query = (
        f"name = '{escaped}' and "
        f"mimeType = '{GOOGLE_FOLDER_MIME_TYPE}' and "
        f"'{parent_id}' in parents and trashed = false"
    )
    list_kwargs: Dict[str, Any] = {
        "q": query,
        "spaces": "drive",
        "fields": "files(id,name,driveId,webViewLink)",
        "pageSize": 10,
        "supportsAllDrives": True,
        "includeItemsFromAllDrives": True,
    }
    if shared_drive_id:
        list_kwargs["corpora"] = "drive"
        list_kwargs["driveId"] = shared_drive_id
    else:
        list_kwargs["corpora"] = "user"

    response = drive_service.files().list(**list_kwargs).execute()
    files = response.get("files", [])
    if files:
        return files[0]["id"]

    body: Dict[str, Any] = {
        "name": folder_name,
        "mimeType": GOOGLE_FOLDER_MIME_TYPE,
        "parents": [parent_id],
    }
    created = (
        drive_service.files()
        .create(
            body=body,
            fields="id,name,driveId,webViewLink",
            supportsAllDrives=True,
        )
        .execute()
    )
    return created["id"]


def upload_binary_file(
    drive_service,
    local_path: str,
    drive_name: str,
    parent_folder_id: str,
    mime_type: str,
) -> Dict[str, str]:
    """Upload a binary file directly into the approved Shared Drive folder."""
    local_file = Path(local_path)
    if not local_file.exists() or local_file.stat().st_size == 0:
        raise FileNotFoundError(f"Upload source is missing or empty: {local_path}")

    metadata: Dict[str, Any] = {
        "name": drive_name,
        "parents": [parent_folder_id],
    }
    media = MediaFileUpload(
        str(local_file),
        mimetype=mime_type,
        resumable=True,
    )
    created = (
        drive_service.files()
        .create(
            body=metadata,
            media_body=media,
            fields="id,name,mimeType,driveId,webViewLink",
            supportsAllDrives=True,
        )
        .execute()
    )
    return {
        "id": created["id"],
        "name": created.get("name", drive_name),
        "mime_type": created.get("mimeType", mime_type),
        "shared_drive_id": created.get("driveId", ""),
        "url": created.get(
            "webViewLink",
            f"https://drive.google.com/file/d/{created['id']}/view",
        ),
    }


def import_docx_as_google_doc(
    drive_service,
    docx_path: str,
    google_doc_name: str,
    parent_folder_id: str,
) -> Dict[str, str]:
    """
    Import the generated DOCX as a native Google Docs file in the same Shared
    Drive run folder. Setting the Google Docs MIME type performs the conversion.
    """
    local_file = Path(docx_path)
    if not local_file.exists() or local_file.stat().st_size == 0:
        raise FileNotFoundError(
            f"Google Docs conversion source is missing or empty: {docx_path}"
        )

    metadata = {
        "name": google_doc_name,
        "mimeType": GOOGLE_DOC_MIME_TYPE,
        "parents": [parent_folder_id],
    }
    media = MediaFileUpload(
        str(local_file),
        mimetype=DOCX_MIME_TYPE,
        resumable=True,
    )
    created = (
        drive_service.files()
        .create(
            body=metadata,
            media_body=media,
            fields="id,name,mimeType,driveId,webViewLink",
            supportsAllDrives=True,
        )
        .execute()
    )
    if created.get("mimeType") != GOOGLE_DOC_MIME_TYPE:
        raise RuntimeError(
            "Drive upload completed, but the result was not converted to a "
            "native Google Docs file."
        )

    return {
        "id": created["id"],
        "name": created.get("name", google_doc_name),
        "mime_type": created.get("mimeType", GOOGLE_DOC_MIME_TYPE),
        "shared_drive_id": created.get("driveId", ""),
        "url": created.get(
            "webViewLink",
            f"https://docs.google.com/document/d/{created['id']}/edit",
        ),
    }




def _is_all_grains_v570(selection: ReportSelection) -> bool:
    """Return True when the user explicitly selected ALL GRAINS."""
    value = normalize_text(selection.grain).upper()
    return value in {"ALL", "ALL GRAINS", "ALL_GRAINS"}


def _active_grains_v570(selection: ReportSelection) -> List[str]:
    """Canonical report-wide grain list in executive display order."""
    return selected_grains(selection.grain)


def _grain_period_type_v570(grain: str) -> str:
    return {
        "DAILY": "DAY",
        "WEEKLY": "WEEK",
        "MONTHLY": "MONTH",
    }[normalize_text(grain).upper()]


def _analysis_scope_for_selection_v570(
    report_scope: Mapping[str, Any],
    grain_results: Mapping[str, GrainResult],
    selection: ReportSelection,
    source_df: pd.DataFrame,
) -> Dict[str, Any]:
    """
    Build the report-wide analysis scope.

    ALL GRAINS keeps the selected report scope.
    A specific grain makes that grain's current period the population used by
    static QA, scrub, Finance/Other, taxonomy and timing analyses.
    """
    output = dict(report_scope)
    active = _active_grains_v570(selection)
    if len(active) != 1:
        output["analysis_grain"] = "ALL GRAINS"
        output["analysis_grains"] = list(active)
        return output

    grain = active[0]
    result = grain_results.get(grain)
    if result is None:
        raise ValueError(f"Missing active grain result for {grain}.")

    metric = result.overall
    current_df = current_period_dataframe(source_df, metric)

    period_start = pd.Timestamp(metric.period_start).normalize()
    period_end = pd.Timestamp(metric.period_end).normalize()
    data_through = pd.Timestamp(metric.data_through).normalize()
    observed_end = min(period_end, data_through)

    output.update(
        {
            "analysis_grain": grain,
            "analysis_grains": [grain],
            "period_type": _grain_period_type_v570(grain),
            "report_start": period_start,
            "report_end": period_end,
            "report_label": metric.period_label,
            "display_df": current_df.copy(),
            "data_through": data_through,
            "operational_data_through": data_through,
            "pattern_start": period_start,
            "pattern_end": observed_end,
            "pattern_label": (
                f"{period_start.strftime('%m/%d/%Y')}–"
                f"{observed_end.strftime('%m/%d/%Y')}"
                if period_start != observed_end
                else period_start.strftime("%m/%d/%Y")
            ),
        }
    )

    if grain == "WEEKLY":
        output["weekly_report_start"] = period_start
        output["weekly_report_end"] = period_end
        output["weekly_source_data_through"] = data_through
    elif grain == "MONTHLY":
        output["reference_month_start"] = month_start(period_start)
        output["reference_month_end"] = month_end(period_start)
        output["monthly_data_through"] = data_through
        output["current_month_incomplete"] = bool(metric.is_incomplete)
    else:
        output["daily_data_through"] = data_through

    return output


def _analysis_population_v570(
    report_scope: Mapping[str, Any],
    grain_results: Mapping[str, GrainResult],
    selection: ReportSelection,
    source_df: pd.DataFrame,
) -> pd.DataFrame:
    """Return the static-analysis population for the selected grain mode."""
    active = _active_grains_v570(selection)
    if len(active) != 1:
        return report_scope["display_df"].copy()

    result = grain_results.get(active[0])
    if result is None:
        return report_scope["display_df"].copy()
    return current_period_dataframe(
        source_df,
        result.overall,
    ).copy()


def _strip_heading_number_v570(value: Any) -> str:
    """Remove executive section numbering such as '3.' or '3.1'."""
    text = normalize_text(value)
    return re.sub(r"^\s*\d+(?:\.\d+)*\.?\s+", "", text)


def _selection_aware_email_payload_v570(
    selection: ReportSelection,
    report_scope: Mapping[str, Any],
    grain_results: Mapping[str, GrainResult],
    primary_site: str,
    focus_squads: Sequence[str],
    monthly_anchor: Optional[pd.Series],
    qa_summary: pd.DataFrame,
    scrubbed_tickets: pd.DataFrame,
    config: AppConfig = CONFIG,
) -> Dict[str, Any]:
    """
    Build an executive email payload that respects the report-wide grain mode.

    ALL GRAINS keeps the cross-grain synthesis. A specific grain contains only
    that grain's evidence, drivers and recommended action.
    """
    active = _active_grains_v570(selection)
    if len(active) > 1:
        payload = build_cross_grain_email_body(
            selection=selection,
            report_scope=report_scope,
            grain_results=grain_results,
            primary_site=primary_site,
            focus_squads=focus_squads,
            monthly_anchor=monthly_anchor,
            qa_summary=qa_summary,
            scrubbed_tickets=scrubbed_tickets,
            config=config,
        )
        for section in payload.get("sections", []):
            section["title"] = _strip_heading_number_v570(
                section.get("title", "")
            )
        payload["analysis_mode"] = "ALL GRAINS"
        payload["plain_text"] = _email_plain_text_from_payload(payload)
        payload["html"] = _email_html_from_payload(payload)
        return payload

    grain = active[0]
    result = grain_results.get(grain)
    if result is None:
        raise ValueError(f"Missing {grain} result for email output.")

    metric = result.overall
    grain_title = grain.title()
    executive_summary = [executive_summary_line(metric)]

    focus_paragraphs: List[str] = []
    if primary_site:
        site_line = _email_metric_site_line(
            grain,
            result,
            primary_site,
        )
        focus_paragraphs.append(
            f"{primary_site} is the primary {grain_title.lower()} recovery "
            f"focus for the selected {selection.lob.title()} population."
        )
        if site_line:
            focus_paragraphs.append(site_line + ".")
    else:
        focus_paragraphs.append(
            f"No single site produced a qualifying negative {grain_title.lower()} "
            "impact in the selected population."
        )

    negative_squads = _email_top_squad_names(
        result,
        primary_site,
        "negative",
        5,
    )
    if negative_squads:
        focus_paragraphs.append(
            "Priority squads requiring review: "
            f"{_human_join(negative_squads)}."
        )

    focus_actions: List[str] = []
    if primary_site:
        focus_actions.append(
            f"Review the most recent non-smiley contacts for {primary_site} "
            f"within the selected {grain_title.lower()} period, prioritizing "
            f"{_human_join(negative_squads[:5], 'the leading risk squads')}."
        )

    scrub_summaries: List[str] = []
    for squad in negative_squads[: max(0, int(config.email_body_top_scrub_summaries))]:
        summary = summarize_scrubbed_squad(
            scrubbed_tickets=scrubbed_tickets,
            qa_summary=qa_summary,
            site=primary_site,
            squad=squad,
        )
        if summary and "No qualifying" not in summary:
            scrub_summaries.append(summary)
    if scrub_summaries:
        focus_actions.append(
            "Scrubbed Ticket Focus: " + " ".join(scrub_summaries)
        )

    winner = identify_grain_winner(result)
    model_site = (
        normalize_text(winner.get("Site", ""))
        if winner is not None
        else ""
    )
    positive_squads = _email_top_squad_names(
        result,
        model_site,
        "positive",
        5,
