def calculate_weekly_metric(
    scope_df: pd.DataFrame,
    data_through: pd.Timestamp,
    report_start: pd.Timestamp,
    report_end: pd.Timestamp,
    allow_projection: bool,
    scope_name: str,
    config: AppConfig = CONFIG,
    baseline_period_keys: Optional[Sequence[pd.Timestamp]] = None,
) -> PeriodMetric:
    """
    Calculate the leadership Weekly view using one fixed calendar rule.

    Every reporting week starts on Sunday and ends on Saturday. No month
    boundary, anchor-date rule, latest-minus-one rule, or Monday safeguard may
    change the selected week.
    """
    selected_week_start = sunday_week_start(
        pd.Timestamp(report_start).normalize()
    )
    selected_week_end = selected_week_start + pd.Timedelta(days=6)

    supplied_end = pd.Timestamp(report_end).normalize()
    if supplied_end != selected_week_end:
        LOGGER.warning(
            "Weekly report_end %s was normalized to Saturday %s for the "
            "Sunday-Saturday reporting rule.",
            supplied_end.strftime("%Y-%m-%d"),
            selected_week_end.strftime("%Y-%m-%d"),
        )

    latest_available_date = pd.Timestamp(data_through).normalize()
    if latest_available_date < selected_week_start:
        raise ValueError(
            "Weekly data-through date is earlier than the selected Sunday. "
            f"Week: {selected_week_start:%Y-%m-%d} to "
            f"{selected_week_end:%Y-%m-%d}; "
            f"data through: {latest_available_date:%Y-%m-%d}."
        )

    weekly_data_through = min(
        latest_available_date,
        selected_week_end,
    )
    current_period_start = selected_week_start
    current_period_end = weekly_data_through

    current_df = scope_df[
        scope_df["Date"].between(
            current_period_start,
            current_period_end,
            inclusive="both",
        )
    ].copy()
    actual_positive, actual_responses, actual_rate = weighted_totals(
        current_df
    )

    weekly = aggregate_by_week(scope_df)
    if baseline_period_keys is None:
        prior_weeks = (
            weekly.loc[
                weekly["Week End"].lt(selected_week_start),
                "Week Start",
            ]
            .drop_duplicates()
            .sort_values()
            .tail(config.weekly_baseline_periods)
            .tolist()
        )
    else:
        prior_weeks = sorted(
            {
                sunday_week_start(pd.Timestamp(value).normalize())
                for value in baseline_period_keys
                if pd.notna(value)
                and sunday_week_start(pd.Timestamp(value).normalize())
                < selected_week_start
            }
        )[-config.weekly_baseline_periods:]

    baseline_df = scope_df[
        scope_df["Week Start"].isin(prior_weeks)
    ].copy()
    baseline_positive, baseline_responses, baseline_rate = weighted_totals(
        baseline_df
    )
    delta = (
        actual_rate - baseline_rate
        if pd.notna(actual_rate) and pd.notna(baseline_rate)
        else np.nan
    )

    is_incomplete = bool(
        allow_projection
        and weekly_data_through < selected_week_end
    )
    projected_rate = np.nan
    projected_positive = np.nan
    projected_responses = np.nan
    projected_delta = np.nan
    remaining_days = 0
    projection_basis = "Period complete"

    if is_incomplete:
        projection = project_remaining_dates(
            scope_df=scope_df,
            actual_positive=actual_positive,
            actual_responses=actual_responses,
            data_through=weekly_data_through,
            projection_end=selected_week_end,
            config=config,
        )
        projected_positive = projection["projected_positive"]
        projected_responses = projection["projected_responses"]
        projected_rate = projection["projected_rate"]
        projected_delta = (
            projected_rate - baseline_rate
            if pd.notna(projected_rate) and pd.notna(baseline_rate)
            else np.nan
        )
        remaining_days = int(projection["remaining_days"])
        projection_basis = projection["projection_basis"]

    completed_chart = weekly[
        weekly["Week End"].lt(selected_week_start)
    ].tail(max(0, config.weekly_chart_periods - 1)).copy()
    completed_chart["Period Label"] = build_week_period_labels(
        completed_chart
    )
    completed_chart["Is Current"] = False
    completed_chart["Is Projected"] = False
    completed_chart["Projected Rate"] = np.nan

    current_chart_row = pd.DataFrame(
        [
            {
                "Week Start": selected_week_start,
                "Week End": selected_week_end,
                "Positive": actual_positive,
                "Responses": actual_responses,
                "Actual Rate": actual_rate,
                "Period Label": week_beginning_chart_label(
                    selected_week_start
                ),
                "Is Current": True,
                "Is Projected": bool(is_incomplete),
                "Projected Rate": projected_rate,
            }
        ]
    )
    chart_df = pd.concat(
        [completed_chart, current_chart_row],
        ignore_index=True,
        sort=False,
    )

    period_label = (
        f"{week_beginning_chart_label(selected_week_start)} "
        f"({selected_week_start.strftime('%m/%d/%Y')}–"
        f"{selected_week_end.strftime('%m/%d/%Y')})"
    )
    if is_incomplete:
        period_label += (
            f" through {weekly_data_through.strftime('%m/%d/%Y')}"
        )

    return PeriodMetric(
        grain="WEEKLY",
        scope_name=scope_name,
        period_label=period_label,
        period_start=selected_week_start,
        period_end=selected_week_end,
        data_through=weekly_data_through,
        actual_rate=actual_rate,
        actual_positive=actual_positive,
        actual_responses=actual_responses,
        baseline_rate=baseline_rate,
        baseline_positive=baseline_positive,
        baseline_responses=baseline_responses,
        delta=delta,
        baseline_period_count=len(prior_weeks),
        is_incomplete=is_incomplete,
        projected_rate=projected_rate,
        projected_positive=projected_positive,
        projected_responses=projected_responses,
        projected_delta=projected_delta,
        remaining_days=remaining_days,
        projection_basis=projection_basis,
        chart_df=chart_df,
        baseline_period_keys=[
            pd.Timestamp(value).normalize()
            for value in prior_weeks
        ],
        baseline_observed_period_count=int(
            baseline_df["Week Start"].dropna().nunique()
        ),
    )

def _human_join(values: Sequence[str], empty_text: str = "") -> str:
    cleaned = [normalize_text(value) for value in values if normalize_text(value)]
    if not cleaned:
        return empty_text
    if len(cleaned) == 1:
        return cleaned[0]
    if len(cleaned) == 2:
        return f"{cleaned[0]} and {cleaned[1]}"
    return ", ".join(cleaned[:-1]) + f", and {cleaned[-1]}"


def _grain_period_heading(metric: PeriodMetric) -> str:
    if metric.grain == "DAILY":
        return f"Latest Date — {metric.period_label}"
    if metric.grain == "WEEKLY":
        return f"Latest Week — {metric.period_label}"
    return f"Current Month — {metric.period_label}"


def _period_target_smileys_needed(
    metric: Optional[PeriodMetric],
    target_rate: float,
) -> int:
    if metric is None:
        return 0
    if metric.is_incomplete and pd.notna(metric.projected_responses):
        responses = float(metric.projected_responses)
        positive = (
            float(metric.projected_positive)
            if pd.notna(metric.projected_positive)
            else float(metric.actual_positive)
        )
    else:
        responses = float(metric.actual_responses)
        positive = float(metric.actual_positive)
    if not np.isfinite(responses) or responses <= 0:
        return 0
    if not np.isfinite(positive):
        positive = 0.0
    return max(int(math.ceil(target_rate * responses - positive)), 0)


def _top_site_rows(
    grain_result: GrainResult,
    direction: str,
    limit: int = 3,
    config: AppConfig = CONFIG,
) -> pd.DataFrame:
    table = filter_rows_to_approved_sites(
        grain_result.site_summary,
        config,
    )
    if table.empty:
        return table
    table["Official Impact"] = pd.to_numeric(
        table["Official Impact"], errors="coerce"
    )
    table["Responses"] = pd.to_numeric(table["Responses"], errors="coerce").fillna(0)
    table = table[table["Official Impact"].notna()]
    if direction.lower() == "positive":
        table = table[table["Official Impact"].gt(0)].sort_values(
            ["Official Impact", "Responses"],
            ascending=[False, False],
        )
    else:
        table = table[table["Official Impact"].lt(0)].sort_values(
            ["Official Impact", "Responses"],
            ascending=[True, False],
        )
    return table.head(max(1, int(limit))).reset_index(drop=True)


def _top_squads_for_site_grain(
    grain_result: GrainResult,
    site: str,
    direction: str,
    limit: int = 3,
) -> pd.DataFrame:
    table = grain_result.squad_summary
    if table is None or table.empty:
        return pd.DataFrame()
    work = table[table["Site"].astype(str).eq(str(site))].copy()
    if work.empty:
        return work
    work["Official Impact"] = pd.to_numeric(
        work["Official Impact"], errors="coerce"
    )
    work["Responses"] = pd.to_numeric(
        work["Responses"], errors="coerce"
    ).fillna(0)
    if direction.lower() == "positive":
        work = work[work["Official Impact"].gt(0)].sort_values(
            ["Official Impact", "Responses"],
            ascending=[False, False],
        )
    else:
        work = work[work["Official Impact"].lt(0)].sort_values(
            ["Official Impact", "Responses"],
            ascending=[True, False],
        )
    return work.head(max(1, int(limit))).reset_index(drop=True)


def build_overall_grain_driver_narrative(
    grain_result: GrainResult,
    report_scope: Mapping[str, Any],
    config: AppConfig = CONFIG,
) -> Dict[str, Any]:
    """
    Build the VP-approved, email-ready all-site narrative for one grain.

    The paragraph structure follows the requested Executive Summary style:
    result -> primary drag -> supporting drivers -> recommended action.
    Detailed rankings remain in the supporting tables.
    """
    metric = grain_result.overall
    grain = metric.grain.upper()
    period_label = {
        "DAILY": "Latest Date",
        "WEEKLY": "Latest Week",
        "MONTHLY": "Current Month",
    }[grain]

    negative_sites = _top_site_rows(
        grain_result, "negative", 3, config=config
    )
    positive_sites = _top_site_rows(
        grain_result, "positive", 3, config=config
    )

    lead_negative_site = ""
    negative_squad_names: List[str] = []
    supporting_negative_sites: List[str] = []

    if not negative_sites.empty:
        lead_negative = negative_sites.iloc[0]
        lead_negative_site = normalize_text(lead_negative.get("Site", ""))
        supporting_negative_sites = [
            normalize_text(value)
            for value in negative_sites["Site"].iloc[1:].tolist()
            if normalize_text(value)
        ]
        negative_squads = _top_squads_for_site_grain(
            grain_result,
            lead_negative_site,
            "negative",
            3,
        )
        negative_squad_names = (
            negative_squads["Squad Code"].astype(str).tolist()
            if not negative_squads.empty
            else []
        )

        focus_title = (
            f"1. Site Focus: {lead_negative_site} — Primary Drag for {period_label}"
        )
        focus_sentences = [
            (
                f"Overall performance for the {period_label.lower()} was "
                f"{format_rate(metric.actual_rate)}, {movement_phrase(metric.delta)} "
                f"versus the preceding {metric.baseline_period_count}-period average "
                f"across {format_int(metric.actual_responses)} responses."
            ),
            (
                f"{lead_negative_site} was the largest negative site driver at "
                f"{format_rate(lead_negative.get('Smiley Rate'))} across "
                f"{format_int(lead_negative.get('Responses'))} responses, with "
                f"{format_pp(lead_negative.get('Official Impact'))} impact on the "
                "overall result."
            ),
        ]
        if supporting_negative_sites:
            focus_sentences.append(
                f"Additional pressure came from "
                f"{_human_join(supporting_negative_sites)}."
            )
        if negative_squad_names:
            focus_sentences.append(
                f"Within {lead_negative_site}, the main squad risks were "
                f"{_human_join(negative_squad_names)}."
            )
        focus_sentences.append(
            f"Recommended action: review the highest-volume non-smiley contacts in "
            f"{lead_negative_site}, prioritize "
            f"{_human_join(negative_squad_names, 'the leading negative squads')}, "
            "and confirm the contact and QA drivers before scaling corrective action."
        )
    else:
        focus_title = f"1. Site Focus — {period_label}"
        focus_sentences = [
            (
                f"Overall performance for the {period_label.lower()} was "
                f"{format_rate(metric.actual_rate)}, {movement_phrase(metric.delta)} "
                f"versus the preceding {metric.baseline_period_count}-period average "
                f"across {format_int(metric.actual_responses)} responses."
            ),
            "No site produced a qualifying negative estimated impact in this period.",
            (
                "Recommended action: protect current controls and continue monitoring "
                "low-volume directional movement before treating it as a sustained risk."
            ),
        ]

    lead_positive_site = ""
    positive_squad_names: List[str] = []
    other_positive_sites: List[str] = []

    high_title = f"2. High Performers & Model Sites — {period_label}"
    if not positive_sites.empty:
        lead_positive = positive_sites.iloc[0]
        lead_positive_site = normalize_text(lead_positive.get("Site", ""))
        other_positive_sites = [
            normalize_text(value)
            for value in positive_sites["Site"].iloc[1:].tolist()
            if normalize_text(value)
        ]
        positive_squads = _top_squads_for_site_grain(
            grain_result,
            lead_positive_site,
            "positive",
            3,
        )
        positive_squad_names = (
            positive_squads["Squad Code"].astype(str).tolist()
            if not positive_squads.empty
            else []
        )

        high_sentences = [
            (
                f"{lead_positive_site} delivered the strongest positive site impact "
                f"at {format_rate(lead_positive.get('Smiley Rate'))} across "
                f"{format_int(lead_positive.get('Responses'))} responses."
            ),
        ]
        if other_positive_sites:
            high_sentences.append(
                f"{_human_join(other_positive_sites)} also helped stabilize the "
                "overall result."
            )
        if positive_squad_names:
            high_sentences.append(
                f"The leading model squads within {lead_positive_site} were "
                f"{_human_join(positive_squad_names)}."
            )
        high_sentences.append(
            "Recommended action: capture the validated handling and coaching "
            "practices from these sites and squads, replicate them in the focus "
            "population, and protect high-volume positive performance."
        )
    else:
        high_sentences = [
            "No site produced a qualifying positive estimated impact in this period.",
            (
                "Recommended action: stabilize the primary negative site first, then "
                "identify repeatable practices once positive movement reaches "
                "reportable volume."
            ),
        ]

    focus_label = lead_negative_site or "the primary focus site"
    squad_label = _human_join(negative_squad_names, "the priority squads")
    positive_label = lead_positive_site or "the leading positive sites"

    if grain == "DAILY":
        # The latest-date view is a completed snapshot. Per VP direction, it has
        # no separate Immediate Action / Final Push block.
        action_title = ""
        action_sentences = []
    elif grain == "WEEKLY" and metric.is_incomplete:
        smileys_needed = _period_target_smileys_needed(metric, config.target_rate)
        action_title = "3. Final Push for Week-End"
        action_sentences = [
            (
                f"Through {pd.Timestamp(metric.data_through).strftime('%A, %B %d')}, "
