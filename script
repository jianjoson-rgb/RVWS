]


def _ticket_age_bucket_order_v548(
    config: AppConfig = CONFIG,
) -> List[str]:
    """Return the configured ticket-age bucket order with safe defaults."""
    configured = list(
        getattr(
            config,
            "ticket_age_bucket_order",
            (
                "1 day",
                "2 days",
                "3 days",
                "4 days",
                "5 days",
                "6 days",
                "7 days",
                ">7 days",
            ),
        )
    )
    return [normalize_text(value) for value in configured if normalize_text(value)]


def _normalize_ticket_age_bucket_v548(value: Any) -> str:
    """
    Normalize raw Ticket Age values into the approved buckets:
      1 day, 2 days, 3 days, 4 days, 5 days, 6 days, 7 days, >7 days.
    """
    raw = normalize_text(value)
    if not raw:
        return ""

    text_value = raw.casefold()
    text_value = text_value.replace("＋", "+")
    compact = re.sub(r"\s+", "", text_value)

    if (
        compact.startswith(">7")
        or compact.startswith("7+")
        or compact in {"morethan7", "morethan7days", "over7", "over7days"}
        or "greaterthan7" in compact
        or "morethan7" in compact
        or "over7" in compact
    ):
        return ">7 days"

    number_match = re.search(r"\d+", compact)
    if not number_match:
        return ""

    try:
        number = int(number_match.group(0))
    except Exception:
        return ""

    if 1 <= number <= 7:
        return "1 day" if number == 1 else f"{number} days"
    if number > 7:
        return ">7 days"
    return ""


def _ticket_age_prepare_source_v548(
    source_df: pd.DataFrame,
    config: AppConfig = CONFIG,
) -> pd.DataFrame:
    """Prepare source rows for deterministic Ticket Age response-mix aggregation."""
    if source_df is None or source_df.empty:
        return pd.DataFrame()

    ticket_age_column = normalize_text(
        getattr(config, "ticket_age_column", "Ticket Age")
    ) or "Ticket Age"

    if ticket_age_column not in source_df.columns:
        return pd.DataFrame()

    work = source_df.copy()

    if "Responses" not in work.columns:
        work["Responses"] = 0.0
    work["Responses"] = pd.to_numeric(work["Responses"], errors="coerce").fillna(0.0)

    if "Smiley Numerator" not in work.columns:
        fallback_outcome = _squad_outcome_series_v531(work)
        work["Smiley Numerator"] = np.where(
            fallback_outcome.eq("Smiley"),
            work["Responses"],
            0.0,
        )
    work["Smiley Numerator"] = pd.to_numeric(
        work["Smiley Numerator"],
        errors="coerce",
    ).fillna(0.0)

    work["_Ticket Age Bucket"] = work[ticket_age_column].map(
        _normalize_ticket_age_bucket_v548
    )
    work["_Ticket Age Outcome"] = _squad_outcome_series_v531(work)

    bucket_order = set(_ticket_age_bucket_order_v548(config))
    work = work[
        work["_Ticket Age Bucket"].isin(bucket_order)
        & work["_Ticket Age Outcome"].isin(["Smiley", "Neutral", "Frownie"])
        & work["Responses"].gt(0)
    ].copy()
    return work


def build_ticket_age_impact_table_v548(
    source_df: pd.DataFrame,
    scope_name: str,
    config: AppConfig = CONFIG,
) -> pd.DataFrame:
    """
    Build a compact Ticket Age Impact table.

    Smiley Rate uses the approved ratio-of-sums approach:
        SUM Smiley Numerator / SUM Responses

    Non-Smiley Share uses:
        bucket Neutral + Frownie / total Neutral + Frownie in the same scope
    """
    columns = [
        "Scope",
        "Ticket Age",
        "Rated",
        "Neutral",
        "Frownie",
        "Smiley",
        "Non-Smiley",
        "Smiley Rate",
        "Non-Smiley Share",
        "Sample",
    ]

    work = _ticket_age_prepare_source_v548(source_df, config)
    if work.empty:
        return pd.DataFrame(columns=columns)

    total_non_smiley = float(
        work.loc[
            work["_Ticket Age Outcome"].isin(["Neutral", "Frownie"]),
            "Responses",
        ].sum()
    )

    rows: List[Dict[str, Any]] = []
    for bucket in _ticket_age_bucket_order_v548(config):
        group = work[work["_Ticket Age Bucket"].eq(bucket)]
        if group.empty:
            continue

        rated = float(pd.to_numeric(group["Responses"], errors="coerce").fillna(0).sum())
        smiley = float(
            pd.to_numeric(group["Smiley Numerator"], errors="coerce").fillna(0).sum()
        )
        neutral = float(
            pd.to_numeric(
                group.loc[group["_Ticket Age Outcome"].eq("Neutral"), "Responses"],
                errors="coerce",
            ).fillna(0).sum()
        )
        frownie = float(
            pd.to_numeric(
                group.loc[group["_Ticket Age Outcome"].eq("Frownie"), "Responses"],
                errors="coerce",
            ).fillna(0).sum()
        )
        non_smiley = neutral + frownie

        rows.append(
            {
                "Scope": normalize_text(scope_name) or "Overall",
                "Ticket Age": bucket,
                "Rated": rated,
                "Neutral": neutral,
                "Frownie": frownie,
                "Smiley": smiley,
                "Non-Smiley": non_smiley,
                "Smiley Rate": safe_rate(smiley, rated),
                "Non-Smiley Share": safe_rate(non_smiley, total_non_smiley),
                "Sample": sample_size_label(rated),
            }
        )

    if not rows:
        return pd.DataFrame(columns=columns)

    output = pd.DataFrame(rows, columns=columns)
    output["_Ticket Age Sort"] = output["Ticket Age"].map(
        {bucket: index for index, bucket in enumerate(_ticket_age_bucket_order_v548(config))}
    )
    output = output.sort_values("_Ticket Age Sort", na_position="last")
    return output.drop(columns=["_Ticket Age Sort"], errors="ignore").reset_index(drop=True)


def _ticket_age_rows_v548(
    impact_df: pd.DataFrame,
) -> List[List[str]]:
    """Format Ticket Age Impact rows for the Google Docs source table."""
    if impact_df is None or impact_df.empty:
        return []

    rows: List[List[str]] = []
    for _, row in impact_df.iterrows():
        rows.append(
            [
                normalize_text(row.get("Ticket Age", "")),
                format_int(row.get("Rated", 0)),
                format_int(row.get("Neutral", 0)),
                format_int(row.get("Frownie", 0)),
                format_int(row.get("Smiley", 0)),
                format_rate(row.get("Smiley Rate", np.nan)),
                format_rate(row.get("Non-Smiley Share", np.nan)),
                normalize_text(row.get("Sample", "")),
            ]
        )
    return rows


def _ticket_age_narrative_v548(
    scope_name: str,
    impact_df: pd.DataFrame,
    config: AppConfig = CONFIG,
) -> str:
    """Build a short business-readable Ticket Age Impact callout."""
    scope_label = normalize_text(scope_name) or "Overall"
    ticket_age_column = normalize_text(
        getattr(config, "ticket_age_column", "Ticket Age")
    ) or "Ticket Age"

