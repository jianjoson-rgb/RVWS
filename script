def build_email_table_images_v560(
    scope_analyses: Mapping[str, FinanceQAScopeAnalysis],
    output_dir: Path,
    config: AppConfig = CONFIG,
) -> List[Dict[str, str]]:
    """
    Generate eight Overall-only email table images.

    Output order is metric-first for executive readability:
    all Smiley Rate views first, followed by all Unhappy Rate views.
    """
    if (
        not config.email_body_include_trend_table_images
        or not scope_analyses
    ):
        return []

    overall_analysis = scope_analyses.get("OVERALL")
    if overall_analysis is None:
        LOGGER.warning(
            "Overall timeframe analysis is unavailable; "
            "email table images were not generated."
        )
        return []

    output_root = Path(output_dir) / "email_timeframe_table_images"
    output_root.mkdir(parents=True, exist_ok=True)

    specs = _scope_timeframe_table_image_specs_v560(overall_analysis)
    metric_order = {"SMILEY RATE": 0, "UNHAPPY RATE": 1}
    section_order = {
        "BY MONTH — ROLLING 4 MONTHS": 0,
        "BY TIME OF DAY — UTC": 1,
        "BY DAY OF WEEK — UTC": 2,
        "BY DAY OF MONTH — UTC": 3,
    }
    specs = sorted(
        specs,
        key=lambda spec: (
            metric_order.get(normalize_text(spec.get("metric", "")).upper(), 99),
            section_order.get(normalize_text(spec.get("section", "")).upper(), 99),
        ),
    )

    results: List[Dict[str, str]] = []
    for index, spec in enumerate(specs, start=1):
        metric = normalize_text(spec["metric"])
        section = normalize_text(spec["section"])
        image_title = f"Overall — {section} — {metric}"
        image_filename = safe_filename(
            f"Overall_{index:02d}_{metric}_{section}.png"
        )
        image_path = _build_docx_table_image_v560(
            title=image_title,
            subtitle=normalize_text(spec.get("subtitle", "")),
            headers=spec["headers"],
            rows=spec["rows"],
            output_path=str(output_root / image_filename),
            config=config,
        )
        results.append(
            {
                "scope": "Overall",
                "title": image_title,
                "section": section,
                "metric": metric,
                "path": image_path,
            }
        )

    if len(results) != 8:
        raise RuntimeError(
            "Expected 8 Overall email table images "
            f"but generated {len(results)}."
        )

    LOGGER.info(
        "Generated %s Overall email timeframe table images "
        "grouped by metric.",
        len(results),
    )
    return results



def _email_metric_rate_v563(
    row: Mapping[str, Any],
    metric: str,
    prefix: str = "All",
    previous: bool = False,
) -> float:
    """Return a 0-1 Smiley/Unhappy rate from a timing or monthly row."""
    metric_key = normalize_text(metric).upper()
    lead = "Previous " if previous else ""
    direct = f"{lead}{prefix} {'Smiley Rate' if metric_key == 'SMILEY RATE' else 'Unhappy Rate'}"
    value = pd.to_numeric(pd.Series([row.get(direct)]), errors="coerce").iloc[0]
    if pd.notna(value):
        return float(value)

    inverse = f"{lead}{prefix} {'Unhappy Rate' if metric_key == 'SMILEY RATE' else 'Smiley Rate'}"
    inverse_value = pd.to_numeric(
        pd.Series([row.get(inverse)]), errors="coerce"
    ).iloc[0]
    if pd.notna(inverse_value):
        return float(1.0 - inverse_value)
    return np.nan


def _email_metric_segment_callout_v563(
    frame: pd.DataFrame,
    label_column: str,
    metric: str,
    config: AppConfig = CONFIG,
) -> str:
    """Create a concise segment-level movement callout versus the prior window."""
    if frame is None or frame.empty or label_column not in frame.columns:
        return "No comparable segment data is available for this view."

    higher_is_better = normalize_text(metric).upper() == "SMILEY RATE"
    threshold = _status_threshold_pp(config)
    moves: List[Dict[str, Any]] = []

    for _, row in frame.iterrows():
        label = normalize_text(row.get(label_column, ""))
        current_rated = pd.to_numeric(
            pd.Series([row.get("All Rated")]), errors="coerce"
        ).iloc[0]
        previous_rated = pd.to_numeric(
            pd.Series([row.get("Previous All Rated")]), errors="coerce"
        ).iloc[0]
        current_rate = _email_metric_rate_v563(row, metric, "All", False)
        previous_rate = _email_metric_rate_v563(row, metric, "All", True)

        if (
            not label
            or pd.isna(current_rated)
            or pd.isna(previous_rated)
            or float(current_rated) <= 0
            or float(previous_rated) <= 0
            or pd.isna(current_rate)
            or pd.isna(previous_rate)
        ):
            continue

        raw_delta = (current_rate - previous_rate) * 100
        performance_delta = raw_delta if higher_is_better else -raw_delta
        if abs(performance_delta) < threshold:
            status = "Stable"
        elif performance_delta > 0:
            status = "Improving"
        else:
            status = "Regressing"
        moves.append(
            {
                "label": label,
                "raw_delta": raw_delta,
                "performance_delta": performance_delta,
                "status": status,
            }
        )

    if not moves:
        return "No segments have sufficient current and previous volume for a reliable comparison."

    improving = [m for m in moves if m["status"] == "Improving"]
    regressing = [m for m in moves if m["status"] == "Regressing"]
    stable = [m for m in moves if m["status"] == "Stable"]

    phrases: List[str] = []
    if improving:
        best = max(improving, key=lambda x: x["performance_delta"])
        phrases.append(
            f"Strongest improvement: {best['label']} "
            f"({best['raw_delta']:+.1f} pp)"
        )
    if regressing:
        worst = min(regressing, key=lambda x: x["performance_delta"])
        phrases.append(
            f"Primary regression: {worst['label']} "
            f"({worst['raw_delta']:+.1f} pp)"
        )
    if not improving and not regressing:
        phrases.append(
            f"All {len(stable)} comparable segment"
            f"{'s' if len(stable) != 1 else ''} remained stable"
        )
    elif stable:
        phrases.append(
            f"{len(stable)} additional comparable segment"
            f"{'s' if len(stable) != 1 else ''} remained stable"
        )
    return ". ".join(phrases) + "."


def _email_month_callout_v563(
    frame: pd.DataFrame,
    metric: str,
    config: AppConfig = CONFIG,
) -> str:
    """Summarize the latest two available months in the rolling-month table."""
    if frame is None or frame.empty or len(frame.index) < 2:
        return "Insufficient monthly history for a month-over-month callout."

    valid: List[Tuple[str, float]] = []
    for _, row in frame.iterrows():
        label = normalize_text(row.get("Month", ""))
        rate = _email_metric_rate_v563(row, metric, "All", False)
        rated = pd.to_numeric(
            pd.Series([row.get("All Rated")]), errors="coerce"
        ).iloc[0]
        if label and pd.notna(rate) and pd.notna(rated) and float(rated) > 0:
            valid.append((label, rate))
    if len(valid) < 2:
        return "Insufficient monthly history for a month-over-month callout."

    previous_label, previous_rate = valid[-2]
    current_label, current_rate = valid[-1]
    raw_delta = (current_rate - previous_rate) * 100
    higher_is_better = normalize_text(metric).upper() == "SMILEY RATE"
    performance_delta = raw_delta if higher_is_better else -raw_delta
    threshold = _status_threshold_pp(config)
    status = (
        "Stable"
        if abs(performance_delta) < threshold
        else ("Improving" if performance_delta > 0 else "Regressing")
    )
    return (
        f"{current_label} is {status.lower()} versus {previous_label}: "
        f"{format_rate(current_rate)} ({raw_delta:+.1f} pp)."
    )


