        grain_result=sharp_result,
        config=config,
        limit=1,
    ) if sharp_result is not None else pd.DataFrame()
    squad_text = "the top site squad driver"
    if squad_rows is not None and not squad_rows.empty:
        squad = normalize_text(squad_rows.iloc[0].get("Squad Code", ""))
        if squad:
            squad_text = squad

    return [
        [
            _email_v551_seg("Performance signal: "),
            _email_v551_seg(site_key, bold=True),
            _email_v551_seg(f" {signal.lower()} across {active_text}, with the sharpest movement in "),
            _email_v551_seg(sharp.title() if sharp else "the selected grain", bold=True),
            _email_v551_seg(" at "),
            _email_v551_seg(format_rate(rate), color=_email_v551_rate_color(rate), bold=True),
            _email_v551_seg(", "),
            _email_v551_seg(format_pp(delta), color=_email_v551_delta_color(delta), bold=True),
            _email_v551_seg(" vs rolling baseline"),
            _email_v551_seg(", "),
            _email_v551_seg(format_pp(overall_gap), color=_email_v551_delta_color(overall_gap), bold=True),
            _email_v551_seg(f" vs same-period overall benchmark across {format_int(responses)} rated responses."),
        ],
        [
            _email_v551_seg("Non-Smiley driver signal: Site Non-Smiley pressure is mainly tied to "),
            _email_v551_seg(
                _email_v565_format_path_signal(non_smiley_path, "no available Non-Smiley deep-dive signal"),
                color=EMAIL_V551_RED if non_smiley_path.get("available") else EMAIL_V551_GRAY,
                bold=True,
            ),
            _email_v551_seg(
                f", representing {format_rate(non_smiley_path.get('share', np.nan), 1)} of the site's Non-Smiley surveys."
                if non_smiley_path.get("available")
                else "."
            ),
        ],
        [
            _email_v551_seg("QA signal: "),
            _email_v551_seg(qa_focus, bold=True),
            _email_v551_seg(" are the top site-specific coaching behaviors connected to the movement."),
        ],
        [
            _email_v551_seg("Bottom line: prioritize "),
            _email_v551_seg(squad_text, color=EMAIL_V551_RED, bold=True),
            _email_v551_seg(" within "),
            _email_v551_seg(site_key, color=EMAIL_V551_RED, bold=True),
            _email_v551_seg(", coach "),
            _email_v551_seg(qa_focus, bold=True),
            _email_v551_seg(", and validate the same-period site driver table before the next action cycle."),
