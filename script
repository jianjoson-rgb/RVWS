def _qa_attribute_columns_available_v549(
    source_df: Optional[pd.DataFrame],
) -> List[str]:
    """Return normalized QA attribute columns available in the source frame."""
    if source_df is None or not isinstance(source_df, pd.DataFrame):
        return []
    return [column for column in QA_ATTRIBUTE_COLUMNS if column in source_df.columns]


def _qa_attribute_prepare_source_v549(
    source_df: pd.DataFrame,
    config: AppConfig = CONFIG,
) -> pd.DataFrame:
    """
    Prepare source rows for QA Attribute Impact.

    QA columns are scored as:
      1 = pass
      0 = fail
      blank/invalid = excluded from that attribute denominator

    Smiley/non-smiley performance uses the same response-weighted
    SUM Smiley Numerator / SUM Responses style as the rest of the report.
    """
    del config

    if source_df is None or source_df.empty:
        return pd.DataFrame()

    work = source_df.copy()

    if "Responses" not in work.columns:
        work["Responses"] = 0.0
    work["Responses"] = pd.to_numeric(
        work["Responses"],
        errors="coerce",
    ).fillna(0.0)

    if "Smiley Numerator" not in work.columns:
        fallback_outcome = _squad_outcome_series_v531(work)
        work["Smiley Numerator"] = np.where(
            fallback_outcome.eq("Smiley"),
            work["Responses"],
            0.0,
        )
    work["Smiley Numerator"] = pd.to_numeric(
        work["Smiley Numerator"],
        errors="coerce",
    ).fillna(0.0)

    work["_QA Outcome"] = _squad_outcome_series_v531(work)
    work = work[
        work["Responses"].gt(0)
        & work["_QA Outcome"].isin(["Smiley", "Neutral", "Frownie"])
    ].copy()
    if work.empty:
        return pd.DataFrame()

    for column in QA_ATTRIBUTE_COLUMNS:
        if column not in work.columns:
            work[column] = np.nan
        raw_numeric = pd.to_numeric(work[column], errors="coerce")
        work[column] = raw_numeric.where(raw_numeric.isin([0, 1]), np.nan)

    return work


def _qa_attribute_teammate_key_v549(work: pd.DataFrame) -> pd.Series:
    """Build a site-aware teammate key so Overall does not merge same-name employees across sites."""
    if work is None or work.empty or "Employee Name" not in work.columns:
        return pd.Series("", index=getattr(work, "index", None), dtype="object")

    employee = (
        work["Employee Name"]
        .fillna("")
        .astype(str)
        .map(normalize_text)
    )

    if "Site" in work.columns:
        site = (
            work["Site"]
            .fillna("")
            .astype(str)
            .map(normalize_text)
        )
        key = site.str.upper() + "||" + employee.str.casefold()
    else:
        key = employee.str.casefold()

    key = key.where(employee.ne(""), "")
    return key.astype("object")


def _qa_attribute_teammate_performance_group_v549(
    work: pd.DataFrame,
    target_rate: float = 0.80,
) -> pd.Series:
    """
    Classify rows by teammate Smiley performance in the same analysis population.

    Output labels:
      >=80%
      <80%

    Blank employee names or teammates without rated volume return blank and are
    excluded from the teammate QA comparison columns.
    """
    if work is None or work.empty:
        return pd.Series(dtype="object")

    key = _qa_attribute_teammate_key_v549(work)
    valid = key.ne("") & pd.to_numeric(work["Responses"], errors="coerce").fillna(0).gt(0)
    if not bool(valid.any()):
        return pd.Series("", index=work.index, dtype="object")

    grouped = (
        work.loc[valid]
        .assign(_QA_TM_Key=key.loc[valid])
        .groupby("_QA_TM_Key", dropna=False)
        .agg(
            _Smiley=("Smiley Numerator", "sum"),
            _Rated=("Responses", "sum"),
        )
    )
    grouped["_Rate"] = grouped.apply(
        lambda row: safe_rate(row["_Smiley"], row["_Rated"]),
        axis=1,
    )

    group_map = grouped["_Rate"].map(
        lambda rate: (
            ">=80%"
            if pd.notna(rate) and float(rate) >= float(target_rate)
            else "<80%"
        )
    )
    return key.map(group_map).fillna("").astype("object")


def _qa_attribute_weighted_smiley_rate_v549(
    frame: pd.DataFrame,
) -> float:
    """Return response-weighted Smiley Rate for an already-filtered frame."""
    if frame is None or frame.empty:
        return np.nan
    smiley = float(
        pd.to_numeric(
            frame.get("Smiley Numerator", pd.Series(dtype="float64")),
            errors="coerce",
        ).fillna(0.0).sum()
    )
    rated = float(
        pd.to_numeric(
            frame.get("Responses", pd.Series(dtype="float64")),
            errors="coerce",
        ).fillna(0.0).sum()
    )
    return safe_rate(smiley, rated)


def _qa_attribute_pass_rate_for_mask_v549(
    work: pd.DataFrame,
    column: str,
    mask: pd.Series,
) -> float:
    """Return QA pass rate for one attribute and row mask."""
    if work is None or work.empty or column not in work.columns:
        return np.nan

    safe_mask = pd.Series(mask, index=work.index).fillna(False).astype(bool)
    values = work.loc[safe_mask, column]
    audited = int(values.notna().sum())
    passed = int(values.eq(1).sum())
    return safe_rate(passed, audited)


def _qa_attribute_focus_label_v549(
    row: pd.Series,
    primary_attributes: set[str],
    min_audits: int,
) -> str:
    """Return a compact action label for the QA attribute impact table."""
    audited = float(pd.to_numeric(pd.Series([row.get("Audited", 0)]), errors="coerce").iloc[0] or 0)
    if audited < min_audits:
        return "Directional"

    attribute = normalize_text(row.get("QA Attribute", ""))
    gap = pd.to_numeric(pd.Series([row.get("Gap", np.nan)]), errors="coerce").iloc[0]
    tm_gap = pd.to_numeric(pd.Series([row.get("TM QA Gap", np.nan)]), errors="coerce").iloc[0]
    fail_rate = pd.to_numeric(pd.Series([row.get("Fail Rate", np.nan)]), errors="coerce").iloc[0]
    ns_share = pd.to_numeric(pd.Series([row.get("Non-Smiley Fail Share", np.nan)]), errors="coerce").iloc[0]

    gap_value = 0.0 if pd.isna(gap) else float(gap)
    tm_gap_value = 0.0 if pd.isna(tm_gap) else float(tm_gap)
    fail_rate_value = 0.0 if pd.isna(fail_rate) else float(fail_rate)
    ns_share_value = 0.0 if pd.isna(ns_share) else float(ns_share)

    if attribute in primary_attributes:
        return "Primary Driver"
    if gap_value >= 0.05 or tm_gap_value >= 0.05 or fail_rate_value >= 0.20:
        return "Coaching Focus"
    if ns_share_value >= 0.10 or fail_rate_value >= 0.10:
        return "Monitor"
    return "Stable"


def build_qa_attribute_impact_table_v549(
    source_df: pd.DataFrame,
    scope_name: str,
    config: AppConfig = CONFIG,
) -> pd.DataFrame:
    """
    Build the QA Attribute Impact table for one report scope.

    This table answers:
      - Which QA attributes fail most often?
      - Which failed attributes have the largest Smiley Rate gap?
      - Which failed attributes are most common on Non-Smiley outcomes?
      - Which QA attributes separate >=80% Smiley teammates from below-80% teammates?
    """
    columns = [
        "Scope",
        "QA Attribute",
        "Audited",
        "Fail Count",
        "Fail Rate",
        "Smiley When Passed",
        "Smiley When Failed",
        "Gap",
        "Non-Smiley Fail Count",
        "Non-Smiley Fail Share",
        ">=80% TM QA",
        "<80% TM QA",
        "TM QA Gap",
        "Focus",
    ]

    work = _qa_attribute_prepare_source_v549(source_df, config)
    if work.empty:
        return pd.DataFrame(columns=columns)

    qa_columns = _qa_attribute_columns_available_v549(work)
    if not qa_columns:
        return pd.DataFrame(columns=columns)

    target_rate = float(
        getattr(
            config,
            "qa_attribute_impact_smiley_target_rate",
            0.80,
        )
    )
    work["_QA TM Performance Group"] = _qa_attribute_teammate_performance_group_v549(
        work,
        target_rate=target_rate,
    )

    non_smiley_mask = work["_QA Outcome"].isin(["Neutral", "Frownie"])
    total_non_smiley_fail_count = 0
    for column in qa_columns:
        total_non_smiley_fail_count += int(
            (work[column].eq(0) & non_smiley_mask).sum()
        )

    rows: List[Dict[str, Any]] = []
    for column in qa_columns:
        values = work[column]
        audited_mask = values.notna()
        fail_mask = values.eq(0)
        pass_mask = values.eq(1)

        audited = int(audited_mask.sum())
        if audited <= 0:
            continue

        fail_count = int(fail_mask.sum())
        non_smiley_fail_count = int((fail_mask & non_smiley_mask).sum())

        passed_frame = work.loc[pass_mask].copy()
        failed_frame = work.loc[fail_mask].copy()

        smiley_when_passed = _qa_attribute_weighted_smiley_rate_v549(passed_frame)
        smiley_when_failed = _qa_attribute_weighted_smiley_rate_v549(failed_frame)
        smiley_gap = (
            float(smiley_when_passed) - float(smiley_when_failed)
            if pd.notna(smiley_when_passed) and pd.notna(smiley_when_failed)
            else np.nan
        )

        high_mask = work["_QA TM Performance Group"].eq(">=80%")
        below_mask = work["_QA TM Performance Group"].eq("<80%")
        high_tm_qa = _qa_attribute_pass_rate_for_mask_v549(
            work,
            column,
            high_mask,
        )
        below_tm_qa = _qa_attribute_pass_rate_for_mask_v549(
            work,
            column,
            below_mask,
        )
        tm_qa_gap = (
            float(high_tm_qa) - float(below_tm_qa)
            if pd.notna(high_tm_qa) and pd.notna(below_tm_qa)
            else np.nan
        )

        rows.append(
            {
                "Scope": normalize_text(scope_name) or "Overall",
                "QA Attribute": column,
                "Audited": audited,
                "Fail Count": fail_count,
                "Fail Rate": safe_rate(fail_count, audited),
                "Smiley When Passed": smiley_when_passed,
                "Smiley When Failed": smiley_when_failed,
                "Gap": smiley_gap,
                "Non-Smiley Fail Count": non_smiley_fail_count,
                "Non-Smiley Fail Share": safe_rate(
                    non_smiley_fail_count,
                    total_non_smiley_fail_count,
                ),
                ">=80% TM QA": high_tm_qa,
                "<80% TM QA": below_tm_qa,
                "TM QA Gap": tm_qa_gap,
                "Focus": "",
            }
        )

    if not rows:
        return pd.DataFrame(columns=columns)

    output = pd.DataFrame(rows, columns=columns)
    min_audits = int(
        getattr(
            config,
            "qa_attribute_impact_min_audits",
            getattr(config, "directional_n", 5),
        )
    )
    eligible = output[
        pd.to_numeric(output["Audited"], errors="coerce").fillna(0).ge(min_audits)
    ].copy()

    primary_attributes: set[str] = set()
    if not eligible.empty:
        gap_rank = eligible.copy()
        gap_rank["_Gap"] = pd.to_numeric(gap_rank["Gap"], errors="coerce").fillna(-1.0)
        gap_rank = gap_rank.sort_values(
            ["_Gap", "Fail Count", "Audited"],
            ascending=[False, False, False],
        )
        if not gap_rank.empty and float(gap_rank.iloc[0]["_Gap"]) > 0:
            primary_attributes.add(normalize_text(gap_rank.iloc[0]["QA Attribute"]))

        ns_rank = eligible.copy()
        ns_rank["_NS Share"] = pd.to_numeric(
            ns_rank["Non-Smiley Fail Share"],
            errors="coerce",
        ).fillna(0.0)
        ns_rank = ns_rank.sort_values(
            ["_NS Share", "Non-Smiley Fail Count", "Fail Count"],
            ascending=[False, False, False],
        )
        if not ns_rank.empty and float(ns_rank.iloc[0]["_NS Share"]) > 0:
            primary_attributes.add(normalize_text(ns_rank.iloc[0]["QA Attribute"]))

    output["Focus"] = output.apply(
        lambda row: _qa_attribute_focus_label_v549(
            row,
            primary_attributes=primary_attributes,
            min_audits=min_audits,
        ),
        axis=1,
    )

    focus_rank = {
        "Primary Driver": 0,
        "Coaching Focus": 1,
        "Monitor": 2,
        "Stable": 3,
        "Directional": 4,
    }
    output["_Focus Sort"] = output["Focus"].map(focus_rank).fillna(9)
    output["_Driver Score"] = (
        pd.to_numeric(output["Gap"], errors="coerce").fillna(0.0).clip(lower=0.0) * 100.0
        + pd.to_numeric(output["Non-Smiley Fail Share"], errors="coerce").fillna(0.0) * 50.0
        + pd.to_numeric(output["Fail Rate"], errors="coerce").fillna(0.0) * 25.0
        + pd.to_numeric(output["TM QA Gap"], errors="coerce").fillna(0.0).clip(lower=0.0) * 25.0
    )

    output = output.sort_values(
        ["_Focus Sort", "_Driver Score", "Audited"],
        ascending=[True, False, False],
        na_position="last",
    )
    return output.drop(
        columns=["_Focus Sort", "_Driver Score"],
        errors="ignore",
    ).reset_index(drop=True)


def _qa_attribute_impact_rows_v549(
    impact_df: pd.DataFrame,
) -> List[List[str]]:
    """Format QA Attribute Impact rows for Google Docs."""
    if impact_df is None or impact_df.empty:
        return []

    rows: List[List[str]] = []
    for _, row in impact_df.iterrows():
        gap_value = row.get("Gap", np.nan)
        tm_gap_value = row.get("TM QA Gap", np.nan)
        rows.append(
            [
                normalize_text(row.get("QA Attribute", "")),
                format_int(row.get("Audited", 0)),
                format_rate(row.get("Fail Rate", np.nan)),
                format_rate(row.get("Smiley When Passed", np.nan)),
                format_rate(row.get("Smiley When Failed", np.nan)),
                _format_pp_delta_v527(
                    float(gap_value) * 100.0
                    if pd.notna(gap_value)
                    else np.nan
                ),
                format_rate(row.get("Non-Smiley Fail Share", np.nan)),
                format_rate(row.get(">=80% TM QA", np.nan)),
                format_rate(row.get("<80% TM QA", np.nan)),
                _format_pp_delta_v527(
                    float(tm_gap_value) * 100.0
                    if pd.notna(tm_gap_value)
                    else np.nan
                ),
                normalize_text(row.get("Focus", "")),
            ]
        )
    return rows


def _qa_attribute_impact_narrative_v549(
    scope_name: str,
    impact_df: pd.DataFrame,
    config: AppConfig = CONFIG,
) -> str:
    """Build a short business-readable QA Attribute Impact callout."""
    scope_label = normalize_text(scope_name) or "Overall"
    if impact_df is None or impact_df.empty:
        return (
            f"{scope_label} QA Attribute Impact is unavailable because no usable "
            "QA attribute scores were found in the selected reporting scope."
        )

    min_audits = int(
        getattr(
            config,
            "qa_attribute_impact_min_audits",
            getattr(config, "directional_n", 5),
        )
    )
    work = impact_df.copy()
    work["_Audited"] = pd.to_numeric(work.get("Audited", 0), errors="coerce").fillna(0)
    work = work[work["_Audited"].gt(0)].copy()
    if work.empty:
        return (
            f"{scope_label} QA Attribute Impact has no audited QA attribute volume "
            "after cleaning blanks and invalid values."
        )

    total_audited = int(work["_Audited"].sum())
    eligible = work[work["_Audited"].ge(min_audits)].copy()
    if eligible.empty:
        return (
            f"{scope_label} QA Attribute Impact covers {format_int(total_audited)} "
            "audited QA attribute scores, but attribute-level volume is too small "
            "to rank stable drivers."
        )

    eligible["_Fail Rate"] = pd.to_numeric(
        eligible.get("Fail Rate", np.nan),
        errors="coerce",
    )
    eligible["_Gap"] = pd.to_numeric(
        eligible.get("Gap", np.nan),
        errors="coerce",
    )
    eligible["_NS Share"] = pd.to_numeric(
        eligible.get("Non-Smiley Fail Share", np.nan),
        errors="coerce",
    )
    eligible["_TM Gap"] = pd.to_numeric(
        eligible.get("TM QA Gap", np.nan),
        errors="coerce",
    )

    highest_fail = eligible.sort_values(
        ["_Fail Rate", "_Audited"],
        ascending=[False, False],
        na_position="last",
    ).iloc[0]

    largest_gap = eligible.sort_values(
        ["_Gap", "Fail Count", "_Audited"],
        ascending=[False, False, False],
        na_position="last",
    ).iloc[0]

    largest_ns = eligible.sort_values(
        ["_NS Share", "Non-Smiley Fail Count", "Fail Count"],
        ascending=[False, False, False],
        na_position="last",
    ).iloc[0]

    tm_gap_candidates = eligible[
        eligible["_TM Gap"].notna() & eligible["_TM Gap"].gt(0)
    ].copy()
    largest_tm_gap = (
        tm_gap_candidates.sort_values(
            ["_TM Gap", "_Audited"],
            ascending=[False, False],
            na_position="last",
        ).iloc[0]
        if not tm_gap_candidates.empty
        else None
    )

    gap_value = float(largest_gap.get("_Gap", np.nan))
    if pd.notna(gap_value) and gap_value > 0:
        smiley_drop_sentence = (
            f"When failed, {normalize_text(largest_gap.get('QA Attribute', ''))} "
            f"showed the largest Smiley Rate drop; passed evaluations were "
            f"{_format_pp_delta_v527(gap_value * 100.0)} higher than failed evaluations."
        )
    else:
        smiley_drop_sentence = (
            "When failed, no QA attribute showed a measurable Smiley Rate drop versus "
            "passed evaluations in this scope."
        )

    ns_share_value = float(largest_ns.get("_NS Share", np.nan))
    if pd.notna(ns_share_value) and ns_share_value > 0:
        non_smiley_sentence = (
            f"For Non-Smiley surveys, {normalize_text(largest_ns.get('QA Attribute', ''))} "
            f"was the most common QA miss at {format_rate(ns_share_value)} of "
            "non-smiley QA failures."
        )
    else:
        non_smiley_sentence = (
            "For Non-Smiley surveys, no QA failure pattern had enough volume to identify "
            "a clear common miss."
        )

    if largest_tm_gap is not None:
        tm_gap_value = float(largest_tm_gap.get("_TM Gap", np.nan))
        tm_gap_sentence = (
            f"Below-80% teammates showed the weakest relative QA performance on "
            f"{normalize_text(largest_tm_gap.get('QA Attribute', ''))}; >=80% teammates "
            f"were {_format_pp_delta_v527(tm_gap_value * 100.0)} higher on that attribute."
        )
    else:
        tm_gap_sentence = (
            "The >=80% versus <80% teammate split did not show a reliable below-target "
            "QA weakness in this scope."
        )

    primary_focus = normalize_text(largest_gap.get("QA Attribute", ""))
    if normalize_text(largest_ns.get("QA Attribute", "")) != primary_focus:
        primary_focus = (
            f"{primary_focus} and "
            f"{normalize_text(largest_ns.get('QA Attribute', ''))}"
        )
    if largest_tm_gap is not None:
        tm_focus = normalize_text(largest_tm_gap.get("QA Attribute", ""))
        if tm_focus and tm_focus not in primary_focus:
            primary_focus = f"{primary_focus} and {tm_focus}"

    return (
        f"{scope_label} QA Attribute Impact covers {format_int(total_audited)} "
        f"audited QA attribute scores across {format_int(len(work))} attributes. "
        f"Highest failure rate: {normalize_text(highest_fail.get('QA Attribute', ''))} "
        f"at {format_rate(highest_fail.get('Fail Rate', np.nan))}. "
        f"{smiley_drop_sentence} {non_smiley_sentence} {tm_gap_sentence} "
        f"Recommended coaching focus: {primary_focus}."
    )


