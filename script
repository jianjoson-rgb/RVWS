                    ),
                    ha="right",
                    va="center",
                    fontsize=8.0,
                    color=delta_color,
                    transform=panel_header.transAxes,
                )
            else:
                panel_header.text(
                    1.0,
                    0.5,
                    "No site data",
                    ha="right",
                    va="center",
                    fontsize=8.0,
                    color="#667085",
                    transform=panel_header.transAxes,
                )

            bars = ax2.bar(
                x,
                volume_values,
