def _email_v565_ticket_age_segments(
    source_df: pd.DataFrame,
    metric: PeriodMetric,
) -> List[Dict[str, Any]]:
    """
    v5.7.69 Ticket Age readout.

    Shows the top two Ticket Age buckets by rated survey volume share, not just
    the weakest/Frownie-heavy bucket.
