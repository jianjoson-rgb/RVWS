def build_executive_dashboard(
    metrics: Mapping[str, PeriodMetric],
    output_path: str,
    report_label: str,
    lob_label: str,
    data_through: pd.Timestamp,
    config: AppConfig = CONFIG,
) -> str:
    ordered_grains = [
        grain
        for grain in ["DAILY", "WEEKLY", "MONTHLY"]
        if grain in metrics
    ]
    if not ordered_grains:
        raise ValueError("No grain metrics were provided for the dashboard.")

    panel_count = len(ordered_grains)
    figure_height = (
        config.chart_panel_height_inches * panel_count
        + 1.15
        + (0.22 if panel_count > 1 else 0)
    )
    fig = plt.figure(
        figsize=(config.chart_width_inches, figure_height),
        facecolor="white",
    )
    gs = GridSpec(
        panel_count,
        2,
        figure=fig,
        width_ratios=[6.1, 1.08],
        hspace=0.78 if panel_count > 1 else 0.25,
        wspace=0.035,
        left=0.055,
        right=0.985,
        top=0.91,
        bottom=0.075,
    )

    shared_ylim = (
        _dashboard_shared_ylim(
            {grain: metrics[grain] for grain in ordered_grains},
            config,
        )
        if config.chart_use_shared_y_axis
        else None
    )

    fig.text(
        0.055,
        0.975,
        "MERCHANT SMILEY TRENDS DASHBOARD",
        ha="left",
        va="top",
        fontsize=17,
        fontweight="bold",
        color=config.chart_title_color,
    )

    for row_index, grain in enumerate(ordered_grains):
        ax = fig.add_subplot(gs[row_index, 0])
        card_ax = fig.add_subplot(gs[row_index, 1])
        metric = metrics[grain]

        if grain == "DAILY":
            _plot_daily_panel(
                ax,
                card_ax,
                metric,
                config,
                shared_ylim=shared_ylim,
            )
        elif grain == "WEEKLY":
            _plot_weekly_panel(
                ax,
                card_ax,
                metric,
                config,
                shared_ylim=shared_ylim,
            )
        elif grain == "MONTHLY":
            _plot_monthly_panel(
                ax,
                card_ax,
                metric,
                config,
                shared_ylim=shared_ylim,
            )

        _add_panel_border(fig, ax, card_ax, config)

    fig.text(
        0.012,
        0.018,
        f"pp = percentage points | Smiley Target = {format_rate(config.target_rate, decimals=1)}",
        ha="left",
        va="bottom",
        fontsize=8.5,
        color="#172033",
    )
    fig.text(
        0.5,
        0.018,
        f"{lob_label.title()} | {report_label} | Data through: "
        f"{pd.Timestamp(data_through).strftime('%b %d, %Y')}",
        ha="center",
        va="bottom",
        fontsize=8.5,
        color="#172033",
    )

    output = Path(output_path)
    output.parent.mkdir(parents=True, exist_ok=True)
    fig.savefig(
        output,
        dpi=config.chart_dpi,
        bbox_inches="tight",
        facecolor="white",
    )
    plt.close(fig)
    return str(output)




def _rolling_overview_site(value: Any) -> str:
    """
    Normalize site labels for the rolling overview.

    Blank, NULL-like, and non-approved values are returned as an empty string
    and are excluded before aggregation. The chart site universe is enforced
    separately through AppConfig.rolling_overview_allowed_sites.
    """
    site = normalize_text(value).upper()
    if site in {"", "NULL", "NONE", "NAN", "N/A", "NA", "UNSPECIFIED", "UNKNOWN"}:
        return ""
    return site


def _rolling_overview_colors(
    sites: Sequence[str],
) -> Dict[str, Any]:
    """Use stable colors for key sites and distinct colors for all others."""
    fixed = {
        "ARN": "#1565C0",
        "HTW": "#188038",
        "MTQ": "#6A3DB6",
        "PHX": "#F4511E",
        "UNSPECIFIED": "#6B7280",
    }
    palette = list(plt.get_cmap("tab20").colors)
    colors_out: Dict[str, Any] = {}
    palette_index = 0
    for site in sites:
        if site in fixed:
            colors_out[site] = fixed[site]
            continue
        colors_out[site] = palette[palette_index % len(palette)]
        palette_index += 1
    return colors_out


def _compact_chart_number(value: float) -> str:
    if value is None or pd.isna(value):
        return "0"
    value = float(value)
    if abs(value) >= 1_000_000:
        return f"{value / 1_000_000:.1f}M"
    if abs(value) >= 1_000:
        return f"{value / 1_000:.1f}K"
    return f"{value:.0f}"


def _all_sites_rolling_periods(
    metric: PeriodMetric,
    grain: str,
    config: AppConfig = CONFIG,
) -> List[Dict[str, Any]]:
    """Return the exact rolling period keys used by the existing executive metric."""
    grain = normalize_text(grain).upper()
    chart_df = metric.chart_df.copy()
    if chart_df.empty:
        return []

    rows: List[Dict[str, Any]] = []
    if grain == "DAILY":
        source = chart_df.tail(config.daily_chart_periods)
        for _, row in source.iterrows():
            start = pd.Timestamp(row["Date"]).normalize()
            rows.append(
                {
                    "start": start,
                    "end": start,
                    "label": normalize_text(row.get("Period Label"))
                    or daily_chart_label(start),
                    "current": bool(row.get("Is Current", False)),
                }
            )
    elif grain == "WEEKLY":
        source = chart_df.tail(config.weekly_chart_periods)
        for _, row in source.iterrows():
            start = pd.Timestamp(row["Week Start"]).normalize()
            full_end = pd.Timestamp(row["Week End"]).normalize()
            current = bool(row.get("Is Current", False))
            observed_end = (
                min(full_end, pd.Timestamp(metric.data_through).normalize())
                if current
                else full_end
            )
            rows.append(
                {
                    "start": start,
                    "end": observed_end,
                    "label": normalize_text(row.get("Period Label"))
                    or week_beginning_chart_label(start),
                    "current": current,
                }
            )
    elif grain == "MONTHLY":
        source = chart_df.tail(config.monthly_chart_periods)
        for _, row in source.iterrows():
            start = month_start(pd.Timestamp(row["Month Start"]).normalize())
            full_end = month_end(start)
            current = bool(row.get("Is Current", False))
            observed_end = (
                min(full_end, pd.Timestamp(metric.data_through).normalize())
                if current
                else full_end
            )
            rows.append(
                {
                    "start": start,
                    "end": observed_end,
                    "label": normalize_text(row.get("Period Label"))
                    or start.strftime("%b %Y"),
                    "current": current,
                }
            )
    else:
        raise ValueError(f"Unsupported grain for rolling overview: {grain}")
    return rows


def _build_all_sites_rolling_frame(
    filtered_df: pd.DataFrame,
    metric: PeriodMetric,
    grain: str,
    config: AppConfig = CONFIG,
) -> pd.DataFrame:
    """Aggregate only the approved site universe for the rolling overview charts."""
    if filtered_df is None or filtered_df.empty:
        return pd.DataFrame()

    allowed_sites = []
    for raw_site in config.rolling_overview_allowed_sites:
        normalized_site = _rolling_overview_site(raw_site)
        if normalized_site and normalized_site not in allowed_sites:
            allowed_sites.append(normalized_site)

    allowed_site_set = set(allowed_sites)
    if allowed_site_set != {"ARN", "HTW", "MTQ", "PHX"}:
        raise ValueError(
            "Rolling overview site configuration must contain exactly "
            "ARN, HTW, MTQ, and PHX."
        )

    work = filtered_df.copy()
    work["Date"] = pd.to_datetime(work["Date"], errors="coerce").dt.normalize()
    work = work[work["Date"].notna()].copy()
    work["Overview Site"] = work["Site"].map(_rolling_overview_site)

    # Hard exclusion: no blank, NULL-like, or other site may enter any
    # performance or volume aggregation for this supporting image.
    work = work[
        work["Overview Site"].notna()
        & work["Overview Site"].ne("")
        & work["Overview Site"].isin(allowed_site_set)
    ].copy()

    periods = _all_sites_rolling_periods(metric, grain, config)
    if not periods:
        return pd.DataFrame()

    # Keep the legend/chart universe fixed to the approved sites that actually
    # have data in the selected LOB population. No blanks, NULLs, or other sites.
    existing_sites = set(work["Overview Site"].dropna().astype(str).unique().tolist())
    sites = [site for site in allowed_sites if site in existing_sites]
    if not sites:
        return pd.DataFrame()

    output_rows: List[Dict[str, Any]] = []
    for period_index, period in enumerate(periods):
        period_df = work[
            work["Date"].between(period["start"], period["end"], inclusive="both")
        ]
        grouped = (
            period_df.groupby("Overview Site", dropna=False)
            .agg(
                Positive=("Smiley Numerator", "sum"),
                Responses=("Responses", "sum"),
            )
            .reset_index()
        )
        grouped_lookup = {
            normalize_text(row["Overview Site"]): (
                float(row["Positive"]),
                float(row["Responses"]),
            )
            for _, row in grouped.iterrows()
        }
        lob_positive = float(
            pd.to_numeric(
                period_df["Smiley Numerator"], errors="coerce"
            ).fillna(0).sum()
        )
        lob_responses = float(
            pd.to_numeric(
                period_df["Responses"], errors="coerce"
            ).fillna(0).sum()
        )
        for site in sites:
            positive, responses = grouped_lookup.get(site, (0.0, 0.0))
            output_rows.append(
                {
                    "Grain": grain,
                    "Period Index": period_index,
                    "Period Start": period["start"],
                    "Period End": period["end"],
                    "Period Label": period["label"],
                    "Is Current": period["current"],
                    "Site": site,
                    "Positive": positive,
                    "Responses": responses,
                    "Smiley Rate": safe_rate(positive, responses),
                    "LOB Positive": lob_positive,
                    "LOB Responses": lob_responses,
                    "LOB Smiley Rate": safe_rate(lob_positive, lob_responses),
                }
            )
    output_df = pd.DataFrame(output_rows)
    if output_df.empty:
        return output_df

    unexpected_sites = sorted(
        set(output_df["Site"].dropna().astype(str).str.upper())
        - allowed_site_set
    )
    if unexpected_sites:
        raise ValueError(
            "Unexpected sites reached the rolling overview aggregation: "
            f"{unexpected_sites}"
        )

    output_df = output_df[
        output_df["Site"].isin(allowed_sites)
    ].copy()
    return output_df



def build_all_sites_rolling_overview(
    filtered_df: pd.DataFrame,
    grain_results: Mapping[str, GrainResult],
    attention_site: str,
    selection: ReportSelection,
    report_scope: Mapping[str, Any],
    output_path: str,
    config: AppConfig = CONFIG,
) -> str:
    """
    Build a chart-only 12-panel executive dashboard.

    Layout:
      - Row 1: Daily — ARN, HTW, MTQ, PHX
      - Row 2: Weekly — ARN, HTW, MTQ, PHX
      - Row 3: Monthly — ARN, HTW, MTQ, PHX

    Overlap prevention:
      - Each timeframe title has its own dedicated axes band.
      - Each site title and Latest / Overall / Delta summary has its own
        dedicated panel-header band.
      - Site data labels close to the top boundary are moved below the point.
      - Overall performance remains a dashed benchmark line without labels.

    Only ARN, HTW, MTQ, and PHX are allowed in this dashboard. Blank,
    NULL-like, unspecified, and all other site values are excluded.
    """
    del attention_site, selection, report_scope  # Kept for call compatibility.

    grains = ["DAILY", "WEEKLY", "MONTHLY"]
    missing = [grain for grain in grains if grain not in grain_results]
    if missing:
        raise ValueError(
            f"Rolling overview is missing grain results: {missing}"
        )

    frames = {
        grain: _build_all_sites_rolling_frame(
            filtered_df,
            grain_results[grain].overall,
            grain,
            config,
        )
        for grain in grains
    }

    allowed_sites = [
        _rolling_overview_site(site)
        for site in config.rolling_overview_allowed_sites
    ]
    allowed_sites = [
        site
        for site in allowed_sites
        if site in {"ARN", "HTW", "MTQ", "PHX"}
    ]
    if allowed_sites != ["ARN", "HTW", "MTQ", "PHX"]:
        raise ValueError(
            "Rolling overview site configuration must be exactly "
            "ARN, HTW, MTQ, and PHX in that order."
        )

    site_colors = _rolling_overview_colors(allowed_sites)

    # Use one performance scale across all 12 panels.
    configured_floor = (
        float(config.rolling_overview_performance_y_min) * 100
    )
    configured_ceiling = (
        float(config.rolling_overview_performance_y_max) * 100
    )

    all_rates: List[float] = []
    for frame in frames.values():
        if frame.empty:
            continue
        approved = frame[frame["Site"].isin(allowed_sites)]
        for column in ["Smiley Rate", "LOB Smiley Rate"]:
            all_rates.extend(
                pd.to_numeric(
                    approved[column],
                    errors="coerce",
                )
                .dropna()
                .mul(100)
                .tolist()
            )

    finite_rates = [
        float(value)
        for value in all_rates
        if pd.notna(value) and np.isfinite(value)
    ]
    minimum_rate = (
        min(finite_rates)
        if finite_rates
        else configured_floor
    )

    if (
        config.rolling_overview_soft_floor
        and minimum_rate < configured_floor
    ):
        y_min = max(
            0.0,
            math.floor((minimum_rate - 2.0) / 5.0) * 5.0,
        )
    else:
        y_min = configured_floor

    y_max = min(
        100.0,
        max(
            configured_ceiling,
            config.target_rate * 100,
        ),
    )
    if y_max <= y_min:
        y_max = min(100.0, y_min + 20.0)

    # The outer grid owns the three timeframe sections.
    # Every timeframe receives a dedicated header row.
    fig = plt.figure(
        figsize=(22, 18.5),
        facecolor="white",
    )
    outer_grid = GridSpec(
        3,
        1,
        figure=fig,
        left=0.045,
        right=0.985,
        top=0.985,
        bottom=0.075,
        hspace=0.24,
    )

    row_titles = {
        "DAILY": "DAILY — ROLLING 12 DAYS",
        "WEEKLY": "WEEKLY — ROLLING 12 WEEKS",
        "MONTHLY": "MONTHLY — ROLLING 4 MONTHS",
    }

    for row_index, grain in enumerate(grains):
        frame = frames[grain]

        # Each timeframe block has:
        #   row 0 = timeframe title band
        #   row 1 = four chart slots
        timeframe_grid = outer_grid[row_index].subgridspec(
            2,
            4,
            height_ratios=[0.085, 0.915],
            hspace=0.06,
            wspace=0.22,
        )

        timeframe_header = fig.add_subplot(
            timeframe_grid[0, :]
        )
        timeframe_header.set_axis_off()
        timeframe_header.text(
            0.0,
            0.50,
            row_titles[grain],
            ha="left",
            va="center",
            fontsize=14,
            fontweight="bold",
            color="white",
            bbox=dict(
                boxstyle="round,pad=0.28",
                facecolor="#122B66",
                edgecolor="#122B66",
            ),
            transform=timeframe_header.transAxes,
        )

        if frame.empty:
            for column_index, site in enumerate(allowed_sites):
                panel_grid = timeframe_grid[
                    1,
                    column_index,
                ].subgridspec(
                    2,
                    1,
                    height_ratios=[0.12, 0.88],
                    hspace=0.0,
                )

                panel_header = fig.add_subplot(panel_grid[0])
                panel_header.set_axis_off()
                panel_header.text(
                    0.0,
                    0.5,
                    site,
                    ha="left",
                    va="center",
                    fontsize=14,
                    fontweight="bold",
                    color=site_colors[site],
                    transform=panel_header.transAxes,
                )
                panel_header.text(
                    1.0,
                    0.5,
                    "No data",
                    ha="right",
                    va="center",
                    fontsize=8.2,
                    color="#667085",
                    transform=panel_header.transAxes,
                )

                ax = fig.add_subplot(panel_grid[1])
                ax.text(
                    0.5,
                    0.5,
                    "No data for selected LOB / period",
                    ha="center",
                    va="center",
                    fontsize=10.5,
                    color="#667085",
                    transform=ax.transAxes,
                )
                ax.set_axis_off()
            continue

        periods = (
            frame[
                [
                    "Period Index",
                    "Period Label",
                    "LOB Smiley Rate",
                    "LOB Responses",
                ]
            ]
            .drop_duplicates("Period Index")
            .sort_values("Period Index")
        )

        x = np.arange(len(periods))
        x_labels = periods["Period Label"].astype(str).tolist()
        x_rotation = 42 if grain == "WEEKLY" else 0

        overall_values = (
            pd.to_numeric(
                periods["LOB Smiley Rate"],
                errors="coerce",
            )
            .to_numpy(dtype=float)
            * 100
        )

        for column_index, site in enumerate(allowed_sites):
            # Each panel gets its own title/statistics band.
            panel_grid = timeframe_grid[
                1,
                column_index,
            ].subgridspec(
                2,
                1,
                height_ratios=[0.12, 0.88],
                hspace=0.0,
            )

            panel_header = fig.add_subplot(panel_grid[0])
            panel_header.set_axis_off()

            ax = fig.add_subplot(panel_grid[1])
            ax2 = ax.twinx()

            # Volume layer behind performance layer.
            ax2.set_zorder(0)
            ax.set_zorder(2)
            ax.patch.set_alpha(0)

            site_frame = (
                frame[frame["Site"].eq(site)]
                .set_index("Period Index")
                .reindex(periods["Period Index"])
            )

            site_values = (
                pd.to_numeric(
                    site_frame["Smiley Rate"],
                    errors="coerce",
                )
                .to_numpy(dtype=float)
                * 100
            )
            volume_values = (
                pd.to_numeric(
                    site_frame["Responses"],
                    errors="coerce",
                )
                .fillna(0)
                .to_numpy(dtype=float)
            )

            has_site_data = bool(
                pd.to_numeric(
                    site_frame["Responses"],
                    errors="coerce",
                )
                .fillna(0)
                .sum()
                > 0
            )

            latest_site_value = next(
                (
                    float(value)
                    for value in reversed(site_values.tolist())
                    if pd.notna(value) and np.isfinite(value)
                ),
                np.nan,
            )
            latest_overall_value = next(
                (
                    float(value)
                    for value in reversed(overall_values.tolist())
                    if pd.notna(value) and np.isfinite(value)
                ),
                np.nan,
            )
            latest_delta = (
                latest_site_value - latest_overall_value
                if (
                    pd.notna(latest_site_value)
                    and pd.notna(latest_overall_value)
                )
                else np.nan
            )

            delta_color = (
                "#137333"
                if (
                    pd.notna(latest_delta)
                    and latest_delta >= 0
                )
                else "#D93025"
            )

            # Dedicated panel-header content; it cannot overlap the plot.
