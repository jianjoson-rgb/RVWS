def _email_v551_current_performance_segments(
    selection: ReportSelection,
    metric: PeriodMetric,
    config: AppConfig = CONFIG,
) -> List[Dict[str, Any]]:
    grain = normalize_text(metric.grain).title()
    rate_threshold = float(getattr(config, "target_rate", 0.815))
    previous_delta = _email_v551_num(getattr(metric, "previous_delta", np.nan))
    volume_change = _email_v551_num(getattr(metric, "volume_change_pct", np.nan))

    segments: List[Dict[str, Any]] = [
        _email_v551_seg(f"{selection.lob.upper()} {grain} Smiley Rate "),
        _email_v551_seg(
            "closed at " if metric.grain.upper() == "DAILY" else "is at "
        ),
        _email_v551_seg(
            format_rate(metric.actual_rate),
            color=_email_v551_rate_color(metric.actual_rate, threshold=rate_threshold),
            bold=True,
        ),
        _email_v551_seg(f" across {format_int(metric.actual_responses)} responses, "),
        _email_v551_seg(
            movement_phrase(metric.delta),
            color=_email_v551_delta_color(metric.delta),
            bold=True,
        ),
        _email_v551_seg(f" versus the {_email_v551_baseline_label(metric)}."),
    ]

    previous_label = normalize_text(getattr(metric, "previous_period_label", ""))
    if previous_label:
        volume_status = normalize_text(getattr(metric, "volume_status", "")) or "N/A"
        if volume_status.lower().startswith("volume "):
            volume_status = volume_status[7:]
        if volume_status and volume_status != "N/A":
            volume_status = volume_status[:1].lower() + volume_status[1:]
        segments.extend(
            [
                _email_v551_seg(" Previous-timeframe indicator: "),
                _email_v551_seg(
                    normalize_text(getattr(metric, "performance_status", "")) or "N/A",
                    color=_email_v551_delta_color(previous_delta),
                    bold=True,
                ),
                _email_v551_seg(" ("),
                _email_v551_seg(
                    format_pp(previous_delta),
                    color=_email_v551_delta_color(previous_delta),
                    bold=True,
                ),
                _email_v551_seg(f") versus {previous_label}; volume "),
                _email_v551_seg(
                    volume_status,
                    bold=True,
                ),
                _email_v551_seg(" ("),
                _email_v551_seg(
                    _email_v551_signed_pct(volume_change),
                    color=EMAIL_V551_GRAY,
                    bold=True,
                ),
                _email_v551_seg(")."),
            ]
        )
    return segments


def _email_v551_projection_segments(
    metric: PeriodMetric,
    config: AppConfig = CONFIG,
) -> List[Dict[str, Any]]:
    grain = normalize_text(metric.grain).upper()
    baseline_label = _email_v551_baseline_label(metric)

    if grain == "DAILY":
        baseline_rate = _email_v551_num(metric.baseline_rate)
        actual_positive = _email_v551_num(metric.actual_positive, 0.0)
        actual_responses = _email_v551_num(metric.actual_responses, 0.0)
        smileys_needed = (
            max(int(math.ceil(baseline_rate * actual_responses - actual_positive)), 0)
            if pd.notna(baseline_rate) and actual_responses > 0
            else 0
        )
        return [
            _email_v551_seg("The Daily view is post-mortem; it closed at "),
            _email_v551_seg(
                format_rate(metric.actual_rate),
                color=_email_v551_rate_color(metric.actual_rate, threshold=float(getattr(config, "target_rate", 0.815))),
                bold=True,
            ),
            _email_v551_seg(f" across {format_int(metric.actual_responses)} responses. To match the {baseline_label} of "),
            _email_v551_seg(
                format_rate(metric.baseline_rate),
                color=_email_v551_rate_color(metric.baseline_rate, threshold=float(getattr(config, "target_rate", 0.815))),
                bold=True,
            ),
            _email_v551_seg(", the day needed approximately "),
            _email_v551_seg(
                format_int(smileys_needed),
                color=EMAIL_V551_RED if smileys_needed > 0 else EMAIL_V551_GREEN,
                bold=True,
            ),
            _email_v551_seg(" additional Smiley response(s), or equivalent non-smiley reduction. Recovery should prevent the same drivers from repeating in the next reporting day."),
        ]

    if pd.notna(metric.projected_rate) and metric.is_incomplete:
        smileys_needed = _period_target_smileys_needed(
            metric,
            float(getattr(config, "target_rate", 0.815)),
        )
        projection_label = "Weekly" if grain == "WEEKLY" else "Monthly"
        return [
            _email_v551_seg(f"{projection_label} is projected to close at "),
            _email_v551_seg(
                format_rate(metric.projected_rate),
                color=_email_v551_rate_color(metric.projected_rate, threshold=float(getattr(config, "target_rate", 0.815))),
                bold=True,
            ),
            _email_v551_seg(f" across approximately {format_int(metric.projected_responses)} responses, "),
            _email_v551_seg(
                format_pp(metric.projected_delta),
                color=_email_v551_delta_color(metric.projected_delta),
                bold=True,
            ),
            _email_v551_seg(f" versus the {baseline_label}. "),
            _email_v551_seg(
                f"{format_int(smileys_needed)} additional positive response(s) are needed within projected volume to reach the {format_rate(float(getattr(config, 'target_rate', 0.815)))} target."
                if smileys_needed > 0
                else "Projected close is at or above target; protect the current run rate."
            ),
        ]

    close_label = "Weekly" if grain == "WEEKLY" else "Monthly"
    return [
        _email_v551_seg(f"{close_label} period is complete; no in-period projection is needed. Final performance closed at "),
        _email_v551_seg(
            format_rate(metric.actual_rate),
            color=_email_v551_rate_color(metric.actual_rate, threshold=float(getattr(config, "target_rate", 0.815))),
            bold=True,
        ),
        _email_v551_seg(", "),
        _email_v551_seg(
            movement_phrase(metric.delta),
            color=_email_v551_delta_color(metric.delta),
            bold=True,
        ),
        _email_v551_seg(f" versus the {baseline_label}."),
    ]


