def build_ticket_lookups(
    merchant_df,
    window_start_date,
    window_end_date,
    summary_rows,
):
    run_timestamp = datetime.now(
        ZoneInfo(TIMEZONE_NAME)
    ).strftime("%Y-%m-%d %H:%M:%S")

    needed_ticket_ids, needed_combined_keys, needed_name_keys = (
        prepare_needed_lookup_keys(merchant_df)
    )

    print("======================================")
    print("TICKET LOOKUPS BUILD START")
    print("======================================")
    print(
        f"Needed ticket IDs for AFTR: "
        f"{len(needed_ticket_ids):,}"
    )
    print(
        f"Needed ticket combined keys: "
        f"{len(needed_combined_keys):,}"
    )
    print(
        f"Needed ticket name keys: "
        f"{len(needed_name_keys):,}"
    )

    empty_result = {
        "tenure_combined": {},
        "tenure_name": {},
        "site_name": {},
        "aftr_by_ticket_id": {},
    }

    if (
        not needed_ticket_ids
        and not needed_combined_keys
        and not needed_name_keys
    ):
        return empty_result

    all_source_files = list_all_matching_source_files(
        drive_service=drive_service,
        folder_id=TICKETS_SOURCE_FOLDER_ID,
        filename_parser=parse_tickets_filename,
    )

    if not all_source_files:
        raise ValueError(
            "No files matching "
            "'MMM EOM YYYY Tickets.csv' were found."
        )

    latest_file = get_latest_file_by_filename(all_source_files)
    latest_file_name = latest_file["name"]
    reference_latest_date = get_reference_date_from_filename(
        latest_file
    )

    if SCAN_NON_MASTER_REFERENCE_DATES:
        PROGRESS.add_total(1)
        latest_source_datetime = get_latest_date_from_file(
            drive_service=drive_service,
            file_meta=latest_file,
            required_columns=TICKETS_REQUIRED_COLUMNS,
            date_column=TICKETS_DATE_COLUMN,
            company_column=TICKETS_COMPANY_COLUMN,
            company_filter_value=TICKETS_COMPANY_FILTER_VALUE,
            parse_dates_func=parse_dates_general,
            temp_prefix="tickets_csv_",
        )
        reference_latest_date = latest_source_datetime.date()
        PROGRESS.update(1, "Ticket latest-date scan complete")
    else:
        print(
            "Skipping ticket latest-date file scan for speed; "
            "raw output uses the merchant window. "
            f"Summary reference date is from filename: "
            f"{reference_latest_date}"
        )

    needed_months = set(
        month_keys_between(window_start_date, window_end_date)
    )
    source_files = [
        file_meta
        for file_meta in all_source_files
        if file_meta["parsed_filename"]["sort_key"]
        in needed_months
    ]

    if not source_files:
        print("No ticket files matched the merchant window.")
        return empty_result

    print(
        f"Ticket window: "
        f"{window_start_date} to {window_end_date}"
    )
    print(f"Ticket files to process: {len(source_files)}")
    PROGRESS.add_total(len(source_files))

    tenure_combined_best = {}
    tenure_name_best = {}
    site_name_best = {}
    aftr_ticket_best = {}

    company_target = TICKETS_COMPANY_FILTER_VALUE.casefold()

    for file_meta in source_files:
        file_name = file_meta["name"]
        modified_time = file_meta.get("modifiedTime", "")
        file_size_mb = (
            round(
                int(file_meta.get("size", 0))
                / (1024 * 1024),
                2,
            )
            if file_meta.get("size")
            else ""
        )
        matched_rows = 0
        file_status = "SUCCESS"
        local_csv = None

        print("--------------------------------------------------")
        print(f"Processing ticket lookup file: {file_name}")
        PROGRESS.set_message(
            f"Processing ticket file: {file_name}"
        )

        try:
            local_csv = download_drive_file_with_retry(
                drive_service,
                file_meta["id"],
                file_name,
                "tickets_csv_",
            )

            header_df = pd.read_csv(
                local_csv,
                nrows=0,
                dtype=str,
                keep_default_na=False,
                low_memory=False,
            )

            actual_columns, rename_map, present_optional = (
                validate_and_map_headers(
                    list(header_df.columns),
                    TICKETS_REQUIRED_COLUMNS,
                    file_name,
                    optional_columns=TICKETS_OPTIONAL_COLUMNS,
                )
            )

            missing_aftr_columns = [
                column
                for column in AFTR_OUTPUT_COLUMNS
                if column not in present_optional
            ]
            if missing_aftr_columns:
                print(
                    "  AFTR columns missing in this ticket file; "
                    "affected output values will be No data: "
                    f"{missing_aftr_columns}"
                )

            chunk_iter = pd.read_csv(
                local_csv,
                dtype=str,
                keep_default_na=False,
                low_memory=False,
                chunksize=CSV_CHUNK_SIZE,
                usecols=actual_columns,
            )

            for chunk_number, chunk in enumerate(
                chunk_iter,
                start=1,
            ):
                chunk = chunk.rename(columns=rename_map)

                for optional_column in TICKETS_OPTIONAL_COLUMNS:
                    if optional_column not in chunk.columns:
                        chunk[optional_column] = ""

                company_mask = (
                    normalize_lookup_series(
                        chunk[TICKETS_COMPANY_COLUMN]
                    )
                    == company_target
                )
                date_series = parse_dates_general(
                    chunk[TICKETS_DATE_COLUMN]
                )
                base_mask = company_mask & date_series.notna()

                ticket_id_series = normalize_ticket_id_series(
                    chunk["ticket_id"]
                )
                employee_name_display = normalize_display_series(
                    chunk["employee_full_name"]
                )
                employee_name_lookup = normalize_lookup_series(
                    chunk["employee_full_name"]
                )
                combined_key_series = build_combined_key_series(
                    ticket_id_series,
                    employee_name_display,
                )

                matched_row_mask = (
                    base_mask
                    & (
                        ticket_id_series.isin(needed_ticket_ids)
                        | combined_key_series.isin(needed_combined_keys)
                        | employee_name_lookup.isin(needed_name_keys)
                    )
                )
                matched_rows += int(matched_row_mask.sum())

                aftr_mask = (
                    base_mask
                    & ticket_id_series.isin(needed_ticket_ids)
                )

                for ticket_id, numerator, denominator, record_date in zip(
                    ticket_id_series.loc[aftr_mask].tolist(),
                    chunk.loc[
                        aftr_mask,
                        "advisor_first_touch_resolution_rate_numerator",
                    ].tolist(),
                    chunk.loc[
                        aftr_mask,
                        "advisor_first_touch_resolution_rate_denominator",
                    ].tolist(),
                    date_series.loc[aftr_mask].tolist(),
                ):
                    existing = aftr_ticket_best.get(ticket_id)
                    if (
                        existing is None
                        or record_date >= existing["date"]
                    ):
                        aftr_ticket_best[ticket_id] = {
                            "advisor_first_touch_resolution_rate_numerator": (
                                normalize_optional_numeric_output_value(
                                    numerator
                                )
                            ),
                            "advisor_first_touch_resolution_rate_denominator": (
                                normalize_optional_numeric_output_value(
                                    denominator
                                )
                            ),
                            "date": record_date,
                        }

                tenure_display = normalize_display_series(
                    chunk["agent_tenure"]
                )
                tenure_lookup = normalize_lookup_series(
                    chunk["agent_tenure"]
                )
                tenure_mask = (
                    base_mask
                    & ~tenure_lookup.isin(
                        INVALID_LOOKUP_VALUES
                    )
                    & tenure_display.ne("")
                )

                combined_mask = (
                    tenure_mask
                    & combined_key_series.isin(
                        needed_combined_keys
                    )
                )

                for combined_key, value, record_date in zip(
                    combined_key_series.loc[
                        combined_mask
                    ].tolist(),
                    tenure_display.loc[
                        combined_mask
                    ].tolist(),
                    date_series.loc[
                        combined_mask
                    ].tolist(),
                ):
                    existing = tenure_combined_best.get(
                        combined_key
                    )
                    if (
                        existing is None
                        or record_date > existing["date"]
                    ):
                        tenure_combined_best[combined_key] = {
                            "value": value,
                            "date": record_date,
                        }

                name_mask = (
                    tenure_mask
                    & employee_name_lookup.isin(
                        needed_name_keys
                    )
                )

                for name_key, value, record_date in zip(
                    employee_name_lookup.loc[name_mask].tolist(),
                    tenure_display.loc[name_mask].tolist(),
                    date_series.loc[name_mask].tolist(),
                ):
                    existing = tenure_name_best.get(name_key)
                    if (
                        existing is None
                        or record_date > existing["date"]
                    ):
                        tenure_name_best[name_key] = {
                            "value": value,
                            "date": record_date,
                        }

                site_source_lookup = normalize_lookup_series(
                    chunk["bpo_location"]
                )
                site_code_series = site_source_lookup.map(
                    TICKETS_SITE_TO_CODE
                )
                site_mask = (
                    base_mask
                    & employee_name_lookup.isin(
                        needed_name_keys
                    )
                    & site_code_series.notna()
                )

                for name_key, site_code, record_date in zip(
                    employee_name_lookup.loc[site_mask].tolist(),
                    site_code_series.loc[site_mask].tolist(),
                    date_series.loc[site_mask].tolist(),
                ):
                    existing = site_name_best.get(name_key)
                    if (
                        existing is None
                        or record_date > existing["date"]
                    ):
                        site_name_best[name_key] = {
                            "value": site_code,
                            "date": record_date,
                        }

                if chunk_number % 5 == 0:
                    PROGRESS.set_message(
                        f"Ticket {file_name}: "
                        f"{matched_rows:,} matched rows"
                    )

        except Exception as exc:
            file_status = f"FAILED: {exc}"
            print(
                f"ERROR processing ticket lookup file "
                f"{file_name}: {exc}"
            )
            raise

        finally:
            summary_rows.append(
                [
                    "TICKET_LOOKUPS",
                    run_timestamp,
                    LOOKBACK_WEEKS,
                    str(window_start_date),
                    str(window_end_date),
                    latest_file_name,
                    str(reference_latest_date),
                    file_name,
                    modified_time,
                    file_size_mb,
                    matched_rows,
                    file_status,
                ]
            )
            safe_cleanup_file(local_csv)
            PROGRESS.update(
                1,
                f"Ticket file complete: {file_name}",
            )

    aftr_by_ticket_id = {}
    for ticket_id, value in aftr_ticket_best.items():
        aftr_by_ticket_id[ticket_id] = {
            column: value.get(column, NO_DATA_TEXT)
            for column in AFTR_OUTPUT_COLUMNS
        }

    print(
        f"AFTR unique matched Ticket IDs: "
        f"{len(aftr_by_ticket_id):,}"
    )

    return {
        "tenure_combined": {
            key: value["value"]
            for key, value in tenure_combined_best.items()
        },
        "tenure_name": {
            key: value["value"]
            for key, value in tenure_name_best.items()
        },
        "site_name": {
            key: value["value"]
            for key, value in site_name_best.items()
        },
        "aftr_by_ticket_id": aftr_by_ticket_id,
    }


