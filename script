def enforce_docs_only_staging_mode_v563(config: AppConfig = CONFIG) -> AppConfig:
    """
    Keep the source workbook as a staging workbook only.

    v5.7.63 intentionally disables all Google Sheets writeback/audit tabs.
    This does not change insight calculations because the report already builds
    all analysis in memory from raw!A:AV before generating the Google Docs files.
    """
    if not is_docs_only_staging_mode_v563(config):
        return config

    updates: Dict[str, Any] = {}
    if bool(getattr(config, "write_google_sheets_outputs", False)):
        updates["write_google_sheets_outputs"] = False
    if bool(getattr(config, "email_body_write_google_sheet", False)):
        updates["email_body_write_google_sheet"] = False

    if updates:
        LOGGER.info(
            "Docs-only staging mode is active; disabling Google Sheets writeback: %s",
            ", ".join(sorted(updates)),
        )
        return replace(config, **updates)
    return config


def validate_raw_staging_headers_v563(
