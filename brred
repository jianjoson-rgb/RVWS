        spreadsheetId=backend_id, range=f'{escaped}!{address}',
        valueRenderOption='UNFORMATTED_VALUE', dateTimeRenderOption='SERIAL_NUMBER')).get('values', [])
    expected = ([('convertedmonth', 'monthdate'), ('month',), ('name', 'lob', 'lobname'),
                 ('name', 'kpi', 'kpiname'), ('comparegoal', 'kpigoal', 'goal', 'target'), ('score', 'kpiscore')]
                if monthly else [('weekstartdate', 'weekbeginning', 'weekstart'), ('name', 'lob', 'lobname'),
                 ('name', 'kpi', 'kpiname'), ('kpigoal', 'goal', 'target'), ('kpiscore', 'score')])
    start_col = 11 if monthly else 3
    if not rows:
        raise ValueError(f'{tab}!{address}: source table is empty.')
    for i, aliases in enumerate(expected):
        value = rows[0][i] if i < len(rows[0]) else ''
        if kpi.normalized(value) not in aliases:
            raise ValueError(f'{tab}!{chr(64 + start_col + i)}1: unexpected header {value!r}.')
    lob_index = 2 if monthly else 1
    metric_index = 3 if monthly else 2
    goal_index, score_index = (4, 5) if monthly else (3, 4)
    lob_names = {kpi.normalized(name): name for name in STANDARD_LOBS}
    metric_names = {kpi.normalized(alias): metric for metric in kpi.METRICS for alias in metric.aliases}
    records = {}
    for rownum, raw in enumerate(rows[1:], 2):
        row = list(raw) + [''] * max(0, len(expected) - len(raw))
        if not any(str(value or '').strip() for value in row):
            continue
        lob = lob_names.get(kpi.normalized(row[lob_index]))
        if lob is None:
            continue  # This reader's explicitly agreed scope is the four standard LOBs.
        period = _gau_exec_date(row[0])
        if period is None:
            raise ValueError(f'{tab}!{chr(64 + start_col)}{rownum}: invalid source date {row[0]!r}.')
        if monthly:
            period = period.replace(day=1)
        elif period.weekday() != 6:
            raise ValueError(f'{tab}!C{rownum}: {period} is not a Sunday week beginning.')
        metric = metric_names.get(kpi.normalized(row[metric_index]))
        if metric is None:
            raise ValueError(f'{tab}!{chr(64 + start_col + metric_index)}{rownum}: unknown KPI {row[metric_index]!r}.')
        key = (period, lob, metric.key)
        if key in records:
            raise ValueError(f'{tab}: duplicate {period} / {lob} / {metric.label} at rows '
                             f'{records[key]["row"]} and {rownum}.')
        records[key] = {'row': rownum, 'goal_raw': row[goal_index], 'score_raw': row[score_index],
                        'goal_cell': f'{chr(64 + start_col + goal_index)}{rownum}',
                        'score_cell': f'{chr(64 + start_col + score_index)}{rownum}'}
    if not records:
        raise ValueError(f'{tab}!{address}: no dated KPI records for CORE, PLUS, RETAIL or PREMIUM.')
    return {'sheet': tab, 'sheet_gid': gid, 'range': address, 'records': records,
            'latest': max(key[0] for key in records), 'monthly': monthly}



def _gau_oprraw_selected(table, period):
    """Require all 20 current records and read each target from its score's row."""
    kpi = load_components()[0]
    selected = {}
    for lob in STANDARD_LOBS:
        selected[lob] = {}
        for metric in kpi.METRICS:
            record = table['records'].get((period, lob, metric.key))
            if record is None:
                raise ValueError(f'{table["sheet"]}: missing {period} / {lob} / {metric.label}. '
                                 'Complete this period; no older-period fallback is used.')
            numbers = {}
            for name, field, cell in [('goal', 'goal_raw', 'goal_cell'), ('actual', 'score_raw', 'score_cell')]:
                try:
                    number = kpi.parse_number(record[field], metric, 'fraction')
                except kpi.DataError as exc:
                    raise ValueError(f'{table["sheet"]}!{record[cell]}: {exc}') from exc
                if number is None:
                    raise ValueError(f'{table["sheet"]}!{record[cell]}: missing {name} for '
                                     f'{period} / {lob} / {metric.label}.')
                numbers[name] = number
            selected[lob][metric.key] = dict(record, **numbers)
    return selected



def _gau_oprraw_load_standard(sheets, standard_config, config):
    """Adapt the long weekly table to the unchanged card parser and calculations."""
    kpi = load_components()[0]
    backend_id = kpi.extract_id(standard_config['source_spreadsheet'], 'spreadsheet')
    metadata = kpi.read_source_metadata(sheets, backend_id)
    table = _gau_oprraw_table(sheets, backend_id, config, metadata=metadata)
    # Preserve the existing explicit report_week override. The default selects
    # the maximum actual source date, regardless of row order or the clock.
    requested = kpi.config_date(standard_config.get('report_week'), 'report_week')
    week = requested or table['latest']
    selected = _gau_oprraw_selected(table, week)
    as_of = (kpi.config_date(standard_config['as_of_date'], 'as_of_date') or
             datetime.now(ZoneInfo(standard_config['timezone'])).date())
    parser_config = dict(standard_config, report_week=week.isoformat(),
                         completed_weeks_only=False, percentage_numeric_scale='fraction')
    results, warnings = [], []
    dates = sorted({key[0] for key in table['records']
                    if week - timedelta(weeks=11) <= key[0] <= week})
    for lob in STANDARD_LOBS:
        headers = ['Weekly'] + [''] * 5
        goals = ['Goal'] + [''] * 5
        for metric in kpi.METRICS:
            offset = ord(metric.column) - ord('B')
            headers[offset] = metric.aliases[0]
            goals[offset] = selected[lob][metric.key]['goal_raw']
        rows = [headers, goals]
        for day in dates:
            row = [day.isoformat()] + [''] * 5
            for metric in kpi.METRICS:
                record = table['records'].get((day, lob, metric.key))
                if record is not None:
                    row[ord(metric.column) - ord('B')] = record['score_raw']
            rows.append(row)
        # Only the operational cards select this source week. No date is
        # forwarded from this adapter into the independent Whitepaper pipeline.
        result = kpi.parse_lob(lob, rows, parser_config, week,
                               metadata.get('properties', {}).get('locale', 'en_US'))
        result['sheet_id'] = table['sheet_gid']
        result['row'] = min(record['row'] for record in selected[lob].values())
        result['oprraw_source'] = {'sheet': table['sheet'], 'sheet_gid': table['sheet_gid'],
                                   'range': 'C:G', 'period': week.isoformat()}
        for card in result['cards']:
            record = selected[lob][card['metric'].key]
            card['source_row'] = record['row']
            card['goal_source_cell'] = record['goal_cell']
            card['score_source_cell'] = record['score_cell']
        results.append(result)
        warnings.extend(result['warnings'])
    return backend_id, as_of, results, warnings



