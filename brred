function movement(value,policy='neutral',digits=1,suffix=' pp'){
  if(value===null||value===undefined||!Number.isFinite(value))return '<span class="movement unavailable" title="Comparison unavailable">N/A</span>';
  const rounded=Number(value.toFixed(digits)),direction=rounded>0?1:rounded<0?-1:0;
  const favorable=policy==='higher'?direction>0:policy==='lower'?direction<0:null;
  const tone=!direction?'flat':favorable===null?(direction>0?'rise':'fall'):(favorable?'good':'bad');
  const meaning=!direction?'No change at displayed precision':policy==='higher'?(favorable?'Improved':'Declined'):policy==='lower'?(favorable?'Lower frequency':'Higher frequency'):(direction>0?'Increased; descriptive direction only':'Decreased; descriptive direction only');
  const text=(direction>0?'↑ ':direction<0?'↓ ':'→ ')+(rounded>0?'+':'')+rounded.toFixed(digits)+suffix;
  return '<span class="movement '+tone+'" title="'+esc(meaning)+'" aria-label="'+esc(meaning+': '+text)+'">'+esc(text)+'</span>';
}
function movementLegend(){return '<div class="movement-legend"><span class="movement good">Green: quality improves / DSAT frequency falls</span><span class="movement bad">Red: quality declines / DSAT frequency rises</span><span>Blue ↑ / purple ↓: descriptive direction for volume, intervention and driver shares</span><span>Gray: unchanged / N/A</span></div>';}
function deltaLine(kind,key){
  const c=state.data.comparisons[kind],v=c.deltas[key],isCount=key==='audits';
  const policy=['ownership','effort','empathy','resolution','overall'].includes(key)?'higher':'neutral';
  const text=movement(v.change,policy,isCount?0:1,isCount?' audits':' pp')+(isCount&&v.relative!==null?' · '+movement(v.relative,'neutral',1,'%'):'');
  const title=rangeLabel(c.currentPeriod)+' vs '+rangeLabel(c.priorPeriod)+'. Current '+(isCount?num(v.current):pct(v.current))+'; prior '+(isCount?num(v.prior):pct(v.prior))+'.';
  return '<div class="delta" title="'+esc(title)+'"><span>'+ (kind==='day'?'Day':'Week')+'</span> <b>'+text+'</b></div>';
}
