def _gau_liveassist_banner_spacing(manifests,height):
    """Reflow only grouped cards/chart; keep the ungrouped main header fixed."""
    unit=height/900.0
    factor=(848.0-304.0)/(848.0-160.0)
    for man in manifests:
        children=set(man['children'])
        for req in man['requests']:
            shape=req.get('createShape');line=req.get('createLine');obj=shape or line
            if obj and obj['objectId'] in children:
                ep=obj['elementProperties'];t=ep['transform']
                t['translateY']=(304.0+(t['translateY']/unit-160.0)*factor)*unit
                if shape:ep['size']['height']['magnitude']*=factor
                else:t['scaleY']*=factor
            style=req.get('updateTextStyle')
            if style and style['objectId'] in children and 'fontSize' in style.get('style',{}):
                style['style']['fontSize']['magnitude']*=factor
    return manifests


def _gau_liveassist_load_source(sheets, config):
    """Accept the shown C:K layout and original B:J; reuse existing LA math."""
    live = load_components()[2]
    spreadsheet_id = live.extract_id(config['source_spreadsheet'], 'spreadsheet')
    metadata = live.read_source_metadata(sheets, spreadsheet_id)
    matches = [sheet['properties'] for sheet in metadata.get('sheets', [])
               if live.normalized(sheet['properties']['title']) == live.normalized('LIVEASSIST')]
    if len(matches) != 1:
        raise live.DataError('Expected one unambiguous LIVEASSIST tab in the configured GAU Backend.')
    properties = matches[0]
    title = properties['title']
    grid = properties.get('gridProperties', {})
    if grid.get('columnCount', 0) < 10:
        raise live.DataError(f'{title}: expected at least columns A:J.')
    escaped = "'" + title.replace("'", "''") + "'"
    end_column = 'K' if grid['columnCount'] >= 11 else 'J'
    last_row = grid['rowCount']
    rows = []
    for start in range(2, last_row + 1, 2000):
        end = min(start + 1999, last_row)
        response = live.execute(sheets.spreadsheets().values().get(
            spreadsheetId=spreadsheet_id, range=f'{escaped}!B{start}:{end_column}{end}',
            valueRenderOption='FORMATTED_VALUE'))
        chunk = response.get('values', [])
        rows.extend(chunk)
        rows.extend([[] for _ in range(end - start + 1 - len(chunk))])
    if not rows:
        raise live.DataError(f'{title}: missing weekly headers and KPI rows.')
    headers = rows[0]
    cell = lambda offset: headers[offset] if offset < len(headers) else ''
    weekly_names = {'weekly', 'week', 'weekbeginning', 'wb', 'weekstart'}
    if live.normalized(cell(0)) in weekly_names:
        offset = 0
    elif (live.normalized(cell(0)) in {'convertedweek', 'convertedweekly'} and
          live.normalized(cell(1)) in weekly_names):
        offset = 1
        if grid['columnCount'] < 11:
            raise live.DataError(f'{title}: converted-week layout requires date C and eight KPIs D:K.')
    else:
        raise live.DataError(f'{title}: expected Weekly at B2, or Converted Week at B2 and Weekly at C2.')
    # Drop only the display-only converted week. Actual source dates remain
    # authoritative, including calendar-year handling and completed-week rules.
    normalized_rows = [row[offset:offset + 9] for row in rows]
    as_of = (live.config_date(config['as_of_date'], 'as_of_date') or
             datetime.now(ZoneInfo(config['timezone'])).date())
    result = live.parse_lob(title, normalized_rows, config, as_of,
                            metadata.get('properties', {}).get('locale', 'en_US'))
    columns = {metric.key: chr(ord(metric.column) + offset) for metric in live.METRICS}
    result['sheet_id'] = properties['sheetId']
    result['source_mapping'] = {
        'sheet': title, 'sheet_gid': properties['sheetId'],
        'range': ('C:K' if offset else 'B:J'), 'date_column': chr(ord('B') + offset),
        'metric_columns': columns, 'goal_cells': {key: column + '3' for key, column in columns.items()}}
    return spreadsheet_id, as_of, [result], list(result['warnings'])


def _gau_liveassist_audit_record(lob):
    """Retain the existing analytical audit with the true shifted source cells."""
    record = load_components()[2].audit_record(lob)
    mapping = lob.get('source_mapping')
    if mapping:
        record['source'] = mapping
        for metric in record['metrics']:
            key = metric['key']
