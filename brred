def build_pages(standard_lobs,live_lob,model,width=720,height=405,font='Poppins',direction='neutral'):
    """Return all five native slide request plans; no Google calls here."""
    kpi,panels,live=load_components()
    _gau_prepare_monthly_banners(None,None,None,model)
    class StandardStrip(kpi.StripBuilder):
        def text(self,label,*args,**kwargs):
            # The combined deck supplies the reference-style banner separately.
            if label=='context':return None
            return super().text(label,*args,**kwargs)
    class LiveAssistView(live.LiveAssistBuilder):
        def text(self,label,text,*args,**kwargs):
            if label in ('footer','source_date'):
                return None
            if label=='week':
                text=week_label(live_lob['week'])
            elif label=='x_label':
                card=next(c for c in live_lob['cards'] if c['metric'].key=='takeover_smiley')
                matches=[day for day in card['dates'] if day.strftime('%b %d')==str(text)]
                if len(matches)!=1:
                    raise ValueError('LIVEASSIST trend tick does not match an actual source date: '+str(text))
                text=week_label(matches[0])
            return super().text(label,text,*args,**kwargs)
    pages=[]
    for lob,section in zip(standard_lobs,model['sections']):
        sid='gau_'+uuid.uuid4().hex[:12]
        groups=[StandardStrip(sid,width,height,font).strip(lob)]
        data=_gau_panel_data(section,model)
        for tag,fn in [('trajectory',_gau_trajectory_panel),('drivers',_gau_drivers_panel)]:
            groups.append(fn(panels.PanelCanvas(sid,width,height,font,tag),data,model))
        insight=_gau_monthly_banner_insight(section,model)
        section['gau_executive_insight']=insight
        _gau_reflow_for_banner(groups,height)
        groups.append(_gau_executive_banner(panels.PanelCanvas(sid,width,height,font,'executive'),insight))
        header=report_header(panels.PanelCanvas(sid,width,height,font,'header'),lob)
        pages.append({'lob':lob['lob'],'slide_id':sid,'manifests':groups,'header':header,
                      'kpi_count':5,'executive_insight':insight})
    sid='gau_la_'+uuid.uuid4().hex[:10]
    settings=dict(live.CONFIG,takeover_rate_direction=direction)
    groups=[LiveAssistView(sid,width,height,font).cards(live_lob,settings),
            LiveAssistView(sid,width,height,font,'history').trajectory(live_lob)]
    _gau_liveassist_banner_spacing(groups,height)
    groups.append(_gau_liveassist_manual_banner(panels.PanelCanvas(sid,width,height,font,'manual')))
    pages.append({'lob':'LIVEASSIST','slide_id':sid,'manifests':groups,'header':[],'kpi_count':8})
    if [p['lob'].strip().upper() for p in pages]!=list(ALL_LOBS):
        raise ValueError('All five LOBs are required; no output was created.')
    return [_gau_square_all_boxes(page) for page in
            _gau_fit_lob_unavailable_notes(_gau_square_kpi_cards(pages),width)]


