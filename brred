def _gau_exec_scalar(value):
    """Finite scalar parser; accounting negatives and explicit percentages are valid."""
    if value is None or isinstance(value, bool):
        return None
    if isinstance(value, (float, int)):
        return float(value) if math.isfinite(float(value)) else None
    text = str(value).strip().replace('\u2212', '-').replace('\u00a0', '')
    if not text or text.startswith('#') or text in ('\u2014', '-', 'N/A'):
        return None
    negative = text.startswith('(') and text.endswith(')')
    if negative:
        text = text[1:-1].strip()
    text = text.replace(',', '').replace('$', '').strip()
    percent = text.endswith('%')
    if percent:
        text = text[:-1].strip()
    try:
        result = float(text) / (100.0 if percent else 1.0)
        if negative:
            result = -abs(result)
        return result if math.isfinite(result) else None
    except (TypeError, ValueError, OverflowError):
        return None

def _gau_exec_rate(value, allow_negative=False):
    """Preserve native Sheets ratios, including attainment above 150%.

    Numeric API values are never divided again. Text '80%' and legacy text
    '80' both mean .8; text ratios between -1.5 and 1.5 remain ratios. For
    unambiguous text attainment above 150%, enter an explicit % in Sheets.
    """
    number = _gau_exec_scalar(value)
    if number is None:
        return None
    if isinstance(value, str) and not value.strip().endswith(('%', '%)')):
        if 1.5 < abs(number) <= 100:
            number /= 100.0
        elif abs(number) > 100:
            return None
    if number < 0 and not allow_negative:
        return None
    return number

def _gau_exec_date(value):
    if isinstance(value, bool) or value is None:
        return None
    if isinstance(value, datetime):
        return value.date()
    if isinstance(value, date):
        return value
    if isinstance(value, (float, int)):
        if not math.isfinite(float(value)):
            return None
        try:
            return (datetime(1899, 12, 30) + timedelta(days=float(value))).date()
        except (OverflowError, ValueError):
            return None
    text = str(value).strip()
    for fmt in ('%m/%d/%Y', '%Y-%m-%d', '%m/%d/%y', '%b %d, %Y'):
        try:
            return datetime.strptime(text, fmt).date()
        except ValueError:
            pass
    return None

def _gau_exec_cell(rows,absolute_row,absolute_col,first_row,first_col):
    r=absolute_row-first_row;c=absolute_col-first_col
    return rows[r][c] if 0<=r<len(rows) and 0<=c<len(rows[r]) else ''

def _gau_exec_padded(values,expected_rows):
    result=[list(row) for row in values]
    return result+[[] for _ in range(max(0,expected_rows-len(result)))]

def _gau_exec_reporting_month(value):
    """Format the explicit EXECVIEW B3 value, never infer it from today's date."""
    if isinstance(value,bool) or value is None:
        raise ValueError('EXECVIEW!B3 must contain the reporting month.')
    parsed=_gau_exec_date(value)
    if parsed:return parsed.strftime('%b-%Y').upper()
    text=str(value).strip()
    # A month-only cell remains month-only: do not invent a year from the clock.
    for fmt in ('%b','%B'):
        try:return datetime.strptime(text,fmt).strftime('%b').upper()
        except ValueError:pass
    for fmt in ('%b-%Y','%B-%Y','%b %Y','%B %Y','%Y-%m','%m/%Y','%m-%Y',
                '%b-%y','%B-%y','%b %d, %Y','%B %d, %Y','%d-%b-%Y'):
        try:return datetime.strptime(text,fmt).strftime('%b-%Y').upper()
        except ValueError:pass
    raise ValueError('EXECVIEW!B3 must contain a valid reporting month; '
                     'for example October, Oct-2026 or an actual spreadsheet date.')

def _gau_exec_financial_columns(rows, tab):
    """Map the current EXECVIEW F6:P6 headers without assuming metric positions."""
    import re
    groups = {
        'Site': ('SITE',), 'HC': ('HC', 'ACTUALHC', 'HEADCOUNT'), 'GPR': ('GPR',),
        'Revenue': ('REVENUE', 'PROJECTEDREVENUE'),
        'Revenue Attainment': ('REVENUEATTAINMENT', 'REVENUEATTAIN'),
        'SM': ('SM', 'SIMPLEMARGIN'), 'GM': ('GM', 'GROSSMARGIN'),
        'PL': ('PL', 'PLANNEDLEAVE'), 'UL': ('UL', 'UNPLANNEDLEAVE'),
        'Attrition': ('ATTRITION',), 'Hours Delivery': ('HOURSDELIVERY', 'HOURSDELIVERED')}
    aliases = {alias: key for key, names in groups.items() for alias in names}
    result = {}
    for col in range(6, 17):
        raw = _gau_exec_cell(rows, 6, col, 5, 6)
        key = aliases.get(re.sub(r'[^A-Z0-9]', '', str(raw).upper()))
        if key is None:
            continue
        if key in result:
            raise ValueError(f'Duplicate financial header {key!r} at '
                             f'{tab}!{chr(64 + result[key])}6 and {chr(64 + col)}6.')
        result[key] = col
    missing = [key for key in _GAU_EXEC_FIN_COLS if key not in result]
    if missing:
        raise ValueError(f'Financial header missing from {tab}!F6:P6: ' + ', '.join(missing))
    return result

def _gau_exec_read_source(sheets, backend_id, model, config, standard_lobs):
    """Read monthly OPRRaw KPIs and the current EXECVIEW financial table only."""
    kpi = load_components()[0]
    gid = int(config.get('executive_source_gid', _GAU_EXEC_GID))
    meta = kpi.read_source_metadata(sheets, backend_id)
    matches = [s['properties'] for s in meta.get('sheets', []) if s['properties'].get('sheetId') == gid]
    if len(matches) != 1:
        raise ValueError(f'EXECVIEW financial worksheet GID {gid} was not found. '
                         'Correct CONFIG["executive_source_gid"].')
    tab = matches[0]['title']
    escaped = "'" + tab.replace("'", "''") + "'"
    monthly = _gau_oprraw_table(sheets, backend_id, config, monthly=True, metadata=meta)
    month = monthly['latest']
    selected = _gau_oprraw_selected(monthly, month)
    keys = {'smiley': 'SMILEY', 'aht': 'AHT', 'aftr': 'AFTR', 'qa': 'QA', 'sentiment': 'SENT'}
    metric_rows = {}
    for lob in STANDARD_LOBS:
        metric_rows[lob] = {}
        for metric in kpi.METRICS:
            record = selected[lob][metric.key]
            metric_rows[lob][keys[metric.key]] = {
                'actual': float(record['actual']), 'goal': float(record['goal']),
                'higher_better': not metric.lower_is_better,
                'source_row': record['row'], 'goal_cell': record['goal_cell'], 'score_cell': record['score_cell']}
    response = kpi.execute(sheets.spreadsheets().values().batchGet(
        spreadsheetId=backend_id, ranges=[f'{escaped}!F5:P11'],
        valueRenderOption='UNFORMATTED_VALUE', dateTimeRenderOption='SERIAL_NUMBER'))
    returned = response.get('valueRanges', [])
    if len(returned) != 1:
        raise ValueError(f'Missing {tab}!F5:P11 financial range.')
    fr = _gau_exec_padded(returned[0].get('values', []), 7)
    header = str(_gau_exec_cell(fr, 5, 6, 5, 6))
    if 'Revenue' not in header or 'GEO' not in header:
        raise ValueError(f'{tab}!F5 expected Revenue & GM Forecast per GEO heading.')
    financial_columns = _gau_exec_financial_columns(fr, tab)
    warnings, sites = [], []
    for row, name in zip(range(7, 12), ('ARN', 'HTW', 'MTQ', 'PHX', 'Overall')):
        found = str(_gau_exec_cell(fr, row, financial_columns['Site'], 5, 6)).strip()
        if found.upper() != name.upper():
            raise ValueError(f'Expected {name} in {tab}!{chr(64 + financial_columns["Site"])}{row}, found {found!r}.')
        record = {'Site': name}
        for key in _GAU_EXEC_FIN_COLS[1:]:
            col = financial_columns[key]
            raw = _gau_exec_cell(fr, row, col, 5, 6)
            number = (_gau_exec_rate(raw, allow_negative=key in ('SM', 'GM'))
                      if key in ('GPR', 'Revenue Attainment', 'SM', 'GM', 'PL', 'UL', 'Attrition')
                      else _gau_exec_scalar(raw))
            if number is not None:
                invalid = ((key in ('HC', 'Revenue', 'Hours Delivery') and number < 0)
                           or (key in ('GPR', 'PL', 'UL', 'Attrition') and not 0 <= number <= 1)
                           or (key in ('SM', 'GM') and number > 1))
                if invalid:
                    number = None
            record[key] = number
            if number is None:
                warnings.append(f'{tab}!{chr(64 + col)}{row} missing/invalid: {key} for {name}; shown as a dash.')
        sites.append(record)
    for key, tolerance in (('HC', .5), ('Revenue', 5.0)):
        values = [record.get(key) for record in sites]
        if all(value is not None for value in values):
            difference = sum(values[:-1]) - values[-1]
            if abs(difference) > tolerance:
                warnings.append(f'{tab}: site {key} sum differs from Overall by {difference:,.2f}; source values retained.')
    financial_date = None
    import re
    match = re.search(r'as\s+of\s+(\d{1,2}/\d{1,2}/\d{4})', header, re.I)
    if match:
        financial_date = _gau_exec_date(match.group(1))
    if not financial_date:
        warnings.append(f'{tab}!F5 does not contain a parseable financial as-of date.')
    # Approved POC notes retain their original Whitepaper report-week key.
    # Monthly KPI selection does not retime any Whitepaper calculation or note.
    week = model['period_start'].date()
    manual = _gau_exec_read_manual(sheets, backend_id, meta, week, config, warnings)
    return {'sheet': tab, 'sheet_gid': gid, 'week': week, 'financial_as_of': financial_date,
            'reporting_month': month.strftime('%b-%Y').upper(), 'scorecard_month': month,
            'reporting_month_source': monthly['sheet'] + '!K:P',
            'kpi_sheet': monthly['sheet'], 'kpi_sheet_gid': monthly['sheet_gid'],
            'kpi_source_range': 'K:P', 'kpis': metric_rows, 'sites': sites, 'overall': sites[-1],
            'manual': manual, 'warnings': warnings, 'financial_heading': header,
            'hours_placeholder': False,
            'financial_columns': {key: chr(64 + col) for key, col in financial_columns.items()},
            'hours_delivery_cell': chr(64 + financial_columns['Hours Delivery']) + '11'}
def _gau_exec_read_manual(sheets,backend_id,metadata,week,config,warnings):
    """Approved notes only. No automatic creation or modification of backend tabs."""
    tab=str(config.get('executive_input_tab','GAU_Executive_Inputs'))
    titles={s['properties']['title'] for s in metadata.get('sheets',[])}
    if tab not in titles:
        warnings.append(f'Optional {tab!r} does not exist: manual discussion input is unavailable; Whitepaper challenges and pivots remain automatic.')
        return {}
    kpi=load_components()[0]
    escaped="'"+tab.replace("'","''")+"'"
    values=kpi.execute(sheets.spreadsheets().values().get(
        spreadsheetId=backend_id,range=f'{escaped}!A:G',valueRenderOption='UNFORMATTED_VALUE',dateTimeRenderOption='SERIAL_NUMBER')).get('values',[])
    required=('Week Beginning','Panel','Mode','Manual Commentary','Reviewed By','Review Status','Updated At')
    if not values or tuple(str(x).strip().lower() for x in values[0][:7])!=tuple(x.lower() for x in required):
        raise ValueError(f'{tab}!A1:G1 must equal: '+', '.join(required))
    selected={};seen=set()
    for ix,row in enumerate(values[1:],start=2):
        row=list(row)+['']*max(0,7-len(row))
        if not any(str(x).strip() for x in row):continue
        this_week=_gau_exec_date(row[0])
        if this_week!=week:continue
        panel=str(row[1]).strip();mode=str(row[2]).strip().upper()
        # Preserve existing approved Help Needed entries after the panel rename.
        if panel=='Help Needed':panel='Immediate Tactical Pivots'
        status=str(row[5]).strip().upper()
        content=str(row[3]).strip()
        if panel not in _GAU_EXEC_PANEL_NAMES:raise ValueError(f'{tab}!B{ix}: unknown panel {panel!r}.')
        if panel in seen:raise ValueError(f'{tab}: duplicate {panel} rows for {week}; use one entry per panel/week.')
        seen.add(panel)
        if mode not in ('AUTO','APPEND','OVERRIDE'):raise ValueError(f'{tab}!C{ix}: mode must be AUTO/APPEND/OVERRIDE.')
        if status not in ('APPROVED','DRAFT',''):
            raise ValueError(f'{tab}!F{ix}: Review Status must be Draft or Approved.')
        if status!='APPROVED' and mode!='AUTO':
            warnings.append(f'{tab}: unapproved {panel} note ignored (row {ix}).')
            continue
        if mode in ('APPEND','OVERRIDE') and (not content or not str(row[4]).strip()):
            raise ValueError(f'{tab}!D{ix}: manual content and Reviewed By are both required for {mode}.')
        if mode=='AUTO':selected[panel]={'mode':'AUTO','text':'','row':ix}
        else:selected[panel]={'mode':mode,'text':content,'row':ix}
    return selected

def _gau_exec_fmt_percent(value,decimals=2):
    return '—' if value is None else f'{value*100:.{decimals}f}%'

def _gau_exec_fmt_number(value,decimals=0):
    return '—' if value is None else f'{value:,.{decimals}f}'

def _gau_exec_short(text,max_chars=230):
    """Stop overflow without changing source or silently adding unsupported text."""
    s=' '.join(str(text or '').split())
    if len(s)<=max_chars:return s
    words=s[:max_chars-1].rsplit(' ',1)
    return (words[0] if words else s[:max_chars-1])+'…'

def _gau_exec_auto_narratives(source,model,config):
    """Numerical interpretation comes only from the unchanged analytical model.

    Backend SENT remains on the operational summary cards. The embedded engine
    has no Merchant Sentiment model, so do not infer sentiment from Smiley or
    generate a backend-derived sentiment conclusion. Approved POC modes remain.
    """
    entries=[_gau_monthly_banner_insight(s,model)
             for s in model['sections']]
    supported=[i for i in entries if i.get('metric')]
    supported.sort(key=lambda i:tuple(i.get('priority') or [0]),reverse=True)
    if supported:
        selected=supported[0]
        summary=selected.get('overview_performance')
        performance=f"{selected['lob']}: {summary}" if summary else f"{selected['lob']}: {selected.get('callout',selected['headline'])} {selected.get('executive_narrative','')}"
    else:
        performance='Insufficient validated analytical evidence for a performance summary.'
    challenges=[]
    for insight in supported:
        gap=insight.get('target_gap')
        if gap is None:continue
        adverse=gap>0 if insight['metric']=='AHT' else gap<0
        if adverse or insight.get('persistent_miss'):
            challenges.append(f"{insight['lob']}: {insight.get('callout',insight['headline'])}")
    return {'Merchant Sentiment':'No validated Merchant Sentiment analytical evidence available.',
            'Performance Summary':performance,
            'Challenges & Escalations':' '.join(challenges[:2]) or 'No supported current target breach selected.',
            'Strategies':'Awaiting approved POC strategy input.',
            'Immediate Tactical Pivots':'Awaiting approved POC executive request.'}

