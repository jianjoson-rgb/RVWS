function server(name,payload){
  if(window.__OMG_PREVIEW_API__)return new Promise((resolve,reject)=>setTimeout(()=>{try{resolve(window.__OMG_PREVIEW_API__[name](payload));}catch(e){reject(e);}},30));
  return new Promise((resolve,reject)=>{
    if(!(window.google&&google.script&&google.script.run)){reject(new Error('Open the deployed Apps Script web app. Use Preview.html for the synthetic demonstration.'));return;}
    const runner=google.script.run.withSuccessHandler(resolve).withFailureHandler(reject);
    if(name==='getDashboard')runner.getDashboard(payload);else runner.getAuditPage(payload);
  });
}
