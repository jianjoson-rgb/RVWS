function paretoHtml(p,site){
  if(!p.total)return empty('No '+driverNames[p.driver]+' cases for this scope.');
  const max=Math.max(...p.items.map(r=>r.count),1);
  let html='<p class="section-note">'+num(p.represented)+' / '+num(p.total)+' cases · '+pct(p.representedPct)+' represented by the leading named causes. Threshold: at least '+p.threshold+'%. Shares include missing causes in the denominator.</p>';
  html+=p.items.map(r=>'<div class="pareto-row '+esc(r.kind)+'"><div>'+
    (r.kind==='cause'||r.kind==='missing'?drillButton(r.cause,{site:site||'',driver:p.driver,cause:r.cause}):'<b>Other</b>')+
    (r.kind==='cause'?'<span class="cell-denom">Cumulative '+pct(r.cumulative)+'</span>':'')+
    '</div><div class="pareto-track"><div class="pareto-fill" style="width:'+(100*r.count/max).toFixed(2)+'%"></div></div><div class="pareto-value"><b>'+num(r.count)+'</b><span class="cell-denom">'+pct(r.share)+'</span></div></div>').join('');
  if(p.other.length)html+='<details class="other-details"><summary>Other combines '+p.other.length+' named causes · '+num(p.otherCount)+' cases</summary><div class="other-content">'+p.other.map(r=>drillButton(r.cause,{site:site||'',driver:p.driver,cause:r.cause})+' ('+num(r.count)+'; '+pct(r.share)+')').join('; ')+'.</div></details>';
  if(!p.reached)html+='<p class="section-note">Recorded named causes do not reach the 40% threshold. Missing causes are displayed separately.</p>';
  return html;
}
