def load_components():
    """Load the existing complete generators unchanged, without their entrypoints."""
    global _COMPONENTS
    if _COMPONENTS is not None:
        return _COMPONENTS
    modules=[]
    for key in ("kpi", "panels", "liveassist"):
        spec=_SOURCES[key]
        content=zlib.decompress(base64.b64decode(''.join(spec['data'].split()),validate=True))
        if hashlib.sha256(content).hexdigest()!=spec['sha256']:
            raise RuntimeError(f"Embedded {key} source failed its integrity check.")
        name='_gau_all_lobs_'+key+'_v120'
        module=types.ModuleType(name)
        module.__file__='embedded_'+spec['filename']
        sys.modules[name]=module
        exec(compile(content.decode('utf-8'),module.__file__,'exec'),module.__dict__)
        modules.append(module)
    _COMPONENTS=tuple(modules)
    return _COMPONENTS


