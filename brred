"""Monthly executive banners only; original weekly/forecast engines are reused."""

def _gau_monthly_windows(model):
    import pandas as pd
    cal=model.get('calendar',{})
    if not cal.get('months') or cal.get('cutoff') is None:
        return {'available':False,'reason':'Monthly reporting dates are unavailable.'}
    start=pd.Timestamp(cal['months'][0]).normalize();cutoff=pd.Timestamp(cal['cutoff']).normalize()
    previous=start-pd.offsets.MonthBegin(1)
    if cutoff<start:
        return {'available':False,'reason':'No current-month observations precede the reporting cutoff.',
                'month':start,'cutoff':cutoff}
    observed_end=min(cutoff,start+pd.offsets.MonthEnd(0))
    elapsed=min(observed_end.day,previous.days_in_month)
    end=start+pd.Timedelta(days=elapsed-1);prior_end=previous+pd.Timedelta(days=elapsed-1)
    return {'available':True,'month':start,'cutoff':cutoff,'start':start,'end':end,
            'previous_start':previous,'previous_end':prior_end,'matched_days':elapsed,
            'common_day_cap':end<observed_end,
            'label':f'{start:%b} 1–{end.day}',
            'basis':'Same elapsed calendar dates in current and previous month, at the established reporting cutoff.'}


def _gau_monthly_driver_rows(engine,current,previous,settings):
    """Same contribution formula/reportability/site filters, matched monthly frames."""
    import math
    candidates=[]
    for dimension,columns in (('Site',['Site']),('Contact taxonomy',['Level One']),
                               ('Tenure group',['Tenure Group']),('Squad',['Site','Squad Code'])):
        if any(c not in current or c not in previous for c in columns):continue
        table=engine._v574_group_table(current,previous,columns)
        if len(table)<2:continue
        difference=engine.weighted_rate(current)-engine.weighted_rate(previous)
        if _gau_num(difference) is not None and not math.isclose(float(table.contribution.sum()),float(difference),abs_tol=1e-10):
            raise ValueError('Monthly banner driver decomposition failed reconciliation.')
        for row in table.to_dict('records'):
            if (min(row['n'],row['nb'])<settings.minimum_reportable_n
                    or any(row[c]=='Unclassified' for c in columns)
                    or not (row['delta'] < -settings.banner_material_delta or row['contribution'] < -settings.banner_material_delta)
                    or _gau_num(row['contribution']) is None or row['contribution']>=0):continue
            if ('Site' in columns and settings.document_approved_sites_only
                    and row['Site'] not in engine.approved_site_set(settings)):continue
            values=tuple(row[c] for c in columns);label=' / '.join(map(str,values))
            if engine._GA584_EXCLUDED.search(label) or label.strip().casefold() in ('chat','phones','async'):continue
            membership=set(current.loc[engine._ga584_segment_mask(current,columns,values),'Ticket ID'].astype(str))
            candidates.append({'label':label,'dimension':dimension,'kpi':'Smiley',
                'impact':float(row['contribution']),'n':float(min(row['n'],row['nb'])),
                'details':row,'membership':membership,
                'basis':'Current matched monthly portion versus previous matched monthly portion.'})
    candidates.sort(key=lambda d:(d['impact'],-d['n'],d['label']))
    chosen=[]
    for row in candidates:
        if any(row['membership'] and other['membership'] and
               len(row['membership']&other['membership'])/min(len(row['membership']),len(other['membership']))>=.8
               for other in chosen):continue
        chosen.append(row)
        if len(chosen)==3:break
    return [{k:v for k,v in row.items() if k!='membership'} for row in chosen]


def _gau_prepare_monthly_banners(engine,normalized,ec,model):
    """Separate monthly evidence. Never mutates weekly KPIs, drivers or forecasts.

    The production path uses the original snapshot/LOB filters. Offline callers
    may supply the existing disjoint weekly-current + 12-week baseline frames,
    which already contain the eligible historical population for these months.
    """
    import pandas as pd
    if normalized is None and all(s.get('gau_monthly_banner_data') is not None
                                  for s in model.get('sections',[])):
        return model
    windows=_gau_monthly_windows(model)
    raw=rated=None
    if windows['available']:
        if engine is None:engine=load_components()[1].load_engine(offline=True)
        if normalized is not None:
            raw,rated,_,_,_=engine._ga585_snapshot(normalized,windows['cutoff'],ec)
    for section in model.get('sections',[]):
        if normalized is None and section.get('gau_monthly_banner_data') is not None:continue
        data={'available':False,'windows':windows,'reason':windows.get('reason',''),
              'source':'Whitepaper','comparison_basis':'same elapsed portion of the previous month'}
        if not windows['available']:
            section['gau_monthly_banner_data']=data;continue
        settings=section.get('config');lob=section['lob']
        if settings is None:
            data['reason']='Monthly source observations are unavailable.'
            section['gau_monthly_banner_data']=data;continue
        if rated is not None:
            pool=rated.loc[engine._ga585_business(rated,lob,ec)].copy()
            raw_pool=raw.loc[engine._ga585_business(raw,lob,ec)].copy()
        else:
            frames=[section[k] for k in ('baseline','current')
                    if isinstance(section.get(k),pd.DataFrame) and not section[k].empty]
            if not frames:
                data['reason']='Monthly source observations are unavailable.'
                section['gau_monthly_banner_data']=data;continue
            pool=pd.concat(frames,ignore_index=True)
            # These frames already carry the established eligible/deduplicated
            # population. No new deduplication or source-matching rule is added.
            raw_pool=pool
        current=pool.loc[pool.Date.between(windows['start'],windows['end'])].copy()
        previous=pool.loc[pool.Date.between(windows['previous_start'],windows['previous_end'])].copy()
        observed=set(pd.DatetimeIndex(raw_pool['Date'].dropna()).normalize())
        missing_current=[str(d.date()) for d in pd.date_range(windows['start'],windows['end']) if d not in observed]
        missing_previous=[str(d.date()) for d in pd.date_range(windows['previous_start'],windows['previous_end']) if d not in observed]
        data.update(missing_current_dates=missing_current,missing_previous_dates=missing_previous)
        if missing_current or missing_previous:
            pieces=[]
            if missing_current:pieces.append(f'{len(missing_current)} current-month')
            if missing_previous:pieces.append(f'{len(missing_previous)} previous-month')
            data['reason']='Monthly comparison unavailable: '+ ' and '.join(pieces)+' source date(s) absent in the matched periods.'
            section['gau_monthly_banner_data']=data;continue
        metrics=[]
        for name in engine.GAU_METRICS_V585:
            a=engine._ga584_kpi_value(current,name,settings)
            b=engine._ga584_kpi_value(previous,name,settings)
            target,direction,target_basis=engine._ga585_target(lob,name,windows['start'],windows['end'],engine._ga585_components(current,name),settings)
            prior_target,prior_direction,prior_basis=engine._ga585_target(lob,name,windows['previous_start'],windows['previous_end'],engine._ga585_components(previous,name),settings)
            metrics.append({'kpi':name,'value':_gau_num(a['value']),'n':a['n'],
                'numerator':a['numerator'],'denominator':a['denominator'],
                'previous_value':_gau_num(b['value']),'previous_n':b['n'],
                'previous_numerator':b['numerator'],'previous_denominator':b['denominator'],
                'target':_gau_num(target),'direction':direction,'target_basis':target_basis,
                'previous_target':_gau_num(prior_target),'previous_direction':prior_direction,
                'previous_target_basis':prior_basis})
        smiley=next(m for m in metrics if m['kpi']=='Smiley')
        if min(smiley['n'],smiley['previous_n'])<settings.minimum_reportable_n:
            data['reason']='Monthly comparison unavailable: insufficient measured responses in one or both matched periods.'
            data['metrics']=metrics;section['gau_monthly_banner_data']=data;continue
        drivers=_gau_monthly_driver_rows(engine,current,previous,settings)
        site_details=_gau_site_details(engine,{'current':current,'baseline':previous,'drivers':drivers},settings)
        for detail in site_details.values():
            detail['basis']='Within-site matched monthly movement; not additive to LOB contribution.'
        data.update(available=True,reason='',metrics=metrics,drivers=drivers,site_details=site_details,
                    minimum_reportable_n=settings.minimum_reportable_n)
        section['gau_monthly_banner_data']=data
    model['gau_banner_comparison_basis']='current month versus same elapsed portion of previous month'
    return model


def _gau_monthly_banner_insight(section,model):
    """Monthly-only selection/copy. Weekly charts and driver panels stay separate."""
    import math
    if section.get('gau_monthly_banner_data') is None:
        _gau_prepare_monthly_banners(None,None,None,model)
    data=section.get('gau_monthly_banner_data',{})
    windows=data.get('windows',{})
    common={'lob':section['lob'],'source':'Whitepaper monthly matched-period evidence',
            'comparison_scope':'current month versus same elapsed portion of previous month',
            'projection_scope':'current-month EOM only',
            'periods':{key:str(windows[key].date()) for key in ('start','end','previous_start','previous_end','cutoff') if key in windows},
            'matched_days':windows.get('matched_days'),'common_day_cap':windows.get('common_day_cap',False)}
    def unavailable(reason):
        return dict(common,metric=None,severity='unverified',headline='Monthly comparison unavailable',
            support=reason,reason=reason,driver=None,forecast_available=False,priority=[-1])
    if not data.get('available'):return unavailable(data.get('reason') or 'Monthly source observations are unavailable.')
    candidates=[];minimum=data['minimum_reportable_n']
    for metric in data['metrics']:
        name=metric['kpi'];value=metric['value'];previous=metric['previous_value'];target=metric['target'];direction=metric['direction']
        if (name not in _GAU_KPI_LABELS or value is None or previous is None or target is None
                or direction not in ('higher','lower') or min(metric['n'],metric['previous_n'])<minimum):continue
        adverse=target-value if direction=='higher' else value-target
        category,tier,_=(_gau_severity_bps(adverse) if name in _GAU_RATE_KPIS
                         else ('unit-based target breach',2 if adverse>0 else 0,None))
        delta=value-previous;adverse_movement=delta<0 if direction=='higher' else delta>0
        previous_target=metric['previous_target']
        persistent=(adverse>0 and previous_target is not None and metric['previous_direction']==direction
                    and (previous<previous_target if direction=='higher' else previous>previous_target))
        forecast=_gau_forecast_evidence(section,name,direction,model)
        projected_miss=any(f['miss'] for f in forecast)
        improving=abs(delta)>1e-9 and not adverse_movement
        if adverse>0:priority=(tier+2,int(persistent),int(projected_miss),int(adverse_movement),max(0.,min(1.,adverse)),name=='Smiley')
        elif projected_miss:priority=(2,int(adverse_movement),1,0,0,name=='Smiley')
        elif adverse_movement and name in _GAU_RATE_KPIS and abs(delta)>=.01:priority=(1,0,0,1,abs(delta),name=='Smiley')
        else:priority=(0,int(improving),0,0,0,name=='Smiley')
        candidates.append(dict(metric,adverse=adverse,delta=delta,severity=category,priority=priority,
                               persistent=persistent,forecast=forecast,projected_miss=projected_miss))
    if not candidates:return unavailable('An applicable monthly target and sufficient measured observations are required.')
    selected=max(candidates,key=lambda m:m['priority']);name=selected['kpi'];label=_GAU_KPI_LABELS[name]
    value=selected['value'];target=selected['target'];delta=selected['delta'];is_rate=name in _GAU_RATE_KPIS
    units='pp' if is_rate else 'min';scale=100 if is_rate else 1
    signed=(value-target)*scale
    direction_word='above' if delta>0 else 'below' if delta<0 else 'unchanged'
    movement=(f'{abs(delta)*scale:.2f} {units} {direction_word} the previous month.'
              if abs(delta)>1e-10 else 'Unchanged from the previous month.')
    # Keep the user-facing phrase explicit, without comparison abbreviations.
    movement=(f'{"Up" if delta>0 else "Down"} {abs(delta)*scale:.2f} {units} from the previous month.'
              if abs(delta)>1e-10 else 'Unchanged from the previous month.')
    result=(f'{value*100:.2f}%' if is_rate else f'{value:.2f}')
    goal=(f'{target*100:.2f}%' if is_rate else f'{target:.2f}')
    callout=f'{windows["label"]} {label} {result} vs {goal} target ({signed:+.2f} {units}).'
    rows=data.get('drivers',[]) if name=='Smiley' else []
    driver=rows[0] if rows else None;detail=None;driver_text='';layer='';brief_driver=''
    if driver:
        full=driver['label'];impact=driver['impact']*100
        driver_text=f'{full} contributed {impact:+.2f} pp to the change from the previous month.'
        brief_driver=f'{full} {impact:+.2f} pp.'
        if driver['dimension']=='Site':
            detail=data.get('site_details',{}).get(full)
            if detail:
                layer=f'Within {full}: {detail["label"]} {detail["impact"]*100:+.2f} site pp, not additive.'
                brief_driver+=f' Within site: {detail["label"]} {detail["impact"]*100:+.2f} site pp.'
        recommendation=(f'Focus recovery on {detail["label"]} in {full}.' if detail
                        else f'Focus recovery on {full}.') if selected['adverse']>0 else ''
    else:recommendation=''
    if not recommendation:
        if selected['adverse']>0:recommendation=f'Prioritize closing the {label} gap.'
        elif selected['projected_miss']:recommendation=f'Protect {label} against current-month closing risk.'
        elif (delta<0 if selected['direction']=='higher' else delta>0):recommendation=f'Stabilize {label} performance.'
        elif abs(delta)>1e-9:recommendation=f'Sustain {label} progress.'
        else:recommendation=f'Maintain {label} performance at goal.'
    forecasts=selected['forecast']
    if forecasts:
        f=forecasts[0];forecast_value=f'{f["value"]*scale:.2f}'+('%' if is_rate else ' min')
        gap=(f['value']-f['target'])*scale
        comparison=f'{abs(gap):.2f} {units} {"below" if gap<0 else "above"} goal' if abs(gap)>1e-10 else 'at goal'
        outlook=f'{f["month"]} EOM: {forecast_value}, {comparison}.'
    else:outlook='Current-month EOM unavailable.'
    narrative=' '.join(x for x in (movement,driver_text,layer,outlook) if x)
    brief_result=f'{windows["label"]} {label} {result} ({signed:+.2f} {units} vs goal).'
    overview=' '.join(x for x in (brief_result,movement,brief_driver,recommendation,outlook) if x)
    performance=' '.join(x for x in (brief_result,movement,brief_driver,outlook) if x)
    return dict(common,metric=name,severity=selected['severity'],headline=recommendation,
        support=callout+' '+narrative,callout=callout,executive_narrative=narrative,
        recommendation=recommendation,movement=movement,driver=driver_text or None,
        site_layer=layer,implication='',outlook=outlook,overview_summary=overview,
        overview_performance=performance,target_gap=value-target,priority=list(selected['priority']),
        persistent_miss=bool(selected['persistent']),persistence_basis='Two matched monthly portions below their applicable targets.',
        forecast_available=bool(forecasts),ranked_metrics=[m['kpi'] for m in candidates],
        current_value=value,previous_value=selected['previous_value'],change_from_previous_month=delta,
        driver_evidence=driver,site_evidence=detail)


def _gau_exec_text_width(text, size):
    """Conservative font-width estimate; includes a safety allowance for Poppins."""
    import unicodedata
    units = 0.
    for char in str(text):
        if unicodedata.combining(char):continue
        if unicodedata.east_asian_width(char) in ('W','F'):units += 1.05
        elif char in 'ilI.,:;!\'`|':units += .32
        elif char in 'MW@%&#':units += .96
        elif char.isspace():units += .36
        elif char.isupper() or char.isdigit():units += .70
        else:units += .62
    return units*float(size)


def _gau_exec_one_line_size(text, width, preferred, minimum):
    """Fit the complete formatted value, including currency and percent signs."""
    if '\n' in str(text) or '\r' in str(text):
        raise ValueError('A single-line executive value contains a line break.')
    size = float(preferred)
    available = float(width)-9.2  # Native 3.6-pt insets plus a width safety allowance.
    while _gau_exec_text_width(text,size) > available and size > minimum:
        size = max(float(minimum),size-.1)
    if _gau_exec_text_width(text,size) > available:
        raise ValueError(f'Executive value cannot fit on one line: {text!r}. Widen its column.')
    return size


