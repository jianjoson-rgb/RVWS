  const d=state.data,rows=[['Period start','Period end','Scope','Site','Driver','Cause','Cases','Driver denominator','Share %','Intervened Yes','Intervention valid','Intervention %']];
  const sites=state.rootSite==='all'?d.sites:d.sites.filter(s=>s.site===state.rootSite);
  sites.forEach(s=>s.roots.filter(r=>r.driver===state.rootDriver).forEach(r=>rows.push([d.period.start,d.period.end,d.executive.scope,s.site,driverNames[r.driver],r.cause,r.count,s.drivers[r.driver].count,r.share,r.intervention.yes,r.intervention.known,r.intervention.pct])));
  downloadCsv('OMG_Roots_'+d.period.start+'_'+d.period.end+'.csv',rows);
}
function clientShift(date,days){return new Date(Date.parse(date+'T00:00:00Z')+days*86400000).toISOString().slice(0,10);}
function clientSunday(date){return clientShift(date,-new Date(date+'T00:00:00Z').getUTCDay());}
function applyPreset(){
  if(!state.data)return;const d=state.data,p=$('presetFilter').value,today=d.today;
  let end=today,start=today;
  if(p==='custom')return;
  if(p==='latest'){end=d.dateBounds.latestOnOrBeforeToday||d.dateBounds.end||today;start=clientSunday(end);}
  if(p==='yesterday')start=end=clientShift(today,-1);
  if(p==='last7')start=clientShift(end,-6);
  if(p==='last14')start=clientShift(end,-13);
  if(p==='month')start=today.slice(0,7)+'-01';
  if(p==='all'){start=d.dateBounds.start||today;end=d.dateBounds.end||today;}
  $('startFilter').value=start;$('endFilter').value=end;refresh();
}
function reset(){
  dimensions.forEach(k=>$(k+'Filter').value='all');
  ['driver','intervened','resolution'].forEach(k=>$(k+'Filter').value='all');
  $('searchFilter').value='';$('compareFilter').value='previous';$('compareStartFilter').value='';$('compareEndFilter').value='';
  document.querySelectorAll('.compare-custom').forEach(el=>el.hidden=true);
  $('startFilter').value='';$('endFilter').value='';$('presetFilter').value='latest';
  state.rootSite='all';state.rootDriver='Agent';state.dsatSite='all';state.dsatMode='contacts';state.dsatSearch='';state.dsatMin=1;state.dsatSort='repeat';refresh();
}
document.querySelectorAll('[data-tab]').forEach(el=>el.addEventListener('click',()=>openTab(el.dataset.tab)));
dimensions.concat(['driver','intervened','resolution']).forEach(k=>$(k+'Filter').addEventListener('change',()=>{
  state.rootSite='all';if(k==='driver'&&driverNames[$('driverFilter').value])state.rootDriver=$('driverFilter').value;refresh();
}));
['start','end'].forEach(k=>$(k+'Filter').addEventListener('change',()=>{$('presetFilter').value='custom';refresh();}));
['compareStart','compareEnd'].forEach(k=>$(k+'Filter').addEventListener('change',refresh));
$('compareFilter').addEventListener('change',()=>{
  const custom=$('compareFilter').value==='custom';document.querySelectorAll('.compare-custom').forEach(el=>el.hidden=!custom);
  if(custom&&state.data){const p=state.data.previousPeriod||{start:clientShift(state.data.period.start,-state.data.period.days),end:clientShift(state.data.period.start,-1)};
    if(!$('compareStartFilter').value)$('compareStartFilter').value=p.start;if(!$('compareEndFilter').value)$('compareEndFilter').value=p.end;
  }refresh();
});
$('presetFilter').addEventListener('change',applyPreset);
let searchTimer;$('searchFilter').addEventListener('input',()=>{clearTimeout(searchTimer);searchTimer=setTimeout(refresh,350);});
$('advancedButton').addEventListener('click',()=>{const open=$('advancedFilters').classList.toggle('open');$('advancedButton').setAttribute('aria-expanded',String(open));});
$('syncButton').addEventListener('click',refresh);$('resetButton').addEventListener('click',reset);
$('presentationButton').addEventListener('click',presentation);$('guideButton').addEventListener('click',()=>openModal('guideModal'));
document.querySelectorAll('[data-close-modal]').forEach(el=>el.addEventListener('click',()=>closeModal(el.dataset.closeModal)));
document.addEventListener('click',event=>{
  const el=event.target.closest('[data-action]');if(!el)return;
  const action=el.dataset.action;
  if(action==='drill')drill(el.dataset);else if(action==='copy')copyBrief();else if(action==='print'){openOtherNotes();window.print();}
  else if(action==='export-sites')exportSites();else if(action==='export-roots')exportRoots();else if(action==='quality')openTab('quality');
  else if(action==='export-dsat')exportDsat();
  else if(action==='open-dsat')openTab('dsat');
  else if(action==='dsat-mode'){state.dsatMode=el.dataset.mode==='causes'?'causes':'contacts';renderDsat();}
  else if(action==='clear-drill'){state.drill={};state.page=1;loadAudit();}
});
document.addEventListener('keydown',e=>{if(e.key==='Escape')document.querySelectorAll('.modal-backdrop').forEach(el=>el.hidden=true);});
window.addEventListener('beforeprint',openOtherNotes);
if(window.__OMG_PREVIEW_API__)document.body.classList.add('demo');
refresh();
</script>
