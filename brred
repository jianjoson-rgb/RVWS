def _gau_exec_fit_text(text, width, height, size=17, minimum=16):
    """Conservative native text fit, including Slides' default text-box insets.

    Uses only the standard library. Explicit line breaks make wrapping stable
    across exports. Any shortening is returned to the caller for audit/alt text.
    It does not depend on unsupported TEXT_AUTOFIT write requests.
    """
    import unicodedata
    text = ' '.join(str(text or '').split())
    if not text:
        return '', float(size), False
    def units(word):
        total = 0.0
        for char in word:
            if unicodedata.combining(char):
                continue
            if unicodedata.east_asian_width(char) in ('W', 'F'):
                total += 1.0
            elif char in 'ilI.,:;!\'`|':
                total += .30
            elif char in 'MW@%&#':
                total += .92
            elif char.isspace():
                total += .32
            elif char.isupper() or char.isdigit():
                total += .65
            else:
                total += .56
        return total
    def wrap(font_size):
        capacity = max(1.0, (width - 20.0) / font_size)
        lines = []
        line = ''
        for word in text.split():
            proposal = (line + ' ' + word).strip()
            if line and units(proposal) > capacity:
                lines.append(line)
                line = ''
            # Very long IDs/URLs must also obey the available width.
            while units(word) > capacity:
                chunk = ''
                while word and units(chunk + word[0]) <= capacity:
                    chunk += word[0]
                    word = word[1:]
                if not chunk:
                    chunk, word = word[:1], word[1:]
                lines.append(chunk)
            line = (line + ' ' + word).strip()
        if line:
            lines.append(line)
        return lines, capacity
    font_size = float(size)
    while True:
        lines, capacity = wrap(font_size)
        max_lines = max(1, int((height - 18.0) / (font_size * 1.22)))
        if len(lines) <= max_lines:
            return '\n'.join(lines), font_size, False
        if font_size <= minimum:
            lines = lines[:max_lines]
            last = lines[-1].rstrip(' .')
            while last and units(last + '\u2026') > capacity:
                last = last[:-1].rstrip()
            lines[-1] = last + '\u2026'
            return '\n'.join(lines), font_size, True
        font_size = max(float(minimum), font_size - .5)

def _gau_exec_fit_boxes(page, width=720):
    """Reserve native text insets and line height without reducing type sizes."""
    requests = page['header'] + [r for m in page['manifests'] for r in m['requests']]
    shapes, fonts, texts, alignment, fixed_fonts = {}, {}, {}, {}, {}
    for request in requests:
        if 'createShape' in request:
            obj = request['createShape']
            shapes[obj['objectId']] = obj['elementProperties']
        if 'updateTextStyle' in request:
            style = request['updateTextStyle']
            if 'fontSize' in style['style']:
                value=style['style']['fontSize']['magnitude']
                if style.get('textRange',{}).get('type')=='ALL':
                    fonts[style['objectId']]=value
                else:
                    fixed_fonts[style['objectId']]=max(value,fixed_fonts.get(style['objectId'],0))
        if 'insertText' in request:
            item = request['insertText']
            texts[item['objectId']] = item['text']
        if 'updateShapeProperties' in request:
            item = request['updateShapeProperties']
            if 'contentAlignment' in item['shapeProperties']:
                alignment[item['objectId']] = item['shapeProperties']['contentAlignment']
    inset = max(7.2, 7.2*width/720)
    for oid, text in texts.items():
        if oid not in fonts or oid not in shapes:
            continue
        props = shapes[oid]
        current = props['size']['height']['magnitude']
        needed = fonts[oid]*1.22*(text.count('\n')+1)+inset
        needed += max(0,fixed_fonts.get(oid,0)-fonts[oid])*1.22
        if needed > current:
            props['size']['height']['magnitude'] = needed
            if alignment.get(oid, 'MIDDLE') == 'MIDDLE':
                props['transform']['translateY'] -= (needed-current)/2
    return page


