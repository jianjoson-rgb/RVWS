def _gau_exec_validate_layout(page, width, height):
    """Validate independent regions and all overview objects before deck creation."""
    geometry=page['layout_geometry'];regions=geometry['regions']
    for i,(name,box) in enumerate(regions):
        x,y,w,h=box
        if min(w,h)<=0 or min(x,y)<-.001 or x+w>width+.001 or y+h>height+.001:
            raise ValueError('Executive region outside the slide: '+name)
        for other,second in regions[i+1:]:
            a,b,c,d=second
            if min(x+w,a+c)-max(x,a)>.01 and min(y+h,b+d)-max(y,b)>.01:
                raise ValueError('Executive regions overlap: '+name+' / '+other)
    for name,box in regions:
        if name.startswith('Narrative ') and not math.isclose(box[3],144.,abs_tol=1e-8):
            raise ValueError('Every narrative panel must be exactly 2 inches high.')
    reqs=page['header']+[r for m in page['manifests'] for r in m['requests']]
    objects={};font_sizes={};texts={};text_boxes=[]
    for r in reqs:
        if 'createShape' in r:
            obj=r['createShape'];ep=obj['elementProperties'];t=ep['transform']
            box=(t['translateX'],t['translateY'],ep['size']['width']['magnitude'],ep['size']['height']['magnitude'])
            objects[obj['objectId']]=box
            if obj.get('shapeType')=='TEXT_BOX':text_boxes.append(obj['objectId'])
            x,y,w,h=box
            if min(w,h)<=0 or min(x,y)<-.001 or x+w>width+.001 or y+h>height+.001:
                raise ValueError('Executive object outside the slide: '+obj['objectId'])
        if 'insertText' in r:
            item=r['insertText'];texts[item['objectId']]=item['text']
        if 'updateTextStyle' in r:
            item=r['updateTextStyle']
            if item.get('textRange',{}).get('type')=='ALL' and 'fontSize' in item['style']:
                font_sizes[item['objectId']]=item['style']['fontSize']['magnitude']
    for i,oid in enumerate(text_boxes):
        x,y,w,h=objects[oid]
        for second in text_boxes[i+1:]:
            a,b,c,d=objects[second]
            if min(x+w,a+c)-max(x,a)>.01 and min(y+h,b+d)-max(y,b)>.01:
                raise ValueError('Executive text boxes overlap: '+oid+' / '+second)
        if oid in texts and oid in font_sizes:
            needed=font_sizes[oid]*1.22*(texts[oid].count('\n')+1)+7.2
            if needed>h+.001:raise ValueError('Executive text is too tall: '+texts[oid])
    for oid in geometry['single_line_ids']:
        text=texts[oid];fs=font_sizes[oid];x,y,w,h=objects[oid]
        for line in text.split('\n'):
            if _gau_exec_text_width(line,fs)>w-9.2+.001:
                raise ValueError('Executive number would wrap: '+line)
        if oid not in geometry['geo_column_ids'] and '\n' in text:
            raise ValueError('Unexpected line break in executive number: '+text)
    geometry['validated']=True
    return page



