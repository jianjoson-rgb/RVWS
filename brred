def _gau_projection_regression_tests(engine):
    import pandas as pd
    from dataclasses import replace
    base=engine.CONFIG
    cutoff=pd.Timestamp('2026-10-17')
    dates=pd.date_range(cutoff-pd.Timedelta(days=153),cutoff)
    # Exact 22 observed weeks; actual Smiley is denominator-weighted and weekday-sensitive.
    daily=pd.DataFrame({'p':[(75+(d.weekday()%4))*1.0 for d in dates],
                        'n':[100.0]*len(dates)},index=dates)
    config=replace(base,projection_history_days=56,smiley_lob='CORE')
    cur=_gau_month_projection(engine,daily,cutoff,pd.Timestamp('2026-10-01'),config,dates)
    nxt=_gau_month_projection(engine,daily,cutoff,pd.Timestamp('2026-11-01'),config,dates)
    assert cur['available'] and nxt['available']
    assert cur['actual_n']==1700. and nxt['actual_n']==0
    assert len(cur['daily_components'])==31 and len(nxt['daily_components'])==30
    assert .70<cur['value']<.82 and .70<nxt['value']<.82
    actual_oct=daily.loc['2026-10-01':'2026-10-17']
    direct=engine.project_remaining_dates(
      pd.DataFrame({'Date':daily.index,'Smiley Numerator':daily['p'].values,'Responses':daily['n'].values}),
      float(actual_oct['p'].sum()),float(actual_oct['n'].sum()),cutoff,pd.Timestamp('2026-10-31'),config)
    assert math.isclose(cur['value'],direct['projected_rate'],abs_tol=1e-12)
    assert _gau_usable_weeks(engine,pd.DataFrame({'Date':dates}),cutoff).__len__()==22
    gaps=dates.delete([1,2,3])
    assert len(_gau_usable_weeks(engine,pd.DataFrame({'Date':gaps}),cutoff))==21
    warned=_gau_month_projection(engine,daily,cutoff,pd.Timestamp('2026-10-01'),config,dates.delete(-10))
    assert warned['available'] and len(warned['validation']['missing_raw_actual_dates'])==1
    assert math.isclose(warned['value'],direct['projected_rate'],abs_tol=1e-12)
    print('PASS: Whitepaper parity, following-month daily projection, 22/21-week use and missing-date flagging.')


