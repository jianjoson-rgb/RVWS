# GAU v1.2.8: executive insight selection uses ONLY validated Whitepaper model
# evidence. The existing three embedded production sources and KPI calculations
# were byte-for-byte unchanged in v1.2.8; v1.2.9 only backports the panels
# engine source-header contract. The following code remains unchanged.
_GAU_RATE_KPIS=frozenset(('Smiley','QA','AFTR'))
_GAU_KPI_LABELS={'Smiley':'Merchant Smiley','QA':'QA','AFTR':'AFTR','AHT':'AHT'}
_GAU_REFLOW_FROM=188.0
_GAU_REFLOW_TO=304.0
_GAU_REFLOW_SCALE=0.86


def _gau_num(value):
    try:
        value=float(value)
        return value if math.isfinite(value) else None
    except (TypeError,ValueError,OverflowError):
        return None


def _gau_severity_bps(adverse_gap):
    """Existing Whitepaper change thresholds, expressed in absolute bp."""
    bp=max(0.0,adverse_gap)*10000.0
    if bp>=200-1e-7:return ('major',4,bp)
    if bp>=100-1e-7:return ('material',3,bp)
    if bp>=50-1e-7:return ('watch',2,bp)
    return ('normal',0,bp)


def _gau_weekly_evidence(section,kpi,direction):
    weekly=sorted((r for r in section.get('history',[]) if r.get('kpi')==kpi),
                  key=lambda r:r['end'] if 'end' in r else r['week'])
    if not weekly:return {'two_week_miss':False,'adverse_wow':False,'wow':None}
    last=weekly[-1]; prior=weekly[-2] if len(weekly)>1 else None
    minimum=getattr(section.get('config'),'minimum_reportable_n',30)
    def usable(row):
        return (row is not None and _gau_num(row.get('value')) is not None
                and (_gau_num(row.get('n')) or 0)>=minimum)
    adjacent=(prior is not None and last['week']-prior['week']==timedelta(days=7))
    def miss(row):
        rate=_gau_num(row.get('value'));target=_gau_num(row.get('target'))
        return (rate is not None and target is not None and
                (target-rate if direction=='higher' else rate-target)>1e-10)
    wow=(float(last['value'])-float(prior['value'])) if adjacent and usable(last) and usable(prior) else None
    adverse_wow=(wow is not None and (wow<0 if direction=='higher' else wow>0))
    return {'two_week_miss':bool(adjacent and usable(last) and usable(prior) and miss(last) and miss(prior)),
            'adverse_wow':adverse_wow,'wow':wow}


def _gau_forecast_evidence(section,kpi,direction,model=None):
    # Select the requested month BEFORE filtering availability. An unavailable
    # current-month forecast must never be replaced by a following-month one.
    months=(model or {}).get('calendar',{}).get('months',[])
    current_month=months[0] if months else None
    available=[f for f in section.get('forecasts',[])
               if f.get('kpi')==kpi and f.get('available') is True
               and current_month is not None and f.get('month')==current_month
               and _gau_num(f.get('value')) is not None
               and _gau_num(f.get('target')) is not None]
    available.sort(key=lambda f:f['month'])
    out=[]
    for fc in available[:1]:
        value=_gau_num(fc['value']);target=_gau_num(fc['target'])
        out.append({'month':fc['month'].strftime('%b'),
                    'value':value,'target':target,
                    'miss':(value<target if direction=='higher' else value>target),
                    'range_valid':bool(fc.get('range_available')),
                    'lower':_gau_num(fc.get('lower')),
                    'upper':_gau_num(fc.get('upper'))})
    return out


def _gau_metric_fragment(kpi,value,target,adverse, direction):
    label=_GAU_KPI_LABELS.get(kpi,kpi)
    if kpi in _GAU_RATE_KPIS:
        diff=value-target
        sign='+' if diff>=0 else '−'
        return f'{label} {value*100:.2f}% vs {target*100:.2f}% target ({sign}{abs(diff)*100:.2f} pp)'
    diff=value-target
    sign='+' if diff>=0 else '−'
    return f'{label} {value:.2f} vs {target:.2f} min target ({sign}{abs(diff):.2f} min)'


def _gau_driver_fragment(data):
    """Never combine overlapping site, tenure and taxonomy contributions."""
    rows=[d for d in data.get('drivers',[]) if d.get('kpi','Smiley')=='Smiley'
          and _gau_num(d.get('impact')) is not None and float(d['impact'])<0]
    if not rows:return ''
    rows.sort(key=lambda d:(float(d['impact']),str(d.get('label',''))))
    driver=rows[0]
    def short(value):
        value=' '.join(str(value).split())
        return value if len(value)<=40 else value[:39].rstrip()+'…'
    label=short(driver.get('label',''))
    if not label:return ''
    details=driver.get('details',{})
    rate=_gau_num(details.get('rate')); baseline=_gau_num(details.get('baseline_rate'))
    if rate is not None and baseline is not None:
        change=(f'fell from {baseline*100:.2f}% to {rate*100:.2f}%' if rate<baseline else
                f'Smiley is {rate*100:.2f}% vs {baseline*100:.2f}% baseline')
        root=f"{label} {change}, contributing −{abs(float(driver['impact']))*100:.2f} pp vs the prior 12-week baseline."
    else:
        root=f"{label} is the largest measured negative contributor (−{abs(float(driver['impact']))*100:.2f} pp vs the prior 12-week baseline)."
    if driver.get('dimension')=='Site':
        detail=data.get('site_details',{}).get(driver['label'])
        if detail and _gau_num(detail.get('impact')) is not None and detail['impact']<0 and detail.get('label'):
            root+=f" Within {label}, {short(detail['label'])} is the largest measured drag."
        else:
            root+=' No validated within-site driver.'
    return root


def _gau_action_narrative(selected,section,data):
    """A recommendation, a quantified callout, and an explicitly scoped outlook.

    No prescribed intervention is presented as an approved action or guaranteed
    remedy. Only a supported Smiley contribution can name a recovery segment.
    """
    def short(value,limit=28):
        text=' '.join(str(value).split())
        return text if len(text)<=limit else text[:limit-1].rstrip()+'…'
    lob=section['lob'];kpi=selected['metric'];label=_GAU_KPI_LABELS[kpi]
    adverse=selected['adverse'];weekly=selected['weekly'];forecast=selected['forecast']
    minimum=getattr(section.get('config'),'minimum_reportable_n',30)
    rows=[d for d in data.get('drivers',[]) if kpi=='Smiley'
          and d.get('kpi','Smiley')=='Smiley'
          and d.get('dimension') in ('Site','Contact taxonomy','Tenure group','Squad')
          and _gau_num(d.get('impact')) is not None and float(d['impact'])<0
          and (_gau_num(d.get('n')) or 0)>=minimum
          and str(d.get('label','')).strip().casefold() not in ('','chat','phones','async')]
    rows.sort(key=lambda d:(float(d['impact']),str(d.get('label',''))))
    driver=rows[0] if rows else None
    evidence='';layer='';movement='';implication=''
    if adverse>0:
        if driver:
            name=short(driver['label'])
            detail=data.get('site_details',{}).get(driver['label']) if driver['dimension']=='Site' else None
            if (detail and _gau_num(detail.get('impact')) is not None and detail['impact']<0
                    and (_gau_num(detail.get('n')) or 0)>=minimum
                    and (_gau_num(detail.get('baseline_n')) or 0)>=minimum and detail.get('label')):
                headline=f"Focus recovery on {short(detail['label'])} in {short(driver['label'],18)}."
            else:
                headline=f"Focus recovery on {name}."
        else:
            headline=f"Prioritize closing the {label} gap."
    elif selected['projected_miss']:
        headline=f"Protect {label} result against month-end risk."
    elif weekly['adverse_wow']:
        headline=f"Stabilize {label} performance to protect goal attainment."
    elif weekly['wow'] is not None and abs(weekly['wow'])>1e-9:
        headline=f"Sustain {label} progress and protect goal attainment."
    else:
        headline=f"Maintain {label} performance at goal."
    if driver:
        evidence=(f"{short(driver['label'])} is the leading measured negative contributor "
                  f"(−{abs(float(driver['impact']))*100:.2f} pp vs the prior 12-week baseline).")
    elif weekly['wow'] is not None and not weekly['adverse_wow'] and abs(weekly['wow'])>1e-9:
        evidence='Week-on-week performance is improving.'
    if driver and driver.get('dimension')=='Site':
        detail=data.get('site_details',{}).get(driver['label'])
        if (detail and _gau_num(detail.get('impact')) is not None and detail['impact']<0
                and (_gau_num(detail.get('n')) or 0)>=minimum
                and (_gau_num(detail.get('baseline_n')) or 0)>=minimum):
            layer=f"Within {short(driver['label'],18)}: {short(detail['label'])} −{abs(detail['impact'])*100:.2f} site pp, not additive."
    if weekly['wow'] is not None:
        delta=weekly['wow']*(100 if kpi in _GAU_RATE_KPIS else 1)
        unit='pp' if kpi in _GAU_RATE_KPIS else 'min'
        movement=f'WoW {delta:+.2f} {unit}.'
    # Do not infer improvement by comparing a weekly result to a monthly forecast.
    if forecast:
        fc=forecast[0]
        value=(f"{fc['value']*100:.2f}%" if kpi in _GAU_RATE_KPIS else f"{fc['value']:.2f} min")
        gap=fc['value']-fc['target'];units='pp' if kpi in _GAU_RATE_KPIS else 'min'
        magnitude=abs(gap)*(100 if kpi in _GAU_RATE_KPIS else 1)
        comparison=(f"{magnitude:.2f} {units} {'below' if gap<0 else 'above'} goal"
                    if abs(gap)>1e-10 else 'at goal')
        outlook=f"{fc['month']} EOM: {value}, {comparison}."
    else:
        outlook='Current-month EOM unavailable.'
    callout=_gau_metric_fragment(kpi,selected['value'],selected['target'],adverse,selected['direction'])+'.'
    narrative=' '.join(x for x in (movement,evidence,layer,implication,outlook) if x)
    brief_driver='';brief_recommendation=headline
    if driver:
        name=short(driver['label'],14)
        brief_driver=f"{name} {float(driver['impact'])*100:+.2f} pp vs baseline."
        brief_recommendation=f'Prioritize the {name} recovery review.'
        if layer:
            underlying=short(detail['label'],16)
            brief_driver+=f" Within site: {underlying} {detail['impact']*100:+.2f} site pp."
            brief_recommendation=f'Prioritize {underlying} in {name}.'
    overview_summary=' '.join(x for x in (callout,movement,brief_driver,implication,brief_recommendation,outlook) if x)
    delta=selected['value']-selected['target']
    brief_result=(f"{label} {selected['value']*100:.2f}% ({delta*100:+.2f} pp vs goal)."
        if kpi in _GAU_RATE_KPIS else f"{label} {selected['value']:.2f} ({delta:+.2f} min vs goal).")
    overview_performance=' '.join(x for x in (brief_result,brief_driver,outlook) if x)
    return {'headline':headline,'support':callout+' '+narrative,
            'overview_summary':overview_summary,'overview_performance':overview_performance,'recommendation':headline,'callout':callout,'executive_narrative':narrative,
            'driver':evidence or None,'movement':movement,'site_layer':layer,'implication':implication,'outlook':outlook,'narrative_style':'recommendation + callout + executive narrative'}


def _gau_select_executive_insight(section,model,data=None):
    """Rank supported KPI risk deterministically; no external narrative or AI calls.

    Priorities: target miss severity > confirmed persistence > forecasted miss >
    weekly adverse movement. Percentage variance bands are never applied to AHT.
    Projections are point forecasts, not likelihood statements.
    """
    if data is None:data=_gau_panel_data(section,model)
    candidates=[]
    minimum=getattr(section.get('config'),'minimum_reportable_n',30)
    for metric in section.get('kpis',[]):
        kpi=metric.get('kpi'); direction=metric.get('direction')
        value=_gau_num(metric.get('value'));target=_gau_num(metric.get('target'))
        if kpi not in ('Smiley','QA','AFTR','AHT') or direction not in ('higher','lower'):
            continue
        if value is None or target is None or (_gau_num(metric.get('n')) or 0)<minimum:continue
        adverse=(target-value if direction=='higher' else value-target)
        category,tier,bps=(_gau_severity_bps(adverse) if kpi in _GAU_RATE_KPIS
                           else ('unit-based target breach',2 if adverse>0 else 0,None))
        weekly=_gau_weekly_evidence(section,kpi,direction)
        fc=_gau_forecast_evidence(section,kpi,direction,model)
        projected_miss=any(x['miss'] for x in fc)
        # A forecast that is unavailable does not count as recovery or risk.
        adverse_wow=weekly['adverse_wow']
        improving_wow=(weekly['wow'] is not None and not adverse_wow and abs(weekly['wow'])>1e-9)
        if adverse>0:
            priority=(tier+2, int(weekly['two_week_miss']), int(projected_miss),
                      int(adverse_wow), min(1.,max(0.,adverse)),kpi=='Smiley')
        elif projected_miss:
            priority=(2,int(adverse_wow),1,0,0,kpi=='Smiley')
        elif adverse_wow and kpi in _GAU_RATE_KPIS and abs(weekly['wow'])>=.01:
            priority=(1,0,0,1,abs(weekly['wow']),kpi=='Smiley')
        else:
            priority=(0,int(improving_wow),0,0,0,kpi=='Smiley')
        candidates.append({'metric':kpi,'direction':direction,'value':value,'target':target,
                           'adverse':adverse,'category':category,'tier':tier,
                           'bps':bps,'weekly':weekly,'forecast':fc,
                           'projected_miss':projected_miss,'priority':priority})
    if not candidates:
        return {'lob':section['lob'],'metric':None,'severity':'unverified',
                'headline':f"Validate {section['lob']}’s source coverage before setting a recovery priority.",
                'support':f'A validated target and at least {minimum} measured observations are required. Review source coverage.',
                'reason':'missing Whitepaper target or insufficient measured observations',
                'driver':None,'forecast_available':False}
    selected=max(candidates,key=lambda c:c['priority'])
    kpi=selected['metric']; label=_GAU_KPI_LABELS[kpi]
    adverse=selected['adverse']; forecast=selected['forecast']
    projected_miss=selected['projected_miss']
    persistence=selected['weekly']['two_week_miss']
    narrative=_gau_action_narrative(selected,section,data)
    return dict(narrative,**{'lob':section['lob'],'metric':kpi,'severity':selected['category'],
            'forecast_available':bool(forecast),'persistent_miss':persistence,
            'target_gap':selected['value']-selected['target'],
            'priority':list(selected['priority']),'source':'Whitepaper validated KPI + panels',
            'ranked_metrics':[c['metric'] for c in candidates],
            'projection_scope':'current-month EOM only'})


def _gau_reflow_for_banner(manifests,height):
    """Reserve new banner space without cropping the existing native panels.

    All groups preserve their internal object ID, order, content and x-geometry.
    Coordinates in the original 1600x900 design are reflowed uniformly to
    leave 146–288 for the banner, 304–457 for cards and ~478–848 for panels.
    """
    scale=height/900.0
    for man in manifests:
        for request in man.get('requests',[]):
            shape=request.get('createShape')
            line=request.get('createLine')
            creation=shape or line
            if creation is not None:
                ep=creation['elementProperties']; t=ep.get('transform',{})
                if 'translateY' in t:
                    orig=t['translateY']/scale
                    t['translateY']=(_GAU_REFLOW_TO+(orig-_GAU_REFLOW_FROM)*_GAU_REFLOW_SCALE)*scale
                if shape is not None:
                    if 'height' in ep.get('size',{}):
                        ep['size']['height']['magnitude']*=_GAU_REFLOW_SCALE
                elif line is not None and 'scaleY' in t:
                    t['scaleY']*=_GAU_REFLOW_SCALE
            textstyle=request.get('updateTextStyle')
            if textstyle and 'fontSize' in textstyle.get('style',{}):
                textstyle['style']['fontSize']['magnitude']*=0.93
    return manifests


