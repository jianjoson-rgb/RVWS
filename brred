        def execute(self, **kwargs): return copy.deepcopy(self.result)
    class Sheets:
        def __init__(self):
            self.calls = []
            self.weekly = [['Week Start Date','Name','Name','KPI Goal','KPI Score']]
            for week_index in range(12):
                day = date(2026,7,26) + timedelta(weeks=week_index)
                for lob_index,lob in enumerate(STANDARD_LOBS):
                    for metric_index,metric in enumerate(kpi.METRICS):
                        goal = goals[lob_index][metric_index]
                        score = weekly[lob_index][metric_index] - (11-week_index) * (.01 if metric.key=='aht' else .0001)
                        self.weekly.append([day.isoformat(),lob.title(),metric.aliases[0],goal,score])
            self.monthly = [['Converted Month','Month','Name','Name','Compare_Goal_','Score']]
            for month in (date(2026,9,1),date(2026,10,1)):
                for lob_index,lob in enumerate(STANDARD_LOBS):
                    for metric_index,metric in enumerate(kpi.METRICS):
                        self.monthly.append([month.isoformat(),month.strftime('%b-%Y'),lob.title(),
                            metric.aliases[0],goals[lob_index][metric_index],monthly[lob_index][metric_index]])
            self.financial = [['Revenue & GM Forecast per GEO as of 10/13/2026'],
                ['SITE','HC','GPR','Revenue','Revenue\nAttainment','SM%','GM%','PL','UL','Attrition','HOURS\nDELIVERY']]
            self.financial.extend(copy.deepcopy(financial))
        def spreadsheets(self): return self
        def values(self): return self
        def get(self, **kwargs):
            self.calls.append(('get',kwargs))
            if 'range' in kwargs:
                assert kwargs['valueRenderOption']=='UNFORMATTED_VALUE'
                if kwargs['range']=="'OPRRaw'!C1:G": return Request({'values':self.weekly})
                if kwargs['range']=="'OPRRaw'!K1:P": return Request({'values':self.monthly})
                raise AssertionError('Unexpected/legacy source range: '+kwargs['range'])
            return Request({'properties':{'title':'Offline source fixture','locale':'en_US'},
                'sheets':[{'properties':{'sheetId':CONFIG['oprraw_source_gid'],'title':'OPRRaw'}},
                          {'properties':{'sheetId':_GAU_EXEC_GID,'title':'EXECVIEW'}}]})
        def batchGet(self, **kwargs):
            self.calls.append(('batchGet',kwargs))
            assert kwargs['ranges']==["'EXECVIEW'!F5:P11"],kwargs['ranges']
            assert kwargs['valueRenderOption']=='UNFORMATTED_VALUE'
            return Request({'valueRanges':[{'values':self.financial}]})
    return Sheets()


