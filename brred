            observation=f'{label} is projected to miss the month-end target.'
        else:
            observation='No validated priority identified.'
        driver=insight.get('driver_evidence') if metric=='Smiley' else None
        driver_label='';nested_label='';nested_valid=False
        if (isinstance(driver,dict) and _gau_num(driver.get('impact')) is not None
                and float(driver['impact'])<0 and (adverse or worsening)):
            candidate=' '.join(str(driver.get('label') or '').split())
            if candidate and len(candidate)<=38:
                driver_label=candidate
                nested=insight.get('site_evidence') if driver.get('dimension')=='Site' else None
                nested_label=' '.join(str(nested.get('label') or '').split()) if isinstance(nested,dict) else ''
                minimum=data.get('minimum_reportable_n',0)
                nested_valid=(nested_label and len(nested_label)<=32 and _gau_num(nested.get('impact')) is not None
                              and float(nested['impact'])<0 and (_gau_num(nested.get('n')) or 0)>=minimum
                              and (_gau_num(nested.get('baseline_n')) or 0)>=minimum)
                if nested_valid:
                    observation=observation.rstrip('.')+f'; {nested_label} in {driver_label} is a leading measured drag.'
                else:
                    observation=observation.rstrip('.')+f'; {driver_label} is a leading measured drag.'
        is_priority=adverse or worsening or projected_miss
        if is_priority:
            # Rule-based next steps use only the selected Whitepaper signal;
            # they are review proposals, not approved or proven interventions.
            if driver_label and nested_valid:
                recommendation=f'Review {nested_label} in {driver_label}.'
            elif driver_label:
                recommendation=f'Review the {driver_label} performance drivers.'
            elif adverse or worsening:
                recommendation={'AHT':'Review AHT drivers and workflow friction.',
                    'QA':'Review quality gaps and coaching needs.',
                    'AFTR':'Review barriers to first-touch resolution.',
                    'Smiley':'Review non-smiley themes and response quality.'}.get(metric,f'Review the {label} performance gap.')
            else:
                recommendation=f'Review the projected {label} month-end risk.'
            compact_action=f'Review {label}.'
            compact_challenge=f'{label} '+(('below' if direction=='higher' else 'above')+' target.' if adverse else ('worsened.' if worsening else 'has closing risk.'))
        else:
            recommendation='No validated immediate pivot identified.'
            compact_action='No pivot identified.'
            compact_challenge='No priority identified.'
        challenges.append(entry(lob,observation,compact_challenge))
        actions.append(entry(lob,recommendation,compact_action))
        audit.append({'lob':lob,'status':'priority' if is_priority else 'no validated priority',
            'metric':metric,'direction':direction,'driver':driver_label or None,
            'source':'Whitepaper matched monthly periods','projection_used':bool(projected_miss and not adverse and not worsening)})
    return {'Challenges & Escalations':challenges,'Immediate Tactical Pivots':actions},audit

def _gau_exec_fit_fixed_paragraphs(full, compact, width, height, panel):
    """Fit complete LOB paragraphs at a fixed physical font size; never drop one."""
    size=5.5
    max_lines=max(1,int((height-18.)/(size*1.22)))
    for candidate in (full,compact):
        if candidate is None:continue
        lines=[];failed=False
        for paragraph in str(candidate).splitlines():
            if not paragraph.strip():continue
            wrapped,_,truncated=_gau_exec_fit_text(paragraph,width,height,size,size)
            if truncated:failed=True;break
            lines.extend(wrapped.splitlines())
        if not failed and len(lines)<=max_lines:
            return '\n'.join(lines),candidate!=full
    raise ValueError(panel+' content cannot fit in the fixed text box at 5.5 pt; shorten the approved note or source labels.')

def _gau_exec_resolve_panels(source, model, config):
    """Generate two Whitepaper panels; retain approved POC handling elsewhere."""
    limit = int(config.get('executive_panel_char_limit', 195))
    if limit < 40:
        raise ValueError('executive_panel_char_limit must be at least 40.')
    resolved, audit = {}, {}
    generated,evidence=_gau_exec_whitepaper_narratives(model)
    for panel in _GAU_EXEC_PANEL_NAMES:
        manual_items=source.get('manual', {})
        item = manual_items.get(panel, manual_items.get('Help Needed') if panel=='Immediate Tactical Pivots' else None) or {'mode':'AUTO', 'text':'', 'row':None}
        mode = item['mode']
        manual = (' '.join(str(item.get('text') or '').split())
                  if mode in ('APPEND', 'OVERRIDE') else '')
        automatic='\n'.join(e['full'] for e in generated.get(panel,[]))
        compact='\n'.join(e['compact'] for e in generated.get(panel,[]))
        if panel in generated:
            content=manual if mode=='OVERRIDE' and manual else automatic
            compact_content=manual if mode=='OVERRIDE' and manual else compact
            if mode=='APPEND' and manual:
                content=automatic+'\n'+manual;compact_content=compact+'\n'+manual
        else:
            content=_gau_exec_short(manual, limit);compact_content=content
        resolved[panel] = content
        audit[panel] = {
            'mode':mode, 'approved_manual':bool(manual), 'source_row':item.get('row'),
            'truncated':panel not in generated and content != manual, 'full_approved_text':manual,
            'full_generated_text':automatic if panel in generated else '',
            'compact_text':compact_content,
            'automatic_source':'Whitepaper matched monthly periods' if panel in generated and mode!='OVERRIDE' else None,
            'evidence':evidence if panel in generated else [],
            'recommendation_basis':'Rule-based review proposals from Whitepaper evidence; not approved actions' if panel=='Immediate Tactical Pivots' else None,
            'manual_source':'Approved POC input' if manual else None,
            'content_policy':'Whitepaper automatic; approved POC override or append supported' if panel in generated else 'POC only; empty editable body without approved input',
        }
    return resolved, audit

def _gau_exec_select_banner(model):
    entries=[_gau_monthly_banner_insight(s,model)
             for s in model['sections']]
    eligible=[i for i in entries if i.get('metric')]
    if not eligible:return entries[0]['support'] if entries else 'Monthly source observations are unavailable.'
    selected=max(eligible,key=lambda i:tuple(i.get('priority') or [0]))
    if selected.get('overview_summary'):
        return selected['lob']+': '+selected['overview_summary']
    # The existing selector restricts forecast evidence to the CURRENT month.
    parts=[selected.get('callout',selected['headline']),selected.get('executive_narrative',''),
           selected.get('recommendation','')]
    return _gau_exec_short(selected['lob']+': '+' '.join(x for x in parts if x),330)

def _gau_exec_kpi_status(metric):
    actual, goal = metric.get('actual'), metric.get('goal')
    if actual is None or goal is None:
        return 'unavailable'
    if not all(math.isfinite(float(v)) for v in (actual, goal)):
        return 'unavailable'
    good = actual >= goal if metric['higher_better'] else actual <= goal
    return 'met' if good else 'miss'

