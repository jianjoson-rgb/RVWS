def _gau_month_projection(engine, daily, cutoff, month, settings, observed_days=None):
    """Whitepaper's 56-day same-weekday / seven-day fallback projection, by month.

    Current month = actual numerator/denominator + Whitepaper future-day estimates.
    Following month = fresh future-day estimates anchored to LAST observed cutoff.
    Never forecasts from synthetic forecast data or averages weekly percentages.
    """
    import pandas as pd
    month=pd.Timestamp(month).normalize();cutoff=pd.Timestamp(cutoff).normalize()
    end=month+pd.offsets.MonthEnd(0)
    no={'available':False,'month':month,'reason':'','method':'Whitepaper 56-day same-weekday, seven-day fallback'}
    if daily.empty or daily['n'].sum()<settings.minimum_reportable_n:
        return dict(no,reason='Insufficient valid Whitepaper Smiley numerator/denominator history.')
    known=daily.loc[daily.index<=cutoff]
    last56=known.loc[known.index>cutoff-pd.Timedelta(days=56)]
    if len(last56)<14 or last56['n'].sum()<settings.minimum_reportable_n:
        return dict(no,reason='Whitepaper 56-day reference has fewer than 14 rated source dates or insufficient responses.')
    scope=pd.DataFrame({'Date':known.index,'Smiley Numerator':known['p'].values,'Responses':known['n'].values})
    actual_days=pd.date_range(month,min(cutoff,end)) if month<=cutoff else pd.DatetimeIndex([])
    missing=actual_days.difference(pd.DatetimeIndex(observed_days)) if observed_days is not None else pd.DatetimeIndex([])
    # Match the existing Whitepaper's operational projection: use known actual
    # numerator/denominator only. Missing dates never become rows of zero volume.
    actual=known.loc[known.index.intersection(actual_days)] if len(actual_days) else known.iloc[0:0]
    numerator=float(actual['p'].sum());denominator=float(actual['n'].sum())
    predicted=[]
    first=max(month,cutoff+pd.Timedelta(days=1))
    for day in pd.date_range(first,end):
        volume,rate,basis=engine._weekday_projection_reference(scope,pd.Timestamp(day),cutoff,settings)
        if not (math.isfinite(float(volume)) and math.isfinite(float(rate))) or volume<=0 or not 0<=rate<=1:
            return dict(no,reason='No usable historical daily volume/rate for the Whitepaper projection.')
        numerator+=volume*rate;denominator+=volume
        predicted.append({'Date':day,'p':float(volume*rate),'n':float(volume),'projected':True,'basis':basis})
    if denominator<=0:
        return dict(no,reason='No rated responses to support the monthly projection.')
    components=[{'Date':day,'p':float(row['p']),'n':float(row['n']),'projected':False,'basis':'Actual'} for day,row in actual.iterrows()]
    components.extend(predicted)
    return {'available':True,'month':month,'reason':'','value':numerator/denominator,
            'numerator':numerator,'denominator':denominator,'actual_n':float(actual['n'].sum()),
            'projected_n':sum(row['n'] for row in predicted),
            'daily_components':pd.DataFrame(components,columns=['Date','p','n','projected','basis']),
            'method':no['method'],'validation':{'type':'Whitepaper operational projection','history_days':56,
            'observed_reference_days':int(len(last56)),'history_source':'same Whitepaper snapshot and LOB population',
            'future_days':len(predicted),'forecast_on_forecast':False,
            'missing_raw_actual_dates':[str(d.date()) for d in missing]}}


def _gau_backtest_range(engine,daily,cutoff,month,settings, min_origins=6):
    """Indicative error dispersion from past SAME-HORIZON weekly origins.
    Origins may share an outcome month: not an independent calibrated 80% interval.
    Suppress the bar instead of inventing a confidence range when too few trials.
    """
    import pandas as pd
    month=pd.Timestamp(month).normalize();cutoff=pd.Timestamp(cutoff).normalize()
    end=month+pd.offsets.MonthEnd(0)
    horizon=(month.to_period('M')-cutoff.to_period('M')).n
    target_lead=(end-cutoff).days
    errors=[]; records=[]
    if daily.empty:return None,{'backtest_origins':0,'range_status':'Unavailable: no history'}
    earliest=daily.index.min()+pd.Timedelta(days=56)
    for origin in pd.date_range(earliest,cutoff,freq='W-SAT'):
        outcome_month=(origin.to_period('M')+horizon).start_time
        outcome_end=outcome_month+pd.offsets.MonthEnd(0)
        if outcome_end>cutoff or abs((outcome_end-origin).days-target_lead)>7:
            continue
        complete_days=pd.date_range(outcome_month,outcome_end)
        if not complete_days.isin(daily.index).all():
            continue
        train=daily.loc[daily.index<=origin]
        prediction=_gau_month_projection(engine,train,origin,outcome_month,settings)
        if not prediction['available']:continue
        actual=daily.reindex(complete_days)
        if actual['n'].sum()<settings.minimum_reportable_n:continue
        realized=float(actual['p'].sum()/actual['n'].sum())
        err=abs(prediction['value']-realized)
        errors.append(err)
        records.append({'origin':str(origin.date()),'month':str(outcome_month.date()),'error_pp':round(err*100,3)})
    info={'backtest_origins':len(errors),'range_status':'Insufficient historical matched weekly origins',
          'overlapping_outcomes':True,'minimum_origins':min_origins}
    if len(errors)<min_origins:return None,info
    # Empirical upper rank; conservative compared with linear interpolation.
    rank=min(len(errors),math.ceil((len(errors)+1)*.8))
    radius=sorted(errors)[rank-1]
    info.update({'range_status':'Indicative 80th-percentile historical absolute error; not calibrated coverage',
                 'error_radius_pp':round(radius*100,3),'origins':records})
    return float(radius),info


def _gau_bootstrap_range(daily,cutoff,month,forecast,*,samples=400):
    """Deterministic 10–90% *scenario* band via 56-day weekly block resampling.

    Preserves the Whitepaper point estimate untouched. This quantifies recent
    empirical week-to-week mix/response variability; NOT an 80% coverage claim.
    """
    import pandas as pd
    import numpy as np
    from hashlib import sha256
    if not forecast.get('available'):
        return None,{'range_status':'Point projection unavailable'}
    cutoff=pd.Timestamp(cutoff).normalize();month=pd.Timestamp(month).normalize()
    hist=daily.loc[(daily.index>cutoff-pd.Timedelta(days=56))&(daily.index<=cutoff)]
    # Entire historical Sunday-Saturday weeks are preferred to individual-day resampling.
    blocks={}
    for day,row in hist.iterrows():
        sunday=day-pd.Timedelta(days=(day.weekday()+1)%7)
        blocks.setdefault(sunday,{})[day.weekday()]=(float(row['p']),float(row['n']))
    complete=[block for block in blocks.values() if len(block)>=5 and sum(n for _,n in block.values())>0]
    if len(complete)<4:
        return None,{'range_status':'Fewer than four usable Whitepaper reference weeks for scenario range',
                     'reference_weeks':len(complete)}
    fallback={wd:[(float(row['p']),float(row['n'])) for day,row in hist.iterrows() if day.weekday()==wd]
              for wd in range(7)}
    predicted=forecast['daily_components']
    future=predicted.loc[predicted['projected']].sort_values('Date')
    if future.empty:
        return None,{'range_status':'No projected future dates'}
    actual=predicted.loc[~predicted['projected']]
    actual_p=float(actual['p'].sum());actual_n=float(actual['n'].sum())
    seed=int.from_bytes(sha256(f"GAU-Whitepaper:{cutoff.date()}:{month.date()}:{hist['p'].sum():.5f}:{hist['n'].sum():.5f}".encode()).digest()[:8], 'big')
    rng=np.random.default_rng(seed)
    bands=[]
    for _ in range(samples):
        p,n=actual_p,actual_n
        chosen={}
        for dt in future['Date']:
            day=pd.Timestamp(dt)
            week=day-pd.Timedelta(days=(day.weekday()+1)%7)
            if week not in chosen:
                chosen[week]=complete[int(rng.integers(len(complete)))]
            pair=chosen[week].get(day.weekday())
            if pair is None:
                pool=fallback[day.weekday()]
                if not pool:
                    pool=[r for block in complete for r in block.values()]
                pair=pool[int(rng.integers(len(pool)))]
            p+=pair[0];n+=pair[1]
        if n>0:bands.append(p/n)
    if len(bands)<100:
        return None,{'range_status':'Insufficient valid block-bootstrap draws'}
    lower=float(np.quantile(bands,.10));upper=float(np.quantile(bands,.90))
    return (max(0.,min(lower,forecast['value'])),min(1.,max(upper,forecast['value']))), {
        'range_status':'Indicative 10th–90th percentile weekly-block bootstrap scenario band; not calibrated coverage',
        'range_method':'56-day observed-week block resampling, actual MTD held fixed',
        'reference_weeks':len(complete),'scenario_draws':len(bands),'forecast_on_forecast':False}


def _gau_usable_weeks(engine,raw,cutoff):
    """Count usable observed source weeks from last 22, allowing weekday-only operations."""
    import pandas as pd
    days=pd.DatetimeIndex(raw['Date'].dropna().unique()).normalize()
    result=[]
    for i in range(22):
        last=cutoff-pd.Timedelta(weeks=i)
        week=pd.date_range(last-pd.Timedelta(days=6),last)
        if week.isin(days).sum()>=5:result.append(week[0])
    return result


def _gau_apply_projections(engine,normalized,ec,model,*,minimum_weeks=20):
    """Mutate ONLY this GAU in-memory model; original Whitepaper logic unchanged."""
    import pandas as pd
    cal=model['calendar'];cutoff=cal['cutoff']
    raw,rated,assessment,_,_=engine._ga585_snapshot(normalized,cutoff,ec)
    notes=[]
    for section in model['sections']:
        lob=section['lob'];settings=section['config']
        mask=engine._ga585_business(assessment,lob,ec)
        assessment_lob=assessment.loc[mask].copy()
        raw_lob=raw.loc[engine._ga585_business(raw,lob,ec)].copy()
        daily=engine._ga585_daily(assessment_lob,'Smiley',settings,cutoff)
        usable=_gau_usable_weeks(engine,raw_lob,cutoff)
        actual_days=pd.DatetimeIndex(raw_lob['Date'].dropna().unique())
        updated=[]
        for month in cal['months'][:2]:
            projection=(_gau_month_projection(engine,daily,cutoff,month,settings,actual_days)
                        if len(usable)>=minimum_weeks else
                        {'available':False,'month':month,'reason':f'Only {len(usable)} usable source weeks within latest 22; minimum {minimum_weeks} required.'})
            projection['usable_weeks']=len(usable)
            if projection['available']:
                radius,evidence=_gau_backtest_range(engine,daily,cutoff,month,settings)
                if radius is not None:
                    boundaries=(max(0.,projection['value']-radius),min(1.,projection['value']+radius))
                else:
                    boundaries,scenario_evidence=_gau_bootstrap_range(daily,cutoff,month,projection)
                    evidence.update(scenario_evidence)
                projection['range_available']=boundaries is not None
                projection['lower']=boundaries[0] if boundaries is not None else None
                projection['upper']=boundaries[1] if boundaries is not None else None
                projection['validation'].update(evidence)
                comp=projection['daily_components']
                t,d,tb=engine._ga585_target(lob,'Smiley',month,month+pd.offsets.MonthEnd(0),comp,ec)
                projection.update(target=t,direction=d,target_basis=tb,
                                  gap=projection['value']-t if math.isfinite(float(t)) else None)
            else:
                projection.update(range_available=False,lower=None,upper=None,
                                  validation={'type':'Whitepaper operational projection','usable_weeks':len(usable)})
            updated.append(projection)
        section['forecasts']=[f for f in section['forecasts'] if f['kpi']!='Smiley']
        section['forecasts'].extend([dict(fc,kpi='Smiley') for fc in updated])
        section['gau_projection_audit']=[{k:v for k,v in fc.items() if k not in ('daily_components','validation')}
                                       for fc in updated]
        section['gau_site_details']=_gau_site_details(engine,section,settings)
        notes.append((lob,updated))
    model['gau_projection_method']='Whitepaper 56-day same-weekday pattern with 7-day fallback'
    model['gau_minimum_usable_weeks']=minimum_weeks
    return notes


def _gau_site_details(engine,section,settings):
    """One supported within-site adverse driver (site-relative pp; never additive to LOB bars)."""
    current=section['current'];baseline=section['baseline']
    out={}
    if current.empty or baseline.empty or 'Site' not in current or 'Site' not in baseline:return out
    for d in section['drivers']:
        if d['dimension']!='Site' or d.get('impact') is None or d['impact']>=0:continue
        site=d['label']
        a=current.loc[current['Site'].astype(str).str.strip().eq(site)]
        b=baseline.loc[baseline['Site'].astype(str).str.strip().eq(site)]
        if a.empty or b.empty:continue
        candidates=[]
        for dimension,col in (('Contact taxonomy','Level One'),('Tenure group','Tenure Group'),('Squad','Squad Code')):
            if col not in a or col not in b:continue
            table=engine._v574_group_table(a,b,[col])
            if len(table)<2:continue
            for row in table.to_dict('records'):
                name=str(row[col]).strip()
                if (not name or name=='Unclassified' or engine._GA584_EXCLUDED.search(name)
                    or name.casefold() in ('chat','phones','async')):continue
                if min(row['n'],row['nb'])<settings.minimum_reportable_n:continue
                if not (math.isfinite(float(row['contribution'])) and row['contribution']<0):continue
                if not (row['contribution']<-settings.banner_material_delta or
                        math.isfinite(float(row['delta'])) and row['delta']<-settings.banner_material_delta):continue
                candidates.append({'site':site,'dimension':dimension,'label':name,
                                   'impact':float(row['contribution']), 'rate':float(row['rate']),
                                   'baseline_rate':float(row['baseline_rate']),
                                   'n':float(row['n']),'baseline_n':float(row['nb']),
'basis':'Within-site Smiley movement versus prior 12-week baseline; not additive to LOB bars'})
        if candidates:
            candidates.sort(key=lambda r:(r['impact'],-min(r['n'],r['baseline_n']),r['label']))
            out[site]=candidates[0]
    return out


