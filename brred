def align_sources(standard_lobs,live_lob,model):
    if tuple(lob['lob'].strip().upper() for lob in standard_lobs)!=STANDARD_LOBS:
        raise ValueError('Expected CORE, PLUS, RETAIL, PREMIUM in order; no standard LOB may be omitted.')
    if live_lob['lob'].replace(' ','').upper()!='LIVEASSIST' or len(live_lob['cards'])!=8:
        raise ValueError('Expected LIVEASSIST with all eight KPI cards.')
    week=model['period_start'].date()
    if any(lob['week']!=week for lob in standard_lobs):
        raise ValueError(f"The four standard LOB KPI weeks must match Whitepaper WB {week}. "
                         "Update missing backend weeks, or use the same as_of_date/reporting cutoff. No deck created.")
    warnings=[]
    if live_lob['week']!=week:
        warnings.append(f"LIVEASSIST latest available WB {live_lob['week']} differs from the other LOBs' WB {week}; its slide is explicitly dated.")
    # Distinct sources may differ; expose discrepancies instead of rewriting results.
    for lob,section in zip(standard_lobs,model['sections']):
        card=next(c for c in lob['cards'] if c['metric'].key=='smiley')
        raw=next(k['value'] for k in section['kpis'] if k['kpi']=='Smiley')
        if card['actual'] is not None:
            try:
                if math.isfinite(float(raw)) and abs(float(card['actual'])-float(raw))>.00005:
                    warnings.append(f"{lob['lob']}: Backend Smiley {float(card['actual'])*100:.2f}% and Whitepaper Smiley {float(raw)*100:.2f}% differ. Cards retain Backend; panels retain Whitepaper. Review source scope before presenting.")
            except (ValueError,TypeError):pass
    return warnings


