def _gau_constructive_outlook_regression_tests(engine,model,standard,live_lob):
    """Production-code regression: two independent horizons and constructive text."""
    import copy
    import unittest
    import pandas as pd
    from dataclasses import replace
    root_model=model
    cal=model['calendar'];current=cal['months'][0];following=cal['months'][1]
    template=copy.deepcopy(model['sections'][0])
    for metric in template['kpis']:
        if metric['kpi']=='Smiley':metric.update(value=.7431,target=.8,n=100.,direction='higher')
        else:metric['target']=None
    template['forecasts']=[{'kpi':'Smiley','month':current,'available':True,'value':.7487,'target':.8,'range_available':False},
                           {'kpi':'Smiley','month':following,'available':True,'value':.76,'target':.8,'range_available':False}]
    template['history']=[{'kpi':'Smiley','week':cal['start']-pd.Timedelta(weeks=i),
                         'value':value,'target':.8,'n':100.} for i,value in ((1,.754),(0,.7431))]
    evidence={'drivers':[{'kpi':'Smiley','dimension':'Site','label':'PHX','impact':-.0082,'n':100.}],
              'site_details':{'PHX':{'label':'Shopify Payments','impact':-.0075,'n':100.,'baseline_n':100.}}}
    empty={'drivers':[],'site_details':{}}
    def insight(section=None,data=None):
        return _gau_select_executive_insight(section or template,root_model,evidence if data is None else data)
    def forecast_frame(weeks=22,drop=None):
        dates=pd.date_range(cal['cutoff']-pd.Timedelta(days=weeks*7-1),cal['cutoff'])
        if drop is not None:dates=dates[dates!=drop]
        rows=[]
        for lob in STANDARD_LOBS:
            for dt in dates:
                rows.append({'Date':dt,'Ticket ID':f'{lob}-{dt:%Y%m%d}','Company':engine.CONFIG.required_company,
                    'Team Code':sorted(engine.PREMIUM_INCLUDED_TEAM_CODES)[0] if lob=='PREMIUM' else 'General Test Team',
                    'Level Of Detail Value':{'CORE':'Core','PREMIUM':'Core','PLUS':'Plus','RETAIL':'Retail'}[lob],
                    'Ticket Channel':'Chat','Responses':100.,'Smiley Numerator':75.+dt.weekday()%4})
        return pd.DataFrame(rows)
    def projection_model():
        return {'calendar':copy.deepcopy(cal),'sections':[{'lob':lob,'config':replace(engine.CONFIG,smiley_lob=lob),
                'forecasts':[],'drivers':[],'current':pd.DataFrame(),'baseline':pd.DataFrame()}
                for lob in STANDARD_LOBS]}
    class Tests(unittest.TestCase):
        @classmethod
        def setUpClass(cls):
            cls.raw=forecast_frame();cls.proj=projection_model()
            _gau_apply_projections(engine,cls.raw,engine.CONFIG,cls.proj)
        def test_two_horizons_each_standard_lob(self):
            for section in self.proj['sections']:
                self.assertEqual([fc['month'] for fc in section['forecasts']],[current,following])
                self.assertTrue(all(fc['available'] for fc in section['forecasts']))
        def test_next_month_has_no_actual_or_forecast_training(self):
            for section in self.proj['sections']:
                cur,nxt=section['forecasts'];self.assertGreater(cur['actual_n'],0);self.assertEqual(nxt['actual_n'],0)
                self.assertTrue(nxt['daily_components']['projected'].all())
                self.assertEqual(len(nxt['daily_components']),following.days_in_month)
                self.assertFalse(nxt['validation']['forecast_on_forecast'])
        def test_next_month_matches_direct_observed_history_projection(self):
            for section in self.proj['sections']:
                raw=self.raw.loc[engine._ga585_business(self.raw,section['lob'],engine.CONFIG)]
                daily=engine._ga585_daily(raw,'Smiley',section['config'],cal['cutoff'])
                direct=_gau_month_projection(engine,daily,cal['cutoff'],following,section['config'],pd.DatetimeIndex(raw.Date.unique()))
                self.assertEqual(direct['value'],section['forecasts'][1]['value'])
        def test_each_month_has_its_own_range_evidence(self):
            for section in self.proj['sections']:
                for fc in section['forecasts']:
                    self.assertTrue(fc['range_available']);self.assertLessEqual(fc['lower'],fc['value']);self.assertGreaterEqual(fc['upper'],fc['value'])
        def test_22_21_20_weeks_allowed_19_withheld_for_both_months(self):
            for weeks in (21,20,19):
                m=projection_model();_gau_apply_projections(engine,forecast_frame(weeks),engine.CONFIG,m)
                for s in m['sections']:
                    for fc in s['forecasts']:
                        self.assertEqual(fc['usable_weeks'],weeks);self.assertEqual(fc['available'],weeks>=20)
        def test_missing_date_is_not_zero_filled(self):
            missing=current+pd.Timedelta(days=4);raw=forecast_frame(drop=missing)
            daily=engine._ga585_daily(raw,'Smiley',engine.CONFIG,cal['cutoff']);self.assertNotIn(missing,daily.index)
        def test_recommendation_callout_narrative(self):
            out=insight();self.assertIn('Shopify Payments in PHX',out['recommendation']);self.assertIn('74.31%',out['callout']);self.assertIn('80.00%',out['callout'])
            self.assertIn('−0.82 pp',out['executive_narrative']);self.assertIn('74.87%',out['executive_narrative']);self.assertIn('5.13 pp below goal',out['executive_narrative'])
        def test_banner_never_uses_next_month(self):
            out=insight();self.assertNotIn(following.strftime('%b'),out['headline']+' '+out['support']);self.assertEqual(out['projection_scope'],'current-month EOM only')
        def test_unavailable_current_not_replaced_by_next(self):
            s=copy.deepcopy(template);s['forecasts'][0]['available']=False
            out=insight(s);self.assertFalse(out['forecast_available']);self.assertIn('EOM unavailable',out['support'])
        def test_no_weekly_monthly_false_improvement(self):
            out=insight();self.assertNotIn('improving',out['support']);self.assertNotIn('recovering',out['support'])
        def test_weekly_improvement_requires_comparable_week(self):
            s=copy.deepcopy(template);s['history'][0]['value']=.72
            self.assertIn('improving',insight(s,empty)['support'])
            s['history'][0]['week']-=pd.Timedelta(days=7)
            self.assertNotIn('improving',insight(s,empty)['support'])
        def test_missing_driver_produces_no_invented_site_or_action(self):
            out=insight(data=empty);self.assertIn('Prioritize closing',out['headline']);self.assertNotIn('PHX',out['support']+out['headline'])
        def test_low_volume_driver_not_named(self):
            d=copy.deepcopy(evidence);d['drivers'][0]['n']=1
            out=insight(data=d);self.assertNotIn('PHX',out['headline']+out['support'])
        def test_low_volume_underlying_detail_not_named(self):
            d=copy.deepcopy(evidence);d['site_details']['PHX']['baseline_n']=1
            out=insight(data=d);self.assertIn('PHX',out['headline']);self.assertNotIn('Shopify Payments',out['headline'])
        def test_no_channel_share_recommendation(self):
            d=copy.deepcopy(evidence);d['drivers'][0].update(label='Chat',dimension='Channel')
            self.assertNotIn('Chat',insight(data=d)['headline'])
        def test_target_met_and_forecast_risk_uses_protect_language(self):
            s=copy.deepcopy(template);s['kpis'][0]['value']=.81
            self.assertIn('Protect',insight(s,empty)['headline'])
        def test_met_stable_result_uses_maintain_language(self):
            s=copy.deepcopy(template);s['kpis'][0]['value']=.81;s['history']=[];s['forecasts'][0]['value']=.81
            self.assertIn('Maintain',insight(s,empty)['headline'])
        def test_aht_callout_uses_minutes_and_no_smiley_driver(self):
            s=copy.deepcopy(template)
            s['kpis']=[{'kpi':'AHT','value':40.,'target':35.,'n':100.,'direction':'lower'}];s['history']=[]
            out=insight(s);self.assertIn('min',out['callout']);self.assertNotIn('PHX',out['headline']);self.assertNotIn('pp',out['callout'])
        def test_banner_length_fits_existing_text_box_budget(self):
            out=insight();self.assertLess(len(out['headline']),110);self.assertLess(len(out['support']),350)
        def test_chart_two_months_banner_one_month_and_liveassist_unchanged(self):
            m=copy.deepcopy(root_model)
            for s in m['sections']:
                s['forecasts']=[dict(fc,kpi='Smiley',month=month) for month,fc in zip((current,following),self.proj['sections'][0]['forecasts'])]
            pages=build_pages(standard,live_lob,m)
            self.assertEqual([p['lob'] for p in pages],list(ALL_LOBS))
            for page in pages[:4]:
                texts=page['manifests'][1]['expected_text'];self.assertEqual([v for k,v in texts.items() if k.endswith('_month_tick')],[current.strftime('%b EOM'),following.strftime('%b EOM')])
                self.assertNotIn(following.strftime('%b'),page['executive_insight']['support'])
            text=' '.join(t for man in pages[-1]['manifests'] for t in man['expected_text'].values()).upper()
            self.assertNotIn('FORECAST',text);self.assertNotIn('EOM',text)
    result=unittest.TextTestRunner(verbosity=2).run(unittest.defaultTestLoader.loadTestsFromTestCase(Tests))
    if not result.wasSuccessful():raise SystemExit(1)
    print('PASS: constructive recommendation/callout/narrative, two independent monthly outlooks, and current-month-only executive statements.')


