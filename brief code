            if node["kind"] == "line":
                node["y1"] *= .9; node["y2"] *= .9
            else:
                node["y"] *= .9; node["h"] *= .9
        c.height = 900
        return c
    raise ValueError("SLIDE_ASPECT must be '16:10' or '16:9'.")


def _chart(c, row, x, y, w, h, report_start):
    """Chart lines/dots are native slide objects; missing weeks are gaps."""
    c.rect(x, y, w, h, "white", "line")
    is_backup = bool(row.get("forecast", {}).get("fallback_used"))
    label = row.get("lob", "") + ("*" if is_backup else "")
    c.text(label, x+9, y+4, 104, 23, 16 if is_backup else 18, bold=True)
    if finite(row.get("target")):
        c.text("Target " + pct(row["target"]), x+114, y+7, w-122, 20, 13, "muted", align="right")
    history = {i["week"]: i for i in row.get("history", [])}
    actual = [history.get(report_start-timedelta(days=7*(12-i))) for i in range(13)]
    # A present row can still lack a valid rate. Treat it as a chart gap,
    # including at W13, rather than trying to draw a None/NaN value.
    actual = [item if item and finite(item.get("rate")) and 0 <= item["rate"] <= 1
              else None for item in actual]
    forecast = row.get("forecast", {}).get("values", [])
    valid_outlook = bool(len(forecast) == 4 and
                         all(finite(v) and 0 <= v <= 1 for v in forecast))
    points = [a["rate"] for a in actual if a and finite(a.get("rate"))]
    if valid_outlook:
        points.extend(forecast)
    if finite(row.get("target")):
        points.append(row["target"])
    if valid_outlook:
        signal = forecast_target_signal(row)
        suffix = " BELOW" if signal == "below_target" else (" MEETS" if signal == "at_or_above_target" else "")
        color = "red" if signal == "below_target" else ("teal" if signal == "at_or_above_target" else "forecast")
        c.text("W+4 " + pct(forecast[-1]) + suffix, x+55, y+25, w-64, 17, 12, color, True, "right")
    left, top = x+35, y+44
    right, bottom = x+w-15, y+h-36
    if not points:
        c.text("No data", left, top+20, right-left, 26, 17, "muted", align="center")
        return
    low, high = min(points), max(points)
    pad = max(0.025, (high-low)*0.20)
    low, high = max(0.0, low-pad), min(1.0, high+pad)
    if high-low < 0.04:
        low, high = max(0.0, low-0.02), min(1.0, high+0.02)
    X = lambda i: left + (right-left)*i/16
    Y = lambda v: bottom - (bottom-top)*(v-low)/(high-low)
    c.line(left, bottom, right, bottom)
    c.line(left, top, left, bottom)
    for v in (low, (low+high)/2, high):
        yy = Y(v)
        c.line(left, yy, right, yy, "grey", 1)
        c.text(f"{100*v:.0f}%", x-3, yy-8, 38, 17, 12, "muted", align="right")
    if finite(row.get("target")):
        yy = Y(row["target"])
        c.line(left, yy, right, yy, "muted", 1, dashed=True)
    c.line(X(12), top, X(12), bottom, "line", 1, dashed=True)
    prior = None
    for idx, item in enumerate(actual):
        if item is None:
            prior = None
            continue
        point = (X(idx), Y(item["rate"]))
        if prior:
            c.line(prior[0], prior[1], point[0], point[1], "navy", 2.4)
        prior = point
        c.dot(*point, 4.5, "navy")
    last = actual[-1]
    if last:
        status = "red" if finite(row.get("target")) and last["rate"] < row["target"] else "teal"
        c.dot(X(12), Y(last["rate"]), 9, status)
    if valid_outlook:
        prior = (X(12), Y(last["rate"])) if last else None
        for idx, value in enumerate(forecast, start=13):
            point = (X(idx), Y(value))
            if prior:
                c.line(*prior, *point, "forecast", 2.3, dashed=True)
            else:
                c.dot(*point, 5, "forecast")
            prior = point
        c.dot(X(16), Y(forecast[-1]), 7, "forecast")
    else:
        # Keep the empty-outlook message in the header, away from the x-axis.
        c.text("Outlook unavailable", x+96, y+25, w-103, 17, 12, "muted", align="right")
    c.text("W1", left-4, y+h-24, 40, 20, 12, "muted")
    c.text("W13", X(12)-20, y+h-24, 40, 20, 11, "muted", align="center")
    c.text("W+4", right-34, y+h-24, 34, 20, 11, "muted", align="right")


