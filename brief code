            module = importlib.import_module("prophet")
        except ImportError:
            print("Installing Prophet for the Smiley forecast ...", flush=True)
            subprocess.run([sys.executable, "-m", "pip", "install", "--quiet", "--no-input",
                            "--timeout", "20", "--retries", "1",
                            f"prophet=={PROPHET_INSTALL_VERSION}"], check=True, timeout=300)
            importlib.invalidate_caches()
            module = importlib.import_module("prophet")
        cls = module.Prophet
        return cls, {"status": "available", "version": str(getattr(module, "__version__", "unknown"))}
    except Exception as exc:
        return None, {"status": "unavailable", "reason": f"{type(exc).__name__}: {exc}"}


def load_arima():
    """Load statsmodels ARIMA, installing the pinned release only if absent."""
    import importlib
    try:
        try:
            module = importlib.import_module("statsmodels.tsa.arima.model")
        except ImportError:
            print("Installing statsmodels for the Smiley forecast ...", flush=True)
            subprocess.run([sys.executable, "-m", "pip", "install", "--quiet", "--no-input",
                            "--timeout", "20", "--retries", "1",
                            f"statsmodels=={STATSMODELS_INSTALL_VERSION}"], check=True, timeout=300)
            importlib.invalidate_caches()
            module = importlib.import_module("statsmodels.tsa.arima.model")
        package = importlib.import_module("statsmodels")
        return module.ARIMA, {"status": "available", "version": str(getattr(package, "__version__", "unknown"))}
    except Exception as exc:
        return None, {"status": "unavailable", "reason": f"{type(exc).__name__}: {exc}"}


def _arima_components(history, arima_class, order):
    """Fit a single ARIMA order on this origin's actual history only."""
    if arima_class is None:
        raise ValueError("statsmodels ARIMA is unavailable.")
    if len(history) < 8:
        raise ValueError("At least eight history weeks are required at an evaluation origin.")
    order = tuple(int(x) for x in order)
    observed = [float(r["rate"]) for r in history]
    if not all(finite(v) and 0 <= v <= 1 for v in observed):
        raise ValueError("ARIMA received an invalid Smiley rate.")
    arima = arima_class(observed, order=order, enforce_stationarity=True,
                        enforce_invertibility=True)
    fitted = arima.fit(method_kwargs={"maxiter": 150})
    convergence = getattr(fitted, "mle_retvals", None)
    if isinstance(convergence, dict) and convergence.get("converged") is not None \
            and not bool(convergence["converged"]):
        raise ValueError("ARIMA optimizer did not converge.")
    fitted_values = [float(v) for v in fitted.fittedvalues]
    raw_future = [float(v) for v in fitted.forecast(steps=4)]
    if len(fitted_values) != len(history) or len(raw_future) != 4 \
            or not all(finite(v) for v in raw_future):
        raise ValueError("ARIMA returned incomplete or invalid predictions.")
    # The first fitted point may be an initialization artifact, especially
    # with differencing. Exclude it and any reported likelihood burn-in.
    burn = max(1, int(getattr(fitted, "loglikelihood_burn", 0) or 0))
    if burn >= len(history) - 2 or not all(finite(v) for v in fitted_values[burn:]):
        raise ValueError("ARIMA fitted history is insufficient or invalid.")
    return fitted_values, raw_future, burn


def _smooth_forecast_path(values, latest):
    """Gently damp forecast movements from the most recent actual rate."""
    alpha = float(FORECAST_SMOOTHING_ALPHA)
    if not 0 < alpha <= 1 or not finite(latest) or not 0 <= latest <= 1:
        raise ValueError("Invalid forecast smoothing alpha or latest rate.")
    if len(values) != 4 or not all(finite(v) for v in values):
        raise ValueError("Smoothing requires four finite predictions.")
    output, before_clip, previous = [], [], float(latest)
    for value in values:
        current = alpha*float(value) + (1-alpha)*previous
        before_clip.append(current)
        previous = max(0.0, min(1.0, current))
        output.append(previous)
    return {"values": output, "before_clip": before_clip,
            "clipped": any(v < 0 or v > 1 for v in before_clip)}


def _arima_prophet_values(history, arima_class, prophet_class, order):
    """Blend ARIMA with its Prophet-smoothed estimate and dampen the path.

    Prophet sees ARIMA's fitted values and its four *predicted* future values;
    those future inputs are not actual observations. Every backtest calls this
    on origin-available history, so no later actual enters either stage.
    """
    import logging
    import pandas as pd
    if prophet_class is None:
        raise ValueError("Prophet is unavailable.")
    fitted_values, raw_future, burn = _arima_components(history, arima_class, order)
    historic_dates = [r["week"] for r in history[burn:]]
    future_dates = [history[-1]["week"] + timedelta(days=7*h) for h in range(1, 5)]
    train = pd.DataFrame({"ds": pd.to_datetime(historic_dates + future_dates),
                          "y": fitted_values[burn:] + raw_future})
    # These are weekly observations. Daily and weekly seasonalities cannot be
    # identified from a single observation per week; the short lookback also
    # does not support annual seasonality. Limited changepoints allow smoothing
    # to reflect changes without manufacturing a seasonal pattern.
    smoother = prophet_class(growth="linear", n_changepoints=min(3, max(0, (len(train)-1)//6)),
                             changepoint_range=0.95,
                             changepoint_prior_scale=PROPHET_SMOOTHING_CHANGEPOINT_SCALE,
                             yearly_seasonality=False, weekly_seasonality=False,
                             daily_seasonality=False, uncertainty_samples=0)
    logger = logging.getLogger("cmdstanpy")
    previous_level = logger.level
    try:
        logger.setLevel(logging.ERROR)
        smoother.fit(train, seed=42)
        predicted = smoother.predict(pd.DataFrame({"ds": pd.to_datetime(future_dates)}))
    finally:
        logger.setLevel(previous_level)
    smoothed = [float(v) for v in predicted["yhat"]]
    if len(smoothed) != 4 or not all(finite(v) for v in smoothed):
        raise ValueError("Prophet returned incomplete or invalid smoothed predictions.")
    weight = float(ARIMA_BLEND_WEIGHT)
    if not 0 <= weight <= 1:
        raise ValueError("ARIMA_BLEND_WEIGHT must be between zero and one.")
    # Keep some ARIMA movement, temper it with Prophet, and gently smooth the
    # resulting path. Backtests evaluate this exact complete pipeline.
    blended = [weight*a + (1-weight)*p for a,p in zip(raw_future, smoothed)]
    stabilized = _smooth_forecast_path(blended, history[-1]["rate"])
    return {"values": stabilized["values"], "prophet_values": smoothed,
            "arima_values": raw_future, "blended_values": blended,
            "smoothed_values_before_clip": stabilized["before_clip"],
            "clipped": stabilized["clipped"], "order": list(order)}


def _score_fixed_predictions(history, origins, predictions):
    """Four-horizon errors, with positive bias meaning forecast above actual."""
    by_horizon, all_errors = [], []
    for horizon in (1, 2, 3, 4):
        errors = [predictions[origin][horizon-1] - history[origin+horizon-1]["rate"]
                  for origin in origins]
        all_errors.extend(errors)
        by_horizon.append({"horizon": horizon, "origins": len(errors),
                           "mae_pp": 100*sum(abs(e) for e in errors)/len(errors),
                           "bias_pp": 100*sum(errors)/len(errors)})
    return {"mae_pp": 100*sum(abs(e) for e in all_errors)/len(all_errors),
            "bias_pp": 100*sum(all_errors)/len(all_errors), "by_horizon": by_horizon}


def _select_arima_prophet(ordered, selection, holdout, result, arima_class, prophet_class):
    """Select ARIMA order on earlier origins, then report a separate guard."""
    if arima_class is None or prophet_class is None:
        missing = [name for name, value in (("ARIMA", arima_class), ("Prophet", prophet_class)) if value is None]
        result["reason"] = "Unavailable required package(s): " + ", ".join(missing) + "."
        return result
    selected_candidates, failed = [], []
    for order in ARIMA_CANDIDATE_ORDERS:
        label = "arima_prophet" + str(tuple(order))
        try:
            outcomes = {i: _arima_prophet_values(ordered[:i], arima_class, prophet_class, order)
                        for i in selection}
            score = _score_fixed_predictions(ordered, selection, {i: x["values"] for i,x in outcomes.items()})
            raw_score = _score_fixed_predictions(ordered, selection,
                {i: [max(0.0, min(1.0, v)) for v in x["arima_values"]] for i,x in outcomes.items()})
            selected_candidates.append((score["mae_pp"], len(selected_candidates), tuple(order), label, score, raw_score))
        except Exception as exc:
            failed.append(f"{label} unavailable: {type(exc).__name__}: {exc}")
    if not selected_candidates:
        result["reason"] = "ARIMA + Prophet failed to fit for every candidate order."
        if failed:
            result["candidate_warning"] = "; ".join(failed)
        return result
    _, _, order, label, selection_score, raw_selection_score = min(selected_candidates)
    try:
        guarded = {i: _arima_prophet_values(ordered[:i], arima_class, prophet_class, order)
                   for i in holdout}
        guard_score = _score_fixed_predictions(ordered, holdout, {i: x["values"] for i,x in guarded.items()})
        raw_guard_score = _score_fixed_predictions(ordered, holdout,
            {i: [max(0.0, min(1.0, v)) for v in x["arima_values"]] for i,x in guarded.items()})
        full = _arima_prophet_values(ordered, arima_class, prophet_class, order)
    except Exception as exc:
        result["reason"] = (f"Selected ARIMA + Prophet model could not complete its guard or final fit "
                            f"({type(exc).__name__}: {exc}).")
        return result
    selection_scores = {x[3]: x[4] for x in selected_candidates}
    selection_scores["arima_only_selected_order"] = raw_selection_score
    selection_scores["last_week"] = _forecast_scorecard(ordered, selection, "last_week")
    baseline = _forecast_scorecard(ordered, holdout, "last_week")
    guard_scores = {label: guard_score, "arima_only_selected_order": raw_guard_score, "last_week": baseline}
    notes = []
    if guard_score["mae_pp"] > baseline["mae_pp"] + 1e-10:
        notes.append("ARIMA + Prophet had higher guard error than last-week; the requested model remains selected.")
    if guard_score["mae_pp"] > raw_guard_score["mae_pp"] + 1e-10:
        notes.append("Prophet smoothing had higher guard error than the selected unsmoothed ARIMA forecast.")
    if full["clipped"]:
        notes.append("One or more smoothed forecasts were clipped to the valid 0–100% range.")
    if any(v < 0.0 or v > 1.0 for v in full["arima_values"]):
        notes.append("Raw ARIMA estimates included values outside 0–100%; see the audit.")
    result.update(available=True, values=full["values"], method="arima_prophet", fallback_used=False,
                  arima_order=list(order), arima_raw_values=full["arima_values"],
                  prophet_raw_values=full["prophet_values"],
                  blended_values_before_smoothing=full["blended_values"], arima_blend_weight=ARIMA_BLEND_WEIGHT,
                  smoothed_values_before_clip=full["smoothed_values_before_clip"],
                  forecast_clipped=full["clipped"], smoothing_alpha=FORECAST_SMOOTHING_ALPHA,
                  smoothing="ARIMA blended with Prophet-smoothed ARIMA estimates, then path smoothing",
                  selection_origins=len(selection), holdout_origins=len(holdout),
                  holdout_mae_pp=guard_score["mae_pp"], baseline_holdout_mae_pp=baseline["mae_pp"],
                  selection_scores=selection_scores, guard_scores=guard_scores,
                  selected_before_guard="arima_prophet", guard_fallback=False,
                  uncertainty_note="No calibrated prediction interval is claimed for the two-stage forecast.")
    if failed:
        result["candidate_warning"] = "; ".join(failed)
    if notes:
        result["method_warning"] = " ".join(notes)
    return result


def _prophet_values(history, prophet_class):
    """Four weekly trend predictions fitted only to the supplied past weeks."""
    import logging
    import pandas as pd
    if prophet_class is None:
        raise ValueError("Prophet is not available.")
    train = pd.DataFrame({"ds": pd.to_datetime([r["week"] for r in history]),
                          "y": [float(r["rate"]) for r in history]})
    future = pd.DataFrame({"ds": pd.to_datetime(
        [history[-1]["week"] + timedelta(days=7 * h) for h in range(1, 5)])})
    # With 22 weekly observations there is no evidence for annual seasonality.
    # Keep one linear trend, with no seasonalities or fitted changepoints.
    forecast = prophet_class(growth="linear", n_changepoints=0,
                            yearly_seasonality=False, weekly_seasonality=False,
                            daily_seasonality=False, uncertainty_samples=0)
    logger = logging.getLogger("cmdstanpy")
    previous_level = logger.level
    try:
        logger.setLevel(logging.ERROR)
        forecast.fit(train, seed=42)
        prediction = forecast.predict(future)
    finally:
        logger.setLevel(previous_level)
    values = list(prediction["yhat"])
    if len(values) != 4 or not all(finite(v) for v in values):
        raise ValueError("Prophet returned an incomplete or invalid forecast.")
    # Smiley is a proportion. Clip the point predictions, not the observations.
    return [max(0.0, min(1.0, float(v))) for v in values]


def _whitepaper_weekday_values(history, context):
    """Extend the Whitepaper's in-period day-of-week projection to four weeks.

    The original Reader projects the unobserved portion of one week or month.
    Here its exact daily reference method is run over 28 future days, and each
    independent seven-day block is pooled to a weekly rate. This is an
    extension, not a claim that the Reader already forecasts four weeks.
    """
    import pandas as pd
    if not history or not context:
        raise ValueError("Whitepaper daily forecast context is unavailable.")
    cutoff = pd.Timestamp(history[-1]["week"]) + pd.Timedelta(days=6)
    daily = context["daily"]
    train = daily[pd.to_datetime(daily["Date"], errors="coerce").le(cutoff)].copy()
    if train.empty:
        raise ValueError("No daily Whitepaper history at this forecast origin.")
    projection = context["reader"].project_remaining_dates(
        scope_df=train, actual_positive=0.0, actual_responses=0.0,
        data_through=cutoff, projection_end=cutoff + pd.Timedelta(days=28),
        config=context["config"])
    projected = projection["daily_projection"]
    if len(projected) != 28:
        raise ValueError("Whitepaper daily projection did not return 28 dates.")
    values = []
    for h in range(4):
        week = projected.iloc[h*7:(h+1)*7]
        if week[["Expected Positive", "Expected Responses"]].isna().any().any():
            raise ValueError("A projected Whitepaper day has missing expected counts.")
        positive = float(week["Expected Positive"].sum())
        responses = float(week["Expected Responses"].sum())
        if not finite(positive) or not finite(responses) or responses <= 0 or not 0 <= positive <= responses:
            raise ValueError("A projected Whitepaper week has invalid or zero response volume.")
        values.append(positive / responses)
    return values


def _forecast_values(history, mode, prophet_class=None, whitepaper_context=None):
    if mode == "prophet":
        return _prophet_values(history, prophet_class)
    if mode == "whitepaper_weekday":
        return _whitepaper_weekday_values(history, whitepaper_context)
    return [_candidate_forecast(history, mode, horizon) for horizon in (1, 2, 3, 4)]


def _forecast_scorecard(history, origins, mode, prophet_class=None, whitepaper_context=None):
    """Summarize multi-step forecast errors using origin-available data only.

    Signed bias is forecast minus actual, so positive means optimistic.
    """
    by_horizon = []
    all_errors = []
    # One fit per origin produces all four horizons; never fit on future data.
    predictions = {origin: _forecast_values(history[:origin], mode, prophet_class, whitepaper_context)
                   for origin in origins}
    for horizon in (1, 2, 3, 4):
        errors = [predictions[origin][horizon - 1] - history[origin + horizon - 1]["rate"]
                  for origin in origins]
        all_errors.extend(errors)
        by_horizon.append({"horizon": horizon, "origins": len(errors),
                           "mae_pp": 100 * sum(abs(e) for e in errors) / len(errors),
                           "bias_pp": 100 * sum(errors) / len(errors)})
    return {"mae_pp": 100 * sum(abs(e) for e in all_errors) / len(all_errors),
            "bias_pp": 100 * sum(all_errors) / len(all_errors),
            "by_horizon": by_horizon}


def _damped_trend_values(history):
    """Dependency-free backup using an exponentially smoothed, damped trend."""
    alpha, damping = float(FORECAST_SMOOTHING_ALPHA), float(FALLBACK_TREND_DAMPING)
    if not 0 < alpha <= 1 or not 0 < damping < 1 or len(history) < 4:
        raise ValueError("Invalid smoothing settings or insufficient history for the damped trend.")
    observed = [float(row["rate"]) for row in history]
    if not all(finite(v) and 0 <= v <= 1 for v in observed):
        raise ValueError("Damped trend received an invalid Smiley rate.")
    levels = [observed[0]]
    for value in observed[1:]:
        levels.append(alpha*value + (1-alpha)*levels[-1])
    slope = (levels[-1]-levels[-4])/3
    values = [levels[-1] + slope*sum(damping**i for i in range(1, h+1))
              for h in range(1, 5)]
    return _smooth_forecast_path(values, observed[-1])


def _finish_forecast_backup(ordered, selection, holdout, result, method,
                            selection_predictions, guard_predictions, final,
                            primary_reason, fallback_errors, arima_order=None):
    """Record the backup and its out-of-sample checks without hiding it."""
    chosen_selection = _score_fixed_predictions(ordered, selection, selection_predictions)
    chosen_guard = _score_fixed_predictions(ordered, holdout, guard_predictions)
    baseline_selection = _forecast_scorecard(ordered, selection, "last_week")
    baseline_guard = _forecast_scorecard(ordered, holdout, "last_week")
    note = f"Backup {method} was used because ARIMA + Prophet was unavailable."
    if chosen_guard["mae_pp"] > baseline_guard["mae_pp"] + 1e-10:
        note += " This backup had higher guard error than last-week."
    if final.get("clipped"):
        note += " At least one forecast was clipped to the valid 0–100% range."
    result.update(available=True, reason="", values=final["values"], method=method,
                  fallback_used=True, fallback_reason=primary_reason,
                  fallback_attempt_warnings=fallback_errors,
                  smoothing_alpha=FORECAST_SMOOTHING_ALPHA,
                  forecast_clipped=bool(final.get("clipped")),
                  smoothed_values_before_clip=final.get("before_clip", []),
                  selection_origins=len(selection), holdout_origins=len(holdout),
                  holdout_mae_pp=chosen_guard["mae_pp"], baseline_holdout_mae_pp=baseline_guard["mae_pp"],
                  selection_scores={method:chosen_selection, "last_week":baseline_selection},
                  guard_scores={method:chosen_guard, "last_week":baseline_guard},
                  selected_before_guard=method, guard_fallback=False, method_warning=note,
                  uncertainty_note="No calibrated prediction interval is claimed for this backup.")
    if arima_order is not None:
        result["arima_order"] = list(arima_order)
    if method == "damped_trend_backup":
        result["trend_damping"] = FALLBACK_TREND_DAMPING
    return result


def _forecast_backup(ordered, selection, holdout, result, arima_class, prophet_class, primary_reason):
    """Try smoothed ARIMA, smoothed Prophet, then a dependency-free trend."""
    failures = []
    if arima_class is not None:
        candidates = []
        for order in ARIMA_CANDIDATE_ORDERS:
            try:
                predictions = {}
                for i in selection:
                    _, raw, _ = _arima_components(ordered[:i], arima_class, order)
                    predictions[i] = _smooth_forecast_path(raw, ordered[i-1]["rate"])["values"]
                score = _score_fixed_predictions(ordered, selection, predictions)
                candidates.append((score["mae_pp"], len(candidates), tuple(order), predictions))
            except Exception as exc:
                failures.append(f"ARIMA backup {tuple(order)}: {type(exc).__name__}: {exc}")
        if candidates:
            _, _, order, predictions = min(candidates, key=lambda item:(item[0],item[1]))
            try:
                guard = {}
                for i in holdout:
                    _, raw, _ = _arima_components(ordered[:i], arima_class, order)
                    guard[i] = _smooth_forecast_path(raw, ordered[i-1]["rate"])["values"]
                _, raw, _ = _arima_components(ordered, arima_class, order)
                final = _smooth_forecast_path(raw, ordered[-1]["rate"])
                result["arima_raw_values"] = raw
                return _finish_forecast_backup(ordered, selection, holdout, result,
                    "arima_smoothed_backup", predictions, guard, final, primary_reason, failures, order)
            except Exception as exc:
                failures.append(f"Selected ARIMA backup: {type(exc).__name__}: {exc}")
    if prophet_class is not None:
        try:
            def prophet_forecast(rows):
                return _smooth_forecast_path(_prophet_values(rows, prophet_class), rows[-1]["rate"])
            predictions = {i:prophet_forecast(ordered[:i])["values"] for i in selection}
            guard = {i:prophet_forecast(ordered[:i])["values"] for i in holdout}
            final = prophet_forecast(ordered)
            return _finish_forecast_backup(ordered, selection, holdout, result,
                "prophet_smoothed_backup", predictions, guard, final, primary_reason, failures)
        except Exception as exc:
            failures.append(f"Prophet backup: {type(exc).__name__}: {exc}")
    try:
        predictions = {i:_damped_trend_values(ordered[:i])["values"] for i in selection}
        guard = {i:_damped_trend_values(ordered[:i])["values"] for i in holdout}
        final = _damped_trend_values(ordered)
        return _finish_forecast_backup(ordered, selection, holdout, result,
            "damped_trend_backup", predictions, guard, final, primary_reason, failures)
    except Exception as exc:
        result["available"] = False
        result["values"] = []
        result["reason"] = f"Primary and backup forecasts are unavailable: {type(exc).__name__}: {exc}"
        result["fallback_attempt_warnings"] = failures
        return result


def _adaptive_available_forecast(observed, end_week, result, reason, min_responses):
    """A dated, weighted and damped backup; never insert synthetic observations."""
    if not observed:
        result["reason"] = "No valid weekly Smiley observations are available."
        return result
    if min_responses <= 0 or not 0 < FORECAST_RECENCY_DECAY < 1:
        raise ValueError("Invalid forecast response or recency setting.")
    latest = observed[-1]
    # Calendar differences, not row indexes, keep missing weeks in their true positions.
    age = [(latest["week"] - row["week"]).days / 7 for row in observed]
    x = [-a for a in age]
    weights = [(FORECAST_RECENCY_DECAY ** a) * min(float(row["n"]) / min_responses, 1.0)
               for a, row in zip(age, observed)]
    total = sum(weights)
    mx = sum(w*v for w, v in zip(weights, x)) / total
    my = sum(w*float(row["rate"]) for w, row in zip(weights, observed)) / total
    denom = sum(w*(v-mx)**2 for w,v in zip(weights,x))
    slope = (sum(w*(v-mx)*(float(row["rate"])-my)
                 for w,v,row in zip(weights,x,observed)) / denom
             if len(observed) >= 3 and denom > 0 else 0.0)
    alpha, damping = float(FORECAST_SMOOTHING_ALPHA), float(FALLBACK_TREND_DAMPING)
    if not 0 < alpha <= 1 or not 0 < damping < 1:
        raise ValueError("Invalid forecast smoothing settings.")
    gap = (end_week - latest["week"]).days // 7
    previous = float(latest["rate"])
    predictions, before_clip = [], []
    for h in range(1, gap + 5):
        raw = my + slope * damping * (1.0 - damping**h) / (1.0 - damping)
        smoothed = alpha*raw + (1-alpha)*previous
        previous = max(0.0, min(1.0, smoothed))
        if h > gap:
            predictions.append(previous)
            before_clip.append(smoothed)
    low = sum(float(row["n"]) < min_responses for row in observed)
    result.update(available=True, values=predictions, method="adaptive_smoothing_backup",
                  fallback_used=True, fallback_reason=reason, reason="",
                  history_weeks=len(observed), last_observed_week=latest["week"],
                  low_sample_weeks=low, skipped_calendar_weeks=gap,
                  forecast_clipped=any(v < 0 or v > 1 for v in before_clip),
                  smoothing_alpha=alpha, trend_damping=damping,
                  method_warning=("Adaptive dated smoothing uses available observations; "
                                  "no separated four-week backtest is available."),
                  uncertainty_note="No calibrated prediction interval is claimed.")
    return result


def forecast_weekly(history, end_week, minimum=FORECAST_MIN_WEEKS,
                    min_responses=FORECAST_MIN_RESPONSES, prophet_class=None,
                    whitepaper_context=None, selection_mode=None, arima_class=None):
    """Four-week forecasts; never fill missing weeks or invent bounds.

    ARIMA_PROPHET fits ARIMA and applies Prophet plus mild path smoothing,
    evaluating the complete pipeline on separated rolling origins. Explicitly
    labeled backups are used on dependency or model failure. WHITEPAPER and
    AUTO retain their earlier behavior. No calibrated intervals are claimed.
    """
    result = {"available": False, "values": [], "reason": "", "method": "",
              "history_weeks": 0, "selection_origins": 0, "holdout_origins": 0,
              "holdout_mae_pp": None, "baseline_holdout_mae_pp": None,
              "selection_scores": {}, "guard_scores": {},
              "selected_before_guard": "", "guard_fallback": False}
    selection_mode = str(FORECAST_MODEL_MODE if selection_mode is None else selection_mode).strip().upper()
    if selection_mode not in ("ARIMA_PROPHET", "WHITEPAPER", "AUTO"):
        raise ValueError("FORECAST_MODEL_MODE must be ARIMA_PROPHET, WHITEPAPER or AUTO.")
    result["selection_mode"] = selection_mode
    eligible = [x for x in history if x.get("week") <= end_week]
    eligible.sort(key=lambda x: x["week"])
    by_week = {}
    for row in eligible:
        key = row["week"]
        if key in by_week:
            raise ValueError("Duplicate weekly observations in forecast input.")
        by_week[key] = row
    observed = []
    for row in eligible:
        if not finite(row.get("n")) or not finite(row.get("p")) or not finite(row.get("rate")):
            continue
        if row["n"] <= 0 or row["p"] < 0 or row["p"] > row["n"] or not 0 <= row["rate"] <= 1:
            raise ValueError("Invalid weekly Smiley counts or rate in forecast input.")
        if (end_week - row["week"]).days % 7:
            raise ValueError("Forecast observation does not align with the reporting week.")
        observed.append(row)
    # The ARIMA backtest uses a contiguous tail. The adaptive fallback can
    # use all dated observations, including records separated by missing weeks.
    valid_by_week = {row["week"]: row for row in observed}
    ordered, cursor = [], end_week
    while cursor in valid_by_week:
        ordered.append(valid_by_week[cursor])
        cursor -= timedelta(days=7)
    ordered.reverse()
    result["history_weeks"] = len(ordered)
    result["available_observation_weeks"] = len(observed)
    result["low_sample_weeks"] = sum(row["n"] < min_responses for row in observed)
    if len(ordered) < minimum:
        if selection_mode == "WHITEPAPER":
            result["reason"] = "Insufficient contiguous history for the requested Whitepaper method; no other method was substituted."
            return result
        return _adaptive_available_forecast(observed, end_week, result,
                    f"Fewer than {minimum} consecutive usable weeks for a separated model backtest.", min_responses)
    # Each origin must have all four observed horizons, strictly later than train.
    origins = list(range(8, len(ordered) - 3))
    holdout = origins[-min(4, max(1, len(origins) - 4)):]
    # Embargo the 4-week horizon: no model-selection outcome may occur at or
    # after the first holdout origin, preventing selection leakage.
    selection = [i for i in origins if i + 3 < holdout[0]]
    if not selection:
        return _adaptive_available_forecast(observed, end_week, result,
                    "Insufficient separated model-selection and holdout origins.", min_responses)

    if selection_mode == "ARIMA_PROPHET":
        result = _select_arima_prophet(ordered, selection, holdout, result, arima_class, prophet_class)
        if result["available"]:
            return result
        primary_reason = result.get("reason", "ARIMA + Prophet failed.")
        return _forecast_backup(ordered, selection, holdout, result,
                                arima_class, prophet_class, primary_reason)

    # Candidate order is the predeclared tie-breaker, favoring simple methods.
    candidates = ("last_week", "pooled_4w", "weighted_smoothing", "blend_50")
    selection_scores = {name: _forecast_scorecard(ordered, selection, name) for name in candidates}
    guard_scores = {name: _forecast_scorecard(ordered, holdout, name) for name in candidates}
    prophet_values = None
    whitepaper_values = None
    candidate_warnings = []
    if whitepaper_context is not None:
        try:
            wp_selection = _forecast_scorecard(ordered, selection, "whitepaper_weekday",
                                                whitepaper_context=whitepaper_context)
            wp_guard = _forecast_scorecard(ordered, holdout, "whitepaper_weekday",
                                            whitepaper_context=whitepaper_context)
            whitepaper_values = _forecast_values(ordered, "whitepaper_weekday",
                                                  whitepaper_context=whitepaper_context)
            candidates += ("whitepaper_weekday",)
            selection_scores["whitepaper_weekday"] = wp_selection
            guard_scores["whitepaper_weekday"] = wp_guard
        except Exception as exc:
            candidate_warnings.append(f"Whitepaper weekday candidate unavailable: {type(exc).__name__}: {exc}")
    if prophet_class is not None:
        try:
            prophet_selection = _forecast_scorecard(ordered, selection, "prophet", prophet_class)
            prophet_guard = _forecast_scorecard(ordered, holdout, "prophet", prophet_class)
            prophet_values = _forecast_values(ordered, "prophet", prophet_class)
            candidates += ("prophet",)
            selection_scores["prophet"] = prophet_selection
            guard_scores["prophet"] = prophet_guard
        except Exception as exc:
            # Never compare a partially scored Prophet candidate with complete candidates.
            candidate_warnings.append(f"Prophet candidate unavailable: {type(exc).__name__}: {exc}")
    if selection_mode == "WHITEPAPER":
        if whitepaper_values is None:
            result["reason"] = "Whitepaper weekday forecast is unavailable; no different model was substituted."
            result["selection_scores"], result["guard_scores"] = selection_scores, guard_scores
            if candidate_warnings:
                result["candidate_warning"] = "; ".join(candidate_warnings)
            return result
        selected = "whitepaper_weekday"
    else:
        selected = min(candidates, key=lambda name: (selection_scores[name]["mae_pp"], candidates.index(name)))
    selected_before_guard = selected
    baseline_mae = guard_scores["last_week"]["mae_pp"]
    chosen_mae = guard_scores[selected]["mae_pp"]
    fallback = selection_mode == "AUTO" and chosen_mae > baseline_mae + 1e-10
    if selection_mode == "WHITEPAPER" and chosen_mae > baseline_mae + 1e-10:
        result["method_warning"] = ("The requested Whitepaper method had higher guard error than last-week "
                                    "in this limited backtest; it remains selected as configured.")
    if fallback:
        selected, chosen_mae = "last_week", baseline_mae
    result.update(available=True,
                  values=(prophet_values if selected == "prophet" else
                          whitepaper_values if selected == "whitepaper_weekday" else
                          _forecast_values(ordered, selected)),
                  method=selected, selection_origins=len(selection), holdout_origins=len(holdout),
                  holdout_mae_pp=chosen_mae, baseline_holdout_mae_pp=baseline_mae,
                  selection_scores=selection_scores, guard_scores=guard_scores,
                  selected_before_guard=selected_before_guard, guard_fallback=fallback,
                  whitepaper_reference=whitepaper_values)
    if candidate_warnings:
        result["candidate_warning"] = "; ".join(candidate_warnings)
    return result


def forecast_target_signal(row):
    """Compare W+4 with its LOB target, using unrounded values."""
    forecast = row.get("forecast", {})
    values = forecast.get("values", [])
    target = row.get("target")
    if not forecast.get("available") or len(values) != 4 or not finite(values[-1]) or not finite(target):
        return "unavailable"
    return "below_target" if values[-1] < target else "at_or_above_target"


def apply_what_if(model, lob_setting, adjustment_setting):
    """Optional, explicitly assumed percentage-point change to one W+4 result."""
    lob = str(lob_setting or "").strip().upper()
    delta_text = "" if adjustment_setting is None else str(adjustment_setting).strip()
    if not lob and not delta_text:
        return None
    if lob not in LOBS or not delta_text:
        raise ValueError("Set both WHAT_IF_LOB (CORE, PLUS, RETAIL or PREMIUM) and WHAT_IF_ADJUSTMENT_PP, or leave both blank.")
    try:
        delta = float(delta_text)
    except ValueError as exc:
        raise ValueError("WHAT_IF_ADJUSTMENT_PP must be a number of percentage points.") from exc
    if not finite(delta) or not -100 <= delta <= 100:
        raise ValueError("WHAT_IF_ADJUSTMENT_PP must be between -100 and 100.")
    row = next(r for r in model["rows"] if r["lob"] == lob)
    f = row.get("forecast", {})
    if not f.get("available") or len(f.get("values", [])) != 4 or not finite(f["values"][-1]):
        return {"available": False, "lob": lob, "adjustment_pp": delta,
                "reason": "A what-if needs an available W+4 baseline."}
    baseline = float(f["values"][-1])
    scenario = baseline + delta / 100
    if not 0 <= scenario <= 1:
        raise ValueError("The what-if W+4 result must be between 0% and 100%; adjust WHAT_IF_ADJUSTMENT_PP.")
    return {"available": True, "lob": lob, "adjustment_pp": delta,
            "baseline_w4": baseline, "scenario_w4": scenario,
            "label": "Manually assumed change; not a model forecast."}


def segment_highlight(reader, current, previous, column, minimum, allowed=None):
    """Compare the same named Whitepaper segment in both reporting periods."""
    import pandas as pd
    if column not in current.columns or column not in previous.columns:
        return None
    def grouped(frame):
        checked = reader._v597_count_frame(frame)
        if checked is None:
            return {}
        labels = checked[column].fillna("").astype(str).str.strip()
        valid = labels.ne("") & ~labels.str.upper().isin(
            {"UNKNOWN", "UNASSIGNED", "N/A", "NONE", "NAN"})
        if allowed is not None:
            valid &= labels.str.upper().isin(allowed)
        checked = checked.loc[valid, ["Responses", "Smiley Numerator"]].copy()
        checked["_group"] = labels[valid].str.upper()
        out = {}
        for key, part in checked.groupby("_group", sort=True):
            p, n, rate = reader.weighted_totals(part)
            if finite(p) and finite(n) and finite(rate) and n > 0 and n >= minimum:
                out[str(key)] = (float(p), float(n), float(rate))
        return out
    now, prior = grouped(current), grouped(previous)
    candidates = []
    for key in now.keys() & prior.keys():
        change = now[key][2] - prior[key][2]
        candidates.append({"label": key, "rate": now[key][2], "responses": now[key][1],
                           "previous_rate": prior[key][2], "previous_n": prior[key][1],
                           "delta_pp": 0.0 if round(change * 100, 1) == 0 else change * 100})
    if not candidates:
        return None
    return sorted(candidates, key=lambda x: (-abs(x["delta_pp"]), x["delta_pp"], x["label"]))[0]


def segment_highlights_two(reader, current, previous, columns, minimum, allowed_sites=None):
    """Select up to two matched segments without combining squads across sites."""
    columns = tuple(columns)
    if not all(col in current.columns and col in previous.columns for col in columns):
        return []
    invalid = {"", "UNKNOWN", "UNASSIGNED", "N/A", "NONE", "NAN", "-"}
    def grouped(frame):
        checked = reader._v597_count_frame(frame)
        if checked is None or checked.empty:
            return {}
        checked = checked.copy()
        keys = []
        mask = None
        for i, col in enumerate(columns):
            key = checked[col].fillna("").astype(str).str.strip().str.upper()
            valid = ~key.isin(invalid)
            if col == "Site" and allowed_sites is not None:
                valid &= key.isin(allowed_sites)
            mask = valid if mask is None else mask & valid
            name = f"_segment_{i}"
            checked[name] = key
            keys.append(name)
        checked = checked.loc[mask]
        result = {}
        for key, part in checked.groupby(keys, sort=True):
            key = key if isinstance(key, tuple) else (key,)
            p, n, rate = reader.weighted_totals(part)
            if finite(p) and finite(n) and finite(rate) and n > 0 and n >= minimum:
                result[key] = (float(n), float(rate))
        return result
    now, prior = grouped(current), grouped(previous)
    options = []
    for key in now.keys() & prior.keys():
        change = (now[key][1] - prior[key][1]) * 100
        hit = {"label": key[-1], "rate": now[key][1], "responses": now[key][0],
               "previous_rate": prior[key][1], "previous_n": prior[key][0],
               "delta_pp": 0.0 if round(change, 1) == 0 else change}
        if len(key) == 2:
            hit["site"] = key[0]
        options.append(hit)
    def identity(item):
        return (item.get("site", ""), item["label"])
    declines = [item for item in options if item["delta_pp"] < 0]
    gains = [item for item in options if item["delta_pp"] > 0]
    if declines and gains:
        return [min(declines, key=lambda x: (x["delta_pp"], identity(x))),
                min(gains, key=lambda x: (-x["delta_pp"], identity(x)))]
    return sorted(options, key=lambda x: (-abs(x["delta_pp"]), identity(x)))[:2]


def whitepaper_topics(reader, current, previous):
    """Reconcile mutually exclusive Level One topics against survey totals."""
    import pandas as pd
    def group(frame):
        checked = reader._v597_count_frame(frame)
        if checked is None or checked.empty or "Level One" not in checked:
            return {}, 0.0, 0.0
        labels = checked["Level One"].map(reader._v574_label).map(reader._taxonomy_clean_value_v557)
        values = pd.DataFrame({"label": labels, "positive": checked["Smiley Numerator"],
                               "non_smiley": checked["Responses"]-checked["Smiley Numerator"]})
        grouped = values.groupby("label", dropna=False, sort=True)[["positive","non_smiley"]].sum()
        result = {str(key): {"positive": float(value["positive"]), "non_smiley": float(value["non_smiley"])}
                  for key, value in grouped.iterrows() if str(key)}
        return result, float(values["positive"].sum()), float(values["non_smiley"].sum())
    now, positive_total, non_total = group(current)
    prior, _, prior_non_total = group(previous)
    positive_rank = sorted(((label, counts["positive"]) for label, counts in now.items() if counts["positive"] > 0),
                           key=lambda item: (-item[1], item[0]))
    negative_rank = sorted(((label, counts["non_smiley"]) for label, counts in now.items() if counts["non_smiley"] > 0),
                           key=lambda item: (-item[1], item[0]))
    positive = None
    if positive_rank and positive_total > 0:
        label, count = positive_rank[0]
        positive = {"label": label, "count": count, "total": positive_total, "share": count/positive_total}
    combined = None
    if len(negative_rank) >= 2 and non_total > 0:
        count = negative_rank[0][1] + negative_rank[1][1]
        combined = {"labels": [negative_rank[0][0], negative_rank[1][0]],
                    "count": count, "total": non_total, "share": count/non_total}
    previous_top = None
    if negative_rank and non_total >= FORECAST_MIN_RESPONSES and prior_non_total >= FORECAST_MIN_RESPONSES:
        label, count = negative_rank[0]
        prior_classified = sum(item["non_smiley"] for item in prior.values())
        # A missing label is zero only when the previous period's non-Smiley
        # population was fully classified. Otherwise its prior count is unknown.
        prior_known = label in prior or math.isclose(prior_classified, prior_non_total, abs_tol=1e-8)
        if prior_known:
            previous_count = prior.get(label, {}).get("non_smiley", 0.0)
            previous_top = {"label": label, "count": count, "total": non_total, "share": count/non_total,
                            "previous_count": previous_count, "previous_total": prior_non_total,
                            "previous_share": previous_count/prior_non_total}
    return {"positive": positive, "top_two_non_smiley": combined, "top_non_smiley_comparison": previous_top}


def whitepaper_omg(reader, filtered, start, end, config):
    """Reuse the Reader's pre-dedup assessment scope and conflict handling."""
    import pandas as pd
    from types import SimpleNamespace
    metric = SimpleNamespace(scope_name="Overall", period_start=pd.Timestamp(start),
                             period_end=pd.Timestamp(end), data_through=pd.Timestamp(end))
    source = reader._v580_scope_omg_source(filtered, metric, config)
    rows = reader._v574_omg_rows(source, config)
    results = []
    for row in rows:
        favorable, adverse = num(row.get("favorable_rows")), num(row.get("adverse_rows"))
        assessed = num(row.get("assessed"))
        good_n, bad_n = num(row.get("good_n")), num(row.get("bad_n"))
        good_rate, bad_rate = num(row.get("good_rate")), num(row.get("bad_rate"))
        def weighted_positives(n, rate):
            if n == 0:
                return 0.0
            if n is None or n < 0 or rate is None or not 0 <= rate <= 1:
                return None
            return n*rate
        good_positive, bad_positive = weighted_positives(good_n, good_rate), weighted_positives(bad_n, bad_rate)
        smiley_n = non_smiley_n = smiley_met = non_smiley_met = None
        if good_positive is not None and bad_positive is not None:
            smiley_n = good_positive + bad_positive
            non_smiley_n = (good_n-good_positive) + (bad_n-bad_positive)
            if smiley_n > 0:
                smiley_met = good_positive/smiley_n
            if non_smiley_n > 0:
                non_smiley_met = (good_n-good_positive)/non_smiley_n
        results.append({"behavior": row["behavior"], "assessed": assessed,
                        "favorable": favorable, "adverse": adverse,
                        "overall_met_rate": num(row.get("favorable_rate")),
                        "smiley_met_rate": smiley_met, "smiley_n": smiley_n,
                        "non_smiley_met_rate": non_smiley_met, "non_smiley_n": non_smiley_n,
                        "unavailable": num(row.get("unavailable")), "unmapped": num(row.get("unmapped")),
                        "association_conflicts": num(row.get("association_conflicts")),
                        "population_basis": str(row.get("population_basis", ""))})
    return results


def read_model(reader, normalized, start, end, prophet_class=None, arima_class=None):
    """Use the Reader's filters and Smiley count aggregation."""
    import pandas as pd
    data = normalized.copy()
    data["Date"] = pd.to_datetime(data["Date"], errors="coerce")
    usable_dates = data["Date"].dropna()
    if usable_dates.empty:
        raise ValueError("The Whitepaper source has no valid reporting Date values.")
    data = data[data["Date"].dt.date.le(end)].copy()
    available_dates = data["Date"].dropna()
    if available_dates.empty:
        raise ValueError("The Whitepaper has no dated records on or before the reporting week.")
    source_latest = available_dates.max().date()
    partial = source_latest < end
    # Compare matching days when the reporting week is only partially loaded.
    comparison_end = min(source_latest, end) - timedelta(days=7)
    config = reader.CONFIG
    rows, problems = [], []
    for lob in LOBS:
        try:
            filtered, _ = reader.apply_business_filter(data, lob, config)
        except ValueError as exc:
            if "returned zero valid rows" not in str(exc):
                raise
            problems.append(f"{lob}: Reader filter failed: {exc}")
            rows.append({"lob": lob, "history": [], "forecast": {"available": False, "values": [], "reason": "LOB unavailable"}})
            continue
        if filtered.empty:
            problems.append(f"{lob}: no eligible Reader rows.")
            rows.append({"lob": lob, "history": [], "forecast": {"available": False, "values": [], "reason": "No eligible rows"}})
            continue
        if reader._v597_count_frame(filtered) is None:
            raise ValueError(f"{lob}: Reader counts do not satisfy 0 ≤ positives ≤ responses.")
        current = filtered[(filtered["Date"] >= pd.Timestamp(start)) & (filtered["Date"] < pd.Timestamp(end + timedelta(days=1)))].copy()
        previous = filtered[(filtered["Date"] >= pd.Timestamp(start - timedelta(days=7))) & (filtered["Date"] < pd.Timestamp(comparison_end + timedelta(days=1)))].copy()
        positive, responses, rate = reader.weighted_totals(current)
        prev_p, prev_n, prev_rate = reader.weighted_totals(previous)
        if responses <= 0 or not finite(rate):
            rate, responses, positive = None, 0.0, 0.0
            problems.append(f"{lob}: no valid Smiley responses in the reporting week.")
        if prev_n <= 0 or not finite(prev_rate):
            prev_rate = None
        weekly = reader.aggregate_by_week(filtered)
        history = []
        for _, item in weekly.iterrows():
            week = pd.Timestamp(item["Week Start"]).date()
            p, n, rate_week = num(item["Positive"]), num(item["Responses"]), num(item["Actual Rate"])
            if week <= start and n is not None and n > 0 and p is not None and rate_week is not None:
                if p < 0 or p > n:
                    raise ValueError(f"Invalid Smiley counts for {lob}, week {week}.")
                history.append({"week": week, "p": p, "n": n, "rate": rate_week})
        current_checked = reader._v597_count_frame(current)
        reason = reader._v597_pareto_facts(current_checked)
        insights = whitepaper_topics(reader, current, previous)
        omg = whitepaper_omg(reader, filtered, start, end, config)
        allowed_sites = reader.approved_site_set(config) if hasattr(reader, "approved_site_set") else None
        # Sites can have a small survey share. Compare any valid positive
        # response counts and show both samples on the slide.
        site = segment_highlight(reader, current, previous, "Site", 0, allowed_sites)
        cohort = segment_highlight(reader, current, previous, "Tenure Group",
                                   int(getattr(config, "minimum_reportable_n", 30)))
        squads = segment_highlights_two(reader, current, previous, ("Site", "Squad Code"), 0, allowed_sites)
        cohorts = segment_highlights_two(reader, current, previous, ("Tenure Group",),
                                          int(getattr(config, "minimum_reportable_n", 30)))
        try:
            target = num(reader._validated_smiley_targets_v583(config).get(lob))
        except (ValueError, KeyError, TypeError):
            target = None
        daily = reader.aggregate_by_date(filtered).rename(columns={"Positive": "Smiley Numerator"})
        wp_context = {"reader": reader, "daily": daily[["Date","Responses","Smiley Numerator"]],
                      "config": reader.resolve_smiley_config_v583(config, lob)}
        forecast = forecast_weekly(history, start, prophet_class=prophet_class,
                                   whitepaper_context=wp_context, arima_class=arima_class)
        if forecast.get("low_sample_weeks"):
            problems.append(f"{lob}: {forecast['low_sample_weeks']} forecast input week(s) have fewer than {FORECAST_MIN_RESPONSES} responses; interpret with care.")
        if forecast.get("candidate_warning"):
            problems.append(f"{lob}: {forecast['candidate_warning']}")
        if forecast.get("method_warning"):
            problems.append(f"{lob}: {forecast['method_warning']}")
        rows.append({"lob": lob, "rate": num(rate), "positive": num(positive),
                     "responses": num(responses), "previous_rate": num(prev_rate),
                     "previous_n": num(prev_n), "target": target,
                     "reason": {"status": reason.get("status"), "label": reason.get("top_reason", ""),
                                "count": num(reason.get("top_reason_non_smiley")),
                                "share": num(reason.get("top_reason_share")),
                                "total": num(reason.get("total_non_smiley")),
                                "topics": [{"label": t["label"], "count": num(t["count"]),
                                            "share": num(t["share"]), "kind": t["kind"]}
                                           for t in reason.get("rows", [])]},
                     "site_highlight": site, "cohort_highlight": cohort,
                     "squad_highlights": squads, "cohort_highlights": cohorts,
                     "insights": insights, "omg": omg,
                     "history": history, "forecast": forecast})
    if not any(finite(row.get("rate")) for row in rows):
        problems.append("No eligible Smiley responses for the reporting week; Smiley results remain unavailable.")
    return {"week_start": start, "week_end": end, "source_latest": source_latest, "source_partial": partial,
            "rows": rows, "warnings": problems, "reader_version": reader.__version__,
            "time_basis": "Reporting Date", "illustrative": False}


def read_google_rows(sheets, spreadsheet_id, tab):
    """Bounded Sheets reads only; never changes the source or creates tabs."""
    import pandas as pd
    metadata = sheets.spreadsheets().get(spreadsheetId=spreadsheet_id,
        fields="sheets(properties(title,gridProperties(rowCount,columnCount)))").execute(num_retries=3)
    matching = [s["properties"] for s in metadata.get("sheets", []) if s["properties"]["title"] == tab]
    if len(matching) != 1:
        raise ValueError(f"Source tab {tab!r} was not found uniquely.")
    grid_rows = int(matching[0]["gridProperties"]["rowCount"])
    if grid_rows > MAX_GRID_ROWS:
        raise ValueError(f"Source grid has {grid_rows:,} rows, exceeding MAX_GRID_ROWS. Check the source or increase the guard explicitly.")
    escaped = tab.replace("'", "''")
    header_value = sheets.spreadsheets().values().get(spreadsheetId=spreadsheet_id,
        range=f"'{escaped}'!1:1").execute(num_retries=3).get("values", [])
    if not header_value or not any(str(x).strip() for x in header_value[0]):
        raise ValueError("The source tab has no named header row.")
    headers = [str(x).strip() for x in header_value[0]]
    named = [i for i, h in enumerate(headers) if h]
    last_col = named[-1] + 1
    def letters(n):
        out = ""
        while n:
            n, rem = divmod(n - 1, 26)
            out = chr(65 + rem) + out
        return out
    all_rows = []
    for first in range(2, grid_rows + 1, ROWS_PER_READ):
        last = min(grid_rows, first + ROWS_PER_READ - 1)
        a1 = f"'{escaped}'!A{first}:{letters(last_col)}{last}"
        batch = sheets.spreadsheets().values().get(spreadsheetId=spreadsheet_id, range=a1).execute(num_retries=3).get("values", [])
        for row in batch:
            if any(str(v).strip() for v in row):
                all_rows.append([row[i] if i < len(row) else "" for i in named])
        if first == 2 or last == grid_rows or first % (ROWS_PER_READ * 10) == 2:
            print(f"Read through source row {last:,} of {grid_rows:,} ...")
    if not all_rows:
        raise ValueError("The source tab has no populated data rows.")
    return pd.DataFrame(all_rows, columns=[headers[i] for i in named])


def _source_key(value):
    return re.sub(r"[^a-z0-9]", "", str(value or "").casefold())


def _weekly_number(value, metric, context):
    """Parse evaluated sheet values; AHT stays a decimal, other metrics are rates."""
    if value is None or (isinstance(value, str) and not value.strip()):
        return None
    if isinstance(value, bool):
        raise ValueError(f"{context}: {metric} must be a number, not a Boolean.")
    is_percent = isinstance(value, str) and "%" in value
    text_value = str(value).strip().replace("%", "")
    if "," in text_value and not re.fullmatch(r"[+-]?\d{1,3}(,\d{3})+(\.\d+)?", text_value):
        raise ValueError(f"{context}: {metric} has an ambiguous comma-formatted value.")
    try:
        numeric = float(text_value.replace(",", ""))
    except (ValueError, TypeError) as exc:
        raise ValueError(f"{context}: {metric} has a non-numeric value.") from exc
    if not math.isfinite(numeric):
        raise ValueError(f"{context}: {metric} must be finite.")
    if metric != "AHT":
        if is_percent:
            numeric /= 100
        if not 0 <= numeric <= 1:
            raise ValueError(f"{context}: {metric} must be between 0% and 100%.")
    elif numeric < 0:
        raise ValueError(f"{context}: AHT cannot be negative.")
    return numeric


def parse_weekly_performance(values):
    """Resolve the ACTUAL and GOALS blocks by header and LOB, not row order."""
    expected = ("LOB",) + PERFORMANCE_FIELDS
    expected_keys = {_source_key(name): name for name in expected}
    markers = {}
    for i, row in enumerate(values):
        for cell in row:
            key = _source_key(cell)
            if key in ("actual", "goals"):
                if key in markers:
                    raise ValueError(f"BIDS has more than one {key.upper()} block.")
                markers[key] = i
    if set(markers) != {"actual", "goals"}:
        raise ValueError("BIDS must contain one ACTUAL block and one GOALS block.")
    if markers["actual"] >= markers["goals"]:
        raise ValueError("BIDS ACTUAL must appear before GOALS, as in the reference.")

    blocks, warnings = {}, []
    for section in ("actual", "goals"):
        limit = markers["goals"] if section == "actual" else len(values)
        header = None
        for index in range(markers[section] + 1, min(limit, markers[section] + 4)):
            keys = [_source_key(x) for x in values[index]]
            if set(expected_keys).issubset(keys):
                if any(keys.count(k) != 1 for k in expected_keys):
                    raise ValueError(f"BIDS {section.upper()} contains duplicate metric headers.")
                if header is not None:
                    raise ValueError(f"BIDS {section.upper()} has ambiguous headers.")
                header = (index, {name: keys.index(key) for key, name in expected_keys.items()})
        if header is None:
            raise ValueError(f"BIDS {section.upper()} headers must contain LOB, QUALITY, AHT, AFTR and MERCHANT SENTIMENT.")
        row_index, cols = header
        rows = {}
        for cells in values[row_index + 1:limit]:
            lob = str(cells[cols["LOB"]] if cols["LOB"] < len(cells) else "").strip().upper()
            if lob not in LOBS:
                continue
            if lob in rows:
                raise ValueError(f"BIDS {section.upper()} has duplicate {lob} rows.")
            row = {}
            for name in PERFORMANCE_FIELDS:
                cell = cells[cols[name]] if cols[name] < len(cells) else None
                row[name] = _weekly_number(cell, name, f"BIDS {section.upper()} {lob}")
                if row[name] is None:
                    warnings.append(f"BIDS {section.upper()} {lob} {name} is blank.")
            rows[lob] = row
        missing = [lob for lob in LOBS if lob not in rows]
        if missing:
            raise ValueError(f"BIDS {section.upper()} is missing LOB row(s): {', '.join(missing)}.")
        blocks[section] = rows
    return {"actual": blocks["actual"], "goals": blocks["goals"], "warnings": warnings}


def read_weekly_performance(sheets, spreadsheet_id, tab, gid):
    """Read the BIDS snapshot; resolve the selected tab from metadata."""
    meta = sheets.spreadsheets().get(spreadsheetId=spreadsheet_id,
        fields="sheets(properties(sheetId,title,gridProperties(rowCount,columnCount)))").execute(num_retries=3)
    properties = [x["properties"] for x in meta.get("sheets", [])]
    matching = [x for x in properties if x.get("sheetId") == gid] if gid is not None else []
    if not matching:
        matching = [x for x in properties if x.get("title") == tab]
    if len(matching) != 1:
        raise ValueError(f"Performance tab {tab!r} (gid {gid}) was not found uniquely.")
    sheet = matching[0]
    grid = sheet.get("gridProperties", {})
    rows, cols = int(grid.get("rowCount", 0)), int(grid.get("columnCount", 0))
    if rows < 14 or cols < 6:
        raise ValueError("The performance tab is too small to contain the expected ACTUAL and GOALS blocks.")
    end_col = min(cols, 26)
    a1 = f"'{sheet['title'].replace(chr(39), chr(39) * 2)}'!A1:{chr(64 + end_col)}{min(rows, 30)}"
    response = sheets.spreadsheets().values().get(spreadsheetId=spreadsheet_id, range=a1,
        valueRenderOption="UNFORMATTED_VALUE").execute(num_retries=3)
    result = parse_weekly_performance(response.get("values", []))
    result["sheet_title"] = sheet["title"]
    result["sheet_id"] = sheet.get("sheetId")
    return result


def attach_weekly_performance(model, weekly):
    for row in model["rows"]:
        row["weekly_actual"] = weekly["actual"][row["lob"]]
        row["weekly_goals"] = weekly["goals"][row["lob"]]
    model["warnings"].extend(weekly.get("warnings", []))
    return model


def backend_spreadsheet_id(value):
    """Preserve the exact case of an ID copied from the Google Sheets URL."""
    value = str(value or "").strip()
    match = re.match(r"^https://docs\.google\.com/spreadsheets/d/([A-Za-z0-9_-]+)(?:[/?#]|$)", value)
    if match:
        return match.group(1)
    if re.fullmatch(r"[A-Za-z0-9_-]{15,}", value):
        return value
    raise ValueError("Paste the original shared Google Sheets URL or its exact mixed-case ID.")


def _wfm_number(value, context, warnings, allow_negative=False):
    if value is None or (isinstance(value, str) and not value.strip()):
        return None
    if isinstance(value, bool):
        warnings.append(f"{context}: Boolean is not a number; left blank.")
        return None
    text = str(value).strip().replace("\u2212", "-")
    if not re.fullmatch(r"[+-]?(?:\d{1,3}(?:,\d{3})+|\d+)(?:\.\d+)?", text):
        warnings.append(f"{context}: not a valid numeric value; left blank.")
        return None
    number = float(text.replace(",", ""))
    if not math.isfinite(number) or (not allow_negative and number < 0):
        warnings.append(f"{context}: value is out of range; left blank.")
        return None
    return number


def parse_wfm_matrix(values):
    """Read B3:H14 from the pictured WFM tab and validate the labelled cells."""
    values = [list(row) for row in (values or [])]
    def cell(row, col):
        return values[row][col] if row < len(values) and col < len(values[row]) else ""
    headers = [cell(0, i) for i in range(7)]
    expected = ["LOB", "HEADCOUNT", "PLANNED HC", "W+1", "W+2", "W+3", "W+4"]
    # Do not use _source_key for W+ labels: it strips the sign and would
    # silently accept past-week headers such as W-1 as future capacity.
    names_match = [_source_key(x) for x in headers[:3]] == [_source_key(x) for x in expected[:3]]
    horizons_match = all(re.fullmatch(rf"W\s*\+\s*{i}", str(headers[i+2]).strip(), re.I)
                         for i in range(1, 5))
    if not names_match or not horizons_match:
        raise ValueError("WFM B3:H3 headers do not match the agreed staffing layout.")
    for row, col, label in ((7,0,"HIRING PROJECTION"), (7,1,"ATTRITION"),
                             (10,0,"PLANNED"), (10,1,"UNPLANNED")):
        if _source_key(cell(row,col)) != _source_key(label):
            raise ValueError(f"WFM is missing the expected {label} label.")
    warnings, rows = [], {}
    for r in range(1, 5):
        lob = str(cell(r,0)).strip().upper()
        if lob not in LOBS or lob in rows:
            raise ValueError("WFM must have one row each for CORE, PLUS, RETAIL and PREMIUM.")
        rows[lob] = {
            "headcount": _wfm_number(cell(r,1),f"WFM {lob} headcount",warnings),
            "planned_hc": _wfm_number(cell(r,2),f"WFM {lob} planned HC",warnings),
            "gaps": [_wfm_number(cell(r,3+i),f"WFM {lob} W+{i+1}",warnings,True)
                     for i in range(4)]}
    def display(value):
        return " ".join(str(value).split()) if value is not None else ""
    drivers = {"hiring_projection": display(cell(8,0)), "attrition": display(cell(8,1)),
               "planned_shrinkage": display(cell(11,0)), "unplanned_shrinkage": display(cell(11,1))}
    return {"rows": rows, "drivers": drivers, "warnings": warnings}


def read_wfm_snapshot(sheets, spreadsheet_id, tab):
    meta = sheets.spreadsheets().get(spreadsheetId=spreadsheet_id,
        fields="sheets(properties(sheetId,title,gridProperties(rowCount,columnCount)))").execute(num_retries=3)
    found = [x["properties"] for x in meta.get("sheets", []) if x["properties"].get("title") == tab]
    if len(found) != 1:
        raise ValueError(f"WFM tab {tab!r} was not found uniquely.")
    grid = found[0].get("gridProperties", {})
    if int(grid.get("rowCount",0)) < 14 or int(grid.get("columnCount",0)) < 8:
        raise ValueError("WFM tab is too small for the agreed B3:H14 layout.")
    escaped = tab.replace("'", "''")
    result = sheets.spreadsheets().values().get(spreadsheetId=spreadsheet_id,
        range=f"'{escaped}'!B3:H14",valueRenderOption="FORMATTED_VALUE").execute(num_retries=3)
    parsed = parse_wfm_matrix(result.get("values", []))
    parsed["sheet_title"] = tab
    parsed["sheet_id"] = found[0].get("sheetId")
    return parsed


def _wfm_fmt(value, signed=False):
    if not finite(value): return ""
    number = float(value)
    text = f"{number:,.4f}".rstrip("0").rstrip(".")
    if signed and number > 0: text = "+" + text
    return text


def wfm_summary(wfm):
    """Summarize observed gap inputs without inventing drivers or actions."""
    rows = (wfm or {}).get("rows", {})
    observations = [(v, lob, i) for lob, row in rows.items()
                    for i, v in enumerate(row.get("gaps", [])) if finite(v)]
    if not observations:
        return ""
    negative = [item for item in observations if item[0] < 0]
    value, lob, i = min(negative or observations, key=lambda item: item[0])
    gaps = rows[lob].get("gaps", [])
    start = gaps[0] if len(gaps) > 0 else None
    end = gaps[3] if len(gaps) > 3 else None
    # Do not hide a larger mid-horizon shortfall behind an improving endpoint.
    if value < 0 and i in (1, 2) and (not finite(start) or value < start) and (not finite(end) or value < end):
        return f"{lob} has a {_wfm_fmt(-value)} FTE capacity gap in W+{i+1}."
    if finite(start) and finite(end) and start < 0 and end < 0 and end > start:
        return f"{lob} gap narrows from {_wfm_fmt(-start)} to {_wfm_fmt(-end)} FTE by W+4."
    if finite(start) and finite(end) and start < 0 and end < 0 and end < start:
        return f"{lob} gap widens from {_wfm_fmt(-start)} to {_wfm_fmt(-end)} FTE by W+4."
    if finite(start) and finite(end) and start < 0 and end == 0:
        return f"{lob}'s {_wfm_fmt(-start)} FTE gap reaches balance in W+4."
    if finite(start) and finite(end) and start < 0 and end > 0:
        return (f"{lob}'s {_wfm_fmt(-start)} FTE gap in W+1 moves to "
                f"a {_wfm_fmt(end)} FTE surplus by W+4.")
    if value < 0:
        return f"{lob} has a {_wfm_fmt(-value)} FTE capacity gap in W+{i+1}."
    if value == 0:
        return f"{lob} is balanced in W+{i+1} among the reported gaps."
    return f"{lob} has a {_wfm_fmt(value)} FTE capacity surplus in W+{i+1}."


def weekly_metric_signal(field, actual, goal):
    if not finite(actual) or not finite(goal):
        return None
    return float(actual) <= float(goal) if field == "AHT" else float(actual) >= float(goal)


def prepare_source_headers(raw, reader):
    """Ignore retired fields, then apply the Reader's header normalization."""
    retired = {"company", "ssanames"}
    keep = [re.sub(r"[^a-z0-9]", "", str(column).casefold()) not in retired
            for column in raw.columns]
    return reader._v574_canonical_headers(raw.loc[:, keep].copy())


def load_embedded_reader():
    payload = zlib.decompress(base64.b64decode(READER_DATA, validate=True))
    if hashlib.sha256(payload).hexdigest() != READER_SHA256:
        raise RuntimeError("Embedded Whitepaper Reader integrity check failed.")
    # Execute only the verified Reader as an imported module, never as __main__.
    folder = Path(tempfile.mkdtemp(prefix="goib_reader_"))
    file = folder / "whitepaper_reader_v597.py"
    file.write_bytes(payload)
    module_name = "_goib_whitepaper_" + uuid.uuid4().hex
    spec = importlib.util.spec_from_file_location(module_name, str(file))
    module = importlib.util.module_from_spec(spec)
    sys.modules[module_name] = module
    try:
        spec.loader.exec_module(module)
    except Exception:
        sys.modules.pop(module_name, None)
        raise
    return module


def rgb(value):
    value = value.lstrip("#")
    return {k: int(value[i:i + 2], 16) / 255 for k, i in (("red", 0), ("green", 2), ("blue", 4))}


class Canvas:
    """One scene drives a native Google Slides batch and a local QA preview."""
    def __init__(self):
        self.nodes = []
        self.width = 1600
        self.height = 900

    def rect(self, x, y, w, h, fill=None, border=None, rounded=False):
        if w <= 0 or h <= 0:
            raise ValueError("Non-positive rectangle dimensions.")
        self.nodes.append(dict(kind="rect", x=x, y=y, w=w, h=h, fill=fill,
                               border=border, rounded=rounded))

    def text(self, text, x, y, w, h, size, color="ink", bold=False,
             align="left", manual=""):
        if w <= 0 or h <= 0:
            raise ValueError("Non-positive text dimensions.")
        self.nodes.append(dict(kind="text", text=str(text or ""), x=x, y=y, w=w,
                               h=h, size=size, color=color, bold=bold,
                               align=align, manual=manual))

    def line(self, x1, y1, x2, y2, color="line", width=1.5, dashed=False):
        self.nodes.append(dict(kind="line", x1=x1, y1=y1, x2=x2, y2=y2,
                               color=color, width=width, dashed=dashed))

    def dot(self, x, y, diameter, fill):
        self.nodes.append(dict(kind="dot", x=x-diameter/2, y=y-diameter/2,
                               w=diameter, h=diameter, fill=fill))

    def wave(self, x, y, w, h, fill):
        self.nodes.append(dict(kind="wave",x=x,y=y,w=w,h=h,fill=fill))


def reflow_for_16x10(canvas):
    """Use the extra height for spacing, keeping font sizes and widths intact."""
    anchors=((0,0),(183,183),(636,691),(646,701),(832,922),(844,944),(900,1000))
    def mapped(y):
        if y <= 0:
            return y
        for (a,b),(c,d) in zip(anchors,anchors[1:]):
            if y <= c:
                return b+(y-a)*(d-b)/(c-a)
        return y+100
    for n in canvas.nodes:
        if n["kind"] == "line":
            n["y1"],n["y2"] = mapped(n["y1"]),mapped(n["y2"])
        elif n["kind"] == "dot":
            n["y"] = mapped(n["y"]+n["h"]/2)-n["h"]/2
        else:
            y1,y2 = mapped(n["y"]),mapped(n["y"]+n["h"])
            n["y"],n["h"] = y1,y2-y1
    canvas.height = 1000
    return canvas


def panel(c, x, y, w, h, title, subtitle=""):
    # Google Slides' default rounded-rectangle radius is much larger than the
    # sample's subtle corners, so square panels preserve its clean geometry.
    c.rect(x, y, w, h, "white", "line")
    c.text(title, x+14, y+7, w-28, 34, 25, bold=True)
    if subtitle:
        c.text(subtitle, x+14, y+39, w-28, 20, 15, "muted")


def section_text(s, limit):
    s = " ".join(str(s or "").split())
    return s if len(s) <= limit else s[:max(0, limit-1)].rstrip() + "…"


def _font(size, bold=False):
    from PIL import ImageFont
    name = "DejaVuSans-Bold.ttf" if bold else "DejaVuSans.ttf"
    try:
        return ImageFont.truetype(name,max(1,round(size)))
    except OSError:
        fallback = "/usr/share/fonts/truetype/dejavu/"+name
        try:
            return ImageFont.truetype(fallback,max(1,round(size)))
        except OSError:
            return ImageFont.load_default()


def fit_short_text(text, width, size, bold=False):
    """Abbreviate a source label to the visible field; full value stays in audit."""
    value=" ".join(str(text or "").split())
    font=_font(size,bold)
    if font.getlength(value)<=width-8:
        return value
    while value and font.getlength(value.rstrip()+"…")>width-8:
        value=value[:-1]
    return value.rstrip()+"…" if value else "…"


def validate_scene(canvas):
    """Fail before creating a deck if visible preview text clips or overlaps."""
    boxes=[]
    for n in canvas.nodes:
        if n["kind"]!="text" or not n["text"]:
            continue
        font=_font(n["size"],n["bold"])
        left,top,right,bottom=font.getbbox(n["text"])
        tw,th=right-left,bottom-top
        if tw>n["w"]-2 or th>n["h"]:
            raise ValueError("A slide label will not fit its reserved area: " +
                             section_text(n["text"], 90))
        x=(n["x"]+(n["w"]-tw)/2 if n["align"]=="center" else
           n["x"]+n["w"]-tw-3 if n["align"]=="right" else n["x"]+3)
        y=n["y"]+(n["h"]-th)/2
        if x<0 or y<0 or x+tw>canvas.width or y+th>canvas.height:
            raise ValueError("A slide label would extend beyond the page.")
        boxes.append(((x,y,x+tw,y+th), n["text"]))
    for i,(a, a_text) in enumerate(boxes):
        for b, b_text in boxes[i+1:]:
            if min(a[2],b[2])>max(a[0],b[0]) and min(a[3],b[3])>max(a[1],b[1]):
                raise ValueError("Two generated slide labels would overlap: " +
                                 section_text(a_text, 65) + " / " + section_text(b_text, 65))
    return len(boxes)


def banner_insight(rows):
    """Build an evidence-led positive or constructive banner for this dataset.

    Smiley movement uses two completed Whitepaper weeks. Operational results
    use the current BIDS snapshot, which has no confirmed reporting-week field.
    No trend, goal attainment or cause is inferred without its own evidence.
    """
    labels = {"QUALITY": "Quality", "AHT": "AHT", "AFTR": "AFTR",
              "MERCHANT SENTIMENT": "Merchant Sentiment"}
    strengths = []
    for field in PERFORMANCE_FIELDS:
        met = [row for row in rows if weekly_metric_signal(
            field, row.get("weekly_actual", {}).get(field),
            row.get("weekly_goals", {}).get(field)) is True]
        if met:
            strengths.append({"field": field, "label": labels[field],
                              "lobs": [row["lob"] for row in met]})
    smiley_met = [row for row in rows if finite(row.get("rate")) and finite(row.get("target"))
                  and finite(row.get("responses")) and row["responses"] >= FORECAST_MIN_RESPONSES
                  and float(row["rate"]) >= float(row["target"])]
    if smiley_met:
        strengths.insert(0, {"field": "SMILEY", "label": "Smiley",
                             "lobs": [row["lob"] for row in smiley_met]})
    # Prefer broad goal attainment; ties keep the declared metric order.
    strengths.sort(key=lambda item: -len(item["lobs"]))

    def goal_sentence(item, supporting=False):
        count, label, names = len(item["lobs"]), item["label"], item["lobs"]
        source = "Whitepaper" if item["field"] == "SMILEY" else "current snapshot"
        prefix = "Whitepaper" if item["field"] == "SMILEY" else "Current snapshot"
        if supporting:
            if count == 1:
                return f"{prefix}: {names[0]} met its {label} goal."
            return f"{prefix}: {label} met goals in {count} LOBs."
        if count == len(LOBS) and set(names) == set(LOBS):
            return f"{label} meets goals across all four LOBs.", source
        if count == 1:
            return f"{names[0]} meets its {label} goal.", source
        return f"{label} meets goals in {count} LOBs.", source

    comparable = [row for row in rows if finite(row.get("rate")) and finite(row.get("previous_rate"))
                  and finite(row.get("responses")) and row["responses"] >= FORECAST_MIN_RESPONSES
                  and finite(row.get("previous_n")) and row["previous_n"] >= FORECAST_MIN_RESPONSES]
    gains = [row for row in comparable if round((float(row["rate"]) - float(row["previous_rate"])) * 100, 1) > 0]
    if gains:
        lead = max(gains, key=lambda row: float(row["rate"]) - float(row["previous_rate"]))
        change = (float(lead["rate"]) - float(lead["previous_rate"])) * 100
        if len(gains) == len(LOBS) and len(comparable) == len(LOBS):
            headline = f"Smiley improved across all four LOBs; {lead['lob']} led with a {change:.1f} pp gain."
        elif len(gains) > 1:
            headline = f"Smiley improved in {len(gains)} LOBs, led by {lead['lob']} at +{change:.1f} pp."
        elif change >= 2:
            headline = f"A {change:.1f} pp Smiley lift brings {lead['lob']} to {pct(lead['rate'])}."
        else:
            headline = f"{lead['lob']} Smiley rose {change:.1f} pp to {pct(lead['rate'])} week over week."
        if strengths:
            support = goal_sentence(strengths[0], supporting=True)
        else:
            support = (f"Week-over-week comparison: {small_number(lead['responses'])} current and "
                       f"{small_number(lead['previous_n'])} previous responses.")
        return {"status": "MOMENTUM", "headline": headline, "support": support, "fill": "pale",
                "evidence": {"kind": "smiley_improvement", "source": "Whitepaper", "lob": lead["lob"],
                             "current_rate": float(lead["rate"]), "previous_rate": float(lead["previous_rate"]),
                             "current_responses": float(lead["responses"]), "previous_responses": float(lead["previous_n"]),
                             "improving_lobs": [row["lob"] for row in gains]}}

    if strengths:
        strength = strengths[0]
        headline, source = goal_sentence(strength)
        support = goal_sentence(strengths[1], supporting=True) if len(strengths) > 1 else \
                  ("Based on the current operational snapshot." if source == "current snapshot" else
                   "Based on the completed week's Whitepaper results.")
        return {"status": "STRENGTH", "headline": headline, "support": support, "fill": "pale",
                "evidence": {"kind": "goal_attainment", "source": source, "metric": strength["field"],
                             "lobs": strength["lobs"]}}

    reasons = []
    for row in rows:
        reason = row.get("reason", {})
        count, total = reason.get("count"), reason.get("total")
        if (reason.get("status") == "available" and str(reason.get("label") or "").strip()
                and finite(row.get("responses")) and row["responses"] >= FORECAST_MIN_RESPONSES
                and finite(count) and finite(total) and 0 < float(count) <= float(total)):
            reasons.append(row)
    if reasons:
        row = max(reasons, key=lambda item: float(item["reason"]["count"]))
        reason = row["reason"]
        name = fit_short_text(section_text(reason["label"], 55), 600, 28, True)
        headline = f"{row['lob']} merchant feedback highlights {name} for review."
        support = (f"Leading classified non-Smiley reason: {small_number(reason['count'])} of "
                   f"{small_number(reason['total'])} non-Smiley responses.")
        return {"status": "FOCUS", "headline": headline, "support": support, "fill": "pale",
                "evidence": {"kind": "classified_reason", "source": "Whitepaper", "lob": row["lob"],
                             "reason": reason["label"], "count": float(reason["count"]),
                             "non_smiley_responses": float(reason["total"])}}

    reported = [row for row in rows if finite(row.get("rate"))]
    if reported:
        leader = max(reported, key=lambda row: float(row["rate"]))
        if finite(leader.get("responses")) and leader["responses"] >= FORECAST_MIN_RESPONSES:
            if len(reported) > 1:
                headline = f"{leader['lob']} leads reported Smiley results at {pct(leader['rate'])}."
            else:
                headline = f"{leader['lob']} Smiley stands at {pct(leader['rate'])}."
            return {"status": "FOCUS", "headline": headline,
                    "support": "Review merchant feedback for opportunities to strengthen the experience.",
                    "fill": "pale", "evidence": {"kind": "reported_smiley", "source": "Whitepaper",
                    "lob": leader["lob"], "rate": float(leader["rate"]), "reported_lobs": len(reported)}}
    return {"status": "REVIEW", "headline": "Review current results to identify the next opportunity.",
            "support": "", "fill": "pale", "evidence": {"kind": "insufficient_supported_evidence"}}


def banner_text(rows):
    insight = banner_insight(rows)
    return insight["status"], insight["headline"], insight["support"], insight["fill"]


def merchant_focus(rows):
    """Pick one LOB for both callouts; leave an unavailable callout blank."""
    def has_reason(row):
        reason = row.get("reason", {})
        return (reason.get("status") == "available" and reason.get("label")
                and (reason.get("count") or 0) > 0)
    improvements = [row for row in rows if finite(row.get("rate")) and finite(row.get("previous_rate"))
                    and (row.get("responses") or 0) >= FORECAST_MIN_RESPONSES
                    and (row.get("previous_n") or 0) >= FORECAST_MIN_RESPONSES
                    and row["rate"] > row["previous_rate"]]
    paired = [row for row in improvements if has_reason(row)]
    if paired or improvements:
        row = max(paired or improvements, key=lambda item: item["rate"] - item["previous_rate"])
        return row, True, bool(has_reason(row))
    reasons = [row for row in rows if has_reason(row)]
    if reasons:
        return max(reasons, key=lambda item: item["reason"]["count"]), False, True
    return None, False, False


def select_priority_lob(model, override=None):
    """Choose a review focus from available evidence, never an invented score.

    This is a transparent triage aid, not a claim that an unavailable staffing,
    security, or business-impact signal was assessed.
    """
    requested = str(PRIORITY_LOB_OVERRIDE if override is None else override).strip().upper()
    if requested and requested not in LOBS:
        raise ValueError("PRIORITY_LOB_OVERRIDE must be CORE, PLUS, RETAIL or PREMIUM.")
    rows = model["rows"]
    if requested:
        row = next((r for r in rows if r["lob"] == requested), None)
        if row is None:
            raise ValueError("The manually selected priority LOB is not in the model.")
        return {"row": row, "lob": requested, "method": "manual",
                "basis": "Manually selected; review supporting evidence.",
                "limitations": "Staffing and other manual inputs are not evaluated."}

    candidates = [r for r in rows if finite(r.get("rate"))
                  and finite(r.get("responses")) and r["responses"] >= FORECAST_MIN_RESPONSES]
    if not candidates:
        return {"row": None, "lob": None, "method": "unavailable",
                "basis": "No LOB has a sufficiently sized Smiley sample.",
                "limitations": "Set an override after review or supply eligible survey data."}

    def signals(row):
        by_week = {h["week"]: h for h in row.get("history", []) if isinstance(h.get("week"), date)}
        recent = [by_week.get(model["week_start"] - timedelta(days=7*i)) for i in (2, 1, 0)]
        adequate = all(h and finite(h.get("rate")) and finite(h.get("n")) and
                       h["n"] >= FORECAST_MIN_RESPONSES for h in recent)
        sustained = bool(adequate and recent[0]["rate"] > recent[1]["rate"] > recent[2]["rate"]
                         and recent[0]["rate"] - recent[2]["rate"] >= .01)
        gap = max(0.0, float(row["target"]) - float(row["rate"])) if finite(row.get("target")) else 0.0
        previous_ok = finite(row.get("previous_rate")) and finite(row.get("previous_n")) and row["previous_n"] >= FORECAST_MIN_RESPONSES
        decline = max(0.0, float(row["previous_rate"]) - float(row["rate"])) if previous_ok else 0.0
        checks = [weekly_metric_signal(f, row.get("weekly_actual", {}).get(f),
                                       row.get("weekly_goals", {}).get(f)) for f in PERFORMANCE_FIELDS]
        missed = sum(result is False for result in checks)
        return sustained, gap, missed, decline, sum(result is not None for result in checks)
    # Ordering is deliberately lexicographic and disclosed: sustained decline,
    # then Smiley target gap, then operational goal misses, then weekly decline.
    # WSLT is an undated snapshot. Missing goals are never counted as misses.
    ordered = sorted(candidates, key=lambda r: (
        -int(signals(r)[0]), -signals(r)[1], -signals(r)[2], -signals(r)[3],
        float(r["rate"]), -float(r["responses"]), LOBS.index(r["lob"])))
    selected = ordered[0]
    sustained, gap, missed, decline, evaluated = signals(selected)
    return {"row": selected, "lob": selected["lob"], "method": "automatic",
            "basis": ("Selected from Smiley and the current operational snapshot." if evaluated
                      else "Selected from available Whitepaper Smiley signals."),
            "signals": {"sustained_decline": sustained, "smiley_target_gap_pp": gap*100,
                        "operational_goals_missed": missed, "operational_goals_evaluated": evaluated,
                        "weekly_decline_pp": decline*100},
            "limitations": "BIDS has no confirmed week field; staffing and other manual inputs are not evaluated."}


def _move_node_y(node, delta):
    if node["kind"] == "line":
        node["y1"] += delta
        node["y2"] += delta
    else:
        node["y"] += delta


