                         "status":wfm.get("status","available"),"summary":wfm_summary(wfm),
                         "warnings":wfm.get("warnings",[]),"data":wfm.get("rows",{}),
                         "drivers":wfm.get("drivers",{}),
                         "period_alignment":"Source snapshot has no supplied week field; alignment is unverified."},
           "source_contract":"Pre-cleaned single-company source; Company and SSA Name(s) ignored; channel, LOB and team rules retained.",
           "data_completeness":"Latest source date is a freshness check, not proof of complete ingestion.",
           "raw_rows":len(raw),"normalized_rows":len(normalized),"warnings":model["warnings"],
           "presentation_url":result["url"],
           "forecast_monitoring":monitoring,"forecast_snapshot":snapshot,"prophet":prophet_status,
           "arima":arima_status,"forecast_requested_mode":FORECAST_MODEL_MODE,
           "banner_insight":banner_insight(model["rows"]),
           "priority_lob":result["priority"],
           "what_if":model["what_if"],
           "lob_metrics":[{**{k:v for k,v in row.items() if k not in ("history",)},
                           "w4_target_signal":forecast_target_signal(row)} for row in model["rows"]]}
    audit_file=out/"operations_brief_audit.json"
    audit_text=json.dumps(audit,default=_json_default,indent=2)
    audit_file.write_text(audit_text,encoding="utf-8")
    archived_audit=out/f"operations_brief_audit_{start:%Y%m%d}_{uuid.uuid4().hex[:8]}.json"
    archived_audit.write_text(audit_text,encoding="utf-8")
    print("Audit and exports:")
    for path in [str(audit_file),str(archived_audit),*result["exports"]]:
        print(" ",path)
    print("Open the new Google Slides link above. Complete the blank contributor and decision fields; check the WFM summary and audit.")
    return result


