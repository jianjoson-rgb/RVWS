def _dimension_points(dimension):
    unit = dimension.get("unit")
    value = float(dimension["magnitude"])
    if unit == "PT":
        return value
    if unit == "EMU":
        return value/12700
    raise ValueError(f"Unsupported Google Slides dimension unit: {unit!r}")


def verify_presentation(resource, slide_id, expected, manual_ids):
    slides = resource.get("slides", [])
    if len(slides) != 1 or slides[0].get("objectId") != slide_id:
        raise RuntimeError("The generated presentation does not contain exactly the expected slide.")
    elements = {x["objectId"]: x for x in slides[0].get("pageElements", [])}
    missing = [oid for oid in list(expected)+manual_ids if oid not in elements]
    if missing:
        raise RuntimeError(f"The presentation is missing {len(missing)} expected editable text boxes.")
    for oid, text in expected.items():
        runs = elements[oid].get("shape", {}).get("text", {}).get("textElements", [])
        actual = "".join(e.get("textRun", {}).get("content", "") for e in runs).rstrip("\n")
        if actual != text:
            raise RuntimeError(f"A generated text box did not verify correctly ({oid}).")
    for oid in manual_ids:
        shape=elements[oid].get("shape")
        if shape is None:
            raise RuntimeError("A manual-entry field is not an editable shape.")
        runs=shape.get("text",{}).get("textElements",[])
        if "".join(e.get("textRun",{}).get("content","") for e in runs).strip():
            raise RuntimeError("A manual-entry field was unexpectedly populated.")
    return len(elements)


def verify_two_slides(resource, slide_ids, expected_by_slide):
    pages = resource.get("slides", [])
    if len(pages) != 2 or [page.get("objectId") for page in pages] != list(slide_ids):
        raise RuntimeError("The generated presentation does not contain exactly the two expected slides.")
    counts = []
    for page, slide_id in zip(pages, slide_ids):
        expected, manual_ids = expected_by_slide[slide_id]
        elements = {x["objectId"]: x for x in page.get("pageElements", [])}
        missing = [oid for oid in list(expected)+manual_ids if oid not in elements]
        if missing:
            raise RuntimeError(f"Slide {slide_id} is missing {len(missing)} editable text boxes.")
        for oid, text in expected.items():
            runs = elements[oid].get("shape", {}).get("text", {}).get("textElements", [])
            actual = "".join(e.get("textRun", {}).get("content", "") for e in runs).rstrip("\n")
            if actual != text:
                raise RuntimeError(f"A generated text box did not verify correctly ({oid}).")
        for oid in manual_ids:
            shape = elements[oid].get("shape")
            if shape is None:
                raise RuntimeError("A manual-entry field is not an editable shape.")
            runs = shape.get("text", {}).get("textElements", [])
            if "".join(e.get("textRun", {}).get("content", "") for e in runs).strip():
                raise RuntimeError("A manual-entry field was unexpectedly populated.")
        counts.append(len(elements))
    return counts


def export_files(drive, slides, presentation_id, slide_ids, output_dir):
    output_dir.mkdir(parents=True, exist_ok=True)
    files=[]
    if EXPORT_PDF_AND_PPTX:
        choices=(("pdf","application/pdf"),
                 ("pptx","application/vnd.openxmlformats-officedocument.presentationml.presentation"))
        for suffix,mime in choices:
            path=output_dir/f"operations_brief.{suffix}"
            try:
                data=drive.files().export(fileId=presentation_id,mimeType=mime).execute(num_retries=3)
                path.write_bytes(data)
                files.append(str(path))
            except Exception as exc:
                print(f"Export {suffix.upper()} did not complete: {type(exc).__name__}: {exc}")
    if EXPORT_PNG:
        for index, slide_id in enumerate(slide_ids, start=1):
          try:
            from urllib.request import urlopen
            thumb=slides.presentations().pages().getThumbnail(presentationId=presentation_id,
                pageObjectId=slide_id, thumbnailProperties_mimeType="PNG",
                thumbnailProperties_thumbnailSize="LARGE").execute(num_retries=3)
            # A short-lived image URL comes from Google's authenticated API;
            # do not print it or share it. It is fetched once into the output.
            with urlopen(thumb["contentUrl"], timeout=30) as response:
                data=response.read(20_000_001)
            if len(data)>20_000_000 or not data.startswith(b"\x89PNG\r\n\x1a\n"):
                raise ValueError("Unexpected or oversized thumbnail response.")
            path=output_dir/("operations_brief.png" if index == 1 else f"operations_brief_slide_{index}.png")
            path.write_bytes(data)
            files.append(str(path))
          except Exception as exc:
            print(f"Slide {index} PNG preview did not complete: {type(exc).__name__}: {exc}")
    return files


def create_sized_presentation(slides, drive, title, aspect):
    """Create a native file; a checked blank PPTX seeds 16:10 page dimensions."""
    if aspect == "16:9":
        return slides.presentations().create(body={"title":title}).execute(num_retries=0)["presentationId"]
    if aspect != "16:10":
        raise ValueError("SLIDE_ASPECT must be '16:10' or '16:9'.")
    payload=zlib.decompress(base64.b64decode(TEMPLATE_16X10_DATA,validate=True))
    if hashlib.sha256(payload).hexdigest()!=TEMPLATE_16X10_SHA256 or not payload.startswith(b"PK\x03\x04"):
        raise RuntimeError("The embedded blank 16:10 presentation failed its integrity check.")
    from googleapiclient.http import MediaIoBaseUpload
    media=MediaIoBaseUpload(io.BytesIO(payload),
        mimetype="application/vnd.openxmlformats-officedocument.presentationml.presentation",resumable=False)
    result=drive.files().create(body={"name":title,"mimeType":"application/vnd.google-apps.presentation"},
                                media_body=media,fields="id,mimeType").execute(num_retries=0)
    if result.get("mimeType")!="application/vnd.google-apps.presentation" or not result.get("id"):
        raise RuntimeError("Google Drive did not confirm creation of a native Google Slides presentation.")
    return result["id"]


def create_slides(slides, drive, model):
    """Create exactly two fresh, editable slides without altering a source file."""
    title=f"{OUTPUT_TITLE} | {model['week_start']:%d %b %Y}"
    priority = select_priority_lob(model)
    canvases=[compose_executive_scene(model), compose_detail_scene(model, priority)]
    # Check visible text geometry and build first, before creating an external file.
    checked_labels=[validate_scene(canvas) for canvas in canvases]
    print(f"Layout preflight: {sum(checked_labels)} visible labels fit across two slides.")
    desired_ratio = 16/10 if SLIDE_ASPECT == "16:10" else 16/9
    for i, canvas in enumerate(canvases):
        scene_requests(canvas,f"goib_validation_slide_{i}",720,450 if SLIDE_ASPECT == "16:10" else 405)
    pid=create_sized_presentation(slides,drive,title,SLIDE_ASPECT)
    link=f"https://docs.google.com/presentation/d/{pid}/edit"
    print("NEW GOOGLE SLIDES:",link,flush=True)
    try:
        resource=slides.presentations().get(presentationId=pid).execute(num_retries=3)
        width=_dimension_points(resource["pageSize"]["width"])
        height=_dimension_points(resource["pageSize"]["height"])
        if abs(width/height-desired_ratio)>0.002:
            raise ValueError(f"Google returned {width:.1f} × {height:.1f} pt, not {SLIDE_ASPECT}. No slide elements were written.")
        existing=resource.get("slides",[])
        if SLIDE_ASPECT == "16:10" and existing:
            # Only the freshly created, blank conversion is altered.
            slide_id=existing[0]["objectId"]
            requests=[{"deleteObject":{"objectId":e["objectId"]}} for e in existing[0].get("pageElements",[])]
            requests.extend({"deleteObject":{"objectId":p["objectId"]}} for p in existing[1:])
        else:
            slide_id="goib_slide_"+uuid.uuid4().hex[:12]
            requests=[{"deleteObject":{"objectId":p["objectId"]}} for p in existing]
            requests.append({"createSlide":{"objectId":slide_id,"slideLayoutReference":{"predefinedLayout":"BLANK"}}})
        second_slide_id = "goib_slide_" + uuid.uuid4().hex[:12]
        requests.append({"createSlide":{"objectId":second_slide_id,
                                        "slideLayoutReference":{"predefinedLayout":"BLANK"}}})
        slide_ids = [slide_id, second_slide_id]
        expected_by_slide = {}
        for canvas, page_id in zip(canvases, slide_ids):
            body, expected, manual = scene_requests(canvas, page_id, width, height)
            expected_by_slide[page_id] = (expected, manual)
            requests.extend(body)
        for i in range(0,len(requests),180):
            slides.presentations().batchUpdate(presentationId=pid,body={"requests":requests[i:i+180]}).execute(num_retries=0)
            print(f"Built native slide elements: request {min(i+180,len(requests)):,} / {len(requests):,}")
        result=slides.presentations().get(presentationId=pid).execute(num_retries=3)
        got_width=_dimension_points(result["pageSize"]["width"])
        got_height=_dimension_points(result["pageSize"]["height"])
        if abs(got_width/got_height-desired_ratio)>0.002:
            raise RuntimeError("The output page aspect ratio changed during generation.")
        counts=verify_two_slides(result,slide_ids,expected_by_slide)
        manual_count=sum(len(manual) for _,manual in expected_by_slide.values())
        print(f"Verified two slides with {sum(counts)} editable elements, including {manual_count} blank manual fields.")
    except Exception:
        print("The new presentation may be incomplete. Inspect or delete this new file before rerunning:",link,flush=True)
        raise
    exports=export_files(drive,slides,pid,slide_ids,Path(OUTPUT_DIRECTORY))
    return {"presentation_id":pid,"url":link,"slide_id":slide_id,"slide_ids":slide_ids,"aspect":SLIDE_ASPECT,
            "elements":sum(counts),"elements_by_slide":counts,"manual_fields":manual_count,"exports":exports,
            "priority":{k:v for k,v in priority.items() if k != "row"}}


def _json_default(value):
    if isinstance(value,(date,datetime)):
        return value.isoformat()
    raise TypeError(f"Unsupported audit value: {type(value).__name__}")


def forecast_source_key(source_id, tab):
    """Separate tracking cohorts without storing the source ID in a slide."""
    contract = "\0".join((source_id, tab, READER_SHA256, "Reporting Date", REPORT_TIMEZONE))
    return hashlib.sha256(contract.encode("utf-8")).hexdigest()[:24]


def forecast_snapshot_properties(model, source_key, issued_at=None):
    """Pack aggregate forecasts in private metadata on the new presentation."""
    issued = issued_at or datetime.now(ZoneInfo(REPORT_TIMEZONE))
    if issued.tzinfo is None:
        raise ValueError("Snapshot issue time must include a timezone.")
    props = {"gob_schema": "1", "gob_source": source_key,
             "gob_week": model["week_start"].isoformat(), "gob_issued": issued.isoformat()}
    for row in model["rows"]:
        forecast = row.get("forecast", {})
        values = forecast.get("values", [])
        if forecast.get("available") and len(values) == 4 and all(finite(v) and 0 <= float(v) <= 1 for v in values):
            props["gob_" + row["lob"].lower()] = json.dumps(
                {"v": [round(float(v), 8) for v in values], "m": str(forecast.get("method", ""))},
                separators=(",", ":"))
    for key, value in props.items():
        if len((key + value).encode("utf-8")) > 124:
            raise ValueError("Forecast snapshot property exceeds Google Drive's metadata limit.")
    return props


def list_forecast_snapshots(drive, source_key):
    """Read prior generated decks visible to this app; do not read source Sheets."""
    query = ("trashed = false and mimeType = 'application/vnd.google-apps.presentation' "
             "and appProperties has { key='gob_schema' and value='1' } "
             f"and appProperties has {{ key='gob_source' and value='{source_key}' }}")
    files, token, seen = [], None, set()
    while True:
        params = {"q": query, "pageSize": 100,
                  "fields": "nextPageToken,incompleteSearch,files(id,createdTime,appProperties)"}
        if token:
            params["pageToken"] = token
        page = drive.files().list(**params).execute(num_retries=3)
        if page.get("incompleteSearch"):
            raise RuntimeError("Google Drive reported an incomplete forecast-history search.")
        files.extend(page.get("files", []))
        if len(files) > 10000:
            raise RuntimeError("Forecast history exceeds the 10,000-deck safety limit.")
        token = page.get("nextPageToken")
        if not token:
            break
        if token in seen:
            raise RuntimeError("Google Drive repeated a forecast-history page token.")
        seen.add(token)
    return files


def _parse_timestamp(value):
    stamp = datetime.fromisoformat(str(value).replace("Z", "+00:00"))
    if stamp.tzinfo is None:
        raise ValueError("Forecast issue time has no timezone.")
    return stamp


def evaluate_forecast_snapshots(files, model, source_key):
    """Score the earliest timely forecast for each origin/LOB/horizon.

    A forecast must be recorded before its target week starts in the reporting
    timezone. Actuals are read from the latest source and can later be revised.
    """
    histories = {row["lob"]: {v["week"]: v for v in row.get("history", [])}
                 for row in model["rows"]}
    chosen = {}
    skipped_late = invalid = 0
    zone = ZoneInfo(REPORT_TIMEZONE)
    for file in files:
        props = file.get("appProperties") or {}
        if props.get("gob_schema") != "1" or props.get("gob_source") != source_key:
            continue
        try:
            origin = date.fromisoformat(props["gob_week"])
            issued = _parse_timestamp(props["gob_issued"])
            created = _parse_timestamp(file["createdTime"])
            issued = max(issued, created)
            if origin.weekday() != 6:
                raise ValueError("Origin is not a Sunday.")
        except (ValueError, TypeError, KeyError):
            invalid += 1
            continue
        if origin > model["week_start"]:
            continue
        for lob in LOBS:
            raw = props.get("gob_" + lob.lower())
            if raw is None:
                continue
            try:
                item = json.loads(raw)
                values = item["v"]
                if not isinstance(values, list) or len(values) != 4 or not all(
                        finite(v) and 0 <= float(v) <= 1 for v in values):
                    raise ValueError("Invalid forecast values.")
            except (ValueError, TypeError, KeyError, json.JSONDecodeError):
                invalid += 1
                continue
            for horizon, value in enumerate(values, start=1):
                target_week = origin + timedelta(days=7 * horizon)
                if target_week > model["week_start"]:
                    continue
                if model.get("source_partial") and target_week == model["week_start"]:
                    continue  # Do not score an incomplete current reporting week as final.
                actual = histories.get(lob, {}).get(target_week)
                if not actual or not finite(actual.get("n")) or actual["n"] < FORECAST_MIN_RESPONSES \
                        or not finite(actual.get("rate")):
                    continue
                target_open = datetime.combine(target_week, datetime.min.time(), tzinfo=zone)
                if issued >= target_open:
                    skipped_late += 1
                    continue
                key = (origin, lob, horizon)
                candidate = {"origin_week": origin, "target_week": target_week, "lob": lob,
                             "horizon": horizon, "issued_at": issued, "forecast": float(value),
                             "actual": float(actual["rate"]), "responses": float(actual["n"]),
                             "method": str(item.get("m", "")), "presentation_id": str(file.get("id", ""))}
                existing = chosen.get(key)
                if existing is None or (issued, candidate["presentation_id"]) < (existing["issued_at"], existing["presentation_id"]):
                    chosen[key] = candidate
    records = sorted(chosen.values(), key=lambda r: (r["target_week"], r["lob"], r["horizon"]))
    for record in records:
        record["error_pp"] = 100 * (record["forecast"] - record["actual"])
    by_lob = {}
    for lob in LOBS:
        by_lob[lob] = {}
        for horizon in (1, 2, 3, 4):
            errors = [r["error_pp"] for r in records if r["lob"] == lob and r["horizon"] == horizon]
            by_lob[lob][str(horizon)] = {"observations": len(errors),
                                         "mae_pp": sum(abs(e) for e in errors) / len(errors) if errors else None,
                                         "bias_pp": sum(errors) / len(errors) if errors else None}
    return {"status": "ok", "snapshot_decks": len(files), "matched_forecasts": len(records),
            "skipped_late": skipped_late, "invalid_snapshots": invalid, "by_lob": by_lob,
            "records": records,
            "note": "Only forecasts recorded before the target week are scored; positive bias means optimistic. Actuals use the latest source and may be revised."}


def save_forecast_snapshot(drive, presentation_id, model, source_key):
    """Store the issued forecast on this new deck; never create a Sheet or tab."""
    props = forecast_snapshot_properties(model, source_key)
    count = sum("gob_" + lob.lower() in props for lob in LOBS)
    if not count:
        return {"status": "no_forecast", "lob_count": 0}
    try:
        result = drive.files().update(fileId=presentation_id, body={"appProperties": props},
                                      fields="id,appProperties").execute(num_retries=0)
        saved = result.get("appProperties", {})
        if result.get("id") != presentation_id or any(saved.get(k) != v for k, v in props.items()):
            raise RuntimeError("Google did not return the complete saved forecast metadata.")
        return {"status": "saved", "lob_count": count, "issued_at": props["gob_issued"]}
    except Exception as exc:
        # A timeout may have committed. Do not retry a non-idempotent operation.
        return {"status": "unconfirmed", "lob_count": count,
                "reason": f"{type(exc).__name__}: {exc}"}


