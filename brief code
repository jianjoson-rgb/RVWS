def finite(v):
    try:
        return v is not None and math.isfinite(float(v))
    except (TypeError, ValueError):
        return False


def num(v):
    return float(v) if finite(v) else None


def pct(v, places=1):
    return f"{100 * float(v):.{places}f}%" if finite(v) else ""


def small_number(v):
    if not finite(v):
        return ""
    v = float(v)
    return f"{v:,.0f}" if abs(v - round(v)) < 1e-8 else f"{v:,.1f}"


def last_completed_sunday(today):
    """Return last fully completed Sunday–Saturday in the reporting timezone."""
    return today - timedelta(days=(today.weekday() + 1) % 7 + 7)


def resolve_week(as_of=None, requested=""):
    today = as_of or datetime.now(ZoneInfo(REPORT_TIMEZONE)).date()
    if requested:
        try:
            start = date.fromisoformat(requested)
        except ValueError as exc:
            raise ValueError("REPORT_WEEK_START must be YYYY-MM-DD.") from exc
        if start.weekday() != 6:
            raise ValueError("REPORT_WEEK_START must be a Sunday.")
    else:
        start = last_completed_sunday(today)
    end = start + timedelta(days=6)
    if end >= today:
        raise ValueError("The requested Sunday–Saturday week has not completed in the reporting timezone.")
    return start, end


def _candidate_forecast(history, mode, horizon):
    """Forecast a rate from only history available at an origin."""
    if mode == "last_week":
        return float(history[-1]["rate"])
    if mode == "pooled_4w":
        tail = history[-4:]
        denominator = sum(x["n"] for x in tail)
        return sum(x["p"] for x in tail) / denominator
    if mode in ("weighted_smoothing", "blend_50"):
        if not 0 < FORECAST_RECENCY_DECAY < 1:
            raise ValueError("FORECAST_RECENCY_DECAY must be between 0 and 1.")
        weighted = [(FORECAST_RECENCY_DECAY ** i, item)
                    for i, item in enumerate(reversed(history))]
        smoothed = sum(weight * item["p"] for weight, item in weighted) / \
                   sum(weight * item["n"] for weight, item in weighted)
        return smoothed if mode == "weighted_smoothing" else (smoothed + float(history[-1]["rate"])) / 2
    raise ValueError("Unknown forecasting candidate: " + str(mode))


