def forecast_dependency_self_test():
    """Exercise real model packages on synthetic weeks without touching Google data."""
    arima_class, arima_status = load_arima()
    prophet_class, prophet_status = load_prophet()
    print("ARIMA package:", arima_status)
    print("Prophet package:", prophet_status)
    end = date(2026,10,18)
    history = []
    for i in range(22):
        rate = 0.76 + 0.0014*i + 0.014*math.sin(0.8*i) + 0.004*math.sin(1.7*i)
        history.append({"week": end-timedelta(days=7*(21-i)), "n": 800,
                        "p": rate*800, "rate": rate})
    forecast = forecast_weekly(history, end, prophet_class=prophet_class,
                               arima_class=arima_class, selection_mode="ARIMA_PROPHET")
    if not forecast.get("available") or forecast.get("fallback_used"):
        reason = forecast.get("fallback_reason") or forecast.get("reason") or "unknown"
        details = forecast.get("candidate_warning") or "; ".join(forecast.get("fallback_attempt_warnings", []))
        raise RuntimeError("Primary ARIMA + Prophet synthetic diagnostic did not complete: " + reason +
                           (" Details: " + details if details else ""))
    print("PASS: ARIMA + Prophet executed on synthetic data; no Google data or slides were used.")
    print("Order:", tuple(forecast["arima_order"]), "ARIMA blend:", ARIMA_BLEND_WEIGHT,
          "smoothing alpha:", FORECAST_SMOOTHING_ALPHA)
    print("W+1–W+4:", ", ".join(f"{v*100:.3f}%" for v in forecast["values"]))
    print(f"Guard MAE: {forecast['holdout_mae_pp']:.3f} pp; "
          f"last-week guard MAE: {forecast['baseline_holdout_mae_pp']:.3f} pp.")
    if forecast.get("method_warning"):
        print("WARNING:",forecast["method_warning"])
    print("Synthetic diagnostics do not establish accuracy on the account's actual data.")
    return forecast


def main(argv=None):
    parser=argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--self-test",action="store_true",help="offline checks and synthetic preview")
    args=parser.parse_args(argv)
    if args.self_test:
        return self_test()
    if FORECAST_TEST_ONLY:
        return forecast_dependency_self_test()
    return run()


