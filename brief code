import pandas as pd
import numpy as np

# Load EMBRData2.1.xlsx
xls = pd.ExcelFile('EMBRData2.1.xlsx')
raw_embr = pd.read_excel(xls, sheet_name='Export', header=None)

records = []
current_dt = None
for c in range(2, raw_embr.shape[1]):
    val_dt = raw_embr.iloc[0, c]
    if pd.notna(val_dt):
        current_dt = pd.to_datetime(val_dt)
    metric = str(raw_embr.iloc[1, c]).strip()
    for r in range(2, raw_embr.shape[0]):
        lob = str(raw_embr.iloc[r, 0]).strip()
        site = str(raw_embr.iloc[r, 1]).strip() if pd.notna(raw_embr.iloc[r, 1]) else 'All_Total'
        val = pd.to_numeric(raw_embr.iloc[r, c], errors='coerce')
        records.append((current_dt, lob, site, metric, 0.0 if pd.isna(val) else val))

df_long = pd.DataFrame(records, columns=['Date', 'LOB', 'Site', 'Metric', 'Value'])
embr = df_long.pivot_table(index=['Date', 'LOB', 'Site'], columns='Metric', values='Value', aggfunc='sum').reset_index()
embr['Month'] = embr['Date'].dt.to_period('M').astype(str)
embr['Week'] = embr['Date'].dt.to_period('W-SAT').apply(lambda r: r.start_time.strftime('%Y-%m-%d'))

# Verify if sum of sites == Total for each LOB
for lob in ['CORE', 'PLUS', 'PREMIUM']:
    sub_sites = embr[(embr['LOB']==lob) & (embr['Site']!='Total')].groupby('Month')[['HANDLED TICKET', 'SMILEY CT', 'FROWNIE CT', 'NEUTRRAL CT', 'RESPONSE CT']].sum()
    tot_row = embr[(embr['LOB']==lob) & (embr['Site']=='Total')].groupby('Month')[['HANDLED TICKET', 'SMILEY CT', 'FROWNIE CT', 'NEUTRRAL CT', 'RESPONSE CT']].sum()
    diff = (tot_row - sub_sites).abs().max().max()
    print(f"LOB {lob} max diff between Total row and sum of sites: {diff}")

# Print Monthly summary (Sept, Oct, Nov) from EMBRData2.1.xlsx for each LOB Total & Site!
lob_totals = embr[((embr['LOB'].isin(['CORE', 'PLUS', 'PREMIUM'])) & (embr['Site']=='Total')) | (embr['LOB']=='RETAIL') | (embr['LOB']=='Total')].copy()
m_sum = lob_totals.groupby(['LOB', 'Month'])[['HANDLED TICKET', 'SMILEY CT', 'NEUTRRAL CT', 'FROWNIE CT', 'RESPONSE CT']].sum()
m_sum['Smiley_%'] = m_sum['SMILEY CT'] / m_sum['RESPONSE CT'] * 100
m_sum['Neutral_%'] = m_sum['NEUTRRAL CT'] / m_sum['RESPONSE CT'] * 100
m_sum['Frownie_%'] = m_sum['FROWNIE CT'] / m_sum['RESPONSE CT'] * 100
m_sum['Resp_Rate_%'] = m_sum['RESPONSE CT'] / m_sum['HANDLED TICKET'] * 100
print("\n=== MONTHLY SUMMARY BY LOB (EMBRData2.1.xlsx) ===")
print(m_sum.to_string(float_format=lambda x: f"{x:.2f}"))

# Also print Site-level Oct vs Nov from EMBRData2.1.xlsx!
site_rows = embr[(embr['LOB'] != 'Total') & (embr['Site'] != 'Total')].copy()
s_sum = site_rows[site_rows['Month'].isin(['2026-10', '2026-11'])].groupby(['LOB', 'Site', 'Month'])[['HANDLED TICKET', 'SMILEY CT', 'NEUTRRAL CT', 'FROWNIE CT', 'RESPONSE CT']].sum()
s_sum['Smiley_%'] = s_sum['SMILEY CT'] / s_sum['RESPONSE CT'] * 100
s_sum['Neutral_%'] = s_sum['NEUTRRAL CT'] / s_sum['RESPONSE CT'] * 100
s_sum['Frownie_%'] = s_sum['FROWNIE CT'] / s_sum['RESPONSE CT'] * 100
print("\n=== SITE x LOB SUMMARY OCT VS NOV (EMBRData2.1.xlsx) ===")
print(s_sum.to_string(float_format=lambda x: f"{x:.2f}"))


