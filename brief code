                      f"raw ARIMA guard MAE: {fc['guard_scores']['arima_only_selected_order']['mae_pp']:.2f} pp.")
            if fc.get("fallback_used"):
                print(f"  BACKUP USED: {fc['method']}. Primary reason: {fc.get('fallback_reason','unknown')}")
                print("  Backup W+1–W+4: "+", ".join(f"{100*v:.3f}%" for v in fc["values"]))
            if fc.get("whitepaper_reference"):
                print(f"  Whitepaper weekday reference W+1–W+4: "+", ".join(pct(v) for v in fc["whitepaper_reference"]))
