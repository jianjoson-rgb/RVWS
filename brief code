    for node in c.nodes[table_i:chart_i]:
        _move_node_y(node, 253.7)

    replacements = {
        "GLOBAL OPERATIONS | WEEKLY INTELLIGENCE BRIEF": "TASKUS SHOPIFY | WEEKLY OPERATIONS BRIEF",
        "SYNTHETIC PREVIEW": "ILLUSTRATIVE SAMPLE",
        f"Source latest: {model['source_latest']:%d %b %Y}": "SLIDE 1 OF 2",
        "TACTICAL": "RESULTS OBSERVED",
        "STRATEGIC": "BEING REVISED",
        "NEW / ESCALATION": "SCALING GLOBALLY",
    }
    for node in c.nodes:
        if node["kind"] == "text" and node["text"] in replacements:
            node["text"] = replacements[node["text"]]
    # These values are computed only when the same source segment has adequate
    # current and prior samples. Otherwise an empty editable field is retained.
    items = []
    for key, label in (("site_highlight", "SITE"), ("cohort_highlight", "COHORT")):
        # Slide 1 highlights movement; stable comparisons remain available on Slide 2.
        hits = [(r, r.get(key)) for r in model["rows"]
                if r.get(key) and round(r[key]["delta_pp"], 1) != 0]
        if hits:
            row, hit = max(hits, key=lambda pair: abs(pair[1]["delta_pp"]))
            value = SITE_DISPLAY_NAMES.get(hit["label"], hit["label"]) if key == "site_highlight" else hit["label"]
            items.append(f"{label} ({row['lob']}): {value} {hit['delta_pp']:+.1f} pp WoW")
    if items:
        c.text(fit_short_text("    |    ".join(items), 944, 13, True), 34, 664, 944, 21, 13, "muted", True)
    else:
        c.text("", 34, 664, 944, 21, 13, "muted", True, manual="Site and cohort highlights")
    chosen = SLIDE_ASPECT if aspect is None else aspect
    if chosen == "16:10":
        return c
