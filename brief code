def scene_requests(canvas, slide_id, width_pt, height_pt):
    """Build Slides API calls for native shapes, lines and editable text boxes."""
    scale_x, scale_y = width_pt / canvas.width, height_pt / canvas.height
    requests, expected, manual_ids = [], {}, []
    prefix = "goib_" + uuid.uuid4().hex[:10]
    def props(x, y, w, h):
        return {"pageObjectId": slide_id,
                "size": {"width": {"magnitude": w*scale_x, "unit": "PT"},
                         "height": {"magnitude": h*scale_y, "unit": "PT"}},
                "transform": {"scaleX": 1, "scaleY": 1, "translateX": x*scale_x,
                              "translateY": y*scale_y, "unit": "PT"}}
    for i, node in enumerate(canvas.nodes):
        oid = f"{prefix}_{i:04d}"
        kind = node["kind"]
        if kind == "line":
            lp = {"pageObjectId": slide_id,
                  "size": {"width": {"magnitude": 1, "unit": "PT"},
                           "height": {"magnitude": 1, "unit": "PT"}},
                  "transform": {"scaleX": (node["x2"]-node["x1"])*scale_x,
                                "scaleY": (node["y2"]-node["y1"])*scale_y,
                                "translateX": node["x1"]*scale_x,
                                "translateY": node["y1"]*scale_y, "unit": "PT"}}
            requests.append({"createLine": {"objectId": oid, "category": "STRAIGHT", "elementProperties": lp}})
            requests.append({"updateLineProperties": {"objectId": oid,
                "lineProperties": {"lineFill": {"solidFill": {"color": {"rgbColor": rgb(COLORS[node["color"]])}, "alpha": 1}},
                                   "weight": {"magnitude": node["width"]*scale_x, "unit": "PT"},
                                   "dashStyle": "DASH" if node["dashed"] else "SOLID",
                                   "startArrow": "NONE", "endArrow": "NONE"},
                "fields": "lineFill,weight,dashStyle,startArrow,endArrow"}})
            continue
        shape = "TEXT_BOX" if kind == "text" else ("ELLIPSE" if kind == "dot" else ("WAVE" if kind == "wave" else
                 ("ROUND_RECTANGLE" if node.get("rounded") else "RECTANGLE"))
                 )
        if kind == "text" and not node.get("manual"):
            # Slides text boxes have internal margins. Extra invisible area
            # preserves the scene's visual content bounds without shrinking type.
            p = props(node["x"]-16,node["y"]-16,node["w"]+32,node["h"]+32)
        else:
            p = props(node["x"],node["y"],node["w"],node["h"])
        requests.append({"createShape": {"objectId": oid, "shapeType": shape, "elementProperties": p}})
        fill = node.get("fill")
        border = node.get("border")
        shape_props = {
            "shapeBackgroundFill": {"solidFill": {"color": {"rgbColor": rgb(COLORS[fill])}, "alpha": 1}}
                                   if fill else {"propertyState": "NOT_RENDERED"},
            "outline": {"outlineFill": {"solidFill": {"color": {"rgbColor": rgb(COLORS[border])}}},
                        "weight": {"magnitude": 1.2*scale_x, "unit": "PT"}, "dashStyle": "SOLID"}
                       if border else {"propertyState": "NOT_RENDERED"},
            "contentAlignment": "MIDDLE"}
        requests.append({"updateShapeProperties": {"objectId": oid, "shapeProperties": shape_props,
                                                    "fields": "shapeBackgroundFill,outline,contentAlignment"}})
        if kind != "text":
            continue
        if node.get("manual"):
            manual_ids.append(oid)
            requests.append({"updatePageElementAltText": {"objectId": oid, "title": node["manual"],
                             "description": "Blank field for manual entry."}})
        if not node["text"] and not node.get("manual"):
            continue
        insert_value = node["text"] if node["text"] else " "
        if node["text"]:
            expected[oid] = node["text"]
        requests.append({"insertText": {"objectId": oid, "insertionIndex": 0, "text": insert_value}})
        requests.append({"updateTextStyle": {"objectId": oid, "textRange": {"type": "ALL"},
            "style": {"fontFamily": FONT_FAMILY, "fontSize": {"magnitude": node["size"]*scale_x, "unit": "PT"},
                      "bold": node["bold"], "foregroundColor": {"opaqueColor": {"rgbColor": rgb(COLORS[node["color"]])}}},
            "fields": "fontFamily,fontSize,bold,foregroundColor"}})
        alignment = {"left": "START", "center": "CENTER", "right": "END"}[node["align"]]
        requests.append({"updateParagraphStyle": {"objectId": oid, "textRange": {"type": "ALL"},
            "style": {"alignment": alignment, "spaceAbove": {"magnitude": 0, "unit": "PT"},
                      "spaceBelow": {"magnitude": 0, "unit": "PT"},
                      "indentStart": {"magnitude": 0, "unit": "PT"}, "indentEnd": {"magnitude": 0, "unit": "PT"}},
            "fields": "alignment,spaceAbove,spaceBelow,indentStart,indentEnd"}})
    return requests, expected, manual_ids


def preview_image(canvas, path):
    """Local synthetic design preview; Google Slides is the authoritative render."""
    from PIL import Image, ImageDraw, ImageFont
    im = Image.new("RGB", (canvas.width, canvas.height), "white")
    draw = ImageDraw.Draw(im)
    reg = "/usr/share/fonts/truetype/dejavu/DejaVuSans.ttf"
    bold = "/usr/share/fonts/truetype/dejavu/DejaVuSans-Bold.ttf"
    fonts = {}
    def F(size, isbold):
        key = (max(1, round(size)), bool(isbold))
        if key not in fonts:
            try:
                fonts[key] = ImageFont.truetype(bold if isbold else reg, key[0])
            except OSError:
                fonts[key] = ImageFont.load_default()
        return fonts[key]
    for n in canvas.nodes:
        kind = n["kind"]
        if kind in ("rect", "dot", "wave"):
            xy = (n["x"], n["y"], n["x"]+n["w"], n["y"]+n["h"])
            fill = "#"+COLORS[n["fill"]] if n.get("fill") else None
            outline = "#"+COLORS[n["border"]] if n.get("border") else None
            if kind == "wave":
                # Lightweight visual approximation of Slides' native WAVE.
                points = []
                for i in range(41):
                    t=i/40
                    points.append((n["x"]+n["w"]*t,n["y"]+n["h"]*(0.25+0.16*math.sin(math.pi*2*t))))
                for i in range(40,-1,-1):
                    t=i/40
                    points.append((n["x"]+n["w"]*t,n["y"]+n["h"]*(0.66+0.16*math.sin(math.pi*2*t))))
                draw.polygon(points,fill=fill)
            elif kind == "dot":
                draw.ellipse(xy, fill=fill)
            elif n.get("rounded"):
                draw.rounded_rectangle(xy, radius=5, fill=fill, outline=outline, width=1)
            else:
                draw.rectangle(xy, fill=fill, outline=outline, width=1)
        elif kind == "line":
            coords=(n["x1"],n["y1"],n["x2"],n["y2"])
            if not n["dashed"]:
                draw.line(coords, fill="#"+COLORS[n["color"]], width=max(1, round(n["width"])))
            else:
                dx,dy=n["x2"]-n["x1"],n["y2"]-n["y1"]
                length=math.hypot(dx,dy)
                if length:
                    for p in range(0, int(length), 9):
                        a,b=p/length,min(p+5,length)/length
                        draw.line((n["x1"]+a*dx,n["y1"]+a*dy,n["x1"]+b*dx,n["y1"]+b*dy),
                                  fill="#"+COLORS[n["color"]],width=max(1,round(n["width"])))
        elif n["text"]:
            font=F(n["size"],n["bold"])
            bbox=draw.textbbox((0,0),n["text"],font=font)
            tw,th=bbox[2]-bbox[0],bbox[3]-bbox[1]
            if n["align"]=="center": xx=n["x"]+(n["w"]-tw)/2
            elif n["align"]=="right": xx=n["x"]+n["w"]-tw-3
            else: xx=n["x"]+3
            yy=n["y"]+(n["h"]-th)/2-bbox[1]
            draw.text((xx,yy),n["text"],fill="#"+COLORS[n["color"]],font=font)
    im.save(str(path), "PNG", optimize=True)


