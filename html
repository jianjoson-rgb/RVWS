let registryStabilityConfig = null;
function loadRegistryStability_() {
  google.script.run.withSuccessHandler(function(config){registryStabilityConfig=config;renderRegistryStability_(filteredDashboardRows);})
    .withFailureHandler(function(){registryStabilityConfig={ready:false,errors:['Stability rules could not be loaded. Reload after maintainer setup.']};renderRegistryStability_(filteredDashboardRows);}).getRegistryStabilityConfig();
}
function registryCalendarAge_(date,today) {
  if(!/^\d{4}-\d{2}-\d{2}$/.test(String(date)) || !/^\d{4}-\d{2}-\d{2}$/.test(String(today)))return null;
  const a=Date.parse(date+'T00:00:00Z'),b=Date.parse(today+'T00:00:00Z');
  if(!Number.isFinite(a) || !Number.isFinite(b) || new Date(a).toISOString().slice(0,10)!==date || new Date(b).toISOString().slice(0,10)!==today)return null;
  return Math.floor((b-a)/86400000);
}
function registryStabilitySummary_(rows,config) {
  const x={state:'Unavailable',candidate:'',score:null,core:0,active:0,completed:0,engagement:0,pending:0,legacy:0,excluded:0,unknown:0,duplicates:0,assessed:0,validated:0,sustained:0,counts:{Intervention:0,Escalation:0,Standardization:0,Scaling:0},reason:'',action:'Review configuration and records.'};
  if(!config || !config.ready){x.reason=config?(config.errors || []).join(' '):'Loading stability rules…';return x;}
  const v=config.values,today=config.today,frequencies=Object.create(null);
  (rows || []).forEach(function(row){const id=String(row.id || '').trim();if(id)frequencies[id]=(frequencies[id] || 0)+1;});
  (rows || []).forEach(function(row){
    const id=String(row.id || '').trim();if(!id || frequencies[id]>1 || (row.stability && row.stability.issue)){x.duplicates++;return;}
    if(!row.stability || row.stability.approved!==true){
      if(row.approvalRequired===true && ['Pending Review','Returned for Revision'].includes(row.reviewStatus))x.pending++;
      else if(row.approvalRequired!==true)x.legacy++;else x.excluded++;return;
    }
    const completed=row.status==='Completed';
    if(completed){const iso=String(row.completionDateIso || ''),date=Number.isFinite(Date.parse(iso))?registryReviewDate_(iso):'';
      const age=registryCalendarAge_(date,today);if(age===null || age<0 || age>v.Completed_Lookback_Days){x.excluded++;return;}}
    else if(!['Ongoing','On Hold'].includes(row.status)){x.excluded++;return;}
    const category=String(row.frameworkCategory || row.category || '').trim();
    if(category==='Engagement'){x.engagement++;return;}
    if(!Object.prototype.hasOwnProperty.call(x.counts,category)){x.unknown++;return;}
    x.counts[category]++;x.core++;if(completed)x.completed++;else x.active++;
    const a=row.stability.assessment,age=a?registryCalendarAge_(a.periodEnd,today):null;
    if(!a || age===null || age<0 || age>v.Evidence_Max_Age_Days || !['Validated','Partially Effective','No Observable Effect','Insufficient Evidence'].includes(a.status))return;
    x.assessed++;
    if(a.status==='Validated' && a.hasEvidence===true && a.expectations==='Met' && a.relationship==='Supported'){x.validated++;if(a.sustained==='Sustained')x.sustained++;}
  });
  const mature=x.counts.Standardization+x.counts.Scaling;
  x.score=x.core?100*mature/x.core:null;
  if(x.unknown || x.duplicates){x.state='Data Review Required';x.score=null;x.reason=x.unknown+' eligible plan(s) have an unknown category; '+x.duplicates+' row(s) have record identity, version, approval or review-history problems. Classification is withheld.';x.action='Resolve classification or record integrity before interpreting stability.';return x;}
  if(x.core<v.Minimum_Core_Plans){x.state='Insufficient Data';x.reason=x.core+' eligible core plans; the rule requires at least '+v.Minimum_Core_Plans+'.';x.action='Build sufficient approved, classified coverage; review excluded and pending plans.';return x;}
  const i=x.counts.Intervention/x.core,e=x.counts.Escalation/x.core,m=mature/x.core;
  if(m>=v.LockedIn_Mature_Share && m>i && m>e){
    x.candidate='CARL (Locked-In)';
    if(x.validated/x.core>=v.Minimum_Validated_Share && x.sustained/x.core>=v.Minimum_Sustained_Validated_Share){x.state='CARL (Locked-In)';x.reason='Standardization/Scaling mix and recent validated/sustained evidence meet the configured thresholds.';x.action='Maintain controls and review sustainability; any scaling rollout still needs governance authorization.';}
    else{x.state='Maturing';x.reason='The category mix is a Locked-In candidate, but recent validated/sustained evidence coverage is below its threshold.';x.action='Validate impact and sustainability before treating the account as Locked-In.';}
  } else if(i>=v.Dominance_Share && i>e && i>m){x.state='Reactive';x.reason='Intervention is the dominant eligible action category.';x.action='Review recurring execution gaps and convert effective fixes into standard operating routines.';}
  else if(e>=v.Dominance_Share && e>i && e>m){x.state='Emerging';x.reason='Escalation is the dominant eligible action category.';x.action='Resolve client, policy, product and cross-functional dependencies; track commitments to closure.';}
  else if(m>i && m>e){x.state='Maturing';x.reason='Standardization/Scaling is the largest group, below the Locked-In mix threshold.';x.action='Embed verified practices and strengthen evidence of sustained impact.';}
  else{x.state='Mixed / Review Needed';x.reason='No unambiguous dominant group meets the configured rules; ties are not forced into a state.';x.action='Review the mix and material drivers before assigning an executive interpretation.';}
  return x;
}
function renderRegistryStability_(rows) {
  const config=registryStabilityConfig,x=registryStabilitySummary_(rows,config),p=function(n,d){return d?(100*n/d).toFixed(1)+'%':'—';};
  const scope=[];
  if(selectedSites.size>0 && selectedSites.size<availableSites.length)scope.push('Sites: '+Array.from(selectedSites).join(', '));
  const department=document.getElementById('departmentFilter').value;if(department)scope.push('Department: '+department);
  const narrow=['searchFilter','kpiFilter','ownerFilter','categoryFilter'].some(function(id){return !!document.getElementById(id).value;}) || (selectedStatuses.size>0 && selectedStatuses.size<availableStatuses.length);
  document.getElementById('stabilityScope').textContent=(scope.length?scope.join(' · '):'Enterprise scope — Global and site/department plans combined')+(narrow?' · Additional filters applied; this is a selected portfolio, not the full account.':'');
  const biasedFilter=!!document.getElementById('categoryFilter').value || (selectedStatuses.size>0 && selectedStatuses.size<availableStatuses.length);
  if(biasedFilter && !['Unavailable','Data Review Required'].includes(x.state)){x.state='Filtered Mix Only';x.reason='Category or execution-status filters select the inputs used to classify stability. Clear these filters to interpret a framework state; the counts and score below describe only the selected plans.';x.action='Clear category and status filters before interpreting account stability.';}
  document.getElementById('stabilityState').textContent=x.state;
  document.getElementById('stabilityRulesStatus').textContent=config && config.ready?config.status+' rules · '+config.version+' · '+config.today+' Manila':'Rules unavailable';
  document.getElementById('stabilityScore').textContent=x.score===null?'—':x.score.toFixed(1)+' / 100';
  document.getElementById('stabilityEvidence').textContent=x.validated+' / '+x.core+' validated · '+x.sustained+' / '+x.core+' sustained';
  const text=x.core+' core plans ('+x.active+' active, '+x.completed+' recently completed); '+x.engagement+' Engagement plans shown separately. '+x.pending+' pending/returned proposals; '+x.legacy+' legacy plans without recorded approval; '+x.excluded+' other excluded plans.';
  document.getElementById('stabilityCoverage').textContent=text+' Recent assessment coverage: '+p(x.assessed,x.core)+'.';
  document.getElementById('stabilityReason').textContent=x.reason;
  document.getElementById('stabilityAction').textContent=x.action;
  const body=document.getElementById('stabilityMixBody');body.textContent='';
  Object.keys(x.counts).forEach(function(category){const tr=document.createElement('tr');[category,String(x.counts[category]),p(x.counts[category],x.core)].forEach(function(value){appendTextCell(tr,value);});body.appendChild(tr);});
  document.getElementById('stabilityRuleReadout').textContent=config && config.ready?'Minimum '+config.values.Minimum_Core_Plans+' core plans; dominance ≥ '+p(config.values.Dominance_Share,1)+'; Locked-In mix ≥ '+p(config.values.LockedIn_Mature_Share,1)+', validated ≥ '+p(config.values.Minimum_Validated_Share,1)+', sustained validated ≥ '+p(config.values.Minimum_Sustained_Validated_Share,1)+'. Evidence age ≤ '+config.values.Evidence_Max_Age_Days+' days; completed lookback '+config.values.Completed_Lookback_Days+' days.':'';
  document.getElementById('narrativeStability').textContent=x.state+' · '+(config && config.ready?config.status+' rules. ':'')+x.reason+' '+x.action;
}

