function submitNewAction() {
  if (!currentAccess.verified || !currentAccess.active || (!currentAccess.canSubmit && !editingRevision)) {
    document.getElementById('createActionMessage').textContent = 'Submission permission is required.';
    return;
  }
  if (document.getElementById('createActionButton').disabled) return;
  clearRegistryCreationErrors_();
  const message = document.getElementById('createActionMessage');
  const button = document.getElementById('createActionButton');
  const kpiName = document.getElementById('newKpi').value;
  const kpiSetting =
    creationKpiSettings[String(kpiName || '').toLowerCase()] || {};

