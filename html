function submitUpdate() {
  if (registryCompletedPlan_(currentActionDetails)) { document.getElementById('message').textContent = 'Completed — read-only. Execution cannot be changed.'; return; }
  if (actionWriteBusy || !currentActionDetails || !currentActionDetails.permissions.canUpdate) {
    document.getElementById('message').textContent = 'Only the active action owner can update this action.';
    return;
  }
  const actionPlanId = document.getElementById('actionPlan').value;
  const currentPerformanceText =
    document.getElementById('currentPerformance').value;
  const actionStatus = document.getElementById('actionStatus').value;
  const comment = document.getElementById('comment').value;
  const message = document.getElementById('message');
  const button = document.getElementById('submitButton');

  if (!actionPlanId) {
    message.textContent = 'Please select an Action Plan.';
    return;
  }

  const governance=currentActionDetails.measurementMethod==='Governance outcome';
  if (!governance && String(currentPerformanceText).trim() === '') {
    message.textContent = 'Please enter Current Performance.';
    return;
  }

  const currentPerformance = governance?'':parseMetricInputForKpi_(
    currentPerformanceText,
    selectedKpiName,
    selectedKpiUnit
  );

  if (!governance && !Number.isFinite(currentPerformance)) {
    message.textContent = isAhtKpi(selectedKpiName)
      ? 'For AHT, enter HH:MM:SS such as 00:12:30.'
      : 'Please enter a valid Current Performance.';
    return;
  }

  if (
    !governance && String(selectedKpiUnit || '').trim() === '%' &&
    (currentPerformance < 0 || currentPerformance > 1)
  ) {
    message.textContent =
      'Percentage KPI values must be 0 to 1 or include %, e.g. 0.82 or 82%.';
    return;
  }

  if (!governance && String(selectedKpiUnit || '').toLowerCase() === 'count' && (!Number.isSafeInteger(currentPerformance) || currentPerformance < 0)) {
    message.textContent = 'Count KPIs require a non-negative whole number.'; return;
  }
  if (!actionStatus) {
    message.textContent = 'Please select Action Status.';
    return;
  }

  if (actionStatus === 'Completed' && currentActionDetails.actionStatus !== 'Completed' && !currentActionDetails.hasCurrentEvidence) {
    message.textContent = 'Upload proof of execution before marking the action Completed.';
    return;
  }
  const expectedRecordVersion = currentActionDetails.recordVersion;
  const signature = JSON.stringify([actionPlanId, currentPerformance, actionStatus, comment, expectedRecordVersion]);
  const requestToken = retryToken_('UPDATE', signature);
  setActionWriteBusy_(true, 'UPDATE');
  message.textContent = 'Saving update...';
  button.disabled = true;
  button.textContent = 'Saving...';
  beginExecutiveLoading_('Saving action update...');

  google.script.run
    .withSuccessHandler(function(result) {
    registryNoticeQueueWarning_(result);
      finishRetry_('UPDATE', signature);

      if (actionStatus === 'Completed' && currentActionDetails && currentActionDetails.actionPlanId === actionPlanId) {
        currentActionDetails.actionStatus = 'Completed';
        currentActionDetails.executionLocked = true;
        ['canUpdate', 'canUpload', 'canRevise', 'canReview'].forEach(function(key) { currentActionDetails.permissions[key] = false; });
        document.getElementById('evidenceForm').style.display = 'none';
        document.getElementById('ownerPermissionMessage').textContent = 'Completed — read-only. Execution, plan details and execution evidence are locked. Effectiveness reviews remain available.';
        document.getElementById('evidenceMessage').textContent = 'Completed — read-only. Saved execution evidence remains available below.';
      }
      setActionWriteBusy_(false);
      endExecutiveLoading_();
      button.disabled = !currentActionDetails || !currentActionDetails.permissions.canUpdate || registryCompletedPlan_(currentActionDetails);
      button.textContent = 'Submit Update';
      message.textContent = 'Update saved.'; showRegistryNotice_('Execution update saved. Current plan approval retained.');

      loadDashboard();
      loadActions();

      if (
        String(document.getElementById('actionPlan').value || '') ===
        String(actionPlanId)
      ) {
        loadActionDetails();
      }
    })
    .withFailureHandler(function(error) {
      setActionWriteBusy_(false);
      endExecutiveLoading_();
      button.disabled = !currentActionDetails || !currentActionDetails.permissions.canUpdate || registryCompletedPlan_(currentActionDetails);
      button.textContent = 'Submit Update';
      message.textContent = 'Error: ' + error.message;
    })
    .submitActionUpdate(
      actionPlanId,
      currentPerformance,
      actionStatus,
      comment,
      requestToken,
      expectedRecordVersion
    );
}

const executiveLoaderState = { pending: 0, hasOpened: false };

function renderExecutiveLoader_() {

  document.getElementById('executiveLoaderPercent').textContent = 'Please wait';
}

function beginExecutiveLoading_(label) {
  const loader = document.getElementById('executiveLoader');
  if (executiveLoaderState.pending === 0) {
    loader.dataset.mode = executiveLoaderState.hasOpened || actionWriteBusy || registryCreationBusy ? 'compact' : 'opening';
    loader.classList.add('active');
    loader.setAttribute('aria-hidden', 'false');
    loader.setAttribute('aria-busy', 'true');
  }
  executiveLoaderState.pending += 1;
  document.getElementById('executiveLoaderLabel').textContent = label || 'Loading registry…';
  renderExecutiveLoader_();
}

function endExecutiveLoading_() {
  executiveLoaderState.pending = Math.max(0, executiveLoaderState.pending - 1);
  if (executiveLoaderState.pending) return;
  executiveLoaderState.hasOpened = true;
  const loader = document.getElementById('executiveLoader');
  loader.classList.remove('active');
  loader.setAttribute('aria-hidden', 'true');
  loader.setAttribute('aria-busy', 'false');
}

function fillSelectOptions_(elementId, values, placeholder) {
  const select = document.getElementById(elementId);
  if (!select) return;

  const previousValue = String(select.value || '');
  select.innerHTML = '';

  const first = document.createElement('option');
  first.value = '';
  first.textContent = placeholder;
  select.appendChild(first);

  (values || []).forEach(function(value) {
    const option = document.createElement('option');
    option.value = value;
    option.textContent = value;
    select.appendChild(option);
  });

  if (
    previousValue &&
    Array.from(select.options).some(function(option) {
      return option.value === previousValue;
    })
  ) {
    select.value = previousValue;
  }
}

