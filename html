function parsePerformanceInput(
  value
) {

  const text =
    String(value || '')
      .trim();

  if (!text) {
    return NaN;
  }

  if (
    isAhtKpi(
      selectedKpiName
    )
  ) {

    if (
      text.includes(':')
    ) {

      const parts =
        text.split(':');

      if (
        parts.length !== 3
      ) {
        return NaN;
      }

      const hours =
        Number(parts[0]);

      const minutes =
        Number(parts[1]);

      const seconds =
        Number(parts[2]);

      if (
        !Number.isFinite(hours) ||
        !Number.isFinite(minutes) ||
        !Number.isFinite(seconds) ||
        minutes < 0 ||
        minutes >= 60 ||
        seconds < 0 ||
        seconds >= 60
      ) {
        return NaN;
      }

      return (
        hours * 60 +
        minutes +
        seconds / 60
      );
    }

    return Number(text);
  }

  if (
    String(
      selectedKpiUnit || ''
    ).trim() === '%'
  ) {

    if (
      text.endsWith('%')
    ) {

      const percentage =
        Number(
          text.slice(0, -1)
        );

      return Number.isFinite(
        percentage
      )
        ? percentage / 100
        : NaN;
    }
  }

  return Number(text);
}

function parseMetricInputForKpi_(value, kpiName, kpiUnit) {
  const text = String(value == null ? '' : value).trim();
  if (!text) return NaN;

  if (isAhtKpi(kpiName)) {
    if (text.includes(':')) {
      const match = text.match(/^(\d+):(\d{2}):(\d{2})$/);
      if (!match) return NaN;

      const hours = Number(match[1]);
      const minutes = Number(match[2]);
      const seconds = Number(match[3]);

      if (
        !Number.isFinite(hours) ||
        !Number.isFinite(minutes) ||
        !Number.isFinite(seconds) ||
        minutes >= 60 ||
        seconds >= 60
      ) {
        return NaN;
      }

      return hours * 60 + minutes + seconds / 60;
    }

    const numericAht = Number(text.replace(/,/g, ''));
    return Number.isFinite(numericAht) && numericAht >= 0
      ? numericAht
      : NaN;
  }

  if (String(kpiUnit || '').trim() === '%') {
    if (text.endsWith('%')) {
      if (!text.slice(0, -1).trim()) return NaN;
      const percent = Number(text.slice(0, -1));
      return Number.isFinite(percent) ? percent / 100 : NaN;
    }
  }

  return Number(text.replace(/,/g, ''));
}

