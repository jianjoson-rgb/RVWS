<html>

<head>

  <base target="_top">

  <meta
    name="viewport"
    content="width=device-width, initial-scale=1"
  >

  <link
    rel="preconnect"
    href="https://fonts.googleapis.com"
  >

  <link
    rel="preconnect"
    href="https://fonts.gstatic.com"
    crossorigin
  >

  <link
    href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&display=swap"
    rel="stylesheet"
  >

  <style>

    * {
      box-sizing: border-box;
    }

    :root {

      --brand-blue: #065AF7;
      --brand-pink: #FF0074;
      --brand-yellow: #FFD400;
      --brand-black: #000000;
      --brand-cream: #FFFFEA;
      --brand-orange: #FF5826;
      --brand-amber: #FCAF17;
      --brand-purple: #8219FF;
      --brand-lilac: #F57EFF;

      --brand-navy: #022566;
      --brand-deep-navy: #011233;
      --brand-soft-blue: #CDDEFF;
      --brand-soft-orange: #FFBCA8;
      --brand-soft-purple: #E6D1FF;
      --brand-soft-yellow: #FFEE99;

      --navy: #022566;
      --bg: #FFFFEA;
      --card: #FFFFFF;
      --border: #CDDEFF;
      --text: #000000;
      --muted: #022566;

      --green: #065AF7;
      --green-bg: #CDDEFF;

      --amber: #997F00;
      --amber-bg: #FFEE99;

      --red: #993517;
      --red-bg: #FFBCA8;

      --blue: #022566;
      --blue-bg: #CDDEFF;

      --gray: #6814CC;
      --gray-bg: #E6D1FF;

      --dark-gray: #000000;
      --dark-gray-bg: #FFFFEA;
    }

    body {
      font-family: "DM Sans", Arial, Helvetica, sans-serif;
      background: var(--bg);
      margin: 0;
      padding: 18px 24px 24px;
      color: var(--text);
    }

    .container {
      max-width: 1450px;
      margin: auto;
    }

    h1,
    h2,
    h3 {
      color: var(--navy);
    }

    h1 {
      margin-top: 0;
      margin-bottom: 5px;
    }

    .subtitle {
      color: var(--muted);
      margin-bottom: 20px;
    }

    .card {
      background: var(--card);
      border: 1px solid var(--border);
      border-radius: 10px;
      padding: 20px;
      margin-bottom: 18px;
    }

    .controls-card {
      padding: 14px 16px;
      margin-bottom: 18px;
    }

    .controls-header {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 12px;
      margin-bottom: 10px;
    }

    .controls-title {
      font-size: 13px;
      font-weight: 700;
      color: var(--navy);
      margin: 0;
    }

    .filtered-count {
      font-size: 12px;
      color: var(--muted);
      white-space: nowrap;
    }

    .filter-grid {
      display: grid;
      grid-template-columns:
        minmax(210px, 1.6fr)
        repeat(5, minmax(120px, 1fr))
        auto;
      gap: 10px;
      align-items: end;
    }

    .filter-field label {
      display: block;
      margin-bottom: 4px;
      color: var(--muted);
      font-size: 11px;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.02em;
    }

    select,
    input,
    textarea {
      width: 100%;
      padding: 9px 10px;
      border: 1px solid #C9D0D8;
      border-radius: 6px;
      background: white;
      font-size: 13px;
    }

    select:focus,
    input:focus,
    textarea:focus {
      outline: none;
      border-color: #7A97BB;
      box-shadow: 0 0 0 2px rgba(23, 54, 93, 0.08);
    }

    .reset-button {
      width: auto;
      min-width: 92px;
      margin: 0;
      padding: 9px 14px;
      background: white;
      color: var(--navy);
      border: 1px solid #9EADC0;
      font-size: 12px;
    }

    .reset-button:hover {
      background: #F6F8FA;
      opacity: 1;
    }

    .meeting-button {
      width: auto;
      min-width: 118px;
      margin: 0;
      padding: 9px 14px;
      background: var(--navy);
      color: white;
      border: 1px solid var(--navy);
      font-size: 12px;
    }

    .meeting-button:hover {
      opacity: 0.94;
    }

    .meeting-meta {
      display: none;
      align-items: center;
      justify-content: space-between;
      gap: 14px;
      margin-top: -6px;
      margin-bottom: 14px;
      padding: 9px 12px;
      background: #F8FAFC;
      border: 1px solid var(--border);
      border-radius: 7px;
      color: var(--muted);
      font-size: 11px;
    }

    .meeting-meta-left {
      font-weight: 700;
      color: var(--dark-gray);
    }

    .meeting-meta-right {
      text-align: right;
    }

    body.meeting-mode {
      padding-top: 12px;
      padding-bottom: 12px;
    }

    body.meeting-mode .container {
      max-width: 1560px;
    }

    body.meeting-mode .meeting-meta {
      display: flex;
    }

    body.meeting-mode .controls-card {
      padding: 10px 12px;
      margin-bottom: 12px;
    }

    body.meeting-mode .controls-header {
      margin-bottom: 7px;
    }

    body.meeting-mode .filter-grid {
      gap: 8px;
    }

    body.meeting-mode .filter-field label {
      margin-bottom: 3px;
      font-size: 10px;
    }

    body.meeting-mode select,
    body.meeting-mode input,
    body.meeting-mode .multi-select-button {
      min-height: 31px;
      padding: 7px 8px;
      font-size: 11px;
    }

    body.meeting-mode .reset-button,
    body.meeting-mode .meeting-button {
      min-height: 31px;
      padding: 7px 10px;
      font-size: 11px;
    }

    body.meeting-mode .title-block {
      margin-bottom: 10px;
    }

    body.meeting-mode h1 {
      font-size: 24px;
      margin-bottom: 3px;
    }

    body.meeting-mode .subtitle {
      margin-bottom: 0;
      font-size: 12px;
    }

    body.meeting-mode .summary-grid {
      gap: 8px;
      margin-bottom: 12px;
    }

    body.meeting-mode .summary-card {
      min-height: 68px;
      padding: 10px 12px;
      border-radius: 8px;
    }

    body.meeting-mode .summary-label {
      font-size: 10px;
      margin-bottom: 4px;
    }

    body.meeting-mode .summary-value {
      font-size: 23px;
    }

    body.meeting-mode .card.action-table-card {
      padding: 12px;
      margin-bottom: 0;
    }

    body.meeting-mode .section-heading-row {
      margin-bottom: 8px;
    }

    body.meeting-mode .section-heading-row h3 {
      font-size: 15px;
    }

    body.meeting-mode th {
      padding: 8px 8px;
      font-size: 10px;
    }

    body.meeting-mode td {
      padding: 7px 8px;
      font-size: 10px;
    }

    body.meeting-mode .badge {
      min-height: 20px;
      padding: 3px 7px;
      font-size: 9px;
    }

    body.meeting-mode .progress-wrap {
      min-width: 90px;
    }

    body.meeting-mode .progress-label {
      font-size: 9px;
    }

    body.meeting-mode .progress-track {
      height: 5px;
    }

    body.meeting-mode .operational-section {
      display: none !important;
    }

    body.meeting-mode .screenshot-only-note {
      display: none;
    }

    .screenshot-only-note {
      display: none;
      color: var(--muted);
      font-size: 10px;
      margin-top: 8px;
      text-align: right;
    }

    .multi-select {
      position: relative;
      width: 100%;
    }

    .multi-select-button {
      width: 100%;
      min-height: 35px;
      margin: 0;
      padding: 9px 10px;
      background: white;
      color: var(--text);
      border: 1px solid #C9D0D8;
      border-radius: 6px;
      font-size: 13px;
      font-weight: 400;
      text-align: left;
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 8px;
    }

    .multi-select-button:hover {
      opacity: 1;
      background: white;
      border-color: #9EADC0;
    }

    .multi-select-button:focus {
      outline: none;
      border-color: #7A97BB;
      box-shadow: 0 0 0 2px rgba(23, 54, 93, 0.08);
    }

    .multi-select-caret {
      color: var(--muted);
      font-size: 11px;
      flex: 0 0 auto;
    }

    .multi-select-menu {
      position: absolute;
      top: calc(100% + 5px);
      left: 0;
      right: 0;
      z-index: 1000;
      display: none;
      background: white;
      border: 1px solid #C9D0D8;
      border-radius: 8px;
      box-shadow: 0 10px 28px rgba(16, 24, 40, 0.14);
      overflow: hidden;
      min-width: 210px;
    }

    .multi-select-menu.open {
      display: block;
    }

    .multi-select-options {
      max-height: 230px;
      overflow-y: auto;
      padding: 7px;
    }

    .multi-select-option {
      display: flex;
      align-items: center;
      gap: 9px;
      padding: 8px 7px;
      border-radius: 5px;
      cursor: pointer;
      font-size: 13px;
      color: var(--text);
      text-transform: none;
      letter-spacing: normal;
      margin: 0;
    }

    .multi-select-option:hover {
      background: #F6F8FA;
    }

    .multi-select-option input[type="checkbox"] {
      width: 15px;
      height: 15px;
      margin: 0;
      padding: 0;
      flex: 0 0 auto;
      accent-color: var(--navy);
    }

    .multi-select-actions {
      display: flex;
      gap: 8px;
      padding: 8px;
      border-top: 1px solid var(--border);
      background: #FAFBFC;
    }

    .multi-select-action {
      width: 50%;
      margin: 0;
      padding: 7px 8px;
      border-radius: 5px;
      background: white;
      color: var(--navy);
      border: 1px solid #C9D0D8;
      font-size: 11px;
      font-weight: 700;
    }

    .multi-select-action:hover {
      opacity: 1;
      background: #F2F4F7;
    }

    .title-block {
      margin-bottom: 18px;
    }

    .summary-grid {
      display: grid;
      grid-template-columns: repeat(6, 1fr);
      gap: 12px;
      margin-bottom: 18px;
    }

    .summary-card {
      background: var(--card);
      border: 1px solid var(--border);
      border-top: 4px solid var(--navy);
      border-radius: 10px;
      padding: 15px 16px;
      min-height: 86px;
    }

    .summary-card.total {
      border-top-color: var(--navy);
    }

    .summary-card.on-track {
      border-top-color: var(--green);
    }

    .summary-card.at-risk {
      border-top-color: #D98A00;
    }

    .summary-card.overdue {
      border-top-color: var(--red);
    }

    .summary-card.on-hold {
      border-top-color: var(--gray);
    }

    .summary-card.completed {
      border-top-color: var(--blue);
    }

    .summary-label {
      color: var(--muted);
      font-size: 12px;
      margin-bottom: 7px;
      font-weight: 600;
    }

    .summary-value {
      font-size: 28px;
      font-weight: 700;
      color: var(--navy);
    }

    .section-heading-row {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 14px;
      margin-bottom: 12px;
    }

    .section-heading-row h3 {
      margin: 0;
    }

    .table-wrap {
      overflow-x: auto;
      border: 1px solid var(--border);
      border-radius: 8px;
    }

    table {
      width: 100%;
      border-collapse: collapse;
      min-width: 1120px;
      background: white;
    }

    th {
      background: var(--navy);
      color: white;
      text-align: left;
      padding: 11px 10px;
      font-size: 12px;
      font-weight: 700;
      white-space: nowrap;
    }

    td {
      padding: 11px 10px;
      border-bottom: 1px solid #EDF0F2;
      font-size: 12px;
      vertical-align: middle;
    }

    tbody tr {
      cursor: pointer;
      transition: background 0.12s ease;
    }

    tbody tr:hover {
      background: #F8FAFC;
    }

    tbody tr:last-child td {
      border-bottom: none;
    }

    .metric-value {
      font-weight: 600;
      white-space: nowrap;
    }

    .empty {
      color: var(--muted);
      padding: 20px 0;
    }

    .badge {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      min-height: 24px;
      padding: 4px 9px;
      border-radius: 999px;
      font-size: 11px;
      line-height: 1;
      font-weight: 700;
      white-space: nowrap;
    }

    .badge-on-track {
      color: var(--green);
      background: var(--green-bg);
    }

    .badge-at-risk {
      color: var(--amber);
      background: var(--amber-bg);
    }

    .badge-overdue {
      color: var(--red);
      background: var(--red-bg);
    }

    .badge-completed {
      color: var(--blue);
      background: var(--blue-bg);
    }

    .badge-on-hold {
      color: var(--gray);
      background: var(--gray-bg);
    }

    .badge-cancelled {
      color: var(--dark-gray);
      background: var(--dark-gray-bg);
    }

    .badge-ongoing {
      color: var(--navy);
      background: #EAF0F7;
    }

    .badge-not-started {
      color: var(--gray);
      background: var(--gray-bg);
    }

    .badge-default {
      color: var(--dark-gray);
      background: var(--dark-gray-bg);
    }

    .progress-wrap {
      min-width: 110px;
    }

    .progress-topline {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 8px;
      margin-bottom: 5px;
    }

    .progress-label {
      font-size: 11px;
      font-weight: 700;
      color: var(--dark-gray);
      white-space: nowrap;
    }

    .progress-track {
      width: 100%;
      height: 7px;
      background: #EAECF0;
      border-radius: 999px;
      overflow: hidden;
    }

    .progress-fill {
      height: 100%;
      width: 0%;
      background: var(--navy);
      border-radius: 999px;
      transition: width 0.2s ease;
    }

    .detail-progress-wrap {
      max-width: 330px;
    }

    .details {
      display: none;
    }

    .detail-grid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 16px 25px;
    }

    .detail-item {
      border-bottom: 1px solid #EEEEEE;
      padding-bottom: 10px;
      min-height: 52px;
    }

    .detail-label {
      color: var(--muted);
      font-size: 12px;
      margin-bottom: 6px;
      font-weight: 600;
    }

    .detail-value {
      font-weight: 700;
      word-break: break-word;
    }

    .full-width {
      grid-column: 1 / -1;
    }

    .days-normal {
      color: var(--dark-gray);
    }

    .days-warning {
      color: var(--amber);
      font-weight: 700;
    }

    .days-overdue {
      color: var(--red);
      font-weight: 700;
    }

    .history-item {
      border-left: 4px solid var(--navy);
      padding: 13px 15px;
      margin-bottom: 13px;
      background: #F8F9FB;
      border-radius: 4px;
    }

    .history-header {
      display: flex;
      justify-content: space-between;
      gap: 10px;
      font-weight: 700;
      margin-bottom: 7px;
    }

    .history-meta {
      color: var(--muted);
      font-size: 12px;
      margin-bottom: 7px;
    }

    .history-comment {
      margin-top: 7px;
      white-space: pre-wrap;
    }

    textarea {
      min-height: 100px;
      resize: vertical;
    }

    button {
      width: 100%;
      padding: 12px;
      margin-top: 22px;
      border: none;
      border-radius: 6px;
      background: var(--navy);
      color: white;
      font-weight: 700;
      cursor: pointer;
    }

    button:hover {
      opacity: 0.94;
    }

    button:disabled {
      opacity: 0.6;
      cursor: default;
    }

    .message {
      margin-top: 15px;
      font-weight: 700;
    }

    @media (max-width: 1200px) {

      .filter-grid {
        grid-template-columns: repeat(3, 1fr);
      }

      .reset-button,
      .meeting-button {
        width: 100%;
      }

      .summary-grid {
        grid-template-columns: repeat(3, 1fr);
      }
    }

    @media (max-width: 800px) {

      body {
        padding: 14px;
      }

      .filter-grid {
        grid-template-columns: 1fr;
      }

      .summary-grid {
        grid-template-columns: repeat(2, 1fr);
      }

      .detail-grid {
        grid-template-columns: 1fr;
      }

      .full-width {
        grid-column: auto;
      }
    }

    h1,
    h2,
    h3 {
      color: var(--brand-black);
      letter-spacing: -0.02em;
    }

    h1 {
      font-weight: 700;
    }

    .subtitle {
      color: var(--brand-navy);
      font-weight: 500;
    }

    .card {
      border-color: var(--brand-soft-blue);
      box-shadow: none;
    }

    .controls-card {
      background: #FFFFFF;
      border-top: 4px solid var(--brand-blue);
    }

    .controls-title {
      color: var(--brand-black);
    }

    .filter-field label {
      color: var(--brand-navy);
    }

    select,
    input,
    textarea,
    .multi-select-button {
      font-family: "DM Sans", Arial, Helvetica, sans-serif;
      border-color: var(--brand-soft-blue);
      color: var(--brand-black);
    }

    select:focus,
    input:focus,
    textarea:focus,
    .multi-select-button:focus {
      border-color: var(--brand-blue);
      box-shadow: 0 0 0 2px #CDDEFF;
    }

    .reset-button {
      border-color: var(--brand-blue);
      color: var(--brand-blue);
      background: #FFFFFF;
    }

    .reset-button:hover {
      background: var(--brand-soft-blue);
    }

    .meeting-button {
      background: var(--brand-blue);
      border-color: var(--brand-blue);
      color: #FFFFFF;
    }

    .multi-select-menu {
      border-color: var(--brand-soft-blue);
      box-shadow: 0 8px 22px rgba(1, 18, 51, 0.14);
    }

    .multi-select-option input[type="checkbox"] {
      accent-color: var(--brand-blue);
    }

    .multi-select-action {
      border-color: var(--brand-soft-blue);
      color: var(--brand-blue);
    }

    .multi-select-action:hover {
      background: var(--brand-soft-blue);
    }

    .meeting-meta {
      background: #FFFFFF;
      border-left: 4px solid var(--brand-purple);
      border-color: var(--brand-soft-blue);
      border-left-color: var(--brand-purple);
      color: var(--brand-navy);
    }

    .meeting-meta-left {
      color: var(--brand-black);
    }

    .summary-card {
      border-color: var(--brand-soft-blue);
      border-top-width: 5px;
    }

    .summary-card.total {
      border-top-color: var(--brand-black);
    }

    .summary-card.on-track {
      border-top-color: var(--brand-blue);
    }

    .summary-card.at-risk {
      border-top-color: var(--brand-amber);
    }

    .summary-card.overdue {
      border-top-color: var(--brand-orange);
    }

    .summary-card.on-hold {
      border-top-color: var(--brand-purple);
    }

    .summary-card.completed {
      border-top-color: var(--brand-navy);
    }

    .summary-label {
      color: var(--brand-navy);
    }

    .summary-value {
