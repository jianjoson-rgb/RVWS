        const start =
          parseTrackerDate(
            row.startDate
          );

        const end =
          parseTrackerDate(
            row.endDate
          );

        return {
          row:
            row,

          start:
            start,

          end:
            end
        };

      }
    )
    .filter(
      item =>
        item.start &&
        item.end
    );
}

function getGanttWindow(
  scheduledRows
) {

  if (
    scheduledRows.length === 0
  ) {
    return null;
  }

  const earliestStart =
    scheduledRows.reduce(
      (minimum, item) =>
        item.start < minimum
          ? item.start
          : minimum,
      scheduledRows[0].start
    );

  const latestEnd =
    scheduledRows.reduce(
      (maximum, item) =>
        item.end > maximum
          ? item.end
          : maximum,
      scheduledRows[0].end
    );

  const earliestWeek =
    startOfSundayWeek(
      earliestStart
    );

  const latestWeek =
    startOfSundayWeek(
      latestEnd
    );

  if (
    !meetingModeEnabled
  ) {

    return {
      start:
        earliestWeek,

      end:
        latestWeek
    };
  }

  const currentWeek =
    startOfSundayWeek(
      new Date()
    );

  let start =
    addWeeks(
      currentWeek,
      -3
    );

  let end =
    addWeeks(
      start,
      13
    );

  const overlapsMeetingWindow =
    scheduledRows.some(
      item => {

        const itemStart =
          startOfSundayWeek(
            item.start
          );

        const itemEnd =
          startOfSundayWeek(
            item.end
          );

        return (
          itemEnd >= start &&
          itemStart <= end
        );

      }
    );

  if (
    !overlapsMeetingWindow
  ) {

    if (
      earliestWeek >
      end
    ) {

      start =
        earliestWeek;

      end =
        addWeeks(
          start,
          13
        );

    } else if (
      latestWeek <
      start
    ) {

      end =
        latestWeek;

      start =
        addWeeks(
          end,
          -13
        );

    }
  }

  return {
    start:
      start,

    end:
      end
  };
}

function buildWeeks(
  start,
  end
) {

  const weeks = [];

  let cursor =
    new Date(
      start.getFullYear(),
      start.getMonth(),
      start.getDate()
    );

  while (
    cursor <= end
  ) {

    weeks.push(
      new Date(
        cursor.getFullYear(),
        cursor.getMonth(),
        cursor.getDate()
      )
    );

    cursor =
      addWeeks(
        cursor,
        1
      );
  }

  return weeks;
}

function buildMonthGroups(
  weeks
) {

  const groups = [];

  weeks.forEach(
    week => {

      const key =
        week.getFullYear() +
        '-' +
        String(
          week.getMonth() + 1
        ).padStart(
          2,
          '0'
        );

      const label =
        week.toLocaleDateString(
          undefined,
          {
            month: 'long',
            year: 'numeric'
          }
        );

      const last =
        groups[
          groups.length - 1
        ];

      if (
        last &&
        last.key === key
      ) {

        last.count += 1;

      } else {

        groups.push({
          key:
            key,

          label:
            label,

          count:
            1
        });

      }

    }
  );

  return groups;
}

function ganttBarClass(
  row
) {

  const value =
    String(
      row.health ||
      row.status ||
      ''
    )
      .trim()
      .toLowerCase();

  if (
    value === 'on track'
  ) {
    return 'gantt-bar-on-track';
  }

  if (
    value === 'at risk'
  ) {
    return 'gantt-bar-at-risk';
  }

  if (
    value === 'overdue'
  ) {
    return 'gantt-bar-overdue';
  }

  if (
    value === 'on hold'
  ) {
    return 'gantt-bar-on-hold';
  }

  if (
    value === 'completed'
  ) {
    return 'gantt-bar-completed';
  }

  if (
    value === 'cancelled'
  ) {
    return 'gantt-bar-cancelled';
  }

  if (
    value === 'not started'
  ) {
    return 'gantt-bar-not-started';
  }

  return 'gantt-bar-default';
}

function renderGantt(
  rows
) {

  const content =
    document.getElementById(
      'ganttContent'
    );

  const scroll =
    document.getElementById(
      'ganttScroll'
    );

  const empty =
    document.getElementById(
      'ganttEmpty'
    );

  const scheduledRows =
    buildScheduledRows(
      rows || []
    );

  const missingCount =
    (rows || []).length -
    scheduledRows.length;

  document.getElementById(
    'ganttPlottedCount'
  ).textContent =
    scheduledRows.length;

  document.getElementById(
    'ganttMissingCount'
  ).textContent =
    missingCount;

  content.innerHTML = '';

  if (
    scheduledRows.length === 0
  ) {

    empty.style.display =
      'block';

    scroll.style.display =
      'none';

    document.getElementById(
      'ganttTimelineSpan'
    ).textContent =
      '-';

    return;
  }

  empty.style.display =
    'none';

  scroll.style.display =
    'block';

  const windowRange =
    getGanttWindow(
      scheduledRows
    );

  const weeks =
    buildWeeks(
      windowRange.start,
      windowRange.end
    );

  const weekWidth =
    meetingModeEnabled
      ? 64
      : 76;

  const timelineWidth =
    weeks.length *
    weekWidth;

  const visibleEndDate =
    addDays(
      weeks[
        weeks.length - 1
      ],
      6
    );

  document.getElementById(
    'ganttTimelineSpan'
  ).textContent =
    formatSpanDate(
      weeks[0]
    ) +
    ' – ' +
    formatSpanDate(
      visibleEndDate
    );

  const headerShell =
    document.createElement(
      'div'
    );

  headerShell.className =
    'gantt-header-shell';

  const infoHeader =
    document.createElement(
      'div'
    );

  infoHeader.className =
    'gantt-info-header';

  [
    'Action Plan',
    'Site',
    'KPI',
    'Owner'
  ].forEach(
    label => {

      const cell =
        document.createElement(
          'div'
        );

      cell.textContent =
        label;

      infoHeader.appendChild(
        cell
      );

    }
  );

  const timelineHeader =
    document.createElement(
      'div'
    );

  timelineHeader.className =
    'gantt-timeline-header';

  timelineHeader.style.width =
    timelineWidth +
    'px';

  const monthRow =
    document.createElement(
      'div'
    );

  monthRow.className =
    'gantt-month-row';

  buildMonthGroups(
    weeks
  ).forEach(
    group => {

      const band =
        document.createElement(
          'div'
        );

      band.className =
        'gantt-month-band';

      band.style.width =
        (
          group.count *
          weekWidth
        ) +
        'px';

      band.textContent =
        group.label;

      monthRow.appendChild(
        band
      );

    }
  );

  const weekRow =
    document.createElement(
      'div'
    );

  weekRow.className =
    'gantt-week-row';

  const currentWeek =
    startOfSundayWeek(
      new Date()
    );

  const currentWeekIndex =
    weeks.findIndex(
      week =>
        dateOnlyTime(week) ===
        dateOnlyTime(
          currentWeek
        )
    );

  weeks.forEach(
    week => {

      const label =
        document.createElement(
          'div'
        );

      label.className =
        'gantt-week-label';

      label.style.width =
        weekWidth +
        'px';

      label.textContent =
        'WB ' +
        week.toLocaleDateString(
          undefined,
          {
            month: '2-digit',
            day: '2-digit'
          }
        );

      weekRow.appendChild(
        label
      );

    }
  );

  timelineHeader.appendChild(
    monthRow
  );

  timelineHeader.appendChild(
    weekRow
  );

  if (
    currentWeekIndex !== -1
  ) {

    const marker =
      document.createElement(
        'div'
      );

    marker.className =
      'gantt-current-marker';

    marker.style.left =
      (
        currentWeekIndex *
        weekWidth
      ) +
      'px';

    timelineHeader.appendChild(
      marker
    );

    const markerLabel =
      document.createElement(
        'div'
      );

    markerLabel.className =
      'gantt-current-marker-label';

    markerLabel.style.left =
      (
        currentWeekIndex *
        weekWidth
      ) +
      'px';

    markerLabel.textContent =
      'Current';

    timelineHeader.appendChild(
      markerLabel
    );
  }

  headerShell.appendChild(
    infoHeader
  );

  headerShell.appendChild(
    timelineHeader
  );

  content.appendChild(
    headerShell
  );

  scheduledRows.forEach(
    item => {

      const row =
        item.row;

      const shell =
        document.createElement(
          'div'
        );

      shell.className =
        'gantt-row-shell';

      const info =
        document.createElement(
          'div'
        );

      info.className =
        'gantt-info-row';

      const actionCell =
        document.createElement(
          'div'
        );

      actionCell.className =
        'gantt-action-name';

      actionCell.textContent =
        row.name ||
        row.id ||
        '-';

      actionCell.title =
        row.id ||
        row.name ||
        '';

      const siteCell =
        document.createElement(
          'div'
        );

      siteCell.className =
        'gantt-meta-text';

      siteCell.textContent =
        row.site ||
        '-';

      const kpiCell =
        document.createElement(
          'div'
        );

      kpiCell.className =
        'gantt-meta-text';

      kpiCell.textContent =
        row.kpi ||
        '-';

      kpiCell.title =
        row.kpi ||
        '';

      const ownerCell =
        document.createElement(
          'div'
        );

      ownerCell.className =
        'gantt-meta-text';

      ownerCell.textContent =
        row.owner ||
        '-';

      ownerCell.title =
        row.owner ||
        '';

      info.appendChild(
        actionCell
      );

      info.appendChild(
        siteCell
      );

      info.appendChild(
        kpiCell
      );

      info.appendChild(
        ownerCell
      );

      const timeline =
        document.createElement(
          'div'
        );

      timeline.className =
        'gantt-timeline-row';

      timeline.style.width =
        timelineWidth +
        'px';

      const cells =
        document.createElement(
          'div'
        );

      cells.className =
        'gantt-week-cells';

      weeks.forEach(
        (week, index) => {

          const cell =
            document.createElement(
              'div'
            );

          cell.className =
            'gantt-week-cell';

          if (
            index ===
            currentWeekIndex
          ) {

            cell.classList.add(
              'current-week-cell'
            );

          }

          cell.style.width =
            weekWidth +
            'px';

          cells.appendChild(
            cell
          );

        }
      );

      timeline.appendChild(
        cells
      );

      if (
        currentWeekIndex !== -1
      ) {

        const marker =
          document.createElement(
            'div'
          );

        marker.className =
          'gantt-current-marker';

        marker.style.left =
          (
            currentWeekIndex *
            weekWidth
          ) +
          'px';

        timeline.appendChild(
          marker
        );
      }

      const startWeek =
        startOfSundayWeek(
          item.start
        );

      const endWeek =
        startOfSundayWeek(
          item.end
        );

      const timelineStart =
        weeks[0];

      const timelineEnd =
        weeks[
          weeks.length - 1
        ];

      if (
        endWeek <
        timelineStart
      ) {

        const earlier =
          document.createElement(
            'div'
          );

        earlier.className =
          'gantt-offscreen-marker left';

        earlier.textContent =
          'Earlier';

        timeline.appendChild(
          earlier
        );

      } else if (
        startWeek >
        timelineEnd
      ) {

        const later =
          document.createElement(
            'div'
          );

        later.className =
          'gantt-offscreen-marker right';

        later.textContent =
          'Later';

        timeline.appendChild(
          later
        );

      } else {

        const clippedStart =
          startWeek <
          timelineStart
            ? timelineStart
            : startWeek;

        const clippedEnd =
          endWeek >
          timelineEnd
            ? timelineEnd
            : endWeek;

        const startIndex =
          weeksBetween(
            timelineStart,
            clippedStart
          );

        const endIndex =
          weeksBetween(
            timelineStart,
            clippedEnd
          );

        const bar =
          document.createElement(
            'div'
          );

        bar.className =
          'gantt-bar ' +
          ganttBarClass(
            row
          );

        bar.style.left =
          (
            startIndex *
            weekWidth +
            4
          ) +
          'px';

        bar.style.width =
          Math.max(
            8,
            (
              (
                endIndex -
                startIndex +
                1
              ) *
              weekWidth
            ) -
            8
          ) +
          'px';

        bar.textContent =
          row.status ||
          row.health ||
          '';

        bar.title =
          (
            row.name ||
            row.id ||
            ''
          ) +
          ' | ' +
          formatSpanDate(
            item.start
          ) +
          ' – ' +
          formatSpanDate(
            item.end
          ) +
          ' | ' +
          (
            row.health ||
            row.status ||
            ''
          );

        timeline.appendChild(
          bar
        );
      }

      shell.appendChild(
        info
      );

      shell.appendChild(
        timeline
      );

      content.appendChild(
        shell
      );

    }
  );

  if (
    !meetingModeEnabled &&
    currentWeekIndex !== -1
  ) {

    setTimeout(
      function() {

        const target =
          Math.max(
            0,
            (
              currentWeekIndex *
              weekWidth
            ) -
            220
          );

        scroll.scrollLeft =
          target;

      },
      0
    );

  } else {

    scroll.scrollLeft =
      0;

  }
}

function toggleMeetingMode() {

  meetingModeEnabled =
    !meetingModeEnabled;

  if (meetingModeEnabled) {
    switchDashboardTab('dashboard');
  }

  document.body.classList.toggle(
    'meeting-mode',
    meetingModeEnabled
  );

  const button =
    document.getElementById(
      'meetingModeButton'
    );

  button.textContent =
    meetingModeEnabled
      ? 'Exit Screenshot Mode'
      : 'Screenshot Mode';

  renderScreenshotReadout_(
    filteredDashboardRows
  );

  if (
    meetingModeEnabled
  ) {

    closeSiteMenu();

    closeStatusMenu();

    updateMeetingMeta();

    window.scrollTo({
      top: 0,
      behavior: 'smooth'
    });

  }
}

document.addEventListener('keydown', function(event) {
  if (meetingModeEnabled && event.key === 'Escape') {
    toggleMeetingMode();
  }
});

function formatMeetingTimestamp() {

  const now =
    new Date();

  return now.toLocaleString(
    undefined,
    {
      year: 'numeric',
      month: 'short',
      day: '2-digit',
      hour: 'numeric',
      minute: '2-digit'
    }
  );
}

function getSelectionSummary(
  selectedSet,
  availableList,
  allLabel
) {

  const count =
    selectedSet.size;

  if (
    count === 0 ||
    (
      availableList.length > 0 &&
      count === availableList.length
    )
  ) {

    return allLabel;
  }

  return [...selectedSet].join(', ');
}

function updateMeetingMeta() {

  const siteSummary =
    getSelectionSummary(
      selectedSites,
      availableSites,
      'All Sites / Departments'
    );

  const statusSummary =
    getSelectionSummary(
      selectedStatuses,
      availableStatuses,
      'All Statuses'
    );

  const kpi =
    document.getElementById(
      'kpiFilter'
    ).value ||
    'All KPIs';

  const owner =
    document.getElementById(
      'ownerFilter'
    ).value;

  const category =
    document.getElementById(
      'categoryFilter'
    ).value;

  const search =
    document.getElementById(
      'searchFilter'
    ).value.trim();

  const parts = [
    'Scope: ' + siteSummary,
    'Status: ' + statusSummary,
    'KPI: ' + kpi
  ];

  if (owner) {
    parts.push(
      'Owner filter applied'
    );
  }

  if (category) {
    parts.push(
      'Category: ' + category
    );
  }

  if (search) {
    parts.push(
      'Search: "' + search + '"'
    );
  }

  const department = document.getElementById('departmentFilter').value;
  if (department) parts.push('Department: ' + department);

  document.getElementById(
    'meetingFilterSummary'
  ).textContent =
    parts.join(' | ');

  document.getElementById(
    'meetingAsOf'
  ).textContent =
    'As of ' +
    formatMeetingTimestamp();
}

function loadDashboard() {
  loadRegistryFollowUps_();
  loadRegistryStability_();

  beginExecutiveLoading_('Loading registry…');

  google.script.run

    .withSuccessHandler(
      function(rows) {

        dashboardRows =
          rows || [];

        populateFilters();

        applyFilters();
        endExecutiveLoading_();

      }
    )

    .withFailureHandler(
      function(error) {

        endExecutiveLoading_();

        alert(
          'Unable to load dashboard: ' +
          error.message
        );

      }
    )

    .getDashboardData();
}

function populateFilters() {
  fillFilter('departmentFilter', dashboardRows.map(function(row) { return row.department || '<not recorded>'; }), 'All Departments');

  populateSiteFilter();

  fillFilter(
    'kpiFilter',
    dashboardRows.map(
      row => row.kpi
    ),
    'All KPIs'
  );

  populateStatusFilter();

  fillFilter(
    'ownerFilter',
    dashboardRows.map(
      row => row.owner
    ),
    'All Owners'
  );

  fillFilter(
    'categoryFilter',
    dashboardRows.map(
      row => row.category
    ),
    'All Categories'
  );
}

function fillFilter(
  elementId,
  values,
  allLabel
) {

  const select =
    document.getElementById(
      elementId
    );

  const currentValue =
    select.value;

  const uniqueValues =
    [...new Set(
      values.filter(
        value =>
          value &&
          String(value).trim() !== ''
      )
    )]
    .sort();

  select.innerHTML = '';

  const allOption =
    document.createElement(
      'option'
    );

  allOption.value = '';

  allOption.textContent =
    allLabel;

  select.appendChild(
    allOption
  );

  uniqueValues.forEach(
    value => {

      const option =
        document.createElement(
          'option'
        );

      option.value =
        value;

      option.textContent =
        value;

      select.appendChild(
        option
      );

    }
  );

  if (
    uniqueValues.includes(
      currentValue
    )
  ) {

    select.value =
      currentValue;

  }
}

function populateSiteFilter() {

  const preferredOrder = [
    'Global',
    'ARN',
    'HTW',
    'MTQ',
    'PHX'
  ];

  const sitesFromData =
    [...new Set(
      dashboardRows
        .map(
          row => row.site
        )
        .filter(
          value =>
            value &&
            String(value).trim() !== ''
        )
    )];

  availableSites =
    preferredOrder.filter(
      site =>
        sitesFromData.includes(
          site
        )
    );

  sitesFromData
    .sort()
    .forEach(
      site => {

        if (
          !availableSites.includes(
            site
          )
        ) {

          availableSites.push(
            site
          );

        }

      }
    );

  selectedSites =
    new Set(
      [...selectedSites].filter(
        site =>
          availableSites.includes(
            site
          )
      )
    );

  const container =
    document.getElementById(
      'siteFilterOptions'
    );

  container.innerHTML = '';

  availableSites.forEach(
    site => {

      const label =
        document.createElement(
          'label'
        );

      label.className =
        'multi-select-option';

      const checkbox =
        document.createElement(
          'input'
        );

      checkbox.type =
        'checkbox';

      checkbox.value =
        site;

      checkbox.checked =
        selectedSites.has(
          site
        );

      checkbox.addEventListener(
        'change',
        function() {

          if (this.checked) {

            selectedSites.add(
              site
            );

          } else {

            selectedSites.delete(
              site
            );

          }

          updateSiteFilterLabel();

          applyFilters();

        }
      );

      const text =
        document.createElement(
          'span'
        );

      text.textContent =
        site;

      label.appendChild(
        checkbox
      );

      label.appendChild(
        text
      );

      container.appendChild(
        label
      );

    }
  );

  updateSiteFilterLabel();
}

function updateSiteFilterLabel() {

  const label =
    document.getElementById(
      'siteFilterLabel'
    );

  const count =
    selectedSites.size;

  if (
    count === 0 ||
    (
      availableSites.length > 0 &&
      count === availableSites.length
    )
  ) {

    label.textContent =
      'All Sites / Departments';

    return;
  }

  const values =
    [...selectedSites];

  if (
    count <= 2
  ) {

    label.textContent =
      values.join(', ');

    return;
  }

  label.textContent =
    count + ' selected';
}

