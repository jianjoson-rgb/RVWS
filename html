function formatActionDaysLeft_(row) {
  if (!row) return '-';

  if (row.status === 'Completed' || row.status === 'Cancelled') {
    return '—';
  }

  if (row.daysRemaining === '' || row.daysRemaining == null) {
    return '—';
  }

  const days = Number(String(row.daysRemaining).replace(/,/g, ''));

  if (!Number.isFinite(days)) {
    return '—';
  }

  if (days === 0) {
    return 'Due Today';
  }

  return String(days);
}

function renderActionTable(rows) {
