  const button = document.getElementById('createActionButton');
  const kpiName = document.getElementById('newKpi').value;
  const kpiSetting =
    creationKpiSettings[String(kpiName || '').toLowerCase()] || {};

  const payload = {
    site: document.getElementById('newSite').value,
    actionPlanName: document.getElementById('newActionName').value,
    actionDescription: document.getElementById('newActionDescription').value,
    kpi: document.getElementById('newMeasurementMethod').value==='Governance outcome'?'':kpiName,
    measurementMethod:document.getElementById('newMeasurementMethod').value,
    governanceCurrentProblem:document.getElementById('newGovernanceCurrentProblem').value,
    governanceExpectedOutcome:document.getElementById('newGovernanceExpectedOutcome').value,
    governanceAcceptanceCriteria:document.getElementById('newGovernanceAcceptanceCriteria').value,
    governanceVerificationMethod:document.getElementById('newGovernanceVerificationMethod').value,
    owner: document.getElementById('newOwner').value,
    category: document.getElementById('newCategory').value,
    actionType: document.getElementById('newType').value,
    activity: document.getElementById('newActivity').value,
    department: document.getElementById('newDepartment').value,
    channel: document.getElementById('newChannel').value,
    lob: document.getElementById('newLob').value,
    cohort: document.getElementById('newCohort').value,
    cohortDetails: document.getElementById('newCohortDetails').value,
    baseline: document.getElementById('newMeasurementMethod').value==='Governance outcome'?'':parseMetricInputForKpi_(
      document.getElementById('newBaseline').value,
      kpiName,
      kpiSetting.unit
    ),
    goal: document.getElementById('newMeasurementMethod').value==='Governance outcome'?'':parseMetricInputForKpi_(
      document.getElementById('newGoal').value,
      kpiName,
      kpiSetting.unit
    ),
    startDate: document.getElementById('newStartDate').value,
    endDate: document.getElementById('newEndDate').value,
    actionStatus: document.getElementById('newStatus').value,
    glideAvailable: document.getElementById('newGlideAvailable').value,
    glideUrl: document.getElementById('newGlideUrl').value.trim()
  };

  const requiredText = [
    ['Site / Department', payload.site],
    ['Channel', payload.channel], ['LOB', payload.lob], ['Cohort', payload.cohort],
    ['Action Plan Name', payload.actionPlanName],
    ['Action Steps', payload.actionDescription],
    ['Target KPI / Behavior', payload.measurementMethod==='Governance outcome'?'Governance outcome':payload.kpi],
    ['Action Owner', payload.owner],
    ['Action Category', payload.category],
    ['Action Type', payload.actionType], ['Activity', payload.activity],
    ['Start Date', payload.startDate],
    ['Target End Date', payload.endDate],
    ['Action Status', payload.actionStatus], ['Glide path available', payload.glideAvailable]
  ];

  const governance=payload.measurementMethod==='Governance outcome';
  if(governance){[['Current governance problem',payload.governanceCurrentProblem],['Expected governance outcome',payload.governanceExpectedOutcome],['Acceptance criteria',payload.governanceAcceptanceCriteria],['Verification method',payload.governanceVerificationMethod]].forEach(function(pair){requiredText.push(pair);});}
  const missing = requiredText.find(function(item) {
    return !String(item[1] || '').trim();
  });

  if (missing) {
    message.textContent = missing[0] + ' is required.';
    return;
  }

  if (isTargetedCohort_(payload.cohort) && !payload.cohortDetails.trim()) {
    message.textContent = 'Specify the targeted population in Cohort Details.'; return;
  }
  if (!governance && String(kpiSetting.unit || '').toLowerCase() === 'count' &&
    (!Number.isSafeInteger(payload.baseline) || payload.baseline < 0 || !Number.isSafeInteger(payload.goal) || payload.goal < 0)) {
    message.textContent = 'Count KPIs require non-negative whole numbers.'; return;
  }
  payload.owner = String(payload.owner || '').trim().toLowerCase();

  if (!/^[A-Z0-9._%+\-]+@taskus\.com$/i.test(payload.owner)) {
    message.textContent =
      'Action Owner must be a valid @taskus.com email address.';
    document.getElementById('newOwner').focus();
    return;
  }

  if (!governance && !Number.isFinite(payload.baseline)) {
    message.textContent = 'Please enter a valid Baseline Performance.';
    return;
  }

  if (!governance && !Number.isFinite(payload.goal)) {
    message.textContent = 'Please enter a valid End Goal / Target.';
    return;
  }

  if (
    !governance && String(kpiSetting.unit || '').trim() === '%' &&
    (
      payload.baseline < 0 || payload.baseline > 1 ||
      payload.goal < 0 || payload.goal > 1
    )
  ) {
    message.textContent =
      'Percentage KPI values must be 0 to 1 or include %, e.g. 0.82 or 82%.';
    return;
  }

  if (payload.endDate < payload.startDate) {
    message.textContent =
      'Target End Date cannot be earlier than Start Date.';
    return;
  }

  if (!validateRegistryGlideClient_(payload, message)) return;
  if (editingRevision) { saveRegistryRevision_(payload); return; }
  const signature = JSON.stringify(payload);
  const requestToken = retryToken_('CREATE', signature);
  setRegistryCreationBusy_(true);
  button.disabled = true;
  button.textContent = 'Registering...';
  message.textContent = 'Creating action plan...';
  beginExecutiveLoading_('Creating action plan...');

  google.script.run
    .withSuccessHandler(function(result) {
    registryNoticeQueueWarning_(result);
      finishRetry_('CREATE', signature);
      registryCreationLocked = true;
      registryCreationContextId = result.actionPlanId;
      setRegistryCreationBusy_(false);
      endExecutiveLoading_();
      button.textContent = 'Registration Disabled';
      message.textContent =
        'Registered ' + (result && result.actionPlanId ? result.actionPlanId : 'action') + ' · Pending Review.';

      clearNewActionForm_();
      const dropdown = document.getElementById('actionPlan');
