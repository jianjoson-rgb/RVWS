    );

  document.getElementById(
    'ganttTimelineSpan'
  ).textContent =
    formatSpanDate(
      weeks[0]
    ) +
    ' – ' +
    formatSpanDate(
      visibleEndDate
    );

  const headerShell =
    document.createElement(
      'div'
    );

  headerShell.className =
    'gantt-header-shell';

  const infoHeader =
    document.createElement(
      'div'
    );

  infoHeader.className =
    'gantt-info-header';

