    getGanttWindow(
      scheduledRows
    );

  const weeks =
    buildWeeks(
      windowRange.start,
      windowRange.end
    );

  const weekWidth =
    meetingModeEnabled
      ? 64
      : 76;

  const timelineWidth =
    weeks.length *
