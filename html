function getGanttWindow(
  scheduledRows
) {

  if (
    scheduledRows.length === 0
  ) {
    return null;
  }

  const earliestStart =
    scheduledRows.reduce(
      (minimum, item) =>
        item.start < minimum
          ? item.start
          : minimum,
      scheduledRows[0].start
    );

  const latestEnd =
    scheduledRows.reduce(
      (maximum, item) =>
        item.end > maximum
          ? item.end
          : maximum,
      scheduledRows[0].end
    );

  const earliestWeek =
    startOfSundayWeek(
      earliestStart
    );

  const latestWeek =
    startOfSundayWeek(
      latestEnd
    );

  if (
    !meetingModeEnabled
  ) {

    return {
      start:
        earliestWeek,

      end:
        latestWeek
    };
  }

  const currentWeek =
    startOfSundayWeek(registryGanttToday_());

  let start =
    addWeeks(
      currentWeek,
      -3
    );

  let end =
    addWeeks(
      start,
      13
    );

  const overlapsMeetingWindow =
    scheduledRows.some(
      item => {

        const itemStart =
          startOfSundayWeek(
            item.start
          );

        const itemEnd =
          startOfSundayWeek(
            item.end
          );

        return (
          itemEnd >= start &&
          itemStart <= end
        );

      }
    );

  if (
    !overlapsMeetingWindow
  ) {

    if (
      earliestWeek >
      end
    ) {

      start =
        earliestWeek;

      end =
        addWeeks(
          start,
          13
        );

    } else if (
      latestWeek <
      start
    ) {

      end =
        latestWeek;

      start =
        addWeeks(
          end,
          -13
        );

    }
  }

  return {
    start:
      start,

    end:
      end
  };
}

function buildWeeks(start,end) {
  const weeks=[];
  let cursor=new Date(dateOnlyTime(start));
  while (cursor <= end) { weeks.push(new Date(cursor.getTime()));cursor=addWeeks(cursor,1); }
  return weeks;
}

function buildMonthGroups(weeks) {
  const groups=[];
  weeks.forEach(function(week) {
    const key=week.getUTCFullYear()+'-'+String(week.getUTCMonth()+1).padStart(2,'0');
    const label=week.toLocaleDateString('en-PH',{timeZone:'UTC',month:'long',year:'numeric'});
    const last=groups[groups.length-1];
    if (last && last.key===key) last.count+=1;else groups.push({key:key,label:label,count:1});
  });
  return groups;
}

function ganttBarClass(
  row
) {

  const value =
    String(
      row.health ||
      row.status ||
      ''
    )
      .trim()
      .toLowerCase();

  if (
    value === 'on track'
  ) {
    return 'gantt-bar-on-track';
  }

  if (
    value === 'at risk'
  ) {
    return 'gantt-bar-at-risk';
  }

  if (
    value === 'overdue'
  ) {
    return 'gantt-bar-overdue';
  }

  if (
    value === 'on hold'
  ) {
    return 'gantt-bar-on-hold';
  }

  if (
    value === 'completed'
  ) {
    return 'gantt-bar-completed';
  }

  if (
    value === 'cancelled'
  ) {
    return 'gantt-bar-cancelled';
  }

  if (
    value === 'not started'
  ) {
    return 'gantt-bar-not-started';
  }

  return 'gantt-bar-default';
}

