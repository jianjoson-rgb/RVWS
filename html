function applyFilters() {
  const department = document.getElementById('departmentFilter').value;
  const search = document.getElementById('searchFilter').value
    .trim()
    .toLowerCase();

  const siteFilterIsActive =
    selectedSites.size > 0 &&
    selectedSites.size < availableSites.length;

  const kpi = document.getElementById('kpiFilter').value;

  const statusFilterIsActive =
    selectedStatuses.size > 0 &&
    selectedStatuses.size < availableStatuses.length;

  const owner = document.getElementById('ownerFilter').value;
  const category = document.getElementById('categoryFilter').value;

  function matchesNonSiteFilters(row) {
    const searchText = [
      row.id,
      row.site,
      row.name,
      row.description, row.governanceExpectedOutcome, row.governanceAcceptanceCriteria,
      row.department,
      row.kpi,
      row.owner,
      row.category,
      row.status,
      row.health,
      row.outcome
    ].join(' ').toLowerCase();

    return (
      (!search || searchText.includes(search)) &&
      (!kpi || row.kpi === kpi) &&
      (!statusFilterIsActive || selectedStatuses.has(row.status)) &&
      (!department || (row.department || '<not recorded>') === department) &&
      (!owner || row.owner === owner) &&
      (!category || row.category === category)
    );
  }

  const matrixRows = dashboardRows.filter(matchesNonSiteFilters);

  const filtered = matrixRows.filter(function(row) {
    return !siteFilterIsActive || selectedSites.has(row.site);
  });

  updateSummaryCards(filtered);
  updateFilteredCounts(filtered.length, dashboardRows.length);

  filteredDashboardRows = filtered;

  renderSiteMatrix(matrixRows);
  renderSinceLastReview(filtered);
  renderRegistryApprovalQueue_(filtered);
  renderRegistryEffectivenessSummary_(filtered);
  renderRegistryCategoryMix_(filtered);
  renderRegistryStability_(filtered);
  renderRegistryFirstAssessmentQueue_(filtered);
  renderRegistryWeeklyCoverage_(filtered);
  renderRegistryReviewAccountability_(filtered);
  renderRegistryFollowUps_();
  renderTopExceptions(filtered);
  actionTablePage_ = 1;
  renderActionTable(filtered);
  renderGantt(filtered);
  renderScreenshotReadout_(filtered);
  renderRegistryMyWork_();

  if (meetingModeEnabled) {
    updateMeetingMeta();
    renderCaptureSurface_(filtered);
  }
}

function selectSiteFromMatrix_(site) {
  if (!site) return;

  if (
    selectedSites.size === 1 &&
    selectedSites.has(site)
  ) {
    selectedSites = new Set(availableSites);
  } else {
    selectedSites = new Set([site]);
  }

  refreshSiteCheckboxes();
  closeSiteMenu();
  applyFilters();
}

function registrySchedulePending_(row) {
  return !!row && !['On Track','At Risk','Overdue'].includes(String(row.health || '').trim());
}
function registryKpiOutcomePending_(row) {
  return row && row.measurementMethod !== 'Governance outcome' &&
    (!registryKpiConfigured_(row) || !['Goal Met','Improving','Unchanged','Worsening'].includes(String(row.outcome || '').trim()));
}
function registryCountWithPending_(count, pending, unknownDefinition) {
  if (unknownDefinition && Number(count) === 0) return '—';
  return String(count) + ((pending || unknownDefinition) ? '*' : '');
}
function registryScheduleAvailabilityUncertain_(){return scheduleHealthAnchorFormulaPresent_!==true || scheduleHealthAnchorFormulaError_!==false;}
function registryScheduleNotice_(rows) {
  const missing=(rows||[]).filter(function(row){return !String(row.health||'').trim();}).length;
  const review=(rows||[]).filter(function(row){return !!String(row.health||'').trim()&&registrySchedulePending_(row);}).length;
  const parts=[];
  if (scheduleHealthAnchorFormulaError_ === true) parts.push('Schedule health calculation reports an error and requires review.');
  else if (scheduleHealthAnchorFormulaPresent_ === false) parts.push('Schedule health may be incomplete; classification coverage has not been verified.');
  else if (scheduleHealthAnchorFormulaPresent_ === null || scheduleHealthAnchorFormulaError_ === null) parts.push('Schedule health availability could not be verified.');
  if(missing)parts.push(missing+' plan(s) have no schedule classification.');
  if(review)parts.push(review+' plan(s) have an unsupported schedule value or formula error requiring review.');
  if(parts.length)parts.push('* Counts show recorded classifications only; unclassified plans are not assumed to be on track. — means unavailable.');
  return parts.join(' ');
}
function registryScheduleText_(value){
  const text=String(value||'').trim();
  return !text?'Pending / unavailable':['On Track','At Risk','Overdue'].includes(text)?text:'Schedule value requires review: '+text;
}
function registryKpiPendingCount_(rows){return (rows||[]).filter(registryKpiOutcomePending_).length;}
function registryKpiConfigured_(setting) { return !!setting && /^(higher|lower)( is better)?$/i.test(String(setting.direction||'').trim()) && !!String(setting.unit||'').trim(); }

function renderSiteMatrix(rows) {
  const body = document.getElementById('siteMatrixBody');
  if (!body) return;

  body.innerHTML = '';
  const siteNotice=document.getElementById('scheduleSiteNotice');
  if(siteNotice)siteNotice.textContent=registryScheduleNotice_(rows) + (registryKpiPendingCount_(rows)?' * Goal Met counts exclude plans with unavailable KPI outcomes.':'');

  const siteSet = new Set(availableSites || []);

  (rows || []).forEach(function(row) {
    if (row.site) {
      siteSet.add(row.site);
    }
  });

  const preferredOrder = ['Global', 'ARN', 'HTW', 'MTQ', 'PHX'];

  const sites = Array.from(siteSet).sort(function(a, b) {
    const ai = preferredOrder.indexOf(a);
    const bi = preferredOrder.indexOf(b);

    if (ai !== -1 || bi !== -1) {
      if (ai === -1) return 1;
      if (bi === -1) return -1;
      return ai - bi;
    }

    return a.localeCompare(b);
  });

  sites.forEach(function(site) {
    const siteRows = (rows || []).filter(function(row) {
      return row.site === site;
    });

    const active = siteRows.filter(function(row) {
      return row.status !== 'Completed' && row.status !== 'Cancelled';
    }).length;

    const onTrack = siteRows.filter(function(row) {
      return row.health === 'On Track';
    }).length;

    const atRisk = siteRows.filter(function(row) {
      return row.health === 'At Risk';
    }).length;

    const overdue = siteRows.filter(function(row) {
      return row.health === 'Overdue';
    }).length;

    const goalMet = siteRows.filter(function(row) {
      return row.outcome === 'Goal Met' && !registryKpiOutcomePending_(row);
    }).length;

    const tr = document.createElement('tr');

    if (
      selectedSites.size === 1 &&
      selectedSites.has(site)
    ) {
      tr.className = 'selected-site-row';
    }

    tr.tabIndex = 0;
    tr.setAttribute('role', 'button');
    tr.setAttribute('aria-label', 'Filter portfolio to ' + site);

    tr.onclick = function() {
      selectSiteFromMatrix_(site);
    };

    tr.onkeydown = function(event) {
      if (event.key === 'Enter' || event.key === ' ') {
        event.preventDefault();
        selectSiteFromMatrix_(site);
      }
    };

    const pending=siteRows.filter(registrySchedulePending_).length, kpiPending=registryKpiPendingCount_(siteRows);
    const definitionUnknown=registryScheduleAvailabilityUncertain_();
    [site, active, registryCountWithPending_(onTrack,pending,definitionUnknown), registryCountWithPending_(atRisk,pending,definitionUnknown), registryCountWithPending_(overdue,pending,definitionUnknown), registryCountWithPending_(goalMet,kpiPending,false)].forEach(
      function(value, index) {
        const td = document.createElement('td');
        td.textContent = value;
        td.className = index === 0
          ? 'site-name-cell'
          : 'site-metric-cell';
        tr.appendChild(td);
      }
    );

    body.appendChild(tr);
  });
}

function getReviewWeekStart_() {
  const now = new Date();
  const parts = new Intl.DateTimeFormat('en-CA', {
    timeZone: 'Asia/Manila', year: 'numeric', month: '2-digit', day: '2-digit'
  }).formatToParts(now);
  const value = {};
  parts.forEach(function(part) { if (part.type !== 'literal') value[part.type] = Number(part.value); });
  const day = new Date(Date.UTC(value.year, value.month - 1, value.day));
  day.setUTCDate(day.getUTCDate() - day.getUTCDay());
  return day;
}

function parseClientIso_(value) {
  if (!value) return null;
  const parsed = new Date(value);
  return Number.isNaN(parsed.getTime()) ? null : parsed;
}

function isOnOrAfterReviewStart_(value, reviewStart) {
  const key = registryBusinessDateKey_(value);
  const today = registryBusinessDateKey_(new Date().toISOString());
  return !!key && key >= reviewStart.toISOString().slice(0, 10) && key <= today;
}

function registryBusinessDateKey_(value) {
  if (!value) return '';
  const raw = String(value);
  if (/^\d{4}-\d{2}-\d{2}$/.test(raw)) return raw;
  const parsed = parseClientIso_(raw);
  if (!parsed) return '';
  const parts = new Intl.DateTimeFormat('en-CA', {
    timeZone: 'Asia/Manila', year: 'numeric', month: '2-digit', day: '2-digit'
  }).formatToParts(parsed);
  const valueParts = {};
  parts.forEach(function(part) { if (part.type !== 'literal') valueParts[part.type] = part.value; });
  return valueParts.year + '-' + valueParts.month + '-' + valueParts.day;
}

function formatReviewWeekLabel_(reviewStart) {
  const month = String(reviewStart.getUTCMonth() + 1).padStart(2, '0');
  const day = String(reviewStart.getUTCDate()).padStart(2, '0');
  return 'Review week WB' + month + day + ' (Sunday-Saturday)';
}

function renderSinceLastReview(rows) {
  const reviewStart = getReviewWeekStart_();
  const now = new Date();
  const scopedRows = rows || [];

  const completed = scopedRows.filter(function(row) {
    return (
      row.status === 'Completed' &&
      isOnOrAfterReviewStart_(row.completionDateIso, reviewStart)
    );
  }).length;

  const goalMet = scopedRows.filter(function(row) {
    return (
      row.outcome === 'Goal Met' && !registryKpiOutcomePending_(row) &&
      isOnOrAfterReviewStart_(row.lastUpdatedDateIso, reviewStart)
    );
  }).length;

  const updatedAtRisk = scopedRows.filter(function(row) {
    return (
      row.health === 'At Risk' &&
      isOnOrAfterReviewStart_(row.lastUpdatedDateIso, reviewStart)
    );
  }).length;

  const overdueDueThisWeek = scopedRows.filter(function(row) {
    const endDate = registryBusinessDateKey_(row.endDateIso);
    return (
      row.health === 'Overdue' &&
      endDate &&
      endDate >= reviewStart.toISOString().slice(0, 10) &&
      endDate < registryBusinessDateKey_(now.toISOString())
    );
  }).length;

  const updatedOnTrack = scopedRows.filter(function(row) {
    return (
      row.health === 'On Track' &&
      !registryKpiOutcomePending_(row) && (row.outcome === 'Improving' || row.outcome === 'Goal Met') &&
      isOnOrAfterReviewStart_(row.lastUpdatedDateIso, reviewStart)
    );
  }).length;

  const completedEl = document.getElementById('reviewCompletedCount');
  if (!completedEl) return;

  completedEl.textContent = completed;
  document.getElementById('reviewGoalMetCount').textContent = goalMet;
  const pending=scopedRows.filter(registrySchedulePending_).length, unknown=registryScheduleAvailabilityUncertain_();
  document.getElementById('reviewAtRiskCount').textContent = registryCountWithPending_(updatedAtRisk,pending,unknown);
  document.getElementById('reviewOverdueCount').textContent = registryCountWithPending_(overdueDueThisWeek,pending,unknown);
  document.getElementById('reviewRecoveredCount').textContent = registryCountWithPending_(updatedOnTrack,pending,unknown);
  document.getElementById('reviewWindowLabel').textContent =
    formatReviewWeekLabel_(reviewStart);
}

function topExceptionPriority_(row) {
  if (row.health === 'Overdue') return 0;
  if (row.health === 'At Risk') return 1;
  return 9;
}

function outcomePriority_(outcome) {
  const order = {
    'Worsening': 0,
    'Unchanged': 1,
    'Insufficient Data': 2,
    'Improving': 3,
    'Goal Met': 4
  };

  return Object.prototype.hasOwnProperty.call(order, outcome)
    ? order[outcome]
    : 5;
}

function numericDaysRemaining_(value) {
  const text = String(value == null ? '' : value).replace(/,/g, '').trim();
  if (!text) return Number.MAX_SAFE_INTEGER;
  const number = Number(text);
  return Number.isFinite(number) ? number : Number.MAX_SAFE_INTEGER;
}

function renderTopExceptions(rows) {
  const card = document.getElementById('topExceptionsCard');
  const body = document.getElementById('topExceptionsBody');
  const empty = document.getElementById('topExceptionsEmpty');
  const count = document.getElementById('topExceptionsCount');

  if (!card || !body || !empty || !count) return;

  const exceptions = (rows || [])
    .filter(function(row) {
      return row.health === 'Overdue' || row.health === 'At Risk';
    })
    .sort(function(a, b) {
      const healthDifference = topExceptionPriority_(a) - topExceptionPriority_(b);
      if (healthDifference !== 0) return healthDifference;

      const dayDifference = numericDaysRemaining_(a.daysRemaining) -
        numericDaysRemaining_(b.daysRemaining);
      if (dayDifference !== 0) return dayDifference;

      return outcomePriority_(a.outcome) - outcomePriority_(b.outcome);
    });

  count.textContent = exceptions.length +
    (exceptions.length === 1 ? ' exception' : ' exceptions');

  body.innerHTML = '';

  if (exceptions.length === 0) {
    card.style.display = 'none';
    empty.style.display = 'none';
    return;
  }

  card.style.display = '';
  empty.style.display = 'none';

  exceptions.slice(0, 5).forEach(function(row) {
    const tr = document.createElement('tr');

    appendOpenActionCell_(tr, row.id);
    appendTextCell(tr, row.site);
    appendTextCell(tr, row.name);
    const brief = document.createElement('div'); brief.className = 'capture-action-summary'; brief.textContent = registryActionExcerpt_(row.description)+(row.measurementMethod==='Governance outcome'?' · Outcome: '+registryActionExcerpt_(row.governanceExpectedOutcome):'');
    tr.lastElementChild.appendChild(brief);
    appendTextCell(tr, row.kpi);
    appendTextCell(
      tr,
      formatKpiValue(row.current, row.unit, row.kpi),
      'metric-value'
    );
    appendTextCell(
      tr,
      formatKpiValue(row.goal, row.unit, row.kpi),
      'metric-value'
    );
    appendBadgeCell(tr, row.health);
    appendBadgeCell(tr, row.outcome);
    appendTextCell(tr, row.owner);
    appendTextCell(tr, row.endDate);
    appendTextCell(
      tr,
      row.daysRemaining === '' || row.daysRemaining == null
        ? '-'
        : row.daysRemaining,
      numericDaysRemaining_(row.daysRemaining) < 0 ? 'exception-days-negative' : ''
    );

    body.appendChild(tr);
  });
}

