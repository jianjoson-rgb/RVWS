function registryEffectivenessSummary_(rows) {
  const counts={Validated:0,'Partially Effective':0,'No Observable Effect':0,'Insufficient Evidence':0,'Not Yet Assessed':0};
  let unknown=0, completed=0, completedValidated=0, completedUnassessed=0;
  (rows || []).forEach(function(row) {
    const rating=String(row.effectivenessStatus || 'Not Yet Assessed');
    if (Object.prototype.hasOwnProperty.call(counts,rating)) counts[rating]++; else unknown++;
    if (row.status==='Completed') {
      completed++; if (rating==='Validated') completedValidated++;
      if (rating==='Not Yet Assessed') completedUnassessed++;
    }
  });
  const total=(rows || []).length, assessed=total-counts['Not Yet Assessed']-unknown;
  return {counts:counts,total:total,assessed:assessed,unknown:unknown,completed:completed,
    completedValidated:completedValidated,completedUnassessed:completedUnassessed};
}
