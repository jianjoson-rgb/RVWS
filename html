}

function populateFilters() {
  fillFilter('departmentFilter', dashboardRows.map(function(row) { return row.department || '<not recorded>'; }), 'All Authorized Departments');

  populateSiteFilter();

  fillFilter(
    'kpiFilter',
    dashboardRows.map(
      row => row.kpi
    ),
    'All KPIs'
  );

  populateStatusFilter();

  fillFilter(
    'ownerFilter',
    dashboardRows.map(
      row => row.owner
    ),
    'All Owners'
  );

  fillFilter(
    'categoryFilter',
    dashboardRows.map(
      row => row.category
    ),
    'All Categories'
  );
}

function fillFilter(
  elementId,
  values,
  allLabel
) {

  const select =
    document.getElementById(
      elementId
    );

  const currentValue =
    select.value;

  const uniqueValues =
    [...new Set(
      values.filter(
        value =>
          value &&
          String(value).trim() !== ''
      )
    )]
    .sort();

  select.innerHTML = '';

  const allOption =
    document.createElement(
      'option'
    );

  allOption.value = '';

  allOption.textContent =
    allLabel;

  select.appendChild(
    allOption
  );

  uniqueValues.forEach(
    value => {

      const option =
        document.createElement(
          'option'
        );

      option.value =
        value;

      option.textContent =
        value;

      select.appendChild(
        option
      );

    }
  );

  if (
    uniqueValues.includes(
      currentValue
    )
  ) {

    select.value =
      currentValue;

  }
}

function populateSiteFilter() {

  const preferredOrder = [
    'Global',
    'ARN',
    'HTW',
    'MTQ',
    'PHX'
  ];

  const sitesFromData =
    [...new Set(
      dashboardRows
        .map(
          row => row.site
        )
        .filter(
          value =>
            value &&
            String(value).trim() !== ''
        )
    )];

  availableSites =
    preferredOrder.filter(
      site =>
        sitesFromData.includes(
          site
        )
    );

  sitesFromData
    .sort()
    .forEach(
      site => {

        if (
          !availableSites.includes(
            site
          )
        ) {

          availableSites.push(
            site
          );

        }

      }
    );

  selectedSites =
    new Set(
      [...selectedSites].filter(
        site =>
          availableSites.includes(
            site
          )
      )
    );

  const container =
    document.getElementById(
      'siteFilterOptions'
    );

  container.innerHTML = '';

  availableSites.forEach(
    site => {

      const label =
        document.createElement(
          'label'
        );

      label.className =
        'multi-select-option';

      const checkbox =
        document.createElement(
          'input'
        );

      checkbox.type =
        'checkbox';

      checkbox.value =
        site;

      checkbox.checked =
        selectedSites.has(
          site
        );

      checkbox.addEventListener(
        'change',
        function() {

          if (this.checked) {

            selectedSites.add(
              site
            );

          } else {

            selectedSites.delete(
              site
            );

          }

          updateSiteFilterLabel();

          applyFilters();

        }
      );

      const text =
        document.createElement(
          'span'
        );

      text.textContent =
        site;

      label.appendChild(
        checkbox
      );

      label.appendChild(
        text
      );

      container.appendChild(
        label
      );

    }
  );

  updateSiteFilterLabel();
}

function updateSiteFilterLabel() {

  const label =
    document.getElementById(
      'siteFilterLabel'
    );

  const count =
    selectedSites.size;

  if (
    count === 0 ||
    (
      availableSites.length > 0 &&
      count === availableSites.length
    )
  ) {

    label.textContent =
      'All authorized sites';

    return;
  }

  const values =
    [...selectedSites];

  if (
    count <= 2
  ) {

    label.textContent =
      values.join(', ');

    return;
  }

  label.textContent =
    count + ' selected';
}

