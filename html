function registryReviewDate_(iso) {
  const value=Date.parse(iso);
  return Number.isFinite(value)?new Date(value+8*3600000).toISOString().slice(0,10):'Not recorded';
}
function registryReviewWaitDays_(row, now) {
  if (row.reviewStatus!=='Pending Review') return null;
  const submitted=Date.parse(row.reviewSubmittedAtIso || '');
  if (!Number.isFinite(submitted)) return null;
  const today=registryReviewDate_((now || new Date()).toISOString()), start=registryReviewDate_(row.reviewSubmittedAtIso);
  const days=Math.floor((Date.parse(today+'T00:00:00Z')-Date.parse(start+'T00:00:00Z'))/86400000);
  return days<0?null:days;
}
function registryReviewSummary_(rows, now) {
  const sites={}, reviewers={}, warnings=new Set(); let enrolled=0, pending=0, missing=0, legacy=0;
  (rows || []).forEach(function(row) {
    (row.reportingWarnings || []).forEach(function(w){warnings.add(w);});
    if (!row.approvalRequired) {legacy++; return;}
    enrolled++; const site=row.department?row.site+' / '+row.department:row.site || 'Not recorded';
    const x=sites[site] || (sites[site]={site:site,pending:0,approved:0,returned:0,declined:0,oldest:null,missing:0,unknownDate:0});
    if (row.reviewStatus==='Pending Review') {
      pending++; x.pending++;
      if (!(row.eligibleReviewers || []).length) {missing++;x.missing++;}
      const days=registryReviewWaitDays_(row,now);
      if (days===null) x.unknownDate++; else x.oldest=x.oldest===null?days:Math.max(x.oldest,days);
    }
    const key={Approved:'approved','Returned for Revision':'returned',Declined:'declined'}[row.reviewStatus];
    if (key) x[key]++;
    const review=row.latestReview;
    if (!review || review.actionPlanId!==String(row.id) || review.planVersion!==row.planVersion || !key || review.decision!==row.reviewStatus) return;
    const actor=review.email || review.name;
    const activity=reviewers[actor] || (reviewers[actor]={name:review.name || review.email,approved:0,returned:0,declined:0,latest:''});
    activity[key]++; if (review.reviewedAt>activity.latest) activity.latest=review.reviewedAt;
  });
  return {enrolled:enrolled,pending:pending,missing:missing,legacy:legacy,
    sites:Object.keys(sites).sort().map(function(key){return sites[key];}),
    reviewers:Object.keys(reviewers).sort().map(function(key){return reviewers[key];}),warnings:Array.from(warnings)};
}
