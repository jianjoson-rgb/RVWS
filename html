function populateStatusFilter() {

  const preferredOrder = [
    'Not Started',
    'Ongoing',
    'On Hold',
    'Completed',
    'Cancelled'
  ];

  const statusesFromData =
    [...new Set(
      dashboardRows
        .map(
          row => row.status
        )
        .filter(
          value =>
            value &&
            String(value).trim() !== ''
        )
    )];

  availableStatuses =
    preferredOrder.filter(
      status =>
        statusesFromData.includes(
          status
        )
    );

  statusesFromData
    .sort()
    .forEach(
      status => {

        if (
          !availableStatuses.includes(
            status
          )
        ) {

          availableStatuses.push(
            status
          );

        }

      }
    );

  selectedStatuses =
    new Set(
      [...selectedStatuses].filter(
        status =>
          availableStatuses.includes(
            status
          )
      )
    );

  const container =
    document.getElementById(
      'statusFilterOptions'
    );

  container.innerHTML = '';

  availableStatuses.forEach(
    status => {

      const label =
        document.createElement(
          'label'
        );

      label.className =
        'multi-select-option';

      const checkbox =
        document.createElement(
          'input'
        );

      checkbox.type =
        'checkbox';

      checkbox.value =
        status;

      checkbox.checked =
        selectedStatuses.has(
          status
        );

      checkbox.addEventListener(
        'change',
        function() {

          if (this.checked) {

            selectedStatuses.add(
              status
            );

          } else {

            selectedStatuses.delete(
              status
            );

          }

          updateStatusFilterLabel();

          applyFilters();

        }
      );

      const text =
        document.createElement(
          'span'
        );

      text.textContent =
        status;

      label.appendChild(
        checkbox
      );

      label.appendChild(
        text
      );

      container.appendChild(
        label
      );

    }
  );

  updateStatusFilterLabel();
}

function updateStatusFilterLabel() {

  const label =
    document.getElementById(
      'statusFilterLabel'
    );

  const count =
    selectedStatuses.size;

  if (
    count === 0 ||
    (
      availableStatuses.length > 0 &&
      count === availableStatuses.length
    )
  ) {

    label.textContent =
      'All Statuses';

    return;
  }

  const values =
    [...selectedStatuses];

  if (
    count <= 2
  ) {

    label.textContent =
      values.join(', ');

    return;
  }

  label.textContent =
    count + ' selected';
}

