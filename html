<script>

let dashboardRows = [];

let selectedKpiUnit = '';

let selectedKpiName = '';

let selectedSites =
  new Set();

let availableSites = [];

let selectedStatuses =
  new Set();

let availableStatuses = [];

let meetingModeEnabled =
  false;

let activeDashboardTab =
  'dashboard';

let filteredDashboardRows = [];

let actionDetailRequestSequence = 0;
let activeActionDetailRequest = 0;
let activeActionDetailId = '';
let creationKpiSettings = {};
let creationFramework = [];
let creationCategoryIntents = {};
let currentAccess = { verified: false, canSubmit: false };
let currentActionDetails = null;
let editingRevision = null;
let registryCreationBusy = false;
let registryCreationLocked = false;
let registryCreationContextId = '';
let registryScopeOptions = { channels: [], lobs: [], cohorts: [] };
let actionWriteBusy = false;
const retryRequests = {};

function retryToken_(kind, signature) {
  const key = kind + '\n' + signature;
  if (!retryRequests[key]) retryRequests[key] = createActionTrackerRequestToken_();
  return retryRequests[key];
}

function finishRetry_(kind, signature) { delete retryRequests[kind + '\n' + signature]; }

function setCreationPermission_(permissions) {
  currentAccess = permissions || { verified: false, canSubmit: false };
  if (document.getElementById('followUpLiveEmailControls')) renderRegistryLiveEmailControls_();
  const identityAllowed = currentAccess.verified && currentAccess.active;
  const locked = registryCreationLocked && !editingRevision;
  const allowed = !registryCreationBusy && !actionWriteBusy && !locked && identityAllowed && (currentAccess.canSubmit || !!editingRevision);
  document.querySelectorAll('#creationCard input, #creationCard select, #creationCard textarea, #createActionButton')
    .forEach(function(element) { element.disabled = !allowed; });
  document.getElementById('creationCard').classList.toggle('registration-locked', locked);
  document.getElementById('registrationContext').style.display = locked ? 'block' : 'none';
  const selected = currentActionDetails && currentActionDetails.actionPlanId === registryCreationContextId ? currentActionDetails : null;
  document.getElementById('registrationContextMessage').textContent =
    'Viewing ' + (registryCreationContextId || 'an existing plan') + '. Registration is disabled for this plan. ' +
    (selected && selected.permissions.canUpdate
      ? 'Use Update Execution below to record performance and status. Approval is retained.'
      : 'Review and execution controls are in the selected plan below.') +
    ' To log a separate plan, select Register New Action Plan.';
  const startButton = document.getElementById('startNewPlanButton');
  startButton.style.display = locked && identityAllowed && currentAccess.canSubmit ? 'inline-block' : 'none';
  startButton.disabled = registryCreationBusy || actionWriteBusy || !identityAllowed || !currentAccess.canSubmit;
  document.getElementById('newRegistryPlanButton').disabled = startButton.disabled;
  document.getElementById('cancelRevisionButton').disabled = registryCreationBusy || actionWriteBusy;
  if (!registryCreationBusy) document.getElementById('createActionButton').textContent =
    editingRevision ? 'Resubmit for Approval' : (locked ? 'Registration Disabled' : 'Register for Approval');
  document.getElementById('accessMessage').textContent = currentAccess.verified
    ? 'Signed in as ' + currentAccess.email +
      (locked ? ' · Viewing an existing plan.' : (allowed ? (editingRevision ? ' · Owner revision permitted.' : ' · Submission permitted.') :
        (registryCreationBusy || actionWriteBusy ? ' · Saving. Please wait.' : ' · Submission is not permitted for this account.')))
    : (currentAccess.message || 'Signed-in identity could not be verified. Writes are blocked.');
}

function startNewRegistryPlan_() {
  if (registryCreationBusy || actionWriteBusy || !currentAccess.verified || !currentAccess.active || !currentAccess.canSubmit) return;
  switchDashboardTab('submission');
  showRegistryNotice_('New action plan ready for registration.');
  cancelPlanRevision_();
  registryCreationLocked = false;
  registryCreationContextId = '';
  document.getElementById('actionPlan').value = '';
  loadActionDetails();
  setCreationPermission_(currentAccess);
  document.getElementById('creationCard').scrollIntoView({ behavior: 'smooth', block: 'start' });
  document.getElementById('newSite').focus();
}

function showExecutionUpdate_() {
  if (actionWriteBusy || registryCreationBusy || !currentActionDetails || !currentActionDetails.permissions.canUpdate) return;
  switchDashboardTab('submission');
  document.getElementById('updateCard').scrollIntoView({ behavior: 'smooth', block: 'start' });
  document.getElementById('currentPerformance').focus({ preventScroll: true });
}

function registryCompletedPlan_(data) {
  return !!data && (data.executionLocked === true || String(data.actionStatus || '').trim().toLowerCase() === 'completed');
}

function setRegistryEvidenceControls_(enabled) {
  ['evidenceFile', 'evidenceDescription', 'evidenceButton'].forEach(function(id) {
    document.getElementById(id).disabled = !enabled || registryCompletedPlan_(currentActionDetails);
  });
}

function setActionWriteBusy_(busy, operation) {
  actionWriteBusy = busy;
  const buttons = { REVIEW: ['reviewButton', 'Save Review Decision', 'Saving Review…'], COMMENT: ['leadershipButton', 'Post Comment', 'Posting…'], EVIDENCE: ['evidenceButton', 'Upload Evidence', 'Uploading…'], UPDATE: ['submitButton', 'Submit Update', 'Saving…'], ASSESSMENT: ['assessmentButton', 'Save Assessment & Decision', 'Saving Assessment…'] };
  Object.keys(buttons).forEach(function(kind) {
    const values = buttons[kind];
    setRegistryButtonBusy_(values[0], busy && operation === kind, busy && operation === kind ? values[2] : values[1]);
  });
  document.getElementById('actionPlan').disabled = busy;
  setActionUpdateControlsEnabled_(!busy && !!(currentActionDetails && currentActionDetails.permissions.canUpdate));
  document.getElementById('leadershipButton').disabled = busy || !currentActionDetails || !currentActionDetails.permissions.canComment;
  setRegistryEvidenceControls_(!busy && !!(currentActionDetails && currentActionDetails.permissions.canUpload && currentActionDetails.uploadConfigured));
  document.getElementById('reviewButton').disabled = busy || !currentActionDetails || !currentActionDetails.permissions.canReview || registryCompletedPlan_(currentActionDetails);
  document.getElementById('revisePlanButton').disabled = busy || !currentActionDetails || !currentActionDetails.permissions.canRevise || registryCompletedPlan_(currentActionDetails);
  document.getElementById('updateExecutionButton').disabled = busy || !currentActionDetails || !currentActionDetails.permissions.canUpdate || registryCompletedPlan_(currentActionDetails);
  setRegistryAssessmentControls_(!busy && !!(currentActionDetails && currentActionDetails.permissions.canAssess));
  setRegistryFollowUpBusy_(busy);
  setCreationPermission_(currentAccess);
}

function updateNewActionTypes_() {
  const category = document.getElementById('newCategory').value;
  fillSelectOptions_('newType', creationFramework.filter(function(row) { return row.category === category; })
    .map(function(row) { return row.type; }), 'Select action type');

  document.getElementById('newType').value = '';
  updateFrameworkGuidance_();
}

function updateFrameworkGuidance_() {
  updateGovernanceMeasurement_();
  const category = document.getElementById('newCategory').value;
  const type = document.getElementById('newType').value;
  const item = creationFramework.find(function(row) { return row.category === category && row.type === type; });
  document.getElementById('frameworkGuidance').textContent = item
    ? 'Definition: ' + (item.definition || 'Not provided in the framework.') + '\nActivity examples: ' + (item.examples || 'Not provided.')
    : 'Select a category and type to see the definition and examples.';
  if (creationCategoryIntents[category]) document.getElementById('frameworkGuidance').textContent = 'Strategic intent: ' + creationCategoryIntents[category] + '\n' + document.getElementById('frameworkGuidance').textContent;
  if (item && String(item.type).trim().toLowerCase() === 'governance projects') {
    document.getElementById('frameworkGuidance').textContent += '\nChoose Numeric KPI for a measurable KPI target, or Governance outcome for verifiable project acceptance criteria.';
  }
}

function renderIndependentHistory_(data) {
  const comments = document.getElementById('leadershipHistory');
  comments.textContent = '';
  (data.comments || []).forEach(function(item) {
    const entry = document.createElement('div');
    entry.className = 'history-item';
    const meta = document.createElement('div');
    meta.className = 'history-meta';
    meta.textContent = (item.name || item.email) + ' · ' + item.email + ' · ' + item.commentedAt;
    const text = document.createElement('div');
    text.style.whiteSpace = 'pre-wrap';
    text.textContent = item.text;
    entry.appendChild(meta); entry.appendChild(text); comments.appendChild(entry);
  });
  if (!comments.childElementCount) comments.textContent = 'No leadership feedback recorded.';
  const evidence = document.getElementById('evidenceHistory');
  evidence.textContent = '';
  (data.evidence || []).forEach(function(item) {
    const entry = document.createElement('div'); entry.className = 'history-item';
    const link = document.createElement('a');
    link.textContent = item.fileName || item.evidenceId;
    if (/^https:\/\/drive\.google\.com\/file\/d\/[A-Za-z0-9_-]+\/view$/.test(item.fileUrl || '')) {
      link.href = item.fileUrl; link.target = '_blank'; link.rel = 'noopener noreferrer';
    }
    entry.appendChild(link);
    const detail = document.createElement('div'); detail.style.whiteSpace = 'pre-wrap';
    detail.textContent = 'Plan version ' + item.planVersion + ' · ' + item.uploadedBy + ' · ' + item.uploadedAt + '\n' + item.description;
    entry.appendChild(detail); evidence.appendChild(entry);
  });
  if (!evidence.childElementCount) evidence.textContent = 'No execution evidence uploaded.';
}

function submitLeadershipFeedback_() {
  const data = currentActionDetails;
  const message = document.getElementById('leadershipMessage');
  const text = document.getElementById('leadershipComment').value.trim();
  if (actionWriteBusy || !data || !data.permissions.canComment) { message.textContent = 'Comment permission is required.'; return; }
  if (!text) { message.textContent = 'Enter feedback first.'; return; }
  const signature = JSON.stringify([data.actionPlanId, text]);
  const token = retryToken_('COMMENT', signature);
  setActionWriteBusy_(true, 'COMMENT'); message.textContent = 'Posting feedback...'; beginExecutiveLoading_('Posting leadership feedback…');
  google.script.run.withSuccessHandler(function(result) {
    registryNoticeQueueWarning_(result);
    finishRetry_('COMMENT', signature); setActionWriteBusy_(false); endExecutiveLoading_(); showRegistryNotice_('Leadership feedback saved.');
    document.getElementById('leadershipComment').value = '';
    loadActionDetails();
  }).withFailureHandler(function(error) {
    setActionWriteBusy_(false); endExecutiveLoading_(); message.textContent = 'Not confirmed: ' + error.message + ' Retry with unchanged text if needed.';
  }).submitLeadershipComment(data.actionPlanId, text, token);
}

function submitEvidenceUpload_(form) {
  const data = currentActionDetails;
  const message = document.getElementById('evidenceMessage');
