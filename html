    'px';

  const monthRow =
    document.createElement(
      'div'
    );

  monthRow.className =
    'gantt-month-row';

  buildMonthGroups(
    weeks
  ).forEach(
    group => {

      const band =
        document.createElement(
          'div'
        );

      band.className =
        'gantt-month-band';

      band.style.width =
        (
          group.count *
          weekWidth
        ) +
        'px';

      band.textContent =
        group.label;

      monthRow.appendChild(
        band
      );

    }
  );

  const weekRow =
    document.createElement(
      'div'
    );

  weekRow.className =
    'gantt-week-row';

  const currentWeek =
    startOfSundayWeek(registryGanttToday_());

  const currentWeekIndex =
    weeks.findIndex(
      week =>
        dateOnlyTime(week) ===
        dateOnlyTime(
          currentWeek
        )
    );

  weeks.forEach(
    week => {

      const label =
        document.createElement(
          'div'
        );

      label.className =
        'gantt-week-label';

      label.style.width =
        weekWidth +
        'px';

      label.textContent =
        'WB ' +
        formatGanttWeek_(week);

      weekRow.appendChild(
        label
      );

    }
  );

  timelineHeader.appendChild(
    monthRow
  );

  timelineHeader.appendChild(
    weekRow
  );

  if (
    currentWeekIndex !== -1
  ) {

    const marker =
      document.createElement(
        'div'
      );

    marker.className =
      'gantt-current-marker';

    marker.style.left =
      (
        currentWeekIndex *
        weekWidth
      ) +
      'px';

    timelineHeader.appendChild(
      marker
    );

    const markerLabel =
      document.createElement(
        'div'
      );

    markerLabel.className =
      'gantt-current-marker-label';

    markerLabel.style.left =
      (
        currentWeekIndex *
        weekWidth
      ) +
      'px';

    markerLabel.textContent =
      'Current';

    timelineHeader.appendChild(
      markerLabel
    );
  }

  headerShell.appendChild(
    infoHeader
  );

  headerShell.appendChild(
    timelineHeader
  );

  content.appendChild(
    headerShell
  );

  scheduledRows.forEach(
    item => {

      const row =
        item.row;

      const shell =
        document.createElement(
          'div'
        );

      shell.className =
        'gantt-row-shell';

      const info =
        document.createElement(
          'div'
        );

      info.className =
        'gantt-info-row';

      const actionCell =
        document.createElement(
          'div'
        );

      actionCell.className =
        'gantt-action-name';

      actionCell.textContent =
        row.name ||
        row.id ||
        '-';

      actionCell.title =
        row.id ||
        row.name ||
        '';

      const siteCell =
        document.createElement(
          'div'
        );

      siteCell.className =
        'gantt-meta-text';

      siteCell.textContent =
        row.site ||
        '-';

      const kpiCell =
        document.createElement(
          'div'
        );

      kpiCell.className =
        'gantt-meta-text';

      kpiCell.textContent =
        row.kpi ||
        '-';

      kpiCell.title =
        row.kpi ||
        '';

      const ownerCell =
        document.createElement(
          'div'
        );

      ownerCell.className =
        'gantt-meta-text';

      ownerCell.textContent =
        row.owner ||
        '-';

      ownerCell.title =
        row.owner ||
        '';

      info.appendChild(
        actionCell
      );

      info.appendChild(
        siteCell
      );

      info.appendChild(
        kpiCell
      );

      info.appendChild(
        ownerCell
      );

      const timeline =
        document.createElement(
          'div'
        );

      timeline.className =
        'gantt-timeline-row';

      timeline.style.width =
        timelineWidth +
        'px';

      const cells =
        document.createElement(
          'div'
        );

      cells.className =
        'gantt-week-cells';

      weeks.forEach(
        (week, index) => {

          const cell =
            document.createElement(
              'div'
            );

          cell.className =
            'gantt-week-cell';

          if (
            index ===
            currentWeekIndex
          ) {

            cell.classList.add(
              'current-week-cell'
            );

          }

          cell.style.width =
            weekWidth +
            'px';

          cells.appendChild(
            cell
          );

        }
      );

      timeline.appendChild(
        cells
      );

      if (
        currentWeekIndex !== -1
      ) {

        const marker =
          document.createElement(
            'div'
          );

        marker.className =
          'gantt-current-marker';

        marker.style.left =
          (
            currentWeekIndex *
            weekWidth
          ) +
          'px';

        timeline.appendChild(
          marker
        );
      }

      const startWeek =
        startOfSundayWeek(
          item.start
        );

      const endWeek =
        startOfSundayWeek(
          item.end
        );

      const timelineStart =
        weeks[0];

      const timelineEnd =
        weeks[
          weeks.length - 1
        ];

      if (
        endWeek <
        timelineStart
      ) {

        const earlier =
          document.createElement(
            'div'
          );

        earlier.className =
          'gantt-offscreen-marker left';

        earlier.textContent =
          'Earlier';

        timeline.appendChild(
          earlier
        );

      } else if (
        startWeek >
        timelineEnd
      ) {

        const later =
          document.createElement(
            'div'
          );

        later.className =
          'gantt-offscreen-marker right';

        later.textContent =
          'Later';

        timeline.appendChild(
          later
        );

      } else {

        const clippedStart =
          startWeek <
          timelineStart
            ? timelineStart
            : startWeek;

        const clippedEnd =
          endWeek >
          timelineEnd
            ? timelineEnd
            : endWeek;

        const startIndex =
          weeksBetween(
            timelineStart,
            clippedStart
          );

        const endIndex =
          weeksBetween(
            timelineStart,
            clippedEnd
          );

        const bar =
          document.createElement(
            'div'
          );

        bar.className =
          'gantt-bar ' +
          ganttBarClass(
            row
          );

        bar.style.left =
          (
            startIndex *
            weekWidth +
            4
          ) +
          'px';

        bar.style.width =
          Math.max(
            8,
            (
              (
                endIndex -
                startIndex +
                1
              ) *
              weekWidth
            ) -
            8
          ) +
          'px';

        bar.textContent =
          row.status ||
          row.health ||
          '';

        bar.title =
          (
            row.name ||
            row.id ||
            ''
          ) +
          ' | ' +
          formatSpanDate(
            item.start
          ) +
          ' – ' +
          formatSpanDate(
            item.end
          ) +
          ' | ' +
          (
            row.health ||
            row.status ||
            ''
          );

        timeline.appendChild(
          bar
        );
      }

      shell.appendChild(
        info
      );

      shell.appendChild(
        timeline
      );

      content.appendChild(
        shell
      );

    }
  );

  if (
    !meetingModeEnabled &&
    currentWeekIndex !== -1
  ) {

    setTimeout(
      function() {

        const target =
          Math.max(
            0,
            (
              currentWeekIndex *
              weekWidth
            ) -
            220
          );

        scroll.scrollLeft =
          target;

      },
      0
    );

  } else {

    scroll.scrollLeft =
      0;

  }
}

