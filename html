</p><div id="adminTemporaryGrants"></div><button type="button" class="secondary-button" id="adminAddGrantButton" onclick="addRegistryTemporaryGrantUI_()" data-user-security>Add temporary grant</button><label for="adminUserReason">Reason for this change</label><textarea id="adminUserReason" maxlength="2000" placeholder="Explain why this change is needed (at least 10 characters and two words)."></textarea><div class="registry-utility-actions"><button type="button" onclick="previewRegistryUserUI_()" id="previewRegistryUserButton">Preview change</button><button type="button" onclick="saveRegistryUserUI_()" id="saveRegistryUserButton" disabled>Save previewed change</button><button type="button" class="secondary-button" onclick="loadRegistryUserHistoryUI_()">Load user history</button></div><p id="registryUserEditMessage" class="registry-utility-message" role="status" aria-live="polite"></p><pre id="registryUserPreview" class="registry-utility-text"></pre><div id="registryUserHistory" class="registry-utility-text"></div></div>
