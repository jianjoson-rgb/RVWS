  applyFilters();
}

function applyFilters() {
  const department = document.getElementById('departmentFilter').value;
  const search = document.getElementById('searchFilter').value
    .trim()
    .toLowerCase();

  const siteFilterIsActive =
    selectedSites.size > 0 &&
    selectedSites.size < availableSites.length;

  const kpi = document.getElementById('kpiFilter').value;

  const statusFilterIsActive =
    selectedStatuses.size > 0 &&
    selectedStatuses.size < availableStatuses.length;

  const owner = document.getElementById('ownerFilter').value;
  const category = document.getElementById('categoryFilter').value;

  function matchesNonSiteFilters(row) {
    const searchText = [
      row.id,
      row.site,
      row.name,
      row.description, row.governanceExpectedOutcome, row.governanceAcceptanceCriteria,
      row.department,
      row.kpi,
      row.owner,
      row.category,
      row.status,
      row.health,
      row.outcome
    ].join(' ').toLowerCase();

    return (
      (!search || searchText.includes(search)) &&
      (!kpi || row.kpi === kpi) &&
      (!statusFilterIsActive || selectedStatuses.has(row.status)) &&
      (!department || (row.department || '<not recorded>') === department) &&
      (!owner || row.owner === owner) &&
      (!category || row.category === category)
    );
  }

  const matrixRows = dashboardRows.filter(matchesNonSiteFilters);

  const filtered = matrixRows.filter(function(row) {
    return !siteFilterIsActive || selectedSites.has(row.site);
  });

  updateSummaryCards(filtered);
  updateFilteredCounts(filtered.length, dashboardRows.length);

  filteredDashboardRows = filtered;

  renderSiteMatrix(matrixRows);
  renderSinceLastReview(filtered);
  renderRegistryApprovalQueue_(filtered);
  renderRegistryEffectivenessSummary_(filtered);
  renderRegistryCategoryMix_(filtered);
  renderRegistryStability_(filtered);
  renderRegistryFirstAssessmentQueue_(filtered);
  renderRegistryReviewAccountability_(filtered);
  renderRegistryFollowUps_();
  renderTopExceptions(filtered);
  renderActionTable(filtered);
  renderGantt(filtered);
  renderScreenshotReadout_(filtered);

  if (meetingModeEnabled) {
    updateMeetingMeta();
  }
}

function selectSiteFromMatrix_(site) {
  if (!site) return;

  if (
    selectedSites.size === 1 &&
    selectedSites.has(site)
  ) {
    selectedSites = new Set(availableSites);
  } else {
    selectedSites = new Set([site]);
  }

  refreshSiteCheckboxes();
  closeSiteMenu();
  applyFilters();
}

function renderSiteMatrix(rows) {
  const body = document.getElementById('siteMatrixBody');
  if (!body) return;

  body.innerHTML = '';

  const siteSet = new Set(availableSites || []);

  (rows || []).forEach(function(row) {
    if (row.site) {
      siteSet.add(row.site);
    }
  });

  const preferredOrder = ['Global', 'ARN', 'HTW', 'MTQ', 'PHX'];

  const sites = Array.from(siteSet).sort(function(a, b) {
    const ai = preferredOrder.indexOf(a);
    const bi = preferredOrder.indexOf(b);

    if (ai !== -1 || bi !== -1) {
      if (ai === -1) return 1;
      if (bi === -1) return -1;
      return ai - bi;
    }

    return a.localeCompare(b);
  });

  sites.forEach(function(site) {
    const siteRows = (rows || []).filter(function(row) {
      return row.site === site;
    });

    const active = siteRows.filter(function(row) {
      return row.status !== 'Completed' && row.status !== 'Cancelled';
    }).length;

    const onTrack = siteRows.filter(function(row) {
      return row.health === 'On Track';
    }).length;

    const atRisk = siteRows.filter(function(row) {
      return row.health === 'At Risk';
    }).length;

    const overdue = siteRows.filter(function(row) {
      return row.health === 'Overdue';
    }).length;

    const goalMet = siteRows.filter(function(row) {
      return row.outcome === 'Goal Met';
    }).length;

    const tr = document.createElement('tr');

    if (
      selectedSites.size === 1 &&
      selectedSites.has(site)
    ) {
      tr.className = 'selected-site-row';
    }

    tr.tabIndex = 0;
    tr.setAttribute('role', 'button');
    tr.setAttribute('aria-label', 'Filter portfolio to ' + site);

    tr.onclick = function() {
      selectSiteFromMatrix_(site);
    };

    tr.onkeydown = function(event) {
      if (event.key === 'Enter' || event.key === ' ') {
        event.preventDefault();
        selectSiteFromMatrix_(site);
      }
    };

    [site, active, onTrack, atRisk, overdue, goalMet].forEach(
      function(value, index) {
        const td = document.createElement('td');
        td.textContent = value;
        td.className = index === 0
          ? 'site-name-cell'
          : 'site-metric-cell';
        tr.appendChild(td);
      }
    );

    body.appendChild(tr);
  });
}

function getReviewWeekStart_() {
  const now = new Date();
  const start = new Date(now);
  start.setHours(0, 0, 0, 0);
  start.setDate(start.getDate() - start.getDay());
  return start;
}

function parseClientIso_(value) {
  if (!value) return null;
  const parsed = new Date(value);
  return Number.isNaN(parsed.getTime()) ? null : parsed;
}

function isOnOrAfterReviewStart_(value, reviewStart) {
  const parsed = parseClientIso_(value);
  return !!parsed && parsed.getTime() >= reviewStart.getTime();
}

function formatReviewWeekLabel_(reviewStart) {
  const month = String(reviewStart.getMonth() + 1).padStart(2, '0');
  const day = String(reviewStart.getDate()).padStart(2, '0');
  return 'Review week WB' + month + day + ' (Sunday-Saturday)';
}

function renderSinceLastReview(rows) {
  const reviewStart = getReviewWeekStart_();
  const now = new Date();
  const scopedRows = rows || [];

  const completed = scopedRows.filter(function(row) {
    return (
      row.status === 'Completed' &&
      isOnOrAfterReviewStart_(row.completionDateIso, reviewStart)
    );
  }).length;

  const goalMet = scopedRows.filter(function(row) {
    return (
      row.outcome === 'Goal Met' &&
      isOnOrAfterReviewStart_(row.lastUpdatedDateIso, reviewStart)
    );
  }).length;

  const newlyAtRisk = scopedRows.filter(function(row) {
    return (
      row.health === 'At Risk' &&
      isOnOrAfterReviewStart_(row.lastUpdatedDateIso, reviewStart)
    );
  }).length;

  const newlyOverdue = scopedRows.filter(function(row) {
    const endDate = parseClientIso_(row.endDateIso);
    return (
      row.health === 'Overdue' &&
      endDate &&
      endDate.getTime() >= reviewStart.getTime() &&
      endDate.getTime() < now.getTime()
    );
  }).length;

  const recovered = scopedRows.filter(function(row) {
    const createdDate = parseClientIso_(row.createdDateIso);
    return (
      row.health === 'On Track' &&
      (row.outcome === 'Improving' || row.outcome === 'Goal Met') &&
      isOnOrAfterReviewStart_(row.lastUpdatedDateIso, reviewStart) &&
      (!createdDate || createdDate.getTime() < reviewStart.getTime())
    );
  }).length;

  const completedEl = document.getElementById('reviewCompletedCount');
  if (!completedEl) return;

  completedEl.textContent = completed;
  document.getElementById('reviewGoalMetCount').textContent = goalMet;
  document.getElementById('reviewAtRiskCount').textContent = newlyAtRisk;
  document.getElementById('reviewOverdueCount').textContent = newlyOverdue;
  document.getElementById('reviewRecoveredCount').textContent = recovered;
  document.getElementById('reviewWindowLabel').textContent =
    formatReviewWeekLabel_(reviewStart);
}

function topExceptionPriority_(row) {
  if (row.health === 'Overdue') return 0;
  if (row.health === 'At Risk') return 1;
  return 9;
}

function outcomePriority_(outcome) {
  const order = {
    'Worsening': 0,
    'Unchanged': 1,
    'Insufficient Data': 2,
    'Improving': 3,
    'Goal Met': 4
  };

  return Object.prototype.hasOwnProperty.call(order, outcome)
    ? order[outcome]
    : 5;
}

function numericDaysRemaining_(value) {
  const number = Number(String(value == null ? '' : value).replace(/,/g, ''));
  return Number.isFinite(number) ? number : 999999;
}

function renderTopExceptions(rows) {
  const card = document.getElementById('topExceptionsCard');
  const body = document.getElementById('topExceptionsBody');
  const empty = document.getElementById('topExceptionsEmpty');
  const count = document.getElementById('topExceptionsCount');

  if (!card || !body || !empty || !count) return;

  const exceptions = (rows || [])
    .filter(function(row) {
      return row.health === 'Overdue' || row.health === 'At Risk';
    })
    .sort(function(a, b) {
      const healthDifference = topExceptionPriority_(a) - topExceptionPriority_(b);
      if (healthDifference !== 0) return healthDifference;

      const dayDifference = numericDaysRemaining_(a.daysRemaining) -
        numericDaysRemaining_(b.daysRemaining);
      if (dayDifference !== 0) return dayDifference;

      return outcomePriority_(a.outcome) - outcomePriority_(b.outcome);
    });

  count.textContent = exceptions.length +
    (exceptions.length === 1 ? ' exception' : ' exceptions');

  body.innerHTML = '';

  if (exceptions.length === 0) {
    card.style.display = 'none';
    empty.style.display = 'none';
    return;
  }

  card.style.display = '';
  empty.style.display = 'none';

  exceptions.slice(0, 5).forEach(function(row) {
    const tr = document.createElement('tr');

    tr.onclick = function() {
      if (!meetingModeEnabled) {
        openAction(row.id);
      }
    };

    appendTextCell(tr, row.id);
    appendTextCell(tr, row.site);
    appendTextCell(tr, row.name);
    const brief = document.createElement('div'); brief.className = 'capture-action-summary'; brief.textContent = registryActionExcerpt_(row.description)+(row.measurementMethod==='Governance outcome'?' · Outcome: '+registryActionExcerpt_(row.governanceExpectedOutcome):'');
    tr.lastElementChild.appendChild(brief);
    appendTextCell(tr, row.kpi);
    appendTextCell(
      tr,
      formatKpiValue(row.current, row.unit, row.kpi),
      'metric-value'
    );
    appendTextCell(
      tr,
      formatKpiValue(row.goal, row.unit, row.kpi),
      'metric-value'
    );
    appendBadgeCell(tr, row.health);
    appendBadgeCell(tr, row.outcome);
    appendTextCell(tr, row.owner);
    appendTextCell(tr, row.endDate);
    appendTextCell(
      tr,
      row.daysRemaining === '' || row.daysRemaining == null
        ? '-'
        : row.daysRemaining,
      numericDaysRemaining_(row.daysRemaining) < 0 ? 'exception-days-negative' : ''
    );

    body.appendChild(tr);
  });
}

function pluralizeAction_(count) {
  return count === 1 ? 'action' : 'actions';
}

function getCurrentScopeText_() {
  const siteSummary = getSelectionSummary(
    selectedSites,
    availableSites,
    'All Sites / Departments'
  );

  const statusSummary = getSelectionSummary(
    selectedStatuses,
    availableStatuses,
    'All Statuses'
  );

  const kpi = document.getElementById('kpiFilter').value || 'All KPIs';
  const owner = document.getElementById('ownerFilter').value;
  const category = document.getElementById('categoryFilter').value;
  const search = document.getElementById('searchFilter').value.trim();

  const parts = [siteSummary, kpi, statusSummary];
  const department = document.getElementById('departmentFilter').value;
  if (department) parts.push('Department: ' + department);

  if (owner) parts.push('Owner filter applied');
  if (category) parts.push('Category: ' + category);
  if (search) parts.push('Search: "' + search + '"');

  return parts.join(' | ');
}

function dueWithinDays_(row, minimumDays, maximumDays) {
  if (!row || row.status === 'Completed' || row.status === 'Cancelled') {
    return false;
  }

  const days = Number(String(row.daysRemaining == null ? '' : row.daysRemaining).replace(/,/g, ''));

  return Number.isFinite(days) && days >= minimumDays && days <= maximumDays;
}

function getExceptionSiteSummary_(rows) {
  const counts = {};

  (rows || []).forEach(function(row) {
    if (row.health !== 'At Risk' && row.health !== 'Overdue') return;
    const site = row.site || 'Unassigned';
    counts[site] = (counts[site] || 0) + 1;
  });

  return Object.keys(counts)
    .map(function(site) {
      return { site: site, count: counts[site] };
    })
    .sort(function(a, b) {
      if (b.count !== a.count) return b.count - a.count;
      return a.site.localeCompare(b.site);
    });
}

function renderScreenshotReadout_(rows) {
  const scopedRows = rows || [];
  const total = scopedRows.length;

  const onTrack = scopedRows.filter(function(row) {
    return row.health === 'On Track';
  }).length;

  const atRisk = scopedRows.filter(function(row) {
    return row.health === 'At Risk';
  }).length;

  const overdue = scopedRows.filter(function(row) {
    return row.health === 'Overdue';
  }).length;

  const completed = scopedRows.filter(function(row) {
    return row.status === 'Completed';
  }).length;

  const goalMet = scopedRows.filter(function(row) {
    return row.outcome === 'Goal Met';
  }).length;

  const improving = scopedRows.filter(function(row) {
    return row.outcome === 'Improving';
  }).length;

  const unchanged = scopedRows.filter(function(row) {
    return row.outcome === 'Unchanged';
  }).length;

  const worsening = scopedRows.filter(function(row) {
    return row.outcome === 'Worsening';
  }).length;

  const reviewStart = getReviewWeekStart_();

  const updatedThisWeek = scopedRows.filter(function(row) {
    return isOnOrAfterReviewStart_(row.lastUpdatedDateIso, reviewStart);
  }).length;

  const completedThisWeek = scopedRows.filter(function(row) {
    return (
      row.status === 'Completed' &&
      isOnOrAfterReviewStart_(row.completionDateIso, reviewStart)
    );
  }).length;

  const goalMetUpdatedThisWeek = scopedRows.filter(function(row) {
    return (
      row.outcome === 'Goal Met' &&
      isOnOrAfterReviewStart_(row.lastUpdatedDateIso, reviewStart)
    );
  }).length;

  const dueSoon = scopedRows.filter(function(row) {
    return dueWithinDays_(row, 0, 7);
  }).length;

  const exceptionSites = getExceptionSiteSummary_(scopedRows);
  const exceptionCount = atRisk + overdue;

  const setTextIfPresent = function(id, value) {
    const element = document.getElementById(id);
    if (element) element.textContent = value;
  };

  setTextIfPresent('screenshotTotalCount', total);
  setTextIfPresent('screenshotOnTrackCount', onTrack);
  setTextIfPresent('screenshotAtRiskCount', atRisk);
  setTextIfPresent('screenshotOverdueCount', overdue);
  setTextIfPresent('screenshotCompletedCount', completed);
  setTextIfPresent('screenshotGoalMetCount', goalMet);
  setTextIfPresent(
    'screenshotActionCountLabel',
    total + ' ' + (total === 1 ? 'action plan' : 'action plans')
  );
  setTextIfPresent('screenshotScopeLabel', getCurrentScopeText_());
  setTextIfPresent('narrativeReviewWeekLabel', formatReviewWeekLabel_(reviewStart));

  if (total === 0) {
    setTextIfPresent(
      'narrativePortfolio',
      'No action plans match the selected filters.'
    );
    setTextIfPresent(
      'narrativeUpdates',
      'No action updates are available for the selected scope.'
    );
    setTextIfPresent(
      'narrativeAttention',
      'No exceptions or upcoming deadlines are identified because the selected scope is empty.'
    );
    return;
  }

  const portfolioParts = [
    total + ' action ' + (total === 1 ? 'plan is' : 'plans are') + ' in scope.',
    onTrack + ' On Track,',
    atRisk + ' At Risk,',
    overdue + ' Overdue,',
    completed + ' Completed,',
    'and ' + goalMet + ' Goal Met.'
  ];

  setTextIfPresent('narrativePortfolio', portfolioParts.join(' '));

  let updateSentence = '';

  if (updatedThisWeek === 0) {
    updateSentence =
      'No action updates have been logged during the current review week.';
  } else {
    const updateParts = [
      updatedThisWeek + ' ' + pluralizeAction_(updatedThisWeek) + ' updated this review week'
    ];

    if (completedThisWeek > 0) {
      updateParts.push(
        completedThisWeek + ' completed'
      );
    }

    if (goalMetUpdatedThisWeek > 0) {
      updateParts.push(
        goalMetUpdatedThisWeek + ' currently meeting goal'
      );
    }

    updateSentence = updateParts.join('; ') + '.';
  }

  const movementParts = [];

  if (improving > 0) {
    movementParts.push(improving + ' improving');
  }
  if (unchanged > 0) {
    movementParts.push(unchanged + ' unchanged');
  }
  if (worsening > 0) {
    movementParts.push(worsening + ' worsening');
  }

  if (movementParts.length > 0) {
    updateSentence += ' Current KPI movement: ' + movementParts.join(', ') + '.';
  }

  setTextIfPresent('narrativeUpdates', updateSentence);

  let attentionSentence = '';

  if (exceptionCount === 0) {
    attentionSentence =
      'No At Risk or Overdue actions are currently identified in the selected scope.';
  } else {
    const topSites = exceptionSites.slice(0, 2).map(function(item) {
      return item.site + ' (' + item.count + ')';
    });

    attentionSentence =
      exceptionCount + ' ' + pluralizeAction_(exceptionCount) +
      ' currently require attention: ' +
      overdue + ' Overdue and ' + atRisk + ' At Risk.';

    if (topSites.length > 0) {
      attentionSentence += ' Exceptions are concentrated in ' + topSites.join(' and ') + '.';
    }
  }

  if (dueSoon > 0) {
    attentionSentence +=
      ' ' + dueSoon + ' active ' + pluralizeAction_(dueSoon) +
      ' ' + (dueSoon === 1 ? 'is' : 'are') + ' due within the next 7 days.';
  }

  setTextIfPresent('narrativeAttention', attentionSentence);
}

