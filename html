function decimalMinutesToHms(
  value
) {

  if (
    value === null ||
    value === undefined ||
    String(value).trim() === ''
  ) {
    return '-';
  }

  const text =
    String(value).trim();

  if (
    /^-?\d{1,3}:\d{2}:\d{2}$/.test(text)
  ) {
    return text;
  }

  const number =
    Number(
      text.replace(/,/g, '')
    );

  if (
    !Number.isFinite(number)
  ) {
    return text;
  }

  const negative =
    number < 0;

  let totalSeconds =
    Math.round(
      Math.abs(number) * 60
    );

  const hours =
    Math.floor(
      totalSeconds / 3600
    );

  totalSeconds -=
    hours * 3600;

  const minutes =
    Math.floor(
      totalSeconds / 60
    );

  const seconds =
    totalSeconds -
    minutes * 60;

  const formatted =
    String(hours).padStart(2, '0') +
    ':' +
    String(minutes).padStart(2, '0') +
    ':' +
    String(seconds).padStart(2, '0');

  return negative
    ? '-' + formatted
