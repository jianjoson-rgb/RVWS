      kpiSetting.unit
    ),
    goal: document.getElementById('newMeasurementMethod').value==='Governance outcome'?'':parseMetricInputForKpi_(
      document.getElementById('newGoal').value,
      kpiName,
      kpiSetting.unit
    ),
    startDate: document.getElementById('newStartDate').value,
    endDate: document.getElementById('newEndDate').value,
    actionStatus: document.getElementById('newStatus').value,
    glideAvailable: document.getElementById('newGlideAvailable').value,
    glideUrl: document.getElementById('newGlideUrl').value.trim()
  };

  const requiredText = [
    ['Authorized scope', payload.site, 'newSite'],
    ['Channel', payload.channel, 'newChannel'], ['LOB', payload.lob, 'newLob'], ['Cohort', payload.cohort, 'newCohort'],
    ['Action Plan Name', payload.actionPlanName, 'newActionName'],
    ['Action Steps', payload.actionDescription, 'newActionDescription'],
    ['Target KPI / Behavior', payload.measurementMethod==='Governance outcome'?'Governance outcome':payload.kpi, 'newKpi'],
    ['Action Owner', payload.owner, 'newOwner'],
    ['Action Category', payload.category, 'newCategory'],
    ['Action Type', payload.actionType, 'newType'], ['Activity', payload.activity, 'newActivity'],
    ['Start Date', payload.startDate, 'newStartDate'],
    ['Target End Date', payload.endDate, 'newEndDate'],
    ['Action Status', payload.actionStatus, 'newStatus'], ['Glide path available', payload.glideAvailable, 'newGlideAvailable']
  ];

  const governance=payload.measurementMethod==='Governance outcome';
  if(governance){[['Current governance problem',payload.governanceCurrentProblem,'newGovernanceCurrentProblem'],['Expected governance outcome',payload.governanceExpectedOutcome,'newGovernanceExpectedOutcome'],['Acceptance criteria',payload.governanceAcceptanceCriteria,'newGovernanceAcceptanceCriteria'],['Verification method',payload.governanceVerificationMethod,'newGovernanceVerificationMethod']].forEach(function(pair){requiredText.push(pair);});}
  const missing = requiredText.find(function(item) {
    return !String(item[1] || '').trim();
  });

  if (missing) {
    registryCreationError_(missing[2],missing[0]+' is required.');
    return;
  }

  if (isTargetedCohort_(payload.cohort) && !payload.cohortDetails.trim()) {
    registryCreationError_('newCohortDetails','Specify the targeted population in Cohort Details.'); return;
  }
  if (!governance && String(kpiSetting.unit || '').toLowerCase() === 'count' &&
    (!Number.isSafeInteger(payload.baseline) || payload.baseline < 0 || !Number.isSafeInteger(payload.goal) || payload.goal < 0)) {
    registryCreationError_(!Number.isSafeInteger(payload.baseline) || payload.baseline<0?'newBaseline':'newGoal','Count KPIs require non-negative whole numbers.'); return;
  }
  payload.owner = String(payload.owner || '').trim().toLowerCase();

  if (!/^[A-Z0-9._%+\-]+@taskus\.com$/i.test(payload.owner)) {
    registryCreationError_('newOwner','Action Owner must be a valid @taskus.com email address.');
    return;
  }

  if (!governance && !Number.isFinite(payload.baseline)) {
    registryCreationError_('newBaseline','Please enter a valid Baseline Performance.');
    return;
  }

  if (!governance && !Number.isFinite(payload.goal)) {
    registryCreationError_('newGoal','Please enter a valid End Goal / Target.');
    return;
  }

  if (
    !governance && String(kpiSetting.unit || '').trim() === '%' &&
    (
      payload.baseline < 0 || payload.baseline > 1 ||
      payload.goal < 0 || payload.goal > 1
    )
  ) {
