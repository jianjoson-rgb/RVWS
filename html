  ) {

    return (
      formatNumber(
        number,
        1
      ) +
      ' sec'
    );
  }

  return formatConfiguredKpiNumber_(number, unit);
}

function progressPercent(
  value
) {

  if (
    value === null ||
    value === undefined ||
    String(value).trim() === ''
  ) {
    return 0;
  }

  const text =
    String(value).trim();

  let percent;

  if (
    text.includes('%')
  ) {

    percent =
      Number(
        text.replace('%', '')
      );

  } else {

    const number =
      Number(text);

    if (
      !Number.isFinite(number)
    ) {
      return 0;
    }

    percent =
      number * 100;
  }

  if (
    !Number.isFinite(percent)
  ) {
    return 0;
  }

  return Math.max(
    0,
    Math.min(
      100,
      percent
    )
  );
}

