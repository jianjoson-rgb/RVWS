<body>
<aside class="registry-shell-nav" id="registryShellNav" aria-label="Action Registry workspaces">
  <button type="button" class="registry-shell-close" id="registryShellCloseButton" onclick="closeRegistryShellNav_(true)" aria-label="Close workspace navigation">×</button>
  <div class="registry-shell-brand"><div class="registry-shell-wordmark"><span class="registry-brand-symbol" id="registryBrandMark"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 48 48" aria-hidden="true" focusable="false">
  <path class="logo-solid" d="M24 5.5 42 15.8 24 26.1 6 15.8Z" fill="#143c2d" stroke="none"/>
  <path class="logo-ink logo-layer logo-layer-one" d="m7 25 17 9.7L41 25" fill="none" stroke="#143c2d" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"/>
  <path class="logo-ink logo-layer logo-layer-two" d="m7 33.4 17 9.7 17-9.7" fill="none" stroke="#143c2d" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"/>
  <path class="logo-accent logo-check" d="m18.2 16 4.2 3.6 8-7.5" fill="none" stroke="#b6e16c" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round"/>
</svg>
</span><span>Action Registry</span></div><small>Shopify Global Accounts</small></div>
  <div class="registry-shell-label">Workspaces</div>
  <div class="dashboard-tabs" id="dashboardTabs" role="tablist" aria-label="Registry workspaces" aria-orientation="vertical"><button type="button" class="dashboard-tab active" id="tabDashboardButton" role="tab" aria-controls="dashboardTab" onclick="switchDashboardTab('dashboard'); closeRegistryShellNav_();"><svg class="registry-shell-icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><rect x="3" y="3" width="7" height="7" rx="1.5"/><rect x="14" y="3" width="7" height="7" rx="1.5"/><rect x="3" y="14" width="7" height="7" rx="1.5"/><rect x="14" y="14" width="7" height="7" rx="1.5"/></svg>Executive Dashboard</button><button type="button" class="dashboard-tab" id="tabSubmissionButton" role="tab" aria-controls="submissionTab" onclick="switchDashboardTab('submission'); closeRegistryShellNav_();"><svg class="registry-shell-icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M8 6h13M8 12h13M8 18h13M3 6h.01M3 12h.01M3 18h.01"/></svg>Submission &amp; Updates</button><button type="button" class="dashboard-tab" id="tabApprovalsButton" role="tab" aria-controls="approvalsTab" onclick="switchDashboardTab('approvals'); closeRegistryShellNav_();"><svg class="registry-shell-icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="m5 12 4 4L19 6"/></svg>Approvals &amp; Feedback <span id="pendingApprovalTabCount" class="tab-count" aria-label="0 pending plans in current filters">0</span></button><button type="button" class="dashboard-tab" id="tabEffectivenessButton" role="tab" aria-controls="effectivenessTab" onclick="switchDashboardTab('effectiveness'); closeRegistryShellNav_();"><svg class="registry-shell-icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M4 3v17h17M8 16v-5m5 5V6m5 10V9"/></svg>Effectiveness &amp; Decisions</button><button type="button" class="dashboard-tab" id="tabGanttButton" role="tab" aria-controls="ganttTab" onclick="switchDashboardTab('gantt'); closeRegistryShellNav_();"><svg class="registry-shell-icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/></svg>Gantt</button><button type="button" class="dashboard-tab" id="tabHowToButton" role="tab" aria-controls="howToTab" onclick="switchDashboardTab('howto'); closeRegistryShellNav_();"><svg class="registry-shell-icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><circle cx="12" cy="12" r="9"/><path d="M10 8l6 4-6 4z"/></svg>How to</button><button type="button" class="dashboard-tab" id="tabReadmeButton" role="tab" aria-controls="readmeTab" onclick="switchDashboardTab('readme'); closeRegistryShellNav_();"><svg class="registry-shell-icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M3 4c4-1 7 0 9 2v15c-2-2-5-3-9-2V4Zm18 0c-4-1-7 0-9 2v15c2-2 5-3 9-2V4Z"/></svg>Readme</button><button type="button" class="dashboard-tab" id="tabMyWorkButton" role="tab" aria-controls="myWorkTab" onclick="switchDashboardTab('myWork'); closeRegistryShellNav_();"><svg class="registry-shell-icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M9 5H5v16h14V5h-4M9 3h6v4H9zM8 12h8M8 16h5"/></svg>My Work</button><button type="button" class="dashboard-tab" id="tabAdminButton" role="tab" aria-controls="adminTab" onclick="switchDashboardTab('admin'); closeRegistryShellNav_();" hidden><svg class="registry-shell-icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><circle cx="12" cy="8" r="4"/><path d="M4 21v-3a8 8 0 0 1 16 0v3"/></svg>Admin</button></div>
  <div class="registry-shell-footer"><strong>Global Accounts</strong><span id="registryShellRelease">Verifying release identity…</span></div>
</aside>
<div class="registry-shell-scrim" id="registryShellScrim" onclick="closeRegistryShellNav_(true)" hidden></div>
<header class="registry-shell-topbar" id="registryShellTopbar"><div class="registry-shell-breadcrumb"><button type="button" class="registry-shell-menu" id="registryShellMenuButton" onclick="toggleRegistryShellNav_()" aria-label="Open workspace navigation" aria-controls="registryShellNav" aria-expanded="false"><svg class="registry-shell-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M4 6h16M4 12h16M4 18h16"/></svg></button><span class="registry-brand-symbol registry-shell-header-mark" id="registryHeaderBrandMark" aria-hidden="true"></span><span>Workspace</span><span aria-hidden="true">/</span><strong id="registryShellCrumb">Executive Dashboard</strong></div><div class="registry-shell-actions"><button type="button" class="registry-shell-search" id="registryShellSearchButton" onclick="focusRegistryShellSearch_()" aria-label="Search the current registry workspace"><svg class="registry-shell-icon" viewBox="0 0 24 24" aria-hidden="true"><circle cx="10" cy="10" r="6"/><path d="m15 15 5 5"/></svg><span>Search registry</span><kbd>⌘ K</kbd></button><span class="registry-shell-account" id="registryShellAccount">Verifying access…</span></div></header>


<div
  class="executive-loader"
  id="executiveLoader"
  aria-hidden="true"
  aria-live="polite"
>
  <div class="executive-loader-panel" role="status"><div class="executive-loader-brand">Shopify Global Accounts Action Registry</div>
    <div class="executive-loader-row">
      <div class="executive-loader-title" id="executiveLoaderLabel">
        Loading registry…
      </div>
      <div class="executive-loader-percent" id="executiveLoaderPercent">Please wait</div>
    </div>
    <div class="executive-loader-track" aria-hidden="true">
      <div class="executive-loader-fill" id="executiveLoaderFill"></div>
    </div>
    <div class="executive-loader-subtext">
      Preparing the latest action plan view.
    </div>
    <div id="executiveLoaderSlow" class="executive-loader-slow" hidden>
      <p id="executiveLoaderSlowText">Loading is taking longer than expected. Any save remains unconfirmed until a response arrives; avoid repeating it.</p>
      <button type="button" class="secondary-button" onclick="hideExecutiveLoading_()">Hide loading screen</button>
    </div>
  </div>
</div>
<div id="executiveLoaderDeferred" class="executive-loader-deferred" role="status" aria-live="polite" hidden>Requests are still pending. Any save remains unconfirmed until a response arrives.</div>

<div class="container">

  <div class="title-block"><div class="registry-shell-title-row"><div><h1 id="registryWorkspaceTitle">Portfolio overview</h1><div class="subtitle" id="registryWorkspaceSubtitle">Authorized actions, evidence and next decisions.</div><div class="registry-shell-status" id="registryShellStatus" role="status" aria-live="polite">Loading the current authorized scope…</div></div><div class="registry-shell-title-actions"><button type="button" class="secondary-button registry-shell-capture" id="registryShellCaptureButton" onclick="openRegistryExecutiveCapture_()" disabled>Executive view ↗</button><button type="button" class="registry-shell-new-action" id="registryShellNewActionButton" onclick="startNewRegistryPlan_()" disabled hidden>＋ New action</button></div></div></div>
<div class="card controls-card">

    <div class="controls-header">

      <div class="controls-title">
        View Controls
      </div>

      <div
        class="filtered-count"
        id="topFilteredCount"
      >
        Showing 0 of 0 actions
      </div>

    </div>

    <div class="filter-grid">

      <div class="filter-field">

        <label>Search</label>

        <input
          type="text"
          id="searchFilter"
          placeholder="ID, action, owner, site..."
          oninput="applyFilters()"
        >

      </div>

      <div class="filter-field">

        <label>Site / Department</label>

        <div
          class="multi-select"
          id="siteMultiSelect"
        >

          <button
            type="button"
            class="multi-select-button"
            id="siteFilterButton"
            aria-label="Filter by site or department"
            title="Filter the sites and departments you can access"
            onclick="toggleSiteMenu(event)"
          >

            <span id="siteFilterLabel">
              All authorized sites
            </span>

            <span class="multi-select-caret">
              ▼
            </span>

          </button>

          <div
            class="multi-select-menu"
            id="siteFilterMenu"
          >

            <div
              class="multi-select-options"
              id="siteFilterOptions"
            ></div>

            <div class="multi-select-actions">

              <button
                type="button"
                class="multi-select-action"
                onclick="selectAllSites(event)"
              >
                Select All
              </button>

              <button
                type="button"
                class="multi-select-action"
                onclick="clearSites(event)"
              >
                Clear
              </button>

            </div>

          </div>

        </div>

      </div>

      <div class="filter-field">

        <label>KPI</label>

        <select
          id="kpiFilter"
          onchange="applyFilters()"
        >
          <option value="">
            All KPIs
          </option>
        </select>

      </div>

      <div class="filter-field">

        <label>Status</label>

        <div
          class="multi-select"
          id="statusMultiSelect"
        >

          <button
            type="button"
            class="multi-select-button"
            id="statusFilterButton"
            onclick="toggleStatusMenu(event)"
          >

            <span id="statusFilterLabel">
              All Statuses
            </span>

            <span class="multi-select-caret">
              ▼
            </span>

          </button>

          <div
            class="multi-select-menu"
            id="statusFilterMenu"
          >

            <div
              class="multi-select-options"
              id="statusFilterOptions"
            ></div>

            <div class="multi-select-actions">

              <button
                type="button"
                class="multi-select-action"
                onclick="selectAllStatuses(event)"
              >
                Select All
              </button>

              <button
                type="button"
                class="multi-select-action"
                onclick="clearStatuses(event)"
              >
                Clear
              </button>

            </div>

          </div>

        </div>

      </div>

      <div class="filter-field">

        <label>Owner</label>

        <select
          id="ownerFilter"
          onchange="applyFilters()"
        >
          <option value="">
            All Owners
          </option>
        </select>

      </div>

      <div class="filter-field">

        <label>Category</label>

        <select
          id="categoryFilter"
          onchange="applyFilters()"
        >
          <option value="">
            All Categories
          </option>
        </select>

      </div>

      <div class="filter-field"><label for="departmentFilter">Department</label><select id="departmentFilter" onchange="applyFilters()"><option value="">All Authorized Departments</option></select></div>
      <button
        class="reset-button"
        onclick="resetFilters()"
      >
        Reset
      </button>

      <button
        class="meeting-button"
        id="meetingModeButton"
        onclick="toggleMeetingMode()"
      >
        Screenshot Mode
      </button>
      <div class="filter-field"><label for="captureMode">Capture view</label><select id="captureMode"><option value="executive">Executive</option><option value="full">Full Report</option></select></div>

    </div>

  </div>

  <div id="workspaceNotice" class="workspace-notice" role="status" aria-live="polite" style="display:none;"></div>
  <div id="dashboardLoadNotice" class="dashboard-load-notice" data-state="loading" role="status" aria-live="polite"><span id="dashboardLoadNoticeText">Loading authorized registry data…</span><button id="dashboardRetryButton" type="button" class="secondary-button" onclick="loadDashboard()" hidden>Retry dashboard</button></div>
  <div id="registryAccessWarning" class="registry-expiry-warning" role="status" hidden></div>
  <div id="registryBootstrapMessage" class="registry-utility-message" role="status" aria-live="polite"></div>

  <div
    class="meeting-meta"
    id="meetingMeta"
  >

    <div
      class="meeting-meta-left"
      id="meetingFilterSummary"
    >
      All actions
    </div>

    <div
      class="meeting-meta-right"
      id="meetingAsOf"
    >
      As of -
    </div>

  </div>

  <div class="tab-panel active" id="dashboardTab">
    <p id="dashboardUnavailable" class="dashboard-unavailable" role="status">The latest dashboard could not be displayed. Previous dashboard content is withheld. Use Retry dashboard above to load a fresh authorized view.</p>
    <section id="captureSurface" class="capture-surface" aria-label="Authorized capture report"><div class="capture-report-controls"><button id="captureExecutiveChoice" type="button" class="secondary-button" onclick="setCaptureView_('executive')">Executive</button><button id="captureFullChoice" type="button" class="secondary-button" onclick="setCaptureView_('full')">Full Report</button><button type="button" class="secondary-button" onclick="window.print()">Print this report</button></div><div id="captureExecutive"></div><div id="captureFullReport"></div></section>
    <div class="executive-overview-grid">

    <div class="card executive-overview-card">

      <div class="section-heading-row executive-heading-row">
        <div>
          <h3>Portfolio Overview</h3>
          <div class="executive-section-subtitle">Current action-plan position</div>
        </div>
      </div>

      <p id="scheduleDefinitionNotice" class="creation-help" role="status"></p>
      <div class="summary-grid executive-summary-grid">

        <div class="summary-card total">
          <div class="summary-label">Active Actions</div>
          <div class="summary-value" id="activeCount">0</div>
        </div>

        <div class="summary-card on-track">
          <div class="summary-label">On Track</div>
          <div class="summary-value" id="onTrackCount">0</div>
        </div>

        <div class="summary-card at-risk">
          <div class="summary-label">At Risk</div>
          <div class="summary-value" id="atRiskCount">0</div>
        </div>

        <div class="summary-card overdue">
          <div class="summary-label">Overdue</div>
          <div class="summary-value" id="overdueCount">0</div>
        </div>

        <div class="summary-card completed">
          <div class="summary-label">Goal Met</div>
          <div class="summary-value" id="goalMetCount">0</div>
        </div>

      </div>

    </div>

    <div class="card review-strip-card">

      <div class="section-heading-row executive-heading-row">
        <div>
          <h3>Current Review-Week Snapshot</h3>
          <div class="executive-section-subtitle" id="reviewWindowLabel">Current review week</div>
          <div class="executive-section-subtitle">Latest row states and recorded dates; no saved prior-review comparison.</div>
        </div>
      </div>

