function formatNumber(number, decimals) {
  const value = Number(number);
  if (!Number.isFinite(value)) return number;
  const fixed = value.toFixed(decimals);

  const result = decimals > 0 ? fixed.replace(/(\.\d*?[1-9])0+$|\.0+$/, '$1') : fixed;
  return Number(result) === 0 ? '0' : result;
}

function formatConfiguredKpiNumber_(number, unit) {
  const pattern = String(unit || '').trim();
  if (/^[#0]+$/.test(pattern) || pattern.toLowerCase() === 'count') {
    return Number(number).toFixed(0).replace(/^-0$/, '0');
  }
  const decimal = pattern.match(/^[#0]+\.([#0]+)$/);
  if (decimal) {
    const fixed = Number(number).toFixed(Math.min(decimal[1].length, 10));
    return Number(fixed) === 0 ? (0).toFixed(Math.min(decimal[1].length, 10)) : fixed;
  }
  return formatNumber(number, 2);
}

function isAhtKpi(
  kpi
) {
  const text = String(kpi || '').trim().toLowerCase();
  return (
    /(^|\W)aht($|\W)/.test(text) ||
    text.indexOf('average handle time') !== -1 ||
    text.indexOf('average handling time') !== -1
  );
}

function decimalMinutesToHms(
  value
) {

  if (
    value === null ||
    value === undefined ||
    String(value).trim() === ''
  ) {
    return '-';
  }

  const text =
    String(value).trim();

  if (
    /^-?\d{1,3}:\d{2}:\d{2}$/.test(text)
  ) {
    return text;
  }

  const number =
    Number(
      text.replace(/,/g, '')
    );

  if (
    !Number.isFinite(number)
  ) {
    return text;
  }

  const negative =
    number < 0;

  let totalSeconds =
    Math.round(
      Math.abs(number) * 60
    );

  const hours =
    Math.floor(
      totalSeconds / 3600
    );

  totalSeconds -=
    hours * 3600;

  const minutes =
    Math.floor(
      totalSeconds / 60
    );

  const seconds =
    totalSeconds -
    minutes * 60;

  const formatted =
    String(hours).padStart(2, '0') +
    ':' +
    String(minutes).padStart(2, '0') +
    ':' +
    String(seconds).padStart(2, '0');

  return negative
    ? '-' + formatted
    : formatted;
}

function formatKpiValue(
  value,
  unit,
  kpi
) {

  if (
    value === null ||
    value === undefined ||
    String(value).trim() === ''
  ) {
    return '-';
  }

  if (
    isAhtKpi(kpi)
  ) {
    return decimalMinutesToHms(
      value
    );
  }

  const text =
    String(value).trim();

  if (
    text.includes('%')
  ) {
    return text;
  }

  const number =
    Number(
      text.replace(/,/g, '')
    );

  if (
    !Number.isFinite(number)
  ) {
    return text;
  }

  const normalizedUnit =
    String(unit || '')
      .trim()
      .toLowerCase();

  if (
    normalizedUnit === '%'
  ) {

    return (
      formatNumber(
        number * 100,
        1
      ) +
      '%'
    );
  }

  if (normalizedUnit === 'count' || /^[#0]+(?:\.[#0]+)?$/.test(normalizedUnit)) return formatConfiguredKpiNumber_(number, unit);

  if (
    normalizedUnit === 'minutes' ||
    normalizedUnit === 'minute'
  ) {

    return (
      formatNumber(
        number,
        2
      ) +
      ' min'
    );
  }

  if (
    normalizedUnit === 'seconds' ||
    normalizedUnit === 'second'
  ) {

    return (
      formatNumber(
        number,
        1
      ) +
      ' sec'
    );
  }

  return formatConfiguredKpiNumber_(number, unit);
}

function formatKpiDelta(
  value,
  unit,
  kpi
) {

  if (
