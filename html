      setRegistryCreationBusy_(false);
      endExecutiveLoading_();
      button.textContent = 'Register for Approval';
      message.textContent = 'Registration not confirmed: ' + error.message + ' Retry with unchanged fields if needed.';
    })
    .submitNewAction(payload, requestToken);
}

