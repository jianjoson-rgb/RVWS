body.meeting-mode{background:#edf2f8}.capture-executive{border-color:#d4dfea}.capture-brand{color:#365675}.capture-brief-tag{color:#294f72;background:#eff5fa;border-color:#d7e5f1}.capture-executive .capture-metric{background:#f6f9fc}.capture-executive .capture-metric strong{color:#173659}.capture-impact-rating{border-left-color:#abc5db}.capture-impact-rating[data-rating=warning]{border-left-color:#ca9a66}.capture-impact-rating strong,.capture-state-label,.capture-priority-title,.capture-report-page h2{color:#173659}.capture-brief-card p,.capture-priority-next{color:#405b72}.capture-weekly-line,.capture-priority-item,.capture-brief-footer{border-color:#e1e8ef}.capture-executive .capture-context{color:#586c80}
