function registryActionExcerpt_(text) {
  const value = String(text || '').replace(/\s+/g, ' ').trim();
  if (!value) return 'Action steps not recorded.';
  if (value.length <= 150) return value;
  const first = value.slice(0, 147), boundary = first.lastIndexOf(' ');
  return first.slice(0, boundary > 90 ? boundary : first.length) + '…';
}
function registryCategoryMix_(rows) {
  const groups = {};
  (rows || []).forEach(function(row) {
    const label = String(row.category || '').trim() || '<not recorded>';
    const x = groups[label] || (groups[label] = {category:label, count:0, active:0, completed:0, validated:0, unassessed:0});
    x.count++;
    if (!['Completed','Cancelled'].includes(row.status)) x.active++;
    if (row.status === 'Completed') x.completed++;
    if (row.effectivenessStatus === 'Validated') x.validated++;
    if (!row.effectivenessStatus || row.effectivenessStatus === 'Not Yet Assessed') x.unassessed++;
  });
  return Object.keys(groups).map(function(k){const x=groups[k];x.share=(rows || []).length?x.count/(rows || []).length:0;return x;})
    .sort(function(a,b){return b.count-a.count || a.category.localeCompare(b.category);});
}
function renderRegistryCategoryMix_(rows) {
  const mix=registryCategoryMix_(rows), body=document.getElementById('categoryMixBody'); body.textContent='';
  mix.forEach(function(x){const tr=document.createElement('tr');
