  document.getElementById('categoryMixReadout').textContent=mix.length?mix[0].category+' represents '+(mix[0].share*100).toFixed(1)+'% of '+rows.length+' plans in scope; '+mix[0].validated+' have validated impact.':'No action plans match the current filters.';
}
