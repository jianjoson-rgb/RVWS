function registryAssessmentPayload_() {
  const mapping = { status: 'assessmentStatus', periodStart: 'assessmentPeriodStart', periodEnd: 'assessmentPeriodEnd',
    governanceCriteriaResult:'assessmentGovernanceCriteriaResult', expectedImpact: 'assessmentExpectedImpact', behaviorChanges: 'assessmentBehaviorChanges', observedImpact: 'assessmentObservedImpact',
    expectationsResult: 'assessmentExpectations', sustainedResult: 'assessmentSustained', relationship: 'assessmentRelationship',
    otherFactors: 'assessmentOtherFactors', rationale: 'assessmentRationale', evidenceUrls: 'assessmentEvidenceUrls',
    decision: 'assessmentDecision', decisionRationale: 'assessmentDecisionRationale', decisionOwner: 'assessmentDecisionOwner',
    nextReviewDate: 'assessmentNextReview', followUpDueDate: 'assessmentFollowUpDue', followUpDeliverable: 'assessmentFollowUpDeliverable', followUpVerifier: 'assessmentFollowUpVerifier', repeatability: 'assessmentRepeatability', transferability: 'assessmentTransferability',
    riskResult: 'assessmentRiskResult', riskNotes: 'assessmentRiskNotes' };
  const payload = {};
  Object.keys(mapping).forEach(function(key) {
    const element = document.getElementById(mapping[key]); payload[key] = element.value.trim();
    if (element.required && !payload[key]) {
      const section = element.closest('details'); if (section) section.open = true;
      element.focus();
      const label = document.querySelector('label[for="' + mapping[key] + '"]');
      throw new Error((label ? label.textContent : 'This field') + ' is required.');
    }
  });
  const defaults = currentActionDetails && currentActionDetails.assessmentDefaults;
  if (defaults && ((payload.periodStart > defaults.today) || (payload.periodEnd > defaults.today))) throw new Error('Observation dates must be on or before today (' + defaults.today + ', Manila). Use future dates for the next review or follow-up deadline.');
  if (payload.periodStart > payload.periodEnd) throw new Error('Observation period start must be on or before observation period end.');
  payload.evidenceIds = Array.from(document.querySelectorAll('#assessmentEvidenceChoices input:checked')).map(function(input) { return input.value; });
  if (payload.status !== 'Insufficient Evidence' && !payload.evidenceIds.length && !payload.evidenceUrls) throw new Error('Select an evidence file or add a source link, or select Insufficient Evidence.');
  if (payload.decision === 'Recommend Scaling' && (payload.status !== 'Validated' || payload.sustainedResult !== 'Sustained' || payload.riskResult !== 'Acceptable')) throw new Error('Recommend Scaling requires Validated impact, Sustained results, and an Acceptable risk review.');
  return payload;
}

