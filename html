        const option = document.createElement('option');
        option.value = result.actionPlanId;
        option.textContent = result.actionPlanId;
        dropdown.appendChild(option);
      }
      dropdown.value = result.actionPlanId;
      loadActionDetails('approvals');
      showRegistryNotice_('Registered ' + result.actionPlanId + ' · Pending Review.');
      setCreationPermission_(currentAccess);
