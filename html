      }

      const hours =
        Number(parts[0]);

      const minutes =
        Number(parts[1]);

      const seconds =
        Number(parts[2]);

      if (
        !Number.isFinite(hours) ||
        !Number.isFinite(minutes) ||
        !Number.isFinite(seconds) ||
        minutes < 0 ||
        minutes >= 60 ||
        seconds < 0 ||
        seconds >= 60
      ) {
        return NaN;
      }

      return (
        hours * 60 +
        minutes +
        seconds / 60
      );
    }

    return Number(text);
